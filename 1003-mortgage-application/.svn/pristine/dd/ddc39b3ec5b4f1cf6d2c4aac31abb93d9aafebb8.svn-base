[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
[remote "origin"]
	url = https://github.com/indradevzapbuild/FNM.git
	fetch = +refs/heads/*:refs/remotes/origin/*
	pushurl = git@github.com:indradevzapbuild/FNM.git
[branch "master"]
	remote = origin
	merge = refs/heads/master
[remote "composer"]
	url = https://github.com/indradevzapbuild/FNM.git
	fetch = +refs/heads/*:refs/remotes/composer/*
