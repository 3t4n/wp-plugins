{"version":3,"file":"./style-index.css","mappings":";;;AAAA;;;;EAAA;AAKA;EACC;AACD;;AACA;EACC;AAED;;AAAA;EACC;EACA;AAGD;AAFC;;EAEC;AAIF;;AADA;EACC;EACA;EACA;EACA;AAID;AAFC;EACC;EACA;EACA;KAAA;AAIF;;AADA;EACC;AAID;AAFC;;;EAGC;EACA;EACA;EACA;EACA;EACA;AAIF;AADC;EACC;EACA;EACA;EACA;EACA;EACA;AAGF;AADE;EACC;AAGH;AAAC;EACC;EACA;EACA;EACA;EACA;AAEF;;AAEA;EACC;AACD;;AACA;EACC;EACA;EACA;EACA;EACA;EACA;EACA;EACA;EACA;EACA;EACA;EACA;EACA;EACA;EACA;EACA;EACA;EACA;AAED;AADC;EACC;AAGF;;AACA;EACC;EACA;AAED;;AAAA;EACC;EACA;EACA;EACA;EACA;EACA;EACA;EACA;EACA;EACA;AAGD;AACE;;EACC;EACA;EACA;AAEH;;AAGA;EACC;EACA;EACA;EACA;AAAD;;AAEA;EACC;AACD;;AACA;EACC;EACA;EACA;EACA;EACA;EACA;AAED;;AACA;;;;mDAAA;AAMA;EACC;AACD;;AAEA;;;EAGC;EACA;EACA;EACA;EACA;EACA;AACD;AACC;;;;;;;;;;;;;;;EAKC;EACA;EACA;EACA;EACA;EACA;EACA;EACA;EACA;EACA;EACA;EACA;EACA;EACA;EACA;AAWF;AATE;;;;;;;;;;;;;;;EACC;EACA;AAyBH;AAtBE;;;;;;;;;;;;;;;;;;;;;;;;;;;;;EAEC;AAmDH;AA/CC;;;EACC;EACA;AAmDF;AAhDC;;;EACC;AAoDF;AA5CC;;;EACC;EACA;EACA;EACA;EACA;EACA;EACA;EACA;EACA;AAgDF;AA7CC;;;;;;;;;;;;;;;;;;EAMC;EACA;AA2DF;AAzDE;;;;;;;;;;;;;;;;;;EACC;EACA;AA4EH;AAzEE;;;;;;;;;;;;;;;;;;EACC;EACA;AA4FH;AAzFE;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;EAEC;AA4HH;AA1HG;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;EACC;EACA;AA8JJ,C","sources":["webpack://perfect-post-grid/./src/style.scss"],"sourcesContent":["/**\n * The following styles get applied inside the editor only.\n *\n * Replace them with your own styles or remove the file completely.\n */\nsection:has(.components-grid) {\n\tmax-width: 1280px;\n}\n.wp-block-wo-advance-post-grid {\n\tmax-width: 100%;\n}\n.wo-advance-post-grid-single {\n\tposition: relative;\n\tpadding-bottom: 90px;\n\ta,\n\ta:visited {\n\t\ttext-decoration: none;\n\t}\n}\n.wo-advance-post-grid-image {\n\tdisplay: block;\n\twidth: 100%;\n\tline-height: 0.65;\n\taspect-ratio: 1/0.6;\n\n\timg {\n\t\twidth: 100%;\n\t\theight: 100%;\n\t\tobject-fit: cover;\n\t}\n}\n.wo-advance-post-grid-content {\n\tmargin-top: 20px;\n\n\th2,\n\th3,\n\th4 {\n\t\tfont-size: 28px !important;\n\t\tdisplay: -webkit-box;\n\t\t-webkit-line-clamp: 2;\n\t\t-webkit-box-orient: vertical;\n\t\toverflow: hidden;\n\t\tmargin-bottom: 12px !important;\n\t}\n\n\tp {\n\t\tmargin: 0 !important;\n\t\tfont-size: 18px !important;\n\t\tdisplay: -webkit-box;\n\t\t-webkit-line-clamp: 4;\n\t\t-webkit-box-orient: vertical;\n\t\toverflow: hidden;\n\n\t\t&:last-child {\n\t\t\tmargin-bottom: 0 !important;\n\t\t}\n\t}\n\t.wo-excerpt {\n\t\tfont-size: 18px !important;\n\t\tdisplay: -webkit-box;\n\t\t-webkit-line-clamp: 4;\n\t\t-webkit-box-orient: vertical;\n\t\toverflow: hidden;\n\t}\n}\n\na:hover .wo-advance-post-grid-button {\n\tpadding-right: 26px;\n}\n.wo-advance-post-grid-button {\n\tdisplay: inline-block;\n\tmargin-top: 24px;\n\tbox-sizing: border-box;\n\tposition: relative;\n\tdisplay: inline-block;\n\toverflow: hidden;\n\ttext-decoration: none;\n\tfont-size: 16px;\n\tfont-weight: bold;\n\tletter-spacing: 0;\n\tpadding: 0 22px 0 0;\n\tbackground-image: url(./assets/images/angle-right.svg);\n\tbackground-size: 20px;\n\tposition: initial !important;\n\tbackground-repeat: no-repeat;\n\tbackground-position: top 1px right;\n\tline-height: 1.35;\n\ttransition: all 0.3s ease-in-out;\n\t&:hover {\n\t\tpadding-right: 26px;\n\t}\n}\n\n.wo-advance-post-grid-single-cats {\n\tflex-wrap: wrap;\n\tmargin-left: 8px;\n}\n.wo-advance-post-grid-single-cat {\n\tdisplay: inline-block;\n\tborder-radius: 100px;\n\tborder: 2px solid #fff;\n\tbackground-color: #000;\n\tpadding: 4px 16px 3px 16px;\n\tcolor: #fff;\n\tfont-size: 16px;\n\tmargin-left: -8px;\n\tmin-height: 35px;\n\tbox-sizing: border-box;\n\n\ta,\n\ta:visited {\n\t\t&:hover {\n\t\t\tborder-color: #fff;\n\t\t\tbackground-color: transparent;\n\t\t\tcolor: #000;\n\t\t}\n\t}\n}\n\n.wo-advance-post-grid-single-bottom {\n\tposition: absolute;\n\twidth: 100%;\n\tleft: 0;\n\tbottom: 0;\n}\n.wo-advance-post-grid-single-button {\n\tline-height: 1;\n}\n.wo-advance-post-grid-single-date {\n\tfont-size: 16px;\n\tdisplay: flex;\n\tgap: 20px;\n\tpadding-top: 10px;\n\tmargin-top: 10px;\n\tborder-top: 1px solid rgba(0, 0, 0, 0.25);\n}\n\n/* -------------------------------------------------\n>> Base Styles\n---------------------------------------------------\n>> Edit these styles as required\n------------------------------------------------- */\n\n.pagination {\n\tmargin: 100px 0;\n}\n\n.page-section .pagination,\n.pagination,\n.pagination-numbers {\n\tdisplay: flex;\n\ttext-align: center;\n\tjustify-content: center;\n\talign-items: center;\n\tgap: 12px;\n\tflex-wrap: wrap;\n\n\ta,\n\tspan,\n\tspan[role=\"button\"],\n\ta:visited,\n\tspan.current {\n\t\tbackground-color: transparent;\n\t\tcolor: var(--cr_color_primary);\n\t\tborder: 1px solid rgba(0, 0, 0, 0.5);\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tjustify-content: center;\n\t\tfont-size: 18px;\n\t\tline-height: 1;\n\t\tcursor: pointer;\n\t\twidth: 60px;\n\t\theight: 60px;\n\t\ttransition: all 0.3s ease-in-out;\n\t\tborder-radius: 100px;\n\t\tbox-sizing: border-box;\n\t\ttext-decoration: none;\n\n\t\t&.current {\n\t\t\tbackground-color: #000;\n\t\t\tcolor: #fff;\n\t\t}\n\n\t\t&:hover,\n\t\t&:focus-visible {\n\t\t\tborder-color: #000;\n\t\t}\n\t}\n\n\tspan.current {\n\t\tbackground-color: #000;\n\t\tcolor: #fff;\n\t}\n\n\t> span.current {\n\t\tborder: none;\n\n\t\t// &:hover,\n\t\t// &:focus-visible {\n\n\t\t// }\n\t}\n\n\t.pagination-dots {\n\t\twidth: 50px;\n\t\theight: 60px;\n\t\tdisplay: flex;\n\t\talign-items: flex-start;\n\t\tjustify-content: center;\n\t\tfont-size: 25px;\n\t\tline-height: 45px;\n\t\tcolor: #000;\n\t\topacity: 0.5;\n\t}\n\n\tspan.pre-page,\n\tspan.next-page,\n\ta.pre-page,\n\ta.next-page,\n\ta.pagination-prev,\n\ta.pagination-next {\n\t\tborder-color: rgba(0, 0, 0, 0.2);\n\t\tbackground-color: transparent;\n\n\t\tpath {\n\t\t\ttransition: stroke 0.3s;\n\t\t\tstroke: #000;\n\t\t}\n\n\t\t&:hover {\n\t\t\tborder-color: #000;\n\t\t\tbackground-color: transparent;\n\t\t}\n\n\t\t&.disabled-pagination,\n\t\t&.disabled {\n\t\t\tborder-color: rgba(0, 0, 0, 0.1);\n\n\t\t\tpath {\n\t\t\t\tstroke: #000;\n\t\t\t\tstroke-opacity: 0.2;\n\t\t\t}\n\t\t}\n\t}\n}\n\n@media only screen and (max-width: 747px) {\n}\n"],"names":[],"sourceRoot":""}