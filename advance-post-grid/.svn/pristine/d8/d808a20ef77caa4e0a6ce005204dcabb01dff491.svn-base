bpack/runtime/hasOwnProperty shorthand","webpack://perfect-post-grid/webpack/runtime/make namespace object","webpack://perfect-post-grid/webpack/runtime/jsonp chunk loading","webpack://perfect-post-grid/webpack/before-startup","webpack://perfect-post-grid/webpack/startup","webpack://perfect-post-grid/webpack/after-startup"],"sourcesContent":["import { __ } from '@wordpress/i18n';\nimport { useSelect } from '@wordpress/data';\nimport { useState, useEffect } from '@wordpress/element';\nimport {\n\t__experimentalGrid as Grid,\n} from '@wordpress/components';\nimport { RangeControl, Spinner, SelectControl, TabPanel, ToggleControl, Panel, PanelBody, __experimentalNumberControl as NumberControl } from '@wordpress/components';\nimport { useBlockProps, InspectorControls, RichText } from '@wordpress/block-editor';\nimport './editor.scss';\n\nexport default function Edit( { attributes, setAttributes } ) {\n\tconst { postGrid, postPerPage, PostOrder, showHidePagi, showHideRT, showHideCat, showHideLink, PostOrderBy, postType } = attributes;\n\tconst [ options, setOptions ] = useState( [] );\n\n\t// Fetch post types\n\tconst fetchPostTypes = async () => {\n\t\ttry {\n\t\t\tconst response = await fetch( '/wp-json/wp/v2/types' );\n\t\t\tconst data = await response.json();\n\t\t\tconst allowedPostTypes = [ 'post', 'page', 'product' ];\n\t\t\tconst filteredPostTypes = Object.values( data ).filter( ( type ) =>\n\t\t\t\tallowedPostTypes.includes( type.slug )\n\t\t\t);\n\t\t\tconst formattedPostTypes = filteredPostTypes.map( ( type ) => ( {\n\t\t\t\tlabel: type.name,\n\t\t\t\tvalue: type.slug,\n\t\t\t} ) );\n\t\t\tsetOptions( formattedPostTypes );\n\t\t} catch ( error ) {\n\t\t\tconsole.error( 'Error fetching post types:', error );\n\t\t}\n\t};\n\n\tuseEffect( () => {\n\t\tfetchPostTypes();\n\t}, [] );\n\n\t// Fetch posts based on selected settings\n\tconst posts = useSelect( ( select ) => {\n\t\treturn select( 'core' ).getEntityRecords( 'postType', postType, { per_page: postPerPage, _embed: true, order: PostOrder.toLowerCase(), orderby: PostOrderBy } );\n\t}, [ postGrid, postPerPage, PostOrder, postType, PostOrderBy, showHidePagi, showHideLink, showHideCat, showHideRT ] );\n\n\t// Function to calculate the reading time\n\tconst calculateReadTime = ( content ) => {\n\t\tconst wordsPerMinute = 200; // Average reading speed\n\t\tconst wordCount = content.split( /\\s+/ ).length;\n\t\tconst readTimeInMinutes = Math.ceil( wordCount / wordsPerMinute );\n\t\treturn readTimeInMinutes;\n\t};\n\n\treturn (\n\t\t<section { ...useBlockProps() }>\n\t\t\t<InspectorControls>\n\t\t\t\t<Panel>\n\t\t\t\t\t<TabPanel\n\t\t\t\t\t\tclassName=\"my-tab-panel\"\n\t\t\t\t\t\tactiveClass=\"active-tab\"\n\t\t\t\t\t\ttabs={ [\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tname: 'tab2',\n\t\t\t\t\t\t\t\ttitle: __( 'Post Settings', 'advance-post-grid' ),\n\t\t\t\t\t\t\t\tclassName: 'tab-two',\n\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tname: 'tab1',\n\t\t\t\t\t\t\t\ttitle: __( 'Layouts Settings', 'advance-post-grid' ),\n\t\t\t\t\t\t\t\tclassName: 'layouts',\n\t\t\t\t\t\t\t},\n\t\t\t\t\t\t] }\n\t\t\t\t\t>\n\t\t\t\t\t\t{ ( tab ) => (\n\t\t\t\t\t\t\t<div className={ tab.className }>\n\t\t\t\t\t\t\t\t{ tab.name === 'tab1' && (\n\t\t\t\t\t\t\t\t\t<>\n\t\t\t\t\t\t\t\t\t\t<PanelBody title={ __( 'Post Grid', 'advance-post-grid' ) }>\n\t\t\t\t\t\t\t\t\t\t\t<RangeControl\n\t\t\t\t\t\t\t\t\t\t\t\thelp={ __( 'Please select how much column you would like this.', 'advance-post-grid' ) }\n\t\t\t\t\t\t\t\t\t\t\t\tinitialPosition={ postGrid }\n\t\t\t\t\t\t\t\t\t\t\t\tlabel={ __( 'Grid', 'advance-post-grid' ) }\n\t\t\t\t\t\t\t\t\t\t\t\tmax={ 4 }\n\t\t\t\t\t\t\t\t\t\t\t\tmin={ 2 }\n\t\t\t\t\t\t\t\t\t\t\t\tonChange={ ( value ) => setAttributes( { postGrid: value } ) }\n\t\t\t\t\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t\t\t\t\t</PanelBody>\n\t\t\t\t\t\t\t\t\t\t<PanelBody title={ __( 'Style Options', 'advance-post-grid' ) }>\n\n\t\t\t\t\t\t\t\t\t\t\t<ToggleControl\n\t\t\t\t\t\t\t\t\t\t\t\tlabel=\"Pagination\"\n\t\t\t\t\t\t\t\t\t\t\t\thelp={ __( 'Show / Hide - Pagination' ) }\n\t\t\t\t\t\t\t\t\t\t\t\tchecked={ showHidePagi }\n\t\t\t\t\t\t\t\t\t\t\t\tonChange={ ( value ) => setAttributes( { showHidePagi: value } ) }\n\t\t\t\t\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t\t\t\t\t\t<ToggleControl\n\t\t\t\t\t\t\t\t\t\t\t\tlabel=\"Post Link\"\n\t\t\t\t\t\t\t\t\t\t\t\thelp={ __( 'Show / Hide - Post Link' ) }\n\t\t\t\t\t\t\t\t\t\t\t\tchecked={ showHideLink }\n\t\t\t\t\t\t\t\t\t\t\t\tonChange={ ( value ) => setAttributes( { showHideLink: value } ) }\n\t\t\t\t\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t\t\t\t\t\t<ToggleControl\n\t\t\t\t\t\t\t\t\t\t\t\tlabel=\"Categories\"\n\t\t\t\t\t\t\t\t\t\t\t\thelp={ __( 'Show / Hide - Categories' ) }\n\t\t\t\t\t\t\t\t\t\t\t\tchecked={ showHideCat }\n\t\t\t\t\t\t\t\t\t\t\t\tonChange={ ( value ) => setAttributes( { showHideCat: value } ) }\n\t\t\t\t\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t\t\t\t\t\t<ToggleControl\n\t\t\t\t\t\t\t\t\t\t\t\tlabel=\"Read Time\"\n\t\t\t\t\t\t\t\t\t\t\t\thelp={ __( 'Show / Hide - Read Time' ) }\n\t\t\t\t\t\t\t\t\t\t\t\tchecked={ showHideRT }\n\t\t\t\t\t\t\t\t\t\t\t\tonChange={ ( value ) => setAttributes( { showHideRT: value } ) }\n\t\t\t\t\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t\t\t\t\t</PanelBody>\n\t\t\t\t\t\t\t\t\t</>\n\t\t\t\t\t\t\t\t) }\n\t\t\t\t\t\t\t\t{ tab.name === 'tab2' && (\n\t\t\t\t\t\t\t\t\t<PanelBody title={ __( 'Settings', 'advance-post-grid' ) }>\n\t\t\t\t\t\t\t\t\t\t<SelectControl\n\t\t\t\t\t\t\t\t\t\t\tlabel=\"Post Type\"\n\t\t\t\t\t\t\t\t\t\t\tvalue={ postType }\n\t\t\t\t\t\t\t\t\t\t\toptions={ options }\n\t\t\t\t\t\t\t\t\t\t\tonChange={ ( value ) => setAttributes( { postType: value } ) }\n\t\t\t\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t\t\t\t\t<NumberControl\n\t\t\t\t\t\t\t\t\t\t\tlabel=\"Post Per Page\"\n\t\t\t\t\t\t\t\t\t\t\tvalue={ postPerPage }\n\t\t\t\t\t\t\t\t\t\t\tonChange={ ( value ) => setAttributes( { postPerPage: value } ) }\n\t\t\t\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t\t\t\t\t<SelectControl\n\t\t\t\t\t\t\t\t\t\t\tlabel=\"Order\"\n\t\t\t\t\t\t\t\t\t\t\tvalue={ PostOrder }\n\t\t\t\t\t\t\t\t\t\t\toptions={ [\n\t\t\t\t\t\t\t\t\t\t\t\t{ label: 'Ascending', value: 'ASC' },\n\t\t\t\t\t\t\t\t\t\t\t\t{ label: 'Descending', value: 'DESC' },\n\t\t\t\t\t\t\t\t\t\t\t] }\n\t\t\t\t\t\t\t\t\t\t\tonChange={ ( value ) => setAttributes( { PostOrder: value } ) }\n\t\t\t\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t\t\t\t\t<SelectControl\n\t\t\t\t\t\t\t\t\t\t\tlabel=\"Order By\"\n\t\t\t\t\t\t\t\t\t\t\tvalue={ PostOrderBy }\n\t\t\t\t\t\t\t\t\t\t\toptions={ [\n\t\t\t\t\t\t\t\t\t\t\t\t{ label: 'Title', value: 'title' },\n\t\t\t\t\t\t\t\t\t\t\t\t{ label: 'Date', value: 'date' },\n\t\t\t\t\t\t\t\t\t\t\t] }\n\t\t\t\t\t\t\t\t\t\t\tonChange={ ( value ) => setAttributes( { PostOrderBy: value } ) }\n\t\t\t\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t\t\t\t</PanelBody>\n\t\t\t\t\t\t\t\t) }\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t) }\n\t\t\t\t\t</TabPanel>\n\t\t\t\t</Panel>\n\t\t\t</InspectorControls>\n\n\t\t\t{ posts && posts.length > 0 ? (\n\t\t\t\t<>\n\t\t\t\t\t<Grid columns={ postGrid }>\n\t\t\t\t\t\t{ posts.map( ( post ) => (\n\t\t\t\t\t\t\t<div key={ post.id } className=\"wo-advance-post-grid-single\">\n\n\t\t\t\t\t\t\t\t<div className=\"wo-advance-post-grid-image\">\n\t\t\t\t\t\t\t\t\t{ post._embedded[ 'wp:featuredmedia' ] && post._embedded[ 'wp:featuredmedia' ][ 0 ] && (\n\t\t\t\t\t\t\t\t\t\t<img\n\t\t\t\t\t\t\t\t\t\t\tclassName=\"featured-image\"\n\t\t\t\t\t\t\t\t\t\t\tsrc={ post._embedded[ 'wp:featuredmedia' ][ 0 ].source_url }\n\t\t\t\t\t\t\t\t\t\t\talt={ post._embedded[ 'wp:featuredmedia' ][ 0 ].alt_text }\n\t\t\t\t\t\t\t\t\t\t\twidth=\"150\"\n\t\t\t\t\t\t\t\t\t\t\theight=\"150\"\n\t\t\t\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t\t\t\t) }\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div className=\"wo-advance-post-grid-content\">\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tshowHideCat ? <div className=\"wo-advance-post-grid-single-cats\">\n\t\t\t\t\t\t\t\t\t\t\t{ post._embedded[ 'wp:term' ] &&\n\t\t\t\t\t\t\t\t\t\tpost._embedded[ 'wp:term' ][ 0 ] &&\n\t\t\t\t\t\t\t\t\t\tpost._embedded[ 'wp:term'