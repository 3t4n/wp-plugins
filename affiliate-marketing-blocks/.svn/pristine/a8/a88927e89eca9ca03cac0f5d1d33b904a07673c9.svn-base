.wp-block-afmb-rating .rating-inner{align-items:center;display:inline-flex;gap:8px}.wp-block-afmb-rating .rating-inner.tp_left{flex-direction:row}.wp-block-afmb-rating .rating-inner.tp_right{flex-direction:row-reverse}.wp-block-afmb-rating .rating-inner.tp_top{flex-direction:column}.wp-block-afmb-rating .rating-inner .rating-title{line-height:1;margin:0!important}.wp-block-afmb-rating .afftra-star-rating{align-items:center;display:inline-flex;gap:1px}.wp-block-afmb-rating .afftra-star-rating svg{fill:var(--afftra-star-color);width:16px}.wp-block-afmb-rating .rating-content{align-items:center;display:inline-flex;gap:8px}.wp-block-afmb-rating .rating-content.nr_left{flex-direction:row-reverse}.wp-block-afmb-rating .rating-content.nr_right{flex-direction:row}
