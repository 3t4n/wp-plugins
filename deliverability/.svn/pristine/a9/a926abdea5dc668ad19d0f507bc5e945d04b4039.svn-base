<?php

namespace TopDeliverability;

class ConfiguredDomains {

	/**
	 * @var ConfiguredDomain[]
	 */
	private $records;

	/**
	 * @param ConfiguredDomain[] $records
	 */
	public function __construct( array $records ) {
		$this->records = $records;
	}

	public function getRecords() {
		return $this->records;
	}
}
