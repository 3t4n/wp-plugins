<div class="td-card account">
	<div class="card-title">
		<div class="text">
			<h1 data-testid="title">{{ title }}</h1>
		</div>
		<div class="plan">
			<div class="description" data-testid="description">{{ description }}:</div>
			<md-suggestion-chip class="{{ plan_name | lower }}" disabled
								label="{{ plan_name | capitalize }}" data-testid="plan_name"></md-suggestion-chip>
		</div>
		<div class="buttons"></div>
	</div>
</div>
