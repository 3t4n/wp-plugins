<?php

namespace TopDeliverability\Settings;

use TopDeliverability\Menu\MenuEntry;
use const TopDeliverability\BASE_SLUG;

class SettingsMenuEntry extends MenuEntry {

	/**
	 * @return string
	 */
	public function getSlug() {
		return BASE_SLUG . '-settings';
	}

	/**
	 * @return string
	 */
	public function getTitle() {
		return __( 'Settings', 'deliverability' );
	}

	/**
	 * @return string
	 */
	public function getMenuTitle() {
		return __( 'Settings', 'deliverability' );
	}
}
