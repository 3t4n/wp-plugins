<?php

namespace TopDeliverability;

class Account {

	/**
	 * @var string
	 */
	private $id;

	/**
	 * @var string
	 */
	private $plan;

	public function __construct( $id, $plan ) {
		$this->id   = $id;
		$this->plan = $plan;
	}

	public function getId() {
		return $this->id;
	}

	public function getPlan() {
		return $this->plan;
	}
}
