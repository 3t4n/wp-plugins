msgstr ""

#: Score/AnalysisResultDetailAdapter.php:117
msgid "DKIM (DomainKeys Identified Mail) adds a digital signature to your emails, ensuring they haven't been tampered with."
msgstr ""

#: Score/AnalysisResultDetailAdapter.php:119
