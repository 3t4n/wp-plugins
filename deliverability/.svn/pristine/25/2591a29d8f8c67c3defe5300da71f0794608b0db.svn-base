<?php

namespace TopDeliverability\Callback;

use TopDeliverability\Menu\MenuEntry;
use const TopDeliverability\BASE_SLUG;

class CallbackMenuEntry extends MenuEntry {

	/**
	 * @return string
	 */
	public function getSlug() {
		return BASE_SLUG . '-callback';
	}

	/**
	 * @return null
	 */
	public function getTitle() {
		return null;
	}

	/**
	 * @return null
	 */
	public function getMenuTitle() {
		return null;
	}
}
