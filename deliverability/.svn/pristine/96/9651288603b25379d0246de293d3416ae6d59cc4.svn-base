<?php

namespace TopDeliverability\Dashboard;

use TopDeliverability\Menu\MenuEntry;
use const TopDeliverability\BASE_SLUG;

class DashboardMenuEntry extends MenuEntry {

	/**
	 * @return string
	 */
	public function getSlug() {
		return BASE_SLUG . '-dashboard';
	}

	/**
	 * @return string
	 */
	public function getTitle() {
		return __( 'Dashboard', 'deliverability' );
	}

	/**
	 * @return string
	 */
	public function getMenuTitle() {
		return __( 'Deliverability Dashboard', 'deliverability' );
	}
}
