.notifications-woocommerce-popup{visibility:hidden;opacity:0;position:fixed;left:0;top:0;width:100%;height:100%;background:rgba(0,0,0,.5);display:flex;justify-content:center;align-items:center;transition:opacity .3s ease-in-out}.notifications-woocommerce-popup.show{visibility:visible;opacity:1}.notifications-woocommerce-popup-content{background:#fff;padding:20px;border-radius:5px;text-align:center;width:400px;position:relative;box-shadow:0 0 10px rgba(0,0,0,.3)}.notifications-woocommerce-popup-close{position:absolute;top:10px;right:10px;cursor:pointer;font-size:18px;font-weight:700}.notifications-woocommerce-popup-button{display:block;background:#0073aa;color:#fff;padding:10px;text-decoration:none;margin-top:10px;border-radius:4px}#notifications-woocommerce-popup-later,#notifications-woocommerce-popup-never{display:block;width:100%;padding:10px;margin-top:10px;border:none;cursor:pointer;text-align:center}#notifications-woocommerce-popup-later{background:#ccc}#notifications-woocommerce-popup-never{background:red;color:#fff}