    width: 100%;
    line-height: 28px;
    font-size: 22px;
    font-weight: 600;
    font-family: "Inter", sans-serif;
    color: #282828;
}
.ada-cc-usage-guide .ada-cc-Widget-main .ada-cc-widget-three-div {
    width: 100%;
    display: flex;
    margin-top: 30px;
}
.ada-cc-usage-guide
