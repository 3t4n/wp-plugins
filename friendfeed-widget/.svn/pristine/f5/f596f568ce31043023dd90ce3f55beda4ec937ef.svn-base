#friendfeed-widget ul li{
	background-repeat:no-repeat;
	padding-left:18px;
}
#friendfeed-widget ul li.lifefeed-item-googlereader{ background-image:url(webicons/googlereader.png); }
#friendfeed-widget ul li.lifefeed-item-blog{ background-image:url(webicons/blog.png); }
#friendfeed-widget ul li.lifefeed-item-flickr { background-image:url(webicons/flickr.png); }
#friendfeed-widget ul li.lifefeed-item-delicious { background-image:url(webicons/delicious.png); }
#friendfeed-widget ul li.lifefeed-item-googletalk { background-image:url(webicons/googletalk.png); }
#friendfeed-widget ul li.lifefeed-item-stumbleupon { background-image:url(webicons/stumbleupon.png); }
#friendfeed-widget ul li.lifefeed-item-twitter { background-image:url(webicons/twitter.png); }
#friendfeed-widget ul li.lifefeed-item-picasa { background-image:url(webicons/picasa.png); }
#friendfeed-widget ul li.lifefeed-item-vimeo { background-image:url(webicons/vimeo.png); }


