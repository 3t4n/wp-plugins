 20px));\n}\n\n.dwp-tooltip-wrap.right.top .dwp-tooltip:after {\n  left: calc(100% - 20px);\n}\n\n.dwp-tooltip-wrap.right.top:hover .dwp-tooltip {\n  transform: translateY(0) translateX(calc(-100% + 20px));\n}\n\n.dwp-tooltip-wrap.left.top .dwp-tooltip {\n  transform: translateY(10px) translateX(-20px);\n}\n\n.dwp-tooltip-wrap.left.top .dwp-tooltip .dwp-tooltip-arrow {\n  left: 20px;\n}\n\n.dwp-tooltip-wrap.left.top:hover .dwp-tooltip {\n  transform: translateY(0) translateX(-20px);\n}\n\n.dwp-tooltip-wrap .dwp-tooltip {\n  background: #51595f;\n  bottom: 100%;\n  font-weight: normal;\n  font-size: 11px !important;\n  color: #fff !important;\n  line-height: 14px !important;\n  display: block;\n  left: 50%;\n  margin-bottom: 15px;\n  opacity: 0;\n  padding: 4px 6px;\n  white-space: nowrap;\n  text-align: center;\n  pointer-events: none;\n  position: absolute;\n  width: auto !important;\n  height: auto !important;\n  border-radius: 3px !important;\n  transform: translateY(10px) translateX(-50%);\n  transition: transform 0.25s ease-out, opacity 0.25s ease-out;\n  box-shadow: 2px 2px 6px rgba(0, 0, 0, 0.28);\n}\n\n.dwp-tooltip-wrap .dwp-tooltip i {\n  padding: 0 3px !important;\n}\n\n.dwp-tooltip-wrap .dwp-tooltip .dwp-subtle {\n  opacity: 0.65;\n}\n\n.dwp-tooltip-wrap.bottom .dwp-tooltip {\n  bottom: auto;\n  top: 100%;\n  margin-bottom: 0;\n  margin-top: 5px;\n  transform: translateY(-10px) translateX(-50%);\n}\n\n.dwp-tooltip-wrap.bottom .dwp-tooltip:before {\n  bottom: -20px;\n}\n\n.dwp-tooltip-wrap.bottom .dwp-tooltip:not(.has-arrow):after {\n  border-left: solid transparent 5px;\n  border-right: solid transparent 5px;\n  border-top: none;\n  border-bottom: solid #51595f 5px;\n  bottom: auto;\n  top: -5px;\n  content: " ";\n  height: 0;\n  left: 50%;\n  margin-left: -5px;\n  position: absolute;\n  width: 0;\n}\n\n.dwp-tooltip-wrap.bottom:hover .dwp-tooltip {\n  transform: translateY(0) translateX(-50%);\n}\n\n.dwp-tooltip-wrap.bottom.right .dwp-tooltip {\n  transfo