#: payments/gc_bluecode.php:139 payments/gc_creditcard.php:179 payments/gc_directdebit.php:158 payments/gc_eps.php:136
#: payments/gc_giropay.php:135 payments/gc_ideal.php:165 payments/gc_maestro.php:145 payments/gc_paydirekt.php:157
#: payments/gc_sofortuw.php:136
msgid "Purpose"
msgstr "Verwendungszweck"

#: payments/gc_bluecode.php:141 payments/gc_creditcard.php:181 payments/gc_directdebit.php:160 payments/gc_eps.php:138
#: payments/gc_giropay.php:137 payments/gc_ideal.php:167 payments/gc_maestro.php:147 payments/gc_paydirekt.php:159
#: payments/gc_sofortuw.php:138
msgid ""
"You can define your own purpose using these placeholders:\n"
"{ORDERID}: Bestellnummer\n"
"{CUSTOMERID}: Kundennummer\n"
"{SHOPNAME}: Shop Name\n"
"{CUSTOMERNAME}: Kundenname\n"
"{CUSTOMERFIRSTNAME}: Kunde Vorname\n"
"{CUSTOMERLASTNAME}: Kunde Nachname\n"
"For example: If your purpose is \"Best. {ORDERID}, {SHOPNAME}\" then the submitted purpose must be \"Best. 55342, TestShop\"\n"
"The maximum length of the purpose is 27 characters."
msgstr ""
"Du kannst im Verwendungszweck die folgenden Platzhalter verwenden:\n"
"{ORDERID}: Bestellnummer\n"
"{CUSTOMERID}: Kundennummer\n"
"{SHOPNAME}: Shop Name \n"
"{CUSTOMERNAME}: Kundenname\n"
"{CUSTOMERFIRSTNAME}: Kunde Vorname \n"
"{CUSTOMERLASTNAME}: Kunde Nachname\n"
"Beispiel: Wenn dein Verwendungszweck \"Best. 55342, TestShop\" lauten soll, dann musst du folgendes angeben: \"Best. {ORDERID}, "
"{SHOPNAME}\".\n"
"Die maximale Länge beträgt 27 Zeichen."

#: payments/gc_bluecode.php:156 payments/gc_creditcard.php:231 payments/gc_directdebit.php:192 payments/gc_eps.php:153
