#: payments/gc_bluecode.php:42 payments/gc_bluecode.php:44 payments/gc_bluecode.php:114 payments/gc_bluecode.php:190
msgid "Bluecode"
msgstr "Bluecode"

#: payments/gc_bluecode.php:53
msgid "Bluecode works like cash — just on your smartphone . Download the App now and do cashless payments at over 4500 partners. Fast. Secure. Simple."
msgstr ""
"Bluecode funktioniert wie Bargeld – nur auf Ihrem Smartphone. Laden Sie die App jetzt herunter und bezahlen Sie bargeldlos bei "
"über 4500 Partnern. Schnell. Sicher. Einfach."

