.pcd-elementor-widget .pcd-single-cat-grid-item {
    text-align: center;
    margin-bottom: 30px;
    border-radius: 0;
}

.pcd-elementor-widget p {
    margin: 0 0 1.41575em;
}

.pcd-elementor-widget .pcd-position-below-content .pcd-single-cat-grid-item .pcd-grid-cat-info a {
    color: #444444;
    padding: 10px;
}

.pcd-elementor-widget .pcd-single-cat-grid-item a img {
    height: auto;
    width: 100%;
    display: block;
    border-radius: 3px;
    margin-bottom: 13px
}

.pcd-elementor-widget .pcd-single-cat-grid-item .pcd-grid-cat-info a {
    margin: 0px 0px 6px 0px;
    padding: 12px 0px 8px 0px;
    font-size: 20px;
    line-height: 18px;
    letter-spacing: 0px;
    text-align: center;
    text-transform: none;
    display: block;
    text-decoration: none;
    transition: ease all 0.2s;
}

.pcd-position-overlay-content .pcd-elementor-widget .pcd-single-cat-grid-item .pcd-grid-cat-info a {
    color: #fff;
}

.pcd-position-overlay-content .pcd-elementor-widget .pcd-single-cat-grid-item .pcd-grid-cat-info a {
    padding: 16px 16px 5px 16px;
}

.pcd-elementor-widget .pcd-position-below-content .pcd-single-cat-grid-item .pcd-grid-description p {
    padding-left: 10px;
    padding-right: 10px;
}

.pcd-elementor-widget .pcd-grid-description {
    /* max-width: 271px; */
    width: 76%;
    margin: 0 auto;
}

.pcd-elementor-widget.pcd-row-cols-4 .pcd-single-card .pdc-reap .pcd-grid-description {
    width: 100% !important;
}

.pcd-elementor-widget.pcd-row-cols-3 .pcd-single-card .pdc-reap .pcd-grid-description {
    width: 100% !important;
}

.pcd-elementor-widget .pcd-grid-cat-info .pcd-grid-special-offer {
    /* color: #fff; */
    font-size: 14px;
    line-height: 28px;
    font-weight: 600;
    font-style: italic;
    padding: 0px 0px 12px 0px;
}

.pcd-single-cat-slider-item .pcd-grid-special-offer {
    padding: 0px 0px 12px 0px;
}

.pcd-elementor-widget .pcd-overlay-content-design .pcd-grid-special-offer {
    font-size: 14px;
    font-weight: 500;
    text-transform: uppercase;
    color: #fff;
    line-height: 22px;
}

.pcd-elementor-widget .pcd-shop-now {
    font-size: 15px;
    color: #fff;
    background: #cc2b5e;
    text-align: center;
    padding: 9px 18px;
    border-radius: 3px;
    font-weight: 600;
    text-decoration: none !important;
}

.pcd-elementor-widget .pdc-reap {
    position: relative;
    min-height: 100px;
}

/*=================hideant overlay-content style========================*/

.pcd-position-overlay-content .pcd-elementor-widget .pcd-single-cat-grid-item .pcd-grid-cat-info {
    background-color: rgba(17, 17, 17, 0.6);
    padding: 16px 16px 16px 16px;
    position: absolute;
    width: 100%;
    height: auto;
    bottom: 0;
    z-index: 0;
}
.pcd-category-name {
    display: block;
    padding: 10px 0px 10px 0px;
}

/* pre-design templates */

.pcd-cat-thumbnail a img, 
.pcd-predesign-template .pcd-cat-thumbnail a img{
    width: 100%;
}

.pcd-predesign-template .pcd-cat-thumbnail a img:hover {
    transform: scale(1.2);
}


.pcd-predesign-template .pcd-slide-product-count {
    padding-bottom: 20px;
}

.pcd-predesign-template .pcd-cat-thumbnail {
    margin: 0;
    padding: 0;
    overflow: hidden;
    transition: all .3s ease;
}

.pcd-predesign-template  .pcd-single-cat-grid-item a img {
    height: auto;
    width: 100%;
    display: block;
    border-radius: 3px;
    margin-bottom: 0px
}

.pcd-predesign-template .pcd-single-cat-slider-item .pcd-grid-cat--details,
.pcd-predesign-template .pcd-single-cat-grid-item .pcd-grid-cat--details {
    padding: 13px 5px 30px 5px;
    -webkit-transition: all 0.5s ease 0s;
    transition: all 0.5s ease 0s;
    width: 100%;
    background-color: #ededed;
    font-size: 17px;
    color: #333;
}

/* pre-design templates tow*/
.pcd-predesign-template-two .pcd-grid-cat--details {
    position: absolute;
    background: #1D1D1D;
    opacity: 0.7;
    width: 100%;
    height: auto;
    bottom: 0px;
    right: 0;
    left: 0;
    margin-bottom: 30px;
}

.pcd-predesign-template-two .pcd-category-name {
    display: block;
    padding: 8px 0px 8px 0px;
    color: #ffffff;
    font-weight: 600;
}

.pcd-predesign-template-two .pcd-single-card:hover {
    opacity: 1;
}

.pcd-predesign-template-two .pcd-sub-category {
    position: absolute;
    top: 0;
    right: 0;
    margin: 10px;
}

.subcategories-list {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
}

.subcategories-list li{
    margin: 3px;
}

.pcd-predesign-template-two .pcd-sub-category a{
    color: #FFFFFF;
    font-weight: 500;
    border: 0.5px solid #FFFFFF;
    padding: 4px;
    background: rgba(5, 2, 16, 0.5);
}

.pcd-predesign-template-two .pcd-over-lay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: #0C0C0C;
    opacity: 0.3;
    top: 0;
    right: 0;
    left: 0;
    bottom: 0;
}

.pcd-predesign-template-two .pcd-over-lay:hover{
    background-color: transparent;
}


/* pre-design templates three*/

.pcd-predesign-template-three .pcd-slide-product-count {
    position: absolute;
    top: 0;
    left: 0;
    margin: 10px;
}

.pcd-predesign-template-three .pcd-slide-product-count a {
    padding: 3px 8px 4px 8px;
    background-color: #464444d6;
    border-radius: 20px;
    color: #ffffff;
}

.pcd-predesign-template-three .pcd-grid-cat--details {
    display: flex;
    justify-content: space-between;
    padding: 10px;
    position: absolute;
    bottom: 0;
    background-color: #2a2828c7;
    width: 100%;
}

.pcd-predesign-template-three .pcd-grid-cat--details .pcd-category-name {
    color: #ffffff;
    font-style: normal;
    font-weight: 700;
    font-size: 20px;
    line-height: 33px;
}

.pcd-predesign-template-three .pcd-grid-cat--details  .pcd-category-name {
    display: block;
    padding: 4px 0px 4px 0px;
}