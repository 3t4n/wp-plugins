.tlite {
  background: #111;
  color: white;
  font-family: sans-serif;
  font-size: 0.8rem;
  font-weight: normal;
  text-decoration: none;
  text-align: left;
  padding: 0.6em 0.75rem;
  border-radius: 4px;
  position: absolute;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.4s;
  white-space: nowrap;
  box-shadow: 0 0.5rem 1rem -0.5rem black;
  z-index: 1000;
  -webkit-backface-visibility: hidden;
}

.tlite-table td,
.tlite-table th {
  position: relative;
}

.tlite-visible {
  visibility: visible;
  opacity: 0.9;
}

.tlite::before {
  content: " ";
  display: block;
  background: inherit;
  width: 10px;
  height: 10px;
  position: absolute;
  transform: rotate(45deg);
}

.tlite-n::before {
  top: -3px;
  left: 50%;
  margin-left: -5px;
}

.tlite-nw::before {
  top: -3px;
  left: 10px;
}

.tlite-ne::before {
  top: -3px;
  right: 10px;
}

.tlite-s::before {
  bottom: -3px;
  left: 50%;
  margin-left: -5px;
}

.tlite-se::before {
  bottom: -3px;
  right: 10px;
}

.tlite-sw::before {
  bottom: -3px;
  left: 10px;
}

.tlite-w::before {
  left: -3px;
  top: 50%;
  margin-top: -5px;
}

.tlite-e::before {
  right: -3px;
  top: 50%;
  margin-top: -5px;
}

.plugin-install-php .wp-filter.giveasap-integration-filters {
  margin-bottom: 20px;
}

.sg-plugin-card .plugin-card-top {
  padding-bottom: 30px;
}

.integration-categories {
  position: absolute;
  bottom: 10px;
  right: 20px;
}
.integration-categories a {
  display: inline-block;
  padding: 2px 5px;
  text-align: right;
  border-radius: 3px;
  color: black;
  font-size: 9px;
  text-transform: uppercase;
  background: rgba(0, 0, 0, 0.05);
  margin: 0 2px;
}

.sg-tooltip {
  position: relative;
}

.sg-code-editor-container .CodeMirror-line {
  padding-left: 30px;
}

.sg-about-page .section-content {
  justify-content: space-around;
}
.sg-about-page .section-item .section-image {
  height: 135px;
  display: block;
  width: 100%;
  text-align: center;
  box-sizing: border-box;
}
.sg-about-page .section-item .section-image img {
  max-height: 100%;
  max-width: 100%;
  width: auto;
  height: auto;
}
.sg-about-page .section-item .inline-svg {
  text-align: center;
  background: #61ce70;
  padding: 1em;
  border-radius: 3px;
}
.sg-about-page .section-item .inline-svg.purple {
  background: #a46497;
}
.sg-about-page .section-item .inline-svg .fal,
.sg-about-page .section-item .inline-svg .fab {
  color: rgba(255, 255, 255, 0.75);
}

.sortable_wordpress_gallery li.attachment {
  width: 141px;
  height: 141px;
}

.sortable_wordpress_gallery {
  display: block;
}

.sortable_wordpress_gallery:after {
  display: table;
  content: "";
  clear: both;
}

#giveasap_display .form-table tbody td:last-child {
  width: 200px;
}

#giveasap_display .wp-picker-open + .wp-picker-input-wrap {
  display: block;
}

#giveasap_display .iris-picker.iris-border {
  margin-left: -100px;
}

#giveasap_schedule .datepicker {
  display: block !important;
}

/** Settings **/
#giveasap_settings textarea {
  width: 100%;
  min-height: 100px;
}

.sg-form-table input:not([type=checkbox]):not([type=radio]),
.sg-form-table select,
.sg-form-table textarea {
  width: 100%;
}
.sg-form-table td {
  vertical-align: top;
}
.sg-form-table th {
  padding: 10px;
  background: #F1F1F4;
  box-shadow: 1px 1px 1px rgba(0, 0, 0, 0.1);
}
.sg-form-table th:not(:last-child) {
  border-right: 1px solid rgba(0, 0, 0, 0.075);
}
.sg-form-table .sg-form-field-option {
  display: flex;
}
.sg-form-table .sg-form-field-option .button {
  margin-left: 10px;
}
.sg-form-table .handle-column {
  width: 50px;
}
.sg-form-table .sg-form-row-handle {
  width: 30px;
  height: 30px;
  display: block;
  line-height: 30px;
  margin-left: 10px;
  background: rgba(0, 0, 0, 0.05);
  cursor: move;
  text-align: center;
  border-radius: 3px;
}

/** Users **/
.wp-list-table.users .column-entries {
  position: relative;
}

.wp-list-table.users .column-entries .button:not(.hidden),
.wp-list-table.users .column-entries .giveasap-edit-user-input,
.wp-list-table.users .column-entries .giveasap-user-entries:not(.hidden),
.wp-list-table.users .column-entries .upgrade-link {
  display: inline-block;
  vertical-align: middle;
}

.wp-list-table.users .column-entries .button {
  margin-left: 5px;
}

.sg-subscriber-data {
  display: flex;
}
.sg-subscriber-data .sg-subscriber-entries {
  font-size: 5em;
  text-align: center;
}

.sg-badge.sg-status {
  display: inline-block;
  padding: 0.25em 0.5em;
  background-color: #a46497;
  color: #fff;
  border-radius: 3px;
}
.sg-badge.sg-status.sg-status-blocked {
  background-color: #d20000;
}
.sg-badge.sg-status.sg-status-pending {
  background-color: rgba(164, 100, 151, 0.5);
}
.sg-badge.sg-entries-status {
  text-transform: uppercase;
}
.sg-badge.sg-entries-status.sg-status-invalid {
  background-color: #d20000;
}
.sg-badge.sg-entries-status.sg-status-valid {
  background-color: rgba(164, 100, 151, 0.5);
}

.wp-core-ui .button.sg-button-red {
  color: #d20000;
}

/** Giveaway Sharing Methods **/
.giveaway-sharing-method:not(:last-child) {
  margin-bottom: 1em;
}
.giveaway-sharing-method .method-header {
  background: #f1f1f1;
  padding: 5px 10px;
  line-height: 28px;
  font-weight: 600;
  cursor: pointer;
  border: 1px solid rgba(0, 0, 0, 0.05);
  -webkit-box-shadow: 0px 1px 1px rgba(0, 0, 0, 0.15);
  -moz-box-shadow: 0px 1px 1px rgba(0, 0, 0, 0.15);
  box-shadow: 0px 1px 1px rgba(0, 0, 0, 0.15);
}
.giveaway-sharing-method .method-header:after {
  content: "";
  display: table;
  clear: both;
}
.giveaway-sharing-method .method-header .button {
  float: right;
}
.giveaway-sharing-method.active .method-header {
  border-bottom: 1px solid rgba(0, 0, 0, 0.15);
}
.giveaway-sharing-method.active .method-form {
  display: block;
}
.giveaway-sharing-method .method-form {
  display: none;
  padding: 10px;
  box-shadow: 0px 1px 1px rgba(0, 0, 0, 0.25);
}

/**
Giveaway Post
 */
.giveasap-winner-picker {
  margin-bottom: 1em;
}

.giveasap-winner-picker-options {
  padding: 10px;
  background: rgba(0, 0, 0, 0.05);
  margin-top: 10px;
}
.giveasap-winner-picker-options p {
  margin: 0;
  margin-bottom: 10px;
  font-style: italic;
  font-size: 0.875em;
  text-align: center;
}
.giveasap-winner-picker-options select {
  height: 40px;
  line-height: 40px;
}
.giveasap-winner-picker-options select:not(:last-child) {
  margin-bottom: 10px;
}

#sg-metaboxes.postbox .inside {
  padding: 0;
  margin-top: 0;
}
#sg-metaboxes.postbox .inside .sg-metaboxes {
  clear: both;
  display: flex;
}
#sg-metaboxes.postbox .inside .sg-metaboxes:after {
  display: table;
  content: "";
  clear: both;
}
#sg-metaboxes.postbox .inside .sg-metaboxes > ul {
  width: 30%;
  max-width: 200px;
  margin: 0;
  padding: 0;
  background: rgba(164, 100, 151, 0.2);
}
#sg-metaboxes.postbox .inside .sg-metaboxes > ul li {
  margin: 0;
}
#sg-metaboxes.postbox .inside .sg-metaboxes > ul li a {
  display: block;
  color: #663c5e;
  padding: 0.5em;
  text-decoration: none;
  border-bottom: 1px solid rgba(164, 100, 151, 0.25);
}
#sg-metaboxes.postbox .inside .sg-metaboxes > ul li a .sg-metabox-icon {
  font-size: 1em;
  width: 20px;
  height: 20px;
  display: inline-block;
  vertical-align: middle;
  line-height: 16px;
}
#sg-metaboxes.postbox .inside .sg-metaboxes > ul li.active a {
  background: rgba(164, 100, 151, 0.6);
  color: white;
  border-bottom-color: #a46497;
}
#sg-metaboxes.postbox .inside .sg-metaboxes .sg-metaboxes-fields {
  width: 100%;
  padding: 1em;
}
#sg-metaboxes.postbox .inside .sg-metaboxes .sg-metaboxes-fields .hidden {
  display: none !important;
}
#sg-metaboxes.postbox .inside .sg-metaboxes .sg-metaboxes-fields .form-table {
  margin: 0;
}
#sg-metaboxes.postbox .inside .sg-metaboxes .sg-metaboxes-fields .form-table th {
  width: 100px;
}
@media screen and (min-width: 960px) {
  #sg-metaboxes.postbox .inside .sg-metaboxes .sg-metaboxes-fields .form-table th {
    width: 150px;
  }
}
#sg-metaboxes.postbox .inside .sg-metaboxes .sg-metaboxes-fields .sg-extra-action {
  padding: 0.5em 0;
}
#sg-metaboxes.postbox .inside .sg-metaboxes .sg-metaboxes-fields .sg-extra-action:not(:last-child) {
  border-bottom: 1px solid rgba(0, 0, 0, 0.15);
}

/** Dashboard **/
#sg-dashboard-widget ul {
  margin: 0;
  padding: 0;
  display: flex;
  flex-flow: row wrap;
}
#sg-dashboard-widget ul:after {
  display: table;
  clear: both;
  content: "";
}
#sg-dashboard-widget ul * {
  box-sizing: border-box;
}
#sg-dashboard-widget ul li {
  list-style: none;
  text-align: center;
  padding: 1em 0.5em;
  width: 50%;
  margin: 0;
  border-bottom: 1px solid rgba(0, 0, 0, 0.1);
}
#sg-dashboard-widget ul li:nth-child(2n+1) {
  border-right: 1px solid rgba(0, 0, 0, 0.1);
}
#sg-dashboard-widget ul li .sg-red {
  color: #bd081c;
}
#sg-dashboard-widget ul li strong {
  display: block;
  height: 30px;
  font-size: 2em;
}
#sg-dashboard-widget ul li i {
  margin-right: 10px;
  color: #a46497;
}
#sg-dashboard-widget ul li i.sg-red-icon {
  color: #bd081c;
}
#sg-dashboard-widget ul li em {
  display: block;
  font-size: 0.75em;
}

/** SG Notices **/
.sg-notice {
  background: #a46497;
  color: white;
  padding: 1em;
}

/** Forms **/
.sg-admin-form {
  padding: 1em;
}
.sg-admin-form .sg-form-field {
  display: flex;
  align-items: center;
  padding-bottom: 1em;
}
.sg-admin-form .sg-form-field label {
  width: 200px;
}

.sg-form-fields-container .sg-form-field,
.sg-prizes-field-container .sg-form-field {
  margin-bottom: 15px;
}
.sg-form-fields-container .sg-form-field:not(.open) .sg-form-field-body,
.sg-prizes-field-container .sg-form-field:not(.open) .sg-form-field-body {
  display: none;
}
.sg-form-fields-container .sg-form-field:not(.open) .sg-form-field-header .sg-field-name:after,
.sg-prizes-field-container .sg-form-field:not(.open) .sg-form-field-header .sg-field-name:after {
  border-top-color: rgba(0, 0, 0, 0.5);
  top: 12px;
}
.sg-form-fields-container .sg-form-field.open .sg-form-field-header .sg-field-name:after,
.sg-prizes-field-container .sg-form-field.open .sg-form-field-header .sg-field-name:after {
  border-bottom-color: rgba(0, 0, 0, 0.5);
  bottom: 12px;
}
.sg-form-fields-container .sg-form-field .sg-form-field-header,
.sg-prizes-field-container .sg-form-field .sg-form-field-header {
  display: flex;
  height: 40px;
  align-items: center;
  background: white;
  border: 1px solid rgba(0, 0, 0, 0.15);
}
.sg-form-fields-container .sg-form-field .sg-form-field-header .sg-field-name,
.sg-prizes-field-container .sg-form-field .sg-form-field-header .sg-field-name {
  line-height: 30px;
  height: 30px;
  width: calc(100% - 30px);
  cursor: pointer;
  padding-right: 30px;
  position: relative;
}
.sg-form-fields-container .sg-form-field .sg-form-field-header .sg-field-name:after,
.sg-prizes-field-container .sg-form-field .sg-form-field-header .sg-field-name:after {
  content: "";
  position: absolute;
  border: 5px solid transparent;
  width: 0px;
  height: 0px;
  right: 10px;
}
.sg-form-fields-container .sg-form-field .sg-form-field-header .handle-column,
.sg-prizes-field-container .sg-form-field .sg-form-field-header .handle-column {
  width: 30px;
  height: 30px;
  cursor: pointer;
}
.sg-form-fields-container .sg-form-field .sg-form-field-header .handle-column .sg-form-row-handle,
.sg-prizes-field-container .sg-form-field .sg-form-field-header .handle-column .sg-form-row-handle {
  text-align: center;
  line-height: 30px;
}
.sg-form-fields-container .sg-form-field .sg-form-field-body,
.sg-prizes-field-container .sg-form-field .sg-form-field-body {
  border: 1px solid rgba(0, 0, 0, 0.15);
}
.sg-form-fields-container .sg-form-field .sg-form-table,
.sg-prizes-field-container .sg-form-field .sg-form-table {
  margin: 0;
}

/** Entries Table **/
.sg-subscriber-entries-table .column-value img {
  max-width: 100%;
  height: auto;
}

.post-type-giveasap .mfp-container {
  left: 160px;
  width: calc(100% - 160px);
}

@media only screen and (max-width: 960px) {
  .post-type-giveasap .mfp-container {
    left: 32px;
    width: calc(100% - 32px);
  }
}
@media only screen and (max-width: 782px) {
  .post-type-giveasap .mfp-container {
    left: 0px;
    width: 100%;
  }
}
/** SG Actions **/
.sg-actions-categories {
  box-sizing: border-box;
}
.sg-actions-categories * {
  box-sizing: border-box;
}
.sg-actions-categories .sg-action-category-title {
  line-height: 20px;
  height: 40px;
  font-size: 1em;
  text-transform: uppercase;
  font-weight: 600;
  padding: 10px 1em;
  background: rgba(0, 0, 0, 0.05);
  display: block;
  width: 100%;
  cursor: pointer;
  position: relative;
}
.sg-actions-categories .sg-action-category-title:after {
  content: "";
  position: absolute;
  right: 10px;
  top: 15px;
  width: 0;
  height: 0;
  display: block;
  border: 6px solid transparent;
  border-top-color: #a46497;
}
.sg-actions-categories .sg-actions {
  display: none;
  padding: 1em;
}
.sg-actions-categories .sg-actions li {
  position: relative;
  display: block;
  padding: 15px 15px 15px 60px;
  text-align: left;
  box-shadow: 0px 2px 2px rgba(0, 0, 0, 0.15);
  cursor: pointer;
  margin-bottom: 1em;
}
.sg-actions-categories .sg-actions li .sg-action-icon {
  width: 30px;
  height: 30px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  color: #a46497;
  position: absolute;
  top: 0;
  bottom: 0;
  left: 15px;
  margin: auto;
}
.sg-actions-categories .sg-actions li .button {
  width: 100%;
  white-space: normal;
}
.sg-actions-categories .sg-action-category.active .sg-action-category-title:after {
  border-top-color: transparent;
  border-bottom-color: #a46497;
  top: 10px;
}
.sg-actions-categories .sg-action-category.active .sg-actions {
  display: block;
}

.sg-admin-action:not(:last-child) {
  margin-bottom: 20px;
}
.sg-admin-action .sg-admin-action-title {
  height: 40px;
  line-height: 36px;
  border-radius: 3px;
  background: white;
  padding-right: 40px;
  padding-left: 1em;
  font-weight: 600;
  border: 2px solid #a46497;
  position: relative;
  cursor: pointer;
  margin: 0;
  text-overflow: ellipsis;
  overflow: hidden;
  display: block;
  width: 100%;
  box-sizing: border-box;
  font-size: 14px;
}
.sg-admin-action .sg-admin-action-title:after {
  content: "";
  position: absolute;
  width: 0;
  height: 0;
  border: 4px solid transparent;
  top: 17px;
  right: 10px;
  border-top-color: #a46497;
}
.sg-admin-action .sg-admin-form {
  display: none;
}
.sg-admin-action .sg-admin-form .sg-form-field {
  flex-wrap: wrap;
}
.sg-admin-action .sg-admin-form .sg-form-field label {
  width: 150px;
}
.sg-admin-action .sg-admin-form .sg-form-field .sg-action-input-container {
  width: calc(100% - 150px);
}
.sg-admin-action .sg-admin-form .sg-form-field .select2-container {
  width: 100% !important;
}
.sg-admin-action .sg-admin-form .sg-form-field.sg-form-field-mandatory_specific_actions label {
  vertical-align: top;
}
.sg-admin-action .sg-admin-form .sg-form-field .sg-select-specific-mandatory-actions label {
  width: 100%;
  display: block;
}
.sg-admin-action .sg-admin-form .sg-form-field .sg-select-specific-mandatory-actions label:not(:last-child) {
  margin-bottom: 10px;
}
.sg-admin-action .sg-admin-form .sg-multioption-input {
  display: flex;
}
.sg-admin-action .sg-admin-form .sg-multioption-input .button {
  width: 30px;
  margin-left: 10px;
}
.sg-admin-action:not(.active).sg-admin-action-with-errors .sg-admin-action-title {
  color: #d20000;
}
.sg-admin-action.active {
  box-shadow: 0px 2px 5px rgba(0, 0, 0, 0.15);
}
.sg-admin-action.active .sg-admin-form {
  display: block;
  border: 1px solid #a46497;
}
.sg-admin-action.active .sg-admin-action-title {
  background: #a46497;
  color: white;
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
}
.sg-admin-action.active .sg-admin-action-title:after {
  border-top-color: transparent;
  border-bottom-color: white;
  top: auto;
  bottom: 15px;
}

/** SG Reports **/
.sg-report-options {
  background: rgba(0, 0, 0, 0.035);
  padding: 1em;
}
.sg-report-options .sg-report-filter {
  position: relative;
  width: 100%;
  margin-bottom: 1em;
}
.sg-report-options .sg-report-filter input:not([type=checkbox]):not([type=radio]),
.sg-report-options .sg-report-filter select {
  width: 100%;
  display: block;
  padding: 20px 10px 10px 10px;
  height: 50px;
}
.sg-report-options .sg-report-filter label {
  position: absolute;
  top: 5px;
  left: 10px;
  opacity: 0.75;
  font-size: 0.75em;
  text-transform: uppercase;
}
.sg-report-options .sg-report-filter label.static {
  position: static;
}
.sg-report-options .sg-button {
  width: 100%;
  display: block;
  text-align: center;
  background: #a46497;
  color: white;
  transition: all 0.4s ease-in-out;
  cursor: pointer;
  height: 40px;
  line-height: 40px;
  text-transform: uppercase;
  padding: 0;
}
.sg-report-options .sg-button:hover {
  background: #ad74a2;
}

.sg-report-view .sg-report-container {
  position: relative;
  width: 100%;
}
.sg-report-view.with-options {
  display: flex;
}
.sg-report-view.with-options .sg-report-options {
  width: 240px;
}
.sg-report-view.with-options .sg-report-container {
  width: calc(100% - 240px);
}

.subsubsub {
  width: 100%;
  margin-bottom: 10px;
  float: none;
}
.subsubsub:after {
  content: "";
  display: table;
  clear: both;
}
.subsubsub li {
  padding: 0 10px;
}
.subsubsub li:not(:last-child) {
  border-right: 1px solid rgba(0, 0, 0, 0.05);
}

.sg-report-options-switch {
  width: 100px;
  height: 50px;
  background: #a46497;
  color: white;
  position: relative;
  overflow: hidden;
  border-radius: 5px;
}
.sg-report-options-switch .data-on,
.sg-report-options-switch .data-off {
  box-sizing: border-box;
  position: absolute;
  top: 0;
  padding: 5px;
  height: 50px;
  width: 100%;
  transition: all 0.4s ease;
  display: flex;
  justify-content: space-between;
  line-height: 40px;
}
.sg-report-options-switch .data-on span,
.sg-report-options-switch .data-off span {
  width: 50%;
  text-align: center;
  border-radius: 5px;
  cursor: pointer;
}
.sg-report-options-switch .data-on span.selected,
.sg-report-options-switch .data-off span.selected {
  color: #a46497;
  background: white;
}
.sg-report-options-switch.on .data-on {
  left: 0;
}
.sg-report-options-switch.on .data-off {
  left: 100%;
}
.sg-report-options-switch:not(.on) .data-on {
  left: -100%;
}
.sg-report-options-switch:not(.on) .data-off {
  left: 0;
}

/** SG Settings **/
.giveasap-settings-header {
  display: flex;
  align-items: center;
  background: white;
  padding: 20px;
  margin-left: -20px;
  font-size: 30px;
  line-height: 30px;
  font-weight: 600;
}
.giveasap-settings-header img {
  max-width: 80px;
  display: block;
}

.giveasap-settings-subheader {
  padding: 20px;
  margin-left: -20px;
  color: white;
  background: #a46497;
  font-weight: 400;
}
.giveasap-settings-subheader h2,
.giveasap-settings-subheader p {
  color: white;
}
.giveasap-settings-subheader h2 {
  margin: 0;
  font-size: 24px;
  font-weight: 400;
}
.giveasap-settings-subheader p {
  margin: 10px 0 0 0;
  font-style: italic;
}

.giveasap_page_giveasap_settings .update-nag,
.giveasap_page_giveasap_settings .notice,
.giveasap_page_giveasap_integrations .update-nag,
.giveasap_page_giveasap_integrations .notice,
.giveasap_page_sg_reports .update-nag,
.giveasap_page_sg_reports .notice {
  display: none;
}
.giveasap_page_giveasap_settings #screen-meta-links,
.giveasap_page_giveasap_integrations #screen-meta-links,
.giveasap_page_sg_reports #screen-meta-links {
  display: none;
}

#sg-metaboxes .CodeMirror-linenumber {
  margin-left: -28px;
}

.sg-loading {
  position: relative;
}
.sg-loading:before, .sg-loading:after {
  content: "";
  position: absolute;
}
.sg-loading:before {
  height: 100%;
  width: 100%;
  background: rgba(0, 0, 0, 0.45);
  top: 0;
  left: 0;
  z-index: 10;
}
.sg-loading:after {
  display: block;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  border: 6px solid #fff;
  border-color: #fff #a46497 #fff #a46497;
  animation: sg-dual-ring 1.2s linear infinite;
  z-index: 12;
  position: absolute;
  top: 0;
  left: 0;
  margin: auto;
  bottom: 0;
  right: 0;
}

@keyframes sg-dual-ring {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

