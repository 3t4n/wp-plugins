#: templates/admin.php:13
msgid ""
"Use <strong>\"[csl-search pageid=\"your store listing page id\"]\"</strong> "
"shortcode on page for displaying search widget in page where \"your store "
"listing page id\" is page id of store listing page which contains  \"[csl-"
"store-list]\" shortcode. For example, [csl-search pageid=\"5226\"] ."
msgstr ""
"Use <strong>\"[csl-search pageid=\"el ID de la página de su ficha de "
"tienda\"]\"</strong> en la página para mostrar el widget de búsqueda en la "
"página donde \"la ID de la página de su ficha de tienda\" es la ID de la "
"página de la ficha de tienda que contiene Código abreviado \"[csl-store-list]"
"\". Por ejemplo, [csl-search pageid=\"5226\"] ."

#: templates/admin.php:15
msgid ""
"Use <strong>\"[csl-store-list category=\"your category slug\"]\"</strong> "
"shortcode on page for displaying store list along with map for specific "
"category"
msgstr ""
"Use <strong>\"[csl-store-list category=\"your category slug\"]\"</strong> "
"shortcode en la página para mostrar la lista de tiendas junto con el mapa "
"para una categoría específica"

#: templates/admin.php:11
msgid ""
"Use <strong>\"[csl-store-list]\"</strong> shortcode on page for displaying "
"store list along with map"
msgstr ""
"Use el código abreviado <strong>\"[csl-store-list]\"</strong> en la página "
"para mostrar la lista de tiendas junto con el mapa"

