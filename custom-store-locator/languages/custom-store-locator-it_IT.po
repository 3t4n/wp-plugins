#: templates/admin.php:13
msgid ""
"Use <strong>\"[csl-search pageid=\"your store listing page id\"]\"</strong> "
"shortcode on page for displaying search widget in page where \"your store "
"listing page id\" is page id of store listing page which contains  \"[csl-"
"store-list]\" shortcode. For example, [csl-search pageid=\"5226\"] ."
msgstr ""
"Utilizza lo shortcode <strong>\"[csl-search pageid=\"your store listing page "
"id\"]\"</strong> sulla pagina per visualizzare il widget di ricerca nella "
"pagina in cui \"your store listing page id\" è l'id della pagina della "
"scheda dello store che contiene Codice funzione \"[csl-store-list]\". Ad "
"esempio, [csl-search pageid=\"5226\"] ."

#: templates/admin.php:15
msgid ""
"Use <strong>\"[csl-store-list category=\"your category slug\"]\"</strong> "
"shortcode on page for displaying store list along with map for specific "
"category"
msgstr ""
"Utilizza lo shortcode <strong>\"[csl-store-list category=\"your category "
"slug\"]\"</strong> sulla pagina per visualizzare l'elenco dei negozi insieme "
"alla mappa per una categoria specifica"

#: templates/admin.php:11
msgid ""
"Use <strong>\"[csl-store-list]\"</strong> shortcode on page for displaying "
"store list along with map"
msgstr ""
"Utilizza lo shortcode <strong>\"[csl-store-list]\"</strong> sulla pagina per "
"visualizzare l'elenco dei negozi insieme alla mappa"

