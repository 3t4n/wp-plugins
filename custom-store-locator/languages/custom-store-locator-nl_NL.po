#: templates/admin.php:13
msgid ""
"Use <strong>\"[csl-search pageid=\"your store listing page id\"]\"</strong> "
"shortcode on page for displaying search widget in page where \"your store "
"listing page id\" is page id of store listing page which contains  \"[csl-"
"store-list]\" shortcode. For example, [csl-search pageid=\"5226\"] ."
msgstr ""
"Gebruik <strong>\"[csl-search pageid=\"uw winkelvermelding pagina-id\"]"
"\"</strong> shortcode op de pagina om de zoekwidget weer te geven op de "
"pagina waar \"uw winkelvermelding pagina-ID\" de pagina-ID is van de "
"winkelvermeldingspagina die bevat \"[csl-store-list]\" shortcode. "
"Bijvoorbeeld [csl-search pageid=\"5226\"] ."

#: templates/admin.php:15
msgid ""
"Use <strong>\"[csl-store-list category=\"your category slug\"]\"</strong> "
"shortcode on page for displaying store list along with map for specific "
"category"
msgstr ""
"Gebruik <strong>\"[csl-store-list category=\"your category slug\"]\"</strong>"
" shortcode op de pagina om de winkellijst samen met de kaart voor een "
"specifieke categorie weer te geven"

#: templates/admin.php:11
msgid ""
"Use <strong>\"[csl-store-list]\"</strong> shortcode on page for displaying "
"store list along with map"
msgstr ""
"Gebruik de shortcode <strong>\"[csl-store-list]\"</strong> op de pagina om "
"de winkellijst samen met de kaart weer te geven"

