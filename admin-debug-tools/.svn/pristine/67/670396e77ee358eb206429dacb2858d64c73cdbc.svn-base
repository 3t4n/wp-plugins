	// Reset the height of the body to allow the content to fill the viewport.
	#wpcontent {
		height: calc(100vh - var(--wp-admin--admin-bar--height, 32px) - var(--wp-admin--footer--height, 40px));
		padding: 0 0 var(--wp-admin--footer--height, 40px);

