msgid "First page"
msgstr "Prima pagina"

#: dn-sitemap-control.php:89
msgid "Previous page"
msgstr "Pagina precedente"

#: dn-sitemap-control.php:92
msgid "Current page"
msgstr "Pagina corrente"

#: dn-sitemap-control.php:95
msgid "Next page"
msgstr "Pagina successiva"

#: dn-sitemap-control.php:96
msgid "Last page"
msgstr "Ultima pagina"

