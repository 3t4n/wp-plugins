msgid "Select all"
msgstr "Seleziona tutti"

#: dn-sitemap-control.php:110
msgid "Deselect all"
msgstr "Deseleziona tutti"

#: dn-sitemap-control.php:111
msgid "Update"
msgstr "Aggiorna"

#: dn-sitemap-control.php:125
msgid "Item deleted"
msgstr "Elemento eliminato"

#: dn-sitemap-control.php:135
msgid "sitemap moved in uploads/sitemaps"
msgstr "Sitemap spostata in uploads/sitemaps"

#: dn-sitemap-control.php:137
msgid "sitemap deleted"
msgstr "Sitemap eliminata"

#: dn-sitemap-control.php:139
msgid "sitemap.xml not found"
msgstr "sitemap.xml non trovata"

#: dn-sitemap-control.php:179
msgid "Put this element in sitemap"
msgstr "Inserisci elemento nella sitemap"

#: dn-sitemap-control.php:187
msgid "Middle (0.5)"
msgstr "Media (0.5)"

#: dn-sitemap-control.php:188
msgid "Low (0.2)"
msgstr "Bassa (0.2)"

