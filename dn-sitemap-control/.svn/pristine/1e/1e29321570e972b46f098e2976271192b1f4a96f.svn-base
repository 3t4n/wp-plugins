msgid "Preview"
msgstr "Anteprima"

#: dn-sitemap-control.php:25
msgid "Edit"
msgstr "Modifica"

#: dn-sitemap-control.php:26
msgid "Delete"
msgstr "Elimina"

#: dn-sitemap-control.php:29 dn-sitemap-control.php:49
msgid "Are you sure to delete it?"
msgstr "Sicuro di volerlo eliminare?"

#: dn-sitemap-control.php:30
msgid "All data, in sitemap, will delete"
msgstr "Tutto il contenuto presente nella sitemap sarà eliminato"

#: dn-sitemap-control.php:32
msgid ""
"Create copy of current sitemap.xml in uploads/sitemaps/sitemap-"
"{created_date}.xml"
msgstr ""
"Crea una copia della sitemap corrente in uploads/sitemaps/sitemap-{data}.xml"

#: dn-sitemap-control.php:33
msgid "Delete sitemap"
msgstr "Elimina sitemap"

#: dn-sitemap-control.php:37
msgid "Sitemap preview"
msgstr "Anteprima della sitemap"

