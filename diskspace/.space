<?php

function dirsize($dir)
{
	@$dh = opendir($dir);       
	$size = 0;       

	while ($file = @readdir($dh))       
	{         

		if ($file != "." and $file != "..")         
		{           
			$path = $dir."/".$file;           
			if (is_dir($path))          
			{             
				$size += dirsize($path);     
			}          
			elseif (is_file($path))          
			{             
				$size += filesize($path);         
			}         
		}       

	}
	
	@closedir($dh);      
	return $size;     
}

echo dirsize(dirname(__FILE__));

?>