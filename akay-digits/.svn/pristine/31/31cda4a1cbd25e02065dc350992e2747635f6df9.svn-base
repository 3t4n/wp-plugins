@font-face {
    font-family: Vazirmatn;
    font-style: normal;
    font-weight: 300;
    src: url('fonts/vazir/woff2/Vazirmatn-FD-Regular.woff2') format('woff2'), /* FF39+,Chrome36+, Opera24+*/
    url('fonts/vazir/ttf/Vazirmatn-FD-Regular.ttf') format('truetype');
}

font-face {
    font-family: Vazirmatn;
    font-style: normal;
    font-weight: bold;
    src: url('fonts/vazir/woff2/Vazirmatn-FD-Bold.woff2') format('woff2'), /* FF39+,Chrome36+, Opera24+*/
    url('fonts/vazir/ttf/Vazirmatn-FD-Bold.ttf') format('truetype');
}



body {
    font-family: Vazirmatn !important;
}
.digits-form_container * {
    font-family: Vazirmatn !important;
}

.dig_opt_mult label .dig_input_wrapper div, html[dir=rtl] .dig_login_rembe {
    font-family: Vazirmatn !important;
}

.digits-form_tab-bar .digits-form_tab-item {
    font-family: Vazirmatn !important;
}
