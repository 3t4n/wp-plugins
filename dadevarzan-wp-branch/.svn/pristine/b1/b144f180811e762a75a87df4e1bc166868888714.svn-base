#dv-branch-items .uabb-blog-post-content{position:relative;border:1px solid #d0cfb4;border-radius:8px;}
#dv-branch-items .uabb-post-wrapper .dv-post-categories{
    position:absolute;z-index:2;top:5px;right:0px;background-color:#ff9000;
    padding: 5px;border-top-left-radius:5px;border-bottom-left-radius:5px;
}
#dv-branch-items .uabb-post-wrapper .dv-post-categories .dv-tax{list-style:none;padding:0;margin:0;}
#dv-branch-items .uabb-post-wrapper .dv-post-categories .dv-tax li{display:inline-block;}
#dv-branch-items .uabb-post-wrapper .dv-post-categories .dv-tax li:before{
    content:"/"; display: inline-block;margin: 0 5px;
}
#dv-branch-items .uabb-post-wrapper .dv-post-categories .dv-tax li:first-child:before{display:none;}
#dv-branch-items .uabb-post-wrapper .dv-post-categories .dv-tax li a{color:#ffffff;}
#dv-branch-items .uabb-post-wrapper .uabb-post-thumbnail{position:relative;}
#dv-branch-items .uabb-post-wrapper .uabb-post-thumbnail:after{
    display: block; content:"";
    position: absolute;left: 0;right: 0;top: 0;bottom: 0;
    background-color: #000000;
    background-color: rgba(0,0,0,0.5);
    transition: 0.3s ease;
    transform: rotate(90deg);
    transform-origin: 0 0;
}
#dv-branch-items .uabb-post-wrapper:hover .uabb-post-thumbnail:after{
    transform: rotate(0deg);
    
