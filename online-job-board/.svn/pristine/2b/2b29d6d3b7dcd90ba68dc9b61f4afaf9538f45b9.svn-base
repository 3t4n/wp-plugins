/*wfojb button*/
.wfojb-button.disabled {
    pointer-events: none;
    opacity: 0.5;
    color: #999;
    cursor: not-allowed;
}

.wfojb-button {
    display: inline-block;
    padding: 5px 15px;
    background-color: #28a745; /* Green background */
    color: #ffffff; /* White text */
    font-size: 20px;
    font-weight: bold;
    text-align: center;
    text-decoration: none !important;
    border-radius: 5px;
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease;
}

.wfojb-button:hover {
    background-color: #218838; /* Darker green on hover */
    color: #ffffff; /* White text */
}

.wfojb-close {
  display: inline-block;
  padding: 5px 15px;
  background-color: #ed2c2c; /* red background */
  color: #ffffff; /* White text */
  font-size: 20px;
  font-weight: bold;
  text-align: center;
  text-decoration: none !important;
  border-radius: 5px;
  border: none;
  cursor: pointer;
  transition: background-color 0.3s ease;
}
.wfojb-close:hover {
  background-color: #b91111; /* Darker red on hover */
  color: #ffffff; /* White text */
}



/*image logo*/
img.wfojb_logo {
width: 500px;
}

/*loading Spinner*/
.spinner {
    border: 8px solid #f3f3f3;
    border-top: 8px solid #3498db;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    animation: spin 1s linear infinite;
}

@keyframes spin {
    0% {
        transform: rotate(0deg);
    }

    100% {
        transform: rotate(360deg);
    }
}

#loading-spinner {
    display:none;
    text-align: center;
    margin: 20px 0;
}

/*layout 1*/
/*Container*/
div.wfojb-main {
  margin-top: 20px;
  margin-bottom: 20px;
  padding: 15px;
  border-radius: 5px;
  border: 1px solid #69666670;
  box-shadow: 0 0 20px rgba(0, 0, 0, 0.3);
}

.wfojb-custom p {
  margin-bottom: 5px;
}
.wfojb-custom h3 {
  margin-bottom: 10px;
  font-weight: 700;
}

/*layout 2*/
/* Included color classes.. 
  .red 
  .blue 
  .orange
*/
@import url(https://fonts.googleapis.com/css?family=Raleway:400,800);
figure.snip1171 {
  font-family: 'Raleway', Arial, sans-serif;
  position: relative;
  overflow: hidden;
  border: 10px solid #000;  
  background: #000000;
  color: #333;
  text-align: left;
  box-shadow: 0 0 5px rgba(0, 0, 0, 0.15);
}
figure.snip1171 * {
  -webkit-box-sizing: border-box;
  box-sizing: border-box;
  -webkit-transition: all 0.35s cubic-bezier(0.25, 0.5, 0.5, 0.9);
  transition: all 0.35s cubic-bezier(0.25, 0.5, 0.5, 0.9);
}
figure.snip1171 img {
  width: 720px;
  margin-bottom: 10px;
}
figure.snip1171 custom {
  position: relative;  
}
figure.snip1171 figcaption {
  position: relative;
  background-color: #ffffff;
  padding: 10px 10px 50px;
  font-size: 24px;
}
.ojbcustom {
  position: relative;
}
.ojbcustom-section {
  position: relative;
}


figure.snip1171 h3 {
  position: absolute;
  text-transform: uppercase;
  padding: 5px 5px;
  margin: 0;
  left: 0;
  bottom: 0;
  font-weight: 600;
  font-size: 20px;
  background-color: #000000;
  color: #ffffff;
}

figure.snip1171 h3 span {
  font-weight: 800;
}
figure.snip1171 h3:before {
  position: absolute;
  left: 100%;
  border-style: solid;
  border-width: 30px 0px 0px 30px;
  border-color: transparent transparent transparent #000000;
  content: '';
  top: 0;
}

figure.snip1171 h4:before {
  position: absolute;
  left: 100%;
  border-style: solid;
  border-width: 31px 0 0 20px;
  border-color: transparent transparent transparent #000000;
  content: '';
  top: 0;
}
figure.snip1171 p {
  font-size: 0.8em;
  font-weight: 500;
  text-align: left;
  margin: 0;
  line-height: 1.6em;
}
figure.snip1171 .price {
  position: absolute;
  top: 0;
  color: #ffffff;
  background-color: #000000;
  padding: 0 10px;
  line-height: 35px;
  font-weight: 700;
  font-size: 25px;
}
figure.snip1171 .price:before {
  position: absolute;
  left: 100%;
  border-style: solid;
  border-width: 0px 0px 35px 25px;
  border-color: transparent #000000 transparent;
  content: '';
  top: 0;
}
figure.snip1171 a {
  text-decoration: none;
  position: absolute;
  bottom: 0;
  right: 0;
  background-color: #000000;
  line-height: 40px;
  padding: 0 10px;
  color: #ffffff;
  font-weight: 800;
  font-size: 0.9em;
  text-transform: uppercase;
}
figure.snip1171 a:before {
  position: absolute;
  right: 100%;
  border-style: solid;
  border-width: 0px 0 50px 30px;
  border-color: transparent transparent #000000;
  content: '';
  top: 0;
}
.snip1171-custom {
  color: white !important;
  font-size: 25px;
}
.snip1171-custom p {
  color: white !important;
  font-size: 25px;
}


/*layout 3*/
@import url(https://code.ionicframework.com/ionicons/2.0.1/css/ionicons.min.css);
@import url(https://fonts.googleapis.com/css?family=Raleway:400,500,600);
figure.snip1195 {
  font-family: 'Raleway', Arial, sans-serif;
  position: relative;
  overflow: hidden;
  width: 100%;
  background: #1a1a1a;
  color: #ffffff;
  text-align: center;
  border-radius: 8px;
  box-shadow: 0 0 5px rgba(0, 0, 0, 0.15);
}
figure.snip1195 * {
  -webkit-box-sizing: border-box;
  box-sizing: border-box;
  -webkit-transition: all 0.35s ease;
  transition: all 0.35s ease;
}
figure.snip1195 .image {
  background-color: #000000;
  width: 34%;
  overflow: hidden;
}
figure.snip1195 img {
  max-width: 100%;
  vertical-align: top;
}
figure.snip1195 figcaption {
  position: absolute;
  width: 33%;
  right: 0;  
  -webkit-transform: translateY(-50%);
  transform: translateY(-50%);
  padding: 10px 15px;
}
figure.snip1195 h4,
figure.snip1195 p,
figure.snip1195 .price {
  margin: 0 0 8px;
}
figure.snip1195 h4 {
  position: absolute;
  width: 34%;
  top: 10px;
  text-transform: uppercase;
  font-weight: 400;
  color: #ffffff;
  letter-spacing: 1px;
  z-index: 1;
}
figure.snip1195 p {
  font-size: 0.7em;
  font-weight: 500;
  line-height: 1.6em;
}
figure.snip1195 .rating {
  position: absolute;
  width: 34%;
  line-height: 44px;
  color: #ffffff;
  left: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.3);
}
figure.snip1195 .price {
  color: #ffffff;
  font-size: 1.3em;
  opacity: 0.8;
}
figure.snip1195 .price s {
  display: inline-block;
  padding: 0 8px 0 0;
  font-size: 0.85em;
  color: #f39c12;
}
figure.snip1195 .add-to-cart {
  text-decoration: none;
  position: absolute;
  bottom: 0;
  right: 0;
  font-weight: 600;
  width: 33%;
  background-color: rgba(0, 0, 0, 0.2);
  line-height: 44px;
  font-size: 0.75em;
  text-transform: uppercase;
  color: #ffffff;
}
figure.snip1195:hover img,
figure.snip1195.hover img {
  opacity: 0.6;
  -webkit-transform: scale(1.1);
  transform: scale(1.1);
}
figure.snip1195:hover .add-to-cart,
figure.snip1195.hover .add-to-cart {
  background-color: rgba(0, 0, 0, 0.5);
}