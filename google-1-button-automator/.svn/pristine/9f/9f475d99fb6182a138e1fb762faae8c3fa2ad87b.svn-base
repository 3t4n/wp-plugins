# @ googleplusone
#: googleplusone.php:174
msgid "Settings for Google +1 button automator"
msgstr "Ajustes para el automatizador del botón de Google +1"

# @ googleplusone
#: googleplusone.php:178
msgid "Display options"
msgstr "Opciones de mostrado"

# @ googleplusone
#: googleplusone.php:181
msgid ""
"Only show button on single post pages (ea. button doesn't show up in loops)"
msgstr ""
"Solo mostrar el botón en páginas de post simples (ejm. el botón no se "
"muestra en los ciclos)"

# @ googleplusone
#: googleplusone.php:185
msgid "Display style"
msgstr "Estilo de muestra"

# @ googleplusone
#: googleplusone.php:188
msgid "Bottom"
msgstr "Abajo"

# @ googleplusone
#: googleplusone.php:189
msgid "Top"
msgstr "Arriba"

# @ googleplusone
#: googleplusone.php:191
msgid "Show button on top or bottom of post"
msgstr "Mostrar botón por encima o por debajo del post"

# @ googleplusone
#: googleplusone.php:194
msgid "Add break before the button"
msgstr "Adicionar un salto de línea antes del botón"

# @ googleplusone
#: googleplusone.php:197
msgid "Add break after the button"
msgstr "Adicionar un salto de línea después del botón"

# @ googleplusone
#: googleplusone.php:200
msgid ""
"Add a containing div for each button with the classname "
"<i>googlePlusOneButton</i>, use this to style and position the button"
msgstr ""
"Adicionar un div contenedor para cada botón con el nombre de clase "
"<i>googlePlusOneButton</i>, usar esto para estilar y posicionar el botón"

# @ googleplusone
#: googleplusone.php:202
msgid "Width"
msgstr "Ancho"

# @ googleplusone
#: googleplusone.php:203
msgid ""
"Width must be a whole number, and at least 120(pixels). Leave blank if "
"unsure."
msgstr ""
"El ancho debe ser un número completo, y al menos 120(píxeles). Dejar en "
"blanco si no está seguro."

# @ googleplusone
#: googleplusone.php:205
msgid "Size"
msgstr "Tamaño"

# @ googleplusone
#: googleplusone.php:213
msgid "Show count"
msgstr "Mostrar cantidad"

# @ googleplusone
#: googleplusone.php:221
msgid "Disable showing recommendations within the hover window"
msgstr "Deshabilitar la muestra de recomendaciones en la ventana hover"

# @ googleone
#: googleplusone.php:226
msgid "Preview"
msgstr "Vista Previa"

# @ googleplusone
#: googleplusone.php:232
msgid "Advanced options"
msgstr "Opciones avanzadas"

# @ googleplusone
#: googleplusone.php:234
msgid "Language"
msgstr "Lenguaje"

# @ googleplusone
#: googleplusone.php:310
msgid "+1 Annotations are currently only available in US English on Google.com"
msgstr ""
"+1 anotaciones están actualmente disponibles solo en Inglés de US en Google."
"com"

# @ googleplusone
#: googleplusone.php:312
msgid "Parse"
msgstr "Parsear"

# @ googleplusone
#: googleplusone.php:318
msgid "JS Callback function"
msgstr "Función de Callback de JS"

# @ googleplusone
#: googleplusone.php:322
msgid "Turn on asynchronous mode"
msgstr "Encender modo asincrónico"

# @ googleplusone
#: googleplusone.php:325
msgid "HTML5 valid syntax"
msgstr "sintaxis válida HTML5"

# @ googleplusone
#: googleplusone.php:330
msgid "Save Changes"
msgstr "Salvar Cambios"
