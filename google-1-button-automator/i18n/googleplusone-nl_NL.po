#: googleplusone.php:174
#@ googleplusone
msgid "Settings for Google +1 button automator"
msgstr "Instellingen voor Google +1 button automator"

#: googleplusone.php:178
#@ googleplusone
msgid "Display options"
msgstr "Weergave opties"

#: googleplusone.php:181
#@ googleplusone
msgid "Only show button on single post pages (ea. button doesn't show up in loops)"
msgstr "Toon de knop alleen op pagina's waar maar één bericht staat."

#: googleplusone.php:185
#@ googleplusone
msgid "Display style"
msgstr "Weergave stijl"

#: googleplusone.php:188
#@ googleplusone
msgid "Bottom"
msgstr "Onder"

#: googleplusone.php:189
#@ googleplusone
msgid "Top"
msgstr "Boven"

#: googleplusone.php:191
#@ googleplusone
msgid "Show button on top or bottom of post"
msgstr "Toon knop aan de boven- of onderkant van een bericht"

#: googleplusone.php:194
#@ googleplusone
msgid "Add break before the button"
msgstr "Voeg een break toe voor de knop"

#: googleplusone.php:197
#@ googleplusone
msgid "Add break after the button"
msgstr "Voeg een break toe na de knop"

#: googleplusone.php:200
#@ googleplusone
msgid "Add a containing div for each button with the classname <i>googlePlusOneButton</i>, use this to style and position the button"
msgstr "Omsluit elke knop met een container div met de klassenaam <i>googlePlusOneButton</i>, deze kan gebruikt worden voor het stijlen en positioneren van de knop"

#: googleplusone.php:202
#@ googleplusone
msgid "Width"
msgstr "Breedte"

#: googleplusone.php:203
#@ googleplusone
msgid "Width must be a whole number, and at least 120(pixels). Leave blank if unsure."
msgstr "(optioneel) Breedte moet een heel nummer zijn en tenminste 120 (pixels)."

#: googleplusone.php:205
#@ googleplusone
msgid "Size"
msgstr "Afmetingen"

#: googleplusone.php:213
#@ googleplusone
msgid "Show count"
msgstr "Toon teller"

#: googleplusone.php:221
#@ googleplusone
msgid "Disable showing recommendations within the hover window"
msgstr "Schakel het tonen van aanbevelingen in het overliggende venster uit"

#: googleplusone.php:226
#@ googleone
msgid "Preview"
msgstr ""

