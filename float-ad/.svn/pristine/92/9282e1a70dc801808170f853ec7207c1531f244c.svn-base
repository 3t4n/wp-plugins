#dummy
{
background-color:#ffffff;
color:#ffffff;
display:block;
}
#copyright
{
float:right;
font-size:9px;
}
#topfixed {
position: fixed;
padding:10px;
background-color:#ff00ff;
border-bottom:1px;
width:100%;
top: 0px;
left: 0px;
}
#bottomfixed {
position: fixed;
padding:10px;
background-color:#ff00ff;
width:100%;
border-top:1px;
bottom: 0px;
left: 0px;
}

<!--[if IE]>

#topfixed { position:absolute; padding:10px;}
#bottomfixed { position:absolute; padding:10px;}

<![endif]-->