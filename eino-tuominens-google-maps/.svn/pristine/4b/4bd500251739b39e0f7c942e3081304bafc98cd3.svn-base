.etgm-map-container {
	width: 600px;
	height: 400px;
	/*float: left;*/
}

.etgm-map-collapse-area {
	position: absolute;
	left: -10000px;
}

.etgm-map-title {
	background-color: #999;
	color: #fff;
	padding: 10px;
	border-radius: 5px;
	cursor: pointer;
}

.etgm-map-shape-description-container {
	width: 100%;
	height: auto;
	padding-top: 20px;
}

.etgm-input-row-container {
	border: 1px solid #ccc;
	border-radius: 5px;
	padding: 10px;
	margin-top: 10px;
	width: 678px;
}

.etgm-input-row-container textarea {
	width: 400px;
	height: 200px;
	float: left;
}

.etgm-input-row-container label {
	width: 200px;
	float: left;
}

.etgm-map-name-control input {
	width: 300px;
}