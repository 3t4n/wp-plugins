.description-generator-container {
    margin-left: 10px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
}

.description-generator-container select {
    max-width: 150px;
}

.description-generating {
    padding: 15px;
    background-color: #f0f0f1;
    border: 1px solid #c3c4c7;
    border-radius: 4px;
    text-align: center;
    margin: 10px 0;
}

.description-generating .spinner {
    float: none;
    margin-top: -3px;
    margin-right: 5px;
    visibility: visible;
}

.description-preview-container {
    display: none;
    margin-top: 10px;
    margin-bottom: 10px;
    padding: 10px;
    border: 1px solid #ddd;
    background-color: #f9f9f9;
}

.description-action-container {
    margin-top: 10px;
    display: flex;
    gap: 10px;
}

/* WordPress editor integration styles */
#wp-content-media-buttons .description-generator-container,
#wp-excerpt-media-buttons .description-generator-container {
    vertical-align: middle;
}

.components-select-control__input {
    height: 30px;
    padding: 0 24px 0 8px;
    border-radius: 2px;
}

/* Add these styles to your existing CSS */
#featured-image-preview-container {
    margin-top: 10px;
    display: none;
}

#featured-image-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-bottom: 10px;
}

#featured-image-generation-status {
    margin: 10px 0;
    padding: 10px;
    background-color: #f0f0f1;
    border: 1px solid #c3c4c7;
    border-radius: 4px;
    text-align: center;
    display: none;
}

#featured-image-generation-status .spinner {
    float: none;
    margin-top: -3px;
    margin-right: 5px;
    visibility: visible;
}

/* Gallery image generation styles */
#gallery-image-preview-container {
    margin-top: 10px;
    display: none;
}

#gallery-image-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-bottom: 10px;
}

#gallery-generation-status {
    margin: 10px 0;
    padding: 10px;
    background-color: #f0f0f1;
    border: 1px solid #c3c4c7;
    border-radius: 4px;
    text-align: center;
    display: none;
}

#gallery-generation-status .spinner {
    float: none;
    margin-top: -3px;
    margin-right: 5px;
    visibility: visible;
}

.select-all-container {
    margin-bottom: 10px;
    padding: 10px;
    background: #f9f9f9;
    border: 1px solid #ddd;
    display: flex;
    align-items: center;
}

.gallery-image-checkbox {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 1;
    width: 20px;
    height: 20px;
}

#select-all-images {
    margin-right: 5px;
}

.select-all-container label {
    margin-right: 10px;
} 