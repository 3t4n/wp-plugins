#: includes/diagnose/class_bill_diagnose.php:733
msgid "Potential Problems"
msgstr "Problemas potenciales"

#: _includes/diagnose/class_bill_diagnose.php:650
msgid "Low WordPress Memory Limit"
msgstr "Límite bajo de memoria de WordPress"

#: _includes/diagnose/class_bill_diagnose.php:663
#: includes/diagnose/class_bill_diagnose.php:762
msgid "Your usage now"
msgstr "Tu uso ahora"

#: _includes/diagnose/class_bill_diagnose.php:671
#: includes/diagnose/class_bill_diagnose.php:766
msgid "Total Php Server Memory"
msgstr "Memoria total del servidor PHP"

#: _includes/diagnose/class_bill_diagnose.php:680
