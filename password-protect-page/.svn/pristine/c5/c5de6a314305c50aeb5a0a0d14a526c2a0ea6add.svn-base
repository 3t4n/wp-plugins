earch ${dataIndex}`}\n          value={selectedKeys[0]}\n          onChange={e => setSelectedKeys(e.target.value ? [e.target.value] : [])}\n          onPressEnter={() => this.handleSearch(selectedKeys, confirm)}\n          style={{ width: 163, marginBottom: 8, display: 'block' }}\n        />\n        <Button\n          type=\"primary\"\n          onClick={() => this.handleSearch(selectedKeys, confirm)}\n          icon=\"search\"\n          size=\"small\"\n          style={{ width: 85, marginRight: 8 }}\n        >\n          Search\n        </Button>\n        <Button onClick={() => this.handleReset(clearFilters)} size=\"small\" style={{ width: 70 }}>\n          Reset\n        </Button>\n      </div>\n    ),\n    filterIcon: filtered => (\n      <Icon type=\"search\" style={{ color: filtered ? '#1890ff' : undefined }} />\n    ),\n    onFilter: (value, record) =>\n      record[dataIndex]\n        .toString()\n        .toLowerCase()\n        .includes(value.toLowerCase()),\n    onFilterDropdownVisibleChange: visible => {\n      if (visible) {\n        setTimeout(() => this.searchInput.select());\n      }\n    },\n    render: (text, record) => (\n      <Tooltip title={ this.state.passwordVisibility[record.id] ? text.toString() : maskPassword(text.toString())}>\n        <div style={{ textOverflow: 'ellipsis', overflow: 'hidden' }}>\n          <Highlighter\n            highlightStyle={{ backgroundColor: '#ffc069', padding: 0 }}\n            searchWords={[this.state.searchText]}\n            autoEscape\n            textToHighlight= {this.state.passwordVisibility[record.id] ? text.toString() : '*'.repeat(text.length)} \n          />\n        </div>\n      </Tooltip>\n    ),\n  });\n\n  handleSearch = (selectedKeys, confirm) => {\n    confirm();\n    this.setState({ searchText: selectedKeys[0] });\n  };\n\n  handleReset = clearFilters => {\n    clearFilters();\n    this.setState({ searchText: '' });\n  };\n\n  onSelectChange = selectedRowKeys => {\n    this.setState({ selectedRowKeys });\n  };\n\n  toggleShowPassword = (record) => {\n    this.setState(prevState => ({\n      passwordVisibility: {\n        ...prevState.passwordVisibility,\n        [record.id]: !prevState.passwordVisibility[record.id],\n      }\n    }), () => {\n      //console.log('Password visibility state:', this.state.passwordVisibility);\n    });\n  };\n  \n  initColumns = () => {\n    const { handleDeletePassword, handleSetPasswordStatus, levels } = this.props;\n    let columns = [\n      {\n        title: 'Show/Hide Password',\n        key: 'showPassword',\n        render: (text, record) => (\n          <Switch\n            checked={!!this.state.passwordVisibility[record.id]} // Use row-specific visibility state\n            onChange={() => this.toggleShowPassword(record)}\n          />\n        ),\n        width: 120,\n        fixed: 'left',\n      },\n      {\n        title: 'Password',\n        dataIndex: 'password',\n        width: 180,\n        key: 'password',\n        fixed: 'left',\n        render: (text) => (\n          <Tooltip title={text}>\n            <div style={{ textOverflow: 'ellipsis', overflow: 'hidden' }}>{text}</div>\n          </Tooltip>\n        ),\n        ...this.getColumnSearchProps('password'),\n        sorter: (a, b) => a.password.localeCompare(b.password),\n        sortDirections: ['descend', 'ascend'],\n        onCell: () => {\n          return {\n            style: {\n              whiteSpace: 'nowrap',\n              maxWidth: 150,\n            }\n          }\n        },\n      },\n      {\n        title: 'Label',\n        dataIndex: 'label',\n        width: 140,\n        editable: true,\n        key: 'label',\n        render: (text) => (\n          <Tooltip title={text}>\n            <div style={{ textOverflow: 'ellipsis', overflow: 'hidden', whiteSpace: 'nowrap', maxWidth: '120px' }}>{text}</div>\n          </Tooltip>\n        ),\n      },\n      {\n        title: 'Post Types',\n        dataIndex: 'post_types',\n        width: 140,\n        key: 'post_types',\n        render: (text) => {\n          if (!text || !ppwMasterPasswords || !ppwMasterPasswords.postTypes) {\n            return '';\n          }\n          const postTypes = text.split(';');\n          const postTypesLabel = postTypes.reduce(function (carry, value) {\n            const foundIndex = ppwMasterPasswords.postTypes.findIndex((postType) => postType.key === value);\n            if (foundIndex > -1) {\n              carry.push(ppwMasterPasswords.postTypes[foundIndex].value);\n            }\n            return carry;\n          }, []);\n          return (\n            <span>\n              {postTypesLabel.map(tag => (\n                <Tag color=\"orange\" key={tag}>\n                  {tag}\n                </Tag>\n              ))}\n            </span>\n          )\n        },\n      },\n      {\n        title: 'Type',\n        dataIndex: 'campaign_app_type',\n        key: 'campaign_app_type',\n        width: 160,\n        sortDirections: ['descend', 'ascend'],\n        render: (text) => {\n          if (text === 'master_global') {\n            return 'Global';\n          }\n          if (!text) {\n            return;\n          }\n\n          const rolesText = text.split(';').map(value => value.split('_')[2]).join(', ');\n          const roleContent = `Role (${rolesText})`;\n\n          return (\n            <Tooltip title={roleContent}>\n              <div style={{ textOverflow: 'ellipsis', overflow: 'hidden', whiteSpace: 'nowrap', maxWidth: '120px' }}>{roleContent}</div>\n            </Tooltip>\n          )\n        },\n        sorter: (a, b) => a.campaign_app_type.localeCompare(b.campaign_app_type),\n\n      },\n      {\n        title: () => {\n          return (\n            <Tooltip title=\"Is the password active?\">\n              <div>Status</div>\n            </Tooltip>\n          )\n        },\n        dataIndex: 'show_is_activated',\n        key: 'show_is_activated',\n        width: 80,\n        sortDirections: ['descend', 'ascend'],\n        sorter: (a, b) => a.show_is_activated.localeCompare(b.show_is_activated),\n        render: (value, record) => {\n          return record.show_is_activated === 'Active' ? (<span className='ppw-master-password-status' style={{ color: 'green' }}>{record.show_is_activated}</span>)\n            : (<span className='ppw-master-password-status' style={{ color: 'red' }}>{record.show_is_activated}</span>);\n        }\n      },\n      {\n        title: () => {\n          return (\n            <Tooltip title=\"Total number of times the password is used\">\n              <div>Usage</div>\n            </Tooltip>\n          )\n        },\n        dataIndex: 'hits_count',\n        key: 'hits_count',\n        width: 80,\n        sorter: (a, b) => sortWithParse(a.hits_count, b.hits_count),\n        sortDirections: ['descend', 'ascend'],\n      },\n      {\n        title: 'Usage Limit',\n        dataIndex: 'usage_limit',\n        key: 'usage_limit',\n        width: 110,\n        editable: true,\n        sorter: (a, b) => sortWithParse(a.usage_limit, b.usage_limit),\n        sortDirections: ['descend', 'ascend'],\n        render: (text) => {\n          return text ? `${text} ${renderAttempt(parseInt(text))}` : 'Unlimited';\n        }\n      },\n      {\n        title: 'Password Expiry',\n        dataIndex: 'expired_date',\n        key: 'expired_date',\n        width: 180,\n        editable: true,\n        sorter: (a, b) => sortWithParse(a.expired_date, b.expired_date),\n        sortDirections: ['descend', 'ascend'],\n        render: (cellData) => {\n          if (cellData) {\n            const date = new Date(cellData * 1000);\n            return date.toLocaleString();\n          }\n          return 'Never';\n        }\n      },\n      {\n        title: 'Created Time',\n        dataIndex: 'created_time',\n        key: 'created_time',\n        sorter: (a, b) => sortWithParse(a.created_time, b.created_time),\n        sortDirections: ['descend', 'ascend'],\n        render: (cellData) => {\n          const date = new Date(cellData * 1000);\n          cellData = date.toLocaleString();\n          return cellData;\n        },\n        onCell: () => {\n          return {\n            style: {\n              minWidth: 160,\n            }\n          }\n        },\n        onHeaderCell: () => {\n          return {\n            style: {\n              minWidth: 160,\n            }\n          }\n        }\n      },\n      {\n        title: 'Actions',\n        key: 'action',\n        dataIndex: 'id',\n        fixed: 'right',\n        width: 110,\n        render: (cellData, record) => {\n          const changeStatusLabel = record.is_activated === \"1\" ? 'Deactivate' : 'Activate';\n          const { editingID, saveButton } = this.state;\n          const editable = this.isEditing(record);\n          if (editable) {\n            return (\n              <span>\n                <EditableContext.Consumer>\n                  {form => (\n                    <a\n                      id='ppwp-save-password'\n                      onClick={() => {\n                        this.setState({\n                          saveButton: 'Saving'\n                        });\n                        this.save(form, record.id).finally(() => {\n                          notification['success']({\n                            message: 'PPWP Lite',\n                            description: 'Great! You’ve updated the password successfully.',\n                          });\n                          this.setState({\n                            saveButton: 'Save'\n                          });\n                          this.cancel();\n                        })\n                      }}\n                      style={{ marginRight: 8 }}\n                    >\n                      {saveButton}\n                    </a>\n                  )}\n                </EditableContext.Consumer>\n                <Popconfirm title=\"Sure to cancel?\" onConfirm={() => this.cancel(record.id)}>\n                  <a>Cancel</a>\n                </Popconfirm>\n              </span>\n            )\n          }\n          return editingID !== '' ? '' : (\n            <div>\n              <span id=\"ppw_popup_copy_password\" className=\"pdav3_table_actions\">\n                <Tooltip title=\"Copy Password\">\n                  <span>\n                    <icon\n                      className=\"fa fa-clone\"\n                      onClick={(evt) => evt.preventDefault() || handleCopy(record.password)}\n                    >\n                    </icon>\n                  </span>\n                </Tooltip>\n              </span>\n              <span id=\"ppw_popup_edit_password\" className=\"pdav3_table_actions\">\n                <Tooltip title=\"Edit\">\n                  <span>\n                    <icon\n                      className=\"fa fa-pencil-square-o\"\n                      aria-hidden=\"true\"\n                      onClick={() => this.edit(record.id)}\n                    >\n                    </icon>\n                  </span>\n                </Tooltip>\n              </span>\n              <span id=\"ppw_popup_status_password\" className=\"pdav3_table_actions\">\n                <Tooltip title={changeStatusLabel}>\n                  <span>\n                    <icon\n                      className={changeStatusLabel === 'Activate' ? 'fa fa-lock' : 'fa fa-unlock-alt'}\n                      aria-hidden=\"true\"\n                      onClick={handleSetPasswordStatus(cellData, record.is_activated)}\n                    >\n                    </icon>\n                  </span>\n                </Tooltip>\n              </span>\n              <span id=\"ppw_popup_delete_password\" className=\"pdav3_table_actions\">\n                <Tooltip title=\"Delete\">\n                  <span>\n                    <icon\n                      className=\"fa fa-trash\"\n                      type=\"delete\"\n                      onClick={handleDeletePassword(record.id)}\n                    >\n                    </icon>\n                  </span>\n                </Tooltip>\n              </span>\n            </div>\n          )\n        },\n      },\n    ];\n\n    if (allowProtectionType()) {\n      columns.splice(2, 0,\n        {\n          title: 'Protection Types',\n          dataIndex: 'protection_types',\n          width: 200,\n          key: 'protection_types',\n          render: (text) => {\n            const { protectionTypes: globalProtectionTypes } = ppwMasterPasswords;\n            if (!text) {\n              return (\n                <Tag color=\"orange\" key=\"single\">\n                  {globalProtectionTypes[0].value}\n                </Tag>\n              );\n            }\n            let protectionTypes = text.split(';');\n            protectionTypes = protectionTypes.map(protectionType => {\n              const foundIndex = globalProtectionTypes.findIndex(p => p.key === protectionType);\n              if (foundIndex === -1) {\n                return protectionType;\n              }\n\n              return globalProtectionTypes[foundIndex].value;\n            });\n            return (\n              <span>\n                {protectionTypes.map(tag => (\n                  <Tag color=\"orange\" key={tag}>\n                    {tag}\n                  </Tag>\n                ))}\n              </span>\n            )\n          },\n      }, \n      );\n    }\n\n\n    return columns;\n  }\n\n  render() {\n    const listPasswords = massagePasswords(this.props.data);\n    const { selectedRowKeys } = this.state;\n    const columns = this.initColumns();\n    const rowSelection = {\n      selectedRowKeys,\n      onChange: this.onSelectChange,\n      hideDefaultSelections: true,\n      fixed: true,\n      columnWidth: '25px'\n    };\n\n    const columnsEditable = columns.map(col => {\n      if (!col.editable) {\n        return col;\n      }\n      let inputType = '';\n      switch (col.dataIndex) {\n        case 'expired_date':\n          inputType = 'date';\n          break;\n        case 'hits_count':\n          inputType = 'hits_count';\n          break;\n        default:\n          inputType = 'text';\n      }\n      return {\n        ...col,\n        onCell: record => ({\n          record,\n          inputType,\n          dataIndex: col.dataIndex,\n          title: col.title,\n          editing: this.isEditing(record),\n        }),\n      };\n    });\n\n    return (\n      <EditableContext.Provider value={this.props.form}>\n        <Table\n          bordered\n          //pagination={false}\n          columns={columnsEditable}\n          dataSource={listPasswords}\n          rowClassName=\"editable-row\"\n          scroll={{ x: 1400, y: 500 }}\n          components={this.components}\n          rowKey={record => record.id}\n          size=\"small\"\n          loading={this.props.loading}\n          rowSelection={rowSelection}\n          style={\n            {\n              minHeigh: 200,\n            }\n          }\n          pagination={{\n            onChange: () => {\n              this.cancel();\n              this.onSelectChange([]);\n            },\n            pageSizeOptions: ['10', '15', '20', '40', '60', '80', '100'],\n            showSizeChanger: true,\n            defaultPageSize: 10\n          }}\n          footer={() => (\n            <Row>\n                <Select\n                showSearch\n                style={{ width: 135, marginRight: 10 }}\n                placeholder=\"Bulk Actions\"\n                allowClear={true}\n                optionFilterProp=\"children\"\n                onChange={this.onChange}\n                filterOption={(input, option) =>\n                  option.props.children.toLowerCase().indexOf(input.toLowerCase()) >= 0\n                }\n                >\n                <Option value=\"remove\">Delete</Option>\n                </Select>\n                <Button disabled={this.state.isDeleteSelectedPassword} onClick={this.clickApply}>\n                    { this.state.isDeleteSelectedPassword ? 'Applying': 'Apply'}\n                </Button>\n\n                 <Button disabled={this.state.isExDeletePassword} onClick={this.clickExPassBtn}>\n                    { this.state.isExDeletePassword ? 'Deleting...': 'Delete All Expired Passwords'}\n                </Button>\n            </Row>\n          )}\n        />\n      </EditableContext.Provider>);\n  }\n\n  clickApply = () => {\n    const { selectedBulkAction, selectedRowKeys } = this.state;\n    if (!selectedBulkAction || selectedRowKeys.length === 0) {\n      return;\n    }\n    switch (selectedBulkAction) {\n      case 'remove':\n        const { handleDeleteSelectedPasswords } = this.props;\n        handleDeleteSelectedPasswords(selectedRowKeys, () => {\n          this.onSelectChange([]);\n        }, (status) => {\n          this.setState({ isDeleteSelectedPassword: status });\n        });\n        return;\n      default:\n        return;\n    }\n  }\n\n  clickExPassBtn = () => {\n    const { selectedBulkAction, selectedRowKeys } = this.state;\n    // if (!selectedBulkAction || selectedRowKeys.length === 0) {\n    //   return;\n    // }\n\n     \n        const { handleDeleteExPasswords } = this.props;\n        handleDeleteExPasswords(selectedRowKeys, () => {\n          this.onSelectChange([]);\n        }, (status) => {\n          this.setState({ isExDeletePassword: status });\n        });\n        return;\n\n \n  }\n\n  onChange = (value) => {\n    this.setState({ selectedBulkAction: value });\n  }\n\n  edit(id) {\n    this.setState({ editingID: id });\n  }\n\n  cancel() {\n    this.setState({ editingID: '' });\n  };\n\n  isEditing(record) {\n    return record.id === this.state.editingID;\n  };\n\n  save = (form, id) => {\n    return new Promise((resolve, reject) => {\n      form.validateFields((error, row) => {\n        if (error) {\n          return reject(error);\n        }\n        const { handleChangeExpiredDate, handleChangeUsageLimit, handleChangeLabel } = this.props;\n        const oldData = [...this.props.data];\n        const index = oldData.findIndex(item => id === item.id);\n        if (index === -1) {\n          return resolve(false);\n        }\n        const item = oldData[index];\n        const promises = [];\n        if (row.usage_limit !== item.usage_limit) {\n          promises.push(handleChangeUsageLimit(row.usage_limit, id));\n        }\n        if (row.expired_date && !convertDate(item.expired_date).isSame(row.expired_date, 'day')) {\n          const timePicked = moment(`${row.expired_date.format(dateFormat)} ${moment().format('h:mm:ss a')}`);\n          promises.push(handleChangeExpiredDate(timePicked.unix(), id));\n        } else if ( ! row.expired_date && row.expired_date !== item.expired_date ) {\n          promises.push(handleChangeExpiredDate( null, id));\n        }\n        if (row.label !== item.label) {\n          promises.push(handleChangeLabel(row.label, id));\n        }\n        return Promise.all(promises)\n          .then(() => resolve(true))\n          .catch((err) => {\n            reject(err);\n          });\n      });\n    })\n  }\n\n}\n\nconst PasswordTable = Form.create()(TableComponent)\nexport default PasswordTable;\n\n\n\n// WEBPACK FOOTER //\n// ./components/PasswordTable/PasswordTable.js","import React, { Component } from 'react';\nimport { Modal, notification } from 'antd';\n\nimport PasswordTable from './PasswordTable';\nimport { getAll } from '../../api/password';\nimport { MESSAGES } from './strings';\n\nimport { deletePassword, updatePassword, updatePasswordStatus, bulkDeletePasswords, exDeletePasswords } from '../../api/password';\n\nconst { confirm } = Modal;\n\nclass Password extends Component {\n  constructor(props) {\n    super(props);\n    this.state = {\n      data: [],\n      isLoading: false,\n    }\n  }\n\n  UNSAFE_componentWillReceiveProps(nextProps) {\n    const { isReload } = nextProps;\n    if (isReload) {\n      this.loadPasswords();\n      this.props.callNotReload();\n    }\n  }\n\n  componentDidMount() {\n    this.loadPasswords();\n  }\n\n  loadPasswords = () => {\n    this.setState({ isLoading: true });\n    getAll().then(({ data }) => {\n      const { result } = data;\n      this.setState({ data: result.reverse() })\n    }).finally(() => this.setState({ isLoading: false }));\n  }\n\n  handleDeletePassword(id) {\n    confirm({\n      title: MESSAGES.CONFIRM_DELETE_PASSWORD,\n      okText: 'Yes',\n      okType: 'danger',\n      cancelText: 'No',\n      width: 435,\n      onOk: () => {\n        deletePassword(id).then(() => {\n          notification['success']({\n            message: 'PPWP Lite',\n            description: 'Great! You’ve deleted the password successfully.',\n          });\n          let { data } = this.state;\n          const foundIndex = data.findIndex(value => value.id === id);\n          if (foundIndex === -1) {\n            return;\n          }\n          data.splice(foundIndex, 1);\n          this.setState({ data });\n        })\n      },\n      onCancel() {\n        console.log('Cancel');\n      },\n    });\n  }\n\n  handleSetPasswordStatus(id, is_activated) {\n    is_activated = is_activated === \"1\" ? true : false;\n    updatePasswordStatus(id, !is_activated)\n      .then(() => {\n        const { data } = this.state;\n        const foundIndex = data.findIndex(value => {\n          return value.id === id;\n        })\n        if (foundIndex === -1) {\n          notification['error']({\n            message: 'PPWP Lite',\n            description: 'Failed to update the password.',\n          });\n        }\n        let passwords = data;\n        passwords[foundIndex].is_activated = is_activated ? '0' : '1';\n        this.setState({ data: passwords });\n        notification['success']({\n          message: 'PPWP Lite',\n          description: 'Great! You’ve updated the password successfully.',\n        });\n      })\n      .catch(() => notification['error']({\n        message: 'PPWP Lite',\n        description: MESSAGES.DEFAULT_ERROR_MESSAGE,\n      }));\n  }\n\n  handleChangeExpiredDate = (expired_date, id) => {\n    return updatePassword(id, { expired_date }).then(() => {\n      const { data } = this.state;\n      const foundIndex = data.findIndex(value => value.id === id)\n      let passwords = data;\n      passwords[foundIndex].expired_date = expired_date ? expired_date.toString() : null;\n      this.setState({ data: passwords });\n      return Promise.resolve(true);\n    })\n  }\n\n  handleChangeLabel = (label, id) => {\n    return updatePassword(id, { label }).then(() => {\n      const { data } = this.state;\n      const foundIndex = data.findIndex(value => value.id === id)\n      let passwords = data;\n      passwords[foundIndex].label = label;\n      this.setState({ data: passwords });\n      return Promise.resolve(true);\n    })\n  }\n\n\n  handleChangeUsageLimit(val, id) {\n    if (val <= 0) {\n      val = null;\n    }\n    val = Math.round(parseFloat(val));\n    return updatePassword(id, { usage_limit: val }).then(() => {\n      const { data } = this.state;\n      const foundIndex = data.findIndex(value => value.id === id);\n      let passwords = data;\n      passwords[foundIndex].usage_limit = val.toString();\n      this.setState({ data: passwords });\n      return Promise.resolve(true);\n    });\n  }\n\n  handleDeleteSelectedPasswords = (ids, cb, setStatus) => {\n    confirm({\n      title: MESSAGES.CONFIRM_DELETE_PASSWORDS,\n      okText: 'Yes',\n      okType: 'danger',\n      cancelText: 'No',\n      width: 435,\n      onOk: () => {\n        setStatus(true);\n        bulkDeletePasswords(ids).then((response) => {\n          const { data: { message } } = response;\n          notification['success']({\n            message: 'PPWP Lite',\n            description: message,\n          });\n          let { data } = this.state;\n          data = data.filter(value => {\n            return ids.indexOf(value.id) === -1;\n          });\n          this.setState({ data });\n        }).catch(error => {\n          notification['error']({\n            message: 'PPWP Lite',\n            description: error.message,\n          });\n        })\n        .finally(() => {\n          cb();\n          setStatus(false);\n        });\n      },\n    });\n}\n\nhandleDeleteExPasswords = (ids, cb, setStatus) => {\n  confirm({\n    title: MESSAGES.CONFIRM_DELETE_ALL_EXPIRED_PASSWORDS,\n    okText: 'Yes',\n    okType: 'danger',\n    cancelText: 'No',\n    width: 435,\n    onOk: () => {\n      setStatus(true);\n      exDeletePasswords(ids).then((response) => {\n        const { data: { message } } = response;\n        notification['success']({\n          message: 'PPWP Lite',\n          description: message,\n        });\n        let { data } = this.state;\n        data = data.filter(value => {\n          return ids.indexOf(value.id) === -1;\n        });\n        this.setState({ data });\n        setTimeout(function(){\n          window.location.reload(1);\n       }, 3000);\n      }).catch(error => {\n        notification['error']({\n          message: 'PPWP Lite',\n          description: MESSAGES.ERROR_DELETE_ALL_EXPIRED_PASSWORDS,\n        });\n      })\n      .finally(() => {\n        cb();\n        setStatus(false);\n      });\n    },\n  });\n}\n\n  render() {\n    const { data, isLoading } = this.state;\n    const { levels } = this.props;\n    return (\n      <div className=\"ppwp-group\">\n        <PasswordTable\n          data={data}\n          loading={isLoading}\n          levels={levels}\n          handleDeletePassword={(id) => this.handleDeletePassword.bind(this, id)}\n          handleSetPasswordStatus={(id, is_activated) => this.handleSetPasswordStatus.bind(this, id, is_activated)}\n          handleChangeUsageLimit={(val, id) => this.handleChangeUsageLimit(val, id)}\n          handleChangeExpiredDate={(val, id) => this.handleChangeExpiredDate(val, id)}\n          handleChangeLabel={(val, id) => this.handleChangeLabel(val, id)}\n          handleDeleteSelectedPasswords = {(ids, cb, setStatus) => this.handleDeleteSelectedPasswords(ids, cb, setStatus)}\n          handleDeleteExPasswords = {(ids, cb, setStatus) => this.handleDeleteExPasswords(ids, cb, setStatus)}\n        />\n      </div>\n    );\n  }\n}\n\nexport default Password;\n\n\n\n// WEBPACK FOOTER //\n// ./components/PasswordTable/index.js","const { MESSAGES } = require('./strings');\nimport { notification } from 'antd';\n\nimport moment from 'moment';\n\nexport const handleCopy = (content, message = MESSAGES.COPY_PASSWORD_TO_CLIPBOARD) => {\n    // Create element\n    let inputCopy = document.createElement('input');\n\n    let pluginName = 'PPWP Lite';\n    // Set value for element\n    inputCopy.value = content;\n\n    // Add element to body\n    document.body.appendChild(inputCopy);\n\n    // Seelct and copy text to clipboard\n    inputCopy.select();\n    try {\n        const isSuccess = document.execCommand(\"copy\");\n        if (isSuccess) {\n            notification['success']({\n                message: pluginName,\n                description: message,\n            });\n        }\n    } catch (err) {\n        console.log(\"Opps, unable to copy!\");\n    }\n\n    // Remove element in body\n    document.body.removeChild(inputCopy);\n}\n\nexport const convertDate = (date, dateFormat) => {\n    if (date) {\n        return moment((new Date(date * 1000)), dateFormat);\n    }\n    return moment(new Date(), dateFormat);\n}\n\nexport const convertDateForDatePicker = (date, dateFormat) => {\n    if (date) {\n        return moment((new Date(date * 1000)), dateFormat);\n    }\n    return null;\n}\n\nexport const dateFormat = 'MM/DD/YYYY';\n\nexport const disabledDate = (current) => current && current < moment().endOf('day');\n\nexport const sortWithParse = (prev, current) => {\n    if (prev === null) {\n        return 1;\n    }\n    if (current === null) {\n        return -1;\n  