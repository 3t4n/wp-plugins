msgstr "تعطيل في واجهة الموقع"

#: panel-page.php:575
msgid "Disable month reset when changing language"
msgstr "تعطيل إعادة تعيين الشهور عند تغيير اللغة"

#: panel-page.php:28
msgid "Disable plugin"
msgstr "تعطيل الإضافة"

#: panel-page.php:620
msgid "Do not delete"
msgstr "لا تحذف"

#: panel-page.php:659
msgid "Do not forget to rate the plugin"
msgstr "لا تنس تقييم الإضافة"

#: panel-page.php:28
msgid "Enable plugin"
msgstr "تفعيل الإضافة"

#: panel-page.php:417
msgid "Enter the new abbreviations of months by order:"
msgstr "أدخل الأسماء الجديدة المختصرة (abbreviation) للشهور بالترتيب:"

#: panel-page.php:152
msgid "Enter the new names of months by order:"
msgstr "أدخل الأسماء الجديدة للشهور بالترتيب:"

#: panel-page.php:635
msgid "Hide the plugin rating icon"
msgstr "إخفاء أيقونة تقييم الإضافة"

