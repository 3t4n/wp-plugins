var mySwiper = undefined;
function initSwiper() {
    if(mySwiper == undefined) {            
        $('.swiper-container').each(function(){
            mySwiper = new Swiper(this, {            
                simulateTouch: false,
			    navigation: {
				nextEl: '.swiper-button-next',
				prevEl: '.swiper-button-prev',
			  },
            })
        });        
    }     
}    
initSwiper(); 
