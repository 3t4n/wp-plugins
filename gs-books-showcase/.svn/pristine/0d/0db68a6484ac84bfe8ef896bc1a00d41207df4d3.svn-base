jQuery((function(a){var o=a("#sortable-list");o.sortable({update:function(t,n){_gsbook_sort_data.is_pro&&(a("#loading-animation").show(),a.ajax({url:_gsbook_sort_data.ajaxurl,type:"POST",async:!0,cache:!1,dataType:"json",data:{action:_gsbook_sort_data.action,_wpnonce:_gsbook_sort_data.nonce,order:o.sortable("toArray").toString()},success:function(o){a("#loading-animation").hide()},error:function(o,t,n){alert("There was an error saving the updates"),a("#loading-animation").hide()}}))}})}));
