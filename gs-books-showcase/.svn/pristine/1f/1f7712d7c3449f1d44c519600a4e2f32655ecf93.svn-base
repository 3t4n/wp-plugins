#titlediv #title{-webkit-border-radius:5px;border-radius:5px}#gsbookshowcaseSection{background:#fff;border:1px solid #e5e5e5;-webkit-box-shadow:0 1px 1px rgba(0,0,0,.04);box-shadow:0 1px 1px rgba(0,0,0,.04);min-width:255px;overflow:hidden}.gsb_media_uploader{height:80px;-o-object-fit:contain;object-fit:contain;-o-object-position:center;object-position:center;width:80px}.gs_bookshowcase-metafields .form-group{margin-bottom:15px;overflow:hidden}.gs_bookshowcase-metafields label{float:left;padding:6px 0;width:20%}.gs_bookshowcase-metafields .form-control{border:1px solid #e1e1e1;-webkit-border-radius:5px;border-radius:5px;-webkit-box-shadow:none;box-shadow:none;display:inline-block;float:left;height:auto;padding:5px 15px;width:50%}.gs_bookshowcase-metafields h2{font-style:italic;font-weight:600!important;padding:8px 12px 8px 0!important}.search-filter .search-fil-nbox{margin:5px 0}.gsp-images{display:-webkit-box;display:-webkit-flex;display:-ms-flexbox;display:flex;gap:10px}.gsp-images li{border:1px solid #d9d9d9;max-height:80px;max-width:80px;padding:5px}.gsp-images li,.gsp-images li img{-webkit-border-radius:5px;border-radius:5px}.gsp-images li img{height:100%;-o-object-fit:cover;object-fit:cover;-o-object-position:center;object-position:center;width:100%}.gs_bookshowcase-metafields input{margin:4px 0;outline:none;width:300px}#gs-bksh-image #gsbk_author_image{max-width:170px!important}.gs_bookshowcase_wrap .gs_bookshow_switch_label{cursor:auto;font-size:13px;font-style:italic;margin-left:20px;vertical-align:sub}.gs_booksh_gallery_images .gallery-item{display:inline-block;margin:4px;width:75px}.gs_booksh_gallery_images .gallery-item img{height:auto;width:100%}i.gsbookshowcase-mce-icon{background-image:url(gsbookshowcase.png)}div#gs_bookshowcase_style_settings{position:relative}div#gs_bookshowcase_style_settings tr:first-child{background:#f8f8f8;height:100%;left:0;opacity:.6;padding:0!important;position:absolute;top:35px;width:100%;z-index:99}div#gs_bookshowcase_style_settings tr:first-child input{display:none}p.gsbookshowcase_pro{background:#000;color:#fff;font-size:30px!important;margin-top:-90px!important;padding:10px}.gsbookshow_pro_fea li:before{color:#f14548;content:"\f046";font-family:FontAwesome;margin:0 5px 0 0}a.gs-pro-link{color:#f50303;font-weight:700}.gswps-admin-sidebar{text-align:center}.gswps-admin-sidebar h3{font-size:14px;line-height:1.4;margin:0;padding:8px 12px}.gs-plugins--sort-links{-webkit-box-align:center;-ms-flex-align:center;-webkit-align-items:center;align-items:center;background:#fff;-webkit-box-shadow:0 1px 10px rgba(63,66,87,.06);box-shadow:0 1px 10px rgba(63,66,87,.06);display:-webkit-box;display:-webkit-flex;display:-ms-flexbox;display:flex;gap:24px;margin:0 0 0 -20px;padding:0 30px}.gs-plugins--sort-links a{border-bottom:2px solid transparent;-webkit-box-shadow:none;box-shadow:none;color:#515365;font-size:16px;font-weight:500;line-height:64px;outline:none;text-decoration:none;-webkit-transition:color .3s;-o-transition:color .3s;transition:color .3s}.gs-plugins--sort-links a.gs-sort-active{border-color:#5e6be5;color:#242429}.gs-book-showcase-app-view-container{color:#515365;font-size:13px;padding:30px 15px}.gs-book-showcase-app-view-container .shortcodes-container .gs-bookshowcase-box{min-height:650px;min-height:70vh}.gs-book-showcase-app-view-container .gs-bookshowcase-box{background:#fff;-webkit-border-radius:4px;border-radius:4px;-webkit-box-shadow:0 1px 10px rgba(63,66,87,.06);box-shadow:0 1px 10px rgba(63,66,87,.06);padding:30px;position:relative}.gs-book-showcase-app-view-container .gs-bookshowcase-box.box-accordion{padding:0}.gs-book-showcase-app-view-container .shortcode-settings--group{background:#fff;-webkit-border-radius:4px;border-radius:4px;-webkit-box-shadow:0 1px 24px rgba(152,157,171,.16);box-shadow:0 1px 24px rgba(152,157,171,.16);margin-bottom:30px;max-width:800px;overflow:hidden;padding:30px;position:relative;width:100%}.gs-book-showcase-app-view-container .shortcode-settings--left{margin-bottom:24px}.gs-book-showcase-app-view-container .shortcode-settings--right .shortcode-setting--row{border:none;margin-bottom:20px;padding-bottom:0}.pro-only{opacity:.4;pointer-events:none}.shortcode-setting--ribon{background:#345be9;color:#fff;font-size:15px;font-weight:600;line-height:1;padding:8px 0;position:absolute;right:-37px;text-align:center;top:18px;-webkit-transform:rotate(45deg);-ms-transform:rotate(45deg);transform:rotate(45deg);width:140px}.gs-book-disable--term-inner{-webkit-box-align:center;-ms-flex-align:center;-webkit-box-pack:center;-ms-flex-pack:center;-webkit-align-items:center;align-items:center;display:-webkit-box;display:-ms-flexbox;display:-webkit-flex;display:flex;height:100%;-webkit-justify-content:center;justify-content:center;left:0;position:absolute;top:0;width:100%;z-index:999}.gs-book-disable--term-message{background:#6472ef;-webkit-border-radius:3px;border-radius:3px;-webkit-box-shadow:0 0 50px rgba(89,97,109,.1);box-shadow:0 0 50px rgba(89,97,109,.1);color:#fff;font-size:18px;letter-spacing:1px;padding:20px 100px}.gs-book-disable--term-message a{color:#fff;font-weight:600;text-decoration:none}.is_pro_active{opacity:.4}
