@charset "utf-8";
/* CSS Document */

body
{
	font-family: Arial, Helvetica, sans-serif;
	font-size:14px;
	line-height:150%;
}
	
	#pwidgetsmain
{
   background: #FFFFFF;
   margin:0 auto;
   font-size: 13px;
   font-family: Arial, 'Arial Unicode MS', Helvetica, Sans-Serif;
   font-weight: normal;
   font-style: normal;
   position: relative;
   width: 100%;
   min-height: 100%;
   left: 0;
   top: 0;
   cursor:default;
   overflow:hidden;
}
.pwidgetscontent-layout
{
   display: table;
   width: 100%;
   table-layout: fixed;
   border-collapse: collapse;
}

.pwidgetscontent-layout-row 
{
   display: table-row;
}

.pwidgetslayout-cell
{
   display: table-cell;
   vertical-align: top;
}

h1
{
	font-size:24px;
	font-family:Arial, Helvetica, sans-serif;
	color: #3FA9F5;
}

h2
{
	font-size:18px;
	font-family:Arial, Helvetica, sans-serif;
	color:#F7931E;
}



a:link
{
   font-family: Arial, 'Arial Unicode MS', Helvetica, Sans-Serif;
   font-weight: bold;
   font-style: normal;
   text-decoration: none;
   color: #3FA9F5;
}

a:visited
{
   font-family: Arial, 'Arial Unicode MS', Helvetica, Sans-Serif;
   text-decoration: none;
   color: #3FA9F5;
}

a:hover
{
   font-family: Arial, 'Arial Unicode MS', Helvetica, Sans-Serif;
   text-decoration: underline;
   color: #F4800B;
}