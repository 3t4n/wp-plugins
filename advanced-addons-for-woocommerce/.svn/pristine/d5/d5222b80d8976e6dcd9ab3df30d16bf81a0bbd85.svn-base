{"version":3,"file":"frontend-scripts.min.js","mappings":"AAAAA,SAASC,iBAAiB,oBAAoB,WAC1C,IA+E4BC,EArDtBC,EAAgB,GAYhBC,EAAuB,WACzBD,EAAcE,OAAS,EAEvBL,SAASM,iBAAiB,iBAAiBC,SAAQ,SAACC,GAChD,IAAMC,EAAWD,EAAOE,QAAQC,QAC1BC,EAAcJ,EAAOK,cAAc,iBAAiBC,YAAYC,OAEhEC,EAAmB,GACzBR,EAAOF,iBAAiB,6BAA6BC,SAAQ,SAACU,GAC1DD,EAAiBE,KAAK,CAClBC,GAAIF,EAAQP,QAAQU,UAAUC,WAC9BC,MAAOL,EAAQP,QAAQY,MACvBC,MAAOC,WAAWP,EAAQP,QAAQa,QAE1C,IACIP,EAAiBX,OAAS,GAC1BF,EAAce,KAAK,CACfC,GAAIV,EACJgB,MAAOb,EACPc,SAAUV,GAGtB,IACAW,GAEJ,EAEMA,EAAqB,WACvB,IAAMC,EAAmB5B,SAASa,cAAc,6BAChD,GAAKe,EAAL,CACA,IAKMC,GALYL,WAAWI,EAAiBlB,QAAQoB,WAAa,GAChD3B,EAAc4B,QAAO,SAACC,EAAOC,GAC5C,OAAOD,EAAQC,EAAMP,SAASK,QAAO,SAACG,EAAUjB,GAAO,OAAKiB,EAAWjB,EAAQM,KAAK,GAAE,EAC1F,GAAG,IAEuCY,QAAQ,GAClDP,EAAiBd,YAAc,GAAHsB,OAAMP,EAAQ,KAAAO,OAAIR,EAAiBlB,QAAQ2B,SAP1C,CAQjC,EA8CMC,EAAgBtC,SAASa,cAAc,mBAC7C,GAAIyB,EAAe,EA3CSpC,EA4CLoC,GA1CThC,iBAAiB,kEAAkEC,SAAQ,SAACgC,GAClGA,EAAKtC,iBAAiB,SAAS,WACZsC,EAAKC,QAAQ,mBAGrBlC,iBAAiB,aAAaC,SAAQ,SAACkC,GAC1CA,EAAaC,UAAUC,OAAO,WAClC,IAGAJ,EAAKG,UAAUE,IAAI,YACnBxC,GACJ,GACJ,IAGAF,EAAUI,iBAAiB,uCAAuCC,SAAQ,SAACsC,GACvEA,EAAM5C,iBAAiB,UAAU,WAC7B,IAAM6C,EAAQD,EAAME,KAGpB/C,SAASM,iBAAiB,+BAAD8B,OAAgCU,EAAK,OAAMvC,SAAQ,SAACgC,IAzE3D,SAACA,EAAMS,GAC7BA,EACAT,EAAKG,UAAUE,IAAI,YAEnBL,EAAKG,UAAUC,OAAO,WAE9B,CAoEgBM,CAAsBV,EAAKW,cAAeX,EAAKY,QACnD,IAEA/C,GACJ,GACJ,IA5GwB,SAACF,GACzB,IAAMkD,EAAelD,EAAUQ,QAAQ0C,cAAgB,WAClClD,EAAUI,iBAAiB,iBAEnCC,SAAQ,SAACC,GAClB,IAAM6C,EAAe7C,EAAOK,cAAc,iBACpCyC,EAAoB9C,EAAOK,cAAc,mBAG3CyC,IACqB,aAAjBF,EACAE,EAAkBZ,UAAUC,OAAO,UAEnCW,EAAkBZ,UAAUE,IAAI,WAKpCS,GAAgBC,GAChBD,EAAapD,iBAAiB,SAAS,WACnCqD,EAAkBZ,UAAUa,OAAO,SACvC,GAER,GACJ,CAoGIC,CAAoBlB,GAGpB,IAAMmB,EAAgBzD,SAASa,cAAc,aACzC4C,IACAA,EAAcxD,iBAAiB,UAAU,WAjBf,IACxByD,KAAc1D,SAASa,cAAc,oCAEvCT,IACAsD,EAAYpC,MAAQqC,KAAKC,UAAUzD,GAenC,IACAsD,EAAcxD,iBAAiB,UAAU,SAAC4D,GACtC,IAAIC,EAAiBxB,EAAc5B,QAAQoD,eACd,IAAzB3D,EAAcE,QAAmC,QAAnByD,IAC9BD,EAAME,iBACNC,MAAM,mEAEd,KAEJ,IAAMpC,EAAmB5B,SAASa,cAAc,6BAChD,GAAIe,EAAkB,CAElB,IAAME,EAAYN,WAAWI,EAAiBd,YAAYmD,QAAQ,WAAY,KAC9ErC,EAAiBlB,QAAQoB,UAAYA,EACrCF,EAAiBlB,QAAQ2B,SAAWT,EAAiBd,YAAYmD,QAAQ,WAAY,IAAIlD,MAC7F,CACJ,CACJ","sources":["webpack://advanced-addons-for-woocommerce/./src/frontend-scripts.js"],"sourcesContent":["document.addEventListener('DOMContentLoaded', () => {\n    const setupToggleBehavior = (container) => {\n        const defaultState = container.dataset.defaultState || \"expanded\"; // Fetch the default state\n        const addonParents = container.querySelectorAll('.addon-parent');\n    \n        addonParents.forEach((parent) => {\n            const toggleButton = parent.querySelector('.addon-toggle');\n            const childrenContainer = parent.querySelector('.addon-subitems');\n    \n            // Set the initial visibility based on the default state\n            if (childrenContainer) {\n                if (defaultState === \"expanded\") {\n                    childrenContainer.classList.remove('hidden'); // Default to visible\n                } else {\n                    childrenContainer.classList.add('hidden'); // Default to hidden\n                }\n            }\n    \n            // Toggle visibility for child container\n            if (toggleButton && childrenContainer) {\n                toggleButton.addEventListener('click', () => {\n                    childrenContainer.classList.toggle('hidden');\n                });\n            }\n        });\n    };\n    // Initialize selection tracking\n    const selectedItems = [];\n\n    // Utility function to update visual feedback\n    const updateSelectedVisuals = (item, isSelected) => {\n        if (isSelected) {\n            item.classList.add('selected');\n        } else {\n            item.classList.remove('selected');\n        }\n    };\n\n    // Collect selected items from the DOM\n    const collectSelectedItems = () => {\n        selectedItems.length = 0; // Reset the array\n\n        document.querySelectorAll('.addon-parent').forEach((parent) => {\n            const parentId = parent.dataset.addonId;\n            const parentTitle = parent.querySelector('.addon-toggle').textContent.trim();\n\n            const selectedSubItems = [];\n            parent.querySelectorAll('.addon-subitems .selected').forEach((subItem) => {\n                selectedSubItems.push({\n                    id: subItem.dataset.subitemid.toString(),\n                    value: subItem.dataset.value,\n                    price: parseFloat(subItem.dataset.price),\n                });\n            });\n            if (selectedSubItems.length > 0) {\n                selectedItems.push({\n                    id: parentId,\n                    title: parentTitle,\n                    subItems: selectedSubItems,\n                });\n            }\n        });\n        updatePriceDisplay();\n\n    };\n\n    const updatePriceDisplay = () => {\n        const basePriceElement = document.querySelector('.woocommerce-Price-amount');\n        if (!basePriceElement) return;\n        const basePrice = parseFloat(basePriceElement.dataset.basePrice || 0);\n        const addonPrice = selectedItems.reduce((total, addon) => {\n            return total + addon.subItems.reduce((subTotal, subItem) => subTotal + subItem.price, 0);\n        }, 0);\n\n        const newPrice = (basePrice + addonPrice).toFixed(2);\n        basePriceElement.textContent = `${newPrice} ${basePriceElement.dataset.currency}`;\n    };\n\n\n    // Attach event listeners to sub-items\n    const setupItemSelection = (container) => {\n        // Handle non-radio items (buttons, colors, images)\n        container.querySelectorAll('.addon-subitems .subitem-button, .color-option, .subitem-image').forEach((item) => {\n            item.addEventListener('click', () => {\n                const parent = item.closest('.addon-subitems'); // Find the parent sub-items container\n\n                // Reset selection in the same group\n                parent.querySelectorAll('.selected').forEach((selectedItem) => {\n                    selectedItem.classList.remove('selected');\n                });\n\n                // Mark the clicked item as selected\n                item.classList.add('selected');\n                collectSelectedItems(); // Update the selection tracking\n            });\n        });\n\n        // Handle radio buttons (grouped selections)\n        container.querySelectorAll('.addon-subitems input[type=\"radio\"]').forEach((radio) => {\n            radio.addEventListener('change', () => {\n                const group = radio.name;\n\n                // Reset selection visuals for all items in the group\n                document.querySelectorAll(`.addon-subitems input[name=\"${group}\"]`).forEach((item) => {\n                    updateSelectedVisuals(item.parentElement, item.checked);\n                });\n\n                collectSelectedItems(); // Update the selection tracking\n            });\n        });\n    };\n\n    // Attach selected items to the Add to Cart form\n    const attachSelectedItemsToCart = () => {\n        const hiddenField = document.querySelector('input[name=\"selected_addons\"]');\n        if (hiddenField) {\n            collectSelectedItems();\n            hiddenField.value = JSON.stringify(selectedItems);\n        }\n    };\n\n\n    const rootContainer = document.querySelector('.product-addons');\n    if (rootContainer) {\n        setupItemSelection(rootContainer);\n        setupToggleBehavior(rootContainer);\n\n        // Hook into Add to Cart button\n        const addToCartForm = document.querySelector('form.cart');\n        if (addToCartForm) {\n            addToCartForm.addEventListener('submit', () => {\n                attachSelectedItemsToCart();\n            });\n            addToCartForm.addEventListener('submit', (event) => {\n                let requiredAddons = rootContainer.dataset.requiredAddons;\n                if (selectedItems.length === 0 && requiredAddons === \"yes\") {\n                    event.preventDefault();\n                    alert('Please select an addon before adding this product to your cart.');\n                }\n            });\n        }\n        const basePriceElement = document.querySelector('.woocommerce-Price-amount');\n        if (basePriceElement) {\n            // Store the base price for reference\n            const basePrice = parseFloat(basePriceElement.textContent.replace(/[^0-9.]/g, ''));\n            basePriceElement.dataset.basePrice = basePrice;\n            basePriceElement.dataset.currency = basePriceElement.textContent.replace(/[0-9.,]/g, '').trim();\n        }\n    }\n});\n"],"names":["document","addEventListener","container","selectedItems","collectSelectedItems","length","querySelectorAll","forEach","parent","parentId","dataset","addonId","parentTitle","querySelector","textContent","trim","selectedSubItems","subItem","push","id","subitemid","toString","value","price","parseFloat","title","subItems","updatePriceDisplay","basePriceElement","newPrice","basePrice","reduce","total","addon","subTotal","toFixed","concat","currency","rootContainer","item","closest","selectedItem","classList","remove","add","radio","group","name","isSelected","updateSelectedVisuals","parentElement","checked","defaultState","toggleButton","childrenContainer","toggle","setupToggleBehavior","addToCartForm","hiddenField","JSON","stringify","event","requiredAddons","preventDefault","alert","replace"],"sourceRoot":""}