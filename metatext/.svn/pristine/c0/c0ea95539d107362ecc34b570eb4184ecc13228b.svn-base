<div class="meta-text__general-switch-button" id="meta-text__general-switch-button">
  <label class="meta-text__switch" for="meta-text__checkbox">
    <input type="checkbox" id="meta-text__checkbox">
    <span id="meta-text__slider" class="meta-text__slider round">
      <span id="meta-text__roller"></span>
      <span id="meta-text__textContent"></span>
    </span>
  </label>
</div>