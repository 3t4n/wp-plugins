export const htmlEntitiesModifier = (text: string, decode: boolean = true) => {
  const entities = [
    ['apos', '\''],
    ['#x27', '\''],
    ['#x2F', '/'],
    ['#39', '\''],
    ['#47', '/'],
    ['lt', '<'],
    ['gt', '>'],
    ['nbsp', ' '],
    ['quot', '"'],
    ['#039', '\''],        
    ['amp', '&']
  ];

  for (let i = 0, max = entities.length; i < max; ++i) {

    const encodeChars = entities[i][0];
    const decodeChar = entities[i][1];
    text = decode
            ? text.replace(new RegExp('&'+encodeChars+';', 'g'), '--'+decodeChar+'--')
            : text.replace(new RegExp('--'+decodeChar+'--', 'g'), '&'+encodeChars+';');
  }

  return text;
}
