{
  "name": "metatext",
  "version": "1.0.0",
  "description": "Meta Text Plugin for Wordpress",
  "scripts": {
    "build": "webpack --mode production",
    "start": "webpack serve --mode development",
    "browserslist": "npx browserslist",
    "lint-scss": "npx stylelint '**/*.scss'",
    "lint-code": "eslint ./app"
  },
  "keywords": [
    "Accessibility",
    "Bionic",
    "Toolbox",
    "Plugin"
  ],
  "author": "metatext",
  "license": "GPLv2",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.13.0",
    "@typescript-eslint/parser": "^5.13.0",
    "autoprefixer": "^10.4.2",
    "css-loader": "^5.2.4",
    "css-mqpacker": "^7.0.0",
    "cssnano": "^5.0.16",
    "dotenv": "^10.0.0",
    "eslint": "^8.10.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-prettier": "^4.0.0",
    "file-loader": "^6.2.0",
    "html-loader": "^2.1.2",
    "html-webpack-plugin": "^5.3.1",
    "postcss": "^8.4.5",
    "postcss-loader": "^6.2.1",
    "postcss-scss": "^4.0.3",
    "posthtml": "^0.16.6",
    "posthtml-inline-svg": "^0.2.0",
    "prettier": "^2.5.1",
    "prettier-eslint": "^13.0.0",
    "sass": "^1.49.0",
    "sass-loader": "^12.4.0",
    "string-replace-loader": "^3.0.1",
    "style-loader": "^2.0.0",
    "stylelint": "^14.3.0",
    "stylelint-config-prettier-scss": "^0.0.1",
    "stylelint-config-standard-scss": "^3.0.0",
    "svg-inline-loader": "^0.8.2",
    "terser-webpack-plugin": "^5.1.2",
    "ts-loader": "^9.2.7",
    "typescript": "^4.6.2",
    "webpack": "^5.37.0",
    "webpack-cli": "^4.7.0",
    "webpack-dev-server": "^3.11.2"
  },
  "homepage": "http://localhost:3001",
  "dependencies": {
    "core-js": "^3.22.0",
    "text-vide": "^1.6.0"
  },
  "browserslist": [
    "defaults",
    "> 1%",
    "last 5 version"
  ]
}
