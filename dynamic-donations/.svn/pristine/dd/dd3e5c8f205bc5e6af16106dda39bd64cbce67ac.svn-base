import React from 'react';
import styled from 'styled-components'

// components
import Errors from '../components/Errors/Errors';

const Wrapper = styled.section`
	background: #fff;
	border-radius: 5px;
`;

export function LayoutPrimary({ children }) {
	return (
		<Wrapper>
			<Errors />
			{ children }
		</Wrapper>
	)
}
