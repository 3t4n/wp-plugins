import React from 'react';
import {Layout} from '../../layouts';


import SettingsNav from './components/SettingsNav';
import SettingsAmountsSectionOptions from './components/SettingsAmountsSectionOptions';

const SettingsAmounts = () => {
  return (
    <Layout title="Settings">
      <SettingsNav />
      <SettingsAmountsSectionOptions />
    </Layout>
  );
}

export default SettingsAmounts;
