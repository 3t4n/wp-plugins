import React from 'react';
import FormSubSection from '../../../components/FormSubSection';
import FormSection from '../../../components/FormSection';

const SettingsSectionParagraphs = () => {
  return (
    <FormSection
      title="Interactive Elements:"
      description="Lorem ipsum dolor sit amet, consectetur adipisicing elit. Amet aperiam autem, eius ipsa iure iusto labore laborum nostrum obcaecati porro quos, repellat! Aliquid architecto, consectetur cupiditate deleniti magni optio possimus."
    >
      <FormSubSection title="Buttons">
        <form action="">
          <input type="text" />
        </form>
      </FormSubSection>
    </FormSection>
  );
}

export default SettingsSectionParagraphs;
