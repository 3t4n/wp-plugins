return ['domain'=>'flexible-coupons','plural-forms'=>'nplurals=3; plural=(n==1 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);','language'=>'pl_PL','project-id-version'=>'Flexible PDF Coupons for WooCommerce 1.10.5','pot-creation-date'=>'2024-12-23T13:50:22+00:00','po-revision-date'=>'YEAR-MO-DA HO:MI+ZONE','x-generator'=>'WP-CLI 2.11.0','messages'=>['Flexible PDF Coupons for WooCommerce'=>'Kupony PDF WooCommerce PRO','https://www.wpdesk.net/products/flexible-coupons/'=>'https://www.wpdesk.pl/sklep/flexible-coupons-woocommerce/','Flexible PDF Coupons for WooCommerce is a WooCommerce plugin with which you can create your gift cards, vouchers, or coupons in PDF format. Use it for your future marketing campaigns.'=>'Tworzy karty podarunkowe, vouchery i bilety w formacie PDF za pomocą wtyczki Kupony PDF WooCommerce.','WP Desk'=>'WP Desk','https://www.wpdesk.net/'=>'https://www.wpdesk.pl/','Coupon for buyer (Flexible Coupons)'=>'Kupon dla kupującego (Kupony PDF WooCommerce)','This message goes to the coupon buyer.'=>'Ta wiadomość trafi do kupującego kupon.','Coupon'=>'Kupon','[{site_title}] You have received a coupon'=>'[{site_title}] Otrzymałeś kupon','Read user\'s manual &rarr;'=>'Przeczytaj instrukcję obsługi &rarr;','Start Here'=>'Zacznij tutaj','Get support'=>'Uzyskaj pomoc techniczną','Before sending a message please:'=>'Przed wysłaniem wiadomości prosimy:','Prepare the information about the version of WordPress, WooCommerce, and Flexible Coupons (preferably your system status from WooCommerce->Status)'=>'Przygotuj informacje o wersji WordPress, WooCommerce i Kuponach PDF WooCommerce (najlepiej status Twojego systemu z WooCommerce->Status)','Describe the issue you have'=>'Opisz swój problem','Attach any log files & printscreens of the issue'=>'Załącz wszystkie pliki dziennika i zrzuty ekranu problemu','Ok, take me to support'=>'OK, przejdź do pomocy technicznej','No, I\'ll wait'=>'Nie, poczekam','Created with %1$s by Sailors from %2$sWP Desk%3$s - if you like Flexible Coupons rate us &rarr;'=>'Stworzony z %1$s przez %2$sWP Desk%3$s - jeśli lubisz Kupony PDF WooCommerce, oceń nas &rarr;','Settings'=>'Ustawienia','Docs'=>'Docs','Upgrade to PRO'=>'Ulepsz do PRO','Recipient name'=>'Nazwa odbiorcy','Recipient email'=>'Email odbiorcy','Recipient message'=>'Wiadomość dla odbiorcy','PDF Coupons'=>'Kupony PDF','Add New'=>'Dodaj nowy','New'=>'Nowy','Edit'=>'Edytuj','Views'=>'Zobacz','Templates'=>'Szablony','Search'=>'Szukaj','Parent:'=>'Rodzic:','No found.'=>'Nie znaleziono.','No found in Trash.'=>'Kosz jest pusty.','Manage coupons templates.'=>'Zarządzaj szablonami kuponów.','%1$sSure, it\'s worth it!%2$s'=>'%1$sOczywiście, warto!%2$s','%1$sNope, maybe later%2$s'=>'%1$sNie, może później%2$s','%1$sNo, never!%2$s'=>'%1$sNie, nigdy!%2$s','Amazing! You\'ve been using Flexible PDF Coupons for Woocommerce for two weeks. I hope it meets your expectations! If so, may I ask you for a big favor and a 5-star rating on the plugin\'s site?'=>'Niesamowite! Korzystasz z Kuponów PDF WooCommerce od dwóch tygodni. Mamy nadzieję, że spełnia Twoje oczekiwania! Jeśli tak, czy możemy prosić o wielką przysługę i ocenę na 5 gwiazdek na stronie wtyczki?','Upgrade to PRO and enable options below →'=>'Kup wersję PRO i korzystaj z opcji pod spodem →','Expiry date format'=>'Format daty wygaśnięcia','Define coupon expiry date format according to %1$sWordPress date formatting%2$s.'=>'Zdefiniuj format daty zgodny z zasadami %1$sformatowania daty w WordPressie%2$s.','PDF as attachment'=>'PDF jako załączniki','Enable'=>'Włącz','Enable to add PDF coupons as email attachments. If this option is disabled, recipients will only be able to download the coupon via a link in the email.'=>'Włącz aby dodawać kupony w formie PDF jako załączniki do emaila. Jeśli opcja jest wyłączona, pobranie kuponu będzie możliwe tylko za pomocą linku znajdującego się w emailu.','Coupon fields position on the product page'=>'Pozycja pól kuponu na stronie produktu','Below Add to cart button'=>'Pod przyciskiem Dodaj do koszyka','Above Add to cart button'=>'Nad przyciskiem Dodaj do koszyka','Select where the coupon fields will be displayed on the product page.'=>'Wybierz w której sekcji strony produktu będą wyświetlane pola kuponu.','Coupon code'=>'Kod kuponu','In this section you can define your own settings for coupon code.'=>'W tej sekcji możesz zdefiniować własne ustawienia dla kodu kuponu.','Coupon code prefix'=>'Prefiks kodu kuponu','Define the prefix which will be used as a beginning of your coupon code. Leave empty if you don’t want to use the prefix. Use <code>{order_id}</code> shortcode if you want to use the order number.'=>'Zdefiniuj prefiks od którego będzie zaczynał się kod generowanych kuponów. Pozostaw puste jeśli nie chcesz korzystać z prefiksu. Możesz użyć szortkodu <code>{order_id}</code> aby wykorzystać numer zamówienia.','Number of random characters'=>'Liczba losowych znaków','The number of random characters in the coupon code. Random characters will be used for generating unique coupon codes. Choose the number between 5 and 30.'=>'Liczba losowych znaków w kodzie kuponu. Losowe znaki zostaną użyte do generowania unikalnych kodów kuponów. Wybierz liczbę z zakresu od 5 do 30.','Coupon code suffix'=>'Sufiks kodu kuponu','Define the suffix which will be used as a end of your coupon code. Leave empty if you don’t want to use the suffix. Use <code>{order_id}</code> shortcode if you want to use the order number.'=>'Zdefiniuj sufiks, który będzie używany jako zakończenie kodu kuponu. Pozostaw puste jeśli nie chcesz korzystać z sufiksu. Możesz użyć szortkodu <code>{order_id}</code> aby wykorzystać numer zamówienia.','Coupon value'=>'Wartość kuponu','Always use the regular price of the product for the coupon value.'=>'Zawsze użyj ceny regularnej produktu dla wartości kuponu.','Hi %s,'=>'Cześć %s,','Download PDF with the coupon &raquo;'=>'Pobierz plik PDF z kuponem &raquo;','Coupon code: %s'=>'Kod kuponu: %s','Coupon value: %s'=>'Wartość kuponu: %s','Expiry date: %s'=>'Data wygaśnięcia: %s','Thanks for reading!'=>'Dzięki za przeczytanie!','Download PDF with the coupon from: %s'=>'Pobierz plik PDF z kuponem z: %s','Coupon information'=>'Informacje o kuponie','Grow your business with WP Desk'=>'Rozwijaj swój biznes razem z WP Desk','Buy now'=>'Kup teraz','Learn more'=>'Odwiedź','Download'=>'Pobierz','More info'=>'Więcej','Support'=>'Wsparcie','Saved'=>'Zapisano','Enter template title'=>'Wpisz tytuł szablonu','Template does not contain [coupon_code] shortcode'=>'Szablon nie zawiera szortkodu [coupon_code]','Data cannot be saved'=>'Nie można zapisać danych','General'=>'Główne','Images'=>'Obrazki','Text'=>'Tekst','Shortcodes'=>'Szortkody','QR Code'=>'Kod QR','Select format'=>'Wybierz format','Page orientation'=>'Orientacja wydruku','Vertical'=>'Pionowa','Horizontal'=>'Pozioma','Background color'=>'Kolor tła','Color'=>'Kolor','Select'=>'Wybierz','Select images'=>'Wybierz obrazki','Add to area'=>'Dodaj do obszaru','Remove from project'=>'Usuń z projektu','Fit to screen'=>'Wyrównaj do obszaru','Crop'=>'Przytnij','Layer up'=>'Warstwa wyżej','Layer down'=>'Warstwa niżej','Clone element'=>'Klonuj element','Delete element'=>'Usuń element','Change image'=>'Zmień obraz','Align right'=>'Wyrównaj do prawej','Align left'=>'Wyrównaj do lewej','Align center'=>'Wyśrodkuj','Justify'=>'Wyjustuj','Font size'=>'Rozmiar czcinki','Change font size'=>'Zmień rozmiar czcionki','Font family'=>'Krój czcionki','Change font family'=>'Zmień krój czcionki','Double click to edit'=>'Podwójne kliknięcie edytuje tekst','Font color'=>'Kolor czcionki','Header 1'=>'Nagłówek 1','Header 2'=>'Nagłówek 2','Header 3'=>'Nagłówek 3','Content'=>'Treść','%1$sUpgrade to PRO →%2$s and enable more shortcodes'=>'%1$sUlepsz do PRO →%2$s aby korzystać z innych szortkodów','Flexible Coupons PRO'=>'Kupony PDF WooCommerce w wersji PRO','This is an add-on for the PRO version. %1$sUpgrade to PRO →%2$s'=>'To jest dodatek do wersji PRO. %1$sUlepsz do PRO →%2$s','Add custom shortcodes with Flexible PDF Coupons PRO addon: %1$sCustom Shortcodes →%2$s'=>'Dodaj własne shortcody za pomocą dodatku Elastyczne Kupony PDF PRO: %1$sWłasne Szortkody →%2$s','Place a generated QR code on the template. Enable users to manage QR codes with the Event Ticket QR Scanner.'=>'Umieść wygenerowany kod QR na szablonie. Pozwól użytkownikom zarządzać kodami QR za pomocą dodatku Skaner Biletów QR.','Read more in plugin docs'=>'Przeczytaj więcej w dokumentacji wtyczki','Add QR codes with Flexible PDF Coupons PRO addon'=>'Dodaj kody QR z pomocą dodatku Kupony PDF WooCommerce PRO','Event Ticket QR Scanner'=>'Skaner Biletów QR','To use QR codes you need'=>'Aby korzystać z kodów QR, potrzebujesz wtyczki','Send coupons by email and schedule gift card delivery with Flexible PDF Coupons PRO addon'=>'Wysyłaj kupony mailem i planuj dostawy kart podarunkowych dzięki dodatkowi Kupony PDF WooCommerce PRO','Advanced Sending'=>'Zaawansowana Wysyłka','Send coupons by email and schedule gift card delivery'=>'Wysyłaj kupony mailem i planuj dostawy kart podarunkowych','Sending'=>'Zaawansowana Wysyłka','Editor'=>'Edytor','post type general nameEditor'=>'Edytor','post type singular nameEditor'=>'Edytor','admin menuEditor'=>'Edytor','add new on admin barEditor'=>'Edytor','Manage editor templates.'=>'Zarządzaj szablonami edytora.','%1$sUpgrade to PRO →%2$s to fully unlock all the features'=>'%1$sUlepsz do PRO →%2$s aby odblokować wszystkie funkcje','Save template'=>'Zapisz szablon','<strong>%s</strong>  is required field.'=>'Pole <strong>%s</strong>  jest wymagane.','<strong>%1$s</strong>  is to short. Minimum length: %2$d.'=>'Pole <strong>%1$s</strong>  jest za krótkie. Minimalna długość: %2$d.','<strong>%1$s</strong>  is to long. Maximum length: %2$d.'=>'Pole <strong>%1$s</strong>  jest za długie. Maksymalna długość: %2$d.','<strong>%s</strong>  has invalid email.'=>'Pole <strong>%s</strong>  zawiera błędny e-mail.','<strong>%s</strong> has an invalid date.'=>'<strong>%s</strong> ma nieprawidłową datę.','<strong>%s</strong> has a date from the past.'=>'<strong>%s</strong> ma datę z przeszłości.','Cannot generate coupon. Unknown order ID or item ID'=>'Nie można wygenerować kuponu. Nieznany ID zamówienia lub pozycji zamówienia','Cannot generate coupon'=>'Nie można wygenerować kuponu','Hi {recipient_name},'=>'Cześć {recipient_name},','Thanks to {buyer_name} you get a gift voucher for use in the {site_url} ({site_title}) store.'=>'Dzięki {buyer_name} otrzymujesz kupon podarunkowy do wykorzystania w sklepie {site_url} ({site_title}).','Download PDF with the coupon from: {coupon_url}'=>'Pobierz PDF z kuponem z: {coupon_url}','Coupon code: {coupon_code}'=>'Kod kuponu: {coupon_code}','Coupon value: {coupon_value}'=>'Wartość kuponu: {coupon_value}','Expiry date: {coupon_expiry}'=>'Data ważności: {coupon_expiry}','A message from the buyer:'=>'Wiadomość od kupującego:','{recipient_message}'=>'{recipient_message}','Read the %1$splugin documentation →%2$s'=>'Przeczytaj więcej w %1$sdokumentacji wtyczki →%2$s','Sample template'=>'Przykładowy szablon','Download PDF coupon'=>'Pobierz kupon PDF','PDF Coupon'=>'Kupon PDF','This coupon not exits or expired!'=>'Kupon nie istnieje lub wygasł!','Unknown template'=>'Nieznany szablon','Coupon doesn\'t exists.'=>'Kupon nie istnieje.','Convert this product to PDF Coupon'=>'Zaznaczenie spowoduje modyfikację produktu na kupon PDF','Your settings have been saved.'=>'Twoje ustawienia zostały zapisane.','Read more in the %1$splugin documentation →%2$s'=>'Przeczytaj więcej w %1$sdokumentacji wtyczki →%2$s','%1$sUpgrade to PRO →%2$s and enable options below'=>'%1$sUlepsz do PRO →%2$s i odblokuj poniższe opcje','Show field tips'=>'Wskazówki dotyczące pól','Show tooltips for fields.'=>'Pokaż podpowiedzi dla pól.','Show textarea counter'=>'Pokaż licznik pola tekstowego','Show character counter below textarea.'=>'Pokaż licznik znaków poniżej pola tekstowego.','Save Changes'=>'Zapisz zmiany','Email settings'=>'Ustawienia E-mail','For more specific email delay settings, visit the product edit page.'=>'Szczegółowe ustawienia opóźnienia wiadomości e-mail znajdziesz w edycji każdego produktu.','Attachments in the e-mail'=>'Załączniki w e-mailu','Attach PDF file to coupon email'=>'Dołącz plik PDF do e-maila z kuponem','Buy %1$sFlexible PDF Coupons PRO - Advanced Sending →%2$s and enable options below'=>'Kup %1$sElastyczne Kupony PDF PRO - Zaawansowana Wysyłka →%2$s i włącz poniższe opcje','%1$sGet Flexible Coupons PRO with add-ons in one Bundle →%2$s'=>'%1$sKup pakiet Kupony PDF z wszystkimi dodatkami →%2$s','Additional recipients'=>'Dodaj dodatkowych odbiorców','E-mail address'=>'Adres e-mail','Add additional recipients'=>'Dodaj dodatkowych odbiorców','Email subject'=>'Temat e-maila','You can use the following placeholders: {recipient_name}, {recipient_message}, {recipient_email}, {buyer_name}, {coupon_url}, {coupon_code}, {coupon_value}, {coupon_expiry}, {site_title}, {site_url}, {admin_email}, {current_date}, {site_description}'=>'Możesz użyć następujących symboli zastępczych: {recipient_name}, {recipient_message}, {recipient_email}, {buyer_name}, {coupon_url}, {coupon_code}, {coupon_value}, {coupon_expiry}, {site_title}, {site_url}, {admin_email}, {current_date}, {site_description}.','E-mail body'=>'Treść e-maila','Emails'=>'E-maile','Automatically generate coupons'=>'Automatyczne generowanie kuponów przy statusie zamówienia','If you want the coupon to be generated automatically, select order status. Coupon will be generated and sent automatically when order status is changed to selected status.'=>'Jeśli chcesz aby kupon był automatycznie generowany i wysyłany do klienta, wybierz status zamówienia. Gdy status zamówienia zostanie zmieniony na wybrany, kupon zostanie wygenerowany i wysłany w wiadomości e-mail.','Allow URL Fopen'=>'Allow URL Fopen','Do not generate'=>'Nie generuj','Enabled'=>'Włączono','Disabled'=>'Wyłączono','Main settings'=>'Ustawienia główne','Define own coupon code'=>'Zdefiniuj własny kod kuponu','Enable this option to overwrite plugin settings and configure your own coupon code settings for this product.'=>'Włącz tę opcję aby pominąć ustawienia wtyczki i skonfigurować własne ustawienia kodu kuponu dla tego produktu.','Define the prefix which will be used as a beginning of your coupon code. Leave empty if you don’t want to use the prefix. Use {order_id} shortcode if you want to use the order number.'=>'Zdefiniuj prefiks od którego będzie zaczynał się kod generowanych kuponów. Pozostaw puste jeśli nie chcesz korzystać z prefiksu. Możesz użyć szortkodu {order_id} aby wykorzystać numer zamówienia.','Define the suffix which will be used as a end of your coupon code. Leave empty if you don’t want to use the suffix. Use {order_id} shortcode if you want to use the order number.'=>'Zdefiniuj sufiks, który będzie używany jako zakończenie kodu kuponu. Pozostaw puste jeśli nie chcesz korzystać z sufiksu. Możesz użyć szortkodu {order_id} aby wykorzystać numer zamówienia.','Date'=>'Data','Interval'=>'Przedział czasowy','Hours'=>'Godziny','Days'=>'Dni','Weeks'=>'Tygodnie','Months'=>'Miesiące','Simple Delay'=>'Proste opóźnienie','Send email on Fixed date'=>'Wyślij e-mail w ustalonym terminie','Send email on Customer defined date'=>'Wyślij e-mail w terminie określonym przez klienta','Email Delay Type'=>'Typ opóźnienia e-maila','Select the type of email delay. If you do not want to delay it, you can deactivate this feature by selecting Disabled.'=>'Wybierz typ opóźnienia wiadomości e-mail. Jeśli nie chcesz opóźniać wiadomości, możesz wyłączyć tę funkcję, wybierając opcję Wyłączone.','Read about each type of delay in the documentation →'=>'Przeczytaj o każdym typie opóźnienia w dokumentacji →','Delay'=>'Opóźnienie','Disable the PDF coupon for this variation'=>'Wyłącz kupon PDF dla tego wariantu','Own expiration time'=>'Własny termin wygaśnięcia','Define own time from purchase to expiration of a generated coupon.'=>'Ustaw własny termin wygaśnięcia wygenerowanego kuponu.','never'=>'nigdy','7 days'=>'7 dni','14 days'=>'14 dni','30 days'=>'30 dni','60 days'=>'60 dni','90 days'=>'90 dni','365 days'=>'365 dni','Set your own date'=>'Ustaw własny termin','Expiration time'=>'Czas do wygaśnięcia','Time from purchase to expiration of a generated coupon'=>'Czas od wygenerowania kuponu po zakupie do jego do wygaśnięcia','Allow free shipping'=>'Włącz darmową wysyłkę','Check if you want the coupon to provide free shipping. The coupon requirement for free shipping must be included in the shipping method.'=>'Zaznacz jeśli chcesz aby kupon zapewnił darmową wysyłkę. Wymóg kuponu dla darmowej wysyłki musi być włączony przy metodzie wysyłki.','Product categories'=>'Kategorie produktów','Any category'=>'Każda kategoria','Categories for which the coupon will be used. Do not select any to apply to all categories.'=>'Kategorie dla których kupon będzie zastosowany. Nie wybieraj żadnej aby zastosować dla wszystkich kategorii.','Products'=>'Produkty','Search for a product&hellip;'=>'Szukaj produktu&hellip;','Products for which the coupon will be used. Do not select any to apply to all products.'=>'Produkty dla których kupon będzie zastosowany. Nie wybieraj żadnego aby zastosować dla wszystkich produktów.','Split coupons by product quantity'=>'Podziel kupony według ilości produktów','Enable this option to split coupons as different products in cart.'=>'Włącz tę opcję, aby rozdzielić kupony jako różne produkty w koszyku.','Limit recipient forms per product'=>'Limit formularzy odbiorcy na produkt','Enter the maximum number of recipient forms on the product page.'=>'Wprowadź maksymalną liczbę formularzy odbiorców na stronie produktu.','Send coupons to first recipient'=>'Wyślij kupony do pierwszego odbiorcy','Enable this option to send all bought coupons to email of first recipient. This option disables email field for other recipients.'=>'Włącz tę opcję, aby wysłać wszystkie zakupione kupony na adres e-mail pierwszego odbiorcy. Ta opcja wyłącza pole e-mail dla innych odbiorców.','Show or hide this field in product page.'=>'Pokaż lub ukryj pole na stronie produktu.','Required'=>'Wymagane','If checked field will be set as required.'=>'Jeśli pole jest zaznaczone, zostanie ustawione jako wymagane.','Coupon template'=>'Szablon kuponu','Select coupon template for this product'=>'Wybierz szablon kuponu dla tego produktu','Allow to multiuse'=>'Włącz wielokrotne użycie','Check this option if you want to allow customer to spread the coupon value over several purchases. For example, a coupon worth $100 for two purchases of $50.'=>'Zaznacz jeśli chcesz aby klient mógł rozłożyć wartość kuponu na kilka zakupów. Np. kupon o wartości 100 zł na dwa zakupy po 50 zł.','Coupon code:'=>'Kod kuponu:','View PDF'=>'Zobacz PDF','View'=>'Zobacz','Product name:'=>'Nazwa produktu:','Generate coupon'=>'Generuj kupon','Buy %1$sFlexible PDF Coupons PRO - Multiple PDFs →%2$s and enable options below'=>'Kup %1$sElastyczne Kupony PDF PRO - Multi Kupony →%2$s i włącz poniższe opcje','Save'=>'Zapisz','Manage Flexible PDF Coupons settings for variation'=>'Zarządzaj ustawieniami Kuponów PDF dla wariantu','Enable individual Flexible PDF Coupons options at variation level'=>'Włącz ustawienia kuponu PDF na poziomie wariantu','Set image'=>'Wstaw obraz','Remove image'=>'Usuń obraz','Select or Upload Media'=>'Wybierz lub prześlij media','Use this media'=>'Wybierz','Emergency'=>'Wypadek','Alert'=>'Ostrzeżenie','Critical'=>'Błąd krytyczny','Error'=>'Błąd','Warning'=>'Ostrzeżenie','Notice'=>'Powiadomienie','Info'=>'Informacja','Debug'=>'Debugowanie','Can not enable WP Desk Debug log! Cannot create directory %s or this directory is not writeable!'=>'Nie można włączyć WP Desk Debug log! Nie można utworzyć katalogu %s lub brak uprawnień do zapisu w tym katalogu!','Can not enable WP Desk Debug log! Cannot create file %s!'=>'Nie można włączyć logowania błędów za pomocą WP Desk Debug! Nie można utworzyć pliku %s!','You successfully opted out of collecting usage data by %1$s. If you change your mind, you can always opt in later in the plugin\'s quick links.'=>'Twoja rezygnacja ze zbierania danych użytkowania wtyczek przez %1$s została przyjęta. Jeśli zmienisz zdanie, zawsze możesz włączyć zgodę ponownie za pomocą szybkich linków na liście wtyczek.','Enable usage tracking'=>'Włącz śledzenie użycia','Disable usage tracking'=>'Wyłącz śledzenie użycia','Hey %s,'=>'Hej %s,','Please help us improve our plugins! If you opt-in, we will collect some non-sensitive data and usage information anonymously. If you skip this, that\'s okay! All plugins will work just fine.'=>'Proszę pomóż nam udoskonalić nasze wtyczki! Jeśli się zgodzisz, będziemy zbierać niewrażliwe dane użytkowania anonimowo. Jeśli pominiesz ten krok, w porządku! Wszystkie wtyczki będą działać niezależnie od Twojej decyzji.','Allow & Continue &rarr;'=>'Pozwól i kontynuuj &rarr;','Skip'=>'Pomiń','What permissions are being granted?'=>'Jakie uprawnienia są przyznawane?','Your Site Overview'=>'Dane witryny','WP version, PHP info'=>'Wersja WP, wersja PHP','Plugin Usage'=>'Dane użytkowania wtyczek','Current settings and usage information of %1$s plugins'=>'Ustawienia i informacje o użytkowaniu wtyczek %1$s','Your Store Overview'=>'Dane sklepu','Anonymized and non-sensitive store usage information'=>'Tylko niewrażliwe i anonimowe dane o użytkowaniu sklepu','Find out more &raquo;'=>'Dowiedz się więcej &raquo;','Current settings and usage information of WP Desk plugins'=>'Ustawienia i informacje o użytkowaniu wtyczek WP Desk','You are deactivating %s plugin.'=>'Dezaktywujesz wtyczkę %s.',' If you have a moment, please let us know why you are deactivating plugin (anonymous feedback):'=>' Jeśli masz chwilę, prosimy daj nam znać dlaczego dezaktywujesz wtyczkę (anonimowa opinia):','The plugin suddenly stopped working'=>'Wtyczka nagle przestała działać','The plugin broke my site'=>'Wtyczka zepsuła moją stronę','I found a better plugin'=>'Znalazłem lepszą wtyczkę','What\'s the plugin\'s name?'=>'Jaka to wtyczka?','I only needed the plugin for a short period'=>'Potrzebowałem wtyczki tylko przez krótki okres','I no longer need the plugin'=>'Nie potrzebuję już wtyczki','It\'s a temporary deactivation. I\'m just debugging an issue.'=>'Jest to tymczasowa dezaktywacja, debuguję problem.','Other'=>'Inny','Kindly tell us the reason so we can improve'=>'Napisz nam powód abyśmy mogli go poprawić','Cancel'=>'Anuluj','Skip &amp; Deactivate'=>'Pomiń i dezaktywuj','We need your help to improve <strong>WP Desk plugins</strong>, so they are more useful for you and the rest of <strong>30,000+ users</strong>. By collecting data on how you use our plugins, you will help us a lot. We will not collect any sensitive data, so you can feel safe.'=>'Potrzebujemy Twojej pomocy, aby dalej rozwijać <strong>wtyczki WP Desk</strong> i były one jeszcze bardziej pomocne dla Ciebie i pozostałych ponad <strong>30 000 użytkowników</strong>. Zbierając dane na temat tego jak korzystasz z naszych wtyczek bardzo nam w tym pomożesz. Nie będziemy zbierać żadnych danych wrażliwych, więc możesz czuć się bezpiecznie.','You successfully opted out of collecting usage data by WP Desk. If you change your mind, you can always opt in later in the plugin\'s quick links.'=>'Twoja rezygnacja ze zbierania danych użytkowania wtyczek przez WP Desk została przyjęta. Jeśli zmienisz zdanie, zawsze możesz włączyć zgodę ponownie za pomocą szybkich linków na liście wtyczek.','https://www.wpdesk.net/products/flexible-coupons-woocommerce/'=>'https://www.wpdesk.pl/sklep/flexible-coupons-woocommerce/','In response to an order %s placed %s, we are sending you a coupon for shopping in our shop.'=>'W odpowiedzi na złożone zamówienie %s dnia %s wysyłamy Ci kupon na zakupy w naszym sklepie.','The &#8220;%s&#8221; plugin cannot run on PHP versions older than %s. Please contact your host and ask them to upgrade.'=>'Wtyczka &#8220;%s&#8221; nie może działać na wersjach PHP starszych niż %s. Skontaktuj się z administratorem hostingu i poproś o aktualizację wersji PHP.','The &#8220;%s&#8221; plugin cannot run on WordPress versions older than %s. Please update WordPress.'=>'Wtyczka &#8220;%s&#8221; nie może działać na wersjach WordPressa starszych niż %s. Wykonaj aktualizację WordPressa.','The &#8220;%s&#8221; plugin cannot run on WooCommerce versions older than %s. Please update WooCommerce.'=>'Wtyczka &#8220;%s&#8221; nie może działać na wersjach WooCommerce starszych niż %s. Wykonaj aktualizację WooCommerce.','The &#8220;%s&#8221; plugin cannot run without OpenSSL module version at least %s. Please update OpenSSL module.'=>'Wtyczka &#8220;%s&#8221; nie może działać bez aktywacji OpenSSL co najmniej w wersji %s. Wykonaj aktualizację OpenSSL.','The &#8220;%1$s&#8221; plugin requires at least %2$s version of %3$s to work correctly. Please update it to its latest release.'=>'Do poprawnego działania wtyczki &#8220;%1$s&#8221; wymagana jest wtyczka %3$s co najmniej w wersji %2$s. Wykonaj jej aktualizację.','The &#8220;%s&#8221; plugin cannot run without %s active. Please install and activate %s plugin.'=>'Wtyczka &#8220;%s&#8221; nie może działać bez aktywacji %s. Zainstaluj i aktywuj wtyczkę %s.','The &#8220;%s&#8221; plugin requires free %s plugin. <a href="%s">Install%s</a>'=>'Wtyczka &#8220;%s&#8221; wymaga bezpłatnej wtyczki %s. <a href="%s">Zainstaluj %s</a>','The &#8220;%s&#8221; plugin requires activating %s plugin. <a href="%s">Activate %s</a>'=>'Wtyczka &#8220;%s&#8221; wymaga aktywnej wtyczki %s. <a href="%s">Włącz %s</a>','The &#8220;%s&#8221; plugin cannot run without %s PHP module installed. Please contact your host and ask them to install %s.'=>'Wtyczka &#8220;%s&#8221; nie może działać bez modułu PHP: %s. Skontaktuj się z administratorem hostingu i poproś o instalację %s.','The &#8220;%s&#8221; plugin cannot run without %s PHP setting set to %s. Please contact your host and ask them to set %s.'=>'Wtyczka &#8220;%s&#8221; nie może działać bez ustawienia PHP %s ustawionego na %s. Skontaktuj się z administratorem hostingu i poproś o ustawienie %s.','The &#8220;%s&#8221; plugin is temporarily disabled since the required %s plugin is being upgraded.'=>'Wtyczka &#8220;%s&#8221; została chwilowo wyłączona, ponieważ wymagana wtyczka %s jest właśnie aktualizowana.','Submit &amp; Deactivate'=>'Wyślij i dezaktywuj','Allow'=>'Pozwól']];