	color:#fff;

}

div.img-h47 a{

	color:transparent !important;

}

div.img-h47:hover a{

	color: #fff !important;

}


/* style 9 */


.img-box-qq{
	width:32%;
	float:left;
		overflow:hidden;

}
.img-box-qq .img{
	height:300px;
	width:100%;
	overflow:hidden;
	position:relative;
}
.img-box-qq .img img{
	width:100%;
	height:100%;
	overflow:hidden;
	transition:1s;
}
.img-box-qq .title {
	width:100%;
	
	text-align:center;
	height:60px;
	transition:.5s;
	overflow:hidden;
}
.img-box-qq .title h2{

	font-size:12px;
	color:#333333;
	transition:.5s;
}
.img-box-qq:hover .title{
	background:#43B4F9;
	border: 1px solid #eee;
}
.img-box-qq:hover .title h2{
	color:#fff;
	
}
.img-box-qq:hover .img img{
	height:140%;
	width:140%;
}
.img-box-qq .blr-ccsw {
	width:100%;
	height:100%;
	position:absolute;
	top:0;
	transition:1s;
	text-align:center;
}

.img-box-qq .blr-ccsw  h2 {
    color: transparent !important;
    text-align: center;
    font-family: tahoma;
    transition: all 0.5s ease 0s;
    position: absolute;
    top: 0px;
    left: 0px;
    right: 0px;
    margin: auto;
}


.img-box-qq .blr-ccsw :hover h2 {
color: #000 !important;
top: 16px !important;
font-size: 21px;
}


.img-box-qq .blr-ccsw i{
	font-size:30px;
	margin-top:130px;
	height:30px;
	width:30px;
	border-radius:50%;
	transition:1s;
	color:transparent;

	box-shadow:0 0 0 80px transparent;
	

}
.img-box-qq :hover .blr-ccsw{
	background:rgba(255, 255, 255, .7);
}
.img-box-qq:hover .blr-ccsw i{
	box-shadow:0 0 0 30px rgba(67, 180, 249, .5);
	color:#fff;
	background:rgba(67, 180, 249, .5);
}


