div.portfolios-sections a {
	text-decoration:none !important;
	bottom:10%;
	color:#fff !important;

	width: 40%;}


div.portfolios-sections h3 {
	font-family: "Unica One","Neuton","Helvetica Neue",Helvetica,Arial,sans-serif;
	font-weight: 400;
	font-size: 23px;
	line-height: 0.1;
	
}

div.portfolios-sections p {
	font-family: "Unica One","Neuton","Helvetica Neue",Helvetica,Arial,sans-serif;
	font-weight: 400;
	font-size: 16px;
	color: #fff;
    text-align: center;
	
}



.img-box-exclusive-pri2010{
	
	background-repeat:no-repeat;
    background-image: url("http://localhost/plugin/wp-content/uploads/2015/12/10011496_1689760781311090_4337367241788349520_n.jpg");
	background-position:center center;
	background-size:100% 100%;
	transition:.5s;
	position:relative;
	float:left;
	overflow:hidden;
}
.img-box-exclusive-pri2010:after{
	content:'';
	display:block;
	clear:both;
}
.img-box-exclusive-pri2010:hover{
		background-size:120% 120%;
}
.img-box-exclusive-pri2010 h3{
	color:transparent;
	text-align:center;

	transition: .5s;
	position:absolute;
	top:0;
	left:0;
	right:0;
	margin:auto;
}
.img-box-exclusive-pri2010:hover h3{
		color:#fff !important;
		top:10px !important;
		font-size: 26px;
		font-family: "Unica One","Neuton","Helvetica Neue",Helvetica,Arial,sans-serif;
		font-weight: 400;
		line-height: 1.1;
		color: inherit;
}

.img-box-exclusive-pri2010 p{
	color:transparent;
	text-align:center;
	font-family: "Unica One","Neuton","Helvetica Neue",Helvetica,Arial,sans-serif;
	transition: .5s;
	position:absolute;
	top:0;
	left:0;
	right:0;
	margin:auto;
	font-size: 16px;
}

.img-box-exclusive-pri2010:hover p {
	color:#fff !important;
	top:80px !important;
	
}

.circles-items {
display: -moz-box; 
}

.blr-exclusive-pri2010 a{
	color:transparent !important;
	text-align:center;
	
	margin:0;
	display:block;
	padding:8px 12px;
	width:55%;
	background:transparent;
	text-decoration:none;
	position:absolute;
	bottom:0;
	left:0;
	right:0;
	margin:auto;
	font-weight:bold;
	transition:.5s;
	

}
.blr-exclusive-pri2010:hover a{
	bottom:10px;
	color:#fff !important;
	border: 1px solid #FFF;
}
.blr-exclusive-pri2010{
	width:100%;
	height:100%;
	position:absolute;
	transition:.5s;
	top:0;
	left:0;
}
.img-box-exclusive-pri2010:hover .blr-exclusive-pri2010{
		background:rgba(0,0,0,.5);
}


    /* style4 */


.img-box-exclusive-pri2010-circles{
	
	background-repeat:no-repeat;
	width:33%;
	height:300px;
	background-position:center center;
	background-size:100% 100%;
	transition:.5s;
	position:relative;
	overflow:hidden;
	display: -moz-box;
}
.img-box-exclusive-pri2010-circles:after{
	content:'';
	display:block;
	clear:both;
}
.img-box-exclusive-pri2010-circles:hover{
		background-size:120% 120%;
}
.img-box-exclusive-pri2010-circles h3{
	color:transparent;
	text-align:center;
	opacity:0;
	transition: .5s;
	position:absolute;
	top:0;
	left:0;
	right:0;
	margin:auto;
}
.img-box-exclusive-pri2010-circles:hover h3{
	color: #fff;
	top: 20%;
	opacity:1;
}

.img-box-exclusive-pri2010-circles p{
	color:transparent ;
	text-align:center;
	opacity:0;
	transition: .5s;
	position:absolute;
	top:0;
	left:0;
	right:0;
	margin:auto;
}


.img-box-exclusive-pri2010-circles:hover p{
		color:#fff;
