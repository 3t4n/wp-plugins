/*hover effect css*/

/*simple desing*/

.portfolios-sections{max-width: 1024px;margin: 10px auto;}
.all_hover_items{padding: 10px;text-align: center;}
.hover_item{display: -moz-box;}

@media all and (max-width: 780px) {
	.hover_item{max-width: 40%}
	.img-box-exclusive-pri2010-circles {width: 40%}
	.img-box-exclusive-pri2010-style5 {width: 40%}
	.img-box-exclusive-pri2010-style5-circles {width: 40%}
	.img-box-c47 {width: 40%}
	.img-h47 {width: 40%}
	.hover_item {width: 40%}
	.hover_effect_twenty_two {width: 40%}
    .img-box-exclusive-pri2010-style5-circles {width: 40%}
	.img-box-caca {width: 40%}
	.all_hover_items .hover_item:nth-child(3n) {
		display: none;
	}
}
@media all and (max-width: 480px) {
	.hover_item{max-width: 90%}
	.img-box-exclusive-pri2010-circles {width: 90%}
	.img-box-exclusive-pri2010-style5 {width: 90%}
	.img-box-c47 {width: 90%}
	.hover-img-box-ccc {width: 90%}
	.hover_effect_twenty_two {width: 90%}
	.hover_item {width: 90%}
	.img-box-exclusive-pri2010-style5-circles {width: 90%}
	.img-box-caca {width: 90%}
	.img-h47 {width: 90%}
	.img-box-exclusive-pri2010-style5-circles {width: 90%}
	.all_hover_items .hover_item:nth-child(2n) {
		display: none;
	}
}
.dont_show{display: none;}


/*basic content style*/
h2{margin:15px 0px;}
.hover_item > h2{text-transform: capitalize;font-size: 25px;font-family: tahoma;font-weight: normal;color:#2e4154;}
div.hover_item > h3,div.hover_item > h2{color: black;font-size: 22px;margin:10px 0px;}
div.hover_item > p,div.hover_item > span{color: black;font-size: 14;margin:10px 0px;}
.hover_item a{color: #e85647;text-decoration: none;padding:7px;box-shadow: 0px 0px 0px 0px currentcolor !important;border: 1px solid #fff; }




/*all hover item css one by one*/
/*hover effect one*/
.hover_effect_one{position: relative;width: 100%;height: 100%;}
.hover_effect_one img{width: 300px;height:300px;display: block;}
.hover_hidden_conent_one{
	position: absolute;
	left: 0px;
	top: 0px;
	height: 100%;
	width: 100%;
	opacity: 0;
	text-align: center;
	text-decoration:none;
	background: #925283;
	-webkit-backface-visibility: hidden;
	-moz-backface-visibility: hidden;
	backface-visibility: hidden;
	-webkit-transition: -webkit-transform 0.3s, opacity 0.3s;
	-moz-transition: -moz-transform 0.3s, opacity 0.3s;
	transition: transform 0.3s, opacity 0.3s;
}

.hover_hidden_conent_one h2 {
	margin-bottom:20px;
}

.hover_hidden_conent_one span {
	margin-bottom: 20px;
display: block;
}


/*when hover */
.hover_effect_one:hover .hover_hidden_conent_one{
	opacity: 0.8;
	-webkit-transform: translate(15px, 15px);
	-moz-transform: translate(15px, 15px);
	-ms-transform: translate(15px, 15px);
	transform: translate(15px, 15px);
	
}


.hover_effect_one:hover .hover_hidden_conent_one h3 {margin-top: 35px;color:#fff;margin-bottom: 20px;}

.hover_effect_one:hover .hover_hidden_conent_one span {color:#fff;}

.hover_effect_one a {
   display: block;
   margin: auto;
}

/*end hover effect one*/


/*begin hover effect two*/
/*hover_effect_two*/
.hover_effect_two{
	position: relative;
	width: 100%;
	height: 100%;
}
.hover_effect_two img{
	max-width: 100%;
	display: block;
	position: relative;
	z-index: 99;
	-webkit-transition: -webkit-transform 0.4s;
	-moz-transition: -moz-transform 0.4s;
	transition: transform 0.4s;
}
/*when hover */
.hover_effect_two:hover img {
	-webkit-transform: translateY(-90px);
	-moz-transform: translateY(-90px);
	-ms-transform: translateY(-90px);
	transform: translateY(-90px);
}

.hover_hidden_conent_two{
	background: #2c3f52;
	position: absolute;
	height: 90px;
	width: 100%;
	top: auto;
	bottom: 0;
	z-index: 9;
}
/*end hover effect two*/


/*begin hover effect three*/
/*hover_effect_three*/
.hover_effect_three{
	position: relative;
	width: 100%;
	height: 100%;
	overflow: hidden;
}
.hover_effect_three img{
	max-width: 100%;
	display: block;
	-webkit-transition: -webkit-transform 0.4s;
	-moz-transition: -moz-transform 0.4s;
	transition: transform 0.4s;
}
/*when hover */
.hover_effect_three:hover img {
	-webkit-transform: translateY(-50px);
	-moz-transform: translateY(-50px);
	-ms-transform: translateY(-50px);
	transform: translateY(-50px);
}
.hover_hidden_conent_three{
	background: #2c3f52;
	position: absolute;
	height: 100px;
	width: 100%;
	top: auto;
	bottom: 0;
	opacity: 0;
	-webkit-transform: translateY(100%);
	-moz-transform: translateY(100%);
	-ms-transform: translateY(100%);
	transform: translateY(100%);
	-webkit-transition: -webkit-transform 0.4s, opacity 0.1s 0.3s;
	-moz-transition: -moz-transform 0.4s, opacity 0.1s 0.3s;
	transition: transform 0.4s, opacity 0.1s 0.3s;
}
/*when hover */
.hover_effect_three:hover .hover_hidden_conent_three{
	opacity: 1;
	-webkit-transform: translateY(0px);
	-moz-transform: translateY(0px);
	-ms-transform: translateY(0px);
	transform: translateY(0px);
	-webkit-transition: -webkit-transform 0.4s, opacity 0.1s;
	-moz-transition: -moz-transform 0.4s, opacity 0.1s;
	transition: transform 0.4s, opacity 0.1s;
}
/*end hover effect three*/


/*begin hover effect four*/
/*hover_effect_four*/
.hover_item{
	-webkit-perspective: 1700px;
	-moz-perspective: 1700px;
	perspective: 1700px;
	-webkit-perspective-origin: 0 50%;
	-moz-perspective-origin: 0 50%;
	perspective-origin: 0 50%;
}
.hover_effect_four{
	position: relative;
	width: 100%;
	height: 100%;
	-webkit-transform-style: preserve-3d;
	-moz-transform-style: preserve-3d;
	transform-style: preserve-3d;
}
.hover_effect_four > div{
	overflow: hidden;
}
.hover_effect_four img{
	max-width: 100%;
	-webkit-transition: -webkit-transform 0.4s;
	-moz-transition: -moz-transform 0.4s;
	transition: transform 0.4s;
}
/*when hover */
.hover_effect_four:hover img {
	-webkit-transform: translateX(25%);
	-moz-transform: translateX(25%);
	-ms-transform: translateX(25%);
	transform: translateX(25%);
}
.hover_hidden_conent_four{
	background: #633F75;
	position: absolute;
	height: 100%;
	width: auto;
	opacity: 0;
	left: 0px;
	top: 0px;
	-webkit-backface-visibility: hidden;
	-moz-backface-visibility: hidden;
	backface-visibility: hidden;
	-webkit-transform-origin: 0 0;
	-moz-transform-origin: 0 0;
	transform-origin: 0 0;
	-webkit-transform: rotateY(-90deg);
	-moz-transform: rotateY(-90deg);
	transform: rotateY(-90deg);
	-webkit-transition: -webkit-transform 0.4s, opacity 0.1s 0.3s;
	-moz-transition: -moz-transform 0.4s, opacity 0.1s 0.3s;
	transition: transform 0.4s, opacity 0.1s 0.3s;
}
/*when hover */
.hover_effect_four:hover .hover_hidden_conent_four{
	opacity: 0.8 !important;
	-webkit-transform: rotateY(0deg);
	-moz-transform: rotateY(0deg);
	transform: rotateY(0deg);
	-webkit-transition: -webkit-transform 0.4s, opacity 0.1s;
	-moz-transition: -moz-transform 0.4s, opacity 0.1s;
	transition: transform 0.4s, opacity 0.1s;
}
/*end hover effect four*/





/*begin hover effect six*/
/*hover_effect_six*/
.hover_effect_six{
	position: relative;
	width: 100%;
	height: 100%;
}
.hover_effect_six img{
	max-width: 100%;
	position: relative;
	z-index: 10;
	-webkit-transition: -webkit-transform 0.4s;
	-moz-transition: -moz-transform 0.4s;
	transition: transform 0.4s;
}
/*when hover */
.hover_effect_six:hover img {
	-webkit-transform: translateY(-50px) scale(0.5);
	-moz-transform: translateY(-50px) scale(0.5);
	-ms-transform: translateY(-50px) scale(0.5);
	transform: translateY(-50px) scale(0.5);
}
.hover_hidden_conent_six{
	background: #2c3f52;
	position: absolute;
	height: 98%;
	width: 100%;
	top: 0px;
	left: 0px;
}
/*text style*/
.hover_hidden_conent_six h3{
	margin-top: 45%;
}

/*when hover */
.hover_effect_six:hover .hover_hidden_conent_six{
	opacity: 1;
	-webkit-transform: translateY(0px);
	-moz-transform: translateY(0px);
	-ms-transform: translateY(0px);
	transform: translateY(0px);
	-webkit-transition: -webkit-transform 0.4s, opacity 0.1s;
	-moz-transition: -moz-transform 0.4s, opacity 0.1s;
	transition: transform 0.4s, opacity 0.1s;
}
/*end hover effect six*/

/*begin hover effect seven*/
/*hover_effect_seven*/
.extra_zindex{
	position: relative;
	z-index: 9999
}
.hover_effect_seven{
	position: relative;
	width: 100%;
	height: 100%;
}
.hover_effect_seven img{
	max-width: 100%;
	position: relative;
	z-index: 10;
}

.hover_hidden_conent_seven{
	background: #2c3f52;
	position: absolute;
	left: 0px;
	top: 0px;
	opacity: 0;
	width: 100%;
	height: 100%;
	-webkit-backface-visibility: hidden;
	-moz-backface-visibility: hidden;
	backface-visibility: hidden;
	-webkit-transition: opacity 0.3s, height 0.3s, box-shadow 0.3s;
	-moz-transition: opacity 0.3s, height 0.3s, box-shadow 0.3s;
	transition: opacity 0.3s, height 0.3s, box-shadow 0.3s;
	box-shadow: 0 0 0 0px #2c3f52;
	z-index: 9;
}
/*when hover */
.hover_effect_seven:hover .hover_hidden_conent_seven{
	opacity: 1;
	height: 130%;
	box-shadow: 0 0 0 10px #2c3f52;
}
/*text effect*/
div.hover_hidden_conent_seven > h3 {
	margin-top: 80%;
	margin-bottom: 0px;
}

div.hover_hidden_conent_seven > h3,
.hover_hidden_conent_seven span,
div.hover_hidden_conent_seven > a{
	opacity: 0;
	-webkit-transition: opacity 0s;
	-moz-transition: opacity 0s;
	transition: opacity 0s;
}
.hover_effect_seven:hover h3,.hover_effect_seven:hover span,.hover_effect_seven:hover a{
	opacity: 1;
}
/*.hover_hidden_conent_seven a {
	position: absolute;
	bottom: 20px;
	right: 20px;
}*/
/*end hover effect seven*/



/*hover effect eight*/

.hover_fold {
  background: #e8c63d;
  height: 188px;
  -moz-perspective: 1500;
  -webkit-perspective: 1500;
  perspective: 1500;
  position: relative;
  width: 100;
}
div.hover_fold > h2 {
  border-bottom: 1px solid #333;
  margin: 0 40px;
  padding: 110px 0 2px;
}
.hover_fold .hover_fold_top {
  height: 50%;
  -moz-transition: all 0.5s ease-out;
  -o-transition: all 0.5s ease-out;
  -webkit-transition: all 0.5s ease-out;
  transition: all 0.5s ease-out;
  -moz-transform: rotateX(0deg);
  -ms-transform: rotateX(0deg);
  -webkit-transform: rotateX(0deg);
  transform: rotateX(0deg);
  -moz-transform-origin: 0 100%;
  -ms-transform-origin: 0 100%;
  -webkit-transform-origin: 0 100%;
  transform-origin: 0 100%;
  -moz-transform-style: preserve-3d;
  -webkit-transform-style: preserve-3d;
  transform-style: preserve-3d;
  position: absolute;
  top: 0px;
  width: 100%;
  z-index: 10;
}
.hover_fold .hover_fold_top .hover_fold_face {
  -moz-backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  backface-visibility: hidden;
  position: absolute;
}
.hover_fold:hover .hover_fold_top {
  -moz-transform: rotateX(-180deg);
  -ms-transform: rotateX(-180deg);
  -webkit-transform: rotateX(-180deg);
  transform: rotateX(-180deg);
}
.hover_fold .hover_fold_front {
  /*has to be 100% of .top */
  background: url(img/1.jpg);
  height: 100%;
  width: 100%;
  background-size: cover;
}
.hover_fold .hover_fold_back {
  background: #e8c63d;
  height: 100%;
  /*has to be 100% of .top */
  -moz-transform: rotateX(180deg);
  -ms-transform: rotateX(180deg);
  -webkit-transform: rotateX(180deg);
  transform: rotateX(180deg);
  width: 100%;
}
.hover_fold .hover_fold_back p {
  margin: 0;
}
.hover_fold .hover_fold_bottom {
  background: url(img/1.jpg) bottom;
  height: 50%;
  position: absolute;
  top: 50%;
  width: 100%;
  z-index: 0;
  background-size: cover;
}
/*end hover effect eight*/


/*hover effect nine*/
.hover_effect_nine{
	position: relative;
	height: 215px;
	width: 100%;
	overflow: hidden;
	z-index: 999;
	cursor: pointer;
	color:black;
}
.hover_effect_nine_content{
	width: 100%;
	height: 100%;
	
}

.hover_effect_nine_content:hover{
background: rgba(41, 0, 4, 0.1);
     
}
.hover_effect_nine_content img{
	max-width: 100%;
	display: block;
	position:absolute;
	margin:-15px 0;
	right:0;
	top:0;
	cursor:pointer;
	-webkit-transition:top .5s ease-in-out,right .5s ease-in-out;
	-moz-transition:top .5s ease-in-out,right .5s ease-in-out;
	-o-transition:top .5s ease-in-out,right .5s ease-in-out;
	transition:top .5s ease-in-out,right .5s ease-in-out
}
.hover_effect_nine:hover .hover_effect_nine_content img{
	top:-400px;
	right:-400px;
	padding-bottom:200px;
	padding-left:300px
}
/*end effect nine*/



/*hover effect ten*/
.hover_effect_ten{
	position: relative;
	height: 250px;
	width: 100%;
	overflow: hidden;
	z-index: 999;
	cursor: pointer;
}
.hover_effect_ten_content{
	width: 100%;
	height: 100%;
}
.hover_effect_ten_content img{
	position:absolute;
	left:0;
	bottom:0;
	cursor:pointer;
	margin:-12px 0;
	-webkit-transition:bottom .3s ease-in-out;
	-moz-transition:bottom .3s ease-in-out;
	-o-transition:bottom .3s ease-in-out;
	transition:bottom .3s ease-in-out
}
.hover_effect_ten:hover .hover_effect_ten_content img{
	bottom:-52%;
	padding-top:100px
}
/*end effect ten*/



/*hover effect eleven*/
.hover_effect_eleven{
	margin:0;
	padding:0;
	position:relative;
	cursor:pointer;
	width: 100%;
	height: 100%;
}
.hover_effect_eleven img{
	width: 300px;
	height:300px;
	display:block;
	position:relative;
	z-index:10;
	backface-visibility:hidden;
	-webkit-transition:all .5s;
	-moz-transition:all .5s;
	transition:all .5s
}
.hover_effect_eleven:hover img{
	-webkit-transform:rotateY(180deg);
	-moz-transform:rotateY(180deg);
	transform:rotateY(180deg)
}

.hover_effect_eleven_content h2 {
	margin-bottom:20px;
}

.hover_effect_eleven_content p {
	margin-bottom:20px;
}

.hover_effect_eleven_content{
	display:block;
	position:absolute;
	z-index:5;
	-webkit-box-sizing:border-box;
	-moz-box-sizing:border-box;
	box-sizing:border-box;
	top:0;
	left:0;
	width:100%;
	height:100%;
	padding: 10%;
	background-color: rgba(73, 13, 77, 0.6);
	text-align:center;
	backface-visibility:hidden;
	-webkit-transform:rotateY(-180deg);
	-moz-transform:rotateY(-180deg);
	transform:rotateY(-180deg);
	-webkit-transition:all .5s;
	-moz-transition:all .5s;
	transition:all .5s }
   
   .hover_effect_eleven a {
	text-decoration: none !important;
	bottom: 10%;
	color: #FFF !important;
	width: 40%;
	background-color: #FF00D8;
	padding: 6px;
	font-size: 14px;
	border-radius: 12%;
	border: 2px solid #FF4CFF;
	box-shadow: 2px 5px 7px -3px black !important;

}
   
 .hover_effect_eleven:hover .hover_effect_eleven_content{
	-webkit-transform:rotateY(0);
	-moz-transform:rotateY(0);
	transform:rotateY(0)
}
/*end effect ten*/



/*This is new to older*/



/*begin effect twelve */
.hover_effect_twelve{
	height: 100%;
	width: 100%;
	position: relative;
	overflow: hidden;
	text-align: center;
}

/*images and images hover default*/
.hover_effect_twelve img{
	width: 105%;
	-webkit-transform: scale(1.1);
	-moz-transform: scale(1.1);
	-o-transform: scale(1.1);
	-ms-transform: scale(1.1);
	transform: scale(1.1)
	-webkit-transition: all 0.5s ease;
	-moz-transition: all 0.5s ease;
	-o-transition: all 0.5s ease;
	-ms-transition: all 0.5s ease;
	transition: all 0.5s ease

}
.hover_effect_twelve:hover img{
    -webkit-transform: scale(1);
    -moz-transform: scale(1);
    -o-transform: scale(1);
    -ms-transform: scale(1);
    transform: scale(1)
}
/*end images hvoer*/

.hover_effect_twelve_content{
	position: absolute;
	cursor: default;
	width: 100%;
	height: 100%;
	background: rgba(44, 62, 80, 0.8);
	padding: 0px;
	text-align: center;
	-ms-filter: "progid:DXImageTransform.Microsoft.Alpha(Opacity=($opacity * 100))";
	filter: alpha(opacity=0);
	-moz-opacity: 0;
	-khtml-opacity: 0;
	opacity: 0;

	-ms-filter: "progid:DXImageTransform.Microsoft.Alpha(Opacity=($opacity * 100))";
	filter: alpha(opacity=100);
	-moz-opacity: 1;
	-khtml-opacity: 1;
	opacity: 1;
	-webkit-user-select: none;
	-moz-user-select: none;
	-o-user-select: none;
	-ms-user-select: none;
	user-select: none;
	-webkit-touch-callout: none;
	-moz-touch-callout: none;
	-o-touch-callout: none;
	-ms-touch-callout: none;
	touch-callout: none;
	-webkit-tap-highlight-color: transparent;
	-moz-tap-highlight-color: transparent;
	-o-tap-highlight-color: transparent;
	-ms-tap-highlight-color: transparent;
	tap-highlight-color: transparent;
	-webkit-transition: all 0.5s ease;
	-moz-transition: all 0.5s ease;
	-o-transition: all 0.5s ease;
	-ms-transition: all 0.5s ease;
	transition: all 0.5s ease;
	color:#fff !important;
}
/*up to all default*/

.hover_effect_twelve_content {
    top: 50%;
    left: 0px;
    opacity: 0;
}

.hover_effect_twelve:hover .hover_effect_twelve_content {
    top: 0px;
    left: 0px;
    opacity: 1;
}


.hover_effect_twelve a {
	padding: 5px;
	border: 1px solid #fff !important;
}

.hover_effect_twelve a:hover {

	background-color:#7B00FF;
}
/* end hover_effect_twelve*/



