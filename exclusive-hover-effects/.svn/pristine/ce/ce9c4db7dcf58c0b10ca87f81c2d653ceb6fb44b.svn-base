/* style 8   */

.img-h47 {
	width:33%;
	height:250px;
	float:left;
	position:relative;
}
.img-h47 img{
	width:100%;
	height:100%;
}
.blr-oo{	
	width:100%;
	height:100%;
	transition:1s;
	position:absolute;
	bottom:0;
}
.blr-oo ul{
	margin:0;
	padding:0;
	list-style:none;
	text-align:center;
	margin-top:30px;
	transition:1s;


}
.blr-oo ul li{
	display:inline;
	border:2px solid transparent;
	padding:10px;

	
}
.blr-oo ul li a{
	color:transparent;

}
.img-h47:hover .blr-oo{
	background:rgba(176, 93, 123, .9);
}
