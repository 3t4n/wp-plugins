html {height:100%;}body {min-height:100%;margin:0;padding:0;font-family:Verdana, Arial, sans-serif;line-height:1.5em;}#vswc {padding:40px;}#vswc p {margin:0 0 10px;padding:0;}#vswc h1, #vswc h2, #vswc h3, #vswc h4, #vswc h5, #vswc h6 {margin:0 0 10px;padding:0;line-height:normal;}.vswc-logo {max-width:100%;height:auto;margin:0;padding:0;border:0;}#vswc h1.vswc-title {margin:0;padding:20px 0;}.vswc-content {padding:20px 0;}.vswc-preview-notice {padding:20px 0;color:#ff0000;font-size:1.5em;}