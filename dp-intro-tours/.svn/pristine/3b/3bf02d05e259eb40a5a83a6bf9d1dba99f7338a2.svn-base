.dpit-no-events{pointer-events:none !important}.dpit-theme-colored{--dpit-overlay-color: var(--accent-contrast-color);--dpit-highlight-border-color: var(--accent-contrast-inv-color);--dpit-number-tx-color: var(--accent-contrast-color);--dpit-number-bg-color: var(--accent-contrast-inv-color);--dpit-number-border-color: var(--accent-contrast-color);--bullet-anim-color: var(--accent-contrast-inv-color);--bullet-anim-on-color: var(--accent-color);--dpit-tooltip-bg-color: var(--accent-color-gentle);--dpit-tooltip-tx-color: var(--accent-contrast-color);--dpit-btn-tx-color: var(--accent-contrast-inv-color);--dpit-btn-on-tx-color: var(--accent-contrast-color);--dpit-btn-bg-color: var(--accent-contrast-color);--dpit-btn-on-bg-color: var(--accent-contrast-inv-color);--dpit-bullet-bg-color: var(--accent-contrast-color);--dpit-bullet-on-bg-color: var(--accent-contrast-color);--dpit-bullet-on-tx-color: var(--accent-contrast-inv-color);--dpit-progress-front-color: var(--accent-contrast-color);--dpit-progress-bg-color: var(--accent-contrast-color);--dpit-scrollbar-bg-color: var(--accent-contrast-color)}.dpit-theme-colored.dpit-light-accent{--dpit-overlay-color: var(--accent-contrast-color);--dpit-tooltip-tx-color: var(--accent-contrast-color)}.dpit-theme-colored .dpit-number--on-tooltip{--dpit-number-bg-color: var(--accent-contrast-inv-color);--dpit-number-border-color: var(--accent-contrast-color)}.dpit-theme-colored .dpit-tooltip .dpit-tooltip-text{letter-spacing:.05em}.dpit-theme-colored .dpit-tooltip .dpit-tooltip-text a{color:rgb(var(--dpit-tooltip-tx-color)) !important;text-decoration:underline}.dpit-theme-colored.dpit-light-accent .dpit-tooltip-text{text-shadow:.2px 0px 0px rgb(var(--dpit-tooltip-tx-color))}

