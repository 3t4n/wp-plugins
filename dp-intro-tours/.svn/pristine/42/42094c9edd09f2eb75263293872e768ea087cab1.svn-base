?.enable_interaction ?? {}, val: val });\r\n\t\t\t\t\t}}\r\n\t\t\t\t/>\r\n\t\t\t\t<MultiItemBoxWithTransition\r\n\t\t\t\t\tclassBEMRoot='dpit-multi-item-box'\r\n\t\t\t\t\tclassName='dpit-multi-item-box--slide-down dpit-step-edit-item--interaction'\r\n\t\t\t\t\topenDisabled={false}\r\n\t\t\t\t\tactive={this.props.enable_interaction?.val == 1}\r\n\t\t\t\t\texternalState={true}\r\n\t\t\t\t\tisOpened={this.props.isInteractionDetailOpened}\r\n\t\t\t\t\tonOpenChange={(isOpened) => {\r\n\t\t\t\t\t\tif (!isOpened || !interactionAdvancedDisabled) {\r\n\t\t\t\t\t\t\tthis.props.updateInteractionDetailOpened(isOpened);\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}}\r\n\t\t\t\t>\r\n\t\t\t\t\t<ArrowDownIcon\r\n\t\t\t\t\t\tclassName={classNames({\r\n\t\t\t\t\t\t\t'dpit-step-edit__arrow-down': true,\r\n\t\t\t\t\t\t\t'dpit-step-edit__arrow-down--hidden': interactionAdvancedDisabled\r\n\t\t\t\t\t\t})}\r\n\r\n\t\t\t\t\t/>\r\n\t\t\t\t\t<StepMetaDataContainerWithTransition\r\n\t\t\t\t\t\tclassBEMRoot='dpit-step-meta-data'\r\n\t\t\t\t\t\tactive={true}\r\n\t\t\t\t\t\tval={this.props.enable_interaction}\r\n\t\t\t\t\t\tdefinition={this.props.stepDefinitions?.enable_interaction?.ext}\r\n\t\t\t\t\t\tonChange={(advParamName, newVal) => this.onAdvancedStepParamChanged('enable_interaction', newVal, advParamName)}\r\n\t\t\t\t\t>\r\n\t\t\t\t\t\t<ArrowDownIcon\r\n\t\t\t\t\t\t\tclassName={classNames({\r\n\t\t\t\t\t\t\t\t'dpit-step-edit__arrow-down': true,\r\n\t\t\t\t\t\t\t\t'dpit-step-edit__arrow-down--up': true,\r\n\t\t\t\t\t\t\t\t'dpit-step-edit__arrow-down--hidden': !this.props.isInteractionDetailOpened,\r\n\t\t\t\t\t\t\t\t'dpit-step-edit__arrow-down--l': true,\r\n\t\t\t\t\t\t\t\t'dpit-step-meta-data__arrow-up': true\r\n\r\n\t\t\t\t\t\t\t})}\r\n\t\t\t\t\t\t\tonClick={() => this.props.updateInteractionDetailOpened(false)}\r\n\t\t\t\t\t\t/>\r\n\t\t\t\t\t</StepMetaDataContainerWithTransition>\r\n\r\n\t\t\t\t</MultiItemBoxWithTransition>\r\n\r\n\r\n\t\t\t</React.Fragment >\r\n\t\t);\r\n\r\n\r\n\r\n\t\treturn (\r\n\t\t\t<div className=\"dpit-step-edit\">\r\n\t\t\t\t<div className='dpit-step-edit__ctrls'>\r\n\r\n\t\t\t\t\t<div className={classNames({\r\n\t\t\t\t\t\t'dpit-step-edit-item': true,\r\n\t\t\t\t\t\t'dpit-step-edit-item--disabled': this.props.isInteractionDetailOpened,\r\n\t\t\t\t\t})} title={editorControlsTitles.target}>\r\n\t\t\t\t\t\t<div className='dpit-step-edit-item__label'>{i18n.target}</div>\r\n\t\t\t\t\t\t{targetMultiItemBox}\r\n\t\t\t\t\t\t{targetSignalIcons}\r\n\t\t\t\t\t</div>\r\n\r\n\t\t\t\t\t<div className={classNames({\r\n\t\t\t\t\t\t'dpit-step-edit-item': true,\r\n\t\t\t\t\t\t'dpit-step-edit-item--disabled': !this.props.element\r\n\t\t\t\t\t\t\t|| this.props.isTargetDetailOpened\r\n\t\t\t\t\t\t\t|| this.props.core.isDummyMode()\r\n\t\t\t\t\t})} title={i18n.allow_interact}>\r\n\r\n\t\t\t\t\t\t<div className='dpit-step-edit-item__label'>{i18n.interaction}</div>\r\n\t\t\t\t\t\t{interactionUi}\r\n\t\t\t\t\t</div>\r\n\r\n\t\t\t\t\t<div\r\n\t\t\t\t\t\tclassName={classNames({\r\n\t\t\t\t\t\t\t'dpit-step-edit-item': true,\r\n\t\t\t\t\t\t\t'dpit-step-edit-item--disabled': !this.props.element\r\n\t\t\t\t\t\t\t\t|| this.props.isTargetDetailOpened\r\n\t\t\t\t\t\t\t\t|| this.props.isInteractionDetailOpened\r\n\t\t\t\t\t\t\t\t|| this.props.core.isDummyMode()\r\n\t\t\t\t\t\t})}\r\n\t\t\t\t\t\ttitle={!this.props.element ? i18n.set_target_first : i18n.tooltip_pref_pos}>\r\n\r\n\t\t\t\t\t\t<div className='dpit-step-edit-item__label'>{i18n.position}</div>\r\n\t\t\t\t\t\t<Select\r\n\t\t\t\t\t\t\tclassName={classNames({\r\n\t\t\t\t\t\t\t\t'dpit-select': true,\r\n\t\t\t\t\t\t\t\t'dpit-step-edit-item__select': true\r\n\t\t\t\t\t\t\t})}\r\n\t\t\t\t\t\t\tclassBEMRoot='dpit-select'\r\n\t\t\t\t\t\t\toptions={this.props.positionConfig.options}\r\n\t\t\t\t\t\t\tvalue={this.selectPositionValueMap[this.props.position || '']}\r\n\t\t\t\t\t\t\tplaceholder={this.props.positionConfig.options[this.props.positionConfig.defIdx].label}\r\n\t\t\t\t\t\t\ttheme={StyleOfSelect}\r\n\t\t\t\t\t\t\tcomponents={{ DropdownIndicator: CustomDropdownIndicator }}\r\n\t\t\t\t\t\t\tonChange={this.onPositionChange}\r\n\t\t\t\t\t\t/>\r\n\t\t\t\t\t</div>\r\n\r\n\t\t\t\t\t<div className={classNames({\r\n\t\t\t\t\t\t'dpit-step-edit-item': true,\r\n\t\t\t\t\t\t'dpit-step-edit-item--disabled': this.props.isTargetDetailOpened || this.props.isInteractionDetailOpened,\r\n\t\t\t\t\t})} title={editorControlsTitles.redirect}>\r\n\t\t\t\t\t\t<div className='dpit-step-edit-item__label'>{i18n.URL}</div>\r\n\t\t\t\t\t\t<Button\r\n\t\t\t\t\t\t\tclassBEMRoot='dpit-step-edit__button'\r\n\t\t\t\t\t\t\tclassName={classNames({\r\n\t\t\t\t\t\t\t\t'dpit-step-edit__button--url': true\r\n\t\t\t\t\t\t\t})}\r\n\t\t\t\t\t\t\tdisabled={!this.props.isPRO\r\n\t\t\t\t\t\t\t\t|| this.props.isTargetDetailOpened\r\n\t\t\t\t\t\t\t\t|| this.props.isInteractionDetailOpened\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\tactive={true}\r\n\t\t\t\t\t\t\tonClick={this.props.onUrlRedirectClick}\r\n\t\t\t\t\t\t\ttitle={editorControlsTitles.redirect}\r\n\t\t\t\t\t\t/>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t</div>\r\n\r\n\t\t\t\t<div className='dpit-step-edit__wrap'>\r\n\t\t\t\t\t<div className={classNames({\r\n\t\t\t\t\t\t'dpit-step-edit-item': true,\r\n\t\t\t\t\t\t'dpit-step-edit-item--ta-wrap': true,\r\n\t\t\t\t\t\t'dpit-step-edit-item--on-light-bg': true,\r\n\t\t\t\t\t\t'dpit-step-edit-item--disabled': this.props.isTargetDetailOpened || this.props.isInteractionDetailOpened\r\n\t\t\t\t\t})}\r\n\t\t\t\t\t>\r\n\t\t\t\t\t\t<label className='dpit-step-edit-item__label dpit-step-edit-item__label--ta'>\r\n\t\t\t\t\t\t\t{i18n.edit_tour_tip_text}\r\n\t\t\t\t\t\t\t<span\r\n\t\t\t\t\t\t\t\tonClick={this.props.isPRO\r\n\t\t\t\t\t\t\t\t\t? null\r\n\t\t\t\t\t\t\t\t\t: () => this.onSignalTargetTypeClick('shortCode')}\r\n\t\t\t\t\t\t\t\tclassName={classNames({ 'dpit-pro-only': !this.props.isPRO })}>{' / ' + i18n.short_code}\r\n\t\t\t\t\t\t\t</span>\r\n\t\t\t\t\t\t\t<InfoIcon\r\n\t\t\t\t\t\t\t\tclassBEMRoot=\"dpit-step-edit-item__label__icon\"\r\