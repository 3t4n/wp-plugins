es.SET_TOTAL_SAVED_CHANGES, totalSavedChanges: totalChanges, increment: true });\r\n\t\t\t\ttry {\r\n\r\n\t\t\t\t\tsetTimeout(() => {\r\n\t\t\t\t\t\tif (onSuccess) onSuccess();\r\n\t\t\t\t\t\tsetTimeout(() => {\r\n\t\t\t\t\t\t\tdispatch({ type: actionTypes.SET_PROCESS_STATE, stateName: 'savingState', processState: ProcessState.IDLE });\r\n\t\t\t\t\t\t}, 2000);\r\n\t\t\t\t\t}, 100);\r\n\t\t\t\t} catch (error) {\r\n\t\t\t\t\tdispatch({\r\n\t\t\t\t\t\ttype: actionTypes.SET_PROCESS_STATE, stateName: 'savingState', processState: ProcessState.ERROR, error: i18n.saving_err_2, errorDetail: error.toString(),\r\n\t\t\t\t\t});\r\n\t\t\t\t}\r\n\t\t\t})\r\n\t\t\t.catch((error) => {\r\n\t\t\t\tconsole.log(error);\r\n\t\t\t\tdispatch({ type: actionTypes.RESTORE_ALL_CHANGES });\r\n\t\t\t\tdispatch({ type: actionTypes.SET_APP_STATE, appState: AppState.VIEW });\r\n\t\t\t\tdispatch({\r\n\t\t\t\t\ttype: actionTypes.SET_PROCESS_STATE, stateName: 'savingState', processState: ProcessState.ERROR, error: i18n.saving_err_1, errorDetail: new AxiosError(error).toString(),\r\n\t\t\t\t});\r\n\t\t\t\tif (onError) onError();\r\n\t\t\t\tsetTimeout(() => {\r\n\t\t\t\t\tdispatch({ type: actionTypes.SET_PROCESS_STATE, stateName: 'savingState', processState: ProcessState.IDLE });\r\n\t\t\t\t}, 4000);\r\n\t\t\t});\r\n\r\n\t};\r\n};\r\n\r\nexport const isUrlValid = (url, onSuccess, onError) => (dispatch) => {\r\n\tdispatch({ type: actionTypes.SET_PROCESS_STATE, stateName: 'apiReqState', processState: ProcessState.PROCESSING });\r\n\taxios.get(`/get-compatible-post?url=${url}`, WpDpApi)\r\n\t\t.then((response) => {\r\n\t\t\tdispatch({ type: actionTypes.SET_PROCESS_STATE, stateName: 'apiReqState', processState: ProcessState.PROCESSED });\r\n\t\t\ttry {\r\n\t\t\t\tif (onSuccess) onSuccess(response.data);\r\n\t\t\t\tsetTimeout(() => {\r\n\t\t\t\t\tdispatch({ type: actionTypes.SET_PROCESS_STATE, stateName: 'apiReqState', processState: ProcessState.IDLE });\r\n\t\t\t\t}, 2000);\r\n\t\t\t} catch (error) {\r\n\t\t\t\tdispatch({\r\n\t\t\t\t\ttype: actionTypes.SET_PROCESS_STATE, stateName: 'apiReqState', processState: ProcessState.ERROR, error: i18n.url_validation_cbk_failed, errorDetail: error.toString(),\r\n\t\t\t\t});\r\n\t\t\t}\r\n\t\t})\r\n\t\t.catch((error) => {\r\n\t\t\tconsole.log(error);\r\n\t\t\tdispatch({\r\n\t\t\t\ttype: actionTypes.SET_PROCESS_STATE, stateName: 'apiReqState', processState: ProcessState.ERROR, error: i18n.url_validation_failed, errorDetail: new AxiosError(error).toString(),\r\n\t\t\t});\r\n\t\t\tif (onError) onError();\r\n\t\t\tsetTimeout(() => {\r\n\t\t\t\tdispatch({ type: actionTypes.SET_PROCESS_STATE, stateName: 'apiReqState', processState: ProcessState.IDLE });\r\n\t\t\t}, 4000);\r\n\t\t});\r\n};\r\n\r\nexport const sendAskForRatingFeedbackToDP = (type, onSuccess, onError) => () => {\r\n\taxios.post(`/${type}`, {}, DpServerApi)\r\n\t\t.then((response) => {\r\n\t\t\tif (onSuccess) onSuccess(response.data);\r\n\t\t})\r\n\t\t.catch((error) => {\r\n\t\t\tif (onError) onError();\r\n\t\t\tconsole.log(new AxiosError(error));\r\n\t\t});\r\n};\r\n\r\nexport const deleteTourPost = (tourId, forceDelete, onSuccess, onError) => () => {\r\n\tconst data = {\r\n\t\ttourId: tourId,\r\n\t\tforceDelete: forceDelete\r\n\t};\r\n\taxios.post('/delete-tour', data, WpDpApi)\r\n\t\t.then((response) => {\r\n\t\t\tif (onSuccess) onSuccess(response.data);\r\n\t\t})\r\n\t\t.catch((error) => {\r\n\t\t\tif (onError) onError();\r\n\t\t\tconsole.log(new AxiosError(error));\r\n\t\t});\r\n};\r\n","export default class MobileViewPopup {\r\n\r\n\tconstructor(onExit, config) {\r\n\t\tthis.onExit = onExit;\r\n\t\tthis.config = config;\r\n\t}\r\n\r\n\tcheckPopup = () => {\r\n\t\tif (this.popup.closed) {\r\n\t\t\tclearInterval(this.popupTimer);\r\n\t\t\tthis.exitPopup();\r\n\t\t}\r\n\t};\r\n\r\n\texitPopup = () => {\r\n\t\t$('.dpit-mobile-view-popup__overlay').fadeOut(1000);\r\n\t\tif (this.onExit) this.onExit();\r\n\t};\r\n\r\n\tonOverlayClick = () => {\r\n\t\tif (this.onExit) this.onExit(true);\r\n\t\t$('.dpit-mobile-view-popup__overlay').fadeOut(700);\r\n\t\tclearInterval(this.popupTimer);\r\n\t\tthis.popup.close();\r\n\t};\r\n\r\n\taddOverlay = () => {\r\n\t\tif (!$('.dpit-mobile-view-popup__overlay').length) $('body').append('<div class=\"dpit-mobile-view-popup__overlay\"/>');\r\n\t\t$('.dpit-mobile-view-popup__overlay').fadeIn(700);\r\n\t};\r\n\r\n\tpopupCenter = (url, title, w, h) => {\r\n\t\tthis.addOverlay();\r\n\t\t$('.dpit-mobile-view-popup__overlay').on('click', this.onOverlayClick);\r\n\r\n\t\t// Fixes dual-screen position                             Most browsers      Firefox\r\n\t\tconst dualScreenLeft = window.screenLeft !== undefined ? window.screenLeft : window.screenX;\r\n\t\tconst dualScreenTop = window.screenTop !== undefined ? window.screenTop : window.screenY;\r\n\r\n\t\tconst width = window.innerWidth ? window.innerWidth : document.documentElement.clientWidth ? document.documentElement.clientWidth : screen.width;\r\n\t\tconst height = window.innerHeight ? window.innerHeight : document.documentElement.clientHeight ? document.documentElement.clientHeight : screen.height;\r\n\r\n\t\tconst systemZoom = width / window.screen.availWidth;\r\n\t\tconst left = (width - w) / 2 / systemZoom + dualScreenLeft;\r\n\t\tconst top = (height - h) / 2 / systemZoom + dualScreenTop;\r\n\t\tthis.popup = window.open(url, title,\r\n\t\t\t`\r\n          modal=yes,\r\n          resizable=no,\r\n          scrollbars=yes,\r\n          width=${w / systemZoom}, \r\n          height=${h / systemZoom}\r\n          `\r\n\t\t);\r\n\t\tif (this.popup) {\r\n\t\t\tthis.popup.moveTo(left, top);\r\n\t\t\tif (window.focus) this.popup.focus();\r\n\t\t\tthis.popupTimer = setInterval(this.checkPopup, 500);\r\n\t\t\tthis.checkPopup();\r\n\t\t}\r\n\t\telse {\r\n\t\t\talert(this.config.i18n.allow_popup_to_set_mob);\r\n\t\t\tthis.exitPopup();\r\n\t\t}\r\n\t\treturn this.popup;\r\n\t};\r\n\r\n\r\n}","import { Origin, TargetType } from '../../../../public/assets/js/apps/TourStepEditor/store/appMode';\r\nimport {\r\n\tgetWinBB\r\n} from '../../../../public/assets/js/modules/dpitUtilsPublic';\r\nimport MobileViewPopup from './MobileViewPopup';\r\nimport { buildDpQueryString } from './dpitUtilsInc';\r\nimport urlJoin from 'url-join';\r\n\r\nexport default class MobileMenuOptionsVisualBuilderLoader {\r\n\r\n\tconstructor(config) {\r\n\t\tthis.config = config;\r\n\t\tthis.mobileViewPopup = new MobileViewPopup(this.onMobileViewPopupExit, this.config);\r\n\t}\r\n\r\n\topenBuilder() {\r\n\t\tlocalStorage.setItem('dp_intro_tours.mobile_menu_options_origin', location.href);\r\n\t\tconst isMobileSize = this.isMobileSize();\r\n\t\tconst params = {\r\n\t\t\tdp_qpb_builder_mode: TargetType.MOBILE_MENU,\r\n\t\t\tdp_qpb_builder_origin: Origin.FRONTEND,\r\n\t\t\tdp_qp_run_always_on_load: 1\r\n\t\t};\r\n\t\tif (isMobileSize) params.dp_qpb_in_new_window = 1;\r\n\t\tconst hrefNewWindow = this.getRedirectUrl(buildDpQueryString({\r\n\t\t\tdp_qpb_builder_mode: TargetType.MOBILE_MENU,\r\n\t\t\tdp_qpb_builder_origin: Origin.FRONTEND,\r\n\t\t\tdp_qp_run_always_on_load: 1,\r\n\t\t\tdp_qpb_in_new_window: !isMobileSize ? 1 : 0\r\n\t\t}, this.config.queryParamsDefs));\r\n\t\tif (!isMobileSize) {\r\n\t\t\tthis.mobileViewPopup.popupCenter(hrefNewWindow, 'DP Mobile menu support', 480, window.outerHeight * 0.9);\r\n\t\t}\r\n\t\telse {\r\n\t\t\tlocation.href = hrefNewWindow;\r\n\t\t}\r\n\t}\r\n\r\n\tgetRedirectUrl(queryString) {\r\n\t\treturn urlJoin(this.config.siteUrl, queryString);\r\n\t}\r\n\r\n\tisMobileSize(breakPointOverride = null) {\r\n\t\tconst winSize = getWinBB();\r\n\t\treturn this.config.mobile_break_points && (winSize.width <= (breakPointOverride ? breakPointOverride : this.config.mobile_break_points?.mobile));\r\n\t}\r\n\r\n\ttryRedirectToOrigin() {\r\n\t\tconst originHref = localStorage.getItem('dp_intro_tours.mobile_menu_options_origin');\r\n\t\tif (originHref) {\r\n\t\t\tlocalStorage.removeItem('dp_intro_tours.mobile_menu_options_origin');\r\n\