argetEl);\r\n\t\t\t\tthis.$visualizer.offset($target.offset());\r\n\t\t\t\tthis.$visualizer.outerWidth($target.outerWidth());\r\n\t\t\t\tthis.$visualizer.outerHeight($target.outerHeight());\r\n\t\t\t}\r\n\t\t\telse {\r\n\t\t\t\tthis.$visualizer.hide();\r\n\t\t\t}\r\n\t\t}\r\n\t\telse {\r\n\t\t\tthis.$visualizer.hide();\r\n\t\t}\r\n\t};\r\n\r\n\tcreateBoundingBoxFromElementWithMargin(element) {\r\n\t\treturn DpitBB.extendByMarginBB(DpitBB.fromElement(element, false), {\r\n\t\t\ttop: getCssValFloat(element, 'margin-top', 0),\r\n\t\t\tleft: getCssValFloat(element, 'margin-left', 0),\r\n\t\t\tbottom: getCssValFloat(element, 'margin-bottom', 0),\r\n\t\t\tright: getCssValFloat(element, 'margin-right', 0),\r\n\t\t});\r\n\t}\r\n\r\n\tisElementSamePosAndSize = (el1, el2, tolerancePx) => {\r\n\t\tif (el1 && el2) {\r\n\t\t\tif (document.documentElement === el1) return false;\r\n\t\t\tconst bb1 = this.createBoundingBoxFromElementWithMargin(el1);\r\n\t\t\tconst bb2 = this.createBoundingBoxFromElementWithMargin(el2);\r\n\t\t\tif (bb1 && bb2) {\r\n\t\t\t\tconst keys = Object.keys(bb1);\r\n\t\t\t\tfor (const key of keys) {\r\n\t\t\t\t\tif (key != 'width' && key != 'height') {\r\n\t\t\t\t\t\tif (Math.abs(bb1[key] - bb2[key]) > tolerancePx) return false;\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\treturn true;\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn false;\r\n\t};\r\n\r\n\r\n\ttrySelectParent = (element) => {\r\n\t\tlet resParentEl = element;\r\n\t\twhile (this.isElementSamePosAndSize(element, resParentEl.parentNode, 3)) {\r\n\t\t\tresParentEl = resParentEl.parentNode;\r\n\t\t}\r\n\t\treturn resParentEl;\r\n\t};\r\n\r\n\tvisualizeInitialTarget() {\r\n\t\tthis.adjustVisualizer(documentQuerySelectorSafe(this.props.initialTargetSelector));\r\n\t}\r\n\r\n\tselectElement = (event) => {\r\n\t\tconst isOnExitBL = this.isTargetOnBlackList(event.target, this.blackListExit);\r\n\t\tconst isOnBL = this.isTargetOnBlackList(event.target, this.blackList);\r\n\r\n\t\tif ((isOnExitBL && !isOnBL) || (!isOnExitBL && !isOnBL)) {\r\n\t\t\tthis.exitSelectElementMode(false);\r\n\t\t}\r\n\r\n\t\tif (isOnExitBL && !isOnBL /* sub button to switch exit btn position */) {\r\n\t\t\tthis.visualizeInitialTarget();\r\n\t\t}\r\n\r\n\t\tif ((!isOnExitBL && !isOnBL)) {\r\n\t\t\tlet selector = '';\r\n\t\t\tlet isError = false;\r\n\t\t\tlet selectedEl = null;\r\n\t\t\tswitch (this.props.mode) {\r\n\t\t\t\tcase TargetSelectorMode.MOST_PARENT: selectedEl = this.trySelectParent(event.target); break;\r\n\t\t\t\tdefault: selectedEl = event.target;\r\n\t\t\t}\r\n\r\n\r\n\t\t\ttry {\r\n\t\t\t\tselector = unique(selectedEl, {\r\n\t\t\t\t\tselectorTypes: this.props.selectorTypes\r\n\t\t\t\t});\r\n\t\t\t\tthis.$visualizer.addClass(this.props.classBEMRoot + '--confirmed');\r\n\r\n\t\t\t}\r\n\t\t\tcatch (exc) {\r\n\t\t\t\tif (selectedEl?.id) {\r\n\t\t\t\t\tselector = `#${selectedEl.id}`;\r\n\t\t\t\t}\r\n\t\t\t\telse {\r\n\t\t\t\t\tisError = true;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tthis.$visualizer.fadeOut(300, () => {\r\n\t\t\t\tthis.clearVisualizedTarget(event.target);\r\n\t\t\t\tthis.props.onTargetSelected(selector, selectedEl, isError);\r\n\t\t\t});\r\n\t\t\t/*setTimeout(() => {\r\n\r\n\r\n\t\t\t\tthis.$visualizer.fadeOut(300, () => {\r\n\t\t\t\t\tthis.clearVisualizedTarget(event.target);\r\n\t\t\t\t\tthis.props.onTargetSelected(selector, selectedEl, isError);\r\n\t\t\t\t});\r\n\t\t\t}, 300);*/ //wait for final animation\r\n\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\telse if (isOnExitBL) {\r\n\t\t\tif (this.props.initialTargetElement) {\r\n\t\t\t\tthis.visualizeInitialTarget();\r\n\t\t\t\t//this.adjustVisualizer($S(this.props.initialTargetElement));\r\n\t\t\t\tthis.$visualizer.addClass(this.props.classBEMRoot + '--confirmed');\r\n\t\t\t}\r\n\t\t\treturn true;\r\n\r\n\t\t}\r\n\r\n\t};\r\n\r\n\trender = () => null;\r\n}","import urlJoin from 'url-join';\r\n\r\nexport const WpDpApi = {\r\n\tbaseURL: urlJoin(window.dpIntroTourPublicConfig.restApiUrl, 'dpintrotours/v1/'),\r\n\theaders: { 'X-WP-Nonce': window.d