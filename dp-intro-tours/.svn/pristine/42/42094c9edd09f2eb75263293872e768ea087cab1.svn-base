\tconst targetSelHint = {\r\n\t\tactive: true,\r\n\t\ttype: 'error',\r\n\t\tpulse: true,\r\n\t\tdismissible: true,\r\n\t\ttitle: error,\r\n\t\tdesc: errorDetail,\r\n\t};\r\n\tswitch (processState) {\r\n\t\tcase ProcessState.ERROR: newState.hintConfig = targetSelHint; break;\r\n\t\tcase ProcessState.PROCESSING: {\r\n\t\t\tnewState.hintConfig = targetSelHint;\r\n\t\t\tnewState.hintConfig.active = false;\r\n\t\t}\r\n\t\t\tbreak;\r\n\t\tcase ProcessState.PROCESSED:\r\n\t\t\t{\r\n\t\t\t\tnewState.hintConfig = targetSelHint;\r\n\t\t\t\tnewState.hintConfig.active = false;\r\n\t\t\t}\r\n\t\t\tbreak;\r\n\t}\r\n\treturn newState;\r\n};\r\n\r\nconst closeHint = (initState) => {\r\n\tconst newState = { ...initState };\r\n\tnewState.hintConfig = { ...initState.hintConfig, active: false };\r\n\treturn newState;\r\n};\r\n\r\nconst addNewStepAt = (initState, stepIdx, newStepCount) => {\r\n\tconst newState = { ...initState };\r\n\tconst stepChangesNew = [];\r\n\tfor (let i = 0; i < newStepCount; i++) {\r\n\t\tif (i < stepIdx) {\r\n\t\t\tif (initState.stepChanges[i]) stepChangesNew[i] = initState.stepChanges[i];\r\n\t\t} else if (i > stepIdx) {\r\n\t\t\tif (initState.stepChanges[i - 1]) {\r\n\t\t\t\tstepChangesNew[i] = { ...initState.stepChanges[i - 1] };\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tnewState.stepAddedRemovedHist.push({ idx: stepIdx, action: 'add' });\r\n\tnewState.stepChanges = stepChangesNew;\r\n\tnewState.isChange = isAnyChange(newState);\r\n\treturn newState;\r\n};\r\n\r\nconst removedStepAt = (initState, stepIdx, oldStepCount) => {\r\n\tconst newState = { ...initState };\r\n\tconst stepChangesNew = [];\r\n\tfor (let i = 0; i < oldStepCount; i++) {\r\n\t\tif (i < stepIdx) {\r\n\t\t\tif (initState.stepChanges[i]) stepChangesNew[i] = initState.stepChanges[i];\r\n\t\t} else if (i >= stepIdx) {\r\n\t\t\tif (initState.stepChanges[i + 1]) {\r\n\t\t\t\tstepChangesNew[i] = { ...initState.stepChanges[i + 1] };\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tnewState.stepAddedRemovedHist.push({ idx: stepIdx, action: 'remove' });\r\n\tnewState.stepChanges = stepChangesNew;\r\n\tnewState.isChange = isAnyChange(newState);\r\n\treturn newState;\r\n};\r\n\r\n\r\nconst reducer = (state = initialState, action) => {\r\n\tswitch (action.type) {\r\n\t\tcase actionTypes.SET_APP_STATE: return setAppState(state, action.appState);\r\n\t\tcase actionTypes.SET_PROCESS_STATE: return setProcessState(state, action.stateName, action.processState, action.error, action.errorDetail);\r\n\t\tcase actionTypes.SET_APP_EDIT_TARGET_TYPE: return updateObject(state, { targetType: action.targetType });\r\n\t\tcase actionTypes.UPDATE_HINT: return updateObject(state, { hintConfig: action.hintConfig });\r\n\t\tcase actionTypes.CLOSE_HINT: return closeHint(state);\r\n\t\tcase actionTypes.ADD_CHANGE: return addChange(state, action.targetType, action.id, action.change);\r\n\t\tcase actionTypes.CLEAR_CHANGES: return clearChanges(state, action.targetType);\r\n\t\tcase actionTypes.CLEAR_ALL_CHANGES: return clearAllChanges(state);\r\n\t\tcase actionTypes.RESTORE_ALL_CHANGES: return restoreAllChanges(state);\r\n\t\tcase actionTypes.ON_ADD_NEW_STEP_AT: return addNewStepAt(state, action.stepIdx, action.newStepCount);\r\n\t\tcase actionTypes.ON_REMOVE_STEP_AT: return removedStepAt(state, action.stepIdx, action.oldStepCount);\r\n\t\tcase actionTypes.SET_CURRENT_STEP_CORE: return updateObject(state, { stepItem: action.stepItem });\r\n\t\tcase actionTypes.SET_STEP_COUNT: return updateObject(state, { stepCount: action.stepCount });\r\n\t\tcase actionTypes.STEP_CHANGING_IN_PROGRESS: return updateObject(state, { stepChangingInProgress: action.stepChangingInProgress });\r\n\t\tcase actionTypes.SET_TARGET_TYPE: return updateObject(state, { targetType: action.targetType });\r\n\t\tcase actionTypes.SET_ORIGIN: return updateObject(state, { origin: action.origin });\r\n\t\tcase actionTypes.SET_TOTAL_SAVED_CHANGES: return updateObject(state, { totalSavedChanges: action.increment ? state.totalSavedChanges + action.totalSavedChanges : action.totalSavedChanges });\r\n\t\tcase actionTypes.SET_CONTROLS_POSITION: return updateObject(state, { controlsPosition: action.controlsPosition });\r\n\t\tcase actionTypes.SET_MOBILE_MENU_OPENER_SELECTED: return updateObject(state, { mobileMenuOpenerSelected: action.mobileMenuOpenerSelected });\r\n\t\tcase actionTypes.SET_MOBILE_ALT_STEP_MODE: return updateObject(state, { mobileAltStepMode: action.mobileAltStepMode });\r\n\t\tcase actionTypes.UPDATE_NAVIG_BUTTON_HOVERED: return updateNavigButtonHoveredState(state, action.id, action.hoverIn);\r\n\t\tcase actionTypes.UPDATE_TARGET_EDIT_DETAIL_OPENED: return updateObject(state, { isTargetDetailOpened: action.isOpened });\r\n\t\tcase actionTypes.UPDATE_CLOSE_MENU_OPENED: return updateObject(state, { isCloseMenuOpened: action.isOpened });\r\n\t\tcase actionTypes.UPDATE_INTERACTION_EDIT_DETAIL_OPENED: return updateObject(state, { isInteractionDetailOpened: action.isOpened });\r\n\t\tcase actionTypes.TOGGLE_CANCEL_BUTTON_POS: return updateObject(state, { cancelButtonAltPos: !state.cancelButtonAltPos });\r\n\t\tcase actionTypes.SET_CANCEL_BUTTON_POS: return updateObject(state, { cancelButtonAltPos: action.position });\r\n\t\tdefault: return state;\r\n\t}\r\n};\r\n\r\nexport default reducer;\r\n","import React, { Component } from 'react';\r\nimport {\r\n\tcreateStore, applyMiddleware, compose, combineReducers,\r\n} from 'redux';\r\n//import { configureStore } from '@reduxjs/toolkit';\r\nimport { Provider } from 'react-redux';\r\nimport thunk from 'redux-thunk';\r\nimport App from './App';\r\nimport introStepReducer from './store/reducers/introStep';\r\nimport appReducer from './store/reducers/app';\r\n\r\n\r\nconst composeEnhancers = window.__REDUX_DEVTOOLS_EXTENSION_COMPOSE__ || compose;\r\n\r\nconst rootReducer = combineReducers({\r\n\tintroStep: introStepReducer,\r\n\tapp: appReducer,\r\n});\r\n\r\n\r\nconst store = createStore(rootReducer, composeEnhancers(\r\n\tapplyMiddleware(thunk),\r\n));\r\n\r\n/*\r\nconst store = configureStore({\r\n\treducer: {\r\n\t\tintroStep: introStepReducer,\r\n\t\tapp: appReducer\r\n\t}\r\n});*/\r\n\r\nexport default class Index extends Component {\r\n\trender() {\r\n\t\treturn (\r\n\t\t\t<Provider store={store}>\r\n\t\t\t\t<App {...this.props} />\r\n\t\t\t</Provider>\r\n\t\t);\r\n\t}\r\n}\r\n","import React from 'react';\r\nimport { createRoot } from 'react-dom/client';\r\nimport DpitBuilderCore from './core/DpitBuilderCore';\r\nimport Dpit from './Dpit';\r\n\r\nimport Index from '../apps/TourStepEditor/Index';\r\nimport { CORE_ENGINES } from './core/constants';\r\nimport { TargetType } from '../apps/TourStepEditor/store/appMode';\r\nimport registerServiceWorker from '../apps/TourStepEditor/registerServiceWorker';\r\n\r\nexport default class DpitBuilder extends Dpit {\r\n\tconstructor(mainCfg, tourCfg) {\r\n\t\tif (mainCfg.dpDebugEn) console.log('[dpit] INIT DpitBuilder');\r\n\t\tsuper(mainCfg, tourCfg);\r\n\t\tif (mainCfg.builderMode === TargetType.MOBILE_MENU) this.createBuilder();\r\n\t}\r\n\r\n\tisStepsEnough2Start() {\r\n\t\treturn true;\r\n\t}\r\n\r\n\t/*createCore() {\r\n\r\n\t\tconst core = new DpitBuilderCore(this.wrapEl, this.mainCfg, this.tourCfg);\r\n\t\tcore.setOptions(this.getIntroCoreOptions());\r\n\t\treturn Promise.resolve(core);\r\n\t}*/\r\n\tafterIntroCoreInit() {\r\n\t\tsuper.afterIntroCoreInit();\r\n\t\tthis.createBuilder();\r\n\t\t// for future\r\n\t}\r\n\r\n\tprocessUserVisit() {\r\n\t\t// Don't work with user visits in builder\r\n\t}\r\n\r\n\r\n\tasync createCore() {\r\n\t\tconst coreModuleName = (this.tourCfg.theme === 'sticky') ? CORE_ENGINES.builderSticky : CORE_ENGINES.builder;\r\n\t\tconst module = await import(/* webpackChunkName: \"[request]\" */ `./core/${coreModuleName}`);\r\n\t\tconst core = new module.default(this.wrapEl, this.mainCfg, this.tourCfg);\r\n\t\tcore.setOptions(this.getIntroCoreOptions());\r\n\t\treturn Promise.resolve(core);\r\n\t}\r\n\r\n\tcreateBuilder() {\r\n\t\tconst container = DpitBuilderCore.initBuilderContainer(this.wrapEl);\r\n\t\tconst root = createRoot(container);\r\n\t\troot.render(\r\n\t\t\t<Index\r\n\t\t\t\tmainCfg={this.mainCfg}\r\n\t\t\t\ttourCfg={this.tourCfg}\r\n\t\t\t\tcore={this.core}\r\n\t\t\t\tsecondLayerIntroModule={this}\r\n\t\t\t/>\r\n\t\t);\r\n\t\tif (!this.mainCfg.dpDebugEn) registerServiceWorker();\r\n\t}\r\n}\r\n","import DpitBuilder from './modules/DpitBuilder';\r\nimport { loadBuilder } from '../../../includes/assets/js/modules/dpitUtilsInc';\r\nimport AdminThemeColors from '../../../includes/assets/js/modules/AdminThemeColors';\r\n\r\njQuery(window).on('load', () => {\r\n\twindow.$ = jQuery;\r\n\tloadBuilder(window.dpIntroTourPublicConfig, (mainCfg, tourCfg) => {\r\n\t\tnew DpitBuilder(mainCfg, tourCfg);\r\n\t\tnew AdminThemeColors(mainCfg);\r\n\t});\r\n});\r\n"],"sourceRoot":""}