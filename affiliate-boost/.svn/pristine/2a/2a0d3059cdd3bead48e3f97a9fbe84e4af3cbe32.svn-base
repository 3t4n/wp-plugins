#. Plugin Name of the plugin
#: affiliate-boost.php
msgid "Affiliate Boost"
msgstr "Affiliate Boost"

#. Description of the plugin
#: affiliate-boost.php
msgid ""
"Plugin para maximizar conversões redirecionando usuários para links de "
"afiliados configuráveis, com integração fácil e opções de personalização."
msgstr ""
"Complemento para maximizar las conversiones redirigiendo a los usuarios "
"a enlaces de afiliados configurables, con fácil integración y opciones "
"de personalización."

#. Author of the plugin
#: affiliate-boost.php
msgid "Luiz Jr. Fernandes / Guilherme Tetamanti"
msgstr "Luiz Jr. Fernandes / Guilherme Tetamanti"

