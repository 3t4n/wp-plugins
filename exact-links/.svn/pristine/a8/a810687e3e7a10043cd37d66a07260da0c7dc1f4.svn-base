body,html{margin:0;height:100vh}.exactlinks-choice-page{display:flex;align-items:center;justify-content:center}.exactlinks-frontend-preview{width:50%;margin:auto;text-align:center;padding:30px}.exactlinks-frontend-preview .choice-page .product-info{display:flex;flex-direction:column;justify-content:center;align-items:center}.exactlinks-frontend-preview .choice-page .product-info .title{color:grey;font-size:22px;line-height:35px;font-weight:400;margin:30px}.exactlinks-frontend-preview .choice-page .product-info p{margin-bottom:10px;margin-top:0;color:grey}.exactlinks-frontend-preview .choice-page .product-info img{width:50%;border-radius:5px}.exactlinks-frontend-preview .choice-page .exactlinks-choice-link{display:flex;justify-content:center;flex-flow:wrap;margin-bottom:30px}.exactlinks-frontend-preview .choice-page .exactlinks-choice-link .product-link{display:flex;margin-right:5px;margin-bottom:5px;margin-top:5px}.exactlinks-frontend-preview .choice-page .exactlinks-choice-link .product-link .btn{border:2px solid #11b996;background-color:#11b996;color:#fff;border-radius:5px;display:flex;align-items:center;width:100%;height:40px;padding:5px 15px;text-decoration:none}.exactlinks-frontend-preview .choice-page .exactlinks-choice-link .product-link img{width:80px}.exactlinks-frontend-preview .choice-page .disclosure{color:grey;text-align:center}.exactlinks-choice-bg-dark{height:100vh;background-position:50%;background-repeat:no-repeat;background-size:cover;position:relative;z-index:1;overflow-x:hidden;background-attachment:fixed}.exactlinks-choice-bg-dark:before{content:"";width:100%;position:fixed;height:100%;top:0;left:0;right:0;bottom:0;z-index:-1;background-color:rgba(0,0,0,.7)}.exactlinks-choice-bg-dark .disclosure,.exactlinks-choice-bg-dark .product-info .title,.exactlinks-choice-bg-dark .product-info p{color:#ddd!important}.exl-shortcode-render-choice-page{margin-top:20px;margin-bottom:30px;height:100%;background-attachment:scroll;border-radius:10px}.exl-shortcod