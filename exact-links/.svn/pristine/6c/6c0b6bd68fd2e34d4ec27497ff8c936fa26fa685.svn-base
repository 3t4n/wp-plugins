@charset "UTF-8";.exactlinks-guten-wrapper{margin-bottom:30px;padding:10px;box-sizing:border-box!important}.exactlinks-guten-wrapper .exactlinks-logo{display:flex;justify-content:center;font-size:20px;font-weight:600}.exactlinks-guten-wrapper .box-templates{display:flex;flex-wrap:wrap}.exactlinks-guten-wrapper .box-templates .box-item{width:25%;padding:0;cursor:pointer}.exactlinks-guten-wrapper .box-templates .box-item.is_active{box-shadow:0 0 0 2px #11b996;border-radius:5px;position:relative}.exactlinks-guten-wrapper .box-templates .box-item.is_active:after{content:"\2713";position:absolute;top:0;right:0;font-size:18px;background-color:#11b996;height:30px;width:30px;text-align:center;line-height:30px;font-weight:700;color:#fff}.exactlinks-guten-wrapper .exl-fields{display:flex;align-items:center;gap:30px;padding:0 10px 10px}.exactlinks-guten-wrapper .exl-fields .input-target-url{margin-top:15px}.exactlinks-guten-wrapper .exl-fields .input-target-url label{font-size:15px}.exactlinks-guten-wrapper .exl-fields .item{display:flex;flex-direction:column;flex:1;gap:8px}.exactlinks-guten-wrapper .exl-fields .item input{height:40px;border-radius:4px}.exactlinks-guten-wrapper .exl-fields .insert-btn{transform:translateY(16px)}.exactlinks-guten-wrapper .exl-fields .insert-btn .box-btn{padding:14px 23px;background-color:#11b996;border-color:#11b996;color:#fff;text-decoration:none;display:inline-block;line-height:1;white-space:nowrap;cursor:pointer;text-align:center;box-sizing:border-box;outline:0;margin:0;transition:.1s;font-weight:500;font-size:14px;border-radius:4px}.exactlinks-guten-wrapper .components-form-token-field{position:relative;top:19px}.exactlinks-guten-wrapper .components-form-token-field .components-form-token-field__input-container{border-radius:5px}.exactlinks-guten-wrapper .components-form-token-field .components-form-token-field__help{margin:0}.exactlinks-guten-wrapper .components-form-token-field .components-form-token-field__token{margin-top:4px}.exactlink