.linkt-loading{-webkit-box-align:center;-ms-flex-align:center;-webkit-box-pack:center;-ms-flex-pack:center;align-items:center;display:-webkit-box;display:-ms-flexbox;display:flex;height:65px;justify-content:center}.linkt-dash-stats .linkt.open .linkt-loading{height:100%}.linkt-head{-webkit-box-align:baseline;-ms-flex-align:baseline;align-items:baseline;display:-webkit-box;display:-ms-flexbox;display:flex;font-weight:700;padding-bottom:10px}.linkt{margin:0 0 4px;padding:0 0 4px}.linkt-element,.linkt-title{-webkit-box-align:center;-ms-flex-align:center;align-items:center;display:-webkit-box;display:-ms-flexbox;display:flex}.linkt-title{-webkit-box-flex:1;-ms-flex:1;flex:1;text-align:left;text-transform:capitalize}.linkt-title span{margin-right:6px}.linkt-icon{cursor:pointer;opacity:.5;-webkit-transition:all .3s;transition:all .3s}.linkt-actions,.linkt-clicks{text-align:center;width:80px}.linkt-dash-stats .linkt-actions{-webkit-box-pack:space-evenly;-ms-flex-pack:space-evenly;-webkit-box-align:center;-ms-flex-align:center;align-items:center;display:-webkit-box;display:-ms-flexbox;display:flex;justify-content:space-evenly}.linkt-action{color:inherit;cursor:pointer;font-size:14px;margin-left:8px;text-decoration:none}.linkt-action:hover{color:#516ee0}.linkt-action:first-child{margin-left:0}.linkt-action.copied{color:#03b60c}.linkt .linkt-chart{height:0;overflow:hidden;-webkit-transition:height .25s ease-in-out;transition:height .25s ease-in-out}.linkt.open .linkt-chart{-webkit-box-shadow:0 1px #c3c4c7;box-shadow:0 1px #c3c4c7;height:265px;padding:0 0 15px;visibility:visible}.linkt:last-child.open .linkt-chart{-webkit-box-shadow:none;box-shadow:none}.linkt-dash-stats-url{margin:8px 0 2px;padding:10px;position:relative}.linkt-dash-stats-url,.linkt-dash-url{-webkit-box-align:center;-ms-flex-align:center;-webkit-box-pack:start;-ms-flex-pack:start;align-items:center;display:-webkit-box;display:-ms-flexbox;display:flex;justify-content:flex-start}.linkt-dash-url{background-color