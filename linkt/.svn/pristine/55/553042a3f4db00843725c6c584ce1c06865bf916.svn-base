rgin:0 0 6px;padding:0 0 4px}.linkt-catitem .linkt:last-child,.linkt-catitem:last-child{-webkit-box-shadow:none;box-shadow:none;margin:0;padding:0}.linkt-cat-title{-webkit-box-align:center;-ms-flex-align:center;-webkit-box-pack:justify;-ms-flex-pack:justify;align-items:center;color:#2a2c2f;display:-webkit-box;display:-ms-flexbox;display:flex;font-size:1.05em;font-weight:600;justify-content:space-between;text-transform:capitalize}.linkt-cat-title.open,.linkt-catitem:hover .linkt-cat-title{color:#516ee0}.linkt-catitem .fa-chevron-right{-webkit-transition:all .3s;transition:all .3s}.linkt-catitem .fa-chevron-right.open{-webkit-transform:rotate(90deg);transform:rotate(90deg)}.linkt-cat-inner{padding:10px 0 7px 6px}.linkt-catitem .linkt-loader-wrap{-webkit-box-align:center;-ms-flex-align:center;-webkit-box-pack:center;-ms-flex-pack:center;align-items:center;display:-webkit-box;display:-ms-flexbox;display:flex;height:30px;justify-content:center}.linkt-catitem .linkt-loader-wrap .linkt-loader-sector{border-width:2px}.linkt-catitem .linkt-actions{text-align:right}.linkts-not-found{color:#989898;font-size:12px;padding:10px;text-align:center}.linkts-not-found a{margin:0 0 0 6px;text-decoration:none}.linkts-not-found a:hover{text-decoration:underline}.linkts .post-item{-webkit-box-align:center;-ms-flex-align:center;align-items:center;display:-webkit-box;display:-ms-flexbox;display:flex}.linkts .post-item .post-item__title{-webkit-box-flex:1;-ms-flex:1;flex:1}.linkts .post-item .post-item__actions,.linkts .post-item .post-item__stats{-webkit-box-align:center;-ms-flex-align:center;align-items:center;display:-webkit-box;display:-ms-flexbox;display:flex}