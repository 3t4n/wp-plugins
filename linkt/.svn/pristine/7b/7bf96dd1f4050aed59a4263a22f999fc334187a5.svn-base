:root{--linkt-color:#516ee0;--linkt-bgcolor:#f4f9ff}body.linkt-free #taxonomy-linkts #linkts-all ul.children{display:none}.linkt-loading{-webkit-box-align:center;-ms-flex-align:center;-webkit-box-pack:center;-ms-flex-pack:center;align-items:center;display:-webkit-box;display:-ms-flexbox;display:flex;height:120px;justify-content:center}.linkt-title{font-size:13px;margin:18px 0 8px;padding:0}.linkt-desc{color:#6e7175;font-size:12px;margin:0 0 12px;padding:0}.link-meta-box-input{position:relative}.linkt-input{background-color:#fff;border:1px solid #8c8f94;border-radius:4px;color:#2c3338;padding:6px 10px;width:100%}.linkt-url{background-color:var(--linkt-bgcolor);border:1px solid var(--linkt-color);border-radius:4px;color:var(--linkt-color);padding:12px 10px}.linkt-copy{-webkit-box-align:center;-ms-flex-align:center;-webkit-box-pack:end;-ms-flex-pack:end;align-items:center;color:var(--linkt-color);cursor:pointer;display:-webkit-box;display:-ms-flexbox;display:flex;font-size:22px;height:100%;justify-content:flex-end;padding:0 10px;position:absolute;right:0;text-decoration:none;top:0;width:100%}.linkt-tooltip{background-color:var(--linkt-color);border-radius:4px;bottom:calc(100% + 2px);color:#fff;font-size:11px;letter-spacing:.5px;opacity:0;padding:2px 5px 3px;position:absolute;right:0;-webkit-transition:all .3s;transition:all .3s}.linkt-tooltip:after{border-color:var(--linkt-color) transparent transparent transparent;border-style:solid;border-width:5px;content:"";margin-right:-5px;position:absolute;right:27px;top:100%}.link-meta-box-input:hover .linkt-tooltip{bottom:calc(100% + 7px);opacity:1}.linkt-post-meta{-webkit-box-align:center;-ms-flex-align:center;-webkit-box-pack:justify;-ms-flex-pack:justify;align-items:center;border-top:1px solid #c3c4c7;display:-webkit-box;display:-ms-flexbox;display:flex;justify-content:space-between;margin-top:35px;padding-top:32px}.linkt-select{margin:0 5px 0 0;width:-webkit-fit-content;width:-moz-fit-content;width:fit-content}.linkt-post-meta h5.linkt-title{font-size:14px;margin:0}.linkt-post-clicks{-webkit-box-orient:vertical;-webkit-box-direction:normal;-webkit-box-align:end;-ms-flex-align:end;-webkit-box-pack:center;-ms-flex-pack:center;align-items:flex-end;display:-webkit-box;display:-ms-flexbox;display:flex;-ms-flex-direction:column;flex-direction:column;justify-content:center;margin-right:15px;width:220px}.linkt-post-clicks .linkt-legacy-count{color:#b8b8b9;font-size:11px}.linkt-post-clicks span.fa-circle-notch,.linkt-post-clicks span.fa-trash-can{color:#b2b2b2;font-size:14px;margin-left:15px}.linkt-post-clicks span.fa-trash-can{cursor:pointer}.linkt-post-clicks span.fa-trash-can:hover{color:#b32d2d}span.fa-circle-notch.rotate{-webkit-animation:rotation 1s linear infinite;animation:rotation 1s linear infinite}@-webkit-keyframes rotation{0%{-webkit-transform:rotate(0deg);transform:rotate(0deg)}to{-webkit-transform:rotate(1turn);transform:rotate(1turn)}}@keyframes rotation{0%{-webkit-transform:rotate(0deg);transform:rotate(0deg)}to{-webkit-transform:rotate(1turn);transform:rotate(1turn)}}.linkt-apexchart{margin-top:15px}.linkt-tags-list{margin:22px 0 0}.linkt-tag-title{margin:0 10px 10px 0}.linkt-tags-list .linkt-tag{background-color:#fff;border:1px solid #2c3338;border-radius:4px;color:#2c3338;display:inline-block;margin:0 5px 10px 0;-webkit-transition:all .3s;transition:all .3s}.link-tags-add{-webkit-box-align:center;-ms-flex-align:center;align-items:center;display:-webkit-box;display:-ms-flexbox;display:flex}.link-tags-add input.linkt-input{-webkit-box-flex:1;border-radius:3px;-ms-flex:1;flex:1;font-size:13px;letter-spacing:.4px;margin:0;padding:4px 8px}.link-tags-add button.linkt-addtag{border:1px solid #8c8f94;border-radius:0 3px 3px 0;height:30px;width:100px}.link-tags-add button.linkt-addtag:hover,.linkt-tags-list .linkt-tag.selected,.linkt-tags-list .linkt-tag:hover{background-color:var(--linkt-bgcolor);border-color:var(--linkt-color);color:var(--linkt-color)}a.linkt-desc-a{margin-left:5px}.linkt-tag-inner{-webkit-box-align:center;-ms-flex-align:center;align-items:center;display:-webkit-box;display:-ms-flexbox;display:flex;position:relative}.linkt-tag-name{cursor:pointer;font-size:12px;padding:5px 15px;text-transform:capitalize}.linkt-tag-delete{color:#b2b2b2;cursor:pointer;display:none;font-size:12px;padding:2px;position:absolute;right:2px;top:-17px}.linkt-tag-delete:hover{color:#be1616}.linkt-tags-clear{color:#999;cursor:pointer;font-size:11px;letter-spacing:.2px;margin:0 0 0 5px}.linkt-tags-clear:hover{color:#222}.linkt-tags-inputs{margin:0 0 20px}.linkt-taginput{display:none}.linkt-taginput.selected,.linkt-tags-list .linkt-tag.selected .linkt-tag-delete{display:block}.linkt-taginput-url{width:100%}.linkt-taginput .linkt-taginput-url.invalid{background-color:#fff6f6;border-color:#f59292!important}.linkt-taginput .linkt-taginput-url:focus.valid{border-color:#09c60b;-webkit-box-shadow:none;box-shadow:none}.linkt-taginput .linkt-taginput-url:focus.invalid{border-color:#f28686;-webkit-box-shadow:none;box-shadow:none}.linkt-unrectags-list{margin:10px 0 22px}.linkt-extratag{margin:0 10px 0 0;text-decoration:underline}.linkt-extratag:last-child{margin:0}.linkt-apexchart .apexcharts-legend-text{text-transform:capitalize}.link-meta-box .linkt-no-data{color:#b5b5b5;font-size:15px;padding:50px 0 40px;text-align:center}#linkt-social-metabox h5.linkt-social-label{font-size:14px;margin:0;padding:0}#linkt-social-metabox button.linkt-image-upload{border:0;border-radius:4px;-webkit-box-shadow:inset 0 0 0 1px rgba(0,0,0,.2),0 1px 8px rgba(0,0,0,.08);box-shadow:inset 0 0 0 1px rgba(0,0,0,.2),0 1px 8px rgba(0,0,0,.08);color:#636363;cursor:pointer;margin:0;padding:14px;width:100%}#linkt-social-metabox button.linkt-image-upload:hover{background-color:#dcdcdc;color:#111}#linkt-social-metabox .linkt-input.linkt-error{background-color:#fff8f8;border-color:#f28686}#linkt-social-metabox .linkt-image-preview{position:relative}#linkt-social-metabox .linkt-image-preview img{-webkit-box-shadow:inset 0 0 0 1px rgba(0,0,0,.08),0 1px 8px rgba(0,0,0,.08);box-shadow:inset 0 0 0 1px rgba(0,0,0,.08),0 1px 8px rgba(0,0,0,.08);display:block;height:auto;margin:0 auto;max-width:100%}#linkt-social-metabox .linkt-image-preview .linkt-image-remove{background-color:#fff;border:0;border-radius:40px;color:#444;cursor:pointer;padding:4px;position:absolute;right:5px;top:5px}#linkt-social-metabox .linkt-image-preview .linkt-image-remove:hover{background-color:#fff8f8;color:#b52727}#linkt-social-metabox .linkt-desc-count{color:#7e7e7e;font-size:11px;margin:2px 2px 0 0;text-align:right}