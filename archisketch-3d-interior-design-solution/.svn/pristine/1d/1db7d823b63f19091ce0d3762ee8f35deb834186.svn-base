.form-table {
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    margin-top: 20px;
}

.archi_module_th_guide {
    padding: 2px;
    margin: 0 !important;
    max-width: 440px;
    word-break: keep-all;
    font-size: 13px !important;
    line-height: 1.25;
    color: #2b2b2b;
}

.archi_module_ex {
    padding: 8px;
    margin: 0 0 8px;
    max-width: fit-content;
    word-break: keep-all;
    font-size: 13px;
    line-height: 1.25;
    background: #3498db3d;
    color: #1b1b1b;
    border-radius: 8px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0px 4px 4px rgba(0, 0, 0, 0.06);
}

/* Buttons */
.archi_module_btn_sync {
    margin: 0 0 16px 0;
    width: 320px;
    height: 40px;
    border-radius: 8px;
    color: #fff;
    font-size: 14px;
    border: 0;
    background: #2e2ee8;
    transition: background-color 0.16s ease;
    user-select: none;
    cursor: pointer;
}

.archi_module_btn_sync:hover {
    color: #fff;
    background: #2e2ee8e0;
}

/* Plugin Status Display */
#archisketch-plugin-status {
    margin-bottom: 4px;
    padding: 7px 12px 6px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.8);
    width: fit-content;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    user-select: none;
}