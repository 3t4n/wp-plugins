#: app/Fields/SelectAutocomplete.php:232
msgid "Invalid value"
msgstr "Valore non valido"

#: app/Fields/SelectAutocomplete.php:115
msgid "Message"
msgstr "Messaggio"

#: app/Fields/SelectAutocomplete.php:174
msgid "Message displayed when no results are found"
msgstr "Messaggio mostrato quando nessun risultato è stato trovato"

#: app/Fields/SelectAutocomplete.php:154
msgid "Minimum number of characters needed to trigger the autocomplete search"
msgstr "Numero minimo di caratteri necessario per iniziare la ricerca"

#: app/Fields/SelectAutocomplete.php:171
msgid "No results"
msgstr "Nessun risultato"

#: app/Fields/SelectAutocomplete.php:173
msgid "No results found"
msgstr "Nessun risultato trovato"

#: app/Fields/SelectAutocomplete.php:129
msgid "Only beginning"
msgstr "Solo inizio"

#: app/Fields/SelectAutocomplete.php:191
msgid "Options"
msgstr "Opzioni"

#: app/Fields/SelectAutocomplete.php:113
msgid "Placeholder"
msgstr "Segnaposto"

#. Description of the plugin
msgid ""
"Plugin that adds an autocomplete field with search functionality to "
"Elementor Pro Forms widget"
msgstr ""
"Plugin che aggiunge il campo select autocomplete con funzionalità di ricerca "
"al widget Modulo di Elementor Pro"

#: app/Fields/SelectAutocomplete.php:132
msgid "Search results checking only if the option start with the given string?"
msgstr ""
"Cercare i risultati controllando soltanto se il valore inizia con la stringa "
"digitata?"

#: app/Fields/SelectAutocomplete.php:194
msgid ""
"Separate options with a pipe char (\"|\"). For example: First value|Second "
"value|Third value"
msgstr ""
"Separa le opzioni col carattere pipe  (\"|\"). Per esempio: Primo "
"valore|Secondo valore|Terzo valore"

#: app/Fields/SelectAutocomplete.php:42
msgid "Type at least %d characters."
msgstr "Digita almeno %d caratteri."
