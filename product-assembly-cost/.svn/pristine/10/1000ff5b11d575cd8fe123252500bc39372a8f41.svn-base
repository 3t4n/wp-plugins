	<custom-fields>
		<custom-field action="copy">_has_assembly</custom-field>
		<custom-field action="copy">_disable_assembly</custom-field>
		<custom-field action="copy">_assembly_cost</custom-field>
	</custom-fields>
	<admin-texts>
