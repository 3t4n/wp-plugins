.editor-styles-wrapper .rich-text:not(:focus) .animated-counter{outline:1px dotted #ccc;outline-offset:4px;position:relative}.editor-styles-wrapper .rich-text:not(:focus) .animated-counter:before{background:#fff;border:1px dotted #ccc;color:#ccc;content:"☕";font-size:16px;font-style:normal;font-weight:400;height:24px;left:-5px;line-height:24px;position:absolute;text-align:center;top:-30px;width:24px}
