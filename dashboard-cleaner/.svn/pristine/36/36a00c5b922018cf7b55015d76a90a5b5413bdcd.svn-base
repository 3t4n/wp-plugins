#wp-admin-bar-dhcl{-moz-animation:pulse 1s ease-out;-moz-animation-iteration-count:3;-webkit-animation:pulse 1s ease-out;-webkit-animation-iteration-count:3;-ms-animation:pulse 1s ease-out;-ms-animation-iteration-count:3;}@-webkit-keyframes pulse{0%{background-color:none;}50%{background-color:orange;border-radius:3px;text-shadow:0 1px 1px #666;box-shadow:1px 1px 3px #A36900 inset;}100%{background-color:none;}}@-moz-keyframes pulse{0%{background-color:none;}50%{background-color:orange;border-radius:3px;text-shadow:0 1px 1px #666;box-shadow:1px 1px 3px #A36900 inset;}100%{background-color:none;}}@-ms-keyframes pulse{0%{background-color:none;}50%{background-color:orange;border-radius:3px;text-shadow:0 1px 1px #666;box-shadow:1px 1px 3px #A36900 inset;}100%{background-color:none;}}
