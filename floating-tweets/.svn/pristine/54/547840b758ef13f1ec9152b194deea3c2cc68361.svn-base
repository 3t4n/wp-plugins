#dc-tweets-%ID% .dc-floater-content {overflow: hidden;}

#dc-tweets-%ID% .tab {background: url(skins/images/tab_white.png) no-repeat 0 -40px; font-weight: bold; font-size: 13px; color: #222; height: 40px; padding: 0 0 0 10px; cursor: pointer; width: auto;}
#dc-tweets-%ID% .tab span {display: block; background: url(skins/images/tab_white.png) no-repeat 100% 0; padding: 13px 10px 14px 0; height: 13px; line-height: 1em;}
#dc-tweets-%ID%.active .tab {background-position: 0 -120px;}
#dc-tweets-%ID%.active .tab span {background-position: 100% -80px;}

#dc-tweets-%ID% .dc-corner {background: url(skins/images/tab_white.png) no-repeat 0 -190px; height: 10px; padding: 0 0 0 10px;}
#dc-tweets-%ID% .dc-corner span {display: block; background: url(skins/images/tab_white.png) no-repeat 100% -230px; padding: 0; height: 10px;}

#dc-tweets-%ID%.bottom.active .tab {background-position: 0 -160px;}
#dc-tweets-%ID%.bottom.active .tab span {background-position: 100% -200px;}

#dc-tweets-%ID%.bottom .dc-corner {background-position: 0 -120px;}
#dc-tweets-%ID%.bottom .dc-corner span {background-position: 100% -80px;}

#dc-tweets-%ID% .dc-floater-content .floating-tweets, #dc-tweets-%ID% .dc-floater-content .floating-tweets li {margin: 0; padding: 0; list-style: none;}
#dc-tweets-%ID% .dc-floater-content .floating-tweets {background: #fff; color: #333; padding: 0 15px 5px 15px; line-height: 1.4em; font-size: 12px;}
#dc-tweets-%ID% .dc-floater-content .floating-tweets a {color: #0082A3;}
#dc-tweets-%ID%.bottom .dc-floater-content .floating-tweets {padding: 5px 15px 0 15px;}
#dc-tweets-%ID% .dc-floater-content .floating-tweets li {padding: 5px 0; border-bottom: 1px solid #ccc;}
#dc-tweets-%ID% .dc-floater-content .floating-tweets li.first {border-top: none;}
#dc-tweets-%ID%.top .dc-floater-content .floating-tweets li.first {padding-top: 0;}
#dc-tweets-%ID% .dc-floater-content .floating-tweets li.link-follow {border-bottom: none; padding: 10px 0 0 0;}
#dc-tweets-%ID%.bottom .dc-floater-content .floating-tweets li.link-follow {padding-bottom: 10px;}
#dc-tweets-%ID% .tab img.icon-twitter {display: block; float: left; width: 24px; height: 24px; background: url(skins/images/icon_twitter.png) no-repeat 0 0; border: none; margin: -5px 8px 0 0; padding: 0;}