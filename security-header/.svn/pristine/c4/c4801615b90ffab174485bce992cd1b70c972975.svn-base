/* General Wrapper */
#inspiredmonks-admin-wrapper {
    font-family: 'Roboto', sans-serif;
    background: linear-gradient(135deg, #fdfbfb, #ebedee);
    padding: 40px;
    border-radius: 12px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
    max-width: 900px;
    margin: 30px auto;
    border: 1px solid #e3e3e3;
}

/* Header */
#inspiredmonks-admin-wrapper h1 {
    font-size: 26px;
    font-weight: 700;
    color: #3a3a3a;
    text-align: center;
    margin-bottom: 20px;
    letter-spacing: 0.5px;
    line-height:100%;
}

/* Settings Section */
.inspiredmonks-settings-section {
    margin-top: 30px;
}

/* Card-based Layout */
.inspiredmonks-settings-fields {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    justify-content: center;
}

/* Individual Card Styling */
.inspiredmonks-clickable-box {
    background: #ffffff;
    padding: 24px 16px;
    border-radius: 10px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    border: 1px solid #e0e0e0;
    cursor: pointer;
    text-align: left;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 10px;
}
/* Hover effect with a shadow on clickabl e box */
.inspiredmonks-clickable-box:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15); /* Soft shadow on hover */
    cursor: pointer;
    transition: all 0.3s ease-out;
}

/* Active box with a more prominent effect */
.inspiredmonks-clickable-box.active {
    box-shadow: 0 15px 30px rgba(0, 115, 170, 0.2); 
    transform: scale(1.05);
        animation: pulse 0.5s ease-out;
    /*border-color: #0073aa;*/

}


@keyframes pulse {
    0% {
        box-shadow: 0 0 0 rgba(0, 115, 170, 0.2);
    }
    100% {
        box-shadow: 0 8px 25px rgba(0, 115, 170, 0.3);
    }
}


.inspiredmonks-clickable-box span {
    display: block;
    font-size: 15px;
    font-weight: 500;
    color: #444444;
    text-align: left;
    width: calc(100% - 30px);
}

/* Icons Styling */
.inspiredmonks-icon {
    transition: transform 0.3s ease, color 0.3s ease;
    width: 20px !important;
    height: 20px;
}

.inspiredmonks-clickable-box:hover .inspiredmonks-icon {
    transform: scale(1.1);
    color: #005f8d;
}

/* Submit Button */
.inspiredmonks-submit-button {
    background: linear-gradient(90deg, #0073aa, #004d80);
    color: #ffffff;
    border: none;
    padding: 12px 25px;
    border-radius: 8px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    transition: background 0.3s ease, box-shadow 0.3s ease;
    display: block;
    margin: 40px auto 0;
    text-align: center;
}

.inspiredmonks-submit-button:hover {
    background: linear-gradient(90deg, #004d80, #002940);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
}

/* Responsive Adjustments */
@media (max-width: 768px) {
    .inspiredmonks-settings-fields {
        grid-template-columns: 1fr;
    }

    .inspiredmonks-clickable-box {
        width: 90%;
        margin: 0 auto;
    }
}

/* Tooltip Styling */
.inspiredmonks-clickable-box {
    position: relative;
}
