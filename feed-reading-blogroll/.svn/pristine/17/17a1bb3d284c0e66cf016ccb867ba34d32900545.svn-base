msgstr "JavaScript"

#: feedreading_blogroll.php:647
#: feedreading_blogroll.php:1122
msgid "News"
msgstr "Nyheter"

#: feedreading_blogroll.php:659
#: feedreading_blogroll.php:1090
msgid "Save Changes"
msgstr "Spara ändringar"

#: feedreading_blogroll.php:664
