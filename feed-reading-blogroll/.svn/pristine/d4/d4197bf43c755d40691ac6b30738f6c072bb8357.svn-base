#: feedreading_blogroll.php:121
#: feedreading_blogroll.php:1210
#: feedreading_blogroll.php:2481
#: feedreading_blogroll.php:2513
msgid "This widget adds the WP Social Blogroll to your sidebar."
msgstr "Questo widget aggiunge il WP Social Blogroll alla tua sidebar."

#: feedreading_blogroll.php:121
#: feedreading_blogroll.php:1210
msgid "It can display multiple link categories. Only a single instance of this widget can be added to your sidebars."
msgstr "Può mostrare il link di più categorie. Un solo widget di questo tipo potrà essere aggiunto alle tue sidebar."

#: feedreading_blogroll.php:161
msgid "Settings"
msgstr "Disposizione"

#: feedreading_blogroll.php:543
msgid "Settings saved."
msgstr "Le impostazioni sono state salvate."

# maybe use the link http://it.wordpress.org in translation
#: feedreading_blogroll.php:579
#: feedreading_blogroll.php:2554
msgid "You are currently using WordPress version %s. Please be informed, that future versions of the WP Social Blogroll plugin will no longer support this version of WordPress. I recommend to upgrade your WordPress-installation to <a href=\"http://wordpress.org\">the latest version</a>."
msgstr "Stai utilizzando la versione %s di WordPress. Sappi che le future versioni del plugin WP Social Blogroll plugin non funzioneranno più per questa versione di WordPress. Mi permetto di suggerirti di aggiornare la tua installazione di WordPress alla <a href=\"http://it.wordpress.org\">ultima versione</a>."

#: feedreading_blogroll.php:589
#: feedreading_blogroll.php:2547
msgid "If you have just upgraded to WordPress 2.8, you will have to add the Widget of the WP Social Blogroll plugin to your sidebar again. <a href=\"%s\">Please go to the Widget-Settings-Page</a> to add the widget to your sidebar."
msgstr "Nel caso in cui avessi aggiornato la piattaforma alla versione WordPress 2.8, sarà necessario che tu aggiunga nuovamente nella sidebar il widget del plugin WP Social Blogroll. <a href=\"%s\">Vai alla pagina Impostazioni/widget</a> per potere aggiungere il widget alla barra laterale."

#: feedreading_blogroll.php:601
msgid "JavaScript-file <strong>and</strong> content-directory are writable. This is no longer necessary. You should make the content-directory read-only (chmod 755) now for security-reasons.</p><p>This plugin requires <strong>only</strong> JavaScript-file itself to be writable."
msgstr "Il file JavaScript <strong>e</strong> la directory sono scrivibili: questa operazione non sarà più necessaria. Dovrai quindi far sì che il contenuto della directory sia in sola-lettura (chmod 755) per ovvie ragioni di sicurezza.</p><p>Questo plugin richiederà <strong>solamente</strong> che sia il file JavaScript in sé a dover essere scrivibile."

#: feedreading_blogroll.php:608
msgid "Content directory and/or JavaScript-file not writable!"
msgstr "La directory e/o il file JavaScript non é scrivibile!"

