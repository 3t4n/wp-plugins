#: feedreading_blogroll.php:121
#: feedreading_blogroll.php:1210
#: feedreading_blogroll.php:2481
#: feedreading_blogroll.php:2513
msgid "This widget adds the WP Social Blogroll to your sidebar."
msgstr "Este widget adiciona o WP Social Blogroll plugin à sua barra lateral."

#: feedreading_blogroll.php:121
#: feedreading_blogroll.php:1210
msgid "It can display multiple link categories. Only a single instance of this widget can be added to your sidebars."
msgstr "Podem ser visualizadas várias categorias de links. Apenas uma única instância deste widget pode ser adiciona às suas barras laterais."

#: feedreading_blogroll.php:161
msgid "Settings"
msgstr "Configurações"

#: feedreading_blogroll.php:543
msgid "Settings saved."
msgstr "Opções guardadas."

# maybe use the link http://pt.wordpress.org in translation
#: feedreading_blogroll.php:579
#: feedreading_blogroll.php:2554
msgid "You are currently using WordPress version %s. Please be informed, that future versions of the WP Social Blogroll plugin will no longer support this version of WordPress. I recommend to upgrade your WordPress-installation to <a href=\"http://wordpress.org\">the latest version</a>."
msgstr "Está a utilizar a versão %s do WordPress. Informámos que as versões futuras do plugin WP Social Blogroll não estarão disponí­veis para esta versão do WordPress. Recomendámos que actualize a instalação do WordPress para a <a href=\"http://pt.wordpress.org\">última versão</a>."

#: feedreading_blogroll.php:589
#: feedreading_blogroll.php:2547
msgid "If you have just upgraded to WordPress 2.8, you will have to add the Widget of the WP Social Blogroll plugin to your sidebar again. <a href=\"%s\">Please go to the Widget-Settings-Page</a> to add the widget to your sidebar."
msgstr "Se acabou de actualizar para a versão 2.8 do WordPress tem de adicionar novamente o WP Social Blogroll Widget plugin à sua barra lateral. <a href=\"%s\">Vá por favor para a Página de Configurações do Widget</a> para adicionar o widget à sua barra lateral."

#: feedreading_blogroll.php:601
msgid "JavaScript-file <strong>and</strong> content-directory are writable. This is no longer necessary. You should make the content-directory read-only (chmod 755) now for security-reasons.</p><p>This plugin requires <strong>only</strong> JavaScript-file itself to be writable."
msgstr "O ficheiro JavaScript <strong>e</strong> a pasta ./wp-content permitem a escrita. Tal já não é necessário. Deve alterar já as permissões da pasta ./wp-content para read-only (chmod 755) por motivos de segurança.</p><p>Este plugin exige <strong>apenas</strong> que o ficheiro JavaScript tenha permissões de escrita."

#: feedreading_blogroll.php:608
msgid "Content directory and/or JavaScript-file not writable!"
msgstr "Pasta ./wp-content e/ou o ficheiro JavaScript sem permissões de escrita!"

#: feedreading_blogroll.php:616
msgid "Developer&rsquo;s Blog"
msgstr "Blogue do Autor"

#: feedreading_blogroll.php:617
msgid "Subscribe to the Developer&rsquo;s RSS-Feed"
msgstr "Subscreva o RSS Feed do Autor"

#: feedreading_blogroll.php:617
