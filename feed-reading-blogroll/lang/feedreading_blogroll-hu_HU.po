msgid "JavaScript-sorting allows sorting by &quot;latest update&quot;."
msgstr "JavaScript rendezés engedélyezi a &quot;utolsó frisstés&quot; szerinti rendezést."

#: feedreading_blogroll.php:875
msgid "JavaScript-sorting timeout"
msgstr "JavaScript rendezés időtullépés"

