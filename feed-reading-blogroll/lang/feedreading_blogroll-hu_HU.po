#, php-format
msgid "You are currently using WordPress version %s. Please be informed, that future versions of the WP Social Blogroll plugin will no longer support this version of WordPress. I recommend to upgrade your WordPress-installation to <a href=\"http://wordpress.org\">the latest version</a>."
msgstr "Jelenleg a Wordpress %s verzióját használod. Kérlek vedd figyelembe, hogy a WP SOcial Blogroll következő verzió nem támogatják majd ezt a Wordpress verziót. Javasoljuk, hogy frissítsd Wordpress verziódat a <a href=\"http://wordpress.org\">legújab verzióra</a>."

#: feedreading_blogroll.php:578
#: feedreading_blogroll.php:2534
#, php-format
msgid "If you have just upgraded to WordPress 2.8, you will have to add the Widget of the WP Social Blogroll plugin to your sidebar again. <a href=\"%s\">Please go to the Widget-Settings-Page</a> to add the widget to your sidebar."
msgstr "Ha éppen most frissítettél 2.8-as Wordpress verzióra, újbol hozza kell adnod a widgetet az oldalsávhoz. Kérlek lépj a <a href=\"%s\">Widget-Settings-Page</a> oldalra és add hozza újra."

#: feedreading_blogroll.php:590
msgid "JavaScript-file <strong>and</strong> content-directory are writable. This is no longer necessary. You should make the content-directory read-only (chmod 755) now for security-reasons.</p><p>This plugin requires <strong>only</strong> JavaScript-file itself to be writable."
msgstr "JavaScript file és mapap írható. Ez többé nem szügséges. A mappát csak olvasásra állíthatod (chmod 755) a biztonságod érdekében."

#: feedreading_blogroll.php:597
msgid "Content directory and/or JavaScript-file not writable!"
msgstr "Mappa és/vagy JavaScript file nem írható"

