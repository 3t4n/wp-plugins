(a=>{a('a[href^="#"]').on("click",function(t){var e=a(a.attr(this,"href"));e.length&&(t.preventDefault(),a("html, body").animate({scrollTop:e.offset().top-110},0))});let c=document.querySelectorAll(".wrap .tabs .mycontainer .myrow .box-menu a"),o=document.querySelectorAll(".wrap .data-content");c.forEach(function(t,e){c[e].addEventListener("click",function(){var t="."+this.getAttribute("myid");c.forEach(function(t){t.classList.remove("active")}),this.classList.add("active"),o.forEach(function(t){t.classList.add("hide"),t.classList.remove("active")}),document.querySelector(t+".data-content").classList.remove("hide"),document.querySelector(t+".data-content").classList.add("active")})})})(jQuery);