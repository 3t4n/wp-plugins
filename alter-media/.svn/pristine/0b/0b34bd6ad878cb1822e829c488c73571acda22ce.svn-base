{
	"name": "matterwp/alter",
	"autoload": {
		"psr-4": {
			"Alter\\Admin\\": "src/Admin/Controllers",
			"Alter\\Core\\": "src/Core/Controllers"
		}
	},
	"config": {
		"optimize-autoloader": true,
		"classmap-authoritative": true
	},
	"authors": [
		{
			"name": "matterwp.com"
		}
	],
	"require": {
		"matterwp/wp-subscription-manager": "^0.0.4"
	}
}
