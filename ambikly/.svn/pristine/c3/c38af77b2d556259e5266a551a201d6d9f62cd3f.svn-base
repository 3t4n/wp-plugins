/*
Toast message
 */
/*
loading spinner
 */
@keyframes spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}
.wrap {
  max-width: 970px;
  margin: 0 auto;
}

.ambikly-add-new-button {
  margin-top: 20px;
}

.ambikly-breadcrumb {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 16px;
  background: #f9f9f9;
  padding: 15px 0;
  max-width: 970px;
  margin: 0 auto;
}

.ambikly-breadcrumb-wrap {
  background: #f9f9f9;
  margin-left: -20px;
  padding-left: 20px;
  border-bottom: 1px solid #e1e1e1;
}

.breadcrumb-left {
  display: flex;
  align-items: center;
  list-style: none;
  margin: 0;
  padding: 0;
}
.breadcrumb-left li {
  margin-right: 10px;
}
.breadcrumb-left li a {
  text-decoration: none;
  color: #0073aa;
}
.breadcrumb-left li a:hover {
  text-decoration: underline;
}
.breadcrumb-left li:last-child {
  color: #666;
}

.breadcrumb-separator svg {
  width: 20px;
  height: 20px;
  fill: none;
  stroke: #bcbcbc;
}

.breadcrumb-right .save-trigger-button {
  background-color: #0073aa;
  color: white;
  padding: 8px 16px;
  font-size: 14px;
  border: none;
  border-radius: 3px;
  cursor: pointer;
  transition: background-color 0.2s ease;
}
.breadcrumb-right .save-trigger-button:hover {
  background-color: #005177;
}

.ambikly-form button[type=submit] {
  background-color: #0073aa;
  color: white;
  padding: 8px 16px;
  font-size: 14px;
  border: none;
  border-radius: 3px;
  cursor: pointer;
  transition: background-color 0.2s ease;
}

.toast {
  position: fixed;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  padding: 15px 25px;
  border-radius: 5px;
  color: #fff;
  display: none;
  z-index: 9999;
  opacity: 0.9999;
}

.toast-success {
  background-color: #28a745;
}

.toast-error {
  background-color: #dc3545;
}

.loading-spinner {
  border: 2px solid rgba(255, 255, 255, 0.6);
  border-top: 2px solid #fff;
  border-radius: 50%;
  width: 12px;
  height: 12px;
  animation: spin 1s linear infinite;
  display: inline-block;
  margin-left: 5px;
}

