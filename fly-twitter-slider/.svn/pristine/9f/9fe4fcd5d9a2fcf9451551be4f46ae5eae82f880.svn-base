
jQuery(document).ready(function(){
	jQuery('.tw_close').click(function(){
		jQuery('#tw_flyarea').animate({
			left: "-=350"
		});
		jQuery('#tw_flybutton').animate({
			left: "+=100"
		});
	})

	jQuery('#tw_flybutton').click(function(){
		jQuery('#tw_flyarea').animate({
			left: "+=350"
		});
		jQuery('#tw_flybutton').animate({
			left: "-=100"
		});
	})

})
