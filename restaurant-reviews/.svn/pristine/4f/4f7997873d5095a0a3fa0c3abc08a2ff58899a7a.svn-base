/* Targeting only the WordPress admin area */
.wp-admin .ptenm_restaurant_reviews_admin__reviews {
    margin: 20px 0;
    padding: 10px;
    background-color: #f9f9f9;
    border: 1px solid #ddd;
    border-radius: 8px;
}

/* Each individual review */
.wp-admin .ptenm_restaurant_reviews_admin__single-review {
    margin-bottom: 15px;
    padding: 10px;
    border-bottom: 1px solid #ddd;
}

/* Review header: Name on the left, stars on the right */
.wp-admin .ptenm_restaurant_reviews_admin__review-header {
    display: flex;                /* Use flexbox to align name and stars in a row */
    justify-content: flex-start;   /* Align items from the start */
    align-items: center;           /* Vertically align the name and stars */
    margin-bottom: 8px;            /* Space between header and review content */
}

/* Reviewer name (left-aligned) */
.wp-admin .ptenm_restaurant_reviews_admin__reviewer-name {
    font-size: 18px;
    font-weight: bold;
    margin-right: 10px;            /* Add space between the name and the stars */
    white-space: nowrap;           /* Prevent name from wrapping */
}

/* Stars (right-aligned next to name) */
.wp-admin .ptenm_restaurant_reviews_admin__stars {
    display: inline-block;
}

.wp-admin .ptenm_restaurant_reviews_admin__stars .star {
    font-size: 20px;
    color: #ccc;                   /* Default color */
}

.wp-admin .ptenm_restaurant_reviews_admin__stars .star.filled {
    color: #ffcc00;                /* Color for filled stars */
}

/* Review content: Text displayed below name and stars */
.wp-admin .ptenm_restaurant_reviews_admin__review-content {
    font-size: 16px;
    line-height: 1.5;
    margin-top: 10px;
}

/* Action links for admin reviews */
.ptenm_restaurant_reviews_admin__actions {
    margin-top: 10px;
    font-size: 14px;
}

.ptenm_restaurant_reviews_admin__actions a {
    color: #0073aa;
    text-decoration: none;
}

.ptenm_restaurant_reviews_admin__actions a:hover {
    color: #00a0d2;
}

#ptenm_restaurant_reviews_reviewer_url {
 width:100%;
}
.ptenm-restaurant-reviews-donate {
    margin:20px 0;
}