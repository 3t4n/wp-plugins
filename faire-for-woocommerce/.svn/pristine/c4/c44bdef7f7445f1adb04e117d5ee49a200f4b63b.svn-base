{"mappings":"ACMC,8CAIA,4CAMD,iDAGC,qGAKA,4OAOA,sFAIA,qFAIA,+JAMA,wEAKD,qDAGC,sFAMC,4DAIA,4DAOD,yCAGC,0DAIA,0DAKD,yDAGC,gJAQA,sLAQF","sources":["styles/admin_order.css","assets/styles/admin_order.scss"],"sourcesContent":["#faire_backorder .postbox-header {\n  display: none;\n}\n\n#faire_backorder .inside {\n  margin: 0;\n  padding: 0;\n}\n\n.woocommerce_order_backorder_products {\n  width: 100%;\n}\n\n.woocommerce_order_backorder_products .product__name {\n  text-align: left;\n  border-bottom: 1px solid #f8f8f8;\n}\n\n.woocommerce_order_backorder_products .product__purchased-qty, .woocommerce_order_backorder_products .product__available-qty, .woocommerce_order_backorder_products .product__backorder-date {\n  text-align: right;\n  border-bottom: 1px solid #f8f8f8;\n}\n\n.woocommerce_order_backorder_products .product__backorder-date .input-text {\n  width: 12em;\n}\n\n.woocommerce_order_backorder_products #backorder_products_qty_field {\n  text-align: right;\n}\n\n.woocommerce_order_backorder_products #backorder_products_qty, .woocommerce_order_backorder_products #backorder_products_date {\n  vertical-align: middle;\n  padding: 5px;\n}\n\n.woocommerce_order_backorder_products #backorder_products_qty {\n  width: 5em;\n}\n\n.backorder_products__header {\n  background-color: #f8f8f8;\n}\n\n.backorder_products__header th {\n  text-align: left;\n  color: #999;\n  padding: 1em;\n  font-weight: 400;\n}\n\n.backorder_products__header th:first-child {\n  padding-left: 2em;\n}\n\n.backorder_products__header th:last-child {\n  padding-right: 2em;\n}\n\n.backorder_products__body td {\n  padding: 1em;\n}\n\n.backorder_products__body td:first-child {\n  padding-left: 2em;\n}\n\n.backorder_products__body td:last-child {\n  padding-right: 2em;\n}\n\n.backorder_products__body .product__thumbnail {\n  width: 38px;\n}\n\n.backorder_products__body .product__thumbnail .thumbnail__wrapper {\n  width: 38px;\n  height: 38px;\n  color: #ccc;\n  background: #f8f8f8;\n  border: 2px solid #e8e8e8;\n}\n\n.backorder_products__body .product__thumbnail .woocommerce-placeholder, .backorder_products__body .product__thumbnail .attachment-woocommerce_gallery_thumbnail {\n  width: 100%;\n  height: 100%;\n}\n\n.backorder_products__actions {\n  text-align: right;\n  padding: 1em 2em;\n}\n\n/*# sourceMappingURL=admin_order.css.map */\n","/**\n * Admin order UI styles.\n */\n\n#faire_backorder {\n\n\t.postbox-header {\n\t\tdisplay: none;\n\t}\n\n\t.inside {\n\t\tmargin: 0;\n\t\tpadding: 0;\n\t}\n}\n\n.woocommerce_order_backorder_products {\n\twidth: 100%;\n\n\t.product__name {\n\t\tborder-bottom: 1px solid #f8f8f8;\n\t\ttext-align: left;\n\t}\n\n\t.product__purchased-qty,\n\t.product__available-qty,\n\t.product__backorder-date {\n\t\tborder-bottom: 1px solid #f8f8f8;\n\t\ttext-align: right;\n\t}\n\n\t.product__backorder-date .input-text {\n\t\twidth: 12em;\n\t}\n\n\t#backorder_products_qty_field {\n\t\ttext-align: right;\n\t}\n\n\t#backorder_products_qty,\n\t#backorder_products_date {\n\t\tvertical-align: middle;\n\t\tpadding: 5px;\n\t}\n\n\t#backorder_products_qty {\n\t\twidth: 5em;\n\t}\n}\n\n.backorder_products__header {\n\tbackground-color: #f8f8f8;\n\n\tth {\n\t\tpadding: 1em;\n\t\ttext-align: left;\n\t\tfont-weight: 400;\n\t\tcolor: #999;\n\n\t\t&:first-child {\n\t\t\tpadding-left: 2em;\n\t\t}\n\n\t\t&:last-child {\n\t\t\tpadding-right: 2em;\n\t\t}\n\t}\n}\n\n.backorder_products__body {\n\ttd {\n\t\tpadding: 1em;\n\n\t\t&:first-child {\n\t\t\tpadding-left: 2em;\n\t\t}\n\n\t\t&:last-child {\n\t\t\tpadding-right: 2em;\n\t\t}\n\t}\n\n\t.product__thumbnail {\n\t\twidth: 38px;\n\n\t\t.thumbnail__wrapper {\n\t\t\twidth: 38px;\n\t\t\theight: 38px;\n\t\t\tborder: 2px solid #e8e8e8;\n\t\t\tbackground: #f8f8f8;\n\t\t\tcolor: #ccc;\n\t\t}\n\n\t\t.woocommerce-placeholder,\n\t\t.attachment-woocommerce_gallery_thumbnail {\n\t\t\twidth: 100%;\n\t\t\theight: 100%;\n\t\t}\n\t}\n}\n\n.backorder_products__actions {\n\tpadding: 1em 2em;\n\ttext-align: right;\n}\n"],"names":[],"version":3,"file":"admin_order.css.map"}