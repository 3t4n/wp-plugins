/* tooltip css */

.tooltip {
   position: relative;
   display: inline-block;
}

/*.tooltip .tooltiptext::after {
   content: " ";
   position: absolute;
   top: 9%;
   right: 100%; /* To the left of the tooltip */
 /*  margin-top: -5px;
   border-width: 5px;
   border-style: solid;
   border-color: transparent #211e1eb3 transparent transparent;
}*/


.tooltip .tooltiptext {
   visibility: hidden;
   width: 120px;
   background-color: #211e1eb3;
   color: #fff;
   text-align: center;
   border-radius: 6px;
   padding: 5px 0;

   /* Position the tooltip */
   position: absolute;
   z-index: 1;
}

.tooltip:hover .tooltiptext {
   visibility: visible;
}