.megaone-slider-block {
    padding: 20px;
    background-color: #333;
    color: white;
}
.megaone-slider-block h1,
.megaone-slider-block h5 {
    color: white;
}

h4{font-size: 1rem}

.particles-js-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none; /* Ensures particles do not block interaction */
}
