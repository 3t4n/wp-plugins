        FS.createFolder('/', Module['outputDirectory'], true, true);
        // create input files with data
        if (Module['files']) {
            Module['files'].forEach(function(file) {
                FS.createDataFile('/', file.name,  new Uint8Array(file.buffer), true, true);
            });
