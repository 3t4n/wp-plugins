.rise-blocks-shadow-enable .block-editor-block-list__block{box-shadow:0 0 16px 0 rgba(0,0,0,.05)}.rise-blocks-block-lists>div>div{height:100%}.rise-blocks-icon-blocks-wrapper .wp-block{margin-top:70px}.rise-blocks-block-lists .block-editor-block-list__block{padding-left:28px;padding-right:28px}.rise-blocks-icon-blocks-wrapper .block-list-appender{flex:100%}.rise-blocks-icon-blocks-wrapper .block-editor-block-list__layout>.block-editor-block-list__block>.block-editor-block-list__block-edit,.rise-blocks-icon-blocks-wrapper>.block-editor-block-list__block>.block-editor-block-list__block-edit{margin-bottom:0;margin-top:0}.rise-blocks-items-per-row-1 .block-editor-block-list__layout{display:flex;flex-wrap:wrap}.rise-blocks-items-per-row-1 .rise-blocks-icon-box{flex:0 0 100%;max-width:100%}.rise-blocks-items-per-row-2 .block-editor-block-list__layout{display:flex;flex-wrap:wrap}.rise-blocks-items-per-row-2 .rise-blocks-icon-box{flex:0 0 50%;max-width:50%}.rise-blocks-items-per-row-3 .block-editor-block-list__layout{display:flex;flex-wrap:wrap}.rise-blocks-items-per-row-3 .rise-blocks-icon-box{flex:0 0 33.33%;max-width:33.33%}.rise-blocks-items-per-row-4 .block-editor-block-list__layout{display:flex;flex-wrap:wrap}.rise-blocks-items-per-row-4 .rise-blocks-icon-box{flex:0 0 25%;max-width:25%}.rise-blocks-items-per-row-5 .block-editor-block-list__layout{display:flex;flex-wrap:wrap}.rise-blocks-items-per-row-5 .rise-blocks-icon-box{flex:0 0 20%;max-width:20%}
