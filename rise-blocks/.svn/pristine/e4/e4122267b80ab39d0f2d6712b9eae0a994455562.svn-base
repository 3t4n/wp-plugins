.rise-blocks-accordion-title{background:#eee;border:1px solid #d7d7d7;padding:10px}.wp-block-rise-blocks-accordion-item>button{align-items:center;background:#000;border:none;border-radius:3px;color:#fff;cursor:pointer;display:flex;font-size:12px;height:25px;justify-content:center;line-height:1;padding:0 14px;position:absolute;right:20px;text-transform:capitalize;top:12px}
