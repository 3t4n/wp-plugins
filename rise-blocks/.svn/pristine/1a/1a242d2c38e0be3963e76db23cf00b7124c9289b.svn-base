.rise-blocks-counter .rise-blocks-counter-number input{background-color:transparent;border:none;height:auto;max-width:100%;padding:0;text-align:center}.rise-blocks-counter .rise-blocks-counter-number input:focus{box-shadow:none;outline:none}.rise-blocks-counter .rise-blocks-counter-number input::-webkit-inner-spin-button,.rise-blocks-counter .rise-blocks-counter-number input::-webkit-outer-spin-button{-webkit-appearance:none;margin:0}.rise-blocks-counter-wrapper.rise-blocks-items-per-row-3>div{flex:33.33%;max-width:33.33%}@media(max-width:768px){.rise-blocks-counter-wrapper.rise-blocks-items-per-row-3>div{flex:100%;max-width:100%}}.rise-blocks-counter-wrapper.rise-blocks-items-per-row-4>div{flex:25%;max-width:25%}@media(max-width:768px){.rise-blocks-counter-wrapper.rise-blocks-items-per-row-4>div{flex:50%;max-width:50%}}.rise-blocks-counter-wrapper.rise-blocks-items-per-row-5>div{flex:20%;max-width:20%}@media(max-width:1199px){.rise-blocks-counter-wrapper.rise-blocks-items-per-row-5>div{flex:25%;max-width:25%}}@media(max-width:768px){.rise-blocks-counter-wrapper.rise-blocks-items-per-row-5>div{flex:100%;max-width:100%}}@media(max-width:576px){.rise-blocks-counter-wrapper.rise-blocks-items-per-row-5>div{flex:50%;max-width:50%}}
