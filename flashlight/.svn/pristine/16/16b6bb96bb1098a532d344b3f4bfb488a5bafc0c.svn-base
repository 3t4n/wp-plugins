*,
*::before,
*::after {
	box-sizing: border-box;
}
.nw-toggle {
	display: block;
	text-align: center;
	margin-top: 40px;
	user-select: none;
}
.toggle-nw-checkbox {
	display: none;
}
.toggle-nw-btn {
	display: block;
	margin: 0 auto;
	font-size: 1.4em;
	transition: all 350ms ease-in;
		-webkit-transition: all 350ms ease-in;
			-moz-transition: all 350ms ease-in;
				-o-transition: all 350ms ease-in;
}
.toggle-nw-btn:hover {
	cursor: pointer;
}
.toggle-nw-btn, .toggle-nw-btn:before, .toggle-nw-btn:after,
.toggle-nw-checkbox,
.toggle-nw-checkbox:before,
.toggle-nw-checkbox:after,
.toggle-nw-feature,
.toggle-nw-feature:before,
.toggle-nw-feature:after {
	transition: all 250ms ease-in;
		-webkit-transition: all 250ms ease-in;
			-moz-transition: all 250ms ease-in;
				-o-transition: all 250ms ease-in;
}
.toggle-nw-btn:before, .toggle-nw-btn:after,
.toggle-nw-checkbox:before,
.toggle-nw-checkbox:after,
.toggle-nw-feature:before,
.toggle-nw-feature:after {
	content: '';
	display: block;
}
.toggle-nw-daynight .toggle-nw-btn {
	position: relative;
	height: 70px;
	width: 125px;
	border-radius: 70px;
}
.toggle-nw-daynight .toggle-nw-btn:before {
	position: absolute;
	top: 2px;
	left: 4px;
	width: 56px;
	height: 56px;
	border-radius: 50%;
}
.toggle-nw-daynight .toggle-nw-btn {
	border: 5px solid #1c1c1c;
	background-color: #3c4145;
}
.toggle-nw-daynight .toggle-nw-btn:before {
	background-color: #fff;
	border: 5px solid #e3e3c7;
}
.toggle-nw-daynight .toggle-nw-btn:after {
	position: absolute;
	top: 62%;
	left: 39px;
	z-index: 1111;
	width: 11.2px;
	height: 11.2px;
	opacity: 0;
	background-color: #fff;
	border-radius: 50%;
	box-shadow: #fff 0 0, #fff 3px 0, #fff 6px 0, #fff 9px 0, #fff 11px 0, #fff 14px 0, #fff 16px 0, #fff 21px -1px 0 1px, #fff 16px -7px 0 -2px, #fff 7px -7px 0 1px, #d3d3d3 0 0 0 4px, #d3d3d3 6px 0 0 4px, #d3d3d3 11px 0 0 4px, #d3d3d3 16px 0 0 4px, #d3d3d3 21px -1px 0 5px, #d3d3d3 16px -7px 0 1px, #d3d3d3 7px -7px 0 5px;
		-moz-box-shadow: #fff 0 0, #fff 3px 0, #fff 6px 0, #fff 9px 0, #fff 11px 0, #fff 14px 0, #fff 16px 0, #fff 21px -1px 0 1px, #fff 16px -7px 0 -2px, #fff 7px -7px 0 1px, #d3d3d3 0 0 0 4px, #d3d3d3 6px 0 0 4px, #d3d3d3 11px 0 0 4px, #d3d3d3 16px 0 0 4px, #d3d3d3 21px -1px 0 5px, #d3d3d3 16px -7px 0 1px, #d3d3d3 7px -7px 0 5px;
			-webkit-box-shadow: #fff 0 0, #fff 3px 0, #fff 6px 0, #fff 9px 0, #fff 11px 0, #fff 14px 0, #fff 16px 0, #fff 21px -1px 0 1px, #fff 16px -7px 0 -2px, #fff 7px -7px 0 1px, #d3d3d3 0 0 0 4px, #d3d3d3 6px 0 0 4px, #d3d3d3 11px 0 0 4px, #d3d3d3 16px 0 0 4px, #d3d3d3 21px -1px 0 5px, #d3d3d3 16px -7px 0 1px, #d3d3d3 7px -7px 0 5px;
	transition: opacity 100ms ease-in;
		-webkit-transition: opacity 100ms ease-in;
			-moz-transition: opacity 100ms ease-in;
				-o-transition: opacity 100ms ease-in;
}
@keyframes starry_star {
50% {
background-color: rgba(255, 255, 255, 0.1);
	box-shadow: #fff 30px -3px 0 0, #fff 12px 10px 0 -1px, rgba(255, 255, 255, 0.1) 38px 18px 0 1px, #fff 32px 34px 0 0, rgba(255, 255, 255, 0.1) 20px 24px 0 -1.5px, #fff 5px 38px 0 1px;
		-moz-box-shadow:#fff 30px -3px 0 0, #fff 12px 10px 0 -1px, rgba(255, 255, 255, 0.1) 38px 18px 0 1px, #fff 32px 34px 0 0, rgba(255, 255, 255, 0.1) 20px 24px 0 -1.5px, #fff 5px 38px 0 1px;
			-webkit-box-shadow: #fff 30px -3px 0 0, #fff 12px 10px 0 -1px, rgba(255, 255, 255, 0.1) 38px 18px 0 1px, #fff 32px 34px 0 0, rgba(255, 255, 255, 0.1) 20px 24px 0 -1.5px, #fff 5px 38px 0 1px;
}
}
@-webkit-keyframes starry_star {
50% {
	background-color: rgba(255, 255, 255, 0.1);
	box-shadow: #fff 30px -3px 0 0, #fff 12px 10px 0 -1px, rgba(255, 255, 255, 0.1) 38px 18px 0 1px, #fff 32px 34px 0 0, rgba(255, 255, 255, 0.1) 20px 24px 0 -1.5px, #fff 5px 38px 0 1px;
		-moz-box-shadow:#fff 30px -3px 0 0, #fff 12px 10px 0 -1px, rgba(255, 255, 255, 0.1) 38px 18px 0 1px, #fff 32px 34px 0 0, rgba(255, 255, 255, 0.1) 20px 24px 0 -1.5px, #fff 5px 38px 0 1px;
			-webkit-box-shadow: #fff 30px -3px 0 0, #fff 12px 10px 0 -1px, rgba(255, 255, 255, 0.1) 38px 18px 0 1px, #fff 32px 34px 0 0, rgba(255, 255, 255, 0.1) 20px 24px 0 -1.5px, #fff 5px 38px 0 1px;px 0 -1.5px, #fff 5px 38px 0 1px;
}
}
@keyframes bounceIn {
0% {
opacity: 0;
	transform: scale(0.3);
		-ms-transform: scale(0.3);
			-webkit-transform: scale(0.3);
}
50% {
	opacity: 100;
	transform: scale(1.1);
		-ms-transform: scale(1.1);
			-webkit-transform: scale(1.1);
}
55% {
	transform: scale(1.1);
		-ms-transform: scale(1.1);
			-webkit-transform: scale(1.1);
}
75% {
	transform: scale(0.9);
	-ms-transform: scale(0.9);
		-webkit-transform: scale(0.9);
}
100% {
	opacity: 100;
	transform: scale(1);
	-ms-transform: scale(1);
		-webkit-transform: scale(1);
}
}
@-webkit-keyframes bounceIn {
0% {
	opacity: 0;
	transform: scale(0.3);
		-ms-transform: scale(0.3);
			-webkit-transform: scale(0.3);
}
50% {
	opacity: 100;
	transform: scale(1.1);
		-ms-transform: scale(1.1);
			-webkit-transform: scale(1.1);
}
55% {
	transform: scale(1.1);
	-ms-transform: scale(1.1);
		-webkit-transform: scale(1.1);
}
75% {
	transform: scale(0.9);
		-ms-transform: scale(0.9);
			-webkit-transform: scale(0.9);
}
100% {
	opacity: 100;
	transform: scale(1);
		-ms-transform: scale(1);
			-webkit-transform: scale(1);
}
}
.toggle-nw-daynight .toggle-nw-feature {
	display: block;
	position: absolute;
	top: 9px;
	left: 52.5%;
	z-index: 2222;
	width: 4px;
	height: 4px;
	border-radius: 50%;
	background-color: #fff;
	box-shadow: rgba(255, 255, 255, 0.1) 30px -3px 0 0, rgba(255, 255, 255, 0.1) 12px 10px 0 -1px, #fff 38px 18px 0 1px, rgba(255, 255, 255, 0.1) 32px 34px 0 0, #fff 20px 24px 0 -1.5px, rgba(255, 255, 255, 0.1) 5px 38px 0 1px;
		-moz-box-shadow: rgba(255, 255, 255, 0.1) 30px -3px 0 0, rgba(255, 255, 255, 0.1) 12px 10px 0 -1px, #fff 38px 18px 0 1px, rgba(255, 255, 255, 0.1) 32px 34px 0 0, #fff 20px 24px 0 -1.5px, rgba(255, 255, 255, 0.1) 5px 38px 0 1px;
			-webkit-box-shadow: rgba(255, 255, 255, 0.1) 30px -3px 0 0, rgba(255, 255, 255, 0.1) 12px 10px 0 -1px, #fff 38px 18px 0 1px, rgba(255, 255, 255, 0.1) 32px 34px 0 0, #fff 20px 24px 0 -1.5px, rgba(255, 255, 255, 0.1) 5px 38px 0 1px;
	animation: starry_star 5s ease-in-out infinite;
		-webkit-animation: starry_star 5s ease-in-out infinite;
			-moz-animation: starry_star 5s ease-in-out infinite;
				-ms-animation: starry_star 5s ease-in-out infinite;
					-o-animation: starry_star 5s ease-in-out infinite;
}
.toggle-nw-daynight .toggle-nw-feature:before {
	position: absolute;
	top: -2px;
	left: -25px;
	width: 18px;
	height: 18px;
	background-color: #fff;
	border-radius: 50%;
	border: 5px solid #e3e3c7;
	box-shadow: #e3e3c7 -28px 0 0 -3px, #e3e3c7 -8px 24px 0 -2px;
		-moz-box-shadow: #e3e3c7 -28px 0 0 -3px, #e3e3c7 -8px 24px 0 -2px;
			-webkit-box-shadow: #e3e3c7 -28px 0 0 -3px, #e3e3c7 -8px 24px 0 -2px;
	transform-origin: -6px 130%;
		-ms-transform-origin: -6px 130%;
			-webkit-transform-origin: -6px 130%;
}
.toggle-nw-daynight .toggle-nw-checkbox:checked + .toggle-nw-btn {
	background-color: #9ee3fb;
	border: 5px solid #86c3d7;
}
.toggle-nw-daynight .toggle-nw-checkbox:checked + .toggle-nw-btn:before {
	left: 55px;
	background-color: #ffdf6d;
	border: 5px solid #e1c348;
}
.toggle-nw-daynight .toggle-nw-checkbox:checked + .toggle-nw-btn:after {
	opacity: 100;
	animation-name: bounceIn;
		-webkit-animation-name: bounceIn;
	animation-duration: 0.60s;
		-webkit-animation-duration: 0.60s;
	animation-delay: 0.10s;
		-webkit-animation-delay: 0.10s;
	animation-fill-mode: backwards;
		-webkit-animation-fill-mode: backwards;
	animation-timing-function: ease-in-out;
		-webkit-animation-timing-function: ease-in-out;
}
.toggle-nw-daynight .toggle-nw-checkbox:checked + .toggle-nw-btn > .toggle-nw-feature {
	opacity: 0;
	box-shadow: rgba(255, 255, 255, 0.1) 30px -3px 0 -4px, rgba(255, 255, 255, 0.1) 12px 10px 0 -5px, #fff 38px 18px 0 -3px, rgba(255, 255, 255, 0.1) 32px 34px 0 -4px, #fff 20px 24px 0 -5.5px, rgba(255, 255, 255, 0.1) 5px 38px 0 -3px;
		-moz-box-shadow: rgba(255, 255, 255, 0.1) 30px -3px 0 -4px, rgba(255, 255, 255, 0.1) 12px 10px 0 -5px, #fff 38px 18px 0 -3px, rgba(255, 255, 255, 0.1) 32px 34px 0 -4px, #fff 20px 24px 0 -5.5px, rgba(255, 255, 255, 0.1) 5px 38px 0 -3px;
			-webkit-box-shadow: rgba(255, 255, 255, 0.1) 30px -3px 0 -4px, rgba(255, 255, 255, 0.1) 12px 10px 0 -5px, #fff 38px 18px 0 -3px, rgba(255, 255, 255, 0.1) 32px 34px 0 -4px, #fff 20px 24px 0 -5.5px, rgba(255, 255, 255, 0.1) 5px 38px 0 -3px;
	animation: none;
		-webkit-animation: none;
			-moz-animation: none;
				-ms-animation: none;
					-o-animation: none;
}
.toggle-nw-daynight .toggle-nw-checkbox:checked + .toggle-nw-btn > .toggle-nw-feature:before {
	left: 25px;
	transform: rotate(70deg);
		-ms-transform: rotate(70deg);
			-webkit-transform: rotate(70deg);
}
.nw-flashlight {
	border-radius: 50%;
	box-shadow: 0 0 0 3999px rgba(0, 0, 0, .8), 0px 0px 150px 151px rgba(255, 255, 255, 0.6);
		-moz-box-shadow: 0 0 0 3999px rgba(0, 0, 0, .8), 0px 0px 150px 151px rgba(255, 255, 255, 0.6);
			-webkit-box-shadow: 0 0 0 3999px rgba(0, 0, 0, .8), 0px 0px 150px 151px rgba(255, 255, 255, 0.6);
	height: 250px;
	width: 250px;
	position: absolute;
	pointer-events: none;
	z-index: 1111;
}