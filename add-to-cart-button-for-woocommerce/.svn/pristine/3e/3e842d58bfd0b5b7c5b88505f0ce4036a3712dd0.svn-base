/**
 * Define the internationalization functionality
 *
 * Loads and defines the internationalization files for this plugin
 * so that it is ready for translation.
 *
 * @link       https://wpforhad.com/
 * @since      1.0.0
 *
 * @package    Add_To_Cart_Button_For_Woocommerce
 * @subpackage Add_To_Cart_Button_For_Woocommerce/includes
 */

/**
 * Define the internationalization functionality.
 *
 * Loads and defines the internationalization files for this plugin
 * so that it is ready for translation.
 *
 * @since      1.0.0
 * @package    Add_To_Cart_Button_For_Woocommerce
 * @subpackage Add_To_Cart_Button_For_Woocommerce/includes
 * @author     Forhad <need@forhad.net>
 */
class Add_To_Cart_Button_For_Woocommerce_i18n {


	/**
	 * Load the plugin text domain for translation.
	 *
	 * @since    1.0.0
	 */
	public function load_plugin_textdomain() {

		load_plugin_textdomain(
			'add-to-cart-button-for-woocommerce',
			false,
			dirname( dirname( plugin_basename( __FILE__ ) ) ) . '/languages/'
		);

	}



}
