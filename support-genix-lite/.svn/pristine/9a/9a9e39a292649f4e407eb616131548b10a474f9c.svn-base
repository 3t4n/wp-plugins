<?php

/**
 * Imap settings.
 */

defined('ABSPATH') || exit;

class Mapbd_wps_imap_settings extends AppsBDModel
{
    public $id;
    public $wps_host;
    public $wps_port;
    public $secure_protocol;
    public $secure_protocol_type;
    public $user_email;
    public $user_password;
    public $status;
    public $attach_with;
    public $choose_category;
    public $cron_cmd;
    // @ Dynamic
    public $action;


    /**
     *@property id,cat_ids,rule_type,rule_id,status
     */
    function __construct()
    {
        parent::__construct();
        $this->SetValidation();
        $this->tableName = "apbd_wps_imap_settings";
        $this->primaryKey = "id";
        $this->uniqueKey = array();
        $this->multiKey = array();
        $this->autoIncField = array("id");
        $this->app_base_name = "support-genix-lite";
    }


    function SetValidation()
    {
        $this->validations = array(
            "id" => array("Text" => "Id", "Rule" => "max_length[11]|integer"),
            "wps_host" => array("Text" => "Host", "Rule" => "max_length[100]"),
            "wps_port" => array("Text" => "Port", "Rule" => "max_length[100]"),
            "secure_protocol" => array("Text" => "Secure Protocol", "Rule" => "max_length[1]"),
            "secure_protocol_type" => array("Text" => "Secure Protocol Type", "Rule" => "max_length[1]"),
            "user_email" => array("Text" => "User Email", "Rule" => "max_length[100]"),
            "user_password" => array("Text" => "User Password", "Rule" => "max_length[255]"),
            "cron_cmd" => array("Text" => "Corn Command", "Rule" => "max_length[255]"),
            "status" => array("Text" => "Status", "Rule" => "max_length[1]"),
            "attach_with" => array("Text" => "attach with", "Rule" => "max_length[1]"),
            "choose_category" => array("Text" => "choose category", "Rule" => "max_length[255]"),

        );
    }

    public function GetPropertyRawOptions($property, $isWithSelect = false)
    {
        $returnObj = array();
        switch ($property) {
            case "secure_protocol_type":
                $returnObj = array("S" => "SSL", "T" => "TLS", "A" => "START-TLS");
                break;
            case "secure_protocol":
                $returnObj = array("A" => "Active", "I" => "Inactive");
                break;
            case "status":
                $returnObj = array("A" => "Active", "I" => "Inactive");
                break;
            default:
        }
        if ($isWithSelect) {
            return array_merge(array("" => "Select"), $returnObj);
        }
        return $returnObj;
    }

    public function GetPropertyOptionsColor($property)
    {
        $returnObj = array();
        switch ($property) {
            case "status":
                $returnObj = array("A" => "success", "S" => "success", "N" => "success");
                break;
            default:
        }
        return $returnObj;
    }

    public function GetPropertyOptionsIcon($property)
    {
        $returnObj = array();
        switch ($property) {
            case "rule_type":
                $returnObj = array("A" => "fa fa-check-circle-o", "S" => "fa fa-check-circle-o", "N" => "fa fa-bell");
                break;
            default:
        }
        return $returnObj;
    }
    public function Update($notLimit = false, $isShowMsg = true, $dontProcessIdWhereNotset = true)
    {
        return parent::Update($notLimit, $isShowMsg, $dontProcessIdWhereNotset); // TODO: Change the autogenerated stub
    }

    public function SetFromPostData($isNew = false, $data = null)
    {
        $newData = [];

        $wps_host = sanitize_text_field(APBD_PostValue('wps_host', ''));
        $wps_port = sanitize_text_field(APBD_PostValue('wps_port', ''));
        $user_email = sanitize_email(APBD_PostValue('user_email', ''));
        $user_password = strval(APBD_PostValue('user_password', ''));
        $secure_protocol = sanitize_text_field(APBD_PostValue('secure_protocol', ''));
        $secure_protocol_type = sanitize_text_field(APBD_PostValue('secure_protocol_type', ''));
        $attach_with = sanitize_text_field(APBD_PostValue('attach_with', ''));
        $choose_category = absint(APBD_PostValue('choose_category', ''));
        $status = sanitize_text_field(APBD_PostValue('status', ''));

        $secure_protocol = 'A' === $secure_protocol ? 'A' : 'I';
        $attach_with = 'A' === $attach_with ? 'A' : 'I';
        $choose_category = strval($choose_category);
        $status = 'A' === $status ? 'A' : 'I';
        $secure_protocol_type = in_array($secure_protocol_type, ['S', 'T', 'A'], true) ? $secure_protocol_type : 'S';

        if (
            (1 > strlen($wps_host)) ||
            (1 > strlen($wps_port)) ||
            (1 > strlen($user_email)) ||
            (1 > strlen($user_password))
        ) {
            return;
        }

        $newData['wps_host'] = $wps_host;
        $newData['wps_port'] = $wps_port;
        $newData['user_email'] = $user_email;
        $newData['user_password'] = $user_password;
        $newData['secure_protocol'] = $secure_protocol;
        $newData['attach_with'] = $attach_with;
        $newData['status'] = $status;

        if ('A' === $secure_protocol) {
            $newData['secure_protocol_type'] = $secure_protocol_type;
        } elseif ($isNew) {
            $newData['secure_protocol_type'] = 'S';
        }

        if ('A' === $attach_with) {
            if (empty($choose_category)) {
                return;
            }

            $newData['choose_category'] = $choose_category;
        }

        return parent::SetFromPostData($isNew, $newData);
    }

    /**
     * From version 1.4.4
     */
    static function UpdateDBTableCharset()
    {
        $thisObj = new static();
        $table_name = $thisObj->db->prefix . $thisObj->tableName;
        $charset = $thisObj->db->charset;
        $collate = $thisObj->db->collate;

        $alter_query = "ALTER TABLE `{$table_name}` CONVERT TO CHARACTER SET {$charset} COLLATE {$collate}";

        $thisObj->db->query($alter_query);
    }

    static function CreateDBTable()
    {
        $thisObj = new static();
        $table = $thisObj->db->prefix . $thisObj->tableName;
        $charsetCollate = $thisObj->db->has_cap('collation') ? $thisObj->db->get_charset_collate() : '';

        if ($thisObj->db->get_var("show tables like '{$table}'") != $table) {
            $sql = "CREATE TABLE `{$table}` (
                      `id` int(11) unsigned NOT NULL AUTO_INCREMENT,
                      `wps_host` char(100) DEFAULT '',
                      `wps_port` char(100) NOT NULL DEFAULT '',
                      `secure_protocol` char(1) NOT NULL COMMENT 'bool(A=Active,I=Inactive)',
                      `secure_protocol_type` char(1) NOT NULL COMMENT 'radio(S=SSL,T=TLS)',
                      `user_email` char(100) NOT NULL DEFAULT '',
                      `user_password` char(200) NOT NULL,
                      `cron_cmd` char(255) NOT NULL,
                      `status` char(1) NOT NULL COMMENT 'bool(A=Active,I=Inactive)',
                       `attach_with` char(1) NOT NULL COMMENT 'bool(A=Active,I=Inactive)',
                       `choose_category` char(255) NOT NULL,
                      PRIMARY KEY (`id`)
                    ) $charsetCollate;";
            require_once(ABSPATH . 'wp-admin/includes/upgrade.php');
            dbDelta($sql);
        }
    }
    function DropDBTable()
    {
        global $wpdb;

        $table_name = $wpdb->prefix . $this->tableName;
        $sql        = "DROP TABLE IF EXISTS $table_name;";
        $wpdb->query($sql);
    }
    static function DeleteById($id)
    {
        return  parent::DeleteByKeyValue("id", $id);
    }
}
