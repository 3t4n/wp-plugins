.qcld-main-style-3 .style-3 ul.ca-menu {
    margin: 0;
    padding: 0;
}
.qcld-main-style-3 .qcpnd-list-holder .style-3 li {
    float: left;
    list-style: none;
    box-shadow: 0px 16px 32px 0px rgba(0, 0, 0, 0.04);
    border-radius: 4px 4px 4px 0;
    background: #fff;
    padding: 12px 2px 2px 2px;
    margin: 8px 20px;
    position: relative;
    min-height: 368px;
    transition: all linear 0.3s;
    border: 1px solid #fff;
}
.qcld-main-style-3 .qcpnd-list-holder .style-3 li img{
    width: 100%;
}

.qcld-main-style-3 .qcpnd-list-holder .style-3 li a.qcld-custom-column{
    text-decoration: none !important;
    display: flex;
    align-items: center;
    line-height: 12px;
}
.qcld-main-style-3 .qcpnd-list-holder .style-3 li .ca-content h2 {
    font-size: 20px;
    font-weight: bold;
    margin: 0;
    padding: 15px 0 0 0;
    text-align: center;
    color: #222;
}

.qcld-main-style-3 .qcpnd-list-holder .style-3 li h3.ca-sub {
    font-size: 16px;
    margin: 0;
    padding: 8px 0 12px 0;
}

.qcld-main-style-3 .qcpnd-list-holder .style-3 li h3.ca-sub span {
    display: inline-block;
    width: 100%;
    padding: 6px 0;
    color: #222;
}

.qcld-main-style-3 .qcpnd-list-holder .style-3 li img {
    width: 100%;
    border-radius: 4px 0 0 0;
    max-width: 150px;
}
.qcld-main-style-3 .qcpnd-list-holder .style-3 li a.qcld-custom-column .list-img-1 {
    width: 100%;
    display: block;
    text-align: center;
}

.qcld-main-style-3 .qcld-main-style-3 .qcpnd-list-holder .style-3 li .sbd_icons {
    position: absolute;
    bottom: 18px;
    left: 20px;
    transition: all linear 0.3s;
}

.qcld-main-style-3 .qcpnd-list-holder .style-3 li .sbd_icons {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 100%;
    background: none;
    width: 34px;
    border-radius: 0;
     margin: 0; 
    text-align: right;
    left: auto;
}
.qcld-main-style-3 .qcpnd-list-holder .style-3 li .sbd_icons a i {
    color: #f45b1e;
}
.qcld-main-style-3 .qcpnd-list-holder .style-3 li .sbd_icons a {
    padding: 0 8px;
    margin: 0 0 15px 0;
    display: block;
    background: #ffffff;
    text-align: center;
    border-radius: 50%;
    width: 20px;
    height: 35px;
    line-height: 35px;
}

.qcld-main-style-3 .qcpnd-list-holder .style-3 li:hover .sbd_icons a i{
    color: #f45b1e;
}
.qcld-main-style-3 .qcpnd-list-holder .style-3 li h3.ca-sub span i{
    font-size: 1rem;
    margin-right: 5px;
    color: #f45b1e;
}
.qcld-main-style-3 .qcpnd-list-holder .style-3 li a.qcld-custom-column .list-img-1{
    position: relative;
    overflow: hidden;
    display: block;
    -webkit-transition: -webkit-transform 0.6s ease-in;
    transition: -webkit-transform 0.6s ease-in;
    transition: transform 0.6s ease-in;
    transition: transform 0.6s ease-in, -webkit-transform 0.6s ease-in;
    min-height: 140px;
}

.qcld-main-style-3 .qcpnd-list-holder .style-3 li a.qcld-custom-column .list-img-1 img {
    transform: scale(1);
    transition: all .8s ease;
}
.qcld-main-style-3 .qcpnd-list-holder .style-3 li a.qcld-custom-column .list-img-1:hover img {
    transform: scale(1.3);
}

.qcld-main-style-3 .qcpnd-list-holder .style-3 li .ca-content {
    width: 100%;
}

.qcld-main-style-3 .qcpnd-list-holder .style-3 li a.qcld-custom-column {
    text-decoration: none !important;
    display: flex;
    align-items: center;
    line-height: 12px;
    flex-direction: column;
}

.qcld-main-style-3 .qcpnd-list-holder .style-3 li .ca-content {
    width: 92%;
}

.qcld-main-style-3 .qcpnd-list-wrapper .qc-grid-item{
    width: 100% !important; 
}

.qcld-main-style-3 .qcpnd-list-wrapper .qc-grid-item .qcpnd-list-column {
    width: 100% !important; 
}

.qcld-main-style-3 .qcpnd-list-wrapper {
    max-width: initial;
    width: 100% !important; 
    margin: 0 auto;
    max-width: 1170px !important; 
}


.qcld-main-style-3 .qcpnd-list-holder .style-3 li .sbd_icons{
    display: none;
}
.qcld-main-style-3 .qcpnd-list-holder .style-3 li:hover  .sbd_icons{
    display: block;
}


.qcld-main-style-3 .qcpnd-list-holder .style-3 li:hover {
    border: 1px solid #eaeaea;
    border-radius: 0px;
}


.qcld-main-style-3 .qcld-sld-content-dividar{
    background-color: #d7d7d7;
    height: 1px;
    margin: auto;
    position: relative;
    -webkit-transition: all 0.5s cubic-bezier(0.645, 0.045, 0.355, 1);
    -khtml-transition: all 0.5s cubic-bezier(0.645, 0.045, 0.355, 1);
    -moz-transition: all 0.5s cubic-bezier(0.645, 0.045, 0.355, 1);
    -ms-transition: all 0.5s cubic-bezier(0.645, 0.045, 0.355, 1);
    -o-transition: all 0.5s cubic-bezier(0.645, 0.045, 0.355, 1);
    transition: all 0.5s cubic-bezier(0.645, 0.045, 0.355, 1);
    text-align: center;
    width: 100%;
    margin: 12px 0 20px 0;
}



.qcld-main-style-3 .qcld-sld-content-dividar.visible:before, .qcld-main-style-3 .qcld-sld-content-dividar.visible:after {
    border-radius: 25px;
    transform: translatey(-50%) scale(1);
}
.qcld-main-style-3 .qcld-sld-content-dividar:before {
    position: absolute;
    content: '';
    top: calc(50%);
    left: 0;
    width: 9px;
    height: 9px;
    background-color: #f45b1e;
    transform: translatey(-50%) scale(0);
    transition-delay: 500ms !important;
    -webkit-transition: all 0.4s cubic-bezier(0.645, 0.045, 0.355, 1);
    -khtml-transition: all 0.4s cubic-bezier(0.645, 0.045, 0.355, 1);
    -moz-transition: all 0.4s cubic-bezier(0.645, 0.045, 0.355, 1);
    -ms-transition: all 0.4s cubic-bezier(0.645, 0.045, 0.355, 1);
    -o-transition: all 0.4s cubic-bezier(0.645, 0.045, 0.355, 1);
    transition: all 0.4s cubic-bezier(0.645, 0.045, 0.355, 1);
    border-radius: 100px;
}

.qcld-main-style-3 .qcld-sld-content-dividar:after {
    position: absolute;
    content: '';
    top: calc(50%);
    right: 0;
    width: 9px;
    height: 9px;
    transform: translatey(-50%) scale(0);
    background-color: #f45b1e;
    transition-delay: 500ms !important;
    -webkit-transition: all 0.4s cubic-bezier(0.645, 0.045, 0.355, 1);
    -khtml-transition: all 0.4s cubic-bezier(0.645, 0.045, 0.355, 1);
    -moz-transition: all 0.4s cubic-bezier(0.645, 0.045, 0.355, 1);
    -ms-transition: all 0.4s cubic-bezier(0.645, 0.045, 0.355, 1);
    -o-transition: all 0.4s cubic-bezier(0.645, 0.045, 0.355, 1);
    transition: all 0.4s cubic-bezier(0.645, 0.045, 0.355, 1);
    border-radius: 100px;
}

.qcld-main-style-3 .qcpnd-list-holder .style-3 li:hover:before {
    bottom: -6px;
    right: -6px;
}
.qcld-main-style-3 .qcpnd-list-holder .style-3 li:before {
    position: absolute;
    z-index: -1;
    content: '';
    right: 0;
    bottom: 0;
    width: calc(100% - 13px);
    height: calc(100% - 6px);
    background-color: #f45b1e;
    -webkit-transition: all 0.25s cubic-bezier(0.645, 0.045, 0.355, 1);
    -khtml-transition: all 0.25s cubic-bezier(0.645, 0.045, 0.355, 1);
    -moz-transition: all 0.25s cubic-bezier(0.645, 0.045, 0.355, 1);
    -ms-transition: all 0.25s cubic-bezier(0.645, 0.045, 0.355, 1);
    -o-transition: all 0.25s cubic-bezier(0.645, 0.045, 0.355, 1);
    transition: all 0.25s cubic-bezier(0.645, 0.045, 0.355, 1);
}





/*style-3*/
.qcld-main-style-3 .ca-menu.column4{
    padding: 0 !important;
    margin: 20px auto;
    width: 100%;
    display: grid;
    grid-auto-rows: 1fr;
    grid-template-columns: 1fr 1fr 1fr 1fr;
}

.qcld-main-style-3 .ca-menu.column3{
    padding: 0 !important;
    margin: 20px auto;
    width: 100%;
    display: grid;
    grid-auto-rows: 1fr;
    grid-template-columns: 1fr 1fr 1fr;
}

.qcld-main-style-3 .ca-menu.column2{
    padding: 0 !important;
    margin: 20px auto;
    width: 100%;
    display: grid;
    grid-auto-rows: 1fr;
    grid-template-columns: 1fr 1fr;
}

.qcld-main-style-3 .ca-menu.column1{
    padding: 0 !important;
    margin: 20px auto;
    width: 100%;
    display: grid;
    grid-auto-rows: 1fr;
    grid-template-columns: 1fr;
}

/* tablet breakpoint */
@media (min-width:320px) {
    .qcld-main-style-3 .ca-menu.column4 {
        display: grid;
        grid-auto-rows: 1fr;
        grid-template-columns: 1fr;
    }
    .qcld-main-style-3 .ca-menu.column3 {
        display: grid;
        grid-auto-rows: 1fr;
        grid-template-columns: 1fr;
    }
    .qcld-main-style-3 .ca-menu.column2 {
        display: grid;
        grid-auto-rows: 1fr;
        grid-template-columns: 1fr;
    }
    .qcld-main-style-3 .ca-menu.column1 {
        display: grid;
        grid-auto-rows: 1fr;
        grid-template-columns: 1fr;
    }
}


