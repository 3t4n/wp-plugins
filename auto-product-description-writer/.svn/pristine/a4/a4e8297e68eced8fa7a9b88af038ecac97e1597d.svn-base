.momo-automation-action-container {
	display: grid;
	grid-template-columns: 3fr 1fr;
	gap: 20px;
}
.momo-automation-row{
	display: block;
	margin-bottom: 20px;
}
.momo-automation-container table {
	width: 100%;
	border-collapse: collapse;
}
.momo-automation-container td {
	padding: 10px;
}
.momo-automation-container table td:first-child {
    background-color: #f9f9f9;
	font-size: 14px;
	position: relative;
	width: 25%;
	padding-left: 15px;
}
.momo-automation-container table td:first-child span.asterisk {
	color: red;
	margin-left: 8px;
}
.form-group {
	display: flex;
	margin-bottom: 15px;
}
.form-group label {
	flex: 1;
	font-weight: bold;
}
.form-group .input-container {
	flex: 2;
}
.momo-automation-container input,
.momo-automation-container select,
.momo-automation-container textarea {
	width: 100%!important;
	padding: 8px;
	border: 1px solid #ccc;
	border-radius: 4px;
	max-width: none!important;
}
.help-info {
	background: #f9f9f9;
	padding: 15px;
	border: 1px solid #ddd;
	border-radius: 5px;
}

.momo-loader-container {
	display: flex;
	justify-content: center;
	align-items: center;
	height: 100vh;
	background: #f5f5f5;
  }

  .momo-loader {
	width: 50px;
	height: 50px;
	position: relative;
	animation: rotate 2s linear infinite;
  }

  .momo-loader:before {
	content: '';
	position: absolute;
	width: 100%;
	height: 100%;
	border-radius: 50%;
	border: 4px solid transparent;
	border-top-color: #e8093e;
	border-right-color: #e8093e;
	border-bottom-color: #e8093e;
	border-left-color: #e8093e;
	animation: circle-fill 2s linear infinite;
  }

  @keyframes rotate {
	0% {
	  transform: rotate(0deg);
	}
	100% {
	  transform: rotate(360deg);
	}
  }

  @keyframes circle-fill {
	0% {
	  clip-path: polygon(50% 50%, 50% 0%, 50% 0%, 50% 0%, 50% 0%, 50% 0%);
	}
	25% {
	  clip-path: polygon(50% 50%, 50% 0%, 100% 0%, 100% 50%, 100% 50%, 100% 50%);
	}
	50% {
	  clip-path: polygon(50% 50%, 50% 0%, 100% 0%, 100% 100%, 100% 100%, 100% 100%);
	}
	75% {
	  clip-path: polygon(50% 50%, 50% 0%, 100% 0%, 100% 100%, 0% 100%, 0% 100%);
	}
	100% {
	  clip-path: polygon(50% 50%, 50% 0%, 100% 0%, 100% 100%, 0% 100%, 0% 0%);
	}
}
table.momo-acgwc-automation-list{
	width: 100%; border-collapse: collapse; font-family: Arial, sans-serif;
}
table.momo-acgwc-automation-list thead{
	background-color: #333; color: #fff!important; font-weight: bold;
}
table.momo-acgwc-automation-list thead th{
	color: #fff;
	font-weight: bold;
}
table.momo-acgwc-automation-list td, table.momo-acgwc-automation-list th{
	padding: 10px; border: 1px solid #ccc;
}
table.momo-acgwc-automation-list tbody tr:nth-child(even){
	background-color: #f9f9f9;
}
table.momo-acgwc-automation-list tbody tr:hover{
	background-color: #f5f5f5;
}
.momo-workflow-toggle-status{
	padding: 5px 10px;
	border-radius: 8px;
	background-color: #cecece;
	border: 1px solid #cecece;
	cursor: pointer;
	text-transform: uppercase;
	color: #333;
	transition: 0.3s;
}
.momo-workflow-toggle-status[data-status="on"]{
	background-color: #4CAF50;
	color: #FFF;
	border: 1px solid #4CAF50;
}
.momo-workflow-toggle-status:hover{
	background-color: #f5f5f5;
	color: #000;
}
.momo-workflow-toggle-status.active{	
	background-color: #4CAF50;
	color: #FFF;
}
.momoacgwc-automation-ed-btn{
	background-color: #4CAF50;
	color: #FFF;
	border: 1px solid #4CAF50;
	padding: 5px 10px;
	border-radius: 8px;
	cursor: pointer;
	text-transform: uppercase;
	transition: 0.3s;
	margin: 0 12px;
}
.momoacgwc-automation-ed-btn:hover{
	background-color: #f5f5f5;
	color: #000;
}