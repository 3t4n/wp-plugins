.revenue-amount, .order-count, .average-order-value {
    font-size: 1.5em;
    font-weight: bold;
    color: #333;
}
@media (max-width: 768px) {
    .momo-dashboard-metrics {
        flex-direction: column;
    }
}


.momo-dashboard-card h2 {
    font-size: 18px;
    color: #333;
}

.momo-dashboard-card .revenue-amount {
    font-size: 24px;
    font-weight: bold;
    color: #009688;
}
.momo-dashboard-card .order-count {
    font-size: 24px;
    font-weight: bold;
    color: #3f51b5;
}
.momo-dashboard-card .average-order {
    font-size: 24px;
    font-weight: bold;
    color: #da8619;
}
.momo-dashboard-card .average-order-value {
    font-size: 24px;
    font-weight: bold;
    color: #ff9800;
}
