/* Example CSS to indent submenu items */
.momo-dashboard-metrics {
    display: flex;
    justify-content: space-between; /* Ensures equal spacing between cards */
    gap: 20px;
}
.momo-dashboard-section {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between; /* Add space between items */
    gap: 1rem; /* Space between each card */
    margin-bottom: 2rem;
}

.momo-dashboard-card {
    flex: 1 1 30%; /* Each card takes up 30% of the row with equal spacing */
    min-width: 250px; /* Set a minimum width to avoid squishing on small screens */
    padding: 1rem;
    background-color: #fff;
    border: 1px solid #ddd;
    border-radius: 8px;
    text-align: center;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}
.momo-dashboard-card i {
    font-size: 3rem!important;
    color: #0073e6;
    margin-bottom: 0.5rem;
}
.momo-dashboard-card .ai-insight {
    font-size: 0.875rem;
    color: #666;
    margin-top: 1rem;
    padding: 0.5rem;
    background-color: #f9f9f9;
    border-top: 1px solid #ddd;
    width: 100%;
    border-radius: 0 0 8px 8px;
}
@media (max-width: 768px) {
    .momo-dashboard-card {
        flex: 1 1 100%; /* Stack cards on smaller screens */
    }
}
