#show-float-cart-close.fa.fa-times {
  background: #f8474e none repeat scroll 0 0;
  -webkit-border-radius: 50%;
  border-radius: 50%;
  color: #fff;
  height: 35px !important;
  position: absolute;
  right: 10px;
  top: -2px;
  width: 35px;
  z-index: 99999999;
  cursor:pointer;
  /* padding-left: 13px !important; */
}
.qcld-express-cart-heading > h3 {
  color: #222;
  font-size: 25px;
