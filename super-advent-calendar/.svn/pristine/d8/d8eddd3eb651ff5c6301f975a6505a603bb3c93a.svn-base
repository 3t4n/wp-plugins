namespace SuperAdventCalendar\Interfaces\Controllers;

/**
 * Exit when accessed directly.
 */
if ( ! defined( 'ABSPATH' )) {
	exit;
}

/**
 * Shortcode controller interface.
 *
 * @since 1.12.0
 */
interface ShortcodeControllerInterface
{
	public function register();
	public function register_shortcodes();
	public function register_super_advent_calendar_shortcode( $attrs );
	public function register_super_advent_calendar_link_shortcode( $attrs );
}
