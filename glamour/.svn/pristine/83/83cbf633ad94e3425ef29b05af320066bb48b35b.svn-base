/* http://meyerweb.com/eric/tools/css/reset/ 
   v2.0 | 20110126
   License: none (public domain)
*/
html, body, div, span, applet, object, iframe, h1, h2, h3, h4, h5, h6, p, blockquote, pre, a, abbr, acronym, address, big, cite, code, del, dfn, em, img, ins, kbd, q, s, samp, small, strike, strong, sub, sup, tt, var, b, u, i, center, dl, dt, dd, ol, ul, li, fieldset, form, label, legend, table, caption, tbody, tfoot, thead, tr, th, td, article, aside, canvas, details, embed, figure, figcaption, footer, header, hgroup, menu, nav, output, ruby, section, summary, time, mark, audio, video {
  margin: 0;
  padding: 0;
  border: 0;
  font-size: 100%;
  font: inherit;
  vertical-align: baseline; }

/* HTML5 display-role reset for older browsers */
article, aside, details, figcaption, figure, footer, header, hgroup, menu, nav, section {
  display: block; }

body {
  line-height: 1; }

ol, ul {
  list-style: none; }

blockquote, q {
  quotes: none; }

blockquote:before, blockquote:after {
  content: '';
  content: none; }

q:before, q:after {
  content: '';
  content: none; }

table {
  border-collapse: collapse;
  border-spacing: 0; }

*, ::after, ::before {
  box-sizing: border-box; }

body, html {
  width: 100%;
  height: 100%; }

body {
  font-family: -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif,"Apple Color Emoji","Segoe UI Emoji","Segoe UI Symbol";
  margin: 0;
  padding-left: 300px;
  background-color: #484E56; }
  body.glamour-popup-panel-active {
    padding-left: 0; }
    body.glamour-popup-panel-active.glamour-popup-dragging-active::after {
      content: '';
      display: block;
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: transparent;
      z-index: 1;
      cursor: move; }

.screen-reader-text {
  display: none; }

.glamour-wrap,
.glamour-canvas {
  width: 100%;
  height: 100%; }

.glamour-canvas {
  display: flex;
  align-items: center; }

iframe {
  display: block;
  width: 100%;
  height: 100%;
  border: none;
  margin: 0 auto;
  transition: all 0.3s; }

input[type="text"] {
  display: block;
  height: 30px;
  border: 1px solid #EAECF1;
  border-radius: 3px;
  color: #7A7D82;
  width: 100%;
  margin: 0;
  padding: 5px 8px; }

button {
  display: inline-block;
  text-align: center;
  border: none;
  padding: 0;
  margin: 0;
  cursor: pointer;
  outline: none !important; }

.glamour-add-button {
  display: block;
  background-color: #00a2ba;
  background-image: linear-gradient(to right, #00a2ba 0%, #00e18a 100%);
  color: #fff;
  padding: 6px 12px;
  border-radius: 3px;
  font-weight: 700;
  margin: 10px auto 0; }

.glamour-pro {
  background-color: #FFAA00;
  color: #fff;
  font-weight: 700;
  padding: 3px 6px 2px;
  font-size: 10px;
  text-transform: uppercase;
  font-family: 'Roboto Condensed', sans-serif;
  letter-spacing: 1px;
  border-radius: 20px; }
.glamour-panel {
  font-family: 'Roboto', sans-serif;
  position: absolute;
  top: 0;
  left: 0;
  width: 300px;
  height: 100%;
  font-size: 14px;
  color: #484E56;
  background-color: #EFF2F5;
  border-right: 1px solid #EAECF1; }
  .glamour-panel.glamour-popup-panel {
    position: fixed;
    max-height: 75%;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
    top: 20px;
    left: 20px; }
.glamour-topbar {
  background-color: #00a2ba;
  background-image: linear-gradient(to right, #00a2ba 0%, #00e18a 100%);
  margin-right: -1px;
  position: relative; }
  .glamour-topbar .glamour-brand {
    font-family: 'Roboto Condensed', sans-serif;
    font-size: 18px;
    color: #fff;
    text-transform: uppercase;
    padding: 15px; }
    .glamour-topbar .glamour-brand span {
      background-color: rgba(255, 255, 255, 0.2);
      font-size: 12px;
      padding: 2px 10px;
      font-weight: 700;
      border-radius: 20px;
      position: relative;
      top: -8px;
      letter-spacing: 1px; }
  .glamour-topbar .glamour-panel-popupp {
    position: absolute;
    top: 50%;
    right: 12px;
    margin-top: -16px;
    font-size: 18px;
    color: #fff;
    opacity: 0.5;
    padding: 7px 10px;
    cursor: pointer;
    border-radius: 3px;
    transition: all 0.3s; }
    .glamour-topbar .glamour-panel-popupp:hover {
      opacity: 1; }

.glamour-popup-panel .glamour-topbar .glamour-brand {
  cursor: move;
  -webkit-user-select: none;
     -moz-user-select: none;
      -ms-user-select: none;
          user-select: none; }

.glamour-popup-panel .glamour-topbar .glamour-panel-popupp {
  opacity: 1;
  background-color: rgba(255, 255, 255, 0.2); }
.glamour-tooltip {
  position: absolute;
  z-index: 9999;
  display: block;
  visibility: visible;
  max-width: 500px; }
  .glamour-tooltip .glamour-tooltip-text {
    font-size: 12px;
    line-height: 1.5;
    padding: 5px 10px;
    background-color: #484E56;
    color: #fff;
    border-radius: 3px;
    margin-bottom: 5px; }
  .glamour-tooltip .glamour-tooltip-arrow {
    width: 6px;
    height: 6px;
    position: absolute;
    bottom: 2px;
    left: 50%;
    margin-left: -3px;
    -webkit-transform: rotate(45deg);
            transform: rotate(45deg);
    background-color: #484E56; }
  .glamour-tooltip.glamour-tooltip-arrow-top .glamour-tooltip-text {
    margin-bottom: 0;
    margin-top: 5px; }
  .glamour-tooltip.glamour-tooltip-arrow-top .glamour-tooltip-arrow {
    bottom: auto;
    top: 2px; }
.glamour-bottom {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%; }
  .glamour-bottom .glamour-bottom-tools {
    padding: 15px 12px;
    display: flex; }
    .glamour-bottom .glamour-bottom-tools .glamour-bottom-tool {
      flex: 0 0 25%;
      text-align: center;
      position: relative; }
      .glamour-bottom .glamour-bottom-tools .glamour-bottom-tool .glamour-pro {
        position: absolute;
        top: -6px;
        left: 50%; }
      .glamour-bottom .glamour-bottom-tools .glamour-bottom-tool button {
        display: inline-block;
        width: 45px;
        height: 45px;
        border-radius: 50%;
        border: 2px solid #DEE1E5;
        background-color: transparent;
        cursor: pointer;
        color: #AFB6BF;
        outline: none !important; }
        .glamour-bottom .glamour-bottom-tools .glamour-bottom-tool button.glamour-active, .glamour-bottom .glamour-bottom-tools .glamour-bottom-tool button:not(.disable):hover {
          background-color: #00a2ba;
          background-image: linear-gradient(to right, #00a2ba 0%, #00e18a 100%);
          border: none;
          color: #fff; }
  .glamour-bottom .glamour-bottom-actions {
    background-color: #E1E4E7;
    display: flex; }
    .glamour-bottom .glamour-bottom-actions .glamour-actions-btn button {
      width: 40px;
      height: 40px;
      text-align: center;
      line-height: 40px;
      position: relative;
      background-color: #D8DBDF;
      color: #7A7D82;
      margin-right: 2px; }
      .glamour-bottom .glamour-bottom-actions .glamour-actions-btn button i + i {
        position: absolute;
        top: 17px;
        right: 10px;
        font-size: 11px;
        background-color: #D8DBDF; }
      .glamour-bottom .glamour-bottom-actions .glamour-actions-btn button:hover {
        background-color: #00a2ba;
        background-image: linear-gradient(to right, #00a2ba 0%, #00e18a 100%);
        color: #fff; }
      .glamour-bottom .glamour-bottom-actions .glamour-actions-btn button.glamour-close-btn:hover {
        background-color: #FF0000;
        background-image: linear-gradient(to right, #DB0000 0%, #FF3400 100%);
        color: #fff; }
      .glamour-bottom .glamour-bottom-actions .glamour-actions-btn button.glamour-save-btn {
        width: auto;
        height: 30px;
        line-height: 30px;
        padding: 0 15px;
        border-radius: 3px;
        margin: 5px;
        background-color: #00a2ba;
        background-image: linear-gradient(to right, #00a2ba 0%, #00e18a 100%);
        color: #fff; }
        .glamour-bottom .glamour-bottom-actions .glamour-actions-btn button.glamour-save-btn:hover {
          background-color: #00a2ba;
          background-image: linear-gradient(to left, #00a2ba 0%, #00e18a 100%);
          color: #fff; }
    .glamour-bottom .glamour-bottom-actions .glamour-actions-btn.glamour-save-action {
      margin-left: auto;
      position: relative; }
      .glamour-bottom .glamour-bottom-actions .glamour-actions-btn.glamour-save-action .glamour-save-note {
        position: absolute;
        bottom: calc(100% + 2px);
        left: 50%;
        -webkit-transform: translateX(-50%);
                transform: translateX(-50%);
        max-width: 200px;
        white-space: nowrap;
        -webkit-transform-origin: left center;
                transform-origin: left center;
        -webkit-animation: swing 0.5s;
                animation: swing 0.5s;
        cursor: pointer; }
        .glamour-bottom .glamour-bottom-actions .glamour-actions-btn.glamour-save-action .glamour-save-note > div {
          padding: 10px 20px;
          color: #fff;
          border-radius: 3px;
          position: relative; }
          .glamour-bottom .glamour-bottom-actions .glamour-actions-btn.glamour-save-action .glamour-save-note > div::after {
            content: '';
            width: 0;
            height: 0;
            border-width: 6px 6px 0 6px;
            border-color: transparent;
            border-style: solid;
            position: absolute;
            bottom: -6px;
            left: 50%;
            margin-left: -3px; }
          .glamour-bottom .glamour-bottom-actions .glamour-actions-btn.glamour-save-action .glamour-save-note > div.glamour-save-note-error {
            background-color: #ff4848; }
            .glamour-bottom .glamour-bottom-actions .glamour-actions-btn.glamour-save-action .glamour-save-note > div.glamour-save-note-error::after {
              border-top-color: #ff4848; }
          .glamour-bottom .glamour-bottom-actions .glamour-actions-btn.glamour-save-action .glamour-save-note > div.glamour-save-note-success {
            background-color: #21d024; }
            .glamour-bottom .glamour-bottom-actions .glamour-actions-btn.glamour-save-action .glamour-save-note > div.glamour-save-note-success::after {
              border-top-color: #21d024; }
  .glamour-bottom .glamour-custom-selector-form {
    position: absolute;
    bottom: 100%;
    left: 0;
    display: flex;
    width: 100%;
    padding: 10px 10px 0;
    background-color: #eff2f5; }
    .glamour-bottom .glamour-custom-selector-form input[type="text"] {
      width: 100%;
      padding: 5px 10px;
      height: 40px;
      border-radius: 3px 0 0 3px;
      border: none;
      outline: none !important; }
    .glamour-bottom .glamour-custom-selector-form button {
      height: 40px;
      width: 40px;
      min-width: 40px;
      background-color: #00a2ba;
      background-image: linear-gradient(to right, #00a2ba 0%, #00e18a 100%);
      color: #fff;
      border-radius: 0 3px 3px 0; }
      .glamour-bottom .glamour-custom-selector-form button:hover {
        background-color: #00a2ba;
        background-image: linear-gradient(to left, #00a2ba 0%, #00e18a 100%); }
  .glamour-bottom .glamour-media-list {
    position: absolute;
    bottom: 40px;
    left: 0;
    width: 100%;
    background-color: #484E56;
    color: #D4D8DE;
    z-index: 1; }
    .glamour-bottom .glamour-media-list ul li {
      text-transform: capitalize;
      padding: 10px 15px;
      cursor: pointer; }
      .glamour-bottom .glamour-media-list ul li:hover {
        background-color: #545b64;
        color: #fff; }
      .glamour-bottom .glamour-media-list ul li.glamour-active {
        background-color: #00a2ba;
        background-image: linear-gradient(to right, #00a2ba 0%, #00e18a 100%);
        color: #fff; }
      .glamour-bottom .glamour-media-list ul li i {
        width: 25px; }
      .glamour-bottom .glamour-media-list ul li.tablet-landscape i::before, .glamour-bottom .glamour-media-list ul li.phone-landscape i::before {
        display: inline-block;
        -webkit-transform: rotate(270deg);
                transform: rotate(270deg); }

@-webkit-keyframes swing {
  20% {
    -webkit-transform: rotate(6deg) translateX(-50%);
            transform: rotate(6deg) translateX(-50%); }
  40% {
    -webkit-transform: rotate(-4deg) translateX(-50%);
            transform: rotate(-4deg) translateX(-50%); }
  60% {
    -webkit-transform: rotate(3deg) translateX(-50%);
            transform: rotate(3deg) translateX(-50%); }
  80% {
    -webkit-transform: rotate(-3deg) translateX(-50%);
            transform: rotate(-3deg) translateX(-50%); }
  to {
    -webkit-transform: rotate(0deg) translateX(-50%);
            transform: rotate(0deg) translateX(-50%); } }

@keyframes swing {
  20% {
    -webkit-transform: rotate(6deg) translateX(-50%);
            transform: rotate(6deg) translateX(-50%); }
  40% {
    -webkit-transform: rotate(-4deg) translateX(-50%);
            transform: rotate(-4deg) translateX(-50%); }
  60% {
    -webkit-transform: rotate(3deg) translateX(-50%);
            transform: rotate(3deg) translateX(-50%); }
  80% {
    -webkit-transform: rotate(-3deg) translateX(-50%);
            transform: rotate(-3deg) translateX(-50%); }
  to {
    -webkit-transform: rotate(0deg) translateX(-50%);
            transform: rotate(0deg) translateX(-50%); } }
.glamour-content {
  width: 100%;
  position: absolute;
  top: 48px;
  left: 0;
  bottom: 115px;
  overflow-x: hidden; }

.glamour-selectors {
  margin-top: 10px; }
  .glamour-selectors > li {
    position: relative;
    overflow: hidden; }
    .glamour-selectors > li .glamour-selector-actions {
      position: absolute;
      top: 0;
      right: -10px;
      height: 100%;
      padding: 10px;
      background-color: transparent;
      background-image: linear-gradient(to right, rgba(255, 255, 255, 0) 0%, white 100%);
      display: flex;
      justify-content: center;
      align-items: center;
      opacity: 0;
      visibility: hidden;
      transition: all 0.3s; }
      .glamour-selectors > li .glamour-selector-actions li {
        display: inline-block;
        padding: 0 5px; }
        .glamour-selectors > li .glamour-selector-actions li button {
          width: 30px;
          height: 30px;
          border-radius: 50%;
          font-size: 12px;
          background-color: #fff;
          border: 1px solid #EAECF1;
          color: #7A7D82; }
          .glamour-selectors > li .glamour-selector-actions li button:hover {
            border: none;
            background-color: #00a2ba;
            background-image: linear-gradient(to right, #00a2ba 0%, #00e18a 100%);
            color: #fff; }
        .glamour-selectors > li .glamour-selector-actions li + li button:hover {
          background-color: #FF0000;
          background-image: linear-gradient(to right, #DB0000 0%, #FF3400 100%); }
    .glamour-selectors > li.glamour-no-selector {
      padding: 0 10px; }
      .glamour-selectors > li.glamour-no-selector .glamour-no-selector-message {
        padding: 10px;
        background-color: #c6e5ff;
        border-radius: 4px;
        color: #286fab;
        font-size: 14px;
        line-height: 1.6; }
    .glamour-selectors > li.glamour-get-pro {
      padding: 10px;
      background-color: #fff;
      text-align: center;
      margin-bottom: 10px; }
      .glamour-selectors > li.glamour-get-pro > a {
        display: inline-block;
        text-decoration: none;
        margin-top: 0; }
  .glamour-selectors .glamour-selector {
    background-color: #fff;
    margin-bottom: 2px;
    padding: 8px;
    cursor: pointer;
    position: relative;
    transition: all 0.3s; }
    .glamour-selectors .glamour-selector:before {
      content: '';
      width: 0;
      height: 100%;
      display: block;
      background-color: #00a2ba;
      background-image: linear-gradient(to bottom, #00a2ba 0%, #00e18a 100%);
      position: absolute;
      top: 0;
      left: 0;
      transition: all 0.3s; }
    .glamour-selectors .glamour-selector .glamour-selector-title {
      color: #484E56;
      font-size: 14px;
      line-height: 24px;
      font-weight: 700;
      text-transform: capitalize; }
    .glamour-selectors .glamour-selector .glamour-selector-code {
      color: #D4D8DE;
      font-size: 12px;
      line-height: 22px; }
      .glamour-selectors .glamour-selector .glamour-selector-code strong {
        color: #B2B6BC;
        font-weight: 700; }
  .glamour-selectors > li:hover .glamour-selector-actions {
    visibility: visible;
    opacity: 1;
    right: 0; }
  .glamour-selectors > li:hover .glamour-selector {
    padding-left: 18px; }
    .glamour-selectors > li:hover .glamour-selector:before {
      width: 5px; }

.glamour-selector-in {
  position: relative;
  margin-top: 10px;
  margin-bottom: 10px; }
  .glamour-selector-in .glamour-selector {
    background-color: #ffffff;
    padding: 10px;
    padding-left: 60px;
    position: relative;
    transition: all 0.3s; }
    .glamour-selector-in .glamour-selector .glamour-selector-title {
      color: #484E56;
