.glamour-property-wrap {
  background-color: #fff;
  padding: 15px;
  margin-bottom: 5px; }
  .glamour-property-wrap .glamour-property-label {
    margin-bottom: 10px;
    position: relative; }
    .glamour-property-wrap .glamour-property-label label {
      line-height: 22px;
      font-weight: 600;
      color: #484E56; }
      .glamour-property-wrap .glamour-property-label label + .glamour-pro {
        margin-left: 10px; }
    .glamour-property-wrap .glamour-property-label button {
      width: 18px;
      height: 18px;
      line-height: 19px;
      border-radius: 50%;
      background-color: #EAECF1;
      color: #484E56;
      font-size: 7px;
      margin-left: 10px; }
      .glamour-property-wrap .glamour-property-label button:hover {
        background-color: #00a2ba;
        background-image: linear-gradient(to right, #00a2ba 0%, #00e18a 100%);
        color: #fff; }
      .glamour-property-wrap .glamour-property-label button.glamour-reset-property {
        position: absolute;
