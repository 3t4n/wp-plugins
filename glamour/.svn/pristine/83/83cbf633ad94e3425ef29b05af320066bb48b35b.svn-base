    cursor: pointer; }

.glamour-status-list {
  padding: 0 5px 10px; }
  .glamour-status-list ul {
    display: flex; }
    .glamour-status-list ul li {
      flex: 0 0 25%;
      padding: 0 5px; }
      .glamour-status-list ul li button {
        display: block;
        width: 100%;
        padding: 5px;
        font-size: 13px;
        color: #a1a4a7;
        background-color: transparent;
