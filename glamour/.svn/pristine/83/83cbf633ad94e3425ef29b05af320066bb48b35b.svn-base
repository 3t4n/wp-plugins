      .glamour-selector-popup .glamour-selector-popup-inner button:hover {
        background-color: #00a2ba;
        background-image: linear-gradient(to left, #00a2ba 0%, #00e18a 100%); }
.glamour-category {
  background-color: #fff;
  padding: 15px;
  margin-bottom: 2px;
  cursor: pointer;
  position: relative; }
  .glamour-category .glamour-category-title {
    font-weight: 600;
    color: #7A7D82;
    transition: all 0.3s; }
    .glamour-category .glamour-category-title > .glamour-pro {
      margin-left: 10px; }
  .glamour-category i {
    display: block;
    position: absolute;
    top: 50%;
    right: 0;
    padding: 0 15px;
    -webkit-transform: translateY(-50%);
            transform: translateY(-50%);
    color: #D4D8DE;
    transition: all 0.3s; }
  .glamour-category:hover i,
  .glamour-category:hover .glamour-category-title {
