.glamour-preset {
  width: 236px;
  position: relative;
  z-index: 9;
  margin-top: 7px; }
  .glamour-preset::after {
    content: '';
    width: 15px;
    height: 15px;
    background-color: #484E56;
    position: absolute;
    top: 0;
    right: 7px;
    -webkit-transform: rotate(45deg);
            transform: rotate(45deg);
    margin-top: -5px;
    z-index: -1;
    box-shadow: 0 0 5px rgba(72, 78, 86, 0.2); }
  .glamour-preset .glamour-color-panel {
    background-color: #484E56;
    padding: 4px;
    box-shadow: 0 12px 25px rgba(72, 78, 86, 0.35);
    border-radius: 3px; }
  .glamour-preset ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    max-height: 105px;
    overflow: auto; }
    .glamour-preset ul li.glamour-color-panel-item {
      flex: 0 0 20%;
      cursor: pointer; }
      .glamour-preset ul li.glamour-color-panel-item div {
        width: 100%;
        height: 35px; }

.glamour-input-color {
  position: relative;
  display: flex; }
  .glamour-input-color .color-input-picker {
    position: absolute;
    top: 5px;
    left: 5px; }
  .glamour-input-color > input[type="text"] {
    padding-left: 45px;
    width: 100%;
    border-radius: 3px 0 0 3px;
    margin-top: -1px; }
  .glamour-input-color button {
    width: 30px;
    height: 30px;
    min-width: 30px;
    line-height: 30px;
    padding: 0;
    background-color: #EAECF1;
    border: none;
    border-radius: 0 3px 3px 0;
    margin-top: -1px; }
    .glamour-input-color button + button {
      margin-left: 2px;
      border-radius: 3px; }
.glamour-number-input {
  position: relative; }
  .glamour-number-input button {
    font-size: 12px;
    line-height: 13px;
    width: 15px;
    height: 15px;
    border: 1px solid #EAECF1;
    background-color: #fff;
    position: absolute;
    top: 0;
    right: 0;
    border-radius: 0 3px 0 0; }
    .glamour-number-input button:hover {
      background-color: #00a2ba;
      background-image: linear-gradient(to right, #00a2ba 0%, #00e18a 100%);
      border: none;
      color: #fff;
      line-height: 15px; }
    .glamour-number-input button + button {
      top: auto;
      bottom: 0;
      border-radius: 0 0 3px 0; }
input[type=range] {
  height: 24px;
  -webkit-appearance: none;
  margin: 10px 0;
  width: 100%; }

input[type=range]:focus {
  outline: none; }

input[type=range]::-webkit-slider-runnable-track {
  width: 100%;
  height: 5px;
  cursor: pointer;
  animate: 0.2s;
  box-shadow: 0px 0px 0px rgba(0, 0, 0, 0.16);
  background: #EAECF1;
  border-radius: 2px;
  border: 0px solid #000000; }

input[type=range]::-webkit-slider-thumb {
  box-shadow: 0px 0px 6px rgba(0, 0, 0, 0.16);
  border: 0px solid #2497E3;
  height: 18px;
  width: 18px;
  border-radius: 25px;
  background-color: #00a2ba;
  background-image: linear-gradient(to right, #00a2ba 0%, #00e18a 100%);
  cursor: pointer;
  -webkit-appearance: none;
  margin-top: -6.5px; }

input[type=range]:focus::-webkit-slider-runnable-track {
  background: #EAECF1; }

input[type=range]::-moz-range-track {
  width: 100%;
  height: 5px;
  cursor: pointer;
  animate: 0.2s;
  box-shadow: 0px 0px 0px rgba(0, 0, 0, 0.16);
  background: #EAECF1;
  border-radius: 2px;
  border: 0px solid #000000; }

input[type=range]::-moz-range-thumb {
  box-shadow: 0px 0px 6px rgba(0, 0, 0, 0.16);
  border: 0px solid #2497E3;
  height: 18px;
  width: 18px;
  border-radius: 25px;
  background-color: #00a2ba;
  background-image: linear-gradient(to right, #00a2ba 0%, #00e18a 100%);
  cursor: pointer; }

input[type=range]::-ms-track {
  width: 100%;
  height: 5px;
  cursor: pointer;
  animate: 0.2s;
  background: transparent;
  border-color: transparent;
  color: transparent; }

input[type=range]::-ms-fill-lower {
  background: #EAECF1;
  border: 0px solid #000000;
  border-radius: 4px;
  box-shadow: 0px 0px 0px rgba(0, 0, 0, 0.16); }

input[type=range]::-ms-fill-upper {
  background: #EAECF1;
  border: 0px solid #000000;
  border-radius: 4px;
  box-shadow: 0px 0px 0px rgba(0, 0, 0, 0.16); }

input[type=range]::-ms-thumb {
  margin-top: 1px;
  box-shadow: 0px 0px 6px rgba(0, 0, 0, 0.16);
  border: 0px solid #2497E3;
  height: 18px;
  width: 18px;
  border-radius: 25px;
  background-color: #00a2ba;
  background-image: linear-gradient(to right, #00a2ba 0%, #00e18a 100%);
  cursor: pointer; }

input[type=range]:focus::-ms-fill-lower {
  background: #EAECF1; }

input[type=range]:focus::-ms-fill-upper {
  background: #EAECF1; }

.glamour-range-input {
  display: flex; }
  .glamour-range-input input[type=range] {
    width: calc(100% - 80px);
    margin: 0;
    height: 30px; }
  .glamour-range-input .glamour-range-input-number {
    display: block;
    width: 70px;
    margin-left: 10px; }
.glamour-buttons-input .glamour-buttons-input-group {
  display: flex; }
  .glamour-buttons-input .glamour-buttons-input-group button {
    padding: 7px;
    flex: 1;
    border: 1px solid #EAECF1;
    background-color: #fff;
    color: #7A7D82;
    border-right: none; }
    .glamour-buttons-input .glamour-buttons-input-group button:first-child {
      border-radius: 3px 0 0 3px; }
    .glamour-buttons-input .glamour-buttons-input-group button:last-child {
      border-radius: 0 3px 3px 0;
      border-right: 1px solid #EAECF1; }
    .glamour-buttons-input .glamour-buttons-input-group button.glamour-active {
      background-color: #00a2ba;
      background-image: linear-gradient(to right, #00a2ba 0%, #00e18a 100%);
      color: #fff;
      border: none; }
