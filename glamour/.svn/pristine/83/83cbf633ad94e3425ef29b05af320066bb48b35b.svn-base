    .glamour-box-wrap .glamour-box-item:nth-child(2) {
      top: 50%;
      right: -35px;
      -webkit-transform: translateY(-50%);
              transform: translateY(-50%); }
    .glamour-box-wrap .glamour-box-item:nth-child(3) {
      bottom: -15px;
      left: 50%;
      -webkit-transform: translateX(-50%);
              transform: translateX(-50%); }
    .glamour-box-wrap .glamour-box-item:nth-child(4) {
      top: 50%;
      left: -35px;
      -webkit-transform: translateY(-50%);
              transform: translateY(-50%); }
  .glamour-box-wrap .glamour-linked-btn {
