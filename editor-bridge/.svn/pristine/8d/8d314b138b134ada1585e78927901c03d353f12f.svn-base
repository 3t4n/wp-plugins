.wp-block-group.is-width-25,
.wp-block-columns.is-width-25 {
  width: 26%;
}
.wp-block-group.is-width-50,
.wp-block-columns.is-width-50 {
  width: 50%;
}
.wp-block-group.is-width-75,
.wp-block-columns.is-width-75 {
