<?php

class Loya_ID_Easy_Lead_Form {

    public function run() {
        // Initialize the admin settings page
        $admin_settings = new Loya_ID_ELF_Admin_Settings();
        $admin_settings->init();

        // Initialize the public lead form functionality
        $lead_form = new Loya_ID_ELF_Lead_Form();
        $lead_form->init();
    }
}
