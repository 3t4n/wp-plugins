#: includes/paybox-config.php:123 includes/paybox-config.php:172
msgid "Enable/Disable"
msgstr "Actif/Inactif"

#: includes/paybox-config.php:126 includes/paybox-config.php:236
msgid "Disable"
msgstr "Inactif"

#: includes/paybox-config.php:127 includes/paybox-config.php:237
msgid "Enable"
msgstr "Actif"

#: includes/paybox-config.php:129
msgid "Enable Paybox Payment"
msgstr "Activer le paiement par Paybox"

#: includes/paybox-config.php:133
msgid "Title"
msgstr "Titre"

#: includes/paybox-config.php:135
msgid "This controls the title which the user sees during checkout."
msgstr "Titre visible par le client lors d'une commande"

#: includes/paybox-config.php:139
msgid "Description"
msgstr "Description"

#: includes/paybox-config.php:141
msgid "Payment method description that the customer will see on your checkout."
msgstr ""
"Description de la méthode de paiement . Visible par le client lors d'une "
"commande"

#: includes/paybox-config.php:146
msgid "Delay"
msgstr "Délai"

#: includes/paybox-config.php:149
msgid "Immediate"
msgstr "Immédiat"

#: includes/paybox-config.php:150
msgid "1 day"
msgstr "1 jour"

#: includes/paybox-config.php:151
msgid "2 days"
msgstr "2 jours"

#: includes/paybox-config.php:152
msgid "3 days"
msgstr "3 jours"

#: includes/paybox-config.php:153
msgid "4 days"
msgstr "4 jours"

#: includes/paybox-config.php:154
msgid "5 days"
msgstr "5 jours"

#: includes/paybox-config.php:155
msgid "6 days"
msgstr "6 jours"

#: includes/paybox-config.php:156
msgid "7 days"
msgstr "7 jours"

#: includes/paybox-config.php:162 includes/paybox-config.php:184
msgid "Minimal amount"
msgstr "Montant minimal"

#: includes/paybox-config.php:164
msgid ""
"Enable this payment method for order with amount greater or equals to this "
"amount (empty to ignore this condition)"
msgstr ""
"Activer 3D Secure pour les commandes dont le montant est supérieur ou égal "
"au montant suivant (laissez vide pour ne pas activer cette condition)"

#: includes/paybox-config.php:168
msgid "3D Secure"
msgstr "3D Secure"

#: includes/paybox-config.php:174
msgid "Enable 3D Secure"
msgstr "Activer 3D Secure"

#: includes/paybox-config.php:175
msgid ""
"You can enable 3D Secure for all orders or depending on following conditions"
msgstr ""
"Vous pouvez activer  3D Secure pour toutes les commandes ou en fonction des "
"conditions suivantes."

#: includes/paybox-config.php:178
msgid "Disabled"
msgstr "Inactif"

#: includes/paybox-config.php:179
msgid "Enabled"
msgstr "Actif"

#: includes/paybox-config.php:180
msgid "Conditional"
msgstr "Sélectif"

#: includes/paybox-config.php:186
msgid ""
"Enable 3D Secure for order with amount greater or equals to this amount "
"(empty to ignore this condition)"
msgstr ""
"Activer 3D Secure pour les commandes dont le montant est supérieur ou égal "
"au montant suivant "

#: includes/paybox-config.php:190
msgid "Paybox account"
msgstr "Compte Paybox"

#: includes/paybox-config.php:194
msgid "Site number"
msgstr "Numéro du site"

#: includes/paybox-config.php:196
msgid "Site number provided by Paybox."
msgstr "Le numéro du site vous est fourni par Paybox"

#: includes/paybox-config.php:200
msgid "Rank number"
msgstr "Rang"

#: includes/paybox-config.php:202
msgid "Rank number provided by Paybox (two last digits)."
msgstr "Numéro de rang fourni par Paybox (deux derniers chiffres)."

#: includes/paybox-config.php:206
msgid "Login"
msgstr "Identifiant"

#: includes/paybox-config.php:208
msgid "Internal login provided by Paybox."
msgstr "Votre identifiant vous est fourni par Paybox"

#: includes/paybox-config.php:212
msgid "HMAC"
msgstr "HMAC"

#: includes/paybox-config.php:214
msgid "Secrete HMAC key to create using the Paybox interface."
msgstr "Clé secrète HMAC à générer puis activer dans votre Back-Office Paybox."

#: includes/paybox-config.php:218
msgid "Environment"
msgstr "Environnement"

#: includes/paybox-config.php:220
msgid "In test mode your payments will not be sent to the bank."
msgstr "En mode test, vos paiements ne seront pas envoyé à la banque."

#: includes/paybox-config.php:222
msgid "Production"
msgstr "Production"

#: includes/paybox-config.php:223
msgid "Test"
msgstr "Test"

#: includes/paybox-config.php:228
msgid "Technical settings"
msgstr "Configuration technique"

#: includes/paybox-config.php:232
msgid "Debug"
msgstr "Debug"

#: includes/paybox-config.php:234
msgid "Enable some debugging information"
msgstr "Activer les informations de debuggage"

#: includes/paybox-encrypt.php:53 includes/paybox-encrypt.php:68
msgid ""
"For some reason, the key has just been generated. please reenter the HMAC "
"key to crypt it."
msgstr ""
"Pour une raison quelconque, la clé vient d'être générée. Entrez à nouveau la "
"clé HMAC pour qu'elle soit cryptée."

#: includes/paybox-helper.php:52
msgid "Install Required Plugins"
msgstr "Installer les Plugins requis"

#: includes/paybox-helper.php:53
msgid "Install Plugins"
msgstr "Installer les Plugins"

#: includes/paybox-helper.php:54
#, php-format
msgid "Installing Plugin: %s"
msgstr "Installation du plugin: %s"

#: includes/paybox-helper.php:55
msgid "Something went wrong."
msgstr ""

#: includes/paybox-helper.php:56
#, php-format
msgid "Paybox plugin requires the following plugin: %1$s."
msgid_plural "Paybox plugin requires the following plugins: %1$s."
msgstr[0] "Wordpress Paybox Payment plugin requiert le plugin suivant : %1$s."
msgstr[1] ""
"Wordpress Paybox Payment plugin requiert les plugins suivant : %1$s."

#: includes/paybox-helper.php:57
#, php-format
msgid "Paybox plugin recommends the following plugin: %1$s."
msgid_plural "Paybox plugin recommends the following plugins: %1$s."
msgstr[0] ""
msgstr[1] ""

#: includes/paybox-helper.php:58
#, php-format
msgid ""
"Sorry, but you do not have the correct permissions to install the %s plugin. "
"Contact the administrator of this site for help on getting the plugin "
"installed."
msgid_plural ""
"Sorry, but you do not have the correct permissions to install the %s "
"plugins. Contact the administrator of this site for help on getting the "
"plugins installed."
msgstr[0] ""
msgstr[1] ""

#: includes/paybox-helper.php:59
#, php-format
msgid "The following required plugin is currently inactive: %1$s."
msgid_plural "The following required plugins are currently inactive: %1$s."
msgstr[0] "Le plugin requis suivant est inactif : %1$s."
msgstr[1] "Les plugins requis suivant sont inactif : %1$s."

#: includes/paybox-helper.php:60
#, php-format
msgid "The following recommended plugin is currently inactive: %1$s."
msgid_plural "The following recommended plugins are currently inactive: %1$s."
msgstr[0] "Le plugin recommandé suivant est inactif : %1$s."
msgstr[1] "Les plugins recommandés suivant sont inactifs : %1$s."

#: includes/paybox-helper.php:61
#, php-format
msgid ""
"Sorry, but you do not have the correct permissions to activate the %s "
"plugin. Contact the administrator of this site for help on getting the "
"plugin activated."
msgid_plural ""
"Sorry, but you do not have the correct permissions to activate the %s "
"plugins. Contact the administrator of this site for help on getting the "
"plugins activated."
msgstr[0] ""
msgstr[1] ""

#: includes/paybox-helper.php:62
#, php-format
msgid ""
"The following plugin needs to be updated to its latest version to ensure "
"maximum compatibility with this theme: %1$s."
msgid_plural ""
"The following plugins need to be updated to their latest version to ensure "
"maximum compatibility with this theme: %1$s."
msgstr[0] ""
msgstr[1] ""

#: includes/paybox-helper.php:63
#, php-format
msgid ""
"Sorry, but you do not have the correct permissions to update the %s plugin. "
"Contact the administrator of this site for help on getting the plugin "
"updated."
msgid_plural ""
"Sorry, but you do not have the correct permissions to update the %s plugins. "
"Contact the administrator of this site for help on getting the plugins "
"updated."
msgstr[0] ""
msgstr[1] ""

