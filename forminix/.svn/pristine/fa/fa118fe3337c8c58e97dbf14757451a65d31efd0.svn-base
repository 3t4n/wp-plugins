/*------------------------------------------------------------------
Entry (Single Entry Page)
-------------------------------------------------------------------*/
#forminix_entry{
    display: none;
}




/* Header */
.forminix_entry_header{
    position: relative;
    background: #ffffff;
    padding: 0 35px;
    height: 70px;
    display: flex;
    align-items: center;
    z-index: 555;
    box-shadow: 0 4px 2px -2px #bfbdbd;
}

.forminix_entry_header .forminix_close_icon img{
    width: 15px;
    cursor: pointer;
}

.forminix_entry_header .forminix_details{
    margin: 0 0 0 35px;
}

.forminix_entry_header .forminix_details h2{
    margin: 0;
    font-size: 18px;
    color: #252F3C;
    font-weight: bold;
}
.forminix_entry_header .forminix_details p{
    margin: 3px 0 0 0;
    font-size: 13px;
    color: #6F727C;
    font-weight: 500;
}





.forminix_entry_body{
    position: relative;
    height: calc(100vh - 102px);
    padding: 0 50px;
}

.forminix_entry_body .forminix_entry_body_container{
    max-width: 1200px;
    margin: 0 auto;
    height: 100%;
    min-height: 500px;
}






/* Loader */
.forminix_entry_loader_container{
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
}
.forminix_entry_loading_bar,
.forminix_entry_loading_bar:before,
.forminix_entry_loading_bar:after {
    width: 1rem;
    height: 3rem;
    background-color: #6A6A75;
    animation: forminix_entry_loader_animation 1s ease-in-out infinite;
}
.forminix_entry_loading_bar {
    animation-delay: -.16s;
    position: relative;
    display: flex;
    align-items: center;
}
.forminix_entry_loading_bar:before {
    position: absolute;
    right: 2rem;
    content: '';
}
.forminix_entry_loading_bar:after {
    position: absolute;
    animation-delay: -.32s;
    content: '';
    left: 2rem;
}
@keyframes forminix_entry_loader_animation {
    0% {
        height: 3rem;
    }
    50% {
        height: 6rem
    }
    100% {
        height: 3rem
    }
}





/* Form Main Area */
.forminix_entry_body .forminix_entry_main_area{
    padding-top: 40px;
}


.forminix_entry_main_area_header{
    display: flex;
    align-items: center;
}
.forminix_entry_main_area_header .forminix_entry_main_area_header_details h2{
    margin: 0;
    font-size: 24px;
    color: #252F3C;
}
.forminix_entry_main_area_header .forminix_entry_main_area_header_details p{
    margin: 7px 0 0 0;
    font-size: 15px;
    color: #737577;
}

.forminix_entry_main_area_header button.forminix_entry_back_to_all{
    margin: 0 0 0 auto;
    cursor: pointer;
    background: transparent;
    color: #252F3C;
    font-weight: 500;
    font-size: 14px;
    border-radius: 4px;
    border: 1px solid #252F3C;
    padding: 9px 16px;
    display: flex;
    align-items: center;
}

.forminix_entry_main_area_header button.forminix_entry_back_to_all img{
    width: 17px;
    height: 17px;
    margin-right: 10px;
}






.forminix_entry_card_container{
    display: flex;
    column-gap: 20px;
    margin-top: 25px;
}

.forminix_entry_card_container .forminix_entry_field_and_payment_data{
    flex: 2;
}

.forminix_entry_card_container .forminix_entry_field_data{
    border: 2px solid #E3E3E3;
    border-radius: 4px;
    background: #FFFFFF;
    height: fit-content;
}
.forminix_entry_card_container .forminix_entry_field_data .forminix_entry_field_data_header{
    padding: 10px 18px;
    color: #6F727C;
    font-size: 14px;
    font-weight: 500;
    border-bottom: 2px solid #E3E3E3;
}
.forminix_entry_field_data .forminix_entry_single_field{
    padding: 15px 18px;
}
.forminix_entry_field_data .forminix_entry_single_field:not(:first-child){
    border-top: 1px solid #F3F4F5;
}
.forminix_entry_field_data .forminix_entry_single_field .forminix_entry_field_label{
    color:#252F3C;
    font-size: 14px;
    font-weight: 500;
}
.forminix_entry_field_data .forminix_entry_single_field .forminix_entry_field_value{
    color: #34383D;
    font-size: 14px;
    font-weight: 400;
}




.forminix_entry_card_container .forminix_entry_payment_data{
    margin: 20px 0 20px 0;
    border: 2px solid #E3E3E3;
    border-radius: 4px;
    background: #FFFFFF;
    height: fit-content;
}
.forminix_entry_card_container .forminix_entry_payment_data .forminix_entry_payment_data_header{
    padding: 10px 18px;
    color: #6F727C;
    font-size: 14px;
    font-weight: 500;
    border-bottom: 2px solid #E3E3E3;
}
.forminix_entry_payment_data .forminix_entry_single_field{
    padding: 15px 18px;
}
.forminix_entry_payment_data .forminix_entry_single_field:not(:first-child){
    border-top: 1px solid #F3F4F5;
}
.forminix_entry_payment_data .forminix_entry_single_field .forminix_entry_field_label{
    color:#252F3C;
    font-size: 14px;
    font-weight: 500;
}
.forminix_entry_payment_data .forminix_entry_single_field .forminix_entry_field_value{
    color: #34383D;
    font-size: 14px;
    font-weight: 400;
}



.forminix_entry_card_container .forminix_entry_submission_info{
    border: 2px solid #E3E3E3;
    border-radius: 4px;
    background: #FFFFFF;
    flex: 1;
    height: fit-content;
}


.forminix_entry_card_container .forminix_entry_submission_info .forminix_entry_submission_info_header{
    padding: 10px 18px;
    color: #6F727C;
    font-size: 14px;
    font-weight: 500;
    border-bottom: 2px solid #E3E3E3;
}

.forminix_entry_submission_info .forminix_entry_single_info{
    padding: 15px 18px;
    color: #252F3C;
    font-size: 14px;
    font-weight: 400;
}
.forminix_entry_submission_info .forminix_entry_single_info:not(:first-child){
    border-top: 1px solid #F3F4F5;
}
.forminix_entry_submission_info .forminix_entry_single_info strong{
    font-weight: 500;
}

.forminix_entry_submission_info .forminix_entry_single_info .forminix_entry_change_status{
    margin: 0 0 0 15px;
    text-decoration: underline;
    cursor: pointer;
    color: #617fa7;
    font-size: 14px;
    font-weight: 500;
    font-style: italic;
}