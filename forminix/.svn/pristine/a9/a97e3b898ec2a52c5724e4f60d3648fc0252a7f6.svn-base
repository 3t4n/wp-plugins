                    </div>
                    <button onclick="forminix_forms_create_popup_show(`<?php echo esc_url(FORMINIX_URL); ?>`)">Create Form</button>
                </div>

                <div class="forminix_forms_card_container">


                </div>

            </div>


        </div>
    </div>



</div>




