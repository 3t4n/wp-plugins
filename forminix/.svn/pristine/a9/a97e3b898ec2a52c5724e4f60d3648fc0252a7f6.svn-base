

<div id="forminix_forms">

    <div class="forminix_forms_header">
        <div class="forminix_icon">
            <img src="<?php echo esc_url(FORMINIX_IMG_DIR . "forminix_logo.svg") ?>"/>
        </div>
    </div>



    <div class="forminix_forms_body">
        <div class="forminix_forms_body_container">



            <div class="forminix_forms_empty">
                <img src="<?php echo esc_url(FORMINIX_IMG_DIR . "forms/forminix_forms_empty.svg") ?>"/>
                <h2>You don't have any forms yet!</h2>
                <p>Your forms will appear here.</p>
                <button onclick="forminix_forms_create_popup_show(`<?php echo esc_url(FORMINIX_URL); ?>`)">Create your first Form</button>
            </div>


            <div class="forminix_forms_loader_container">
                <div class="forminix_forms_loading_bar"></div>
            </div>


            <div class="forminix_forms_main_area">

                <div class="forminix_forms_main_area_header">
                    <div class="forminix_forms_main_area_header_details">
