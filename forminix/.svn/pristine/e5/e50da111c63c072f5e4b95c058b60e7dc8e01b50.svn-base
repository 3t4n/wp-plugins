/* ===================
  Email Notification
=================== */

/* Empty View */
.forminix_settings_tab_body_container .forminix_settings_email_empty{
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 350px;
}

.forminix_settings_tab_body_container .forminix_settings_email_empty img{
    width: 180px;
}
.forminix_settings_tab_body_container .forminix_settings_email_empty h2{
    margin: 23px 0 0 0;
    font-size: 20px;
    color: #252F3C;
}
.forminix_settings_tab_body_container .forminix_settings_email_empty p{
    margin: 12px 0 0 0;
    font-size: 15px;
    color: #737577;
}

.forminix_settings_tab_body_container .forminix_settings_email_empty button{
    margin: 13px 0 0 0;
    cursor: pointer;
    background: #252F3C;
    color: #FFFFFF;
    border-radius: 4px;
    border: 0;
    padding: 9px 6px;
    width: 208px;
}
.forminix_settings_tab_body_container .forminix_settings_email_empty button:hover{
    background: #090808;
}



/* Main Area */
.forminix_settings_tab_body_container .forminix_settings_email_main_area{
    padding-top: 40px;
}
.forminix_settings_email_main_area_header{
    display: flex;
    align-items: center;
    margin: 0 0 48px 0;
}
.forminix_settings_email_main_area_header .forminix_settings_email_main_area_header_details h2{
    margin: 0;
    font-size: 20px;
    color: #252F3C;
}
.forminix_settings_email_main_area_header .forminix_settings_email_main_area_header_details p{
    margin: 7px 0 0 0;
    font-size: 15px;
    color: #737577;
}
.forminix_settings_email_main_area_header button{
    margin: 0 0 0 auto;
    cursor: pointer;
    background: #252F3C;
    color: #FFFFFF;
    border-radius: 4px;
    border: 0;
    padding: 9px 6px;
    width: 140px;
}
.forminix_settings_email_main_area_header button:hover{
    background: #090808;
}




.forminix_settings_email_single_item{
    padding: 23px 27px;
    border-radius: 8px;
    margin-bottom: 30px;
    border: 1px solid #e0e0e0;
}

.forminix_settings_email_single_item .forminix_settings_single_form_element_column_container{
    column-gap: 20px;
}

.forminix_settings_email_single_item .forminix_settings_email_single_item_intro{
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.forminix_settings_email_single_item.forminix_settings_email_single_item_maximized .forminix_settings_email_single_item_intro{
    margin-bottom: 10px;
}

.forminix_settings_email_single_item .forminix_settings_email_single_item_intro h2{
    display: inline-block;
    cursor: pointer;
    color: #17161F;
    font-size: 20px;
    line-height: 20px;
    margin: 0;
    border: 0;
    outline: 0px solid transparent;
    background: url(../img/settings/forminix_settings_email_title_editor.svg) no-repeat;
    background-size: 19px;
    background-position-y: top;
    padding-left: 29px;
}
.forminix_settings_email_single_item .forminix_settings_email_single_item_intro h2:focus{
    cursor: text;
}
.forminix_settings_email_single_item .forminix_settings_email_single_item_intro .forminix_settings_email_single_item_actions{
    display: flex;
    align-items: center;
}

.forminix_settings_email_single_item_actions button.forminix_settings_email_single_item_minimize{
    margin: 0 10px 0 0;
    cursor: pointer;
    -webkit-appearance: none;
    -moz-appearance: none;
    background: transparent url(../img/settings/forminix_settings_email_minimize.svg) no-repeat;
    background-size: 18px;
    background-position-x: center;
    background-position-y: center;
    border: 0;
    padding: 15px 23px;
}
.forminix_settings_email_single_item_actions button.forminix_settings_email_single_item_maximize{
    margin: 0 10px 0 0;
    cursor: pointer;
    -webkit-appearance: none;
    -moz-appearance: none;
    background: transparent url(../img/settings/forminix_settings_email_maximize.svg) no-repeat;
    background-size: 18px;
    background-position-x: center;
    background-position-y: center;
    border: 0;
    padding: 15px 23px;
}

.forminix_settings_email_single_item_actions button.forminix_settings_email_single_item_delete{
    margin: 0;
    cursor: pointer;
    -webkit-appearance: none;
    -moz-appearance: none;
    background: transparent url(../img/settings/forminix_settings_delete_red_icon.svg) no-repeat;
    background-size: 12px;
    background-position-x: 13px;
    background-position-y: center;
    color: #f33;
    border: 1px solid #f33;
    border-radius: 14px;
    font-weight: 500;
    line-height: 12px;
    letter-spacing: 1px;
    padding: 6px 15px 6px 36px;
    font-size: 12px;
}

.forminix_settings_email_single_item.forminix_settings_email_single_item_maximized button.forminix_settings_email_single_item_maximize{
    display: none;
}
.forminix_settings_email_single_item.forminix_settings_email_single_item_maximized button.forminix_settings_email_single_item_minimize{
    display: block;
}
.forminix_settings_email_single_item:not(.forminix_settings_email_single_item_maximized) button.forminix_settings_email_single_item_maximize{
    display: block;
}
.forminix_settings_email_single_item:not(.forminix_settings_email_single_item_maximized) button.forminix_settings_email_single_item_minimize{
    display: none;
}
.forminix_settings_email_single_item.forminix_settings_email_single_item_maximized .forminix_settings_email_single_item_content{
    display: block;
}
.forminix_settings_email_single_item:not(.forminix_settings_email_single_item_maximized) .forminix_settings_email_single_item_content{
    display: none;
}










.forminix_settings_email_conditional_logic .forminix_settings_email_conditional_logic_item {
    display: flex;
    column-gap: 10px;
    align-items: end;
}

.forminix_settings_email_conditional_logic_item .forminix_settings_email_conditional_logic_item_part_0,
.forminix_settings_email_conditional_logic_item .forminix_settings_email_conditional_logic_item_part_1,
.forminix_settings_email_conditional_logic_item .forminix_settings_email_conditional_logic_item_part_2,
.forminix_settings_email_conditional_logic_item .forminix_settings_email_conditional_logic_item_part_3,
.forminix_settings_email_conditional_logic_item .forminix_settings_email_conditional_logic_item_part_4{
    flex: 1;
}
.forminix_settings_email_conditional_logic_item .forminix_settings_email_conditional_logic_item_part_4 {
    max-width: fit-content;
}


.forminix_settings_email_conditional_logic_item .forminix_settings_email_conditional_logic_item_part_0 {
    max-width: 80px;
}
.forminix_settings_email_conditional_logic_item .forminix_settings_email_conditional_logic_item_part_2 {
    max-width: 200px;
    min-width: 200px;
}
.forminix_settings_email_conditional_logic_item .forminix_settings_email_conditional_logic_item_part_3 {
    max-width: 260px;
    min-width: 260px;
}
.forminix_settings_email_conditional_logic_item button.add_rule {
    box-sizing: border-box;
    display: block;
    width: 40px;
    height: 37px;
    border: 1px solid #E4E4E6;
    outline: none;
    box-shadow: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    background: #f6f8fa url(../img/settings/forminix_settings_add_icon.svg) no-repeat;
    background-size: 13px;
    background-position-x: center;
    background-position-y: center;
}
.forminix_settings_email_conditional_logic_item button.remove_rule {
    box-sizing: border-box;
    display: block;
    width: 40px;
    height: 37px;
    border: 1px solid #E4E4E6;
    outline: none;
    box-shadow: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    background: #f6f8fa url(../img/settings/forminix_settings_delete_red_icon.svg) no-repeat;
    background-size: 13px;
    background-position-x: center;
    background-position-y: center;
}