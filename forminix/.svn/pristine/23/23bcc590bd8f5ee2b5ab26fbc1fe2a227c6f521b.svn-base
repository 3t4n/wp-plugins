/*------------------------------------------------------------------
Module Manager Page
-------------------------------------------------------------------*/

/* Header */
.forminix_modules_header{
    position: relative;
    background: #ffffff;
    padding: 0 35px;
    height: 70px;
    display: flex;
    align-items: center;
    z-index: 555;
    box-shadow: 0 4px 2px -2px #bfbdbd;
}

.forminix_modules_header .forminix_icon img{
    width: 180px;
    cursor: pointer;
}





.forminix_modules_body{
    position: relative;
    height: calc(100vh - 102px);
    padding: 0 50px;
}

.forminix_modules_body .forminix_modules_body_container{
    max-width: 1100px;
    margin: 0 auto;
    height: 100%;
    min-height: 500px;
}


/* Main Area */
.forminix_modules_body .forminix_modules_main_area{
    padding-top: 40px;
}

.forminix_modules_main_area_header{
    display: flex;
    align-items: center;
}
.forminix_modules_main_area_header .forminix_modules_main_area_header_details h2{
    margin: 0;
    font-size: 24px;
    color: #252F3C;
}
.forminix_modules_main_area_header .forminix_modules_main_area_header_details p{
    margin: 7px 0 0 0;
    font-size: 15px;
    color: #737577;
}




/* Module Card */

.forminix_modules_body .forminix_modules_card_container{
    padding: 25px 0 25px 0;
    display: grid;
    grid-template-columns: auto auto auto;
    column-gap: 7px;
    row-gap: 7px;
    justify-content: left;
}
.forminix_modules_body .forminix_modules_card{
    border: 1px solid #e2e2ef;
    border-radius: 6px;
    width: 357px;
}

.forminix_modules_body .forminix_modules_card .forminix_modules_card_header{
    background: #ffffff;
    border-bottom: 1px solid #e8e8ff;
    border-radius: 6px 6px 0 0;
    padding: 8px 20px;
    text-align: center;
}
.forminix_modules_body .forminix_modules_card .forminix_modules_card_header h3{
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    color: #252F3C;
}


.forminix_modules_body .forminix_modules_card .forminix_modules_card_body{
    background: #FFFFFF;
    border-radius: 0;
    padding: 30px 20px;
}

.forminix_modules_body .forminix_modules_card .forminix_modules_card_body .forminix_modules_card_image{
    height: 65px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.forminix_modules_body .forminix_modules_card .forminix_modules_card_body .forminix_modules_card_details{
    margin: 17px 0 0 0;
}
.forminix_modules_body .forminix_modules_card .forminix_modules_card_body .forminix_modules_card_details p{
    margin: 0 10px;
    font-size: 14px;
    color: #737577;
    text-align: center;
}

.forminix_modules_body .forminix_modules_card .forminix_modules_card_footer{
    background: #fafbff;
    border-top: 1px solid #e8e8ff;
    border-radius: 0 0 6px 6px;
    padding: 8px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}








.forminix_modules_body .forminix_modules_card .upgrade_to_pro_btn{
    text-decoration: none;
    margin: 0;
    cursor: pointer;
    color: #5A4BE7;
    border-radius: 15px;
    border: 2px solid #5A4BE7;
    padding: 3px 13px;
    text-align: center;
    font-size: 12px;
    font-weight: 500;
}
.forminix_modules_body .forminix_modules_card .upgrade_to_pro_btn:hover{
    background: #5A4BE7;
    color: #FFFFFF;
}


.forminix_modules_card_switch {
    position: relative;
    display: inline-block;
    width: 70px;
    height: 28px;
}
.forminix_modules_card_switch input {
    opacity: 0;
    width: 0;
    height: 0;
}
.forminix_modules_card_switch_slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: #dfdcfb;
    -webkit-transition: .4s;
    transition: .4s;
}
.forminix_modules_card_switch_slider:before {
    position: absolute;
    content: "";
    height: 20px;
    width: 20px;
    left: 4px;
    bottom: 4px;
    background-color: white;
    -webkit-transition: .4s;
    transition: .4s;
}
input:checked + .forminix_modules_card_switch_slider {
    background-color: #5A4BE7;
}

input:focus + .forminix_modules_card_switch_slider {
    box-shadow: 0 0 1px #5A4BE7;
}
input:checked + .forminix_modules_card_switch_slider:before {
    -webkit-transform: translateX(42px);
    -ms-transform: translateX(42px);
    transform: translateX(42px);
}

.forminix_modules_card_switch_slider.round {
    border-radius: 34px;
}
.forminix_modules_card_switch_slider.round:before {
    border-radius: 50%;
}

.forminix_modules_card_footer .forminix_modules_card_status{
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    color: #252F3C;
}