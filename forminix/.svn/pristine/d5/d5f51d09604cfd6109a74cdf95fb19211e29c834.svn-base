/* ===================
  Integrations
=================== */

/* Empty View */
.forminix_settings_tab_body_container .forminix_settings_integration_empty{
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 350px;
}

.forminix_settings_tab_body_container .forminix_settings_integration_empty img{
    width: 180px;
}
.forminix_settings_tab_body_container .forminix_settings_integration_empty h2{
    margin: 23px 0 0 0;
    font-size: 20px;
    color: #252F3C;
}
.forminix_settings_tab_body_container .forminix_settings_integration_empty p{
    margin: 12px 0 0 0;
    font-size: 15px;
    color: #737577;
}

.forminix_settings_tab_body_container .forminix_settings_integration_empty button{
    margin: 13px 0 0 0;
    cursor: pointer;
    background: #252F3C;
    color: #FFFFFF;
    border-radius: 4px;
    border: 0;
    padding: 9px 6px;
    width: 208px;
}
.forminix_settings_tab_body_container .forminix_settings_integration_empty button:hover{
    background: #090808;
}





/* Main Area */
.forminix_settings_tab_body_container .forminix_settings_integration_main_area{
    padding-top: 40px;
}
.forminix_settings_integration_main_area_header{
    display: flex;
    align-items: center;
    margin: 0 0 48px 0;
}
.forminix_settings_integration_main_area_header .forminix_settings_integration_main_area_header_details h2{
    margin: 0;
    font-size: 20px;
    color: #252F3C;
}
.forminix_settings_integration_main_area_header .forminix_settings_integration_main_area_header_details p{
    margin: 7px 0 0 0;
    font-size: 15px;
    color: #737577;
}
.forminix_settings_integration_main_area_header button{
    margin: 0 0 0 auto;
    cursor: pointer;
    background: #252F3C;
    color: #FFFFFF;
    border-radius: 4px;
    border: 0;
    padding: 9px 6px;
    width: 140px;
}
.forminix_settings_integration_main_area_header button:hover{
    background: #090808;
}













.forminix_settings_integration_single_item{
    padding: 23px 27px;
    border-radius: 8px;
    margin-bottom: 30px;
    border: 1px solid #e0e0e0;
}

.forminix_settings_integration_single_item .forminix_settings_single_form_element_column_container{
    column-gap: 20px;
}

.forminix_settings_integration_single_item .forminix_settings_integration_single_item_intro{
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.forminix_settings_integration_single_item.forminix_settings_integration_single_item_maximized .forminix_settings_integration_single_item_intro{
    margin-bottom: 10px;
}

.forminix_settings_integration_single_item .forminix_settings_integration_single_item_intro h2{
    display: inline-block;
    cursor: pointer;
    color: #17161F;
    font-size: 20px;
    line-height: 20px;
    margin: 0;
    border: 0;
    outline: 0px solid transparent;
    background: url(../img/settings/forminix_settings_integration_title_editor.svg) no-repeat;
    background-size: 19px;
    background-position-y: top;
    padding-left: 29px;
}
.forminix_settings_integration_single_item .forminix_settings_integration_single_item_intro h2:focus{
    cursor: text;
}
.forminix_settings_integration_single_item .forminix_settings_integration_single_item_intro .forminix_settings_integration_single_item_actions{
    display: flex;
    align-items: center;
}

.forminix_settings_integration_single_item_actions button.forminix_settings_integration_single_item_minimize{
    margin: 0 10px 0 0;
    cursor: pointer;
    -webkit-appearance: none;
    -moz-appearance: none;
    background: transparent url(../img/settings/forminix_settings_integration_minimize.svg) no-repeat;
    background-size: 18px;
    background-position-x: center;
    background-position-y: center;
    border: 0;
    padding: 15px 23px;
}
.forminix_settings_integration_single_item_actions button.forminix_settings_integration_single_item_maximize{
    margin: 0 10px 0 0;
    cursor: pointer;
    -webkit-appearance: none;
    -moz-appearance: none;
    background: transparent url(../img/settings/forminix_settings_integration_maximize.svg) no-repeat;
    background-size: 18px;
    background-position-x: center;
    background-position-y: center;
    border: 0;
    padding: 15px 23px;
}

.forminix_settings_integration_single_item_actions button.forminix_settings_integration_single_item_delete{
    margin: 0;
    cursor: pointer;
    -webkit-appearance: none;
    -moz-appearance: none;
    background: transparent url(../img/settings/forminix_settings_delete_red_icon.svg) no-repeat;
    background-size: 12px;
    background-position-x: 13px;
    background-position-y: center;
    color: #f33;
    border: 1px solid #f33;
    border-radius: 14px;
    font-weight: 500;
    line-height: 12px;
    letter-spacing: 1px;
    padding: 6px 15px 6px 36px;
    font-size: 12px;
}

.forminix_settings_integration_single_item.forminix_settings_integration_single_item_maximized button.forminix_settings_integration_single_item_maximize{
    display: none;
}
.forminix_settings_integration_single_item.forminix_settings_integration_single_item_maximized button.forminix_settings_integration_single_item_minimize{
    display: block;
}
.forminix_settings_integration_single_item:not(.forminix_settings_integration_single_item_maximized) button.forminix_settings_integration_single_item_maximize{
    display: block;
}
.forminix_settings_integration_single_item:not(.forminix_settings_integration_single_item_maximized) button.forminix_settings_integration_single_item_minimize{
    display: none;
}
.forminix_settings_integration_single_item.forminix_settings_integration_single_item_maximized .forminix_settings_integration_single_item_content{
    display: block;
}
.forminix_settings_integration_single_item:not(.forminix_settings_integration_single_item_maximized) .forminix_settings_integration_single_item_content{
    display: none;
}


.forminix_settings_integration_single_item_content .forminix_settings_integration_sub_section_container{
    background: #e7f1fd1c;
    margin: 15px 0 0 0;
    padding: 20px;
    border: 1px solid #bed4ed;
    border-radius: 10px;
}
.forminix_settings_integration_single_item_content .forminix_settings_integration_sub_section_container span.section_title{
    display: block;
    color: #17161F;
    font-weight: 600;
    font-size: 18px;
    margin: 0 0 25px 0;
}














/* Integrations Popup Design */
.forminix_settings_integration_popup_container {
    position: fixed;
    z-index: 10500;
    top: 0;
    right: 0;
    left: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    height: 100vh;
}
.forminix_settings_integration_popup_container .forminix_settings_integration_popup_dark_bg {
    background: #252F3C;
    opacity: 0.5;
    top: 0;
    right: 0;
    left: 0;
    bottom: 0;
    position: absolute;
}
.forminix_settings_integration_popup_container .forminix_settings_integration_popup {
    background: #ffffff;
    border-radius: 15px;
    padding: 20px;
    width: 457px;
    position: relative;
}
.forminix_settings_integration_popup .forminix_settings_integration_popup_header{
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.forminix_settings_integration_popup .forminix_settings_integration_popup_header h3{
    margin: 0;
    font-size: 18px;
    color: #252F3C;
    font-weight: bold;
}



.forminix_settings_integration_popup .forminix_settings_integration_popup_header .forminix_settings_integration_popup_header_action{
    display: flex;
    align-items: center;
}

.forminix_settings_integration_popup .forminix_settings_integration_popup_header_action .open_module_manager{
    margin: 0 20px 0 0;
    text-decoration: none;
    color: #2271b1;
    font-size: 14px;
    font-weight: 600;
}

.forminix_settings_integration_popup .forminix_settings_integration_popup_header_action span.close_icon{
    width: 25px;
    height: 25px;
    display: block;
    cursor: pointer;
    background: url(../img/settings/forminix_settings_integration_popup_close.svg) no-repeat;
    background-size: 25px;
    background-position: center;
}

.forminix_settings_integration_popup .forminix_settings_integration_popup_items{
    margin-top: 15px;
    max-height: 500px;
    overflow-y: scroll;
    background: #f6f6fd;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    -moz-box-shadow:    inset 0 0 5px #e0e0e0;
    -webkit-box-shadow: inset 0 0 5px #e0e0e0;
    box-shadow: inset 0 0 5px #e0e0e0;
}
.forminix_settings_integration_popup .forminix_settings_integration_popup_items::-webkit-scrollbar {
    width: 10px;
}
.forminix_settings_integration_popup .forminix_settings_integration_popup_items::-webkit-scrollbar-thumb {
    background: #7a7d80;
    border-radius: 8px;
}
.forminix_settings_integration_popup .forminix_settings_integration_popup_items::-webkit-scrollbar-thumb:hover {
    background: #7a7d80;
}




.forminix_settings_integration_popup_items .forminix_settings_integration_popup_item_empty{
    margin: 0;
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 500;
    color: #465262;
    text-align: center;
}



.forminix_settings_integration_popup_items .forminix_settings_integration_popup_item{
    cursor: pointer;
    padding: 20px;
    display: flex;
    justify-content: start;
    align-items: center;
    background: #ffffff;
    margin: 10px;
    border-radius: 4px;
}
.forminix_settings_integration_popup_items .forminix_settings_integration_popup_item:hover{
    -moz-box-shadow:    0 0 5px #e0e0e0;
    -webkit-box-shadow: 0 0 5px #e0e0e0;
    box-shadow: 0 0 5px #e0e0e0;
}
.forminix_settings_integration_popup_items .forminix_settings_integration_popup_item span{
    display: inline-block;
    margin: 0;
    font-size: 13px;
    color: #252F3C;
    font-weight: 500;
}









/* ==============================
 Integration Conditional Logic
================================ */


.forminix_settings_integration_conditional_logic .forminix_settings_integration_conditional_logic_item {
    display: flex;
    column-gap: 10px;
    align-items: end;
}

.forminix_settings_integration_conditional_logic_item .forminix_settings_integration_conditional_logic_item_part_0,
.forminix_settings_integration_conditional_logic_item .forminix_settings_integration_conditional_logic_item_part_1,
.forminix_settings_integration_conditional_logic_item .forminix_settings_integration_conditional_logic_item_part_2,
.forminix_settings_integration_conditional_logic_item .forminix_settings_integration_conditional_logic_item_part_3,
.forminix_settings_integration_conditional_logic_item .forminix_settings_integration_conditional_logic_item_part_4{
    flex: 1;
}
.forminix_settings_integration_conditional_logic_item .forminix_settings_integration_conditional_logic_item_part_4 {
    max-width: fit-content;
}


.forminix_settings_integration_conditional_logic_item .forminix_settings_integration_conditional_logic_item_part_0 {
    max-width: 80px;
}
.forminix_settings_integration_conditional_logic_item .forminix_settings_integration_conditional_logic_item_part_2 {
    max-width: 200px;
    min-width: 200px;
}
.forminix_settings_integration_conditional_logic_item .forminix_settings_integration_conditional_logic_item_part_3 {
    max-width: 260px;
    min-width: 260px;
}
.forminix_settings_integration_conditional_logic_item button.add_rule {
    box-sizing: border-box;
    display: block;
    width: 40px;
    height: 37px;
    border: 1px solid #E4E4E6;
    outline: none;
    box-shadow: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    background: #f6f8fa url(../img/settings/forminix_settings_add_icon.svg) no-repeat;
    background-size: 13px;
    background-position-x: center;
    background-position-y: center;
}
.forminix_settings_integration_conditional_logic_item button.remove_rule {
    box-sizing: border-box;
    display: block;
    width: 40px;
    height: 37px;
    border: 1px solid #E4E4E6;
    outline: none;
    box-shadow: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    background: #f6f8fa url(../img/settings/forminix_settings_delete_red_icon.svg) no-repeat;
    background-size: 13px;
    background-position-x: center;
    background-position-y: center;
}








/* ==============================
 User Registration Integration
================================ */
.forminix_settings_integration_user_meta_column_container_all_end{
    align-items: end;
}
.forminix_settings_integration_user_meta_remove_btn{
    box-sizing: border-box;
    display: block;
    width: 40px;
    height: 37px;
    border: 1px solid #E4E4E6;
    outline: none;
    box-shadow: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    background: #f6f8fa url(../img/settings/forminix_settings_delete_red_icon.svg) no-repeat;
    background-size: 13px;
    background-position-x: center;
    background-position-y: center;
}

.forminix_settings_integration_user_meta_add_new_btn{
    margin: 0 0 0 auto;
    cursor: pointer;
    background: #252F3C;
    color: #FFFFFF;
    border-radius: 4px;
    border: 0;
    padding: 9px 6px;
    width: 140px;
}
.forminix_settings_integration_user_meta_add_new_btn:hover{
    background: #090808;
}





/* ==============================
 PayPal Integration
================================ */

.forminix_paypal_conditional_amount_container button.add_new_item{
    margin: 17px 0 0 auto;
    cursor: pointer;
    background: transparent;
    color: #000000;
    font-weight: 500;
    font-size: 12px;
    border-radius: 4px;
    border: 1px solid #252F3C;
    padding: 6px 10px;
    display: flex;
    align-items: center;
}
.forminix_settings_integration_paypal_conditional_amount_item {
    display: flex;
    column-gap: 10px;
    align-items: end;
}
.forminix_settings_integration_paypal_conditional_amount_item .forminix_settings_integration_paypal_conditional_amount_item_part_0,
.forminix_settings_integration_paypal_conditional_amount_item .forminix_settings_integration_paypal_conditional_amount_item_part_1,
.forminix_settings_integration_paypal_conditional_amount_item .forminix_settings_integration_paypal_conditional_amount_item_part_2,
.forminix_settings_integration_paypal_conditional_amount_item .forminix_settings_integration_paypal_conditional_amount_item_part_3,
.forminix_settings_integration_paypal_conditional_amount_item .forminix_settings_integration_paypal_conditional_amount_item_part_4,
.forminix_settings_integration_paypal_conditional_amount_item .forminix_settings_integration_paypal_conditional_amount_item_part_5{
    flex: 1;
}
.forminix_settings_integration_paypal_conditional_amount_item .forminix_settings_integration_paypal_conditional_amount_item_part_1,
.forminix_settings_integration_paypal_conditional_amount_item .forminix_settings_integration_paypal_conditional_amount_item_part_5{
    max-width: fit-content;
    min-width: 40px;
}
.forminix_settings_integration_paypal_conditional_amount_item .forminix_settings_integration_paypal_conditional_amount_item_part_1{
    margin: 0 40px 0 0;
}
.forminix_settings_integration_paypal_conditional_amount_item .forminix_settings_integration_paypal_conditional_amount_item_part_2{
    max-width: 145px;
    min-width: 145px;
}
.forminix_settings_integration_paypal_conditional_amount_item .forminix_settings_integration_paypal_conditional_amount_item_part_3{
    max-width: 155px;
    min-width: 155px;
}
.forminix_settings_integration_paypal_conditional_amount_item .forminix_settings_integration_paypal_conditional_amount_item_part_4{
    max-width: 145px;
    min-width: 145px;
}
.forminix_settings_integration_paypal_conditional_amount_item button.add_rule {
    box-sizing: border-box;
    display: block;
    width: 40px;
    height: 37px;
    border: 1px solid #E4E4E6;
    outline: none;
    box-shadow: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    background: #f6f8fa url(../img/settings/forminix_settings_add_icon.svg) no-repeat;
    background-size: 13px;
    background-position-x: center;
    background-position-y: center;
}
.forminix_settings_integration_paypal_conditional_amount_item button.remove_rule {
    box-sizing: border-box;
    display: block;
    width: 40px;
    height: 37px;
    border: 1px solid #E4E4E6;
    outline: none;
    box-shadow: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    background: #f6f8fa url(../img/settings/forminix_settings_delete_red_icon.svg) no-repeat;
    background-size: 13px;
    background-position-x: center;
    background-position-y: center;
}