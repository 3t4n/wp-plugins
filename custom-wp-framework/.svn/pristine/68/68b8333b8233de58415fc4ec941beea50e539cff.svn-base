<?php

namespace Custom_WP_Framework\Includes;

// Exit if accessed directly.
if ( ! defined ( 'ABSPATH' ) ) { 
	exit(); 
} 

// Load required classes.
use Custom_WP_Framework\Admin;
use Custom_WP_Framework\Includes\Helpers\CWF_Utils;

/**
 * The main plugin class.
 * 
 * Load dependencies and main hooks/filters for the plugin.
 * 
 * @since	1.0.0
 */
class CWF_Plugin {

	/**
	 * The main admin class for the plugin.
	 * 
	 * @since 	1.0.0
	 * @var		CWF_Admin		$plugin_admin
	 */
	public $plugin_admin;

	/**
	 * The main init class for the plugin.
	 * 
	 * @since 	1.0.0
	 * @var		CWF_Init		$plugin_init
	 */
	public $plugin_init;

	/**
	 * Default constructor for the main plugin class.
	 * 
	 * @since	1.0.0
	 * @param	void
	 * @return	void
	 */
	public function __construct() {

		/**
		 * Create new instance of Custom_WP_Framework_Admin.
		 */
		$this->plugin_admin = new Admin\CWF_Admin();

		/**
		 * Create new instance of Custom_WP_Framework_Init.
		 */ 
		$this->plugin_init = new Core\Components\CWF_Init();

		/**
		 * Load main hooks for the plugin.
		 */ 
		$this->load_hooks();

		/**
		 * Load main filters for the plugin.
		 */
		$this->load_filters(); 
	}

	/**
	 * Load main hooks for the plugin.
	 * 
	 * @since	1.00
	 * @param	void
	 * @return	void
	 */
	private function load_hooks() {

		/**
		 * Register custom post types on init.
		 * 
		 * @since	1.0.0
		 */
		add_action( 'init', array( $this->plugin_init, 'cwf_register_custom_post_types' ), 10 );
		
		/**
		 * Flush rewrite rules if any changes to post types or taxonomies.
		 * 
		 * @since 	1.0.0
		 */
		add_action( 'init', array( $this->plugin_init, 'cwf_flush_rewrite_rules' ), 15 );
		
		/**
		 * Register admin pages of plugin.
		 * 
		 * @since 	1.0.0
		 */
		add_action( 'admin_menu', array( $this->plugin_admin, 'register_admin_pages' ) );
	}

	/**
	 * Load main filters for the plugin.
	 * 
	 * @since	1.00
	 * @param	void
	 * @return	void
	 */
	private function load_filters() {
		
		/**
         * Modify footer text for CPT admin pages.
         */
        add_filter( 'admin_footer_text', array( &$this, 'cwf_footer_text' ) );

        /**
         * Remove WordPress update footer for CPT admin pages.
         */
        add_filter( 'update_footer', array( &$this, 'cwf_footer_remove_version' ), 1000 );

	}

	/**
     * Footer text for CPT admin pages.
     * 
     * @since   1.0.0
     * @param   string  $footer_text
     * @return  string  $footer_text
     */
    public function cwf_footer_text( $footer_text) {
        
        /**
         * Check if current admin page is generated by plugin.
         */
        if( CWF_Utils::is_cwf_admin() ) {

            /**
             * Set footer text to plugin credits.
             */
            $developer_url = '<a href="https://pullclicks.com">Pull Clicks</a>';
            $footer_text = __( sprintf( 'Custom WP Framework &copy; %s. Version: %s by %s', date( "Y" ), CUSTOM_WP_FRAMEWORK_VERSION, $developer_url ), CUSTOM_WP_FRAMEWORK_TEXT_DOMAIN );
        }

        return $footer_text;
    }

    /**
     * Remove footer upgrade text for CPT admin pages.
     * 
     * @since   1.0.0
     * @param   string  $footer_text
     * @return  string  $footer_text
     */
    public function cwf_footer_remove_version( $footer_text ) {

        /**
         * Check if current admin page is generated by plugin.
         */
        if( CWF_Utils::is_cwf_admin() ) {

            /**
             * Set text to empty string.
             */
            $footer_text = '';
        }

        return $footer_text;

    }
}