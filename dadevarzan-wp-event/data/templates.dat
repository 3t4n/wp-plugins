  [wpbb-if post:featured_image]
  <div class="dv-conferences-image">
	[wpbb post:featured_image size="medium" display="tag" linked="yes"]
  </div>
  [/wpbb-if]

  <div class="dv-conferences-detail">

    <h2 class="dv-conferences-title">[wpbb post:link text="title"]</h2>
    
    <div class="dv-conference-info">
        [acf-if field="cnf_status"]
        <div class="dv-conference-date dv-conference-info-item">
            <i class="dv-icon-address-card-o"></i>
            وضعیت:
            <span class="dv-conf-value dv-conf-startdate"> [acf field="cnf_status"]</span>
        </div>
        [/acf-if]
        [acf-if field="cnf_date_start"]
        <div class="dv-conference-date dv-conference-info-item">
            <i class="dv-icon-calendar"></i>
            تاریخ برگزاری :
            <span class="dv-conf-value dv-conf-startdate"> [acf field="cnf_date_start"]</span>
        </div>
        [/acf-if]
    </div>        
    <div class="dv-conferences-excerpt">
    	[wpbb post:excerpt length="55" more="..."]
    </div>
    
    <div class="dv-conferences-more-link">
    	[wpbb post:link text='custom' custom_text='اطلاعات بیشتر ...']
    </div>

  </div>
</div>";s:3:"css";s:1369:".uabb-blog-posts-shadow:hover{background-color: #f5eee5; border: 1px solid #ded9d1;}
.dv-conferences-wrapper{display:flex;flex-wrap:wrap;}
.dv-conferences-wrapper .dv-conferences-image{width:20%;}
.dv-conferences-wrapper .dv-conferences-detail{
    width:77%;
    margin-right: 2%;
    
}
.dv-conferences-wrapper .dv-conferences-detail .dv-conferences-title{font-size: 20px;font-weight:bold;}
.dv-conferences-wrapper .dv-conferences-detail .dv-conference-info{margin-top:10px;}
.dv-conferences-wrapper .dv-conferences-detail .dv-conference-info .dv-conference-info-item{padding: 10px 0;}
.dv-conferences-wrapper .dv-conferences-detail .dv-conference-info .dv-conference-info-item i{color: #ff9000;margin-left: 8px;}
.dv-conferences-wrapper .dv-conferences-detail .dv-conference-info .dv-conference-info-item .dv-conf-value{font-weight:bold;}
.dv-conferences-wrapper .dv-conferences-detail .dv-conference-info .dv-conference-info-item .dv-conf-startdate{direction:ltr;}
.dv-conferences-wrapper .dv-conferences-detail .dv-conferences-excerpt{margin-top:10px;line-height:25px;}
.dv-conferences-wrapper .dv-conferences-detail .dv-conferences-more-link{text-align:left;}

@media screen and (max-width: 768px) {
    .dv-conferences-wrapper .dv-conferences-image{width:90%;text-align:center;margin-bottom:20px;}
    .dv-conferences-wrapper .dv-conferences-detail{ width:90%;}
