#. Description of the plugin
msgid ""
"Displays multiple RSS feeds in the WordPress admin dashboard, each in its "
"own widget."
msgstr ""
"Zeigt mehrere RSS-Feeds im WordPress-Admin-Dashboard an, jeder in seinem "
"eigenen Widget."

#: includes/admin-settings.php:88
msgid "Enter the RSS feed URLs, separated by line breaks."
msgstr "Geben Sie die URLs der RSS-Feeds ein, eine Feed URL pro Zeile."

#: includes/dashboard-widgets.php:66
msgid "Error fetching feed."
msgstr "Error: Dieser Feed konnte nicht gelesen werden."

