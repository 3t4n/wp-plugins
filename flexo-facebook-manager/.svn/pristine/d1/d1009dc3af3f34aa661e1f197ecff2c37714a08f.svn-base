<!-- flexo facebook manager admin style -->
<style>
	.fb-manager h3{
		border: 1px solid #DFDFDF ;
	}
	.fb-manager ul{
		margin-top:5px;
	}
	.fb-manager ul li{
		float:left;
		display:block;
		vertical-align:middle;
		border-right:1px solid #DFDFDF;
		padding:4px 14px 4px 4px;
	}
	
	.fb-manager li input{
		display:block;
		height:14px;
		width:16px;
		float:left;
		padding-right:10px;
	}
	.verb {
		clear: both;
	}
	.fb-manager textarea{
		width:400px;
		height:35px;
		clear:left;
		margin-bottom:10px;
		font-weight:normal !important;
	}
	.clear {
		width:100%;
		height:0;
		line-height:0;
		overflow:hidden;
		clear:both;
	}
	
	a.debug-button:hover{
		color:#E7EAF2 !important;
	}


	input.submit-button,
	a.debug-button:link,
	a.debug-button:visited
	 {
		-webkit-box-shadow: rgba(0, 0, 0, 0.0976563) 0px 1px 0px 0px;
	background-attachment: scroll;
	background-clip: border-box;
	background-color: #5B74A8;
	background-image: url(http://static.ak.fbcdn.net/rsrc.php/v1/yx/r/NL9V9jlBmDa.png);
	background-origin: padding-box;
	background-position: 0px -49px;
	background-repeat: no-repeat;
	border-bottom-color: #1A356E;
	border-bottom-style: solid;
	border-bottom-width: 1px;
	border-left-color: #29447E;
	border-left-style: solid;
	border-left-width: 1px;
	border-right-color: #29447E;
	border-right-style: solid;
	border-right-width: 1px;
	border-top-color: #29447E;
	border-top-style: solid;
	border-top-width: 1px;
	color: #FFFFFF;
	cursor: pointer;
	direction: ltr;
	display: inline-block;
	font-family: 'lucida grande', tahoma, verdana, arial, sans-serif;
	font-size: 11px;
	font-weight: bold;
	height: 18px;
	line-height:18px;
	/*line-height: 20px;*/
	margin-bottom: 0px;
	margin-left: 10px;
	margin-right: 0px;
	margin-top: 0px;
	padding-bottom: 2px;
	padding-left: 6px;
	padding-right: 6px;
	padding-top: 2px;
	text-align: center;
	text-decoration: none;
	unicode-bidi: normal;
	vertical-align: top;
	white-space: nowrap;
	width: 130px;
}

input.submit-button {
	height:28px;
}
	.fb_admin .row .radio input{
		margin-top:13px;
	}
	.fb_admin .row .radio{
		border-right:1px solid #DFDFDF;
		padding: 0 10px 0 0;
		/*width:108px;*/
	}
	
	.fb_admin  {
		/*padding:10px;*/
		}
		.fb_admin input{
			margin:10px;
		}
		
		.fb_admin  .layout {
			height:46px;
			width: 46px;
			background-repeat:no-repeat;
		}
		.fb_admin  .top {
			background:url('<?php echo $url = plugins_url( 'layout-2.png' , __FILE__ ); ?>');
		}
		.fb_admin  .bottom {
			background:url('<?php echo $url = plugins_url( 'layout-1.png' , __FILE__ ); ?>');
		}
		
		.fb_admin .left{
			float:left;
		}
		
		.fb_admin .clear{
			width:100%;
			clear:both;
		}
		.fb_admin .row input,
		.fb_admin .row div{
			float:left;
		}
		
		.fb_admin .row{
			clear:right;
			border-bottom:1px solid #DFDFDF;
			height:40px;
			line-height:40px;
			display:block;
			overflow:hidden;
			margin-top:1px;
		}
		
		.fb_admin .row .title{
			background:#F0F0F0;
			width:200px;
			text-align:right;
			padding:0 10px;
		}
		
		.fb_admin .row .desc{
			float:right !important;
			vertical-align:bottom;
			padding-top:7px;
		}	
		
		/* weight */
		.second-title {
			margin-top: 10px;
			margin-bottom: 8px;
			font-size: 11px;
			font-weight: bold;
		}
		.FB-weight {
			font-size:11px;
		}
		.FB-weight .widget-top{
			margin-top:10px;
			margin-bottom:10px;
			cursor:auto;
			
		}
		.widget-title{
			float: left;
		}
		.w-a{
			background-image:url('<?php echo $url = plugins_url( 'arrows.png' , __FILE__ ); ?>');
			background-repeat:no-repeat;
			width:15px;
			height:15px;
			float: right;
			top: 5px;
			position: relative;
			cursor:pointer;
		}
		.togg1,.togg2,.togg3,.togg4,.togg5{
			display:none;
		}
</style>