.wagon-card-background{
	margin: auto;
    width: 90%;
    margin-top: 50px;
    padding: 30px;
    background-color: #fff;
    box-shadow: 0 0 20px 2px #00000017;
}
.wagon-card-background form input{
	width: 50%;
	margin-bottom: 20px;
	border-radius: 0px;
	font-size: 1.2em;
	padding: 3px 10px;
}
.wagon-card-background form select{
    display: block !important;
    width: 50%;
    margin-bottom: 20px;
    border-radius: 0px;
    font-size: 1.2em;
    padding: 3px 10px;
    max-width: 100% !important;
}
.wagon-submit-btn{
	clear: both;
    display: block;
    width: 150px !important;
    border: 0px;
    box-shadow: 0 0 20px 2px #00000021;
    background-color: #093050;
    color: #fff;
    font-size: 1.4em !important;
    cursor: pointer;
    padding: 10px 10px !important;
}
.wagon-submit-btn:hover{
	background-color: #031b2f;
}
.select2-container--default .select2-selection--single{
    border: 1px solid #949494 !important;
    border-radius: 0px !important;
    height: auto !important;
    padding: 3px;
    font-size: 1.2em;
}
input[name='wagon_pickup_street']{
    margin-top: 20px !important;
}