function tsptCreateFeature(tsptId) {
	let tsptFeaturesCount = parseInt(parseInt(jQuery('#TS_PTable_FCount_' + tsptId).val()) + 1),
		tsptIconsSelect = jQuery('#Total_Soft_PTable_Select_Icon').html();
	jQuery('#Total_Soft_PTable_Features_' + tsptId).append('<tr class="Total_Soft_PTable_Features_None"><td><select class="Total_Soft_PTable_Select TS_PTable_FIcon_' + tsptFeaturesCount + '" style="font-family: FontAwesome, Arial;" id="TS_PTable_FIcon_' + tsptId + '_' + tsptFeaturesCount + '" name="TS_PTable_FIcon_' + tsptId + '_' + tsptFeaturesCount + '">' + tsptIconsSelect + '</select><span class="TS_PTable_FChecked TS_PTable_FChecked_' + tsptFeaturesCount + '"><input type="checkbox" id="TS_PTable_FChecked_' + tsptId + '_' + tsptFeaturesCount + '" name="TS_PTable_FChecked_' + tsptId + '_' + tsptFeaturesCount + '" value="' + tsptFeaturesCount + '"><label class="totalsoft totalsoft-question-circle-o" for="TS_PTable_FChecked_' + tsptId + '_' + tsptFeaturesCount + '"></label></span></td><td><input type="text" class="Total_Soft_PTable_Select TS_PTable_FText_' + tsptFeaturesCount + '" id="TS_PTable_FText_' + tsptId + '_' + tsptFeaturesCount + '" name="TS_PTable_FText_' + tsptId + '_' + tsptFeaturesCount + '" value=""><i class="totalsoft totalsoft-times TS_PTable_FDI TS_PTable_FDI_' + tsptFeaturesCount + '" title="Delete Feature" onclick="tsptDeleteFeature(' + tsptId + ', ' + tsptFeaturesCount + ')"></i></td></tr>');
	jQuery('#TS_PTable_FCount_' + tsptId).val(tsptFeaturesCount);
	jQuery('.Total_Soft_PTable_Features_None').animate({ opacity: "1" }, 500);
}
function tsptCloneTable(tsptId) {
	jQuery.ajax({
		type: 'POST',
		url: tspt_editor_object.ajaxurl,
		data: {
			action: 'tspt_clone',
			tspt_nonce: tspt_editor_object.tspt_nonce,
			tspt_id: tsptId
		},
		beforeSend: function () {
			jQuery('.Total_Soft_PTable_Loading').css('display', 'block');
		},
		success: function (response) {
			if (response.success) {
				location.reload();
			} else {
				console.error('TS Pricing Table - AJAX Error.');
			}
		},
		fail: function (response) {
			console.error('TS Pricing Table - AJAX Error.', response);
		}
	});
}
function tsptEditTable(tsptId) {
	jQuery('#Total_SoftPTable_Update').val(tsptId);
	jQuery.ajax({
		type: 'POST',
		url: tspt_editor_object.ajaxurl,
		data: {
			action: 'tspt_edit',
			tspt_nonce: tspt_editor_object.tspt_nonce,
			tspt_id: tsptId
		},
		beforeSend: function () {
			jQuery('.Total_Soft_PTable_Loading').css('display', 'block');
		},
		success: function (response) {
			if (response.success) {
				// Manager
				jQuery('#Total_Soft_PTable_Title').val(response['data']['manager']['Total_Soft_PTable_Title']);
				jQuery('#Total_Soft_PTable_Them').val(response['data']['manager']['Total_Soft_PTable_Them']);
				jQuery('#Total_Soft_PTable_M_01').val(response['data']['manager']['Total_Soft_PTable_M_01']);
				jQuery('#Total_Soft_PTable_M_02').val(response['data']['manager']['Total_Soft_PTable_M_02']);
				tsptThemeOptions();
				tsptThemeImage();
				tsptUpdateOutput();
				// Columns
				if (response['data']['cols'].length) {
					response['data']['cols'].forEach((tsptCol, tsptIndex) => {
						tsptNewColumn();
						setTimeout(function () {
							let tsptRow = parseInt(tsptIndex) + 1,
								TS_PTable_FIcon = tsptCol['TS_PTable_FIcon'].split('TSPTFI'),
								TS_PTable_FText = tsptCol['TS_PTable_FText'].split('TSPTFT'),
								TS_PTable_FCheck = tsptCol['TS_PTable_C_01'].split('TSPTFC');
							jQuery('#TS_PTable_TSetting_' + tsptRow).val(tsptCol['TS_PTable_TSetting']);
							jQuery('#TS_PTable_TText_' + tsptRow).val(tsptCol['TS_PTable_TText']);
							jQuery('#TS_PTable_TIcon_' + tsptRow).val(tsptCol['TS_PTable_TIcon']);
							jQuery('#TS_PTable_PCur_' + tsptRow).val(tsptCol['TS_PTable_PCur']);
							jQuery('#TS_PTable_PVal_' + tsptRow).val(tsptCol['TS_PTable_PVal']);
							jQuery('#TS_PTable_PPlan_' + tsptRow).val(tsptCol['TS_PTable_PPlan']);
							jQuery('#TS_PTable_BText_' + tsptRow).val(tsptCol['TS_PTable_BText']);
							jQuery('#TS_PTable_BIcon_' + tsptRow).val(tsptCol['TS_PTable_BIcon']);
							jQuery('#TS_PTable_BLink_' + tsptRow).val(tsptCol['TS_PTable_BLink']);
							for (j = 1; j <= parseInt(tsptCol['TS_PTable_FCount']); j++) {
								tsptCreateFeature(tsptRow);
							}
							for (k = 1; k <= parseInt(tsptCol['TS_PTable_FCount']); k++) {
								jQuery('#TS_PTable_FIcon_' + tsptRow + '_' + k).val(TS_PTable_FIcon[k - 1]);
								jQuery('#TS_PTable_FText_' + tsptRow + '_' + k).val(TS_PTable_FText[k - 1]);
								if (jQuery('#TS_PTable_FChecked_' + tsptRow + '_' + k).val() == TS_PTable_FCheck[k - 1]) {
									jQuery('#TS_PTable_FChecked_' + tsptRow + '_' + k).attr('checked', 'checked');
								}
							}
						}, 500);
					});
				}
				// Editor
				jQuery('.Total_Soft_PTable_AMD2').animate({ 'opacity': 0 }, 500);
				jQuery('.Total_Soft_PTable_AMMTable').animate({ 'opacity': 0 }, 500);
				jQuery('.Total_Soft_PTable_AMOTable').animate({ 'opacity': 0 }, 500);
				jQuery('.Total_Soft_PTable_Save').animate({ 'opacity': 0 }, 500);
				jQuery('.Total_Soft_PTable_Update').animate({ 'opacity': 1 }, 500);
				jQuery('#Total_Soft_PTable_ID').html('[Total_Soft_Pricing_Table id="' + tsptId + '"]');
				jQuery('#Total_Soft_PTable_TID').html('&lt;?php echo do_shortcode(&#039;[Total_Soft_Pricing_Table id="' + tsptId + '"]&#039;);?&gt');
				setTimeout(function () {
					jQuery('.Total_Soft_PTable_AMD2').css('display', 'none');
					jQuery('.Total_Soft_PTable_AMMTable').css('display', 'none');
					jQuery('.Total_Soft_PTable_AMOTable').css('display', 'none');
					jQuery('.Total_Soft_PTable_Save').css('display', 'none');
					jQuery('.Total_Soft_PTable_Update').css('display', 'block');
					jQuery('.Total_Soft_PTable_AMD3').css('display', 'block');
					jQuery('.Total_Soft_PTable_AMMain_Div').css('display', 'block');
				}, 500)
				setTimeout(function () {
					jQuery('.Total_Soft_PTable_AMD3').animate({ 'opacity': 1 }, 500);
					jQuery('.Total_Soft_PTable_AMMain_Div').animate({ 'opacity': 1 }, 500);
					jQuery('.Total_Soft_PTable_Loading').css('display', 'none');
				}, 500)
			} else {
				console.error('TS Pricing Table - AJAX Error.');
			}
		},
		fail: function (response) {
			console.error('TS Pricing Table - AJAX Error.', response);
		}
	});
}
function tsptDeleteTable(tsptId) {
	jQuery('#Total_Soft_PTable_AMOTable_tr_' + tsptId).find('.Total_Soft_PTable_Del_Span').addClass('Total_Soft_PTable_Del_Span1');
}
function tsptDelete(tsptId) {
	jQuery.ajax({
		type: 'POST',
		url: tspt_editor_object.ajaxurl,
		data: {
			action: 'tspt_delete',
			tspt_nonce: tspt_editor_object.tspt_nonce,
			tspt_id: tsptId
		},
		beforeSend: function () {
			jQuery('.Total_Soft_PTable_Loading').css('display', 'block');
		},
		success: function (response) {
			if (response.success) {
				location.reload();
			} else {
				console.error('TS Pricing Table - AJAX Error.');
			}
		},
		fail: function (response) {
			console.error('TS Pricing Table - AJAX Error.', response);
		}
	});
}
function tsptCancel(tsptId) {
	jQuery('#Total_Soft_PTable_AMOTable_tr_' + tsptId).find('.Total_Soft_PTable_Del_Span').removeClass('Total_Soft_PTable_Del_Span1');
}
function tsptEditTheme(tsptThemeKey) {
	let tspt_theme_type = 'type' + tsptThemeKey;
	jQuery('#Total_Soft_PTable_Theme_Type').val(tspt_theme_type);
	jQuery.ajax({
		type: 'POST',
		url: tspt_editor_object.ajaxurl,
		data: {
			action: 'tspt_edit_theme',
			tspt_nonce: tspt_editor_object.tspt_nonce,
			tspt_type: tspt_theme_type
		},
		beforeSend: function () {
			jQuery('.Total_Soft_PTable_Loading').css('display', 'block');
		},
		success: function (response) {
			if (response.success) {
				if (response['data'].length) {
					response['data'].forEach((tsptCol, tsptIndex) => {
						tsptNewSetting('clone');
						let tsptPrefix = '',
							tsptNumber = parseInt(tsptIndex) + 1;
						jQuery('#Total_Soft_PTable_Set_Count').val(tsptNumber);
						if (tspt_theme_type == 'type1') {
							tsptPrefix = 'TS_PTable_ST1_';
							jQuery('#' + tsptPrefix + tsptNumber + '_31').val(tsptCol['TS_PTable_ST_31']);
							jQuery('#' + tsptPrefix + tsptNumber + '_32').val(tsptCol['TS_PTable_ST_32']);
							jQuery('#' + tsptPrefix + tsptNumber + '_33').val(tsptCol['TS_PTable_ST_33']);
							jQuery('#' + tsptPrefix + tsptNumber + '_34').val(tsptCol['TS_PTable_ST_34']);
						} else if (tspt_theme_type == 'type2') {
							tsptPrefix = 'TS_PTable_ST2_';
						} else if (tspt_theme_type == 'type3') {
							tsptPrefix = 'TS_PTable_ST3_';
							jQuery('#' + tsptPrefix + tsptNumber + '_31').val(tsptCol['TS_PTable_ST_31']);
							jQuery('#' + tsptPrefix + tsptNumber + '_32').val(tsptCol['TS_PTable_ST_32']);
							jQuery('#' + tsptPrefix + tsptNumber + '_33').val(tsptCol['TS_PTable_ST_33']);
							jQuery('#' + tsptPrefix + tsptNumber + '_34').val(tsptCol['TS_PTable_ST_34']);
							jQuery('#' + tsptPrefix + tsptNumber + '_35').val(tsptCol['TS_PTable_ST_35']);
							jQuery('#' + tsptPrefix + tsptNumber + '_36').val(tsptCol['TS_PTable_ST_36']);
							jQuery('#' + tsptPrefix + tsptNumber + '_37').val(tsptCol['TS_PTable_ST_37']);
						} else if (tspt_theme_type == 'type4') {
							tsptPrefix = 'TS_PTable_ST4_';
							jQuery('#' + tsptPrefix + tsptNumber + '_31').val(tsptCol['TS_PTable_ST_31']);
							jQuery('#' + tsptPrefix + tsptNumber + '_32').val(tsptCol['TS_PTable_ST_32']);
						} else if (tspt_theme_type == 'type5') {
							tsptPrefix = 'TS_PTable_ST5_';
							jQuery('#' + tsptPrefix + tsptNumber + '_31').val(tsptCol['TS_PTable_ST_31']);
							jQuery('#' + tsptPrefix + tsptNumber + '_32').val(tsptCol['TS_PTable_ST_32']);
						}
						if (tsptCol['TS_PTable_ST_02'] == 'on') { tsptCol['TS_PTable_ST_02'] = true; } else { tsptCol['TS_PTable_ST_02'] = false; }
						jQuery('#' + tsptPrefix + tsptNumber + '_ID').val(tsptCol['id']);
						jQuery('#' + tsptPrefix + tsptNumber + '_00').val(tsptCol['TS_PTable_ST_00']);
						jQuery('#' + tsptPrefix + tsptNumber + '_01').val(tsptCol['TS_PTable_ST_01']);
						jQuery('#' + tsptPrefix + tsptNumber + '_02').attr('checked', tsptCol['TS_PTable_ST_02']);
						jQuery('#' + tsptPrefix + tsptNumber + '_03').val(tsptCol['TS_PTable_ST_03']);
						jQuery('#' + tsptPrefix + tsptNumber + '_04').val(tsptCol['TS_PTable_ST_04']);
						jQuery('#' + tsptPrefix + tsptNumber + '_05').val(tsptCol['TS_PTable_ST_05']);
						jQuery('#' + tsptPrefix + tsptNumber + '_06').val(tsptCol['TS_PTable_ST_06']);
