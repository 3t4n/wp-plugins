				jQuery(this).find('.Total_Soft_PT_AMSetDiv_Content div.TS_PT_Option_Div:nth-child(3)').attr('class', 'TS_PT_Option_Div TS_PT_Option_Div_1_' + tsptSettingIdx).attr('id', 'Total_Soft_PT_AMSetTable_1_' + tsptSettingIdx + '_PO');
