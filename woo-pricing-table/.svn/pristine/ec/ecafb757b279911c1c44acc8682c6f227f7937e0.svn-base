						jQuery('#' + tsptPrefix + tsptNumber + '_11').val(tsptCol['TS_PTable_ST_11']);
						jQuery('#' + tsptPrefix + tsptNumber + '_12').val(tsptCol['TS_PTable_ST_12']);
						jQuery('#' + tsptPrefix + tsptNumber + '_13').val(tsptCol['TS_PTable_ST_13']);
						jQuery('#' + tsptPrefix + tsptNumber + '_14').val(tsptCol['TS_PTable_ST_14']);
						jQuery('#' + tsptPrefix + tsptNumber + '_15').val(tsptCol['TS_PTable_ST_15']);
						jQuery('#' + tsptPrefix + tsptNumber + '_16').val(tsptCol['TS_PTable_ST_16']);
						jQuery('#' + tsptPrefix + tsptNumber + '_17').val(tsptCol['TS_PTable_ST_17']);
						jQuery('#' + tsptPrefix + tsptNumber + '_18').val(tsptCol['TS_PTable_ST_18']);
						jQuery('#' + tsptPrefix + tsptNumber + '_19').val(tsptCol['TS_PTable_ST_19']);
						jQuery('#' + tsptPrefix + tsptNumber + '_20').val(tsptCol['TS_PTable_ST_20']);
						jQuery('#' + tsptPrefix + tsptNumber + '_21').val(tsptCol['TS_PTable_ST_21']);
						jQuery('#' + tsptPrefix + tsptNumber + '_22').val(tsptCol['TS_PTable_ST_22']);
						jQuery('#' + tsptPrefix + tsptNumber + '_23').val(tsptCol['TS_PTable_ST_23']);
						jQuery('#' + tsptPrefix + tsptNumber + '_24').val(tsptCol['TS_PTable_ST_24']);
						jQuery('#' + tsptPrefix + tsptNumber + '_25').val(tsptCol['TS_PTable_ST_25']);
						jQuery('#' + tsptPrefix + tsptNumber + '_26').val(tsptCol['TS_PTable_ST_26']);
						jQuery('#' + tsptPrefix + tsptNumber + '_27').val(tsptCol['TS_PTable_ST_27']);
						jQuery('#' + tsptPrefix + tsptNumber + '_28').val(tsptCol['TS_PTable_ST_28']);
						jQuery('#' + tsptPrefix + tsptNumber + '_29').val(tsptCol['TS_PTable_ST_29']);
						jQuery('#' + tsptPrefix + tsptNumber + '_30').val(tsptCol['TS_PTable_ST_30']);
					});
					jQuery('.Total_Soft_PTable_TMMain_Div_But1').animate({ opacity: "1" }, 500);
				}
				jQuery('.TS_PTable_Color').alphaColorPicker();
				jQuery('.wp-picker-holder').addClass('alpha-picker-holder');
				tsptUpdateOutput();
				jQuery('.Total_Soft_PTable_TMMTable').animate({ 'opacity': 0 }, 500);
				jQuery('.Total_Soft_PTable_TMOTable').animate({ 'opacity': 0 }, 500);
				setTimeout(function () {
					jQuery('.Total_Soft_PTable_TMMTable').css('display', 'none');
					jQuery('.Total_Soft_PTable_TMOTable').css('display', 'none');
					jQuery('.Total_Soft_PTable_AMD3').css('display', 'block');
					jQuery('.Total_Soft_PTable_AMMain_Div').css('display', 'block');
					jQuery('.Total_Soft_PTable_AMD3').animate({ 'opacity': 1 }, 500);
					jQuery('.Total_Soft_PTable_AMMain_Div').animate({ 'opacity': 1 }, 500);
					jQuery('.Total_Soft_PTable_Loading').css('display', 'none');
				}, 500)
			} else {
				console.error('TS Pricing Table - AJAX Error.');
			}
		},
		fail: function (response) {
			console.error('TS Pricing Table - AJAX Error.', response);
		}
	});
}
function tsptChange(tsptTheme, tsptType, tsptId) {
	jQuery('.TS_PT_Option_Div_' + tsptTheme + '_' + tsptType).css('display', 'none');
	jQuery('.Total_Soft_PT_AMSetDiv_Button_' + tsptTheme + '_' + tsptType).removeClass('Total_Soft_PT_AMSetDiv_Button_C');
	jQuery('#TS_PT_TM_TBut_' + tsptTheme + '_' + tsptType + '_' + tsptId).addClass('Total_Soft_PT_AMSetDiv_Button_C');
	jQuery('#Total_Soft_PT_AMSetTable_' + tsptTheme + '_' + tsptType + '_' + tsptId).css('display', 'block');
}
