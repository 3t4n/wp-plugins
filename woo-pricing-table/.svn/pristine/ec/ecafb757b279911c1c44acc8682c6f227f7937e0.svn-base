let tsptDeleteOption,
	tsptDeleteItem;
jQuery(window).on('load', function () {
	jQuery('.Total_Soft_PTable_Loading').css('display', 'none');
	jQuery('.Total_Soft_PTable_Loading').css('background', 'rgba(0, 0, 0, 0.2)');
	setTimeout(() => {
		jQuery('.tspt-form').css('display', '');
	}, 100);
});
jQuery(document).on('click', '.TS_PTable_Remove_Cols_Rel_No', function () {
	jQuery('.TS_PTable_Remove_Cols_Fixed').fadeOut();
	jQuery('.TS_PTable_Remove_Cols_Abs').fadeOut();
});
jQuery(document).on('click', '.TS_PTable_Remove_Cols_Rel_Yes', function () {
	jQuery('.TS_PTable_Remove_Cols_Fixed').fadeOut();
	jQuery('.TS_PTable_Remove_Cols_Abs').fadeOut();
	if (tsptDeleteOption === 'column') {
		tsptDeleteColumn('action');
	} else if (tsptDeleteOption === 'setting') {
		tsptDeleteSetting('action');
	} else if (tsptDeleteOption === 'feature') {
		tsptDeleteFeature('action');
	}
});
function tsptDeleteConfirm(item, option) {
	if (option === "setting" && jQuery('.Total_Soft_PTable_TMMain_Div_Sets').children().length < 2) {
		console.error('Minimum setting count is 1.');
	} else {
		jQuery('.TS_PTable_Remove_Cols_Fixed').fadeIn();
		jQuery('.TS_PTable_Remove_Cols_Abs').fadeIn();
		tsptDeleteItem = item;
		tsptDeleteOption = option;
	}
}
function tsptDeleteColumn(tsptId) {
	if (tsptId === 'action') {
		jQuery('#TS_PTable_Col_' + tsptDeleteItem).remove();
		jQuery('#Total_Soft_PTable_Cols_Count').val(parseInt(parseInt(jQuery('#Total_Soft_PTable_Cols_Count').val()) - 1));
		tsptUpdateColumns();
	} else {
		tsptDeleteConfirm(tsptId, 'column');
	}
}
function tsptDeleteSetting(tsptSettingIndex) {
	if (tsptSettingIndex === 'action') {
		let tsptSettingsCount = parseInt(parseInt(jQuery('#Total_Soft_PTable_Set_Count').val()) - 1),
			tsptThemeType = jQuery('#Total_Soft_PTable_Theme_Type').val();
		jQuery('#Total_Soft_PTable_Set_Count').val(tsptSettingsCount);
		if (tsptSettingsCount < 2) {
			jQuery('.Total_Soft_PTable_TMMain_Div_But1').animate({ opacity: "0" }, 500);
		}
		if (tsptThemeType == 'type1') {
			jQuery('#TS_PTable_Set_T1_' + tsptDeleteItem).remove();
			jQuery(".Total_Soft_PTable_TMMain_Div_Sets > div.TS_PTable_TMMain_Set1").each(function () {
				let tsptSettingIdx = parseInt(parseInt(jQuery(this).index()) + 1);
				jQuery(this).attr('id', 'TS_PTable_Set_T1_' + tsptSettingIdx);
				jQuery(this).find('div.Total_Soft_PTable_TMMain_Div_Sets1_Actions1 i').attr('onclick', 'tsptCloneSetting(' + tsptSettingIdx + ')');
				jQuery(this).find('div.Total_Soft_PTable_TMMain_Div_Sets1_Actions2 i').attr('onclick', 'tsptDeleteSetting(' + tsptSettingIdx + ')');
				jQuery(this).find('.Total_Soft_PT_AMSetDiv_Buttons div.Total_Soft_PT_AMSetDiv_Button:nth-child(1)').attr('class', 'Total_Soft_PT_AMSetDiv_Button Total_Soft_PT_AMSetDiv_Button_C Total_Soft_PT_AMSetDiv_Button_1_' + tsptSettingIdx).attr('id', 'TS_PT_TM_TBut_1_' + tsptSettingIdx + '_GO').attr('onclick', 'tsptChange(\'1\', \'' + tsptSettingIdx + '\', \'GO\')');
				jQuery(this).find('.Total_Soft_PT_AMSetDiv_Buttons div.Total_Soft_PT_AMSetDiv_Button:nth-child(2)').attr('class', 'Total_Soft_PT_AMSetDiv_Button Total_Soft_PT_AMSetDiv_Button_1_' + tsptSettingIdx).attr('id', 'TS_PT_TM_TBut_1_' + tsptSettingIdx + '_TO').attr('onclick', 'tsptChange(\'1\', \'' + tsptSettingIdx + '\', \'TO\')');
				jQuery(this).find('.Total_Soft_PT_AMSetDiv_Buttons div.Total_Soft_PT_AMSetDiv_Button:nth-child(3)').attr('class', 'Total_Soft_PT_AMSetDiv_Button Total_Soft_PT_AMSetDiv_Button_1_' + tsptSettingIdx).attr('id', 'TS_PT_TM_TBut_1_' + tsptSettingIdx + '_PO').attr('onclick', 'tsptChange(\'1\', \'' + tsptSettingIdx + '\', \'PO\')');
				jQuery(this).find('.Total_Soft_PT_AMSetDiv_Buttons div.Total_Soft_PT_AMSetDiv_Button:nth-child(4)').attr('class', 'Total_Soft_PT_AMSetDiv_Button Total_Soft_PT_AMSetDiv_Button_1_' + tsptSettingIdx).attr('id', 'TS_PT_TM_TBut_1_' + tsptSettingIdx + '_FO').attr('onclick', 'tsptChange(\'1\', \'' + tsptSettingIdx + '\', \'FO\')');
