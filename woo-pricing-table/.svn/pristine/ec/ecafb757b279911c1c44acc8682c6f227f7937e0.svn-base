function tsptDeleteFeature(tsptId, tsptIndex = false) {
	if (tsptId === 'action') {
		let tsptFeaturesCount = parseInt(parseInt(jQuery('#TS_PTable_FCount_' + tsptDeleteItem).val()) - 1);
		jQuery('#TS_PTable_FCount_' + tsptDeleteItem).val(tsptFeaturesCount);
		for (let i = 0; i <= tsptFeaturesCount; i++) {
			jQuery('#Total_Soft_PTable_Features_' + tsptDeleteItem + ' tr:nth-child(' + parseInt(parseInt(i) + 1) + ')').find('select').removeClass('TS_PTable_FIcon_' + parseInt(parseInt(i) + 1));
			jQuery('#Total_Soft_PTable_Features_' + tsptDeleteItem + ' tr:nth-child(' + parseInt(parseInt(i) + 1) + ')').find('span').removeClass('TS_PTable_FChecked_' + parseInt(parseInt(i) + 1));
			jQuery('#Total_Soft_PTable_Features_' + tsptDeleteItem + ' tr:nth-child(' + parseInt(parseInt(i) + 1) + ')').find('input[type=text]').removeClass('TS_PTable_FText_' + parseInt(parseInt(i) + 1));
			jQuery('#Total_Soft_PTable_Features_' + tsptDeleteItem + ' tr:nth-child(' + parseInt(parseInt(i) + 1) + ')').find('i').removeClass('TS_PTable_FDI_' + parseInt(parseInt(i) + 1));
		}
		jQuery('#Total_Soft_PTable_Features_' + tsptDeleteItem + ' tr:nth-child(' + jQuery('.TS_PTable_Remove_Cols_Rel_Yes').attr('data-index') + ')').remove();
		for (let i = 1; i <= tsptFeaturesCount; i++) {
			jQuery('#Total_Soft_PTable_Features_' + tsptDeleteItem + ' tr:nth-child(' + i + ')').find('select').attr('id', 'TS_PTable_FIcon_' + tsptDeleteItem + '_' + i).attr('name', 'TS_PTable_FIcon_' + tsptDeleteItem + '_' + i).addClass('TS_PTable_FIcon_' + i);
			jQuery('#Total_Soft_PTable_Features_' + tsptDeleteItem + ' tr:nth-child(' + i + ')').find('span input[type=checkbox]').attr('id', 'TS_PTable_FChecked_' + tsptDeleteItem + '_' + i).attr('name', 'TS_PTable_FChecked_' + tsptDeleteItem + '_' + i).val(i);
			jQuery('#Total_Soft_PTable_Features_' + tsptDeleteItem + ' tr:nth-child(' + i + ')').find('span label').attr('for', 'TS_PTable_FChecked_' + tsptDeleteItem + '_' + i);
			jQuery('#Total_Soft_PTable_Features_' + tsptDeleteItem + ' tr:nth-child(' + i + ')').find('span').addClass('TS_PTable_FChecked_' + i);
			jQuery('#Total_Soft_PTable_Features_' + tsptDeleteItem + ' tr:nth-child(' + i + ')').find('input[type=text]').attr('id', 'TS_PTable_FText_' + tsptDeleteItem + '_' + i).attr('name', 'TS_PTable_FText_' + tsptDeleteItem + '_' + i).addClass('TS_PTable_FText_' + i);
			jQuery('#Total_Soft_PTable_Features_' + tsptDeleteItem + ' tr:nth-child(' + i + ')').find('i').attr('onclick', 'tsptDeleteFeature(' + tsptDeleteItem + ',' + i + ')').addClass('TS_PTable_FDI_' + i);
		}
	} else {
		jQuery('.TS_PTable_Remove_Cols_Rel_Yes').attr('data-index', tsptIndex);
		tsptDeleteConfirm(tsptId, 'feature');
	}
}
function tsptCreate(tsptId) {
	jQuery('.Total_Soft_PTable_AMD2').animate({ 'opacity': 0 }, 500);
	jQuery('.Total_Soft_PTable_AMMTable').animate({ 'opacity': 0 }, 500);
	jQuery('.Total_Soft_PTable_AMOTable').animate({ 'opacity': 0 }, 500);
	jQuery('.Total_Soft_PTable_Save').animate({ 'opacity': 1 }, 500);
	jQuery('.Total_Soft_PTable_Update').animate({ 'opacity': 0 }, 500);
	jQuery('#Total_Soft_PTable_ID').html('[Total_Soft_Pricing_Table id="' + tsptId + '"]');
	jQuery('#Total_Soft_PTable_TID').html('&lt;?php echo do_shortcode(&#039;[Total_Soft_Pricing_Table id="' + tsptId + '"]&#039;);?&gt');
	tsptThemeSet();
	tsptNewColumn();
	setTimeout(function () {
		jQuery('.Total_Soft_PTable_AMD2').css('display', 'none');
		jQuery('.Total_Soft_PTable_AMMTable').css('display', 'none');
		jQuery('.Total_Soft_PTable_AMOTable').css('display', 'none');
		jQuery('.Total_Soft_PTable_Save').css('display', 'block');
		jQuery('.Total_Soft_PTable_Update').css('display', 'none');
		jQuery('.Total_Soft_PTable_AMD3').css('display', 'block');
		jQuery('.Total_Soft_PTable_AMMain_Div').css('display', 'block');
		jQuery('.Total_Soft_PTable_AMD3').animate({ 'opacity': 1 }, 500);
		jQuery('.Total_Soft_PTable_AMMain_Div').animate({ 'opacity': 1 }, 500);
	}, 500)
}
function tsptCopyShortcode(shortcodeId) {
	let shortcodeInput = document.createElement("input"),
		getShortcode = document.getElementById(shortcodeId).innerHTML;
	getShortcode = getShortcode.replace("&lt;", "<");
	getShortcode = getShortcode.replace("&gt;", ">");
	getShortcode = getShortcode.replace("&#039;", "'");
	getShortcode = getShortcode.replace("&#039;", "'");
	shortcodeInput.setAttribute("value", getShortcode);
	document.body.appendChild(shortcodeInput);
	shortcodeInput.select();
	document.execCommand("copy");
	document.body.removeChild(shortcodeInput);
}
function tsptReload() {
	location.reload();
}
function tsptThemeImage() {
	let tsptThemeKey = jQuery('#Total_Soft_PTable_Them').val(),
		tsptThemePrefix = jQuery('#Total_Soft_PTable_TImage_HidSrc').val();
	jQuery('#Total_Soft_PTable_TImage').attr('src', tsptThemePrefix + tsptThemeKey + '.png');
	tsptThemeSet();
}
function tsptThemeSet() {
	let tsptThemeKey = jQuery('#Total_Soft_PTable_Them').val();
	jQuery('.TS_PTable_TSetting option').each(function () {
		jQuery(this).attr('disabled', jQuery(this).attr('alt') != tsptThemeKey);
		jQuery(this).css('display',jQuery(this).attr('alt') != tsptThemeKey ? 'none' : '');
		jQuery(this).attr('selected', false);
	});
	jQuery('.TS_PTable_TSetting option').each(function () {
		if (jQuery(this).attr('alt') == tsptThemeKey) {
			jQuery('.TS_PTable_TSetting').val(jQuery(this).val());
			return false;
		}
	});
}
function tsptThemeOptions() {
	let tsptThemeKey = jQuery('#Total_Soft_PTable_Them').val();
	jQuery('.TS_PTable_TSetting option').each(function () {
		jQuery(this).attr('disabled', jQuery(this).attr('alt') != tsptThemeKey);
		jQuery(this).css('display',jQuery(this).attr('alt') != tsptThemeKey ? 'none' : '');
	})
}
function tsptNewColumn() {
	let tsptColumnsCount = parseInt(parseInt(jQuery('#Total_Soft_PTable_Cols_Count').val()) + 1),
		tsptSelectIcon = jQuery('#Total_Soft_PTable_Select_Icon').html(),
		tsptThemeSetting = jQuery('#Total_Soft_PTable_Select_TSet').html();
	jQuery('.Total_Soft_PTable_AMMain_Div2_Cols').append('<div class="Total_Soft_PTable_AMMain_Div2_Cols1 Total_Soft_PTable_AMMain_Div2_Cols1_None" id="TS_PTable_Col_' + tsptColumnsCount + '"><div class="Total_Soft_PTable_AMMain_Div2_Cols1_Actions"><div class="Total_Soft_PTable_AMMain_Div2_Cols1_Action1"><i class="totalsoft totalsoft-arrows" title="Reorder" onmouseover="tsptSortableColumns()"></i></div><div class="Total_Soft_PTable_AMMain_Div2_Cols1_Action2"><i class="totalsoft totalsoft-file-text" title="Make Duplicate" onclick="tsptCloneColumn(' + tsptColumnsCount + ')"></i></div><div class="Total_Soft_PTable_AMMain_Div2_Cols1_Action3"><i class="totalsoft totalsoft-trash" title="Delete Column" onclick="tsptDeleteColumn(' + tsptColumnsCount + ')"></i></div></div><div class="Total_Soft_PTable_AMMain_Div2_Cols1_Fields"><table class="Total_Soft_PTable_AMMain_Div2_Cols1_FTable1"><tr><td colspan="2">Select Theme Setting</td></tr><tr><td colspan="2"><select class="Total_Soft_PTable_Select TS_PTable_TSetting" id="TS_PTable_TSetting_' + tsptColumnsCount + '" name="TS_PTable_TSetting_' + tsptColumnsCount + '">' + tsptThemeSetting + '</select></td></tr><tr><td>Title</td><td>Title Icon</td></tr><tr><td><input type="text" class="Total_Soft_PTable_Select TS_PTable_TText" id="TS_PTable_TText_' + tsptColumnsCount + '" name="TS_PTable_TText_' + tsptColumnsCount + '" value=""></td><td><select class="Total_Soft_PTable_Select TS_PTable_TIcon" id="TS_PTable_TIcon_' + tsptColumnsCount + '" name="TS_PTable_TIcon_' + tsptColumnsCount + '" style="font-family: FontAwesome, Arial;">' + tsptSelectIcon + '</select></td></tr><tr><td>Price Currency</td><td>Price Value</td></tr><tr><td><input type="text" class="Total_Soft_PTable_Select TS_PTable_PCur" id="TS_PTable_PCur_' + tsptColumnsCount + '" name="TS_PTable_PCur_' + tsptColumnsCount + '" value=""></td><td><input type="text" class="Total_Soft_PTable_Select TS_PTable_PVal" id="TS_PTable_PVal_' + tsptColumnsCount + '" name="TS_PTable_PVal_' + tsptColumnsCount + '" value=""></td></tr><tr><td colspan="2">Price Plan</td></tr><tr><td colspan="2"><input type="text" class="Total_Soft_PTable_Select TS_PTable_PPlan" id="TS_PTable_PPlan_' + tsptColumnsCount + '" name="TS_PTable_PPlan_' + tsptColumnsCount + '" value=""></td></tr><tr><td colspan="2">Features</td></tr><tr><td>Icon</td><td>Text</td></tr><tr style="background: #ffffff;"><td colspan="2"><table class="Total_Soft_PTable_AMMain_Div2_Cols1_FTable1" id="Total_Soft_PTable_Features_' + tsptColumnsCount + '"></table></td></tr><tr><td colspan="2"><div class="Total_Soft_PTable_Features_New" onclick="tsptCreateFeature(' + tsptColumnsCount + ')"><span class="Total_Soft_PTable_Features_New1"><i class="Total_Soft_PTable_Features_New_Icon totalsoft totalsoft-plus-circle" style="margin-right: 5px;"></i>Add New</span></div><input type="text" style="display: none;" class="TS_PTable_FCount" id="TS_PTable_FCount_' + tsptColumnsCount + '" name="TS_PTable_FCount_' + tsptColumnsCount + '" value="0"></td></tr><tr><td>Button Text</td><td>Button Icon</td></tr><tr><td><input type="text" class="Total_Soft_PTable_Select TS_PTable_BText" id="TS_PTable_BText_' + tsptColumnsCount + '" name="TS_PTable_BText_' + tsptColumnsCount + '" value=""></td><td><select class="Total_Soft_PTable_Select TS_PTable_BIcon" style="font-family: FontAwesome, Arial;" id="TS_PTable_BIcon_' + tsptColumnsCount + '" name="TS_PTable_BIcon_' + tsptColumnsCount + '">' + tsptSelectIcon + '</select></td></tr><tr><td colspan="2">Button Link</td></tr><tr><td colspan="2"><input type="text" class="Total_Soft_PTable_Select TS_PTable_BLink" id="TS_PTable_BLink_' + tsptColumnsCount + '" name="TS_PTable_BLink_' + tsptColumnsCount + '" value=""></td></tr></table></div></div>');
	jQuery('#Total_Soft_PTable_Cols_Count').val(tsptColumnsCount);
	jQuery('.Total_Soft_PTable_AMMain_Div2_Cols1_None').animate({ opacity: "1" }, 500);
	tsptThemeOptions();
}
function tsptUpdateColumns() {
	jQuery(".Total_Soft_PTable_AMMain_Div2_Cols > div.Total_Soft_PTable_AMMain_Div2_Cols1").each(function () {
		let tsptColumnIndex = parseInt(parseInt(jQuery(this).index()) + 1);
		jQuery(this).attr('id', 'TS_PTable_Col_' + tsptColumnIndex);
		jQuery(this).find('div.Total_Soft_PTable_AMMain_Div2_Cols1_Action2 i').attr('onclick', 'tsptCloneColumn(' + tsptColumnIndex + ')');
		jQuery(this).find('div.Total_Soft_PTable_AMMain_Div2_Cols1_Action3 i').attr('onclick', 'tsptDeleteColumn(' + tsptColumnIndex + ')');
		jQuery(this).find('table.Total_Soft_PTable_AMMain_Div2_Cols1_FTable1 select.TS_PTable_TSetting').attr('id', 'TS_PTable_TSetting_' + tsptColumnIndex);
		jQuery(this).find('table.Total_Soft_PTable_AMMain_Div2_Cols1_FTable1 select.TS_PTable_TSetting').attr('name', 'TS_PTable_TSetting_' + tsptColumnIndex);
		jQuery(this).find('table.Total_Soft_PTable_AMMain_Div2_Cols1_FTable1 input.TS_PTable_TText').attr('id', 'TS_PTable_TText_' + tsptColumnIndex);
		jQuery(this).find('table.Total_Soft_PTable_AMMain_Div2_Cols1_FTable1 input.TS_PTable_TText').attr('name', 'TS_PTable_TText_' + tsptColumnIndex);
		jQuery(this).find('table.Total_Soft_PTable_AMMain_Div2_Cols1_FTable1 select.TS_PTable_TIcon').attr('id', 'TS_PTable_TIcon_' + tsptColumnIndex);
		jQuery(this).find('table.Total_Soft_PTable_AMMain_Div2_Cols1_FTable1 select.TS_PTable_TIcon').attr('name', 'TS_PTable_TIcon_' + tsptColumnIndex);
		jQuery(this).find('table.Total_Soft_PTable_AMMain_Div2_Cols1_FTable1 input.TS_PTable_PCur').attr('id', 'TS_PTable_PCur_' + tsptColumnIndex);
		jQuery(this).find('table.Total_Soft_PTable_AMMain_Div2_Cols1_FTable1 input.TS_PTable_PCur').attr('name', 'TS_PTable_PCur_' + tsptColumnIndex);
		jQuery(this).find('table.Total_Soft_PTable_AMMain_Div2_Cols1_FTable1 input.TS_PTable_PVal').attr('id', 'TS_PTable_PVal_' + tsptColumnIndex);
		jQuery(this).find('table.Total_Soft_PTable_AMMain_Div2_Cols1_FTable1 input.TS_PTable_PVal').attr('name', 'TS_PTable_PVal_' + tsptColumnIndex);
		jQuery(this).find('table.Total_Soft_PTable_AMMain_Div2_Cols1_FTable1 input.TS_PTable_PPlan').attr('id', 'TS_PTable_PPlan_' + tsptColumnIndex);
		jQuery(this).find('table.Total_Soft_PTable_AMMain_Div2_Cols1_FTable1 input.TS_PTable_PPlan').attr('name', 'TS_PTable_PPlan_' + tsptColumnIndex);
		jQuery(this).find('table.Total_Soft_PTable_AMMain_Div2_Cols1_FTable1 table.Total_Soft_PTable_AMMain_Div2_Cols1_FTable1').attr('id', 'Total_Soft_PTable_Features_' + tsptColumnIndex);
		jQuery(this).find('div.Total_Soft_PTable_Features_New').attr('onclick', 'tsptCreateFeature(' + tsptColumnIndex + ')');
		jQuery(this).find('table.Total_Soft_PTable_AMMain_Div2_Cols1_FTable1 input.TS_PTable_FCount').attr('id', 'TS_PTable_FCount_' + tsptColumnIndex);
		jQuery(this).find('table.Total_Soft_PTable_AMMain_Div2_Cols1_FTable1 input.TS_PTable_FCount').attr('name', 'TS_PTable_FCount_' + tsptColumnIndex);
		jQuery(this).find('table.Total_Soft_PTable_AMMain_Div2_Cols1_FTable1 input.TS_PTable_BText').attr('id', 'TS_PTable_BText_' + tsptColumnIndex);
