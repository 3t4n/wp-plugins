msgid "API Settings"
msgstr "Réglages API"

msgid "API user"
msgstr "Nom d'utilisateur API"

msgid "API key"
msgstr "Clé d'accès API"

msgid "API url"
msgstr "Adresse du serveur API"

msgid "API state"
msgstr "Etat courant de l'API"

msgid "API Error: Missing parameters"
msgstr "Erreur API: Paramètres manquants"

msgid "Connection established"
msgstr "Connexion établie"

msgid "%s result found"
msgid_plural "%s results found"
msgstr[0] "%s résultat trouvé"
msgstr[1] "%s résultats trouvés"

msgid "Saved settings"
msgstr "Paramètres enregistrées"

msgid "Dismiss this message"
msgstr "Ne pas tenir compte de ce message"

msgid "Search for a video"
msgstr "Rechercher une vidéo"

msgid "Send a video"
msgstr "Envoyer une vidéo"

msgid "Add a Freecaster video"
msgstr "Ajouter une vidéo Freecaster"

msgid "Offline, settings are required"
msgstr "Désactivé, des paramètres sont requis"

msgid "Offline, access problem"
msgstr "Désactivé, problème d'accès"

msgid "Settings missing, please contact Freecaster if you do not have yet"
msgstr ""
"Paramètre(s) manquant(s), veuillez contacter Freecaster si vous n'en "
"possédez pas encore"

msgid "Please enter a reference (ID) or a title in the search box"
msgstr ""
"Veuillez introduire une référence (ID) ou un titre dans la zone de recherche "
"ci-dessus"

msgid ""
"An error occurred while retrieving data <b>please verify your access</b> in "
"the <a href='%s'>options page</a>"
msgstr ""
"Une erreur s'est produite lors de la récupération des données, <b>veuillez "
"vérifier votre accès</b><br>dans la <a href='%s'>page d'options</a>"

msgid ""
"An error accessing your data has occurred, <b>please verify your settings</"
"b> in the <a href='%s'>options page</a>"
msgstr ""
"Une erreur d'accès à vos données a eu lieu, <b>veuillez vérifier vos "
"paramètres</b><br>dans la <a href='%s'>page d'options</a>"

msgid ""
"To access all your content <b>please encode your settings</b> in the <a "
"href='%s'>options page</a>.<br>You still can include a video directly, using "
"his ID please."
msgstr ""
"Afin d’accéder à l'ensemble votre contenu <b>veuillez encodez vos paramètres "
"d'accès</b><br>dans la <a href='%s'>page d'options</a>. Vous pouvez toujours "
"inclure une vidéo via sa référence (ID)."

msgid "Playback"
msgstr "Lecture"

msgid "Auto play video"
msgstr "Lire automatiquement la vidéo"

msgid "Player width"
msgstr "Largeur du lecteur"

msgid "Sets the player size (default 100%)"
msgstr "Définit la taille du lecteur (par défaut 100%)"

msgid "Insert video"
msgstr "Insérer la vidéo"

msgid "Player Settings"
msgstr "Paramètres du lecteur"

msgid "Player url"
msgstr "Adresse lecteur"

msgid "Player protocol"
msgstr "Protocole du lecteur"

msgid "Related channel"
msgstr "Chaîne parente"

msgid "Video title"
msgstr "Titre de la vidéo"

msgid "File to upload"
msgstr "Fichier à envoyer"

msgid "Upload video"
msgstr "Envoyer la vidéo"

msgid "Your form submission seems incomplete"
msgstr "Votre soumission du formulaire semble incomplète"
