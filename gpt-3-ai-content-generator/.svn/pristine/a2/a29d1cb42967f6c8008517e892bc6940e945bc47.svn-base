body.toplevel_page_wpopenai #wpbody-content{float:none}#wpopenai a,#wpopenai button{transition:all .1s ease-in;vertical-align:middle}.wpoais-modal .components-modal__content{padding:0}.wpoais-modal .components-modal__header{margin:0}.wpoai-components-Modal_WPModal.components-modal__frame.is-full-screen{max-height:90vh}.wpoai-components-Modal_WPModal .components-modal__header{margin:0}.wpoai-components-Modal_WPModal .components-modal__content{padding:0}.wpoai-components-Modal_WPModal .components-modal__content:before{margin-bottom:0}.wpoai-components-Modal_OverlayDark.components-modal__screen-overlay{background-color:rgba(0,0,0,.9)}.wpoai-components-Tooltip_Popover:not(.is-without-arrow)[data-y-axis=top]:after,.wpoai-components-Tooltip_Popover:not(.is-without-arrow)[data-y-axis=top]:before{border-top-color:rgba(0,0,0,.85)}.wpoai-components-Tooltip_Popover .components-popover__content{background:rgba(0,0,0,.85);border:none;color:#fff;font-size:12px;font-weight:700;padding:4px 8px;text-align:center;width:90px}#wpopenai .mantine-Select-wrapper input.mantine-Select-input{background:#fff}#wpopenai .mantine-Select-dropdown .mantine-ScrollArea-root{padding:4px}#wpopenai .mantine-Select-dropdown .mantine-ScrollArea-viewport{padding:0}#wpopenai .mantine-Select-dropdown .mantine-ScrollArea-viewport>div>div{padding:0!important}#wpopenai .mantine-Select-dropdown .mantine-Select-item{border-radius:0}#wpopenai .mantine-Select-dropdown .mantine-Select-item:first-child{border-top-left-radius:4px;border-top-right-radius:4px}#wpopenai .mantine-Select-dropdown .mantine-Select-item:last-child{border-bottom-left-radius:4px;border-bottom-right-radius:4px}
a.mantine-Button-root:focus { color: white !important; box-shadow: none !important; }
