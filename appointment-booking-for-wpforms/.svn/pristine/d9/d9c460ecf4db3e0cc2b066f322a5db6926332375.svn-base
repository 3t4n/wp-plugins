.toplevel_page_booknow-settings-wizard #adminmenuback, 
.toplevel_page_booknow-settings-wizard #adminmenuwrap, 
.toplevel_page_booknow-settings-wizard #wpadminbar,
.toplevel_page_booknow-settings-wizard .error,
.toplevel_page_booknow-settings-wizard .notice {
	display: none;
}

.toplevel_page_booknow-settings-wizard img{
	width: 16px;
	height: 16px;
}
.booknow_settings_container_working_hours-content {
	display: inline-block;
}
.booknow_settings_container_working_hours_add {
	padding: 5px 0;
}
.booknow_settings_container_working_hours_add a {
	text-decoration: none;
}
.post-type-booknow #post-body-content,
.post-type-booknow #minor-publishing-actions,
.post-type-booknow #misc-publishing-actions,
.post-type-booknow #message,
.post-type-booknow #wpseo_meta,
.post-type-booknow_services #post-body-content,
.post-type-booknow_services #minor-publishing-actions,
.post-type-booknow_services #misc-publishing-actions,
.post-type-booknow_services #message,
.post-type-booknow_services #wpseo_meta,
.post-type-booknow_staffs #post-body-content,
.post-type-booknow_staffs #minor-publishing-actions,
.post-type-booknow_staffs #misc-publishing-actions,
.post-type-booknow_staffs #message,
.post-type-booknow_staffs #wpseo_meta,
.post-type-booknow_customers #post-body-content,
.post-type-booknow_customers #minor-publishing-actions,
.post-type-booknow_customers #misc-publishing-actions,
.post-type-booknow_customers #wpseo_meta,
.post-type-booknow_customers #message,
.post-type-booknow_notify #post-body-content #edit-slug-box,
.post-type-booknow_notify #minor-publishing-actions,
.post-type-booknow_notify #misc-publishing-actions,
.post-type-booknow_notify #wpseo_meta,
.post-type-booknow_notify #message
 {
	display: none !important;
}
.booknow-container-settings {
    background: #fff;
    display: flex;
    margin-top: 50px;
}
.booknow-tabs {
	margin-right: 15px;
	padding: 15px;
	width: 250px;
}
.booknow-tabs ul li {
	padding: 15px 15px;
    font-size: 20px;
    font-weight: 600;
    border: 1px solid #e7e7e7;
    margin: 15px 0;
    border-radius: 15px;
}
.booknow-tabs ul li:hover, .booknow-tabs ul li.active{
	opacity: 0.8;
	cursor: pointer;
    background: #12D488;
    color: #fff;
}
.booknow-container-settings .booknow-tab-content {
	padding: 15px;
	border-left: 1px solid #e7e7e7;
	margin-left: 15px;
	width: 100%;
}
.calculation_forms_settings_title {
	border-bottom: 1px solid #e7e7e7;
	margin-left: -15px;
	font-size: 20px;
    font-weight: bold;
    padding: 15px 0px 15px 15px;
}
.booknow_settings_container_color,
.booknow_settings_nav {
	display: flex;
	
}
.booknow_settings_nav {
	position: absolute;
    bottom: 0;
    left: 0;
	width: 100%;
}
.booknow_settings_nav_next {
	width: 100%;
	text-align: right;
}
.booknow_settings_nav_next .submit{
	text-align: right;
	margin: 0;
	padding: 0;
}
.booknow-container-settings-wizard {
	max-width: 900px;
	margin: 0 auto;
}
.booknow-container-settings-wizard .booknow-container-settings{
   border: 1px solid #e7e7e7;
   border-radius: 5px;

}
.toplevel_page_booknow-settings-wizard #wpcontent {
	margin-left: 0;
}
.toplevel_page_booknow-settings-wizard .booknow-tab-main  {
	min-height: 500px;
	position: relative;
}
.toplevel_page_booknow.menu-top img,
.toplevel_page_booknow-settings .wp-menu-image img
{
   width: 24px;
}
.booknow-dashboard-analysis-container {
	display: flex;
}
.booknow-dashboard-analysis-container>div {
	padding: 15px;
	width: 100%;
}
.booknow-dashboard-summary-data {
	display: flex;
}
.booknow-dashboard-summary-data h3 {
	margin: 5px 0;
}
.booknow-dashboard-summary-data p {
	margin: 5px 0;
}
.booknow-dashboard-summary-data>div {
	padding: 15px;
	width: 100%;
	text-align: center;
    border: 1px solid #e7e7e7;
    margin: 15px;
    border-radius:  5px;
    background: #fff;
    font-size: 18px;
}
.booknow_list_booking {
     list-style: none;
     margin: 0;
}