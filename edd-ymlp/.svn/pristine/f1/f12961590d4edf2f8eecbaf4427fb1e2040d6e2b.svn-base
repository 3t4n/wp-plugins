p#edd-ymlp-checkbox-wrapper{ clear:both; display:block; }
p#edd-ymlp-checkbox-wrapper input#edd-ymlp-checkbox { position:relative; margin:0 5px 0 0; padding:0; height:13px; width:13px; 
	display:inline-block; -webkit-appearance: checkbox; clear:both; }
p#edd-ymlp-checkbox-wrapper label{ cursor:pointer; }