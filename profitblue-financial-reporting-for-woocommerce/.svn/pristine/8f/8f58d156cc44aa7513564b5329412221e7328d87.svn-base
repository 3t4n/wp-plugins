<?php

namespace Profiblue\Enums;

/**
 * OrderStatuses
 * 
 * This class defines custom order statuse for pluign
 * 
 * @since 1.0.0
 * 
 */
class OrderStatuses {

	/**
	 * get
	 * Return array of order custom statuses
	 *
	 * @since    1.0.0
	 * @return array
	 * @access public
	 */
	public static function get() {
		return array(
			array(
				'label' => esc_html__( 'Shipped', 'profitblue-financial-reporting-for-woocommerce' ),
				'value' => 'shipped',
			),			
		);
	}
}
