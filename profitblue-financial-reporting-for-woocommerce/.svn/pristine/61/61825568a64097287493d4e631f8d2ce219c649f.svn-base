<?php

namespace Profiblue\Enums;

/**
 * WeekDays
 * 
 * This class defines config for days in week
 * 
 * @since 1.0.0
 * 
 */
class WeekDays {

	/**
	 * get
	 * Return array of days in week
	 *
	 * @since    1.0.0
	 * @return array
	 * @access public
	 */
	public static function get() {

			

		return array(
			array(
				'value' => 1,
				'label' => esc_html__( 'Monday', 'profitblue-financial-reporting-for-woocommerce' ),
			),
			array(
				'value' => 2,
				'label' => esc_html__( 'Tuesday', 'profitblue-financial-reporting-for-woocommerce' ),
			),
			array(
				'value' => 3,
				'label' => esc_html__( 'Wednesday', 'profitblue-financial-reporting-for-woocommerce' ),
			),
			array(
				'value' => 4,
				'label' => esc_html__( 'Thursday', 'profitblue-financial-reporting-for-woocommerce' ),
			),
			array(
				'value' => 5,
				'label' => esc_html__( 'Friday', 'profitblue-financial-reporting-for-woocommerce' ),
			),
			array(
				'value' => 6,
				'label' => esc_html__( 'Saturday', 'profitblue-financial-reporting-for-woocommerce' ),
			),
			array(
				'value' => 7,
				'label' => esc_html__( 'Sunday', 'profitblue-financial-reporting-for-woocommerce' ),
			),
		);
	}
}
