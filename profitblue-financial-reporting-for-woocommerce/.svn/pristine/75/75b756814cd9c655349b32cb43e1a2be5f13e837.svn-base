/* Checkbox */
.checkbox-wrap{
	width:100%;
}
.checkbox-wrap .checkbox-input{
	opacity:0;
	width:0px;
	height:0px;
	border:none!important;
	box-shadow:none!important;
}
.checkbox-wrap .checkbox-input-handler{
	display:flex;
	width: 18px;
	height: 18px;
	cursor:pointer;
	border: solid 1px #e4e4e4;
	
}
.checkbox-wrap .checkbox-input-handler.checked{
	background-color:#01baff;
	background-image: url( '../images/icons/check-solid-white.svg' );
	background-position: center center;
	background-repeat: no-repeat;
	background-size: 14px;
	position:relative;
}

/* Select */
.select-wrap{
	display:grid;
	width:100%;
}
.select-wrap select{
	display:none;
}

.select-wrap .select-inner{
	display:grid;
	width:100%;
	position: relative;
}
.select-wrap .select-inner .selected-value{
	width:100%;
	display:flex;
	align-items: center;
	position:relative;
	border: solid 1px #e4e4e4;
	padding: 8px 10px 8px 24px;
	box-sizing: border-box;
}
.selected-value-label{
	display:flex;
}
.select-dropdown-icon{
	display: flex;
	justify-content: center;
	align-items: center;
	position:absolute;
	right:0;
	top:0;
	width:30px;
	height: 34px;
	cursor: pointer;
}
.select-dropdown-icon svg{
	width:14px;
	fill:#8c9292;
}
.select-wrap .select-inner .select-dropdown{
	width:100%;
	display:none;
	background:#ffffff;
	border-bottom: solid 1px #e4e4e4;
	border-left: solid 1px #e4e4e4;
	border-right: solid 1px #e4e4e4;
	box-sizing: border-box;
}
.select-wrap .select-inner .select-dropdown.open{
	display:block;
}
.select-dropdown .select-dropdown-item{
	height:0px;
	padding: 5px 10px 5px 24px;
	cursor:pointer;
	-webkit-transition: all 0.5s ease-out;
  	-moz-transition: all 0.5s ease-out;
  	-o-transition: all 0.5s ease-out;
  	transition: all 0.5s ease-out;
}
.select-dropdown .select-dropdown-item:hover{
	background:#e4e4e4;
}
.select-dropdown.open .select-dropdown-item{
	height:auto;
}
.select-dropdown-icon svg{
	-webkit-transition: all 0.5s ease-out;
  	-moz-transition: all 0.5s ease-out;
  	-o-transition: all 0.5s ease-out;
  	transition: all 0.5s ease-out;
}
.select-dropdown-icon.active svg{
	transform: rotate(180deg);
}

/* Number */
.number-wrap{
	width:100%;
}
.number-inner{
	width:100%;
	display:flex;
}
.number-inner input{
	width:100%;
	display:flex;
	align-items: center;
	position:relative;
	border: solid 1px #e4e4e4;
	padding: 8px 0px 8px 24px;
	box-sizing: border-box;
	border-radius:0;
	font-size:14px;
	line-height:14px;
}

