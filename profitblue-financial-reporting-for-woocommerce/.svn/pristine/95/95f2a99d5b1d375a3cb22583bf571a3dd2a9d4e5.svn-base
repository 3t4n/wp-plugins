	height: 14px;
	fill:#ffffff;
}


/* Product list pagination */
.products-pagination{
	width:100%;
	display: flex;
	flex-wrap:wrap;
	gap:20px;
	margin-top: 30px;
	margin-bottom: 30px;
}
.pagination-more{
	width:auto;
	justify-content: center;
	display: flex;
	width: 100%;
}
.pagination-more a{
	text-decoration:none;
}
.pagination-numbers-wrap{
	width: 100%;
	justify-content: end;	
	display: flex;
	gap:20px;
}
.pagination-numbers{
	display: flex;
	gap:10px;
}
.pagination-numbers span{
	display:flex;
	justify-content: center;
	align-items: center;
	border:solid 1px #ececec;
	background-color: #ececec;
	height: 20px;
	width:20px;
	color: #141414;
}
.pagination-numbers a{
	display:flex;
	justify-content: center;
	align-items: center;
	border:solid 1px #ececec;
	height: 20px;
	width:20px;
	text-decoration:none;
	color: #ffffff;
}
.pagination-arrows{
	display: flex;
	gap:10px;
}
.pagination-arrows span{
	display:flex;
	justify-content: center;
	align-items: center;
	border:solid 1px #ececec;
	background-color: #ececec;
	height: 20px;
	width:20px;
	border-radius:2px;
}
.pagination-arrows a{
	display:flex;
	justify-content: center;
	align-items: center;
	border:solid 1px #ececec;
	height: 20px;
	width:20px;
	text-decoration:none;
	border-radius:2px;
	color:#141414;
}
.pagination-arrows a:hover{
	background-color: #ececec;
}
.pagination-arrows a:hover svg{
	fill:#b9b9b9;
}
.pagination-arrows a svg{
	width: 8px;
	fill:#141414;
}
.pagination-arrows span svg{
	width: 8px;
	fill:#ffffff;
}

.checkbox-list-item{
	width:100%;
	display: flex;
	gap:20px;
	margin-bottom: 20px;
}
.checkbox-list-item-left{
	width: 60px;
	margin-right:auto;
	position:relative;
	padding-left: 20px;
	box-sizing: border-box;
}
.checkbox-list-item-left input{
	position:absolute;
	width:0;
	height:0;
	border:none;
	box-shadow:none;
	opacity: 0;
}
.checkbox-list-item-radio{
	width: 14px;
	height: 14px;
	border: solid 1px #bdbdbd;
	cursor: pointer;
	position:relative;
}
.checkbox-list-item-radio.active{
	background-color:#01baff;
}
.checkbox-list-item-radio::before{
	content:'';
	position:absolute;
	left:50%;
	top:50%;
	width:2px;
	height:10px;
	margin-top:-5px;
	margin-left:1px;
	transform: rotate(45deg);
	background-color: #ffffff;
}
.checkbox-list-item-radio::after{
	position:absolute;
	content:'';
	left:50%;
	top:50%;
	width:2px;
	height: 5px;
    margin-left: -4px;
	margin-top:-2px;
	transform: rotate(135deg);
	background-color: #ffffff;
}
.checkbox-list-item-radio::before:hover,
.checkbox-list-item-radio::after:hover{
	background-color: #000000;
}
.checkbox-list-item-right{
	width:100%;
}

/* Shipping list */
.shipping-list{
	width:100%;
}
.shipping-list-item{
	width:100%;
	display: flex;
	gap:20px;
	margin-bottom: 20px;
}
.shipping-list-item.no-shipping-cost-all,
.shipping-list-item.different-shipping-cost,
.shipping-list-item.insert-shipping-cost{
	opacity:0.4;
}
.shipping-list-item-left{
	width: 60px;
	margin-right:auto;
	position:relative;
	padding-left: 20px;
	box-sizing: border-box;
}
.shipping-list-item-left input{
	position:absolute;
	width:0;
	height:0;
	border:none;
	box-shadow:none;
	opacity: 0;
}
.shipping-list-item-radio{
	width: 14px;
	height: 14px;
	border-radius:20px;
	border: solid 1px #ffffff;
	-webkit-box-shadow: 0px 0px 0px 1px #bdbdbd;
	-moz-box-shadow: 0px 0px 0px 1px #bdbdbd;
	box-shadow: 0px 0px 0px 1px #bdbdbd;
	cursor: pointer;
}
.shipping-list-item-radio.active,
.shipping-list-item-radio:hover{
	background-color:#01baff;
}
.shipping-list-item-right{
	width:100%;
}
.shipping-variable-cost,
.shipping-zone-cost{
	display:none;
}

/* Modal content */
.are-you-sure{
	width:100%;
	text-align:center;
	margin-bottom:30px;
	font-size:20px;
}
.modal-save-button{
	width:100%;
	display: flex;
	justify-content: center;
}
.modal-save-form{
	
}

.modal-ajax-response{
	width:100%;
	text-align:center;
}

/* Progress bar */
.cogs-batch-progress-bar{
	width:100%;
	height:20px;
	background-color: #ededed;
	position:relative;
}
.cogs-batch-progress-bar-percent{
	width:0%;
	height:20px;
	background-color: #000000;
	position:absolute;
	left:0;
	top:0;
}

/* Order search */
.order-filter-search{
	position:relative;
	display:grid;
	align-items: center;
	border-radius: 0!important;
	border: solid 1px #ececec!important;
	max-width: 300px;
}
.order-filter-search form{
	display: flex;
	align-items: center;
}
.order-filter-search button{
	background-color: transparent;
	border:none;
	cursor: pointer;
}
.order-filter-search button svg{
	width:20px;
	height:20px;
	fill: #b0b0b0;
}
.order-search{	
	padding: 4px 10px 4px 30px!important;	
	border:none!important;
}
.order-search-button{
	padding:4px 20px!important;
	background:#01baff!important;
	border-color:#01baff!important;
	font-weight:600;
}

/* Cogs */
.cogs-header{
	width:100%;
	display:grid;
	gap:20px;
	align-items: center;
	position:relative;
}
.csv-export-import{
	line-height: 18px;
	font-size: 14px;
	padding: 8px 15px;
}
.cogs-header .csv-export-import{
	position: absolute;
    right: 0;
    top: 10px
}

.page-notice{

}
.products-filter{
	width:100%;
	display:flex;
	gap:20px;
}
.products-filter-search{
	position:relative;
	display:grid;
	align-items: center;
	border-radius: 0!important;
	border: solid 1px #ececec!important;
	margin-right:20px;
}
.products-filter-search form{
	display: flex;
	align-items: center;
}
.products-filter-search button{
	background-color: transparent;
	border:none;
	cursor: pointer;
}
.products-filter-search button svg{
	width:20px;
	height:20px;
	fill: #b0b0b0;
}
.product-search{	
	padding: 4px 10px 4px 30px!important;	
	border:none!important;
}
.product-search-button{
	padding:4px 20px!important;
	background:#01baff!important;
	border-color:#01baff!important;
	font-weight:600;
}
.products-filter-show{
	border: solid 1px #ececec!important;
	display:flex;
	gap: 10px;
	padding: 10px 10px;
}
.product-show-check{
	border: solid 1px #ececec!important;
	width: 14px;
	height: 14px;
	cursor:pointer;
	position:relative;
}
.product-show-check.active::before{
	left:0;
	top: 8px;
	position:absolute;
	width: 8px;
	height:2px;
	background:#01baff;
	content:'';
	transform: rotate(45deg);
}
.product-show-check.active::after{
	left: 4px;
	top: 7px;
	position:absolute;
	width: 11px;
	height:2px;
	background:#01baff;
	content:'';
	transform: rotate(135deg);
}
.product-show-label{
	line-height: 14px;
}
.product-search-target{
	position:absolute;
	left:0;
	top:100%;
	width: 350px;
	display:flex;
	display:none;
	border-radius: 0!important;
	border: solid 1px #ececec!important;
	padding: 20px!important;
	background: #ffffff;
}
.product-search-target ul{
	margin:0;
	padding:0;
	width: 100%;
}
.product-search-target ul li{
	width:100%;
	border-bottom: solid 1px #ececec!important;
	margin:0;
}
.product-search-target ul li:last-child{
	border-bottom:none;
}
.product-search-target ul li a{
	width:100%;
	display: flex;
	align-items: center;
	gap:20px;
	text-decoration: none;
	color:#3c434a;
}
.product-search-target ul li a:hover{
	background-color:#ececec;
}
.product-search-target ul li a img{
	display: flex;
    margin: 0;
    width: 40px;
    height: auto;
}

/* Hidden */
.form-section-hidden-line{
	height:0;
	overflow: hidden;
	padding-top:0px;
	-webkit-transition: all 0.5s ease-out;
	-moz-transition: all 0.5s ease-out;
	-o-transition: all 0.5s ease-out;
	transition: all 0.5s ease-out;
}
.form-section-hidden-line.open{
	height:auto;
	padding-top:10px;
}

.fixed-form,
.variable-form,
.income-form{
	background-color:#ffffff;
}
.fixed-form.wizard-active-div .tooltip-icon,
.variable-form.wizard-active-div .tooltip-icon,
.income-form.wizard-active-div .tooltip-icon,
.fixed-form.wizard-active-div .ccai-remove-line,
.variable-form.wizard-active-div .ccai-remove-line,
.income-form.wizard-active-div .ccai-remove-line{
	display:none;
}
/* Custom cost and income */
.fixed-cost-line-wrap,
.income-cost-line-wrap,
.variable-cost-line-wrap{
	position:relative;
}
.fixed-cost-line-parts,
.income-cost-line-parts{
	display:grid;
	grid-template-columns: 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr;
	gap:10px;
	margin-top:10px;
	margin-bottom: 10px;
}
.fixed-cost-recalculte,
.income-cost-recalculte{
	display: flex;
	align-items: center;
	gap: 20px;
}
.fixed-cost-recalculte .checkbox-wrap,
.income-cost-recalculte .checkbox-wrap{
	width:auto;
	display: grid;
	align-items: center;
}
.fixed-cost-line-parts,
.income-cost-line-parts{
	height:auto;
	overflow: hidden;
	-webkit-transition: all 0.5s ease-out;
  	-moz-transition: all 0.5s ease-out;
  	-o-transition: all 0.5s ease-out;
  	transition: all 0.5s ease-out;
}
.fixed-cost-line-parts.closed,
.income-cost-line-parts.closed{
	height:0;
}
.fixed-cost-line-month,
.income-cost-line-month{
	position:relative;	
}

.mont-number{
	position:absolute;
	left: 1px;
	top:0;
	border: solid 1px #ececec;
	padding: 0px 4px;
	font-size: 10px;
}
.fixed-cost-line-tables,
.income-cost-line-tables{
	font-size:12px;
	padding: 1px 10px;
	border: solid 1px #ececec;
	cursor:pointer;
}
.fixed-cost-line-tables.hide,
.income-cost-line-tables.hide{
	display:none;
}
.ccai-more-line{
	width:100%;
	margin: 20px 0 40px 0;
	display:flex;
	justify-content: center;
	box-sizing: border-box;
}
.ccai-more-line-button{
	padding: 6px 80px;
	border: solid 1px #ececec;
	cursor:pointer;
	text-decoration: none;
	color: #000000;
}
.variable-cost-line-wrap{
	margin-bottom:20px;
}
.ccai-remove-line{
	position:absolute;
	width: 18px;
	height: 18px;
	left: -23px;
	top: 10px;
	cursor: pointer;
	z-index:100;
	background-image: url( '../images/icons/circle-xmark-regular.svg' );
	background-repeat: no-repeat;
	background-position: center center;
	background-size: 18px;
	cursor: pointer;
	z-index:8;
}

.shop-setting-first-line{
	padding:10px 0;
	border-bottom:solid 1px #ececec;
	align-items: center;
}
.shop-setting-second-line{
	padding:10px 0;
	align-items: center;
}
.checkbox-wrap.exclude-proccessing-wrap{
	display:flex;
	align-items: center;
}

/* Order overwiev table */
.orders-overwiev{
	width:100%;
	padding: 0 10px;
    box-sizing: border-box;
	position:relative;
}
.orders-overwiev-header{
	width:100%;
	display:grid;
	grid-template-columns: 1fr 1fr 6fr 1fr 1fr 1fr 1fr 1fr;
	gap:10px;
	padding:10px 0;
	background-color: #ffffff;
	z-index:9;
}

.orders-overwiev-header.fixed{
	border-bottom:#ededed 1px solid;
	padding-right:30px;
	padding-left:30px;
	margin-left:-40px;
}

.orders-overwiev-header-id,
.orders-overwiev-header-date,
.orders-overwiev-header-name,
.orders-overwiev-header-country,
.orders-overwiev-header-status,
.orders-overwiev-header-pcs,
.orders-overwiev-header-revenue,
.orders-overwiev-header-cogs,
.orders-overwiev-header-margin,
.orders-overwiev-header-percent{
	font-weight: bold;
}
.orders-overwiev-header-date{
	display:flex;
}
.orders-overwiev-header-date .date-order,
.orders-overwiev-header-pcs .pcs-order,
.orders-overwiev-header-revenue .revenue-order{
	display: inline-block;
	width: 14px;
	height: 14px;
	cursor: pointer;
	background-image: url( '../images/icons/caret-down-solid.svg' );
	background-repeat: no-repeat;
	background-position: center center;
	background-size: 14px;
	margin-left: 4px;
}
.orders-overwiev-header-date .date-order.order-up,
.orders-overwiev-header-pcs .pcs-order.order-up,
.orders-overwiev-header-revenue .revenue-order.order-up{
	background-image: url( '../images/icons/caret-up-solid.svg' );
}

.orders-overwiev-header-inner,
.orders-overwiev-item-inner{
	width:100%;
	display:grid;
	grid-template-columns: 1fr 2fr 1fr;
	gap:10px;
}

.orders-overwiev-item{
	position:relative;
	width:100%;
	display:grid;
	grid-template-columns: 1fr 1fr 6fr 1fr 1fr 1fr 1fr 1fr;
	border-top: solid 1px #ececec;
	align-items: center;
	gap:10px;
	padding: 5px 0;
}

.orders-overwiev-icon{
	position:absolute;
	width: 14px;
	height: 14px;
	left: -23px;
	top: 50%;
	margin-top: -7px;
	cursor: pointer;
	z-index:100;
	background-image: url( '../images/icons/chevron-right-solid.svg' );
	background-repeat: no-repeat;
	background-position: center center;
	background-size: 10px;
	-webkit-transition: all 0.5s ease-out;
	-moz-transition: 	all 0.5s ease-out;
	-o-transition: 		all 0.5s ease-out;
	transition: 		all 0.5s ease-out;
}
.orders-overwiev-icon.open{
	transform: rotate(90deg);
}
.orders-overwiev-item-details{
	display:grid;
	position:relative;
	width:100%;
	grid-template-columns: 1fr 1fr 6fr 1fr 1fr 1fr 1fr 1fr;
	align-items: center;
	gap:10px;
	padding:0;
	overflow: hidden;
	height:0;
	background:#01baff;
	color:#ffffff;
	-webkit-transition: all 0.5s ease-out;
  	-moz-transition: 	all 0.5s ease-out;
  	-o-transition: 		all 0.5s ease-out;
  	transition: 		all 0.5s ease-out;
}
.orders-overwiev-item-details.open{
	padding: 10px;
	box-sizing: border-box;
	height:auto;
}
.orders-datepicker{
	width:100%;
	display:flex;
	justify-content: end;
	margin-bottom:20px;
}

/* Cogs popup */
#modal-quickview.cogs-popup .modal__container{
	padding:0;
	width: 600px;
	max-width: 600px;
	min-width: 600px;
}
#modal-quickview.cogs-popup .modal__container .modal__header{
	height:0;
}
.bulk-cogs-overlay{
	position:absolute;
	left:0;
	top:0;
	display: none;
	width:100%;
	height:100%;
	background-color: #ffffffa6;
	align-items:center;
	justify-content:center;
}
.bulk-cogs-overlay.active{
	display:grid;
}
.bulk-cogs-overlay img{
	width: 100px;
	height: 100px;
	animation: rotate-animation 2s infinite linear;
}
@keyframes rotate-animation {
	0% {
		transform: rotate(0deg);
  }
  50% {
		transform: rotate(180deg);
	}
	100% {
		transform: rotate(360deg);
	}
}
.bulk-cogs-header{
	width:100%;
	padding: 0px 20px 20px;
	box-sizing: border-box;
	border-bottom:solid 1px #ececec;
}
.bulk-cogs-header h3{
	margin: 0;
	font-weight:bold;
}
.bulk-cogs-body{
	width:100%;
	padding: 0 20px;
	box-sizing: border-box;
}
.bulk-cogs-body-item{
	width:100%;
	padding: 20px;
	border-bottom:solid 1px #ececec;
	display: grid;
	grid-template-columns: 1fr 8fr;
	align-items: center;
	/* justify-content: space-between; */
	gap: 20px;
	box-sizing: border-box;
}
.bulk-cogs-body-step{
	width:70px;
}
.bulk-cogs-body-step span{
	width: 50px;
	height: 50px;
	color:#ffffff;
	background-color: #01baff;
	border-radius:100px;
	display:flex;
	justify-content: center;
	align-items: center;
	font-size: 24px;
}
.bulk-cogs-body-label{width: auto;display: flex;justify-content: space-between;align-items: center;font-size: 16px;font-weight: bold;}
.slim-button{
	width: 118px;
	padding: 8px 24px;
	color: #2c3338;
	text-decoration:none;
	border-radius: 3px;
	background-color: #ffffff;
	border:solid 1px #ececec;
	box-shadow: none;
	font-size: 14px;
	font-weight: normal;
	line-height: 10px;
	letter-spacing: 1px;
	text-align: center;
}
.slim-button:hover{
	color: #ffffff;
	background-color: #01baff;	
	border:solid 1px #01baff;
}

/* Overview */
.profitblue-page.profitblue-page-profitblue{
	width: 100%;
	border: none;
	background: transparent;
	border-radius: 0px;
	padding: 0px 30px;
	box-sizing: border-box;
	display: grid;
}
.overview-notice{
	width:100%;
	margin-bottom: 30px;
	margin-top: 20px;
	padding: 10px 20px;
	background: #f09898;
	box-sizing: border-box;
	border-radius: 5px;
	border: solid 1px red;
	font-weight: bold;
}
.overview-notice-inner{

}
.overview-notice-text{

}

.overview{
	display:grid;
	width:100%;
	box-sizing: border-box;
}
.overview-header{
	width:100%;
	display:grid;
	grid-template-columns: 1fr 1fr 1fr 1fr 1fr;
	gap:20px;
	row-gap:20px;
}
.overview-header-item{
	width: 100%;
    border: solid 1px #ececec;
    background: #ffffff;
    border-radius: 5px;
    padding: 0px;
    box-sizing: border-box;
    display: grid;

}
.overview-header-item.small-item{
	width: 100%;
	display: flex;
	justify-content: space-between;
	margin: 0;
	padding: 10px 10px;
	box-sizing: border-box;
	font-weight: bold;
}
.overview-header-item-content{
	width:100%;
}
.overview-header-item-content h3{
	margin: 16px 0 0px 0;
	width:100%;
	text-align:center;
	font-size: 20px;
	text-transform: uppercase;
}
.overview-header-item-label{

}
.overview-header-item-value{
	width: 100%;
	text-align: center;
	font-size: 22px;
	font-weight: bold;
	text-transform: uppercase;
	margin: 0;
}
.overview-header-item-footer{

}
.overview-header-item-footer-value{
	color: #01baff;
	width: 100%;
	display: flex;
	justify-content: space-between;
	margin: 0;
	padding: 10px 10px;
	box-sizing: border-box;
	font-weight: bold;
}

.overview-main-graph{
	width: 100%;
	border: solid 1px #ececec;
	background: #ffffff;
	border-radius: 5px;
	padding: 10px 30px;
	box-sizing: border-box;
	display: grid;
	margin-top: 20px;
}
.overview-main-header{
	width:100%;
	display:grid;
	grid-template-columns: 70% 30%;
	gap:20px;
}
.overview-main-header h2{
	width:100%;
	text-align:right;
}


.overview-latest-orders{
	width: 100%;
	border: solid 1px #ececec;
	background: #ffffff;
	border-radius: 5px;
	padding: 10px 30px;
	box-sizing: border-box;
	display: grid;
	margin-top: 20px;
}
.overview-latest-orders-footer{
	width:100%;
	display:flex;
	justify-content: center;
}
.overview-analysis{
	width: 100%;
	display:grid;
	grid-template-columns: 1fr 1fr;
	gap:20px;
}
.overview-analysis-net{
	width:100%;
	border: solid 1px #ececec;
	background: #ffffff;
	border-radius: 5px;
	padding: 10px;
	box-sizing: border-box;
	display: grid;
	margin-top: 20px;
}
.overview-analysis-net-header{
	width:100%;
}
.overview-analysis-net-content{
	width:100%;
	display:grid;
	grid-template-columns: 65% 35%;
	height: 250px;
}
.overview-analysis-net-content-data{
	display: grid;
}
.overview-analysis-net-content-label{
	
}
.overview-analysis-net-item{
	width:100%;
	display: flex;
	justify-content: start;
	align-items: center;
	line-height: 22px;
}
.overview-analysis-net-item-square{
	display: inline-flex;
	width:10px;
	height:10px;
}
.overview-analysis-net-item-text{
	margin-left:10px;
	font-weight: bold;
}

.overview-analysis-custom{
	border: solid 1px #ececec;
	background: #ffffff;
	border-radius: 5px;
	padding: 10px;
	box-sizing: border-box;
	display: grid;
	margin-top: 20px;
}

.overview-analysis-custom-header{
	width:100%;
}
.overview-analysis-custom-content{
	width:100%;
	display:grid;
	grid-template-columns: 1fr 1fr;
}
.overview-analysis-custom-content-data-container{
	display:grid;
	width:100%;
}
.overview-analysis-custom-content-data{
	display:grid;
	width:100%;
	height: 300px;
}
.overview-analysis-custom-content-labels{
	width:100%;
	display:grid;
	grid-template-columns: 1fr 1fr;
}

.overview-ads-analysis{
	width: 100%;
	border: solid 1px #ececec;
	background: #ffffff;
	border-radius: 5px;
	padding: 10px;
	box-sizing: border-box;
	display: grid;
	margin-top: 20px;
}
.overview-ads-analysis-header h3{
	width:100%;
	text-align:center;
}
.overview-ads-analysis-content{width: 100%;}

/* Products analysis */
.overview-product-sold-analysis{
	width: 100%;
	border: solid 1px #ececec;
	background: #ffffff;
	border-radius: 5px;
	padding: 10px;
	box-sizing: border-box;
	display: grid;
	margin-top: 20px;
}
.overview-product-sold-analysis-header{
	width:100%;
	text-align: center;
}
.overview-product-sold-analysis-header h3{
	width:100%;
	text-align: center;
}
.overview-product-sold-analysis-content{
	width:100%;
}
.overview-product-sold-analysis-content>ul.product-sold-menu{
	width: 100%;
	border-bottom: solid 1px #ececec;
	margin-bottom: 20px;
	margin-top: 0;
	display: flex;
	gap: 20px;
	/* margin-left: -10px; */
}
.overview-product-sold-analysis-content>ul.product-sold-menu li{
	cursor: pointer;
	font-weight: bold;
} 
.overview-product-sold-analysis-content ul li.active-item,
.overview-product-sold-analysis-content ul li:hover{
	color:#01baff;
}
.overview-product-carousel-wrap{
	display: grid;
	margin-bottom:30px;
	width: 100%;
	position:relative;	
}
.products-overwiev-tab-target{
	display:none;
	width: 100%;
	max-width: 100%;	
}
.products-overwiev-tab-target.active-tab{
 	display:grid;
}
.overview-product-carousel-bestsellers{
	width: 100%;
	max-width: 100%;	
}
.overview-product-carousel-bestsellers .splide{
	display:grid;
	width:100%;
}
.overview-product-item{
	padding: 10px;
	border: solid 1px #ececec;
	border-radius: 10px;
	width: 100%;
	box-sizing: border-box;
	display:flex;
	flex-direction: column;
}
.overview-product-item-header{
	width:100%;
	display: flex;
	align-items: center;
	border-bottom: solid 1px #ececec;
	padding-bottom: 5px;
	box-sizing: border-box;
}
.overview-product-item-header img{
	width: 40px;
	height: auto;
	display: flex;
}
.overview-product-item-header h3{
	font-size: 12px;
	font-weight: bold;
	color: #01baff;
	margin: 0;
}
.overview-product-item-content{
	width:100%;
	padding: 5px;
}
.overview-product-item-content p{margin: 0;line-height: 1.5;}
.overview-product-item-content p span{
	font-weight:bold;
	font-size:18px;
	margin-left: 20px;
}

body .splide__arrow{
	top:50%;
}
.splide__arrow{
	border: solid 10px #ffffff!important;
    opacity: 1!important;
}
.splide__arrow--prev{
	margin-left:-20px;
}
.splide__arrow--next{
	margin-right:-20px;
}

.product-overwiev-footer{
	width:100%;
	display:flex;
	justify-content: center;
	margin:20px 0;
}
.product-overwiev-footer a{
	
}
/* Category analysis */
.select2-container{
	width:100%;
}
.overview-category-sold-analysis{
	width: 100%;
	border: solid 1px #ececec;
	background: #ffffff;
	border-radius: 5px;
	padding: 10px;
	box-sizing: border-box;
	display: grid;
	margin-top: 20px;
}
.overview-category-sold-analysis-header{
	width:100%;
}
.overview-category-sold-analysis-header h3{
	width:100%;
	text-align:center;
}


.overview-category-sold-analysis-content{
	width:100%;
}
.overview-category-container{
	width:100%;
	display: grid;
	grid-template-columns: 1fr 1fr 1fr 1fr;
	gap:20px;
}
.overview-category-item{
	padding: 10px;
	border: solid 1px #ececec;
	border-radius: 10px;
}
.overview-category-item-header{
	width:100%;
	display: flex;
	align-items: center;
	border-bottom: solid 1px #ececec;
	padding-bottom: 5px;
}
.overview-category-item-header img{
	width: 40px;
	height: 40px;
	display: flex;
}
.overview-category-item-header h3{
	font-size: 12px;
	font-weight: bold;
	color: #01baff;
	margin: 0;
}
.overview-category-item-content{
	width:100%;
	padding: 5px;
}
.overview-category-item-content p{margin: 0;line-height: 1.5;}
.overview-category-item-content p span{
	font-weight:bold;
	font-size:18px;
	margin-left: 20px;
}
.overview-category-item-select{
	padding: 10px 0;
	height: fit-content;
	box-sizing: border-box;
	overflow: hidden;
	cursor: pointer;
	position: relative;
	height: 81px;
}
.overview-category-item-select.open{
	height: 190px;
}
.category-select-dropdown{
	height:100%;
	overflow-x: scroll;
	position: absolute;
	left: 0;
	width: 100%;
	padding: 10px 0 10px 0;
	box-sizing: border-box;
}
.category-select-dropdown ul li{
	cursor: pointer;
	padding: 5px;
	margin: 0;
	border-bottom: solid 1px #ededed;
}
.category-select-dropdown ul li:hover{
	background:#ededed;
}



/* Progress bar */
.modal-progress-bar{
	width:100%;
}
.modal-progress-bar-inner{
	width:100%;
	height:10px;
	background-color: #b9b9b9;
	position:relative;
	margin-bottom: 20px;
	margin-top: 20px;
}
.modal-progress-value{
	position:absolute;
	left:0;
	top:0;
	height:10px;
	width:0%;
	background-color:#01baff;
}

.modal-spinner{
	display:none;
	width: 100%;
	justify-content: center;
	margin-top: 20px;
}
.modal-spinner-img{
	width: 30px;
	height: 30px;
	background-image: url( '../images/icons/spinner-solid.svg' );
	background-position: center center;
	background-repeat: no-repeat;
	background-size: 30px;
	animation: rotation 2s infinite linear;
}

/* Shipping period */
.shipping-overwiev-periods{
	width:100%;
	display:flex;
}
.shipping-overwiev-periods-inner{
	width:100%;
	display:flex;
	justify-content: space-between;
	margin-bottom: 20px;
}
.shipping-overwiev-periods-custom{
	display:flex;
	flex-direction: column;
}
.shipping-overwiev-periods-custom.hidden{
	height:0px;
	overflow: hidden;
	opacity:0;
}
.shipping-overwiev-periods-data{
	width:100%;
	display:grid;
	grid-template-columns: 1fr 1fr 1fr 1fr;
}
.shipping-overwiev-periods-data .data-item{
	background-color: #ffffff;
	border: solid 1px #ececec;	
}
.shipping-overwiev-periods-data .data-item .data-item-year{
	border-bottom: solid 1px #ececec;
	padding:5px 10px;
	font-weight:bold;
}
.shipping-overwiev-periods-data .data-item .data-item-dates{
	padding:5px 10px;
}
.shipping-overwiev-periods-select{
	padding-top: 20px;
	gap: 10px;
	display: flex;
	flex-direction: column;
}
.shipping-period{
	display:flex;
	flex-direction: column;
	gap: 10px;
	/* position: relative; */
}
.shipping-period.hidden{
	height:0px;
	overflow: hidden;
	opacity:0;
}
.shipping-datepicker-datepicker{
	border-radius: 0!important;
	border: solid 1px #9e9e9e!important;
	padding: 4px 10px 4px 30px!important;
	background-color: #ffffff!important;
}
.btn.save-shipping-custom{
	font-size: 14px;
	padding: 5px 5px;
	text-align: center;
}

/* Profit and loss */
.profitblue-page.profitblue-page-profit-and-loss{
	border:none;
	background:none;
	padding:0;
	overflow: hidden;
}
.profit-and-loss{
	width:100%;
	display:grid;
	grid-template-columns: 400px auto;
	overflow: hidden;
}
.profit-and-loss-labels{
	width:400px;
	border-bottom:solid 1px #000000;
	border-top: solid 1px transparent;
	padding-top: 20px;
	flex-shrink: 0;
}
.profit-and-loss-labels-container{
	width:100%;
}
.profit-and-loss-labels-inner{
	width:100%;
}
.profit-and-loss--months-inner .profit-and-loss-months-item:nth-child(13){
	/*width:110px;*/
}
.profit-and-loss-labels-title{
	background-color: #02cbff;
	color:#ffffff;
	width:100%;
	font-size:12px;
	font-weight:600;
	line-height: 22px;
	border-right:solid 1px #02cbff;
	border-left: solid 1px #000000;
	border-right: 1px solid #000000;
	padding:0 3px 0 3px;
	box-sizing: border-box;
}
.profit-and-loss-labels-item{
	position:relative;
	color:#000000;
	background-color: #ffffff;
	width:100%;
	font-size:12px;
	line-height: 22px;
	border-right:solid 1px #000000;
	border-left: solid 1px #000000;
	padding:0 3px 0 30px;
	box-sizing: border-box;
	overflow: hidden;
}
.profit-and-loss-labels-subtitle{
	position:relative;
	color:#000000;
	background-color: #9aebff;
	font-weight:bold;
	width:100%;
	font-size:12px;
	line-height: 22px;
	border-right: solid 1px #000000;
	border-left: solid 1px #000000;
	padding:0 3px 0 3px;
	box-sizing: border-box;
}
.profit-and-loss-labels-footer{
	color:#ffffff;
	background-color: #fe0000;
	font-weight:bold;
	width:100%;
	font-size:12px;
	line-height: 22px;
	border-right: solid 1px #000000;
	border-left: solid 1px #000000;
	padding:0 3px 0 3px;
	box-sizing: border-box;
}


.profit-and-loss-months{
	width: auto!important;
	/*max-width:1200px!important;*/
	flex-shrink: 0;
	cursor: pointer;
}
.profit-and-loss-months-container{
	width:100%;
	overflow: hidden;
	white-space: nowrap;
}
.profit-and-loss--months-inner{
	width:100%;
	display: flex;
}
.profit-and-loss-months-item{
	border-bottom: solid 1px #000000;
}
.profit-and-loss-months-item>div{
	position:relative;
	padding-right: 35px;
	margin: 0;
}
.pnl-percent{
	position:absolute;
	right: 4px;
	top:0;
	font-size: 8px;
	line-height:22px;
	width: 24px;
	color: #000000;
	border-left: solid 1px #000000;
	text-align: right;
}
.profit-and-loss-month-label{
	background-color: #000000;
	color:#ffffff;
	width:100%;
	font-size:12px;
	line-height: 22px;
	border-right:solid 1px #000000;
	text-align: center;
	box-sizing: border-box;
}
.profit-and-loss-month-main{
	background-color: #02cbff;
	color:#ffffff;
	width:100%;
	min-width: 100px;
	font-size:12px;
	line-height: 22px;
	border-right: solid 1px #000000;
	padding:0 3px 0 3px;
	text-align: right;
	box-sizing: border-box;
}
.profit-and-loss-month-sub{
	overflow: hidden;
	color:#000000;
	background-color: #9aebff;
	font-weight:bold;
	width:100%;
	font-size:12px;
	line-height: 22px;
	border-right: solid 1px #000000;
	padding:0 3px 0 3px;
	text-align: right;
	box-sizing: border-box;
}
.profit-and-loss-month-item{
	color:#000000;
	background-color: #ffffff;
	width: 100%;
	font-size:12px;
	line-height: 22px;
	border-right:solid 1px #000000;
	padding:0 3px 0 3px;
	text-align: right;
	box-sizing: border-box;
}
.profit-and-loss-month-footer{
	color:#ffffff;
	background-color: #fe0000;
	width: 100%;
	min-width: 100px;
	font-size:12px;
	line-height: 22px;
	border-right:solid 1px #000000;
	padding:0 3px 0 3px;
	text-align: right;
	box-sizing: border-box;
}

.bottom-blue{
	border-bottom:solid 1px #9aebff;
}

.pl-60{
	padding-left:60px;
}

.profit-and-loss-periods-inner{
	width:100%;
	display: flex;
	justify-content: end;
}

/* Email notification */

.section-line-label{
	font-weight:bold;
}
.notifications-report-input{
	display:grid;
	justify-content:end;
	position:relative;
	height:22px;
}
.notifications-report-input input[type=checkbox] {
	position: absolute;
	left:0;
	top:0;
	width:0;
	height:0;
	opacity:0;
}

.notifications-report-input .checkbox-switcher{
	position:absolute;
	top:50%;
	left:100%!important;
	width:50px;
	height:22px;
	border-radius:20px;
	background:#ededed;
	margin-left:-50px;
	margin-top:-11px;
	cursor:pointer;
}
.notifications-report-input .checkbox-switcher::before{
	width:18px;	
	height:18px;
	position:absolute;
	left:2px;
	top:2px;
	content:'';
	border-radius:10px;
	background-color:#ffffff;
}
.notifications-report-input .checkbox-switcher.active{
	background-color: #02cbff;
}
.notifications-report-input .checkbox-switcher.active::before{
	left:28px;
}
.pnl-dropdown{
	position:absolute;
	right: 3px;
	top: 3px;
	width: 16px;
	height: 16px;
	background-color:#c4c4c4;
	border-radius: 2px;
	cursor: pointer;
}
.pnl-dropdown::before{
	position:absolute;
	left:50%;
	top:50%;
	width:8px;
	height:2px;
	background-color:#000000;
	margin-left:-4px;
	margin-top:-1px;
	content:'';
}
.pnl-dropdown.closed::after{
	position:absolute;
	left:50%;
	top:50%;
	width:2px;
	height:8px;
	background-color:#000000;
	margin-left:-1px;
	margin-top:-4px;
	content:'';
}
.pnl-dropdown:hover{
	background-color:#ededed;
}
.profit-and-loss-month-main .pnl-e{
	font-weight:600;
}
.pnl-export-wrap{
	width:100%;
	margin-bottom:10px;
	margin-top:10px;
}
.pnl-export-inner{
	width:100%;
}
.pnl-export .pnl-export-inner a{
	width:fit-content;
}


@keyframes spin {
	0% { transform: rotate(0deg); }
	100% { transform: rotate(360deg); }
}
.modal-spinner-container{
	width: 100%;
    display: grid;
    justify-content: center;
}
.modal-spinner {
	display: inline-block; /* Allows transform */
	animation: spin 2s linear infinite;
}
.modal-spinner svg {
	width:30px;
}

.wizard-overlay{
	position:absolute;
	left:0;
	top:0;
	width:100%;
	height:100%;
	background-color: #000000;
	opacity:0.5;
	z-index:9;
}
.wizard-active-div{
	position:relative;
	z-index:10;
	background-color: #ffffff;
}
.wizard-active-div.btn{
	background-color: #01baff;
}
.shipping-list.wizard-active-div,
.shipping-list-item.wizard-active-div,
.form-section-line.wizard-active-div{
	padding-top:10px;
	padding-bottom:10px;
}
.form-section-inner.wizard-active-div{
	padding:10px;
}

.wizard-tooltip{
	width:100%;
	max-width:400px;
	padding:20px;
	border-radius:10px;
	background-color: #ffffff;
	position:absolute;
	top:100px;
	left:50%;
	-webkit-box-shadow: 0px 0px 13px 0px rgba(179,179,179,1);
	-moz-box-shadow: 0px 0px 13px 0px rgba(179,179,179,1);
	box-shadow: 0px 0px 13px 0px rgba(179,179,179,1);
	display:none;
	z-index:11;
}
.wizard-tooltip-inner{
	width:100%;
	position: relative;
    z-index: 10;
}
#wizard-tooltip-title{
	margin:0;
}
#wizard-tooltip-content{
	width:100%;
}
.wizard-tooltip-nav{
	width:100%;
	display:flex;
	justify-content: space-between;
	padding:10px 0 0 0;
}
.skip-wizard{
	cursor:pointer;
}
.wizard-next-step{
	display: inline-block;
    padding: 1px 12px;
    margin-bottom: 0;
    font-size: 14px;
    font-weight: 500;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
    vertical-align: middle;
    cursor: pointer;
    background-image: none;
	background-color: #01baff;
	color:#ffffff;
    border: 1px solid transparent;
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    -o-user-select: none;
    user-select: none;
    -webkit-border-radius: 3px;
    -moz-border-radius: 3px;
    border-radius: 3px;
    border: 1px solid transparent;
    -webkit-box-shadow: inset 0px -2px 0px 0px rgba(0, 0, 0, 0.09);
    -moz-box-shadow: inset 0px -2px 0px 0px rgba(0, 0, 0, 0.09);
    box-shadow: inset 0px -1px 0px 0px rgba(0, 0, 0, 0.09);
}
.wizard-next-step:hover{
	color:#000000;
}
.triangle-bottom-left{
	position: absolute;
    left: 40px;
    bottom: -45px;
    width: 0px;
    height: 0px;
    border-style: solid;
    border-width: 110px 53.5px 0 53.5px;
    border-color: #ffffff transparent transparent transparent;
    transform: rotate(40deg);
}
.triangle-bottom-right{
	position: absolute;
    right: 40px;
    bottom: -45px;
    width: 0px;
    height: 0px;
    border-style: solid;
    border-width: 110px 53.5px 0 53.5px;
    border-color: #ffffff transparent transparent transparent;
    transform: rotate(320deg);
}
.triangle-top-left{
	position: absolute;
    left: 40px;
    top: -45px;
    width: 0px;
    height: 0px;
    border-style: solid;
    border-width: 0px 53.5px 110px 53.5px;
    border-color: transparent transparent #ffffff transparent;
    transform: rotate(320deg);
}
.triangle-top-right{
	position: absolute;
    right: 40px;
    top: -45px;
    width: 0px;
    height: 0px;
    border-style: solid;
    border-width: 0px 53.5px 110px 53.5px;
    border-color: transparent transparent #ffffff transparent;
    transform: rotate(40deg);
}
.deactivate-list{
	width:100%;
}
.deactivate-list-header{
	width: 100%;
    padding: 20px;
    padding-top: 0;
    box-sizing: border-box;
}
.deactivate-list-header p{
	font-weight: 500;
}
.deactivate-list-footer{
	width:100%;
	display:flex;
	justify-content: space-between;
	padding:20px;
	box-sizing: border-box;
}


/* Licence page */
.licence-line{
	width:100%;
	display:flex;
	gap:20px;
}
#profitblue-licence.licence-input {
    width: 450px;
    display: flex;
    align-items: center;
    position: relative;
    border: solid 1px #ececec;
    padding: 8px 0px 8px 24px;
    box-sizing: border-box;
    border-radius: 0;
    font-size: 14px;
    line-height: 14px;
}
.deactivate-licence.btn{
	background:red;
}
#profitblue-licence.licence-input.error{
	border: solid 1px red;
	background:#ffe3e3;
}
.save-licence.btn,
.deactivate-licence.btn{
	border-radius:0;
	padding:7px 30px
}
.form-section-line.licence-line.error-line{
	margin-top:20px;
	font-size:17px;
	font-weight:bold;
	color:red;
}
.form-section-line.licence-line.success-line{
	margin-top:20px;
	font-size:17px;
	font-weight:bold;
	color:green;
}
.form-section-line.licence-line.success-line .black-color{
	color:#000000;
}
.ads_total-container{
	width:100%;
	display:grid;
	justify-content: center;
	margin-bottom:20px;
}
.ads_total{
	width:fit-content;
	display:flex;
	gap:40px;
	padding:10px 30px;
	border:solid 2px #01baff;
	border-radius:30px;
	color:#01baff;
	font-weight:bold;
}

/* Install modal */
.install-modal{
	position:absolute;
	left:0;
	top:0;
	width:100vw;
	height:100%;
	background-color: #0000009d;
	display:none;
	justify-content: center;
	padding-top:200px;
	z-index:100;
}
.install-modal-container{
	background:#ffffff;
	width:500px;
	height:fit-content;
	padding:20px;
	border-radius: 10px;
}
.install-modal-content{
	
}

