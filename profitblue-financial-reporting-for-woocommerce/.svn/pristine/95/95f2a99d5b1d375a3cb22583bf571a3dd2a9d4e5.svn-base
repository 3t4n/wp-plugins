}

.product-overwiev-item{
	width:100%;
	display:grid;
	grid-template-columns: 1fr 1fr 4fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr;
	border-top: solid 1px #ececec;
	align-items: center;
	gap:10px;
}
.product-overwiev-item-image{
	padding:10px 0;
}
.product-overwiev-item-image img{
	display: flex;
	margin:0;
	width: 40px;
	height: auto;
	border: solid 1px #ececec;
}
.product-overwiev-item-sku{

}
.product-overwiev-item-name{
}
.product-overwiev-item-type{

}
.product-overwiev-item-status{

}
.product-overwiev-item-stock{

}
.product-overwiev-item-sales{

}
.product-overwiev-item-price{

}
.product-overwiev-item-revenue{

}
.product-overwiev-item-cogs{

}
.product-overwiev-item-margin{

}
.product-overwiev-item-percent{

}
.product-overwiev-item-detail{
	display:flex;
	align-items: center;
	justify-content: start;
}
.product-overwiev-item-detail a{
	text-decoration:none;
	/* padding:4px; */
	background:#ea3223;
	width: 22px;
	height: 22px;
	border-radius: 3px;
