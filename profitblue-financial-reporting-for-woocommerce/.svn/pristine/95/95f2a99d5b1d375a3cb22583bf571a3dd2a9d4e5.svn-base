.easepick-wrapper>.container.show{

}
.container.show{
	right:0!important;
}
.wp-admin #wpfooter{
	display:none;
}
.form-error{
	border:solid 1px #ea3223!important;
}
.profitblue-wrap{
	padding-left:30px;
	padding-right:30px;
}

.profitblue-page{
	width:100%;
	border: solid 1px #ececec;
	background:#ffffff;
	border-radius:3px;
	padding:30px;
	box-sizing: border-box;
	display: grid;
}
.page-description-has-filter{
	display: flex;
	gap:20px;
}
.page-description-has-filter p{
	width:100%;
}

.page-save-button{
	width:100%;
	margin:30px 0;
	display:flex;
	justify-content: end;
}
/* Buttons */
.btn{
	padding: 6px 12px;
	color: #ffffff;
	text-decoration:none;
	border-radius: 3px;
	background-color: #01baff;
	border:none;
	box-shadow: none;
	font-size: 14px;
	letter-spacing: 1px;
}

.blocks-section{
	width:100%;
	margin-bottom:20px;
}
.blocks-section h2{
	margin-top:0;
}
.blocks-section-inner{
	width:100%;
	display:grid;
	grid-template-columns: 1fr 1fr 1fr;
	gap:20px;
	row-gap:20px;
}
.block-item{
	display:flex;
	background-color: #f8f8f8;
	padding:10px;
	text-decoration:none;
	gap: 20px;
	border:solid 1px #e6e6e6;
	border-radius:10px;
}
.block-item img{
	width: 50px;
}
.block-item-content h3{
	margin-bottom:0;
	margin-top: 0;
}
.block-item-content p{
	margin-bottom:0;
	margin-top: 0;
	color: #1d2327;
}

.form-section-inner{
	width:100%;
	display:grid;
	gap: 10px;
	row-gap: 15px;
}
.form-section-line{
	width:100%;
	display:grid;
	grid-template-columns: 3fr 2fr 2fr 3fr;
	gap: 20px;
}
.form-section-line.line-3-2-2-3{
	grid-template-columns: 3fr 2fr 2fr 3fr;
}
.form-section-line.line-3-2-2{
	grid-template-columns: 3fr 2fr 2fr;
	align-items: center;
	border-bottom: solid 1px #ececec;
	row-gap: 0;
	padding: 10px 0;
}
.form-section-line.notifications-report-line{
	grid-template-columns: 1fr 1fr;
	align-items: center;
	border-bottom: solid 1px #ececec;
	row-gap: 0;
	padding: 10px 0;
}
.form-section-line.line-3-1{
	grid-template-columns: 3fr 1fr;
}
.section-line-label>span{
	padding-right:20px;
	font-weight:bold;
}

.tooltip-wrap{
	position:relative;
}
.tooltip-icon{
	position:absolute;
	right:0;
	top: -4px;
	border-radius:20px;
	display:flex;
	justify-content: center;
	align-items: center;
	cursor:pointer;
}
.tooltip-icon svg{
	fill: #c1c1c1;
	color: #c1c1c1;
	width: 14px;
	height: 14px;
}
.tooltip-label{
	position:relative;
	font-weight:normal;
	position:absolute;
	background:#ffffff;
	bottom:100%;
	width:200px;	
	border-radius:5px;
	margin-left:-100px;
	margin-bottom:12px;
	height: 0;
    max-height: 0;
    overflow: hidden;
    padding: 0;
    border: none;
	-webkit-transition: max-height 0.15s ease-out;
  	-moz-transition: max-height 0.15s ease-out;
  	-o-transition: max-height 0.15s ease-out;
  	transition: max-height 0.15s ease-out;
}
.tooltip-label::before{
	content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 10px;
    height: 10px;
    background-color: #ffffff;
    border-left: solid 1px #ececec;
    border-bottom: solid 1px #ececec;
    margin-left: -4px;
    margin-bottom: -6px;
    transform: rotate(-45deg);
}
.tooltip:hover .tooltip-label{
	height:auto;
	max-height: 100%;
	min-height:40px;
	padding:10px;
	border: solid 1px #ececec;
	overflow: visible;
	display:grid;
	align-items: center;
}

/* Year filter */
.cost-year-filter{
	width: 320px;
	min-width: 320px;
	position: relative;
}
.cost-year-filter select{
	width:100%;
}
.year-filter-datepicker{
	position:absolute;
	left:0;
	top: 30px;
	display: block;
	width: 100%;
	height: auto;
}
.year-filter-datepicker input{
	display:none;
	width: 100%;
	margin-top: 10px;
	background: #ffffff;
	border: solid 1px #ececec;
	padding: 6px 10px;
}
/* Products table */
.products-list{
	width:100%;
	position:relative;
}
.product-lists-header{
	width:100%;
	display:grid;
	grid-template-columns: 100px 70px auto 100px 200px;
	gap:10px;
	padding:10px 0;
	background-color: #ffffff;
	z-index:101;
}
.wizard .product-lists-header{
	z-index:1;
}
.product-lists-header.fixed{
	border-bottom:#ededed 1px solid;
	padding-right:30px;
	padding-left:30px;
	margin-left:-30px;
}
.product-lists-header-image{
	font-weight: bold;
}
.product-lists-header-sku{
	font-weight: bold;
}
.product-lists-header-name{
	font-weight: bold;
}
.product-lists-header-price{
	font-weight: bold;
}
.product-lists-header-cogs{
	font-weight: bold;
}

.product-lists-item{
	width:100%;
	display:grid;
	grid-template-columns: 100px 70px auto 100px 200px;
	border-top: solid 1px #ececec;
	align-items: center;
	gap:10px;
}
.product-lists-item-image{
	padding:10px 0;
}
.product-lists-item-image img{
	display: flex;
	margin:0;
	width: 40px;
	height: auto;
	border: solid 1px #ececec;
}
.product-lists-item-sku{

}
.product-lists-item-name{

}
.product-lists-item-price{

}
.product-lists-item-cogs input{
	max-width:100px;
	display:flex;
	align-items: center;
	position:relative;
	border: solid 1px #ececec;
	padding: 4px 0px 4px 20px;
	box-sizing: border-box;
	border-radius:0;
	font-size:14px;
	line-height:14px;
	margin: 0;
}

.no-cogs{
	background-color: #f0c3bf!important;
	border:solid 1px #ea3223!important;
}
/* Products overwiev periods */
.product-overwiev-periods{
	width:100%;
	display:flex;
}
.product-overwiev-periods-inner{
	width:100%;
	display:flex;
	justify-content: space-between;
	margin-bottom: 20px;
}
.product-overwiev-periods-custom{
	display:flex;
	flex-direction: column;
}
.product-overwiev-periods-custom.hidden{
	height:0px;
	overflow: hidden;
	opacity:0;
}
.product-overwiev-periods-data{
	width:100%;
	display:grid;
	grid-template-columns: 1fr 1fr 1fr 1fr;
}
.product-overwiev-periods-data .data-item{
	background-color: #ffffff;
	border: solid 1px #ececec;	
}
.product-overwiev-periods-data .data-item .data-item-year{
	border-bottom: solid 1px #ececec;
	padding:5px 10px;
	font-weight:bold;
}
.product-overwiev-periods-data .data-item .data-item-dates{
	padding:5px 10px;
}
.product-overwiev-periods-data .data-item-date{
	padding-right:30px;
	position:relative;
}
.product-overwiev-periods-data .data-item-date .data-item-delete{
	display: grid;
	width:20px;
	height:20px;
	position:absolute;
	right:0;
	top:5px;
	cursor:pointer;
}
.product-overwiev-periods-data .data-item-date .data-item-delete::before{
	width:2px;
	height:10px;
	content:'';
	position:absolute;
	top:0;
	left:50%;
	margin-left:-1px;
	background:#ea3223;
	transform: rotate(45deg);
}
.product-overwiev-periods-data .data-item-date .data-item-delete::after{
	width:2px;
	height:10px;
	content:'';
	position:absolute;
	top:0;
	left:50%;
	margin-left:-1px;
	background:#ea3223;
	transform: rotate(135deg);
}
.product-overwiev-periods-select{
	padding-top: 20px;
	gap: 10px;
	display: flex;
	flex-direction: column;
}
.product-period{
	display:flex;
	flex-direction: column;
	gap: 10px;
}
.product-period.hidden{
	height:0px;
	overflow: hidden;
	opacity:0;
}
.product-datepicker-datepicker{
	border-radius: 0!important;
	border: solid 1px #9e9e9e!important;
	padding: 4px 10px 4px 30px!important;
	background-color: #ffffff!important;
}
.btn.save-product-custom{
	font-size: 14px;
	padding: 5px 5px;
	text-align: center;
}

/* Products overwiev table */
.products-overwiev{
	width:100%;
}
.product-overwiev{
	position:relative;
}
.product-overwiev-header{
	width:100%;
	display:grid;
	grid-template-columns: 1fr 1fr 4fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr;
	gap:10px;
	padding:10px 0;
	background-color: #ffffff;
}
.product-overwiev-header.fixed{
	border-bottom:#ededed 1px solid;
	padding-right:30px;
	padding-left:30px;
	margin-left:-30px;
}
.product-overwiev-header-image,
.product-overwiev-header-sku,
.product-overwiev-header-name,
.product-overwiev-header-type,
.product-overwiev-header-status,
.product-overwiev-header-stock,
.product-overwiev-header-sales,
.product-overwiev-header-price,
.product-overwiev-header-revenue,
.product-overwiev-header-cogs,
.product-overwiev-header-margin,
.product-overwiev-header-percent,
