@use "sass:color";

$scheme-name: "akari";
$text-color: #F4FEF8;
$base-color: #23282d;
$icon-color: #9ba2a6;
$highlight-color: #064F55;
$notification-color: #d54e21;

$button-color: #064F55;

$body-background: #f7f7f7;

$menu-submenu-text: #fff;
$menu-submenu-focus-text: #fff;
$menu-submenu-background: #2c3338;

$dashboard-icon-background: $highlight-color;
$link: #064F55;

.notice-warning {
    background-color: #fdfdfd !important;
    border-left-color: #064F55;
}

.e-major-update-warning__separator {
    border: 1px solid #064F55 !important;
}

@import "_admin.scss";
