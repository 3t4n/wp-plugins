#: class.formdesigner.php:72
msgid "Settings"
msgstr "Настройки"

#: class.formdesigner.php:142
msgid "Forms are being loaded..."
msgstr "Идет загрузка форм..."

#: class.formdesigner.php:143
msgid "Choose form"
msgstr "Выбрать форму"

#: class.formdesigner.php:144
msgid "-- choose a form --"
msgstr "-- выберите форму --"

#: class.formdesigner.php:145 views/popup.php:36
msgid "Insert form"
msgstr "Вставить форму"

#: class.formdesigner.php:146
msgid "Align left"
msgstr "Выравнивание по левому краю"

#: class.formdesigner.php:147
msgid "Align center"
msgstr "Выравнивание по центру"

#: class.formdesigner.php:148 views/popup.php:10
msgid "FormDesigner form list"
msgstr "Список форм FormDesigner"

#: class.formdesigner.php:186
msgid "FormDesigner Web Form Builder"
msgstr "Конструктор веб-форм FormDesigner"

#: class.formdesigner.php:289
msgid "Unable to find a template"
msgstr "Не удается найти шаблон"

#: class.formdesigner.php:341
msgid "Unable to retrieve form list"
msgstr "Не удается получить список форм"

#: views/popup.php:27
msgid "Select the form to be inserted"
msgstr "Выберите форму для вставки"

#: views/popup.php:40
msgid "You do not have any forms created. Go to the"
msgstr "У вас нет созданных форм. Перейдите в раздел"

#: views/popup.php:42
msgid "menu and create your first form"
msgstr "и создайте свою первую форму"
