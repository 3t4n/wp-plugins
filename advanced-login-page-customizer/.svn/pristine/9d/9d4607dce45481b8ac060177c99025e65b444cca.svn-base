.ols-ui{--ols-app-border-radius:5px;--ols-app-primary-color:#890f4c;--ols-app-secondary-color:#e7cfdb}.ols-ui .ols-container>*{box-sizing:border-box;margin:0 auto;max-width:1200px}.ols-ui .ols-settings-header{background:var(--ols-app-primary-color);color:#fff;margin-left:-20px;padding:1rem}.ols-ui .ols-settings-header h3{color:#fff;font-size:30px;line-height:1}.ols-ui .ols-settings-header>*{align-items:center;display:flex;gap:1rem;justify-content:space-between;margin:0 auto;max-width:1200px}.ols-ui .ols-settings-tabs{display:flex;margin:2rem auto;max-width:1200px}.ols-ui .ols-settings-tabs>.components-tab-panel__tabs{flex-direction:column;min-width:min(200px,100%)}.ols-ui .ols-settings-tabs>.components-tab-panel__tabs:not(:has(:nth-child(2))){display:none}.ols-ui .ols-settings-tabs>.components-tab-panel__tabs:not(:has(:nth-child(2)))+.components-tab-panel__tab-content h3{display:none}.ols-ui .ols-settings-tabs>.components-tab-panel__tabs .components-button{font-size:16px}.ols-ui .ols-settings-tabs>.components-tab-panel__tabs .components-button:hover{color:#890f4c}.ols-ui .ols-settings-tabs>.components-tab-panel__tabs .active-tab{background-color:#fff;border-radius:var(--ols-app-border-radius) 0 0 var(--ols-app-border-radius);box-shadow:-4px 0 5px #efeeee;color:#890f4c}.ols-ui .ols-settings-tabs>.components-tab-panel__tab-content{background-color:#fff;border-radius:var(--ols-app-border-radius);box-shadow:0 0 5px #efeeee;flex:1;margin-left:-3px;padding:0 2rem 2rem}
