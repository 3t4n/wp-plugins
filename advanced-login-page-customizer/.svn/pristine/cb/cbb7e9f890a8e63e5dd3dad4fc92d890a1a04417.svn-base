{
  "title": "Login Form",
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "alpc/login-form",
  "attributes": {
    "settings": {
      "type": "object",
      "default": {
        "username": "Username or Email Address",
        "password": "Password",
        "remember": "Remember Me",
        "login": "Login In",
        "username_placeholder": "Username or Email Address",
        "password_placeholder": "Password"
      }
    },
    "styles": {
      "type": "object",
      "default": {
        "form": {},
        "label": {},
        "textField": {},
        "placeholder": {},
        "checkbox": {},
        "button": {}
      }
    }
  },
  "supports": {
    "anchor": true,
    "html": false,
    "align": [
      "center",
      "wide",
      "full"
    ]
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css"
}