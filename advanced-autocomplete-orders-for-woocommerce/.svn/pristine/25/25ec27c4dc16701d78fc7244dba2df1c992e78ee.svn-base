#hawo_meta_settings .inside{margin:0;padding:0}.hawo-metabox-wrapper h4{font-size:14px;margin:0 0 10px}.hawo-metabox-wrapper button:not(.hpcl-delete-btn){background:#f7f7f7;border:1px solid #ccc;border-radius:3px;box-shadow:0 2px 1px 0 #ccc;color:#575a6c;cursor:pointer;line-height:1;padding:7px 15px}.hawo-metabox-wrapper button:not(.hpcl-delete-btn) svg{align-items:center;display:flex;justify-content:center}.hawo-metabox-wrapper .hpcl-metabox-content{align-items:stretch;display:flex;justify-content:flex-start;width:100%}.hawo-metabox-wrapper .hpcl-metabox-content .hpcl-rule-header-wrapper{background:#f0f0f1;border-left:2px solid #e3e3e3;padding:20px;width:215px}.hawo-metabox-wrapper .hpcl-metabox-content .hpcl-rule-header-wrapper h4{font-weight:700}.hawo-metabox-wrapper .hpcl-metabox-content .hpcl-rule-header-wrapper p{margin:0;padding:0}.hawo-metabox-wrapper .hpcl-metabox-content .hpcl-field-group{padding:20px;width:calc(100% - 215px)}.hawo-metabox-wrapper .hpcl-metabox-content .hpcl-field-group h5{font-size:14px;margin:0 0 10px}.hawo-metabox-wrapper .hpcl-metabox-content .hpcl-field-group .hpcl-select-group-fields .hpcl-selets-wrapper{align-items:center;display:flex;justify-content:flex-start;margin-bottom:10px}.hawo-metabox-wrapper .hpcl-metabox-content .hpcl-field-group .hpcl-select-group-fields .hpcl-selets-wrapper input,.hawo-metabox-wrapper .hpcl-metabox-content .hpcl-field-group .hpcl-select-group-fields .hpcl-selets-wrapper select{border-color:#ccc;margin-left:8px;min-width:200px}.hawo-metabox-wrapper .hpcl-metabox-content .hpcl-field-group .hpcl-select-group-fields .hpcl-selets-wrapper .hpcl-and-btn{margin-left:8px}.hawo-metabox-wrapper .hpcl-metabox-content .hpcl-field-group .hpcl-select-group-fields .hpcl-selets-wrapper .hpcl-delete-btn{background:none;border:none;cursor:pointer;display:none;padding:0}.hawo-metabox-wrapper .hpcl-metabox-content .hpcl-field-group .hpcl-select-group-fields .hpcl-selets-wrapper .hpcl-delete-btn path{fill:#f22222}.hawo-metabox-wrapper .hpcl-metabox-content .hpcl-field-group .hpcl-select-group-fields .hpcl-selets-wrapper:last-child{margin-bottom:0}.hawo-metabox-wrapper .hpcl-metabox-content .hpcl-field-group .hpcl-select-group-fields .hpcl-selets-wrapper:hover .hpcl-delete-btn{display:flex}.hawo-metabox-wrapper .hpcl-metabox-content .hpcl-field-group .hpcl-select-group-fields:first-of-type .hpcl-selets-wrapper:first-child:hover .hpcl-delete-btn{display:none}.hawo-metabox-wrapper .hpcl-metabox-content .hpcl-field-group .hpcl-rule-group-or-label{margin:15px 0 5px}.hawo-metabox-wrapper .hpcl-metabox-content .hpcl-field-group .hpcl-add-rule-group-btn{margin-top:20px}
