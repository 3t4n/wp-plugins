.ben .d-none{display:none !important}.ben .d-block{display:block !important}.ben .ben-block-editor-ui i.dashicons{font-size:16px;width:auto;height:auto;margin:0 2px;top:1px;position:relative}.ben .ben-block-editor-ui .button-group{display:flex;align-items:center;justify-content:space-between}.ben .ben-block-editor-ui .button-group .components-button.is-primary,.ben .ben-block-editor-ui .button-group .button.button-primary{border-radius:0;display:flex;align-items:center;justify-content:center;min-height:36px;width:50%}.ben .ben-block-editor-ui .button-group .components-button.is-primary:first-child,.ben .ben-block-editor-ui .button-group .button.button-primary:first-child{border-top-left-radius:4px;border-bottom-left-radius:4px;border-right:1px solid rgba(34,34,34,.1)}.ben .ben-block-editor-ui .button-group .components-button.is-primary:last-child,.ben .ben-block-editor-ui .button-group .button.button-primary:last-child{border-top-right-radius:4px;border-bottom-right-radius:4px;border-left:1px solid rgba(34,34,34,.1)}.ben .ben-block-editor-ui .button-group>p{width:100%;display:flex;align-items:stretch;justify-content:space-between}.ben .ben-block-editor-ui .search-group{display:flex;align-items:center;justify-content:space-between;position:relative}.ben .ben-block-editor-ui .search-group input[type=text]{width:100%;height:36px;border-bottom-left-radius:0;border-bottom-right-radius:0}.ben .ben-block-editor-ui .search-group .search-results{z-index:9;position:absolute;top:22px;border-bottom-left-radius:4px;border-bottom-right-radius:4px;width:101%;border:2px solid #27c;border-top:1px solid ligten(#222, 10%);max-height:240px;overflow:auto;background:#fff}.ben .ben-block-editor-ui .search-group .search-results li{cursor:pointer;padding:7px;margin-bottom:1px}.ben .ben-block-editor-ui .search-group .search-results li:hover{color:#27c;background-color:#eee}.ben .ben-block-editor-ui .search-group .search-results li:last-child{border-bottom-left-radius:4px;border-bottom-right-radius:4px;margin-bottom:0}.ben-notice{background:rgba(255,255,255,.5);margin-bottom:20px;padding:15px}.ben-notice h3{margin-top:0;margin-bottom:15px}.ben-notice p{align-items:center;display:flex;font-size:14px;justify-content:flex-start;line-height:1;margin:0 0 15px 0;gap:5px}.ben-notice p:last-of-type{margin-bottom:0}.ben-notice p strong{min-width:120px}/*# sourceMappingURL=block-editor-navigator.min.css.map */
