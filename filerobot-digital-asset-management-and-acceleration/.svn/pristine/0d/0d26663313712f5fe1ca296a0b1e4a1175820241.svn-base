# Tabs
msgid "desc_tab"
msgstr "Welcome"

msgid "settings_tab"
msgstr "General Settings"

msgid "logs_tab"
msgstr "Scaleflex DAM Logs"

msgid "support_tab"
msgstr "Support"

# Description Tab
msgid "filerobot"
msgstr "Scaleflex DAM"

msgid "filerobot_welcome"
msgstr "Welcome to the Scaleflex DAM WordPress Plugin"

msgid "filerobot_fmaw_title"
msgstr "Scaleflex DAM Widget"

msgid "filerobot_fmaw"
msgstr "Scaleflex DAM"

msgid "filerobot_is_1"
msgstr ""
"<b>What is Scaleflex DAM?</b><br><i>Seamless Content Operations to deliver "
"beautiful Digital Experiences</i><br>Scaleflex DAM is a scalable and performance-"
"oriented Digital Asset Management platform with integrated image and video "
"optimizers to store, organize, optimize and deliver your media assets such "
"as images, videos, PDFs and many other brand assets fast all around the "
"world to all device types.<br>Scaleflex DAM's multi-tenant, scalable and "
"flexible file system and intuitive UI allows to simplify complex workflows "
"and integrations within your Content Operations. AI-powered uploads with "
"automatic tagging enable to enrich media assets for better categorization, "
"retrieval with the overall mission to give a meaning to your brand assets."
"<br><b>Scaleflex DAM will allow you to:</b><br><i>Upload & Manage</"
"i><br>Fast Media Upload, Categorization, Search and Manipulation.\n"
"A single source of truth for enriching your images, videos, logos, PDF and "
"any other media: the Asset Hub.<br><i>Collaborate</i><br>One cloud "
"collaboration platform for media assets. Break silos and accelerate your "
"Content Operations by fostering collaboration between internal and external "
"teams.<br><i>Optimize</i><br>Build beautiful Digital Experiences while "
"boosting SEO ranking.\n"
"Publish optimized and mobile-friendly content to provide fast loading "
"visuals to your users, everywhere in the world.<br><i>Publish & Accelerate</"
"i><br>Empower your Marketing and Tech teams with Media Analytics. Get "
"impactful, real-time insights on the usage and performance of your media "
"assets to always be one step ahead."

msgid "filerobot_is_2"
msgstr ""
"<b>No development needed. Simply set up your account and enjoy fast and "
"responsive images.</b>"

msgid "filerobot_is_3"
msgstr ""
"To start using Scaleflex DAM and boost your media, request an account on "
"the <a target=\"_blank\" href=\"https://www.scaleflex.com/filerobot-free-trial"
"\"><b>Scaleflex DAM website</b></a> to obtain a Scaleflex DAM token."

msgid "filerobot_is_4"
msgstr ""
"Regardless of the Scaleflex DAM flavor you chose, our base Plans give you 100GB "
"Cloud Storage | 1TB CDN Traffic | 1TB Cache | 5 Tenants.<br>They are "
"described there: <a target=\"_blank\" href=\"https://www.scaleflex.com/en/"
"pricing\"><b>Scaleflex DAM Plans</b></a>"

msgid "filerobot_is_5"
msgstr ""
"We take care of the complexity for your Digital Asset Management needs!"

msgid "token_label"
msgstr "Scaleflex DAM token"

msgid "token_hint"
msgstr "Enter token: for example fmpsaXXX"

msgid "token_tooltip"
msgstr "Scaleflex DAM token from your Scaleflex DAM account"

msgid "secret_key_label"
msgstr "Scaleflex DAM API Secret Key"

msgid "secret_key_hint"
msgstr ""
"Enter secret key: for example bb9498694fe746bbb544db670803dXXX. <a href="
"\"%1$s\" target=\"_blank\">More info</a>"

msgid "secret_key_tooltip"
msgstr ""
"Generate a Scaleflex DAM API Secret Key for the WP integration and enter it here"

msgid "sec_id_label"
msgstr "Security Template Identifier"

msgid "sec_id_hint"
msgstr ""
"Enter the Security Template Identifier: for example "
"SECU_3268740A1382466B9XBC390D8"

msgid "sec_id_tooltip"
msgstr ""
"To load the Scaleflex DAM Widget or Scaleflex DAM Image Editor, you you need to "
"create a Security Template in your Scaleflex DAM Asset Hub first, in order for "
"your WordPress instantiation of the Scaleflex DAM Widget to obtain proper "
"credentials and access your storage"

msgid "container_label"
msgstr "Scaleflex DAM upload directory"

msgid "cname_label"
msgstr "CNAME:"

msgid "cname_hint"
msgstr "Enter CNAME: for example media.mydomain.com"

msgid "cname_tooltip"
msgstr ""
"Enter the cname as per configuration done in your Scaleflex DAM Hub "
"interface, once validated and SSL certificate accepted. (Or leave blank if "
"none)"

msgid "container_hint"
msgstr "By default: /"

msgid "container_tooltip"
msgstr ""
"The directory in your Scaleflex DAM account, where the files will be stored"

msgid "container_placeholder"
msgstr "/"

msgid "cloud_only_label"
msgstr "Do not store media assets on WP server"

msgid "cloud_only_tooltip"
msgstr ""
"Save space on your WordPress server by securely keeping your media files "
"solely in the Scaleflex DAM's multi-tenant cloud"

msgid "use_fmaw_only_label"
msgstr "Use Scaleflex DAM Widget as gallery"

msgid "synchronize_filerobot_metadata_label"
msgstr "Synchronize Scaleflex DAM metadata"

msgid "use_fmaw_only_tooltip"
msgstr ""
"Will replace the default WordPress Media Gallery by the Scaleflex DAM "
"Gallery, unifying user experience across platforms and allowing advanced "
"media handling from within WordPress"

msgid "endpoint_label"
msgstr "API Endpoint"

msgid "endpoint_hint"
msgstr "By default: https://api.filerobot.com/"

msgid "endpoint_tooltip"
msgstr "The API endpoint, which will receive requests for files operations"

msgid "endpoint_placeholder"
msgstr "https://api.filerobot.com/"

msgid "save_button"
msgstr "Save all changes"

msgid "check_button"
msgstr "Synchronization status"

msgid "sync_button"
msgstr "Finalize activation and synchronize assets database"

msgid "test_button"
msgstr "Test connection"

# Support Tab
msgid "links_to_email"
msgstr ""
"<b>Reach out:</b><br>If you encounter an issue or feel something is not "
"working as it should, please use the support form in the main Scaleflex DAM Hub "
"interface.<br><br>You can also click here to open a support request or "
"request a new feature: <a target=\"_blank\" href=\"https://scaleflex.zendesk."
"com\">https://scaleflex.zendesk.com</a>"

msgid "documentation"
msgstr ""
"<b>Documentation:</b><br><a target=\"_blank\" href=\"https://docs.scaleflex.com/filerobot-documentation/headless-dam-and-api/plugins-and-connectors/plugins/wordpress\">https://docs.scaleflex.com/filerobot-"
"documentation/headless-dam-and-api/plugins-and-connectors/plugins/wordpress</a>"

# Messages
msgid "php_too_old"
msgstr ""
"Plugin Scaleflex DAM Spaces Sync requires PHP 5.3.3 or higher. The plugin has "
"now disabled itself."

msgid "curl_too_old"
msgstr ""
"Plugin Scaleflex DAM Spaces Sync requires cURL 7.16.2+. The plugin has now "
"disabled itself."

msgid "curl_need_openssl"
msgstr ""
"Plugin Scaleflex DAM Spaces Sync requires that cURL is compiled with OpenSSL. "
"The plugin has now disabled itself."

msgid "setup_prompt"
msgstr ""
"<div class=\"%1$s\"><p>Scaleflex DAM is almost ready. To get started, please "
"fill your token : <a href=\"%2$s\">here</a></p></div>"

msgid "localhost_warning"
msgstr ""
"<div class=\"%1$s\"><p>Scaleflex DAM cannot sync because your are running on "
"localhost. Scaleflex DAM needs accessible URL to work</p></div>"

msgid "test_connection_success"
msgstr "Connection is successfully established. Proceed with files upload."

msgid "test_connection_fail"
msgstr "Connection is not established. Please check your credentials"

msgid "test_connection_result"
msgstr ""
"There are %1$s files to sync to Scaleflex DAM. There are %2$s files to sync from "
"Scaleflex DAM. In case there are many local files, the upload TO Scaleflex DAM can "
"take a while."

msgid "sync_up_label"
msgstr "To Scaleflex DAM:"

msgid "sync_down_label"
msgstr "From Scaleflex DAM:"

msgid "change_remote_warning"
msgstr ""
"Changing token or upload directory in mid-use can cause unexpected "
"consequences. It's highly recommended that you deactivate then activate this "
"plugin before entering a new token or upload directory."

msgid "filerobot_default_warning"
msgstr ""
"Please do not change the default 'Store' settings on Scaleflex DAM hub, because "
"this version of the Scaleflex DAM plugin does NOT support any non-default "
"settings. Hence, please keep 'How should the assets be called once "
"uploaded?' as 'Keep original file name' and keep 'Action to take if a file "
"with the same name already exist in the container?' as 'New version'."

msgid "log_id_label"
msgstr "ID"

msgid "log_post_id_label"
msgstr "Post ID"

msgid "log_remote_name_label"
msgstr "Remote Name"

msgid "log_local_name_label"
msgstr "Local Name"

msgid "log_uuid_label"
msgstr "UUID"

msgid "log_sha_label"
msgstr "SHA1"

msgid "log_container_label"
msgstr "Container"

msgid "log_status_label"
msgstr "Status"

msgid "log_in_progress_label"
msgstr "In Progress"

msgid "log_created_label"
msgstr "Created"

msgid "log_updated_label"
msgstr "Updated"

msgid "btn_fmaw_insert_to_post"
msgstr "Insert from DAM into page"

msgid "btn_fmaw_insert_product_img"
msgstr "Insert Product Image"

msgid "btn_fmaw_insert_product_gallery"
msgstr "Insert to Product Gallery"

msgid "btn_fmaw_replace_to_post"
msgstr "Replace via FMAW"

msgid "filerobot_image_editor_title"
msgstr "Scaleflex DAM Image Editor"

msgid "sync_comments_label"
msgstr "Synchronize Comments as Description"

msgid "sync_comments_tooltip"
msgstr ""
"Synchronize all Comments attached to the media in the Scaleflex DAM library to "
"the Description field in the WordPress database"

msgid "setup_unready"
msgstr ""
"Please fill and save Token, Security Template Identifier and Directory "
"before synchronization"
