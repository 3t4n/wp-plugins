
#sub-accordion-section-habc_bg_colors_section .wp-picker-input-wrap{
    z-index: 1000 !important;
    position: absolute;
    background: #fff;
}

#sub-accordion-section-habc_bg_colors_section li{
    width: 50%;
    clear: none;
    display: inline-block;
    float: left;
}


#sub-accordion-section-habc_bg_colors_section li:nth-child(odd) {
    width: 40%;
}

#sub-accordion-section-habc_bg_colors_section li:nth-child(even) {
    width: 60%;
}

#sub-accordion-section-habc_bg_colors_section li.customize-section-description-container.section-meta, #sub-accordion-section-habc_bg_colors_section li:first-child{
    clear: both;
    width: 100%;
    display: block;
    float: none;
}

#sub-accordion-section-habc_bg_colors_section span.customize-inside-control-row{
    display: inline-block;
    width: 24%;
    min-width: 30px;
    clear: none;
    float: left;
}

span.customize-control-title {
    width: calc(100% - 30px);
}

li#customize-control-habc_nav_li_hover_bg_color_5 span.customize-control-title, li#customize-control-habc_nav_dropdown_bg_color_6 span.customize-control-title,
li#customize-control-habc_dd_li_hover_bg_color_7 span.customize-control-title{
    zoom: .92;
}

#customize-control-hcc_bg_gradient_color_1, 
#customize-control-hcc_bg_gradient_color_2, 
#customize-control-hcc_bg_gradient_color_3, 
#customize-control-hcc_body_bg_base_color {
    width: 50%;
    display: inline-block;
    float: left;
    clear: none;
}

#sub-accordion-section-hcc_options_section .customize-control .customize-inside-control-row {
    display: inline-block !important;
    width: calc(50% - 30px);
    min-width: 80px;
}

#customize-control-hcc_css_style_options .customize-inside-control-row {
    text-align: center;
    font-weight: bold;
    margin: 5px auto 5px;
    width: calc(50% - 20px);
    display: inline-block;
    padding: 5px 5px 5px 5px;
}

#customize-control-hcc_css_style_options .customize-inside-control-row input {
    height: 100px;
    width: 100px;
    border-radius: 0px;
    display: block;
    float: none;
    margin: 5px auto;
}

