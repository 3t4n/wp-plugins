parameters:
    level: 8
    treatPhpDocTypesAsCertain: false
    checkMissingIterableValueType: false
    checkUninitializedProperties: false
    tmpDir: tests
    paths:
        - disable-webp-by-default.php
        - inc
    scanFiles:
        - disable-webp-by-default.php
    scanDirectories:
        - inc
    bootstrapFiles:
        - %rootDir%/../../php-stubs/wordpress-stubs/wordpress-stubs.php