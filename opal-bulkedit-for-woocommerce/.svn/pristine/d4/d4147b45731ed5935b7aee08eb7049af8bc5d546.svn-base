#opqw-bulkedit {
	padding: 0 50px 0 0;
	.opbw-box {
		padding: 20px;
		box-shadow: 0 0 3px rgba(0,0,0,0.2);
		border-radius: 10px;
		background-color: #fff;
        position: relative;
        overflow: hidden;

        &.loading {
            &::before, &::after {
                content: '';
                position: absolute;
                width: 100%;
                height: 100%;
                left: 0;
                top: 0;
                z-index: 9;
            }
            &::before {
                background: rgba(0,0,0,0.6);
            }
            &::after {
                background: url(../images/loading.gif) no-repeat center;
            }
        }
	}
	.opbw_header_settings {
		margin-bottom: 20px;
		padding-bottom: 20px;
		border-bottom: 1px solid var(--opbw-border-color);
	}
	.opbw_title_page {
		margin: 0;
		font-size: 1.5em;
	}
}

.opbw_setting_form.form-field {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    font-size: 15px;
    margin: 0;

    &.opbw_rule_field {
        margin-left: 10px;
    }

    .opbw_setting_field, .select2-container {
        width: 300px !important;
        min-height: 40px;
        // padding: 5px 15px;
        max-width: 33.3333%;

        @include responsive(XL) {
            width: 200px !important;
            padding: 5px;
        }
    }

    .woocommerce-help-tip {
        position: absolute;
        left: 335px;

        .opbw_preview_action & {
            left: 135px;
        }

        @include responsive(XL) {
            left: 140px;
        }
    }

    & > label, & > legend {
        width: 300px;
        margin-right: 50px;
        max-width: 33.3333%;

        .opbw_preview_action & {
            width: 120px;
            margin-right: 30px;
        }

        @include responsive(XL) {
            width: 100px;
        }
    }
}

.opbw-content {
    .options_group {
        border-bottom: 1px solid var(--opbw-border-color);

        & > ul {
            margin-top: 0;

            & > li {
                margin-bottom: 25px;
            }
        }
    }

    .wc-radios {
        display: flex;
        grid-gap: 30px;

        & > li {
            margin-bottom: 0;
        }
    }
}

.opbw_preview_action {
    .form-field {
        margin: 0;
        font-size: 15px;

        label {
            margin-right: 10px;
        }
    }

    input {
        margin-top: 5px;
    }

    .button {
        margin: 0 0 0 10px;
    }
}

#opbw-preview {
    .wp-list-table {
        .column-properties {
            width: 20%;
        }
        .column-published {
            width: 8%;
        }
        .column-price {
            width: 10%;
        }
        .column-checkbox {
            width: 6%;
        }
    }
}

.media_value {
    border: 1px solid #ebebeb;
    padding: 5px;
    .opbw_multiple_media & {
        padding: 10px;
        width: 300px;
        display: flex;
        gap: 5px;
        flex-wrap: wrap;

        .attachment {
            padding: 0;
            width: 50px;
            height: 50px;
            border: 1px solid #ebebeb;
            overflow: hidden;
            .gallery_action {
                position: absolute;
                right: 0;
                top: 0;
                opacity: 0;
                transition: 0.2s linear;
                width: 100%;
                height: 100%;
                background-color: rgba(0,0,0.5);
                display: flex;
                justify-content: center;
                align-items: center;
                a {
                    text-decoration: none;
                    color: #fff;
                }
            }
            &:hover {
                .gallery_action {
                    opacity: 1;
                }
            }
        }
    }
}

#opbw_history_link {
    position: relative;
    &.opbw_disable {
        opacity: 1;
        &::before {
            content: '';
            position: absolute;
            width: 100%;
            height: 100%;
            background: url(../../../../../wp-includes/js/tinymce/skins/lightgray/img/loader.gif) no-repeat center var(--opbw-primary-color);
            left: 0;
            top: 0;
        }
    }
}

#opbw_logs {
    margin-top: 30px;
    code {
        display: block;
        height: 300px;
        padding: 20px;
        border-radius: 5px;
        overflow-y: auto;
    }
}

.number_edited {
    font-size: 18px;
    color: var(--opbw-shadow-color);
    text-decoration: underline;
    margin-left: 20px;
    font-weight: 600;
}
