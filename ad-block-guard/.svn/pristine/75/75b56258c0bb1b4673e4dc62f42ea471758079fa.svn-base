/* Example styles for TinyMCE content */
body {
	font-size:16px;
    font-family: 'Arial', sans-serif;
    color: #333;
    background-color: #f9f9f9;
    padding:0;
    margin:0;
}

a {
    color: #0073aa;
    text-decoration: none;
}

a:hover {
    color: #005177;
}

p {
  margin:0;
}

p + p {
  margin-top:10px;
}

#tinymce {
	margin:10px;
}
