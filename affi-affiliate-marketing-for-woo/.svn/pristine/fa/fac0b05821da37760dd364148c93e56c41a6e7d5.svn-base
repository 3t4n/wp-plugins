.affi-share-btn-wrap {

  .affi-share-btn {
    cursor: copy;

    display: inline-block;
    line-height: 1.6;
    font-size: inherit;
    color: #fff;
    padding: 5px 10px;
    margin: 5px;
    border: 2px solid transparent;
    text-align: center;
    opacity: 1;
    background: #475347;
    -webkit-transition: all .3s ease-in-out;
    -o-transition: all .3s ease-in-out;
    transition: all .3s ease-in-out;
    will-change: transform;
  }

  .affi-share-btn-input {
    display: none;
  }

  .affi-share-btn-copy {
    display: none;
  }
}

.affi-wrap-share {
  display: flex;
  align-items: center;

  h5 {
    margin: 0 5px 0 0;
    font-size: 16px;
    font-weight: bold;
  }

  .affi-wrap-share-social-buttons {
    margin-left: 10px;

    .affi-share-social-icon {
      text-decoration: none;
      margin-right: 5px;
      font-size: 16px;
      outline: none !important;
    }
  }
}
