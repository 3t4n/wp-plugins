/*! Embed-Login WP Plugin (C) David Tyler 2010 */var EmbedLogin = {	P: function (f,i) {		jQuery('#' + f + '_Status').remove();		jQuery('#' + f).prepend('<div id="' + f + '_Loading" class="EmbedLogin_Loading" ></div>').append('<input type="hidden" name="EmbedLogin_Js_Request" value="' + f + '" />');		return jQuery('#' + f).attr('action')		},	F: function (f,d,s) {		jQuery('#' + f + '_Loading').remove();		if (d.type !== 'confirm' && d.type !== 'invalid') d.message = 'Error: Please try again.';		jQuery('#' + f).prepend('<div id="' + f + '_Status" class="EmbedLogin_Status ' + d.type + '">' + d.message + '</div>')		},	R: function (e, f, r, c) {		if(e != false) e.preventDefault();		f = 'EmbedLogin_' + f + '_Form';		if(!c){ c = function(d){ EmbedLogin.D(d, r); }; }		jQuery.ajax({type: 'POST',url: EmbedLogin.P(f),data: jQuery("#" + f).serialize(),success: function(d,s){ EmbedLogin.F(f,d,s); c(d); },error: function(x,s,e){ s = (s!=null) ? ' ('+s+')' : ''; EmbedLogin.F(f, { 'type': 'invalid', 'message': '<strong>ERROR</strong>: Unable to connect to server'+s+'. Try again or let us know you had a problem.' }); },dataType: 'json',timeout: 5000});		},	D: function(d, r){		if (d.type == 'confirm' && r) {			if (d.redirect != null) window.location = d.redirect;			else window.location.reload()			}		},	L: function(){		FB.getLoginStatus(function(response) {			if (response.session) {				EmbedLogin.R(false, 'Facebook', 1);				}			else {				EmbedLogin.F('EmbedLogin_Facebook_Form', { 'type': 'invalid', 'message': '<strong>ERROR</strong>: You need to grant us access to your Facebook profile.' });				}			});		}	};		jQuery(document).ready(function ($) {	$('#EmbedLogin_LoginBox_Form').submit(function (e) { EmbedLogin.R(e, 'LoginBox', 1); });	$('#EmbedLogin_RememberBox_Form').submit(function (e) { EmbedLogin.R(e, 'RememberBox'); });	$('#EmbedLogin_RegisterBox_Form').submit(function (e) { EmbedLogin.R(e, 'RegisterBox'); });	$('#EmbedLogin_PasswordBox_Form').submit(function (e) { EmbedLogin.R(e, 'PasswordBox',1); });	$('#EmbedLogin_RememberBox_Link').click(function (e) { e.preventDefault(); $('#EmbedLogin_RememberBox').slideDown(1000); $('body,html').animate({ scrollTop: $('#EmbedLogin_RememberBox').offset()['top'] }, 1000); });	$('#EmbedLogin_RememberBox_Cancel').click(function (e) { e.preventDefault(); $('#EmbedLogin_RememberBox').slideUp(1000); });	$('.EmbedLogin_Loading').click(function(e){ this.remove(); });	});