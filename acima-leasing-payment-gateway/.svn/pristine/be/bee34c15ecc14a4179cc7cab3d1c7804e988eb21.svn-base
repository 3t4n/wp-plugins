.acima-config-field.hidden {
    display: none;
}

.acima-config-field[type="checkbox"]:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

.acima-config-field[type="checkbox"]:disabled + label {
    opacity: 0.6;
    cursor: not-allowed;
}

.error-message {
    color: #dc3232;
    margin-top: 5px;
    padding: 5px;
    display: none;
}

input[readonly] {
    background-color: #f0f0f1 !important;
    color: #50575e !important;
    cursor: not-allowed !important;
}

.acima-login-section {
    margin-top: 20px;
    display: none;
}

/* Added to prevent FOUC */
.form-table tr {
    visibility: hidden;
}

.form-table.initialized tr {
    visibility: visible;
}