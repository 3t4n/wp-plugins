<tr valign="top">
    <th scope="row" class="titledesc">
        <button name="download_config"
                class="button-primary woocommerce-save-button"
                type="button"
                onclick="downloadAcimaConfig()"
                value="%button_text%">
            %button_text%
        </button>
        <p class="description">%description%</p>
    </th>
    <td class="forminp"></td>
</tr>
