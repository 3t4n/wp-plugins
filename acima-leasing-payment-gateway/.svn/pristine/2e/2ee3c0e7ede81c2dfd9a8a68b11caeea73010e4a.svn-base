{
    "name": "acima/ecom-woocommerce",
    "description": "Acima WooCommerce Integration",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "version": "dev-master",
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.7",
        "woocommerce/woocommerce-sniffs": "^1.0.0",
        "wp-coding-standards/wpcs": "^3.1",
        "phpunit/phpunit": "9.5.14",
        "php-stubs/wordpress-stubs": "5.8.2",
        "php-stubs/woocommerce-stubs": "6.8.0",
        "wp-phpunit/wp-phpunit": "^6.4",
        "yoast/phpunit-polyfills": "^2.0",
        "symfony/var-dumper": "^7.0",
        "php-vcr/php-vcr": "^1.7",
        "mockery/mockery": "^1.6"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
      "make-zip": "zip -r acima-credit-woo.zip .",
      "format": "phpcbf --standard=WordPress --extensions=php --ignore=*/vendor/*,*/node_modules/* .",
      "lint": "find . -type f -name '*.php' ! -path './vendor/*' -exec php -l {} \\;",
      "test": [
          "./vendor/bin/phpunit --configuration /var/www/html/wp-content/plugins/acima-credit/phpunit.xml.dist --verbose"
        ],
      "test-debug": [
          "./vendor/bin/phpunit --configuration /var/www/html/wp-content/plugins/acima-credit/phpunit.xml.dist --verbose --debug"
        ],
        "test-migrate": [
          "./vendor/bin/phpunit --migrate-configuration"
        ],
        "phpcs": [
          "./vendor/bin/phpcs -s -p . --standard=WordPress --ignore=vendor/*"
        ],
        "phpcbf": [
          "./vendor/bin/phpcbf -p . --standard=WordPress --ignore=vendor/*"
        ]
    },
    "extra": {
      "scripts-description": {
        "test": "Run unit tests",
        "phpcs": "Analyze code against the WordPress coding standards with PHP_CodeSniffer",
        "phpcbf": "Fix coding standards warnings/errors automatically with PHP Code Beautifier"
      }
    }
}
