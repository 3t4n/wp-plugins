<?php

namespace Awesomesauce\Blocks\Clocks\Text;

use Awesomesauce\Admin\BlockSettings;

if (!defined('ABSPATH')) {
    exit;
}

class Html extends BlockSettings {

    public function getHtml() {
        $html = '<div class="awesomesauce_text">';
        $html .= '<p class="line"><span class="it active"><span>I</span><span>T</span></span><span class="l"><span>L</span></span><span class="is active"><span>I</span><span>S</span></span><span class="as"><span>A</span><span>S</span></span><span class="tgif"><span>G</span><span>T</span><span>F</span><span>I</span></span></p>';
        $html .= '<p class="line"><span class="ac"><span>A</span><span>C</span></span><span class="quarter desc"><span>Q</span><span>U</span><span>A</span><span>R</span><span>T</span><span>E</span><span>R</span></span><span class="bs"><span>B</span><span>S</span></span></p>';
        $html .= '<p class="line"><span class="twenty desc"><span>T</span><span>W</span><span>E</span><span>N</span><span>T</span><span>Y</span></span><span class="five desc"><span>F</span><span>I</span><span>V</span><span>E</span></span><span><span class="x">X</span></span></p>';
        $html .= '<p class="line"><span class="half desc"><span>H</span><span>A</span><span>L</span><span>F</span></span><span class="b"><span>B</span></span><span class="ten desc"><span>T</span><span>E</span><span>N</span></span><span class="f"><span>F</span></span><span class="to desc"><span>T</span><span>O</span></span></p>';
        $html .= '<p class="line"><span class="past desc"><span>P</span><span>A</span><span>S</span><span>T</span></span><span class="eru"><span>E</span><span>R</span><span>U</span></span><span class="nine hr"><span>N</span><span>I</span><span>N</span><span>E</span></span></p>';
        $html .= '<p class="line"><span class="one hr"><span>O</span><span>N</span><span>E</span></span><span class="six hr"><span>S</span><span>I</span><span>X</span></span><span class="three hr"><span>T</span><span>H</span><span>R</span><span>E</span><span>E</span></span></p>';
        $html .= '<p class="line"><span class="four hr"><span>F</span><span>O</span><span>U</span><span>R</span></span><span class="five-hr hr"><span>F</span><span>I</span><span>V</span><span>E</span></span><span class="two hr"><span>T</span><span>W</span><span>O</span></span></p>';
        $html .= '<p class="line"><span class="eight hr"><span>E</span><span>I</span><span>G</span><span>H</span><span>T</span></span><span class="eleven hr"><span>E</span><span>L</span><span>E</span><span>V</span><span>E</span><span>N</span></span></p>';
        $html .= '<p class="line"><span class="seven hr"><span>S</span><span>E</span><span>V</span><span>E</span><span>N</span></span><span class="twelve hr"><span>T</span><span>W</span><span>E</span><span>L</span><span>V</span><span>E</span></span></p>';
        $html .= '<p class="line"><span class="ten-hr hr"><span>T</span><span>E</span><span>N</span></span><span class="se"><span>S</span><span>E</span></span><span class="oclock desc"><span>O</span><span>C</span><span>L</span><span>O</span><span>C</span><span>K</span></span></p>';
        $html .= '<p class="line"><span class="midnight hr"><span>M</span><span>I</span><span>D</span><span>N</span><span>I</span><span>G</span><span>H</span><span>T</span></span></p>';
        $html .= '</div>';

        return $html;
    }
}