#awesomesauce_admin_page .awesomesauce_input[type="text"],
#awesomesauce_admin_page .awesomesauce_input[type="number"],
#awesomesauce_admin_page .awesomesauce_textarea,
#awesomesauce_admin_page .awesomesauce_select {
    border-color: #c3c4c7;
    border-radius: 0;
    margin: 0;
}

#awesomesauce_admin_page .awesomesauce_select.single {
    pointer-events: none;
}

#awesomesauce_admin_page .awesomesauce_input::placeholder,
#awesomesauce_action .awesomesauce_input::placeholder {
    color: #b3b3b3;
}

#awesomesauce_admin_page .awesomesauce_input[type="button"],
#awesomesauce_preview .awesomesauce_input[type="button"] {
    line-height: 1;
    background: #3586D5;
    color: white;
    border: none;
    height: 30px;
    padding: 8px 12px;
    margin: 0;
    cursor: pointer;
    transition: background 0.5s;
}

#awesomesauce_admin_page .awesomesauce_input[type="button"]:hover,
#awesomesauce_preview .awesomesauce_input[type="button"]:hover,
#awesomesauce_preview .awesomesauce_input[type="button"].active {
    background: #2E6CA9;
}

#awesomesauce_preview .awesomesauce_preview_buttons {
    margin: 10px 0;
}

#awesomesauce_preview {
    width: 100%;
    max-width: 100%;
    transition: max-width 0.5s;
    overflow: auto;
    resize: horizontal;
}

#awesomesauce_admin_page .awesomesauce_hover_title {
    display: none;
    line-height: 30px;
    vertical-align: middle;
    margin-left: 5px;
    color: #b3b3b3;
}

#awesomesauce_admin_page .awesomesauce_hover_title .awesomesauce_hover_title_link {
    text-decoration: none;
    color: #98c6eb;
}

#awesomesauce_admin_page .awesomesauce_hover_title .awesomesauce_hover_title_link:hover {
    color: #2271b1;
}

#awesomesauce_admin_page .awesomesauce_setting_container:hover .awesomesauce_hover_title {
    display: inline;
}

#awesomesauce_admin_page .awesomesauce_title, #awesomesauce_admin_page .awesomesauce_setting_container {
    margin: 7px 0;
}

#awesomesauce_admin_page .awesomesauce_setting_container .awesomesauce_setting_container {
    display: inline;
    margin: 0;
}

#awesomesauce_admin_page .awesomesauce_setting_container.awesomesauce_flex_container_fullwidth {
    display: flex;
    align-items: center;
}

#awesomesauce_admin_page .awesomesauce_flex_container_fullwidth .awesomesauce_setting_container {
    margin: 0;
}

#awesomesauce_admin_page .awesomesauce_flex_container {
    display: flex;
    place-items: center;
    line-height: normal;
}

#awesomesauce_admin_page .awesomesauce_flex_title {
    margin: -7px 0;
}

#awesomesauce_admin_page .awesomesauce_block_setting:first-child .awesomesauce_flex_title {
    margin: 0 0 -7px 0;
}

#awesomesauce_admin_page .awesomesauce_flex_container .awesomesauce_input {
    width: 75px;
}

#awesomesauce_admin_page .awesomesauce_flex_container .awesomesauce_select {
    background: #3586D5;
    color: white;
    border-left: 0;
    padding: 0 8px;
}

#awesomesauce_admin_page .awesomesauce_title {
    line-height: normal;
}

#awesomesauce_admin_page h3.awesomesauce_title {
    margin: 25px 0 15px 0;
}

#awesomesauce_admin_page h1.awesomesauce_title {
    margin: 0 0 0 -20px;
    padding: 15px 0 15px 25px;
    border-bottom: 1px solid #c3c4c7;
    background: #fff;
}

#awesomesauce_admin_page h2.awesomesauce_title {
    margin: 7px 0 -7px -20px;
    padding: 10px 0 10px 25px;
    border-bottom: 1px solid #c3c4c7;
    border-top: 1px solid #c3c4c7;
    background: #fff;
    text-align: center;
}

@media (max-width: 782px) {
    #awesomesauce_admin_page h1.awesomesauce_title {
        margin-left: -10px;
    }

    #awesomesauce_admin_page h2.awesomesauce_title {
        margin-left: -10px;
    }
}

#awesomesauce_admin_page .awesomesauce_textarea {
    height: 70px;
    resize: both;
}

#awesomesauce_admin_page .wp-color-result {
    border-color: #c4c5c5;
    border-radius: 0px;
}

#awesomesauce_admin_page .wp-color-result-text {
    border-radius: 0px;
}

#awesomesauce_admin_page .awesomesauce_description,
#awesomesauce_shortcode .awesomesauce_description,
#awesomesauce_action .awesomesauce_description {
    line-height: 1;
    margin-top: -4px;
    margin-left: 7px;
    color: #a9a9a9;
}

#awesomesauce_shortcode .inside .awesomesauce_title {
    font-size: 17px;
    margin: 8px 0 0 0;
}

#awesomesauce_action .inside .awesomesauce_input {
    margin: 8px 0 0 0;
}

#awesomesauce_shortcode .inside .awesomesauce_description,
#awesomesauce_action .inside .awesomesauce_description {
    margin: 8px 0 0 0;
}

#awesomesauce_shortcode .awesomesauce_title_container {
    user-select: all;
    caret-color: transparent;
}

#awesomesauce_block_settings .awesomesauce_display_id {
    position: absolute;
    top: 2px;
    right: 15px;
    z-index: 1;
    color: #a9a9a9;
}

#awesomesauce_global_settings {
    border: 1px solid #c3c4c7;
    box-shadow: 0 1px 1px rgba(0, 0, 0, .04);
    background: #fff;
    padding: 15px;
    margin: 20px 20px 0 0;
}

#awesomesauce_global_settings #awesomesauce_save {
    margin-top: 25px;
    font-size: 16px;
}

#awesomesauce_global_settings #awesomesauce_delete_google {
    display: block;
}

#awesomesauce_admin_page .awesomesauce_admin_notice {
    margin: 15px 0 0 0;
    display: inline-block;
    align-self: flex-start;
}

#awesomesauce_admin_page .awesomesauce_settings_divider {
    width: 250px;
    background: #c3c4c7;
    height: 1px;
    margin: 10px 0 15px 0
}

#awesomesauce_admin_page.awesomesauce_block_settings {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
}

#awesomesauce_rating .awesomesauce_star {
    font-size: 30px;
    color: #ff8c00;
    width: 25px;
    height: 25px;
    line-height: 25px;
    display: inline-block;
}

.awesomesauce_star_container {
    cursor: pointer;
}

.awesomesauce_hidden_background_image_container {
    display: none;
}

#awesomesauce_admin_page .awesomesauce_title {
    position: relative;
}

#awesomesauce_admin_page .awesomesauce_small_logo {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
}

#awesomesauce_admin_page .awesomesauce_small_logo .awesomesauce_small_logo_img {
    height: 100%;
}

#awesomesauce_admin_page .awesomesauce_small_logo .awesomesauce_overlay {
    background: linear-gradient(to right, white, rgba(255, 255, 255, 0));
    display: inline-block;
    height: 100%;
    margin-right: -20px;
    width: 20px;
    position: relative;
    z-index: 100;
}

#awesomesauce_logo {
    max-width: 280px;
}

#awesomesauce_logo .inside {
    margin: 0;
    padding: 0;
    line-height: 0;
}

.js #awesomesauce_logo.closed .inside {
    display: block;
}

#awesomesauce_logo.closed {
    border-bottom: 1px solid #c3c4c7;
}

#awesomesauce_logo .awesomesauce_big_logo_img {
    width: 100%;
}

#awesomesauce_logo .postbox-header {
    display: none;
}

.awesomesauce_bottom_links {
    order: 9999 !important;
    margin-top: 20px !important;
}

/* CSS for settings meta box, when moved to sidebar */
#side-sortables #awesomesauce_admin_page {
    overflow: scroll;
    max-height: 605px;
    resize: vertical;
}

#side-sortables #awesomesauce_block_settings {
    height: auto !important;
}

#side-sortables #awesomesauce_admin_page * {
    white-space: nowrap;
}

/* color picker */
div#lc-color-picker.lccp-shown {
    margin-left: 75px;
    z-index: 9999;
    user-select: none;
}

#awesomesauce_preview .awesomesauce_block {
    opacity: 0;
}

/*Hide WP notices*/
.notice:not(.notice-success) {
    display: none;
}

/*Add new page*/
#awesomesauce_admin_page.awesomesauce_addnew {
    display: flex;
    flex-direction: column;
}

#awesomesauce_admin_page.awesomesauce_addnew .awesomesauce_add_new_section {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
}

#awesomesauce_admin_page.awesomesauce_addnew .awesomesauce_add_new_section .awesomesauce_add_new_block {
    background: white;
    height: 200px;
    padding: 0px 0px 25px 0px;
    margin-top: 15px;
    margin-right: 15px;
    border: 1px solid #c3c4c7;
    box-shadow: 0 1px 1px rgba(0, 0, 0, .04);
    border-radius: 15px 0 15px 0;
    overflow: hidden;
}

#awesomesauce_admin_page.awesomesauce_addnew .awesomesauce_add_new_section .awesomesauce_add_new_block_container {
    height: 100%;
    width: 100%;
    position: relative;
    border-bottom: 1px solid #e7e7e7;
}

#awesomesauce_admin_page.awesomesauce_addnew .awesomesauce_add_new_section .awesomesauce_add_new_block_inner {
    display: block;
    height: 100%;
    width: 100%;
    background-size: cover;
    background-position: center;
}

#awesomesauce_admin_page.awesomesauce_addnew .awesomesauce_add_new_section .awesomesauce_add_new_block_inner:focus {
    box-shadow: none;
}

#awesomesauce_admin_page.awesomesauce_addnew .awesomesauce_add_new_section .awesomesauce_sub_title {
    font-size: 15px;
    line-height: 15px;
    height: 15px;
    width: 100%;
    text-align: center;
    margin: 0;
    padding: 0;
    font-weight: 400;

    position: absolute;
    bottom: -20px;
    left: 0;
}

#awesomesauce_admin_page.awesomesauce_addnew .awesomesauce_update_link {
    text-decoration: none;
}

#awesomesauce_admin_page.awesomesauce_addnew .awesomesauce_update_text {
    vertical-align: top;
    font-size: 12px;
    margin: 10px 15px;
    display: inline-block;
    text-decoration: none;
}

#awesomesauce_admin_page.awesomesauce_addnew h1.awesomesauce_title {
    order: -1;
}

@media (max-width: 1920px) {
    #awesomesauce_admin_page.awesomesauce_addnew .awesomesauce_add_new_section {
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    }

    #awesomesauce_admin_page.awesomesauce_addnew .awesomesauce_add_new_section .awesomesauce_add_new_block {
        height: 160px;
    }
}

/*Install category page*/
#awesomesauce_install_page {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 50px;
}

#awesomesauce_install_page .awesomesauce_form {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    width: 100%;
    max-width: 300px;
}

#awesomesauce_install_page input[type="file"] {
    display: block;
    margin: 10px 0;
}

#awesomesauce_install_page .awesomesauce_button {
    padding: 10px 20px;
    font-size: 16px;
    background-color: #0073aa;
    color: #fff;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}

#awesomesauce_install_page .awesomesauce_button:hover {
    background-color: #005a8d;
}

#awesomesauce_install_page .notice {
    margin: 0 auto 20px auto;
}