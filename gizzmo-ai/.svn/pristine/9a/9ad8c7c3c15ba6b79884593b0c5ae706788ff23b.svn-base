<div class="container_roundup" style="display: inline-block;">
	<div class="Product_Title">
		<h2>{{product_number}}. <a target="_blank" class="gizzmo_link" href="{{AffiliateLink}}">{{ShortName}}</a></h2>
	</div>
	<div class="Product_Image"><a href="{{AffiliateLink}}" target="_blank" class="gizzmo_link"><img class="prod_img" src="{{ImageSource}}"/></a></div>
	<div class="Product_Text">
		{{ProductText}}
	</div>
	{{item_CTA_html}}
	<input type="hidden" class="product_asin" value="{{ASIN}}">
</div>