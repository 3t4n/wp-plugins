{"version":3,"file":"../../css/admin.css","mappings":"AAQA,gIACI,aACA,uBACA,cAGJ,+LACI,yBACI,kBAEJ,aACA,wBAdY,CAkBhB,YACI,cAEA,2BACI,eACA,gBAGJ,sBACI,oBAMJ,0BACI,gBACA,YAuBR,YACI,cAIJ,iBACI,aACA,uBACA,YAGA,wBACI,kBACA,kBAGJ,oBACI,SAGJ,wBACI,gBAKR,cACI,6BACA,yBACA,kBAEA,sBACI,YACA,YAKR,kBACI,aAYA,oFAEI,cAKJ,4CACI,aAOJ,6IAII,cAGJ,6BACI,cAMA,mCACI,aAKZ,0BACI,mBAEA,gCACI,qBACA,wBArJQ,CAsJR,kBACA,WACA,YACI,kBAEJ,WACA,+BAIR,kBACI,qBAIJ,eACI,aACA,kBAGJ,aACI,kBACA,kBAQJ,oBACI,eACA,mBACA,gCAEA,0BACI,kBACA,qBACA,UAbO,CAcP,WAZQ,CAeZ,0BACI,aAEA,gDACI,wBArMO,CAuMP,uDACI,2BAIR,8CACI,2BAIR,kCACI,kBACA,eACA,MACA,OACA,QACA,SACA,yBACA,eAEA,yCACI,kBACA,WACA,WA3CK,CA4CL,UA5CK,CA6CL,QA/CK,CAgDL,UAhDK,CAiDL,sBACA,eAIR,wCACI,kBACA,UAKR,kBACI,c","sources":["webpack://gui-for-lcp/./gui-for-lcp/admin/assets/sass/admin.scss"],"sourcesContent":["@use \"sass:math\";\n\n@import \"mixins\";\n\n$main-theme-color: #007fff;\n$main-bg-color: #f6f6f6;\n\n// Placeholder classes\n%two-column-grid {\n    display: grid;\n    grid: auto-flow / 1fr 1fr;\n    grid-gap: 15px;\n}\n\n%fieldset {\n    border: 1px solid $main-theme-color {\n        radius: 5px;\n    }\n    padding: 10px;\n    background-color: $main-bg-color;\n}\n\n// Overriden WP styles\n#gflcp-form {\n    overflow: auto;\n\n    .cat-checklist {\n        height: initial;\n        max-height: 12em;\n    }\n\n    .children {\n        margin:  6px 0 0 10px;\n    }\n}\n\n// Root modal wrapper\n.gflcp-modal {\n    .media-modal {\n        max-width: 720px;\n        margin: auto;\n    }\n}\n\n// Form checklists\n#gflcp-tag-grid,\n#gflcp-cat-grid,\n#gflcp-tax-grid,\n.gflcp-date {\n    @extend %two-column-grid;\n\n    fieldset {\n        @extend %fieldset;\n    }\n}\n\n#gflcp-taxonomy-terms > div {\n    @extend %two-column-grid;\n    fieldset {\n        @extend %fieldset;\n    }\n}\n\n#load-terms {\n    margin: 10px 0;\n}\n\n// Modal form container\n.modal-form-view {\n    display: grid;\n    grid: 50px 1fr 56px / 1fr;\n    height: 100%;\n\n    // Modal header\n    header {\n        padding-left: 10px;\n        align-self: center;\n    }\n\n    h1 {\n        margin: 0;\n    }\n\n    legend {\n        font-size: 1.5em;\n    }\n}\n\n// Modal footer\n.gflcp-footer {\n    border-top: 1px solid #e3e3e3;\n    background-color: #f0f0f0;\n    align-self: center;\n\n    .button {\n        margin: 10px;\n        float: right;\n    }\n}\n\n// Form elements\n.gflcp-hidden-btn {\n    display: none;\n}\n\n.gflcp-type-status {\n    @extend %two-column-grid;\n\n    fieldset {\n        @extend %fieldset;\n    }\n}\n\n#gflcp-select-accordion {\n    input[type=\"text\"],\n    input[type=\"number\"] {\n        display: block;\n    }\n}\n\n.gflcp-display-accordion {\n    fieldset[disabled] {\n        display: none;\n    }\n}\n\n.gflcp-display-details {\n    @extend %two-column-grid;\n\n    select,\n    label,\n    input[type=\"text\"],\n    input[type=\"number\"] {\n        display: block;\n    }\n\n    label {\n        margin: 10px 0;\n    }\n\n    fieldset {\n        @extend %fieldset;\n\n        h3 {\n            margin-top: 0;\n        }\n    }\n}\n\n.gflcp-display-checkboxes {\n    margin-bottom: 10px;\n\n    label {\n        display: inline-block;\n        background-color: $main-bg-color;\n        border-radius: 5px;\n        color: black;\n        padding: 2px {\n            right: 8px;\n        }\n        margin: 2px;\n        box-shadow: 2px 2px 5px $main-theme-color;\n    }\n}\n\n.gflcp-row-span-2 {\n    grid-row: auto / span 2;\n}\n\n// Ajax spinner SVG\n.gflcp-spinner {\n    grid-row: 2 / 3;\n    place-self: center;\n}\n\n.gflcp-alert {\n    place-self: center;\n    text-align: center;\n}\n\n$switch-width: 30px;\n$switch-padding: 4px;\n$switch-height: math.div($switch-width, 2) + $switch-padding;\n$switch-sq-size: $switch-height - 2 * $switch-padding;\n\n.gflcp-switch-block {\n    padding: 10px 0;\n    margin-bottom: 10px;\n    border-bottom: 1px solid $main-theme-color;\n\n    label {\n        position: relative;\n        display: inline-block;\n        width: $switch-width;\n        height: $switch-height;\n    }\n\n    input {\n        display: none;\n\n        &:checked + .gflcp-slider {\n            background-color: $main-theme-color;\n\n            &:before {\n                transform: translateX($switch-sq-size);\n            }\n        }\n\n        &:focus + .gflcp-slider {\n            box-shadow: 0 0 1px $main-theme-color;\n        }\n    }\n\n    .gflcp-slider {\n        position: absolute;\n        cursor: pointer;\n        top: 0;\n        left: 0;\n        right: 0;\n        bottom: 0;\n        background-color: #7cbdff;\n        transition: .4s;\n\n        &:before {\n            position: absolute;\n            content: \"\";\n            height: $switch-sq-size;\n            width: $switch-sq-size;\n            left: $switch-padding;\n            bottom: $switch-padding;\n            background-color: white;\n            transition: .4s;\n        }\n    }\n\n    .gflcp-switch-label {\n        position: relative;\n        left: $switch-width + 10px;\n    }\n}\n\n// Utility classes\n.gflcp-vmargin-10 {\n    margin: 10px 0;\n}\n"],"names":[],"sourceRoot":""}