.adminz_wrap table {
  border-collapse: collapse;
  width: 100%;
}
.adminz_wrap table td {
  border: 1px solid lightgray;
  background-color: white;
  padding: 10px;
}
.adminz_wrap table td td {
  padding: 5px 10px;
  vertical-align: top;
}
.adminz_wrap .adminz_response:not(:empty) {
  padding: 5px;
  background: #fbfbfb;
  outline: 1px dashed black;
  margin: 0 1px;
  border-radius: 4px;
  margin-bottom: 15px;
  margin-top: 10px;
  font-family: monospace;
}
.adminz_wrap .adminz_click_to_copy:not(:empty) {
  font-family: Consolas, Monaco, monospace;
  background-color: #ededed;
  cursor: pointer;
  margin: 0 5px 5px 0;
  border-radius: 4px;
  padding: 0 5px;
}
.adminz_wrap .adminz_click_to_copy:not(:empty):hover {
  background-color: #2271b1;
  color: white;
}
.adminz_wrap .adminz_click_to_copy:not(:empty):hover .icon_name {
  color: white;
}
.adminz_wrap textarea {
  resize: auto;
}
.adminz_wrap .adminz_grid_item {
  width: 100%;
  display: inline-block;
  margin-right: 1em;
  position: relative;
  margin-bottom: 0.5em;
}
@media (min-width: 768px) {
  .adminz_wrap .adminz_grid_item {
    width: 20em;
  }
}
.adminz_wrap .adminz_grid_item .adminz_field_wrap:not(.type-checkbox) {
  width: 100%;
}
.adminz_wrap .adminz_icon_item {
  display: inline-flex;
  flex-direction: column;
  width: 30px;
  margin: 2px;
  padding: 5px !important;
}
.adminz_wrap .adminz_icon_item .icon_name {
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-align: center;
  color: gray;
}
.adminz_wrap .adminz_icon_item .dashicons {
  width: 100%;
  height: auto;
  font-size: 30px;
}

.column-adminz_page_post_id {
  width: 52px;
  text-align: center !important;
}/*# sourceMappingURL=adminz-admin.css.map */