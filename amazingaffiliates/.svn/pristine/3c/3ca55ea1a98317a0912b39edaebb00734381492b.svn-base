/* the navbar */
.amazingaffiliates_admin_page #amazingaffiliates_navbar { display: flex; flex-wrap:wrap; justify-content: space-between; width: calc(100% - 0.5em); height: 50px; gap: 5px; font-size: 120%; font-weight: 600; margin-top:0.5em;}

.amazingaffiliates_admin_page #navbar { display:flex; flex-wrap:wrap; gap: 10px; padding:10px;  }
.amazingaffiliates_admin_page .navbar_menu_item ,
.amazingaffiliates_admin_page .navbar_menu_current_item { min-height:36px; display: flex; justify-content:center;
    align-items:center; text-align:center; flex-basis:100px; flex-shrink:0; flex-grow:1; flex-wrap:wrap; padding:0; border-width:2px; border-style:solid; border-radius:5px; color:black; text-decoration:none; transition:0.1s; }
.amazingaffiliates_admin_page .navbar_menu_item:hover { color:black; }

.amazingaffiliates_admin_page .home  { border-color: gold;  }
.amazingaffiliates_admin_page .setup  { border-color: fuchsia;  }
.amazingaffiliates_admin_page .insert { border-color: Coral;  }
.amazingaffiliates_admin_page .edit { border-color: LightGreen;  }
.amazingaffiliates_admin_page .manage { border-color: Khaki;  }
.amazingaffiliates_admin_page .learn { border-color: LightSkyBlue;  }
.amazingaffiliates_admin_page .settings { border-color: LightGray;  }

.amazingaffiliates_admin_page .home:hover { border-color: black; box-shadow:inset 0px 0px 8px 4px gold }
.amazingaffiliates_admin_page .setup:hover { border-color: fuchsia; box-shadow:inset 0px 0px 8px 4px fuchsia; }
.amazingaffiliates_admin_page .insert:hover { border-color: red; box-shadow:inset 0px 0px 8px 4px Coral; }
.amazingaffiliates_admin_page .edit:hover { border-color: green; box-shadow:inset 0px 0px 8px 4px LightGreen; }
.amazingaffiliates_admin_page .manage:hover { border-color: gold; box-shadow:inset 0px 0px 8px 4px Khaki; }
.amazingaffiliates_admin_page .learn:hover { border-color: blue; box-shadow:inset 0px 0px 8px 4px LightSkyBlue; }	
.amazingaffiliates_admin_page .settings:hover { border-color: gray; box-shadow:inset 0px 0px 8px 4px LightGray; }

.amazingaffiliates_admin_page .navbar_menu_current_item.home { border-color: gold; background-color:#FAFAD2FF; }
.amazingaffiliates_admin_page .navbar_menu_current_item.setup { border-color: fychsia; background-color:#FFEEFF; }
.amazingaffiliates_admin_page .navbar_menu_current_item.insert { border-color: red; background-color:#FF7F5044; }
.amazingaffiliates_admin_page .navbar_menu_current_item.edit { border-color: green; background-color:#90EE9044; }
.amazingaffiliates_admin_page .navbar_menu_current_item.manage { border-color: gold; background-color:#F0E68C44; }
.amazingaffiliates_admin_page .navbar_menu_current_item.learn { border-color: blue; background-color:#87CEFA44; }	
.amazingaffiliates_admin_page .navbar_menu_current_item.settings { border-color: gray; background-color:#D3D3D388; }

/* common admin */
#wpcontent { background-color: white; }
.amazingaffiliates_admin_page #header { display:flex; flex-direction:column; padding:50px; text-align:center; justify-content:flex-start; align-items:center; }

.amazingaffiliates_admin_page h1 { display:inline-flex; align-items:center; gap:10px; justify-content:center; }
.amazingaffiliates_admin_page h2 big { font-weight: bold; }

.amazingaffiliates_admin_page section { padding:25px; border:1px solid lightgray; border-radius:5px; margin:0 10px; }

.amazingaffiliates_admin_page .tocopy { background-color:white; color:black; transition:0.3s ease-out; box-sizing: content-box; }
.amazingaffiliates_admin_page .tocopy:hover { background-color:gray; color:white; transition:0s; }
.amazingaffiliates_admin_page .tocopy:active { background-color:gray; color:white; transition:0s; }

/* metaboxes */
.amazingaffiliates_custom_meta_metabox { display: flex; flex-wrap:wrap; gap:5px; }
.amazingaffiliates_metabox_element  { flex-basis:100%; }
@media (min-width:769px) {
    .amazingaffiliates_metabox_element  { flex-basis:40%; flex-grow:1; }
    .amazingaffiliates_metabox_element .product_container .amazing_product.wrapper { margin-top:3px; }
    .amazingaffiliates_metabox_element.product_preview .product_container.product_block .product_toolbar { top: 5px; }
}
.amazingaffiliates_custom_fields_group { flex-grow:1; display: flex; flex-wrap: wrap; border: 1px solid gray; margin: 3px 0; border-radius: 5px; overflow: hidden; padding-top:40px; position:relative; }
.amazingaffiliates_custom_fields_group_title { padding: 9px; height: 40px; font-size: 1.2em; font-weight: 600; box-sizing: border-box; margin: 0; position: absolute; top: 0px; }
.amazingaffiliates_custom_fields { display:flex; flex-direction: column; padding:3px 2px 5px 2px; outline:1px solid lightgray; flex-grow: 1; }
.amazingaffiliates_custom_fields label { margin: 0 0 3px 3px; font-weight: 600; }
.amazingaffiliates_custom_fields p { margin: 0 0 3px 3px; }
.amazingaffiliates_custom_fields ul { padding: 0 0.75em; margin: 0; list-style-type: circle; list-style-position: inside; }
.amazingaffiliates_custom_fields a  { padding: 0.25em 0.75em; margin: 0.25em; background-color:white; border-radius:5px; }
.green_metabox 	{ background-color: #4caf50; color: white; outline:1px solid #51b361; }
.gold_metabox   { background-color: gold; color: black; outline:1px solid gray; }
.red_metabox 	{ background-color: #f44336; color: white; outline:1px solid #eb5f35; }
.gray_metabox { background-color: #ebebeb; color: #393939; outline:1px solid gray; }

.metabox16 		{ flex-basis:15%; }
.metabox25 		{ flex-basis:24%; }
.metabox33 		{ flex-basis:32%; }
.metabox50 		{ flex-basis:49%; }
.metabox66 		{ flex-basis:65%; }
.metabox75 		{ flex-basis:74%; }
.metabox100 	{ flex-basis:100%; }

/* product block editor */
.amazingaffiliates_product_field .editableList { display:flex; flex-wrap:wrap; width:100%; border:1px solid lightgray; border-radius:5px; padding:0 0.5em;}
.amazingaffiliates_product_field .editableList textarea { width:60%; flex-grow:4; display:none; }
.amazingaffiliates_product_field .editableList #clearproductid { width:10%; flex-grow:1; display:none; }
.amazingaffiliates_product_field #list_display { width:100%; margin:1em 0 0.5em 0; list-style: decimal; list-style-position: inside; display:grid; grid-template-columns:auto auto; gap:5px; align-items:flex-start; }
.amazingaffiliates_product_field #list_display li { flex-grow:1; display:flex; justify-content:flex-start; align-items:center; gap:5px; min-height:23px; box-sizing:border-box; margin:0; border: 1px solid lightgray; border-radius: 5px; width: 100%; transition:0.3s ease; }
.amazingaffiliates_product_field #list_display li:hover { background-color:#eeeeff; transition: 0.1s ease; }
.amazingaffiliates_product_field #list_display button:not(#addproductid) { box-sizing: border-box; padding: 0 6px 2px 7px; display: flex; align-items: center; background-color: tomato; color: white; border: 0px solid lightgray; width: 24px; height: 25px; border-radius: 5px 0px 0px 5px; margin: -1px 0 -1px -1px; }
.amazingaffiliates_product_field .clearableTextarea { display: flex; flex-grow: 1; transition: 0.1s;}
.amazingaffiliates_product_field #addproductid { background-color:mediumseagreen; color:white; border:1px solid lightgray; width:25px; height:25px; box-sizing:border-box; border-radius:5px;  }
.amazingaffiliates_product_field .clearableTextarea { display: flex; flex-grow: 1; transition: 0.1s;}
.amazingaffiliates_product_field #addproductid:hover { filter:brightness(1.15); }
.amazingaffiliates_product_field #addproductid:active { transform:translate(1px, 1px); }
.amazingaffiliates_product_field { border-top: 1px solid lightgray; padding: 7px; margin:0; }
.amazingaffiliates_product_field .amazingaffiliates_product_field { margin:5px 0; border: 1px solid lightgray; border-radius:5px; }
.amazingaffiliates_product_field .hiddencontrol { display: none; }
.amazingaffiliates_product_field label.panel { width:100%; display:block; }
.amazingaffiliates_product_field .label { position: absolute; top: -10px; left: 7px; font-size: 13px; padding: 0 2px; background-color: white; font-weight:600; }
.amazingaffiliates_product_field .control { position:relative; width:100%; display:flex; justify-content:space-between; gap:5px; align-items:center; margin:15px 0 5px 0; }
.amazingaffiliates_product_field select , .wp_1p4_product_field input , .wp_1p4_product_field textarea   { flex-grow:1; margin:0; }
.amazingaffiliates_product_field select { padding-top:5px; padding-bottom:2px; }
.amazingaffiliates_product_field input[type="text"] , .wp_1p4_product_field input[type="number"] , .wp_1p4_product_field input[type="integer"] { padding-top: 3px; }
.amazingaffiliates_product_field textarea {  border: 1px solid #ccc;  padding: 1px 6px; resize: none; height:1.8em; padding-top: 7px; flex-grow: 1; }
.amazingaffiliates_product_field .numericpanel { margin: 3px 0; display: flex; flex-wrap: wrap; }
.amazingaffiliates_product_field .numericinput { display:flex; align-items: stretch; flex-grow: 1; margin: -5px 0 0 0; }
.amazingaffiliates_product_field .numericinput .shortinput { margin: 2px 0; width: 50%; flex-grow: 30; }
.amazingaffiliates_product_field .numericinput button { margin: 2px 1px; border-radius: 3px; padding: 0 10px; border: 1px solid gray; flex-grow:1; }
.amazingaffiliates_product_field .switch { position: relative; display: inline-block; width: 48px; height: 24px; margin: 5px 5px 5px 0; }
.amazingaffiliates_product_field .switch input { opacity: 0; width: 0; height: 0; }
.amazingaffiliates_product_field .slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #ccc; -webkit-transition: .4s; transition: .4s; border-radius: 30px;  }
.amazingaffiliates_product_field .slider:before { position: absolute; content: ""; height: 16px; width: 16px; left: 4px; bottom: 4px; background-color: white; -webkit-transition: .4s; transition: .4s; border-radius: 50%; }
				
.amazingaffiliates_product_field input:checked + .slider { background-color: #2196F3; }
.amazingaffiliates_product_field input:focus + .slider { box-shadow: 0 0 1px #2196F3; }
.amazingaffiliates_product_field input:checked + .slider:before { -webkit-transform: translateX(24px); -ms-transform: translateX(24px); transform: translateX(24px); }
.amazingaffiliates_product_field .refreshdiv { display: flex; justify-content: center; align-items: center; padding-bottom: 5px; }
.amazingaffiliates_product_field #refreshafter { height: 30px; width: 30px; transform: rotate(0deg); transition: 0s ease-out; background-color:green; border-radius:25px; color: white; display: flex; justify-content: center; align-items: center; font-size: 18px; }	

.amazingaffiliates_product_field #refreshafter.refreshing { transform: rotate(360deg); transition: 1s; }

.amazingaffiliates_product_field .container {  position: relative; margin: 0 8px 0 2px; cursor: pointer; font-size: 22px; -webkit-user-select: none; -moz-user-select: none; -ms-user-select: none; user-select: none; }
.amazingaffiliates_product_field .container input { position: absolute; opacity: 0; cursor: pointer; height: 0; width: 0; }
.amazingaffiliates_product_field .shortinput { min-height:21px; }

.amazingaffiliates_product_field summary { margin: -7px -7px 0 -7px; padding: 7px; }
.amazingaffiliates_product_field.amazingproductblock 			summary { background-color: PaleGreen; }
.amazingaffiliates_product_field.amazingproductblockwrapper 	summary	{ background-color: LightYellow; }
.amazingaffiliates_product_field.amazingproductblockproduct 	summary	{ background-color: #ffeee7; }
.amazingaffiliates_product_field.amazingproductblockhide 		summary	{ background-color: Lavender; }

/* tabs */
.amazingaffiliates_admin_page .tabcontent { display: none; }
.amazingaffiliates_admin_page .tab { overflow: hidden; border: 1px solid #ccc; background-color: #f1f1f1; display: flex; justify-content: space-around; margin:0 10px; }
.amazingaffiliates_admin_page .tab button { flex-grow:1; background-color: inherit; float: left; border: none; outline: none; cursor: pointer; padding: 14px 16px; transition: 0.3s; font-size: 17px;	}
.amazingaffiliates_admin_page .tab button:hover { background-color: #ddd;	}
.amazingaffiliates_admin_page .tab button.active { background-color: #ccc; }

/* jQuery UI tabs */
.amazingaffiliates_tab  ul { display: flex; background-color: #eee; justify-content: space-around; margin:10px 10px 0 10px; border:1px solid #ccc; }
.amazingaffiliates_tab  li { flex-grow: 1; display: flex; justify-content: center; margin:0; }
.amazingaffiliates_tab  li:hover { background-color: #ddd; }
.amazingaffiliates_tab  li.ui-state-active {  background-color: #ccc; }

.amazingaffiliates_tab  li a  { flex-grow: 1; display: flex; justify-content: center; padding:15px 7px; color:black; font-size:125%; text-decoration:unset;}

/* forms */
.button.button-primary.amazingaffiliates_submit { margin: 0 10px; }

/* dashboard */
.amazingaffiliates_admin_page #dashboard { display:flex; flex-wrap:wrap; gap: 10px; padding:10px;  }
.amazingaffiliates_admin_page .dashboard_menu_item { display:block; flex-basis:150px; flex-shrink:0; flex-grow:0; flex-wrap:wrap; padding:50px; border-width:3px; border-style:solid; border-radius:5px; color:black; text-decoration:none; transition:0.1s; }
.amazingaffiliates_admin_page .dashboard_menu_item:hover { color:black; }

/* inventory */
.amazingaffiliates_admin_page .inventory_filters  { display:flex; margin:2px 0; width:100%; flex-wrap:wrap;  }
.amazingaffiliates_admin_page .wp-core-ui .inventory_filters select  { max-width:unset; }
.amazingaffiliates_admin_page .filter_element     { display:flex; flex-grow:1; margin:2px; }
.amazingaffiliates_admin_page .filter_element>*   { display:flex; flex-grow:1; }

/* workshop */
.amazingaffiliates_admin_page #workshop_forge                        { display:flex; flex-wrap:wrap; align-items:stretch; gap:5px; margin:10px 0; border:1px solid lightgray; border-radius:5px; padding: 0.5em; margin:10px;  }
.amazingaffiliates_admin_page #workshop_forge div				     { flex-grow:1; border:1px solid gray; border-radius:5px; }
.amazingaffiliates_admin_page #asins_crucible    					 { flex-grow:1; border:1px solid gray; border-radius:5px; margin:0; display:flex; flex-direction:column; gap:5px;  padding:10px; }
.amazingaffiliates_admin_page .crucibled_asin    					 { list-style-position: inside; }
.amazingaffiliates_admin_page .crucibled_asin button				 { background-color:tomato; color:white; font-weight:600; border:none; border-radius:100%; align-items: center; display: inline-flex; justify-content: center; width: 20px; height: 20px; font-size: 16px; padding-bottom: 2px; }
.amazingaffiliates_admin_page .crucibled_asin button:hover			 { background-color:red; }
.amazingaffiliates_admin_page .crucibled_asin button:active			 { transform:translate(1px , 2px); }
.amazingaffiliates_admin_page #asin_purifier                         { display:flex; width:100%; }
.amazingaffiliates_admin_page #workshop_forge textarea               { flex-grow:1; }
.amazingaffiliates_admin_page #workshop_forge button                 { flex-basis:100px; }
.amazingaffiliates_admin_page #workshop_forge .correct_asin          { font-weight:600; color:green; }
.amazingaffiliates_admin_page #workshop_forge .invalid_asin          { color:gray; }
.amazingaffiliates_admin_page #workshop_forge .invalid_asin span     { text-decoration: line-through; }



.amazingaffiliates_admin_page #consolebox								{ position:relative; border-radius: 5px; overflow:hidden; margin:10px;  }
.amazingaffiliates_admin_page #console                                { color: #66ff77; background-color: #282828; padding:5px; overflow-y:scroll; height:1.2em; scrollbar-color: #66ff77 #202020; display:flex; flex-direction:column; justify-content:flex-end; line-height: 1.5em; }
.amazingaffiliates_admin_page #console.extended							{ height:25em; }
.amazingaffiliates_admin_page #expand									{ background-color:#282828; color:#66ff77; position:absolute; width:80px; right:22px; bottom:0; height:1.9em; }
.amazingaffiliates_admin_page #latest_products                      	{ display: grid; gap: 15px; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
.amazingaffiliates_admin_page .product_tile								{ display:flex; flex-wrap:wrap; border-radius:10px; box-sizing: border-box; height:100%; overflow:hidden; z-index:2; padding:2px; }

.amazingaffiliates_admin_page .product_tile	.tile_title					{ padding: 5px 10px; line-height: 1em; background-color:lightgray; width:calc( 100% + 30px ); height:40px; box-sizing: border-box; margin:0; left:0; font-weight:600; }
.amazingaffiliates_admin_page .product_tile	.inside_tile				{ background-color:white; border-radius: 8px; padding:0 15px; display: flex; flex-direction: column; justify-content: space-around; width: 100%; }
.amazingaffiliates_admin_page .product_tile .product_img				{ height: auto; width:100%; padding:15px; box-sizing: border-box; }
.amazingaffiliates_admin_page .product_tile .inside_tile a				{ font-size: min(18px, 4vw); line-height: 1.3em; display:flex; padding-bottom:0.5em; word-break: break-all; }

.amazingaffiliates_admin_page .product_tile .product_tile_editorbar					{ border-radius:0 0 5px 5px; margin:0 -15px;; padding: 5px 5px 5px 5px; z-index:0; display: flex; flex-wrap:wrap; gap:3px; }
.amazingaffiliates_admin_page .product_tile .product_tile_editorbar .input			{ font-size:14px; text-align: center; margin:0; padding: 5px; border-radius: 5px; border: 1px solid gray; min-width: 75px; flex-grow:1; height:30px; box-sizing: border-box; flex-basis:40%; }
.amazingaffiliates_admin_page .product_tile .product_tile_editorbar .availabilitybutton { border-radius: 4px; height: 30px; line-height: 1.2em; text-align: center; display: flex;
    justify-content: center; align-items: center; gap:5px; outline: 1px solid #8c8f94; margin:0; width:100%; text-decoration:none; color:black; box-sizing: border-box; font-size:100%; padding-bottom:0; }

.amazingaffiliates_admin_page .product_tile .product_tile_editorbar .availabilitybutton img { border-radius:5px; background-color:white; padding:3px;  box-sizing: border-box; width:20px; }

.amazingaffiliates_admin_page .product_tile .product_tile_editorbar .buttonedit { display: inline-flex; border-radius: 7px; transition: filter ease 0.4s, transform ease 0.2s; justify-content: center; align-items: center; width: 39px; height: 39px; box-sizing: border-box; background-color: white; border: 1px solid lightgray; overflow:hidden; padding:5px;}

.amazingaffiliates_admin_page .product_tile .product_card { flex-direction:column; }
.amazingaffiliates_admin_page .product_tile .product_card span { position:relative; height: 4em; }
.edittextbutton { display: inline; position: relative; bottom: -4px; right: -5px; height: 18px; width: 18px; filter: brightness(0.66) contrast(3.5) hue-rotate(223deg) saturate(0.3); }

.amazingaffiliates_admin_page .product_tile_bottom_editorbar { display: flex; justify-content: flex-end; gap: 5px; margin: -10px 10px 10px 10px; border-radius: 0 0 5px 5px; padding: 15px 5px 5px 5px; flex-grow: 0; position: relative; z-index: 0; background-color: #f5f5f5; }
.amazingaffiliates_admin_page .product_tile_bottom_editorbar button { height: 28px; width: 28px; box-sizing: content-box; }

/* warehouse */
.amazingaffiliates_admin_page .warehouse_selectors					        { display:flex; flex-direction:column; gap:5px; margin:10px; border:1px solid lightgray; border-radius:5px; padding: 0.5em; }
.amazingaffiliates_admin_page .warehouse_selector_wrapper				    { display:flex; flex-wrap:wrap; gap:5px; }
.amazingaffiliates_admin_page .warehouse_selector_wrapper div			    { flex-basis:150px; flex-grow:1; }
.amazingaffiliates_admin_page .warehouse_selector						    { display:flex; width:100%; flex-grow:1; align-items:center; position:relative; margin:0; }
.amazingaffiliates_admin_page .warehouse_selector.labeled				    { margin-top:20px; }
.amazingaffiliates_admin_page .warehouse_selector.labeled>label				{ margin-right:10px; position:absolute; top:-18px; left:3px; font-size:12px; font-weight:600; }
.amazingaffiliates_admin_page .warehouse_selector select				    { width:100%; }
.amazingaffiliates_admin_page .warehouse_selector input[type="text"]		{ width:100%; font-size:13px; }
.amazingaffiliates_admin_page .warehouse_selector input[type="checkbox"]	{ display:none; }
.amazingaffiliates_admin_page .warehouse_selector input+label               { border:1px solid lightgray; padding:3px 7px; border-radius:5px; }
.amazingaffiliates_admin_page .warehouse_selector input:checked+label 		{ background-color:steelblue; color:white; }
.amazingaffiliates_admin_page .warehouse_selector .chosen-choices 	        { border-radius:5px; }

.amazingaffiliates_admin_page #warehouse_amazing_product_category_selector ,
.amazingaffiliates_admin_page #warehouse_amazing_product_tag_selector           { display:flex; justify-content:flex-start; gap:5px; border:1px solid #8c8f94; padding:5px; border-radius:5px; }

.amazingaffiliates_admin_page #product_display					{  }
.amazingaffiliates_admin_page #product_display .list_item			{ position:relative; flex-basis:250px; flex-grow:1; background-color:white; border-radius:9px; padding:0.5em; display: grid; grid-template-columns: 50px auto; column-gap: 2%; align-items:center; }
.amazingaffiliates_admin_page #product_display .list_item *			{ transition:1s; opacity:1; filter:blur(0px); }

.amazingaffiliates_admin_page .product_container	{ position:relative; display:flex; flex-direction:column; height:100%;}
.amazingaffiliates_admin_page .product_toolbar		{ z-index:999; position:absolute; display: flex; justify-content: center; align-items: center; gap:4px; top:5px; right:6px; }
.amazingaffiliates_admin_page .product_container.product_block .product_toolbar { top:12px; }

.amazingaffiliates_admin_page .product_update,
.amazingaffiliates_admin_page .product_edit,
.amazingaffiliates_admin_page .product_delete		{ border-radius:6px; display: flex; justify-content: center; align-items: center; box-sizing: border-box; height:32px; width:32px; background-color:white; font-weight:600; font-size:1.5em; padding:0 1px; overflow:hidden; }

.amazingaffiliates_admin_page .product_update		{ border:2px solid green; color:green; transition:1s ease-in-out; }
.amazingaffiliates_admin_page .product_edit			{ border:2px solid gold; color:gold; transition:0.1s ease-out; }
.amazingaffiliates_admin_page .product_edit:hover	{ transform:scale(1.1); }
.amazingaffiliates_admin_page .product_edit:active	{ transform:scale(50); opacity:5%; }
.amazingaffiliates_admin_page .product_delete		{ border:2px solid red; color:red; }

.amazingaffiliates_admin_page .product_warehouse .title				{ font-size:88%; margin:0; }
.amazingaffiliates_admin_page .product_warehouse .copy_product_asin 	{ font-size: smaller; display: inline; min-height: unset; max-width: 65px; box-sizing:unset; }
.amazingaffiliates_admin_page .product_warehouse .image				{ display:flex; flex-direction:column; align-self: flex-start; }
.amazingaffiliates_admin_page .product_warehouse .image img			{ display:block; border-radius:12px; max-width:50px; max-height:50px; }
.amazingaffiliates_admin_page .product_warehouse .info				{ font-size:77%; margin:0; }
.amazingaffiliates_admin_page .product_warehouse .infotitle			{ font-weight:600; }
.amazingaffiliates_admin_page .taxonomy_label		{ padding:1px 5px; border-radius:5px; background-color:lightgray; margin:2px; }

/* setting */
.amazingaffiliates_settings .missing_value_row { background-color:#ff000033; color:red; font-weight:bold; font-size:120%;  }
.amazingaffiliates_settings .missing_value { border:3px solid red; padding:10px; }
.amazingaffiliates_settings .th { display:flex; align-items:center; padding: 15px; min-height: 50px; }

/* setup */
.amazingaffiliates_setup .tr:not(:last-child) { margin-bottom:1.5em; }
.amazingaffiliates_setup .tr.lineseparator .td { padding:15px; }
.amazingaffiliates_setup .tr:not(.lineseparator) { display:flex; flex-wrap:wrap; gap:1em; align-items:center; padding:1.5em; position:relative; border:1px solid #55cc55; border-radius:10px; }
.amazingaffiliates_setup .tr.missing_value_row { border:5px solid #dddd55; }
.amazingaffiliates_setup .th { position:absolute;top:-15px;background-color:white;min-height:unset;width:unset;padding:7px;margin-left:10px; }
.amazingaffiliates_setup .tr.missing_value_row .th { top:-20px; border:1px solid #dddd55;border-radius:3px;}
.amazingaffiliates_setup .tr.missing_value_row .th::after { content:"!";color:#dddd55; border: 1px solid #dddd55; border-radius: 50%; margin-left:7px; margin-right:2px; padding:1px 8px; } 
.amazingaffiliates_setup .tr:not(.missing_value_row) .th::after { content:"✓";color:#55cc55; border: 1px solid #55cc55; border-radius: 50%; margin-left:7px; margin-right:2px; padding:1px 5px;}
.amazingaffiliates_setup .td:nth-child(2) { flex-basis:250px; flex-grow:0; vertical-align: top; }
.amazingaffiliates_setup .td.desc { flex-basis:40%; flex-grow:1; font-size:120%; }

/* workshop product */
.product_container .amazing_product.wrapper								{ z-index: 1; position: relative; flex-direction:row; justify-content:center; border-radius:12px; margin:0.75em 0; }
.product_container .amazing_product .wrappertext						{ margin:7px 15px; font-weight:600; color:white; }
.product_container .amazing_product .product_block						{ padding:0.75em; display:flex; flex-direction:row; justify-content:center; flex-wrap:wrap; border-radius:9px; outline:1px solid lightGray;	 }
.product_container .amazing_product .product_thumbnail					{ display:flex; margin:0.75em 0.75em 0 0.75em; flex-basis:100px; flex-grow:1; flex-direction:column; align-items:center; }
.product_container .product_container .amazing_product .product_thumbnail .product_img		{ display:block; margin:10px auto 10px auto; border-radius:12px; object-fit:scale-down; max-height:300px; }
.product_container .amazing_product .product_thumbnail .no_img_found   	{ width: 100%; aspect-ratio: 1/1; background-color: lightgray; justify-content: center; align-items: center; display: flex; text-align: center; }
.product_container .amazing_product .product_thumbnail p					{ font-size:60%; text-decoration:underline; text-align:center; padding:0 0 1.5em 0; margin:0; }
.product_container .amazing_product .product_title						{ padding-bottom:5px; margin-bottom:20px; border-bottom:solid 1px lightgray; font-size:120%; line-height: 1.4em; }
.product_container .amazing_product .product_info						{ margin:0.75em 0.75em 0 0.75em; flex-basis:250px; flex-grow:3; }
.product_container .amazing_product .product_info a .product_title     { text-decoration:none; }
.product_container .amazing_product .custom_content_after ,
.product_container .amazing_product .custom_content_before				{ margin:0; }
.product_container .amazing_product .product_block                     { text-decoration:none; }
.product_container .amazing_product ol, 
.product_container .amazing_product ul					                { margin: 0 0 0 1em; font-size: 100%; padding: 0; line-height: 1.4; }
.product_container .amazing_product ul	                                { list-style: disc; }
.product_container .amazing_product li									{ padding-bottom:5px; }
.product_container .amazing_product table             					{ border-radius:12px;  overflow:hidden; border:solid 1px lightgray; border-spacing: 0; margin-bottom: 20px; }
.product_container .amazing_product tr:nth-child(even) 					{ background-color:#fafafa; }
.product_container .amazing_product tr:nth-child(odd) 					{ background-color:white; }
.product_container .amazing_product table td          					{ border:unset; font-size:90%; vertical-align: text-top; width:100%; padding: 5px 12px; }
.product_container .amazing_product table tr td:first-child				{ text-transform: capitalize; font-size:80%; font-weight:600; }
.product_container .amazing_product table tr			 					{ transition: filter ease-out 0.4s; }
.product_container .amazing_product table tr:hover 	 					{ filter: brightness(93%); }
.product_container .amazing_product .product_rating						{ margin:10px 0; display:flex; align-items:center; font-size: 115%; }
.product_container .amazing_product .product_opinion						{ margin:0; }
.product_container .amazing_product .product_list_price					{ font-size:90%; color:#767676; margin:0.5em 0; }
.product_container .amazing_product .product_barred_price				{ text-decoration:line-through; font-weight:600; font-size:115%; }
.product_container .amazing_product .product_current_price				{ font-size:90%; color:black; margin:0.5em 0; }
.product_container .amazing_product .product_highlighted_price			{ color:green; font-weight:600; font-size:140%; }
.product_container .amazing_product .product_price_postcomma				{ font-size:80%; }

.product_container .amazing_product .product_buybutton					{ display:inline-block; border-radius:12px; padding:10px 20px; margin:0.75em 0; text-decoration: none;
														box-shadow: 2px 2px 3px 0 rgba(0, 0, 0, .2); transition: background-color ease 0.3s , transform ease 0.2s; }
.product_container .amazing_product .product_buybutton.orange			{ background-color:#fcb900; color:black;  }
.product_container .amazing_product .product_buybutton.orange:hover	{ background-color:#ffca4a; }
.product_container .amazing_product .product_buybutton.orange:active	{ background-color:#eba600; transform: translate(1px,1px); }

@keyframes offer_flip {
    0%      {  	transform: rotateX(0); 			}
    40%     {	transform: rotateX(0);			}
    49%     {  	transform: rotateX(90deg); 		}
    50%		{	 								}
    51%     {	transform: rotateX(90deg);		}
    60%     {  	transform: rotateX(0);			}
    99%    	{	transform: rotateX(0); 			}
    100%	{	 								}
}
@keyframes offer_switch {
    0%      {  	opacity: 1;	}
    40%     {				}
    49%     {  	opacity: 1;	}
    50%	    {	opacity: 0; }
    51%     {				}
    60%     {  				}
    99%    	{	opacity: 0;	}
    100%	{	opacity: 0; }
}
@media (max-width:768px)    {
  	.offer_flip { height:4em; }
  	.offer_flip::after , .offer_flip::before { height:4em; }
}
.product_container .offer_flip	{
    position:relative; width: 100%; display: flex; align-items: center; background-color: yellow; border-radius: 10px; height:40px;	animation: offer_flip 2s -1s cubic-bezier(0.455, 0.030, 0.515, 0.955) infinite alternate;
}
.product_container .offer_front ,
.product_container .offer_rear {
    position:absolute; padding: 2px 0; color: black; font-size: min(110% , 4vw); font-weight:600; width:100%; display: flex; justify-content: center; align-items: center;
}
.product_container .offer_front {
    animation: offer_switch 2s -1s cubic-bezier(0.455, 0.030, 0.515, 0.955) infinite alternate;
}
.product_container .offer_rear {
    animation: offer_switch 2s -3s cubic-bezier(0.455, 0.030, 0.515, 0.955) infinite alternate;
}

.product_container .amazing_product.outerbox 				{ display:flex; flex-direction:column; justify-content:flex-start; align-items:stretch; flex-wrap:wrap; outline:2px solid lightGray; border-radius:12px; background-color:#f6f6f6; padding: 15px; }

.product_container #search { display:none; }
.product_container .amazing_product.outerbox .searchbox        { display:flex; justify-content:stretch; flex-grow:1; }
.product_container .amazing_product.outerbox .searchbar        { flex-grow:1; height: 30px; margin:0 10px; padding: 5px; resize: none; scrollbar-width: none;}
.product_container .amazing_product.outerbox .setup			{ margin:15px 0 15px 0; text-align:center; border-bottom:solid 1px lightgray; }
.product_container .amazing_product.outerbox .setuptip		    { margin:15px; text-align:center; color:#333; font-style:italic; font-size:80%; display: flex; justify-content: center; align-items: center; flex-direction: column; }
.product_container .amazing_product.outerbox .entrylist		{ display:flex; gap:5px; width:100%; justify-content:center; }
.product_container .amazing_product.outerbox .entrybox		    { cursor:pointer; display:flex; flex-direction:column; align-items:center; border: 2px solid gray; border-radius: 5px; padding: 5px; background-color:white; }
.product_container .amazing_product.outerbox .entryimg		    { max-height: 90px; width: auto; margin:5px; }
.product_container .amazing_product.outerbox .entrydesc	    { padding:0; text-align:left; flex-grow:1; font-size:75%; line-height:1.2em;  }
.product_container .amazing_product.outerbox .entryp  	        { margin-bottom:0; }
.product_container .amazing_product.outerbox .linktoworkshop   { background-color: beige; box-shadow:0px 0px 1px silver; transition:0.5s; border: 1px solid silver; border-radius: 5px; padding: 8px 10px 5px 10px; display: inline-block; }
.product_container .amazing_product.outerbox .linktoworkshop:hover { background-color: gold; color:black; box-shadow:1px 1px 1px silver; }
.product_container .amazingaffiliates_product_block_notice     { margin: 0 7px 9px 7px; display: block; font-style: italic; color: gray; text-align: center; }

.product_container .amazing_product .product_img.no_img_found { width:300px;height:300px;background-color:lightgray;justify-content:center;align-items:center; display: flex; text-align: center; }

.product_container .amazing_product_editorbar { display:flex; justify-content:flex-end; gap:5px; margin:-20px 15px 25px 15px; border:1px solid silver; border-radius:0 0 5px 5px; padding:15px 5px 5px 5px; flex-grow:0; position:relative; z-index:0; background-color:#eee; }
.product_container .amazing_product_editorbar a ,
.product_container .amazing_product_editorbar button { display:flex; justify-content:center; align-items:center; padding:0 5px; min-width:40px; background-color:white; border-radius:5px; border:1px solid gray;  }
.product_container .amazing_product_editorbar .product_availability { flex-grow:1; display:flex; justify-content:center; align-items:center; color:white; gap:5px; padding:5px; }
.product_container .amazing_product_editorbar .product_availability img { border-radius:5px; background-color:white; padding:2px; }

.product_container .amazing_product_editorbar .product_update ,
.product_container .amazing_product_editorbar .product_edit ,
.product_container .amazing_product_editorbar .product_delete { height: 40px; width: 40px; }


.product_container .amazing_product_editorbar .product_edit    { border-radius:6px; display: flex; justify-content: center; align-items: center; box-sizing: border-box; background-color:white; font-weight:600; font-size:1.5em; padding:0 1px; overflow:hidden; }

.product_container .amazing_product_editorbar .product_edit		{ border:2px solid gold; color:gold; transition:0.1s ease-out; }
.product_container .amazing_product_editorbar .product_edit:hover	{ transform:scale(1.1); }
.product_container .amazing_product_editorbar .product_edit:active	{ transform:scale(50); opacity:5%; }

.product_container .tocopy { background-color:white; color:black; transition:1.2s 0.3s ease-out; box-sizing: content-box; }
.product_container .tocopy:active { background-color:steelblue; color:white; transition:0s; }

.product_container #showdetails { color:black; }
