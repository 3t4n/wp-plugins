jQuery(document).ready(async function(){let t=async()=>{await connectWallet(jQuery("#monft-mp-connect-wallet"))};void 0!==window.ethereum&&window.ethereum.request({method:"eth_accounts"}).then(t=>{0!==t.length&&jQuery("#monft-mp-connect-wallet").text("Wallet connected: "+t[0].substring(0,5)+"...."+t[0].substring(37,42))}).catch(t=>{console.log(t,t.code)}),jQuery("#monft-mp-connect-wallet").click(t)});