msgstr "Masquer la photo de profil de l'auteur de l'avis"

#: admin/class-widgets-for-google-reviews-and-ratings-admin.php:496
msgid "Hide Google Logo"
msgstr "Masquer le logo Google"

#: admin/class-widgets-for-google-reviews-and-ratings-admin.php:502
msgid "Hide Widget Rating Text (e.g. EXCELLENT XXX reviews)"
msgstr "Cacher le texte d'évaluation du widget (par ex. EXCELLENT XXX avis)"

