#. Plugin Name of the plugin
#: widgets-for-google-reviews-and-ratings.php
msgid "Widgets for Google Business Reviews and Ratings"
msgstr "Vidinad Google’i äriliste arvustuste ja hinnangute jaoks"

#. Plugin URI of the plugin
#: widgets-for-google-reviews-and-ratings.php
msgid "https://repocean.com/"
msgstr "https://repocean.com/"

#. Description of the plugin
#: widgets-for-google-reviews-and-ratings.php
msgid ""
"Quickly and easily embed Google reviews into your WordPress site. Boost SEO, "
"build trust, and increase sales with Google reviews."
msgstr ""
"Sisestage Google’i arvustused kiiresti ja lihtsalt oma WordPressi saidile. "
"Suurendage SEO-d, looge usaldust ja suurendage müüki Google’i arvustustega."

#. Author of the plugin
#: widgets-for-google-reviews-and-ratings.php
msgid "repocean"
msgstr "repocean"

#. Author URI of the plugin
#: widgets-for-google-reviews-and-ratings.php
msgid "https://profiles.wordpress.org/repocean/"
msgstr "https://profiles.wordpress.org/repocean/"

