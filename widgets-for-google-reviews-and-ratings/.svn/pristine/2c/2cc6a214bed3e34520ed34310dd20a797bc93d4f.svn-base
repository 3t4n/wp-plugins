#. Plugin Name of the plugin
#: widgets-for-google-reviews-and-ratings.php
msgid "Widgets for Google Business Reviews and Ratings"
msgstr "Widgets para Reseñas y Calificaciones de Negocios de Google"

#. Plugin URI of the plugin
#: widgets-for-google-reviews-and-ratings.php
msgid "https://repocean.com/"
msgstr "https://repocean.com/"

#. Description of the plugin
#: widgets-for-google-reviews-and-ratings.php
msgid ""
"Quickly and easily embed Google reviews into your WordPress site. Boost SEO, "
"build trust, and increase sales with Google reviews."
msgstr ""
"Integra reseñas de Google en tu sitio de WordPress de forma rápida y "
"sencilla. Mejora el SEO, genera confianza y aumenta las ventas con reseñas "
"de Google."

#. Author of the plugin
#: widgets-for-google-reviews-and-ratings.php
msgid "repocean"
msgstr "repocean"

#. Author URI of the plugin
#: widgets-for-google-reviews-and-ratings.php
msgid "https://profiles.wordpress.org/repocean/"
msgstr "https://profiles.wordpress.org/repocean/"

