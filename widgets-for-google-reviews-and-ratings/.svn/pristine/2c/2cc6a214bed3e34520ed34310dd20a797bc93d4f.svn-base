msgstr "RepOcean verifica que la fuente original de la reseña es Google."

#: admin/class-widgets-for-google-reviews-and-ratings-admin.php:526
msgid "Shorten Reviewer Names (e.g., John Smith → John S.)"
msgstr ""
"Acortar los nombres de los revisores (por ejemplo, John Smith → John S.)"

#: admin/class-widgets-for-google-reviews-and-ratings-admin.php:534
msgid "Enable Dark Mode (Dark background with light text)"
msgstr "Activar el modo oscuro (fondo oscuro con texto claro)"

