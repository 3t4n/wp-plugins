#. Plugin Name of the plugin
#: widgets-for-google-reviews-and-ratings.php
msgid "Widgets for Google Business Reviews and Ratings"
msgstr "ગૂગલ બિઝનેસ સમીક્ષાઓ અને રેટિંગ્સ માટે વિજેટ્સ"

#. Plugin URI of the plugin
#: widgets-for-google-reviews-and-ratings.php
msgid "https://repocean.com/"
msgstr "https://repocean.com/"

#. Description of the plugin
#: widgets-for-google-reviews-and-ratings.php
msgid ""
"Quickly and easily embed Google reviews into your WordPress site. Boost SEO, build "
"trust, and increase sales with Google reviews."
msgstr ""
"ઝડપી અને સરળતાથી તમારી વર્ડપ્રેસ સાઇટમાં ગૂગલની સમીક્ષાઓ ને અમલમાં લાવો. SEOને વધારવા, વિશ્વાસ "
"બનાવવા અને ગૂગલની સમીક્ષાઓ સાથે વેચાણ વધારવા માટે કામ કરો."

#. Author of the plugin
#: widgets-for-google-reviews-and-ratings.php
msgid "repocean"
msgstr "repocean"

#. Author URI of the plugin
#: widgets-for-google-reviews-and-ratings.php
msgid "https://profiles.wordpress.org/repocean/"
msgstr "https://profiles.wordpress.org/repocean/"

