#doc-search{background-color:#fff;border-right:1px solid rgba(0,0,0,.1);height:100%;padding:50px 0;position:fixed;left:0;top:0;-webkit-transition:all .5s ease-in-out;transition:all .5s ease-in-out;z-index:100}#doc-search-contents{margin-top:39px;overflow-x:hidden;overflow-y:scroll;width:100%}#doc-search-contents::-webkit-scrollbar,#editor-container::-webkit-scrollbar{background-color:#fff;border-right:1px solid rgba(0,0,0,.1);display:block!important;width:10px}#doc-search-contents::-webkit-scrollbar-thumb,#editor-container::-webkit-scrollbar-thumb{background-color:#e1e1e1}#doc-search-contents .ent{background-color:rgba(255,255,0,.3)}#doc-search.hide{-webkit-transition:all .5s ease-in-out;transition:all .5s ease-in-out;webkit-transform:translate(-100%);-webkit-transform:translate(-100%);-ms-transform:translate(-100%);transform:translate(-100%)}#doc-search #loader{padding-top:35%;position:absolute}#doc-search-header{background-color:#f3f5f8;padding:4px 0 8px;position:fixed;top:0;z-index:1000}#doc-search-header div a{display:inline-block}#doc-search-header a{display:inherit;font-size:13px;text-transform:capitalize}#document-custom-search-box{border:1px solid rgba(0,0,0,.1);border-radius:3px;font-size:13px;margin-right:2%;position:relative;vertical-align:middle;width:96%}#document-custom-search-box div{background-color:#fff;border-radius:3px;padding:10px 8px}#document-custom-search-box span{font-size:14px}#document-custom-search-box .fa-search{font-size:13px;vertical-align:middle}#document-custom-search-box .fa-times{color:#fff}#document-country-filter{max-width:120px;position:absolute;left:0;text-align:left;top:0}#document-country-filter span{font-size:12px;text-transform:uppercase}#document-country-list ul{margin:0;max-height:400px;overflow-y:scroll;padding:0 5px}#document-country-list ul li{background-color:#fff;border-radius:3px;cursor:pointer;display:inline-block;list-style:none;margin:2px 0;width:100%}#document-country-list li div{background-color:#fff;padding:4px