.lexilink-switch{display:inline-block;height:25px;position:relative;width:50px}.lexilink-switch input{height:0;opacity:0;width:0}.lexilink-switch input:checked+.lexilink-switch__slider{background-color:#2271b1}.lexilink-switch input:checked+.lexilink-switch__slider:before{transform:translateX(25px)}.lexilink-switch__slider{background-color:#ccc;border-radius:34px;bottom:0;cursor:pointer;left:0;position:absolute;right:0;top:0;transition:.4s}.lexilink-switch__slider:before{background-color:#fff;border-radius:50%;bottom:2px;content:"";height:21px;left:2px;position:absolute;transition:.4s;width:21px}.lexilink-display__header{align-items:center;display:flex;flex-direction:column;margin-bottom:50px}.lexilink-display__header__filter__list{background-color:var(--lexilink-background-color,hsla(60,8%,95%,.749));border-radius:15px;color:var(--lexilink-color,#0d0f10);display:flex;flex-wrap:wrap;list-style:none;margin:0;padding:8px 16px;position:relative}.lexilink-display__header__filter__list__item{border-radius:5px;cursor:pointer;line-height:1;margin-right:8px;padding:4px;transition:all .5s ease}.lexilink-display__header__filter__list__item:last-child{margin-right:0}.lexilink-display__header__filter__list__item.active{background-color:var(--lexilink-background-color-active,#5b62e7);color:var(--lexilink-background-color,hsla(60,8%,95%,.749));cursor:auto}.lexilink-display__header__filter__list__item.empty{cursor:auto;opacity:.33}.lexilink-display__header__search-bar{margin-top:20px;position:relative}.lexilink-display__header__search-bar input{background-color:var(--lexilink-background-color,hsla(60,8%,95%,.749));border:none;border-radius:15px;box-shadow:none;color:var(--lexilink-color,#0d0f10);line-height:1;outline:none;padding:8px 30px 8px 12px;width:300px}.lexilink-display__header__search-bar__icon{background-image:url(data:image/svg+xml;base64,);background-position:50%;background-repeat:no-repeat;background-size:contain;height:20px;position:absolute;right:12px;top:50%;transform:translateY(-50%);width:20px}.lexilink-display__body{display:grid;grid-template-columns:repeat(4,1fr)}@media screen and (max-width:1024px){.lexilink-display__body{grid-template-columns:repeat(2,1fr)}}@media screen and (max-width:768px){.lexilink-display__body{grid-template-columns:1fr}}.lexilink-display__body__letter{border-bottom:1px solid #0d0f10;padding:46px 8px 64px}.lexilink-display__body__letter.empty .lexilink-display__body__letter__title{opacity:.3}.lexilink-display__body__letter.hide{display:none}.lexilink-display__body__letter.accordion .lexilink-display__body__letter__list__item__title__icon{cursor:pointer}.lexilink-display__body__letter.accordion .lexilink-display__body__letter__list__item__title__icon:after{background-image:url(data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIzMiIgaGVpZ2h0PSIzMiIgdmlld0JveD0iMCAwIDI0IDI0Ij48cGF0aCBmaWxsPSJjdXJyZW50Q29sb3IiIGQ9Ik03LjQxIDguNThMMTIgMTMuMTdsNC41OS00LjU5TDE4IDEwbC02IDZsLTYtNnoiLz48L3N2Zz4=);background-position:50%;background-repeat:no-repeat;background-size:contain;content:"";display:inline-block;height:20px;transition:transform .3s ease;width:20px}.lexilink-display__body__letter.accordion .lexilink-display__body__letter__list__item__excerpt{height:0;overflow:hidden}.lexilink-display__body__letter.accordion .lexilink-display__body__letter__list__item.open .lexilink-display__body__letter__list__item__title__icon:after{transform:rotate(180deg)}.lexilink-display__body__letter.accordion .lexilink-display__body__letter__list__item.open .lexilink-display__body__letter__list__item__excerpt{height:auto}.lexilink-display__body__letter__title{color:var(--lexilink-color,#0d0f10);margin:0 0 16px}.lexilink-display__body__letter__list{list-style:none;margin:0;padding:0}.lexilink-display__body__letter__list__item{margin-bottom:8px}.lexilink-display__body__letter__list__item__title{align-items:center;display:flex;justify-content:flex-start;margin-bottom:10px}.lexilink-display__body__letter__list__item__title__link{line-height:1}.lexilink-display__body__letter__list__item__title__link.link{color:var(--lexilink-background-color-active,#5b62e7)}.lexilink-display__body__letter__list__item__title__icon{align-items:center;display:flex;justify-content:center;padding:0 5px}.lexilink-display__body__letter__list__item:last-child{margin-bottom:0}
