/* Horizontally moveable table for small screens */

figure.mfdwc-block-table { 
    overflow-x: auto; 
    overflow-y: hidden; 
    margin: 1em 0px;
    }
    
.wp-block-table table {
  min-width: 500px;
}



/* Tooltip format */

#mfdwc_jqueryTooltip {
  position:absolute; /* das ist zwingend notwendig, damit der Tooltip der Maus folgen kann */
  display:none; /* auch wichtig damit der Tooltip leer nicht gezeigt wird */
  border:1px solid grey;
  background:LemonChiffon;
  padding:0.25em;
}
