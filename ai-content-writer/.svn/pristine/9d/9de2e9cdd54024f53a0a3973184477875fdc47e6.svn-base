msgid "Generate Content"
msgstr ""

#: includes/Admin/Admin.php:66 includes/Admin/Admin.php:67
#: includes/Admin/views/settings.php:15 includes/Plugin.php:124
#. translators: %1$s: Settings URL, %2$s: Settings text
msgid "Settings"
msgstr ""

#: includes/Admin/Admin.php:83 includes/Admin/Admin.php:84
#: includes/Admin/views/help.php:15
msgid "Help"
msgstr ""

#: includes/Admin/views/admin.php:17
msgid "Configure API Settings"
msgstr ""

#: includes/Admin/views/admin.php:20
msgid ""
"You can generate content here. This form will generate content based on the "
"below configurations."
msgstr ""

#: includes/Admin/views/admin.php:26 includes/Admin/views/admin.php:47
msgid "Prompt"
msgstr ""

#: includes/Admin/views/admin.php:28
msgid "Write a detailed, well-structured article on..."
msgstr ""

#: includes/Admin/views/admin.php:31
msgid ""
"Enter the prompt title to generate content. Please, start with \"Write an "
"article on...\""
msgstr ""

#: includes/Admin/views/admin.php:35
msgid "Related Keywords"
msgstr ""

#: includes/Admin/views/admin.php:37
msgid "keyword, keyword 2, keyword 3, ..."
msgstr ""

#: includes/Admin/views/admin.php:40
msgid ""
"Enter the related keywords to generate the article content. Separate each "
"keyword with a comma."
msgstr ""

#: includes/Admin/views/admin.php:44
msgid "Prompt Type"
msgstr ""

#: includes/Admin/views/admin.php:48
msgid "Completion"
msgstr ""

#: includes/Admin/views/admin.php:52
msgid "Select the type of prompt to generate the article content."
msgstr ""

#: includes/Admin/views/admin.php:56
msgid "Language"
msgstr ""

#: includes/Admin/views/admin.php:63
msgid "Select the language of the article. Currently, only English is supported."
msgstr ""

#: includes/Admin/views/admin.php:67
msgid "Min Words"
msgstr ""

#: includes/Admin/views/admin.php:72
msgid ""
"Enter the minimum words to generate the article content. Leave empty for "
"default."
msgstr ""

#: includes/Admin/views/admin.php:77
msgid "Below fields are optional for ChatGPT API"
msgstr ""

#: includes/Admin/views/admin.php:79
msgid "System Tone"
msgstr ""

#: includes/Admin/views/admin.php:84
msgid ""
"Select the system tone for the ChatGPT API. Leave empty for default. For "
"best results, use a tone that matches the content. Example: \"You are an "
"expert SEO content writer. Generate factually accurate, engaging, and "
"well-structured articles optimized for readability and search engines.\""
msgstr ""

#: includes/Admin/views/admin.php:88
msgid "Max Tokens"
msgstr ""

#: includes/Admin/views/admin.php:93
msgid "Enter the maximum tokens for the ChatGPT API. Leave empty for default."
msgstr ""

#: includes/Admin/views/admin.php:97
msgid "Temperature"
msgstr ""

#: includes/Admin/views/admin.php:102
msgid ""
"Enter the temperature for the ChatGPT API. Leave empty for default. "
"Example: 0.7"
msgstr ""

#: includes/Admin/views/admin.php:109
msgid "Publish content as"
msgstr ""

#: includes/Admin/views/admin.php:110
msgid "Type"
msgstr ""

#: includes/Admin/views/admin.php:116
msgid "Post Type"
msgstr ""

#: includes/Admin/views/admin.php:136
msgid "Select the post type to publish the content."
msgstr ""

#: includes/Admin/views/admin.php:143
msgid "Actions"
msgstr ""

#: includes/Admin/views/admin.php:147
msgid "Status"
msgstr ""

#: includes/Admin/views/admin.php:150
msgid "Publish"
msgstr ""

#: includes/Admin/views/admin.php:151
msgid "Draft"
msgstr ""

#: includes/Admin/views/admin.php:152
msgid "Pending"
msgstr ""

#: includes/Admin/views/admin.php:156
msgid "Select the status of the campaign."
msgstr ""

