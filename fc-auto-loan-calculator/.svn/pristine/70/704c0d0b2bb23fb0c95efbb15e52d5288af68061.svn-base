#. Populate with the ISO language code aligning with the language for the msgstr.
#: dist/js/interface.AUTO-LOAN.gpl.js:29
#: dist/js/interface.AUTO-LOAN.gpl.js:814
msgid "en"
msgstr "fi"

#. An instructional message which may appear to the user suggesting efficient way to edit data.
#: dist/js/interface.AUTO-LOAN.gpl.js:33
#: dist/js/interface.AUTO-LOAN.gpl.js:818
msgid "If value is selected, just start typing new value to clear prior value."
msgstr "Jos arvo on valittu, aloita uuden arvon kirjoittaminen tyhjentääksesi edellisen arvon."

#. Instructional message that may be shown to user when entering numbers.
#: dist/js/interface.AUTO-LOAN.gpl.js:34
#: dist/js/interface.AUTO-LOAN.gpl.js:819
msgid "When a number is selected (value shown in inverse), use right arrow key to clear selection without clearing value. Then backspace to edit."
msgstr "Kun numero on valittu (arvo näkyy käänteisenä), voit poistaa valinnan oikealla nuolinäppäimellä tyhjentämättä arvoa. Muokkaa sitten askelpalauttimella."

#. Instructional message that may be shown to user when entering numbers.
#: dist/js/interface.AUTO-LOAN.gpl.js:35
#: dist/js/interface.AUTO-LOAN.gpl.js:820
msgid "TIP: Generally it is best to use the TAB or SHIFT-TAB keys to move from one input to the next or previous input."
msgstr "VINKKI: Yleensä on parasta käyttää TAB- tai SHIFT-TAB-näppäimiä siirtyäksesi yhdestä syötteestä seuraavaan tai edelliseen syötteeseen."

#. Instructional message that may be shown to user when entering numbers.
#: dist/js/interface.AUTO-LOAN.gpl.js:36
#: dist/js/interface.AUTO-LOAN.gpl.js:821
msgid "TIP 2: Generally, editing a value is inefficient. Since values are auto selected, just type the number you want."
msgstr "VINKKI 2: Yleensä arvon muokkaaminen on tehotonta. Koska arvot valitaan automaattisesti, kirjoita vain haluamasi luku."

#. Instructional message that may be shown to user when entering numbers.
#: dist/js/interface.AUTO-LOAN.gpl.js:37
#: dist/js/interface.AUTO-LOAN.gpl.js:822
msgid "Do not type the thousand separator character."
msgstr "Älä kirjoita tuhaterotusmerkkiä."

#. Instructional message that may be shown to user when entering numbers.
#: dist/js/interface.AUTO-LOAN.gpl.js:38
#: dist/js/interface.AUTO-LOAN.gpl.js:823
msgid "(If using U.S. convention, that would be the comma.)"
msgstr "(Jos käytössä on Yhdysvaltojen konventio, se olisi pilkku.)"

#. A whimsical instructional message that may be shown to user when entering numbers.
#: dist/js/interface.AUTO-LOAN.gpl.js:39
#: dist/js/interface.AUTO-LOAN.gpl.js:824
msgid "I'm smart enough to enter them for you!"
msgstr "Olen tarpeeksi fiksu syöttämään ne puolestasi!"

#. An exception error message which user could potentially see.
#: dist/js/interface.AUTO-LOAN.gpl.js:40
#: dist/js/interface.AUTO-LOAN.gpl.js:825
msgid "An unknown date calculation error occurred."
msgstr "Tapahtui tuntematon päivämäärän laskentavirhe."

#. Message asking user to provide details about an error condition.
#: dist/js/interface.AUTO-LOAN.gpl.js:41
#: dist/js/interface.AUTO-LOAN.gpl.js:826
msgid "Please provide us with your inputs and settings so that we can fix this. Thank you."
msgstr "Ilmoita meille syötteesi ja asetuksesi, jotta voimme korjata tämän. Kiitos."

#. An exception error message which user could potentially see.
#: dist/js/interface.AUTO-LOAN.gpl.js:42
#: dist/js/interface.AUTO-LOAN.gpl.js:827
msgid "Date is not valid - bad year."
msgstr "Päivämäärä ei ole kelvollinen - virheellinen vuosi."

#. Recognized abbreviation for January - abbreviation used due to limited space.
#: dist/js/interface.AUTO-LOAN.gpl.js:43
#: dist/js/interface.AUTO-LOAN.gpl.js:828
msgid "Jan"
msgstr "tammi"

#. Recognized abbreviation for February - abbreviation used due to limited space.
#: dist/js/interface.AUTO-LOAN.gpl.js:44
#: dist/js/interface.AUTO-LOAN.gpl.js:829
msgid "Feb"
msgstr "helmi"

#. Recognized abbreviation for March - abbreviation used due to limited space.
#: dist/js/interface.AUTO-LOAN.gpl.js:45
#: dist/js/interface.AUTO-LOAN.gpl.js:830
msgid "Mar"
msgstr "maalis"

#. Recognized abbreviation for April - abbreviation used due to limited space.
#: dist/js/interface.AUTO-LOAN.gpl.js:46
#: dist/js/interface.AUTO-LOAN.gpl.js:831
msgid "Apr"
msgstr "huhti"

#. The month of May.
#: dist/js/interface.AUTO-LOAN.gpl.js:47
#: dist/js/interface.AUTO-LOAN.gpl.js:832
msgid "May"
msgstr "toukokuu"

#. Recognized abbreviation for June - abbreviation used due to limited space.
#: dist/js/interface.AUTO-LOAN.gpl.js:48
#: dist/js/interface.AUTO-LOAN.gpl.js:833
msgid "Jun"
msgstr "kesä"

#. Recognized abbreviation for July - abbreviation used due to limited space.
#: dist/js/interface.AUTO-LOAN.gpl.js:49
#: dist/js/interface.AUTO-LOAN.gpl.js:834
msgid "Jul"
msgstr "heinä"

#. Recognized abbreviation for August - abbreviation used due to limited space.
#: dist/js/interface.AUTO-LOAN.gpl.js:50
#: dist/js/interface.AUTO-LOAN.gpl.js:835
msgid "Aug"
msgstr "elo"

#. Recognized abbreviation for September - abbreviation used due to limited space.
#: dist/js/interface.AUTO-LOAN.gpl.js:51
#: dist/js/interface.AUTO-LOAN.gpl.js:836
msgid "Sept"
msgstr "syys"

#. Recognized abbreviation for October - abbreviation used due to limited space.
#: dist/js/interface.AUTO-LOAN.gpl.js:52
#: dist/js/interface.AUTO-LOAN.gpl.js:837
msgid "Oct"
msgstr "loka"

#. Recognized abbreviation for November- abbreviation used due to limited space.
#: dist/js/interface.AUTO-LOAN.gpl.js:53
#: dist/js/interface.AUTO-LOAN.gpl.js:838
msgid "Nov"
msgstr "marras"

#. Recognized abbreviation for December- abbreviation used due to limited space.
#: dist/js/interface.AUTO-LOAN.gpl.js:54
#: dist/js/interface.AUTO-LOAN.gpl.js:839
msgid "Dec"
msgstr "joulu"

#. An exception error message which user could potentially see.
#: dist/js/interface.AUTO-LOAN.gpl.js:55
msgid "Error: dates out of sequence."
msgstr "Virhe: päivämäärät eivät ole järjestyksessä."

#. Title for exception error message which user could potentially see. Title in modal header.
#: dist/js/interface.AUTO-LOAN.gpl.js:56
msgid "Exception"
msgstr "Poikkeus"

#. A portion of an exception error message which user could potentially see.
#: dist/js/interface.AUTO-LOAN.gpl.js:57
msgid "occurred when accessing"
msgstr "tapahtui, kun käytettiin"

#. A portion of an exception error message which user could potentially see.
#: dist/js/interface.AUTO-LOAN.gpl.js:58
msgid "Invalid index"
msgstr "Virheellinen indeksi"

#. An exception error message. The English word 'trillions' corresponds to 10 to the 12th power.
#: dist/js/interface.AUTO-LOAN.gpl.js:60
msgid "Internal limit reached. Balance exceeds +/- 99 trillion."
msgstr "Sisäinen raja saavutettu. Saldo ylittää +/- 99 biljoonaa."

#. "YTD" stands for "Year-to-Date" totals. It is used as a row label in reports and must be translated as a commonly recognized abbreviation or kept within approximately 15 characters to fit formatting constraints.
#: dist/js/interface.AUTO-LOAN.gpl.js:61
msgid "YTD"
msgstr "KHT"

#. "Running Totals" are accumulated totals calculated incrementally from the start of a sequence or period. This row label appears in reports with multiple cumulative totals in a single row. The term is plural because it refers to multiple totals.
#: dist/js/interface.AUTO-LOAN.gpl.js:62
msgid "Running Totals"
msgstr "Juoksevat summat"

#. A centered title over a section of a financial report.
#: dist/js/interface.AUTO-LOAN.gpl.js:64
msgid "Your Personalized Loan Schedule"
msgstr "Henkilökohtainen lainaaikataulusi"

#. A portion of a rounding adjustment message which appears in the footer of financial reports.
#: dist/js/interface.AUTO-LOAN.gpl.js:65
msgid "Last payment amount decreased by"
msgstr "Viimeisen maksuerän summaa vähennettiin"

#. A portion of a rounding adjustment message which appears in the footer of financial reports.
#: dist/js/interface.AUTO-LOAN.gpl.js:66
msgid "due to rounding"
msgstr "pyöristämisestä johtuen"

#. A portion of a rounding adjustment message which appears in the footer of financial reports.
#: dist/js/interface.AUTO-LOAN.gpl.js:67
msgid "Last payment amount increased by"
msgstr "Viimeisen maksun summa kasvoi"

#. A title centered over the section of a financial report.
#: dist/js/interface.AUTO-LOAN.gpl.js:68
msgid "Auto Loan Summary"
msgstr "Autolainan yhteenveto"

#. 'Down Payment' refers to an upfront payment made to reduce the loan amount; it's either a fixed amount or a percentage of the total price. This is a user prompt. Its meaning will be understood from its context.
#: dist/js/interface.AUTO-LOAN.gpl.js:70
msgid "Down Payment"
msgstr "Käsiraha"

#. A calculator's user prompt for input or a report's label. The user will understand the concept from its context. The translation must be concise.
#: dist/js/interface.AUTO-LOAN.gpl.js:71
msgid "Loan Amount"
msgstr "Lainasumma"

#. A calculator's user prompt for input or a report's label. The user will understand the concept from its context. The translation must be concise.
#: dist/js/interface.AUTO-LOAN.gpl.js:72
msgid "Number of Payments"
msgstr "Maksujen lukumäärä"

#. 'annual interest rate' is the nominal annual rate. The user will understand the concept from its context. The translation must be concise. A report's label.
#: dist/js/interface.AUTO-LOAN.gpl.js:73
msgid "Annual Interest Rate"
msgstr "Vuotuinen korkoprosentti"

#. A calculator's user prompt for input or a report's label. The user will understand the concept from its context. The translation must be concise.
#: dist/js/interface.AUTO-LOAN.gpl.js:74
msgid "Periodic Payment"
msgstr "Jaksottainen maksu"

#. Date when the money is available. In U.S. it's the closing date of the loan. A calculator's user prompt for input or a report's label. The user will understand the concept from its context. The translation must be concise.
#: dist/js/interface.AUTO-LOAN.gpl.js:75
msgid "Loan Date"
msgstr "Lainan päivämäärä"

#. Date the first payment is due. A calculator's user prompt for input or a report's label. The user will understand the concept from its context. The translation must be concise.
#: dist/js/interface.AUTO-LOAN.gpl.js:76
msgid "1st Payment Due"
msgstr "Ensimmäinen maksupäivä"

#. The frequency of the schedule payments or cash flow. Examples: monthly, quarterly. A calculator's user prompt for input or a report's label. The user will understand the concept from its context. The translation must be concise.
#: dist/js/interface.AUTO-LOAN.gpl.js:77
msgid "Payment Frequency"
msgstr "Maksutiheys"

#. The scheduled date for the last loan payment. A report label. The user will understand the concept from its context. The translation must be concise.
#: dist/js/interface.AUTO-LOAN.gpl.js:78
msgid "Last Payment Due"
msgstr "Viimeinen maksupäivä"

#. Estimated total interest amount. A report label. The user will understand the concept from its context. The translation must be concise.
#: dist/js/interface.AUTO-LOAN.gpl.js:79
msgid "Total Interest Due"
msgstr "Korkojen kokonaismäärä"

#. The sum of all loan payments. A report label. The user will understand the concept from its context. The translation must be concise.
#: dist/js/interface.AUTO-LOAN.gpl.js:80
msgid "Total All Payments"
msgstr "Kaikki maksut yhteensä"

#. A title centered over a section of a financial report.
#: dist/js/interface.AUTO-LOAN.gpl.js:81
msgid "Auto Loan Payment Schedule"
msgstr "Autolainan maksuaikataulu"

#. A report's label for a specific calendar year. Example: "Year: 2024". The user will understand the concept from its context. The translation must be specifically for "year".
#: dist/js/interface.AUTO-LOAN.gpl.js:82
msgid "Year"
msgstr "Vuosi"

#. A specific date. Example: "Date: 11/30/2024". Frequently, a column label in a report or a prompt for user input. The translation must be specifically for 'date' in this context. It is NOT a romantic 'date.'
#: dist/js/interface.AUTO-LOAN.gpl.js:83
msgid "Date"
msgstr "Päivämäärä"

#. Periodic payment amount. A calculator's user prompt for input or a report's label. The user will understand the concept from its context. The translation must be concise.
#: dist/js/interface.AUTO-LOAN.gpl.js:84
msgid "Payment"
msgstr "Maksu"

#. Loan or investment interest amount. A report label. The user will understand the concept from its context. Must specifically translate "interest" in the financial sense.
#: dist/js/interface.AUTO-LOAN.gpl.js:85
msgid "Interest"
msgstr "Korko"

#. Loan or investment principal amount as of a particular date. Used to label a column in a report. Must specifically translate "principal" in the financial sense.
#: dist/js/interface.AUTO-LOAN.gpl.js:86
msgid "Principal"
msgstr "Pääoma"

#. The loan or investment balance as of a particular date. Used to label a column in a report. Must be concise.
#: dist/js/interface.AUTO-LOAN.gpl.js:87
msgid "Balance"
msgstr "Saldo"

#. A report label. The user will understand the concept from its context. The translation must be concise.informing reader what calculation method was used.
#: dist/js/interface.AUTO-LOAN.gpl.js:88
msgid "Calculation method: Normal"
msgstr "Laskentamenetelmä: Normaali"

#. The total loan principal. A report's label.
#: dist/js/interface.AUTO-LOAN.gpl.js:89
msgid "Total Principal"
msgstr "Kokonaispääoma"

#. The total loan or investment interest. A report's label.
#: dist/js/interface.AUTO-LOAN.gpl.js:90
#: en/calculator.gui.php:104
#: en/calculator.gui.php:232
#: en/calculator.gui.php:361
#: en/calculator.gui.php:488
msgid "Total Interest"
msgstr "Kokonaiskorko"

#. The percentage of total payment. A chart's label. Use recognized abbreviations for conciseness.
#: dist/js/interface.AUTO-LOAN.gpl.js:91
msgid "Pct. of Total Payments"
msgstr "Kokonaismaksujen %"

#. The centered title over a graph or chart.
#: dist/js/interface.AUTO-LOAN.gpl.js:92
msgid "Annual Principal and Interest Totals"
msgstr "Vuotuiset pääoma- ja korkosummat"

#. The centered title over a graph or chart.
#: dist/js/interface.AUTO-LOAN.gpl.js:93
msgid "Accumulated Principal and Interest with Remaining Balance"
msgstr "Kertyneet pääoma- ja korkosummat sekä jäljellä oleva saldo"

#. The centered title over a graph or chart.
#: dist/js/interface.AUTO-LOAN.gpl.js:94
msgid "Total Principal and Interest"
msgstr "Kokonaispääoma ja korko"

#. A label for a financial report, chart or graph.
#: dist/js/interface.AUTO-LOAN.gpl.js:95
msgid "Loan"
msgstr "Laina"

#. Informative message to user.
#: dist/js/interface.AUTO-LOAN.gpl.js:98
msgid "One of the following: \"Price\", \"Down Payment Amount\" or \"Loan Amount\" must be \"0\"."
msgstr "Yhden seuraavista: \"Hinta\", \"Käsirahan summa\" tai \"Lainasumma\" on oltava \"0\"."

#. Informative message to user.
#: dist/js/interface.AUTO-LOAN.gpl.js:99
msgid "You may use our general purpose loan calculator if you don't want to consider purchase price."
msgstr "Voit käyttää yleiskäyttöistä lainalaskuriamme, jos et halua ottaa huomioon ostohintaa."

#. Informative message to user.
#: dist/js/interface.AUTO-LOAN.gpl.js:100
msgid "Only one of the following: \"Price\", \"Down Payment\" or \"Loan Amount\" can be \"0\"."
msgstr "Vain yksi seuraavista: \"Hinta\", \"Käsiraha\" tai \"Lainasumma\" voi olla \"0\"."

#. A data entry error message shown to the user. User needs to provide more inputs.
#: dist/js/interface.AUTO-LOAN.gpl.js:102
msgid "There are too many unknown values."
msgstr "Tuntemattomia arvoja on liikaa."

#. Title used in pop-up modal's header.
#: dist/js/interface.AUTO-LOAN.gpl.js:104
msgid "Auto Loan Calculator Help"
msgstr "Autolainalaskuri ohje"

#. Informational text for the calculator's user. Keep HTML markup intact (as always)!
#: dist/js/interface.AUTO-LOAN.gpl.js:105
msgid "<p>Use this calculator to calculate loan details when the down payment is expressed as an amount.</p>"
msgstr "<p>Käytä tätä laskuria lainatietojen laskemiseen, kun käsiraha on ilmaistu summana.</p>"

#. Informational text for the calculator's user. Keep HTML markup intact (as always)!
#: dist/js/interface.AUTO-LOAN.gpl.js:106
msgid "<p>Unlike a general loan calculator, this calculator allows for two unknown values. In addition to solving for the monthly payment amount, it will also calculate the \"Car Price\", the \"Down Payment Amount\" or the \"Loan Amount\". Just enter a \"0\" (zero) for one of the three values and provide the other two.</p>"
msgstr "<p>Toisin kuin yleinen lainalaskuri, tämä laskuri mahdollistaa kahden tuntemattoman arvon laskemisen. Kuukausimaksun lisäksi se laskee myös \"Auton hinnan\", \"Käsirahan summan\" tai \"Lainasumman\". Syötä vain \"0\" (nolla) yhdelle kolmesta arvosta ja anna kaksi muuta.</p>"

#. Informational text for the calculator's user. Keep HTML markup intact (as always)!
#: dist/js/interface.AUTO-LOAN.gpl.js:107
msgid "<p>Note that the calculator calculates what percentage the down payment is of the price of the car. This is handy when a lender requires a borrower to provide a minimum percentage cash deposit.</p>"
msgstr "<p>Huomaa, että laskuri laskee, kuinka suuri prosenttiosuus käsiraha on auton hinnasta. Tämä on kätevää, kun lainanantaja vaatii vähimmäiskäsirahan prosenttiosuutta.</p>"

#. Informational text for the calculator's user. Keep HTML markup intact (as always)!
#: dist/js/interface.AUTO-LOAN.gpl.js:108
msgid "<p class=\"tail\">The term (duration) of the loan is expressed as a number of months.</p>"
msgstr "<p class=\"tail\">Lainan kesto ilmoitetaan kuukausien lukumääränä.</p>"

#. Informative message providing conversions for user found in the calculator's help text. Retain HTML markup!
#: dist/js/interface.AUTO-LOAN.gpl.js:109
msgid "<ul class=\"mono tail\"><li>&nbsp;60 months = &nbsp;5 years</li><li>120 months = 10 years</li><li>180 months = 15 years</li><li>240 months = 20 years</li><li class=\"tail\">360 months = 30 years</li></ul>"
msgstr "<ul class=\"mono tail\"><li>&nbsp;60 kuukautta = &nbsp;5 vuotta</li><li>120 kuukautta = 10 vuotta</li><li>180 kuukautta = 15 vuotta</li><li>240 kuukautta = 20 vuotta</li><li class=\"tail\">360 kuukautta = 30 vuotta</li></ul>"

#. Informational text for the calculator's user. Keep HTML markup intact (as always)!
#: dist/js/interface.AUTO-LOAN.gpl.js:110
msgid "<p class=\"small\" style=\"font-size: 85%; line-height: 1.5; color:red; user-select: text\">If you need the ability to print the amortization schedule, or more flexibility such as selecting different payment or compounding frequencies or the ability to calculate term or interest rate, please see the auto loan calculator here: <b>https://AccurateCalculators.com/auto-loan-calculator</b></p>"
msgstr "<p class=\"small\" style=\"font-size: 85%; line-height: 1.5; color:red; user-select: text\">Jos tarvitset mahdollisuuden tulostaa lyhennysohjelman tai enemmän joustavuutta, kuten eri maksutahtien tai korkojaksojen valinnan tai mahdollisuuden laskea laina-aikaa tai korkoprosenttia, katso autolainalaskuri täällä: <b>https://AccurateCalculators.com/auto-loan-calculator</b></p>"

#: dist/js/interface.AUTO-LOAN.gpl.js:111
msgid "<p class=\"small\" style=\"font-size: 85%; line-height: 1.5; color:red; user-select: text\">If you want to set the loan closing date and first payment due date; select different payment or compounding frequencies; the ability to calculate term or interest rate; or the ability to export the schedule to Excel or Word, please see the auto loan calculator here: <b>https://AccurateCalculators.com/auto-loan-calculator</b></p>"
msgstr "<p class=\"small\" style=\"font-size: 85%; line-height: 1.5; color:red; user-select: text\">Jos haluat asettaa lainan päättymispäivän ja ensimmäisen maksun eräpäivän; valita eri maksutiheyksiä tai korkojaksojen tiheyksiä; laskea laina-aika tai korkoprosentti; tai viedä aikataulun Exceliin tai Wordiin, katso autolainalaskuri täältä: <b>https://AccurateCalculators.com/auto-loan-calculator</b></p>"

#. The cash flow or compounding frequency.
#: dist/js/interface.AUTO-LOAN.gpl.js:112
#: dist/js/interface.AUTO-LOAN.gpl.js:848
msgid "Monthly"
msgstr "Kuukausittainen"

#. A title centered over a section of a financial report.
#: dist/js/interface.AUTO-LOAN.gpl.js:114
msgid "Your Personalized Car Loan Schedule"
msgstr "Henkilökohtainen autolainan maksuaikataulu"

#. The person's name for whom a report is prepared. A report's label.
#: dist/js/interface.AUTO-LOAN.gpl.js:116
msgid "Prepared for"
msgstr "Kenelle valmistettu"

#. A report's label for a street address.
#: dist/js/interface.AUTO-LOAN.gpl.js:118
#: dist/js/interface.AUTO-LOAN.gpl.js:126
msgid "Address"
msgstr "Osoite"

#. A report's label for postal address details.
#: dist/js/interface.AUTO-LOAN.gpl.js:120
msgid "City, State  ZIP"
msgstr "Kaupunki, Maakunta  Postinumero"

#. The date a financial report was prepared. A report's label.
#: dist/js/interface.AUTO-LOAN.gpl.js:122
msgid "Prepared On"
msgstr "Laadittu"

#. The person's name who prepared a report. A report's label.
#: dist/js/interface.AUTO-LOAN.gpl.js:124
msgid "Prepared by"
msgstr "Valmistajan nimi"

#. A label for a phone number.
#: dist/js/interface.AUTO-LOAN.gpl.js:128
msgid "Phone"
msgstr "Puhelin"

#. A report's label for an email address.
#: dist/js/interface.AUTO-LOAN.gpl.js:130
msgid "Email"
msgstr "Sähköposti"

#. A report's label for a website address or URL.
#: dist/js/interface.AUTO-LOAN.gpl.js:132
msgid "Website"
msgstr "Verkkosivusto"

#. An instructional message about numeric input which may be shown to the calculator's user.
#: dist/js/interface.AUTO-LOAN.gpl.js:815
msgid "Please use the backspace key to delete."
msgstr "Käytä backspace-näppäintä poistaaksesi."

#. An instructional message about numeric input which may be shown to the calculator's user.
#: dist/js/interface.AUTO-LOAN.gpl.js:816
msgid "Left, up & down arrow keys are disabled. So are the home, end, pgup and pgdn keys."
msgstr "Vasen, ylös- ja alanuolinäppäimet ovat pois käytöstä. Sama koskee home, end, pgup ja pgdn -näppäimiä."

#. An instructional message about numeric input which may be shown to the calculator's user.
#: dist/js/interface.AUTO-LOAN.gpl.js:817
msgid "Use backspace to delete."
msgstr "Käytä backspace-näppäintä poistaaksesi."

#. An unknown value. Tells the calculator what to solve for.
#: dist/js/interface.AUTO-LOAN.gpl.js:841
msgid "Unknown"
msgstr "Tuntematon"

#. The first letter of the word (lowercase) which means "Unknown" in the non-English language of the 'msgstr'
#: dist/js/interface.AUTO-LOAN.gpl.js:843
msgid "u"
msgstr "t"

#. The first letter of the word (capitalized) which means "Unknown" in the non-English language of the 'msgstr'
#: dist/js/interface.AUTO-LOAN.gpl.js:845
msgid "U"
msgstr "T"

#. An exception error message which user could potentially see.
