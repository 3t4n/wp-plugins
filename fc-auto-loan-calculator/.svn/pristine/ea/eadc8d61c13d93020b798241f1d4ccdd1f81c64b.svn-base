#. When a payment is due, either at the start of period or end of period. A calculation option or setting. User needs to decide which option to use.
#: en/calculator.gui.php:217
#: en/calculator.gui.php:345
#: en/calculator.gui.php:474
msgid "Payment Method?"
msgstr "Timing de versement ?"

#. When the cash flow (payment or investment) is due. One of two options from which a user will select. The user will understand the concept from its context.. One of two options from which a user will select. The user will understand the concept from its context. An option the user selects.
#: en/calculator.gui.php:220
#: en/calculator.gui.php:348
#: en/calculator.gui.php:476
msgid "End-of-Period"
msgstr "Fin de période"

#. When the cash flow (payment or investment) is due. One of two options from which a user will select. The user will understand the concept from its context.. One of two options from which a user will select. The user will understand the concept from its context. An option the user selects.
#: en/calculator.gui.php:221
#: en/calculator.gui.php:349
#: en/calculator.gui.php:477
msgid "Start-of-Period"
msgstr "Début de période"

#. Periodic payment amount. A calculator's user prompt for input or a report's label. The user will understand the concept from its context. The translation must be concise.
#: en/calculator.gui.php:226
#: en/calculator.gui.php:355
#: en/calculator.gui.php:482
msgid "Payment Amount"
msgstr "Montant du paiement"

#. A button's label to indicate clicking will initiate the calculation.
#: en/calculator.gui.php:245
#: en/calculator.gui.php:372
#: en/calculator.gui.php:500
msgid "Calc"
msgstr "Calc"

#. The number of months expected for the term of the cash flow. A user prompt for input.
#: en/calculator.gui.php:339
#: en/calculator.gui.php:468
msgid "Number of Months?"
msgstr "Nombre de mois ?"

#. The annual interest rate (implying the nominal annual interest rate). A user prompt for input.
#: en/calculator.gui.php:342
msgid "Annual Rate?"
msgstr "Taux annuel ?"

#. "Down Payment Amount?" refers to the upfront payment in monetary terms, used to reduce the loan balance. This is a label for a user prompt and does not refer to a percentage. The concept will be clear from context.
#: en/calculator.gui.php:460
msgid "Down Payment Amount?"
msgstr "Montant de l'apport personnel ?"

#. "Down Payment Pct." refers to the percentage used to calculate the upfront payment reducing the loan amount. This is a label for the down payment percentage; users will understand it from the context.
#: en/calculator.gui.php:485
msgid "Down Payment Percentage"
msgstr "Pourcentage de l'apport personnel"

#. Used either as a label for a calculated result field, or a label for a financial report.
#: en/calculator.gui.php:491
msgid "Total Principal & Interest"
msgstr "Total du capital et des intérêts"

#. A title centered over a detail report section showing projected payments with their due dates. Translate 'schedule' in this financial context. English synonym 'amortization schedule'
#: en/calculator.gui.php:506
msgid "Payment Schedule"
msgstr "Calendrier de paiements"

#. The title in a modal's header. The modal offers the user the ability to select a currency symbol and date formatting options.
#: en/calculator.gui.php:583
msgid "Currency and Date Conventions"
msgstr "Conventions relatives aux devises et aux dates"

#. An information message shown to the user in a modal window.
#: en/calculator.gui.php:735
msgid "The calculator will remember your choice. You may also change it at any time."
msgstr "La calculatrice se souviendra de votre choix. Vous pouvez également le modifier à tout moment."

#. An information message shown to the user in a modal window.
#: en/calculator.gui.php:738
msgid "Clicking \"Save changes\" will cause the calculator to reload. Your edits will be lost."
msgstr "Cliquer sur \"Enregistrer les modifications\" entraînera le rechargement de la calculatrice. Vos modifications seront perdues."

#. A label on a button. Clicking the button cancels an action, cancels an option or closes a window.
#: en/calculator.gui.php:745
msgid "Cancel"
msgstr "Annuler"

#. A label on a button. Clicking the button causes the user selections to .be saved
#: en/calculator.gui.php:746
msgid "Save changes"
msgstr "Enregistrer les modifications"

#: en/calculator.gui.php:770
msgid "Cash flow forecast..."
msgstr "Prévision de flux de trésorerie..."

#. A label on a button. When the button is clicked by the user, the window will close.
#: en/calculator.gui.php:781
#: en/calculator.gui.php:828
#: en/calculator.gui.php:862
#: en/calculator.gui.php:896
msgid "Close"
msgstr "Fermer"

#. A title which appears in a modal's header section. This indicates it's a "message" for the user.
#: en/calculator.gui.php:885
msgid "Message"
msgstr "Message"

#. An informative message shown to a user after making a data entry error.
#: fc-auto-loan-calculator.php:443
msgid "Please enter a valid number greater than 0 for"
msgstr "Veuillez entrer un nombre valide supérieur à 0 pour"

#. An informative message shown to a user after making a data entry error.
#: fc-auto-loan-calculator.php:1087
msgid "Please enter a valid number for \"Default price\"."
msgstr "Veuillez entrer un nombre valide pour le \"Prix par défaut\"."

#. An informative message shown to a user after making a data entry error.
#: fc-auto-loan-calculator.php:1092
msgid "Please enter a valid number for \"Default down payment\"."
msgstr "Veuillez entrer un nombre valide pour \"Apport personnel par défaut\"."

#. An informative message shown to a user after making a data entry error.
#: fc-auto-loan-calculator.php:1097
msgid "Please enter a valid number for \"Default loan amount.\""
msgstr "Veuillez saisir un nombre valide pour \"Montant du prêt par défaut\""

#. An informative message shown to a user after making a data entry error.
#: fc-auto-loan-calculator.php:1101
msgid "Please enter a valid number for \"Default number of months.\""
msgstr "Veuillez entrer un nombre valide pour \"Nombre de mois par défaut.\""

#. An informative message shown to a user after making a data entry error.
#: fc-auto-loan-calculator.php:1105
msgid "Please enter a valid number for \"Default interest rate.\""
msgstr "Veuillez entrer un nombre valide pour \"Taux d'intérêt par défaut\""

#. An informative message shown to a user after making a data entry error.
#: fc-auto-loan-calculator.php:1110
msgid "Please enter a valid value for \"Default Currency.\""
msgstr "Veuillez entrer une valeur valide pour \"Devise par défaut\""

#. The date format maps to a number. An informative message shown to a user after making a data entry error.
#: fc-auto-loan-calculator.php:1114
msgid "Please enter a valid number for \"Default Date Format.\""
msgstr "Veuillez entrer un nombre valide pour \"Format de date par défaut\""

#. An instructional message to the user appearing on a set up screen.
#: fc-auto-loan-calculator.php:1211
msgid "Do not forget to save your changes. Scroll all the way down in this panel for the <span class=\"red\">[Save]</span> button."
msgstr "N'oubliez pas de sauvegarder vos modifications. Faites défiler jusqu'en bas de ce panneau pour trouver le bouton <span class=\"red\">[Sauvegarder]</span>."

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-auto-loan-calculator.php:1216
msgid "Widget's size (size limits adjustable below)?"
msgstr "Taille du widget (limites de taille ajustables ci-dessous) ?"

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-auto-loan-calculator.php:1218
msgid "Tiny (max width = 180px)"
msgstr "Très petit (largeur max = 180px)"

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-auto-loan-calculator.php:1219
msgid "Small (max width = 300px)"
msgstr "Petit (largeur max = 300px)"

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-auto-loan-calculator.php:1220
msgid "Medium (max width = 340px)"
msgstr "Moyen (largeur maximale = 340px)"

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-auto-loan-calculator.php:1221
msgid "Large (max width = 440px)"
msgstr "Large (largeur maximale = 440px)"

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-auto-loan-calculator.php:1228
msgid "Load custom style sheet?"
msgstr "Charger une feuille de style personnalisée ?"

#. The negative answer to a binary question.
#: fc-auto-loan-calculator.php:1230
#: fc-auto-loan-calculator.php:1397
#: fc-auto-loan-calculator.php:1406
#: fc-auto-loan-calculator.php:1417
#: fc-auto-loan-calculator.php:1426
msgid "No"
msgstr "Non"

#. The positive answer to a binary question.
#: fc-auto-loan-calculator.php:1231
#: fc-auto-loan-calculator.php:1398
#: fc-auto-loan-calculator.php:1407
#: fc-auto-loan-calculator.php:1418
#: fc-auto-loan-calculator.php:1427
msgid "Yes"
msgstr "Oui"

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-auto-loan-calculator.php:1235
msgid "If \"Yes\" loads &lt;site&gt;\\wp-content\\plugins\\ac-auto-loan-calculator-plus\\css\\accurate-calculators-custom.css. Entries in <b>accurate-calculators-custom.css</b> override the plugin's look. Editing the provided custom stylesheet is another way to modify the look of the calculator. For best performance include only the rules in the custom stylesheet you are overriding. BACKUP YOUR CUSTOMIZATIONS! You will need to manually replace them when (if) you upgrade the plugin."
msgstr "Si \"Oui\" charge &lt;site&gt;\\wp-content\\plugins\\ac-auto-loan-calculator-plus\\css\\accurate-calculators-custom.css. Les entrées dans <b>accurate-calculators-custom.css</b> remplacent l'apparence du plugin. Modifier la feuille de style personnalisée fournie est une autre façon de modifier l'apparence de la calculatrice. Pour de meilleures performances, incluez uniquement les règles que vous remplacez dans la feuille de style personnalisée. SAUVEGARDEZ VOS PERSONNALISATIONS ! Vous devrez les remplacer manuellement lors de la mise à jour du plugin."

#. A configuration option set by the website's developer for setting the websites default currency symbol - not user facing.
#: fc-auto-loan-calculator.php:1241
msgid "Set a default currency?"
msgstr "Définir une devise par défaut ?"

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-auto-loan-calculator.php:1243
msgid "Use visitor's browser's settings to set currency - do not override."
msgstr "Utilisez les paramètres du navigateur du visiteur pour définir la devise - ne passez pas outre."

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-auto-loan-calculator.php:1367
msgid "Set a date format convention?"
msgstr "Définir une convention de format de date ?"

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-auto-loan-calculator.php:1369
msgid "Use visitor's browser's settings to set date format - do not override."
msgstr "Utilisez les paramètres du navigateur du visiteur pour définir le format de la date - ne passez pas outre."

#. An instruction or clarification for the website's administrator - not end-user facing.
#: fc-auto-loan-calculator.php:1381
msgid "When a user first visits your site, the plugin will use the browser's international conventions to set the currency and date format. If you wish, you may override the plugin and set a default currency and date format. The user will still have the ability to override either setting if you do not hide the &quot;international conventions&quot; below."
msgstr "Lorsqu'un utilisateur visite votre site pour la première fois, le plugin utilise les conventions internationales du navigateur pour définir la devise et le format de date. Si vous le souhaitez, vous pouvez remplacer le plugin et définir une devise et un format de date par défaut. L'utilisateur pourra toujours modifier ces réglages si vous ne masquez pas les &quot;conventions internationales&quot; ci-dessous."

#. An instruction or clarification for the website's administrator - not end-user facing.
#: fc-auto-loan-calculator.php:1386
msgid "<strong>Note:</strong> Your visitors may select a date format and currency by clicking on <span class=\"red\">$ : MM/DD/YYYY</span> in the calculator's lower right corner if you do not set \"Hide international conventions\" to \"yes\"."
msgstr "<strong>Remarque :</strong> Vos visiteurs peuvent sélectionner un format de date et une devise en cliquant sur <span class=\"red\">$ : MM/JJ/AAAA</span> dans le coin inférieur droit de la calculatrice si vous ne définissez pas \"Masquer les conventions internationales\" sur \"oui\"."

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-auto-loan-calculator.php:1395
msgid "Hide the resize buttons?"
msgstr "Cacher les boutons de redimensionnement ?"

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-auto-loan-calculator.php:1404
msgid "Hide international conventions?"
msgstr "Masquer les conventions internationales ?"

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-auto-loan-calculator.php:1415
msgid "Hide the Payment Method?"
msgstr "Masquer la \"Timing de versement\" ?"

#. Inital part of a string asking site's administrator if they want to "link to" another site. Administrator will answer 'Yes' or 'No'.
#: fc-auto-loan-calculator.php:1424
msgid "Link to"
msgstr "Lien vers"

#. An instruction or clarification for the website's administrator - not end-user facing.
#: fc-auto-loan-calculator.php:1436
msgid "If \"Link to AccurateCalculators.com\" is set to \"Yes\", one very discreet follow link will be inserted in the calculator. If you allow the link, you may rebrand the calculator with your name. Resetting this option to \"No\" at any time will remove the links. See FAQ's in readme file for details."
msgstr "Si \"Lien vers AccurateCalculators.com\" est réglé sur \"Oui\", un lien de suivi très discret sera inséré dans la calculatrice. Si vous autorisez le lien, vous pouvez renommer la calculatrice avec votre nom. Réinitialiser cette option sur \"Non\" à tout moment supprimera les liens. Consultez les FAQ dans le fichier readme pour plus de détails."

#. A prompt asking site's administrator for their brand name.
#: fc-auto-loan-calculator.php:1441
msgid "Add Your Brand Name"
msgstr "Ajoutez votre marque"

#. An instruction or clarification for the website's administrator - not end-user facing.
#: fc-auto-loan-calculator.php:1445
msgid "You may brand this widget with your brand. <b>Example: \"Abe's Best\"</b> will be preappended to \"Loan Calculator\". For this to work, the above \"Link to\" option must be set to \"Yes\"."
msgstr "Vous pouvez marquer ce widget avec votre marque. <b>Exemple : \"Le Meilleur de Abe\"</b> sera ajouté devant \"Calculatrice de Prêt\". Pour que cela fonctionne, l'option ci-dessus \"Lien vers\" doit être réglée sur \"Oui\"."

#. A prompt for the site's developer instructing them to set a site-wide default value for a user entered value. Not user facing.
#: fc-auto-loan-calculator.php:1456
msgid "Default price"
msgstr "Prix par défaut"

#. A prompt for the site's developer instructing them to set a site-wide default value for a user entered value. Not user facing.
