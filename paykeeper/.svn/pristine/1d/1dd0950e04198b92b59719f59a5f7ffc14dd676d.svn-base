msgid "VAT 10/110"
msgstr "VAT 10/110"

#: paykeeper-gateway-class.php:251
msgid "VAT 20/120"
msgstr "VAT 20/120"

#: paykeeper-gateway-class.php:255
msgid "Enable transmission of the TRU code"
msgstr "Enable transmission of the TRU code"

#: paykeeper-gateway-class.php:257
msgid "If enabled, the tru_code parameter will be passed to the cart"
msgstr "If enabled, the tru_code parameter will be passed to the cart"

#: paykeeper-gateway-class.php:261
msgid "Designation of the TRU code"
msgstr "Designation of the TRU code"

#: paykeeper-gateway-class.php:263
msgid "The name of the TRU code parameter for the product (variation) in the cart"
msgstr "The name of the TRU code parameter for the product (variation) in the cart"

#: paykeeper-gateway-class.php:267
msgid "Enable receipt generation"
msgstr "Enable receipt generation"

#: paykeeper-gateway-class.php:269
msgid "If enabled, a receipt for the final payment will be generated when the order status is changed to the specified one"
msgstr "If enabled, a receipt for the final payment will be generated when the order status is changed to the specified one"

#: paykeeper-gateway-class.php:273
msgid "Order status for receipt generation"
msgstr "Order status for receipt generation"

#: paykeeper-gateway-class.php:285
msgid "Title"
msgstr "Title"

#: paykeeper-gateway-class.php:287
msgid "Name of the payment system when paying"
msgstr "Name of the payment system when paying"

#: paykeeper-gateway-class.php:288
