#: paykeeper-gateway-class.php:82
msgid "You will now be redirected to the banks page"
msgstr "Вы будете перенаправлены на страницу банка"

#: paykeeper-gateway-class.php:84
msgid "Click the Pay button to proceed to payment"
msgstr "Нажмите кнопку 'Оплатить', чтобы продолжить оплату"

#: paykeeper-gateway-class.php:131
msgid "PayKeeper"
msgstr "PayKeeper"

#: paykeeper-gateway-class.php:132
msgid "Allows Payments via the PayKeeper gateway"
msgstr "Приём платежей обеспечивается платёжной платформой PayKeeper"

#: paykeeper-gateway-class.php:148
msgid "Enable/Disable"
msgstr "Включить/Выключить"

#: paykeeper-gateway-class.php:150
msgid "Enable PayKeeper Gateway"
msgstr "Включить PayKeeper"

#: paykeeper-gateway-class.php:157
msgid "PayKeeper server URL"
msgstr "Платёжная форма PayKeeper"

#: paykeeper-gateway-class.php:159
msgid "Your PayKeeper server URL"
msgstr "Ссылка на платежную форму PayKeeper"

#: paykeeper-gateway-class.php:163
msgid "PayKeeper secret word"
msgstr "Секретное слово"

#: paykeeper-gateway-class.php:165
msgid "Your PayKeeper secret word"
msgstr "Ваше секретное слово со страницы настроек уведомления о платежах"

#: paykeeper-gateway-class.php:177
msgid "Token"
msgstr "Токен"

#: paykeeper-gateway-class.php:179
msgid "Authorization token. Clear and save to make changes."
msgstr "Токен авторизации. Чтобы изменить, очистите и сохраните."

#: paykeeper-gateway-class.php:184
msgid "PayKeeper login"
msgstr "Логин"

#: paykeeper-gateway-class.php:186
msgid "Your PayKeeper login"
msgstr "Логин входа в личный кабинет PayKeeper"

#: paykeeper-gateway-class.php:190
msgid "PayKeeper password"
msgstr "Пароль к логину"

#: paykeeper-gateway-class.php:192
msgid "Your PayKeeper password"
msgstr "Пароль к логину от личного кабинета PayKeeper"

#: paykeeper-gateway-class.php:201
msgid "Force discounts check"
msgstr "Принудительный учёт скидок"

#: paykeeper-gateway-class.php:203
msgid "If option is enabled, discounts will be checked anyway. Please, report about this option to support@paykeeper.ru"
msgstr "Если включено, скидки будут учтены принудительно. Пожалуйста, сообщите об этом службе техподдержки по адресу support@paykeeper.ru"

#: paykeeper-gateway-class.php:207
msgid "Automatically redirect to payment"
msgstr "Автоматический редирект на страницу оплаты"

#: paykeeper-gateway-class.php:209
msgid "If enabled, the customer will be immediately redirected to the payment page after placing the order"
msgstr "Если включено, клиент будет немедленно перенаправлен на страницу оплаты после оформления заказа"

#: paykeeper-gateway-class.php:213
msgid "Ajax checkout support"
msgstr "Поддержка Ajax оформления заказа"

#: paykeeper-gateway-class.php:215
msgid "If enabled, the customer will be redirected directly to the payment form, bypassing the payment page."
msgstr "Если включено, клиент сразу будет направлен к форме оплаты, минуя страницу результата оформления заказа."

#: paykeeper-gateway-class.php:219
msgid "Autocomplete order"
msgstr "Автозавершение заказа"

#: paykeeper-gateway-class.php:221
msgid "If this option is enabled, then upon successful payment, the order will be assigned the status completed"
msgstr "Если включено, заказ будет помечен как завершённый после успешной оплаты"

#: paykeeper-gateway-class.php:225
msgid "Back to order view"
msgstr "Вернуть клиента на страницу заказа"

#: paykeeper-gateway-class.php:227
msgid "If this option is enabled, after payment, customer will be sent to specific page view-order"
msgstr "Если включено, после оплаты клиент будет перенаправлен на специальную страницу просмотра заказа view-order"

#: paykeeper-gateway-class.php:231
msgid "Enable cart transmission"
msgstr "Включить передачу корзины"

#: paykeeper-gateway-class.php:233
msgid "If enabled, the order cart will be passed in the cart parameter for the checkout form"
msgstr "Если включено, корзина заказа будет передана в параметре cart для чека"

#: paykeeper-gateway-class.php:237
msgid "Default VAT"
msgstr "НДС по умолчанию"

#: paykeeper-gateway-class.php:242
msgid "No VAT"
msgstr "Без НДС"

#: paykeeper-gateway-class.php:243
msgid "VAT 0%"
msgstr "НДС 0%"

#: paykeeper-gateway-class.php:244
msgid "VAT 5%"
msgstr "НДС 5%"

#: paykeeper-gateway-class.php:245
msgid "VAT 7%"
msgstr "НДС 7%"

#: paykeeper-gateway-class.php:246
msgid "VAT 10%"
msgstr "НДС 10%"

#: paykeeper-gateway-class.php:247
msgid "VAT 20%"
msgstr "НДС 20%"

#: paykeeper-gateway-class.php:248
msgid "VAT 5/105"
msgstr "НДС 5/105"

#: paykeeper-gateway-class.php:249
msgid "VAT 7/107"
msgstr "НДС 7/107"

#: paykeeper-gateway-class.php:250
msgid "VAT 10/110"
msgstr "НДС 10/110"

#: paykeeper-gateway-class.php:251
msgid "VAT 20/120"
msgstr "НДС 20/120"

#: paykeeper-gateway-class.php:255
msgid "Enable transmission of the TRU code"
msgstr "Включить передачу кода ТРУ"

#: paykeeper-gateway-class.php:257
msgid "If enabled, the tru_code parameter will be passed to the cart"
msgstr "Если включено, параметр tru_code будет передан в корзину"

#: paykeeper-gateway-class.php:261
msgid "Designation of the TRU code"
msgstr "Обозначение кода ТРУ"

#: paykeeper-gateway-class.php:263
msgid "The name of the TRU code parameter for the product (variation) in the cart"
msgstr "Имя ключа параметра кода ТРУ товара (вариации) в корзине"

#: paykeeper-gateway-class.php:267
msgid "Enable receipt generation"
msgstr "Включить генерацию чека"

#: paykeeper-gateway-class.php:269
msgid "If enabled, a receipt for the final payment will be generated when the order status is changed to the specified one"
msgstr "Если включено, то при изменении статуса заказа на указанный будет инициирована генерация чека окончательного расчёта"

#: paykeeper-gateway-class.php:273
msgid "Order status for receipt generation"
msgstr "Статус заказа для генерации чека"

#: paykeeper-gateway-class.php:285
msgid "Title"
msgstr "Наименование"

#: paykeeper-gateway-class.php:287
msgid "Name of the payment system when paying"
msgstr "Название способа оплаты при выборе"

#: paykeeper-gateway-class.php:288
msgid "Payment by Visa/MasterCard online"
msgstr "Оплата картами онлайн"

#: paykeeper-gateway-class.php:292
msgid "Description"
msgstr "Описание"

#: paykeeper-gateway-class.php:294
msgid "Description of payment system"
msgstr "Описание способа оплаты"

#: paykeeper-gateway-class.php:295
msgid "Payments via the PayKeeper gateway"
msgstr "Приём платежей обеспечивает платёжная платформа PayKeeper"

#: paykeeper-gateway-class.php:299
msgid "Icon"
msgstr "Логотип способа оплаты"

#: paykeeper-gateway-class.php:301
msgid "The icon for this checkout option"
msgstr "Расположение логотипа способа оплаты"

#: paykeeper-gateway-class.php:438
msgid "Payment pending"
msgstr "Ожидает оплаты"

#: paykeeper-gateway-class.php:755
msgid "No refund data found."
msgstr "Не найдено данных о возврате средств."

#: paykeeper-gateway-class.php:828
#, php-format
msgid "Order ID (%s) failed to be refunded."
msgstr "Неизвестная ошибка возврата средств для заказа %s."
