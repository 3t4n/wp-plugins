    .loading-select {
        width: 8px; /* Adjusted width for smaller screens */
        height: 8px; /* Adjusted height for smaller screens */
    }

    .tooltip .tooltiptext {
        width: 150px; /* Adjusted width for smaller screens */
        font-size: 12px; /* Adjusted font size for smaller screens */
    }

    .tooltip-right {
        top: -67px; /* Adjusted top position for smaller screens */
    }

    .help-icon {
        width: 16px; /* Adjusted width for smaller screens */
    }

    /* Adjust styles for smaller screens */
    input#wp-deactivate-log {
        margin-left: 44px; /* Align button to the right on smaller screens */
        margin-right: auto; /* Align button to the left on larger screens */
    }
	input#ffforms-setting-google-access-code {
    width: 400px;
    max-width: inherit;
}
}

/* Media Query for responsiveness */
@media screen and (min-width: 768px) {
