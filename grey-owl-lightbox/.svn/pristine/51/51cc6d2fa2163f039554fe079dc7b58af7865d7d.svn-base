// compileCompressed: gol-style.css
@import 'grey-owl-icon-font-style.css';
[data-gol-content]{
    display: none;
}
.admin-bar{
    .go-lightbox-wrapper{
        .media-block-wrapper{
            top: calc( 50% + 16px );
        }
    }
}
.go-lightbox-wrapper{
    position: fixed;
    top: 0;
    left: 0;
    background-color: transparent;
    width: 100%;
    height: 100vh;
    z-index: 99990;
    .bg-btn-close {
        position: absolute;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        z-index: 9999;
    }
    .media-block-wrapper{
        position: absolute;
        top: 50%;
        left: 50%;
        -webkit-transform: translate(-50%, -50%);
        -moz-transform: translate(-50%, -50%);
        -ms-transform: translate(-50%, -50%);
        -o-transform: translate(-50%, -50%);
        transform: translate(-50%, -50%);
        z-index: 99995;
        [data-gol-content-box]{
            //max-width: 100vh;
            max-height: 90vh;
            overflow-y: auto;
            &>iframe{
                display: block;
                margin: 0;
                max-width: none;
            }
            .error-message-box{
                background-color: #ffffff;
                width: 100%;
                min-height: 100%;
                text-align: center;
                .error-text-cont{
                    position: absolute;
                    top: 50%;
                    width: 100%;
                    -webkit-transform: translate( 0, -50% );
                    -moz-transform: translate( 0, -50% );
                    -ms-transform: translate( 0, -50% );
                    -o-transform: translate( 0, -50% );
                    transform: translate( 0, -50% );

                }
            }
        }
        .media-block{
            position: relative;
            min-width: 150px;
            min-height: 150px;
            border-radius: 10px;
            box-shadow: 0 0 30px rgba(0, 0, 0, 0.5);
            .loader-image-box{
                display: block;
                position: absolute;
                top: 50%;
                left: 50%;
                -webkit-transform: translate(-50%, -50%);
                -moz-transform: translate(-50%, -50%);
                -ms-transform: translate(-50%, -50%);
                -o-transform: translate(-50%, -50%);
                transform: translate(-50%, -50%);
                -webkit-transition: all 0.5s ease; /* Safari */
            }
            .video-wrapper {
                border-radius: 5px;
                overflow: hidden;
                iframe {
                    display: block;
                }
            }
            .image-wrapper{
                position: relative;
                display: table;
                -webkit-transition: all 0.5s ease; /* Safari */
                transition: all 0.5s ease;
                overflow: hidden;
                .image-box{
                    display: block;
                    position: absolute;
                    top: 50%;
                    left: 50%;
                    -webkit-transform: translate(-50%, -50%);
                    -moz-transform: translate(-50%, -50%);
                    -ms-transform: translate(-50%, -50%);
                    -o-transform: translate(-50%, -50%);
                    transform: translate(-50%, -50%);
                    transition: all 0.5s ease;
                    opacity: 0;
                    img{
                        max-width: 100%;
                    }
                    &.current{
                        opacity: 1;
                    }
                }
                .button{
                    position: absolute;
                    background: transparent;
                    height: 100%;
                    width: 100px;
                    top: 0;
                    border: none;
                    padding: 15px;
                    margin: 0;
                    opacity: 0;
                    -webkit-transition: all 0.5s ease; /* Safari */
                    transition: all 0.5s ease;
                    opacity: 0;
                    .btn-cont{
                        display: inline-block;
                        padding: 5px;
                        color: #000000;
                        background-color: rgba(255,255,255,0.7)
                        //text-shadow: 0 0 10px #000000;
                    }
                    &:hover, &:focus{
                        opacity: 1;
                    }
                    span, i{
                        font-size: 20px;
                    }
                    &.previous{
                        left: 0;
                    }
                    &.next{
                        right: 0;
                    }
                }
            }
        }
        .top-close-btn-wrapp{
            position: absolute;
            width: auto;
            height: auto;
            opacity: 0;
            -webkit-transition: all 0.5s ease; /* Safari */
            transition: all 0.5s ease;
            .top-close-lightbox{
                cursor: pointer;
                position: relative;
                width: 100%;
                z-index: 99999;
                padding: 0;
                color: #000000;
                background-color: #ffffff;
                border: none;
                border-radius: 50%;
                box-shadow: 0 0 30px rgba(0, 0, 0, 0.5);
                text-align: center;
                font-size: 22px;
                img{
                    position: absolute;
                    top: 50%;
                    left: 50%;
                    -webkit-transform: translate(-50%, -50%);
                    -moz-transform: translate(-50%, -50%);
                    -ms-transform: translate(-50%, -50%);
                    -o-transform: translate(-50%, -50%);
                    transform: translate(-50%, -50%);
                    max-height: 100% !important;
                    width: auto !important;
                    margin: 0 !important;
                }
                span, div, i{
                    width: inherit;
                    height: inherit;
                    line-height: inherit;
                    font-size: inherit;
                    text-align: center;
                    display: block;
                }
            }
        }
    }
    .bottom-close-btn-wrapp{
        position: absolute;
        height: 2rem;
        left: 50%;
        bottom: 25px;
        -webkit-transform: translateX(-50%);
        -moz-transform: translateX(-50%);
        -ms-transform: translateX(-50%);
        -o-transform: translateX(-50%);
        transform: translateX(-50%);
        z-index: 99999;
        .bottom-close-lightbox {
            background-color: #fff;
            color: #000;
            padding: 0;
            font-size: 0;
            line-height: 0;
            height: 0;
            margin: 0;
            border: 0;
            &:focus {
                padding: 0.3rem 1rem;
                font-size: 1.25rem;
                line-height: 1.4rem;
                height: 2rem;
            }
        }
    }
    &.displayed{
        .media-block-wrapper {
            .top-close-btn-wrapp{
                opacity: 1;
            }
            // .media-block{
            //     .image-wrapper{
            //         .button{
            //             opacity: 1;
            //         }
            //     }
            // }
        }
        &.mobile-box{
            .media-block-wrapper{
                .media-block{
                    .image-wrapper{
                        .button{
                            opacity: 0.4;
                            width: 40px;
                            padding: 0;
                            &:hover, &:focus{
                                opacity: 1;
                            }
                        }
                    }
                }
            }
        }
    }
    .lightbox-added-content{
        position: absolute;
        width: 100vw;
        height: 100vh;
        top: 0;
        left: 0;
        .button{
            position: absolute;
            top: 50%;
            -webkit-transform: translateY(-50%);
            -moz-transform: translateY(-50%);
            -ms-transform: translateY(-50%);
            -o-transform: translateY(-50%);
            transform: translateY(-50%);
            z-index: 99996;
            &.previous{
                left: 15px;
            }
            &.next{
                right: 15px;
            }
        }
    }
    &.mobile{
        [data-lightbox-type="video"], [data-lightbox-type="video-file"], [data-lightbox-type="image"], [data-lightbox-type="gallery"]{
            // .media-block{
            //     border-radius: 0 !important;
            //     padding: 0 !important;
            // }
        }
    }
}
