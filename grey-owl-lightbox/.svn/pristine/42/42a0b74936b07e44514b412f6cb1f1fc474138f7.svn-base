{
	"version": 3,
	"file": "gol-style.css",
	"sources": [
		"gol-style.scss"
	],
	"sourcesContent": [
		"// compileCompressed: gol-style.css\r\n@import 'grey-owl-icon-font-style.css';\r\n[data-gol-content]{\r\n    display: none;\r\n}\r\n.admin-bar{\r\n    .go-lightbox-wrapper{\r\n        .media-block-wrapper{\r\n            top: calc( 50% + 16px );\r\n        }\r\n    }\r\n}\r\n.go-lightbox-wrapper{\r\n    position: fixed;\r\n    top: 0;\r\n    left: 0;\r\n    background-color: transparent;\r\n    width: 100%;\r\n    height: 100vh;\r\n    z-index: 99990;\r\n    .bg-btn-close {\r\n        position: absolute;\r\n        width: 100%;\r\n        height: 100%;\r\n        top: 0;\r\n        left: 0;\r\n        z-index: 9999;\r\n    }\r\n    .media-block-wrapper{\r\n        position: absolute;\r\n        top: 50%;\r\n        left: 50%;\r\n        -webkit-transform: translate(-50%, -50%);\r\n        -moz-transform: translate(-50%, -50%);\r\n        -ms-transform: translate(-50%, -50%);\r\n        -o-transform: translate(-50%, -50%);\r\n        transform: translate(-50%, -50%);\r\n        z-index: 99995;\r\n        [data-gol-content-box]{\r\n            //max-width: 100vh;\r\n            max-height: 90vh;\r\n            overflow-y: auto;\r\n            &>iframe{\r\n                display: block;\r\n                margin: 0;\r\n                max-width: none;\r\n            }\r\n            .error-message-box{\r\n                background-color: #ffffff;\r\n                width: 100%;\r\n                min-height: 100%;\r\n                text-align: center;\r\n                .error-text-cont{\r\n                    position: absolute;\r\n                    top: 50%;\r\n                    width: 100%;\r\n                    -webkit-transform: translate( 0, -50% );\r\n                    -moz-transform: translate( 0, -50% );\r\n                    -ms-transform: translate( 0, -50% );\r\n                    -o-transform: translate( 0, -50% );\r\n                    transform: translate( 0, -50% );\r\n\r\n                }\r\n            }\r\n        }\r\n        .media-block{\r\n            position: relative;\r\n            border-radius: 10px;\r\n            box-shadow: 0 0 30px rgba(0, 0, 0, 0.5);\r\n            .video-wrapper {\r\n                border-radius: 5px;\r\n                overflow: hidden;\r\n                iframe {\r\n                    display: block;\r\n                }\r\n            }\r\n            .image-wrapper{\r\n                position: relative;\r\n                display: table;\r\n                -webkit-transition: all 0.5s ease; /* Safari */\r\n                transition: all 0.5s ease;\r\n                overflow: hidden;\r\n                .loader-image-box{\r\n                    display: block;\r\n                    position: absolute;\r\n                    top: 50%;\r\n                    left: 50%;\r\n                    -webkit-transform: translate(-50%, -50%);\r\n                    -moz-transform: translate(-50%, -50%);\r\n                    -ms-transform: translate(-50%, -50%);\r\n                    -o-transform: translate(-50%, -50%);\r\n                    transform: translate(-50%, -50%);\r\n                    -webkit-transition: all 0.5s ease; /* Safari */\r\n                }\r\n                .image-box{\r\n                    display: block;\r\n                    position: absolute;\r\n                    top: 50%;\r\n                    left: 50%;\r\n                    -webkit-transform: translate(-50%, -50%);\r\n                    -moz-transform: translate(-50%, -50%);\r\n                    -ms-transform: translate(-50%, -50%);\r\n                    -o-transform: translate(-50%, -50%);\r\n                    transform: translate(-50%, -50%);\r\n                    transition: all 0.5s ease;\r\n                    opacity: 0;\r\n                    img{\r\n                        max-width: 100%;\r\n                    }\r\n                    &.current{\r\n                        opacity: 1;\r\n                    }\r\n                }\r\n                .button{\r\n                    position: absolute;\r\n                    background: transparent;\r\n                    height: 100%;\r\n                    width: 100px;\r\n                    top: 0;\r\n                    border: none;\r\n                    padding: 15px;\r\n                    margin: 0;\r\n                    opacity: 0;\r\n                    -webkit-transition: all 0.5s ease; /* Safari */\r\n                    transition: all 0.5s ease;\r\n                    opacity: 0;\r\n                    .btn-cont{\r\n                        display: inline-block;\r\n                        padding: 5px;\r\n                        color: #000000;\r\n                        background-color: rgba(255,255,255,0.7)\r\n                        //text-shadow: 0 0 10px #000000;\r\n                    }\r\n                    &:hover, &:focus{\r\n                        opacity: 1;\r\n                    }\r\n                    span, i{\r\n                        font-size: 20px;\r\n                    }\r\n                    &.previous{\r\n                        left: 0;\r\n                    }\r\n                    &.next{\r\n                        right: 0;\r\n                    }\r\n                }\r\n            }\r\n        }\r\n        .top-close-btn-wrapp{\r\n            position: absolute;\r\n            width: auto;\r\n            height: auto;\r\n            opacity: 0;\r\n            -webkit-transition: all 0.5s ease; /* Safari */\r\n            transition: all 0.5s ease;\r\n            .top-close-lightbox{\r\n                cursor: pointer;\r\n                position: relative;\r\n                width: 100%;\r\n                z-index: 99999;\r\n                padding: 0;\r\n                color: #000000;\r\n                background-color: #ffffff;\r\n                border: none;\r\n                border-radius: 50%;\r\n                box-shadow: 0 0 30px rgba(0, 0, 0, 0.5);\r\n                text-align: center;\r\n                font-size: 22px;\r\n                img{\r\n                    position: absolute;\r\n                    top: 50%;\r\n                    left: 50%;\r\n                    -webkit-transform: translate(-50%, -50%);\r\n                    -moz-transform: translate(-50%, -50%);\r\n                    -ms-transform: translate(-50%, -50%);\r\n                    -o-transform: translate(-50%, -50%);\r\n                    transform: translate(-50%, -50%);\r\n                    max-height: 100% !important;\r\n                    width: auto !important;\r\n                    margin: 0 !important;\r\n                }\r\n                span, div, i{\r\n                    width: inherit;\r\n                    height: inherit;\r\n                    line-height: inherit;\r\n                    font-size: inherit;\r\n                    text-align: center;\r\n                    display: block;\r\n                }\r\n            }\r\n        }\r\n    }\r\n    .bottom-close-btn-wrapp{\r\n        position: absolute;\r\n        height: 2rem;\r\n        left: 50%;\r\n        bottom: 25px;\r\n        -webkit-transform: translateX(-50%);\r\n        -moz-transform: translateX(-50%);\r\n        -ms-transform: translateX(-50%);\r\n        -o-transform: translateX(-50%);\r\n        transform: translateX(-50%);\r\n        z-index: 99999;\r\n        .bottom-close-lightbox {\r\n            background-color: #fff;\r\n            color: #000;\r\n            padding: 0;\r\n            font-size: 0;\r\n            line-height: 0;\r\n            height: 0;\r\n            margin: 0;\r\n            border: 0;\r\n            &:focus {\r\n                padding: 0.3rem 1rem;\r\n                font-size: 1.25rem;\r\n                line-height: 1.4rem;\r\n                height: 2rem;\r\n            }\r\n        }\r\n    }\r\n    &.displayed{\r\n        .media-block-wrapper {\r\n            .top-close-btn-wrapp{\r\n                opacity: 1;\r\n            }\r\n            // .media-block{\r\n            //     .image-wrapper{\r\n            //         .button{\r\n            //             opacity: 1;\r\n            //         }\r\n            //     }\r\n            // }\r\n        }\r\n        &.mobile-box{\r\n            .media-block-wrapper{\r\n                .media-block{\r\n                    .image-wrapper{\r\n                        .button{\r\n                            opacity: 0.4;\r\n                            width: 40px;\r\n                            padding: 0;\r\n                            &:hover, &:focus{\r\n                                opacity: 1;\r\n                            }\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n        }\r\n    }\r\n    .lightbox-added-content{\r\n        position: absolute;\r\n        width: 100vw;\r\n        height: 100vh;\r\n        top: 0;\r\n        left: 0;\r\n        .button{\r\n            position: absolute;\r\n            top: 50%;\r\n            -webkit-transform: translateY(-50%);\r\n            -moz-transform: translateY(-50%);\r\n            -ms-transform: translateY(-50%);\r\n            -o-transform: translateY(-50%);\r\n            transform: translateY(-50%);\r\n            z-index: 99996;\r\n            &.previous{\r\n                left: 15px;\r\n            }\r\n            &.next{\r\n                right: 15px;\r\n            }\r\n        }\r\n    }\r\n    &.mobile{\r\n        [data-lightbox-type=\"video\"], [data-lightbox-type=\"video-file\"], [data-lightbox-type=\"image\"], [data-lightbox-type=\"gallery\"]{\r\n            // .media-block{\r\n            //     border-radius: 0 !important;\r\n            //     padding: 0 !important;\r\n            // }\r\n        }\r\n    }\r\n}\r\n"
	],
	"names": [],
	"mappings": "AACA,OAAO,CAAP,iCAAO,EACP,AAAA,AAAA,gBAAC,AAAA,CAAiB,CACd,OAAO,CAAE,IAAI,CAChB,AACD,AAEQ,UAFE,CACN,oBAAoB,CAChB,oBAAoB,AAAA,CAChB,GAAG,CAAE,iBAAkB,CAC1B,AAGT,AAAA,oBAAoB,AAAA,CAChB,QAAQ,CAAE,KAAK,CACf,GAAG,CAAE,CAAC,CACN,IAAI,CAAE,CAAC,CACP,gBAAgB,CAAE,WAAW,CAC7B,KAAK,CAAE,IAAI,CACX,MAAM,CAAE,KAAK,CACb,OAAO,CAAE,KAAK,CAsQjB,AA7QD,AAQI,oBARgB,CAQhB,aAAa,AAAC,CACV,QAAQ,CAAE,QAAQ,CAClB,KAAK,CAAE,IAAI,CACX,MAAM,CAAE,IAAI,CACZ,GAAG,CAAE,CAAC,CACN,IAAI,CAAE,CAAC,CACP,OAAO,CAAE,IAAI,CAChB,AAfL,AAgBI,oBAhBgB,CAgBhB,oBAAoB,AAAA,CAChB,QAAQ,CAAE,QAAQ,CAClB,GAAG,CAAE,GAAG,CACR,IAAI,CAAE,GAAG,CACT,iBAAiB,CAAE,qBAAqB,CACxC,cAAc,CAAE,qBAAqB,CACrC,aAAa,CAAE,qBAAqB,CACpC,YAAY,CAAE,qBAAqB,CACnC,SAAS,CAAE,qBAAqB,CAChC,OAAO,CAAE,KAAK,CA0JjB,AAnLL,AA0BQ,oBA1BY,CAgBhB,oBAAoB,EAUhB,AAAA,oBAAC,AAAA,CAAqB,CAElB,UAAU,CAAE,IAAI,CAChB,UAAU,CAAE,IAAI,CAuBnB,AApDT,AA8BY,oBA9BQ,CAgBhB,oBAAoB,EAUhB,AAAA,oBAAC,AAAA,EAIK,MAAM,AAAA,CACJ,OAAO,CAAE,KAAK,CACd,MAAM,CAAE,CAAC,CACT,SAAS,CAAE,IAAI,CAClB,AAlCb,AAmCY,oBAnCQ,CAgBhB,oBAAoB,EAUhB,AAAA,oBAAC,AAAA,EASG,kBAAkB,AAAA,CACd,gBAAgB,CAAE,OAAO,CACzB,KAAK,CAAE,IAAI,CACX,UAAU,CAAE,IAAI,CAChB,UAAU,CAAE,MAAM,CAYrB,AAnDb,AAwCgB,oBAxCI,CAgBhB,oBAAoB,EAUhB,AAAA,oBAAC,AAAA,EASG,kBAAkB,CAKd,gBAAgB,AAAA,CACZ,QAAQ,CAAE,QAAQ,CAClB,GAAG,CAAE,GAAG,CACR,KAAK,CAAE,IAAI,CACX,iBAAiB,CAAE,kBAAoB,CACvC,cAAc,CAAE,kBAAoB,CACpC,aAAa,CAAE,kBAAoB,CACnC,YAAY,CAAE,kBAAoB,CAClC,SAAS,CAAE,kBAAoB,CAElC,AAlDjB,AAqDQ,oBArDY,CAgBhB,oBAAoB,CAqChB,YAAY,AAAA,CACR,QAAQ,CAAE,QAAQ,CAClB,aAAa,CAAE,IAAI,CACnB,UAAU,CAAE,CAAC,CAAC,CAAC,CAAC,IAAI,CAAC,eAAkB,CA+E1C,AAvIT,AAyDY,oBAzDQ,CAgBhB,oBAAoB,CAqChB,YAAY,CAIR,cAAc,AAAC,CACX,aAAa,CAAE,GAAG,CAClB,QAAQ,CAAE,MAAM,CAInB,AA/Db,AA4DgB,oBA5DI,CAgBhB,oBAAoB,CAqChB,YAAY,CAIR,cAAc,CAGV,MAAM,AAAC,CACH,OAAO,CAAE,KAAK,CACjB,AA9DjB,AAgEY,oBAhEQ,CAgBhB,oBAAoB,CAqChB,YAAY,CAWR,cAAc,AAAA,CACV,QAAQ,CAAE,QAAQ,CAClB,OAAO,CAAE,KAAK,CACd,kBAAkB,CAAE,aAAa,CACjC,UAAU,CAAE,aAAa,CACzB,QAAQ,CAAE,MAAM,CAiEnB,AAtIb,AAsEgB,oBAtEI,CAgBhB,oBAAoB,CAqChB,YAAY,CAWR,