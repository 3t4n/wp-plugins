#. Page title.
#: includes/class-xclickpw-settings.php:80
msgid "1-Click Login"
msgstr "Connexion en 1 clic"

#. Name of the plugin
msgid "1-Click PasswordLess Login"
msgstr "Connexion sans mot de passe en 1 clic"

#: includes/class-xclickpw-handler.php:142
msgid "Check your email for the login link."
msgstr "Vérifiez votre e-mail pour le lien de connexion."

#: includes/class-xclickpw-email.php:44
msgid "Click the button below to securely log in:"
msgstr ""
"Cliquez sur le bouton ci-dessous pour vous connecter en toute sécurité :"

#. Description of the plugin
msgid "Enable secure password less login with a 1-click magic link."
msgstr ""
"Activez la connexion sécurisée sans mot de passe avec un lien magique en 1 "
"clic."

#: includes/class-xclickpw-frontend.php:45
msgid "Enter your email to login:"
msgstr "Entrez votre e-mail pour vous connecter :"

#: includes/class-xclickpw-settings.php:346
msgid "Failed Login Attempts"
msgstr "Tentatives de connexion échouées"

#. Author URI of the plugin
msgid "https://github.com/xplodman/"
msgstr "https://github.com/xplodman/"

#: includes/class-xclickpw-email.php:50
msgid "If you didn't request this email, you can safely ignore it."
msgstr ""
"Si vous n'avez pas demandé cet e-mail, vous pouvez l'ignorer en toute "
"sécurité."

#: includes/class-xclickpw-handler.php:95
msgid "Invalid or expired login link. Please request a new one."
msgstr "Lien de connexion invalide ou expiré. Veuillez en demander un nouveau."

#: includes/class-xclickpw-handler.php:109
msgid "Invalid request. Please provide a username or email."
msgstr "Demande invalide. Veuillez fournir un nom d'utilisateur ou un e-mail."

#: includes/class-xclickpw-handler.php:74
msgid "Invalid request. Please try again."
msgstr "Demande invalide. Veuillez réessayer."

#: includes/class-xclickpw-settings.php:114
msgid "Lockout Time (minutes)"
msgstr "Temps de verrouillage (minutes)"

#: includes/class-xclickpw-email.php:45
msgid "Login Now"
msgstr "Se connecter maintenant"

#: includes/class-xclickpw-settings.php:339
msgid "Login Statistics"
msgstr "Statistiques de connexion"

#: includes/class-xclickpw-settings.php:113
msgid "Maximum Login Attempts"
msgstr "Nombre maximal de tentatives de connexion"

#: includes/class-xclickpw-settings.php:316
msgid "PasswordLess Authentication Settings"
msgstr "Paramètres d'authentification sans mot de passe"

#: includes/class-xclickpw-settings.php:112
msgid "Passwordless Expiry (minutes)"
msgstr "Expiration sans mot de passe (minutes)"

#: includes/class-xclickpw-frontend.php:47
msgid "Send Login Link"
msgstr "Envoyer le lien de connexion"

#. Section ID.
#: includes/class-xclickpw-settings.php:105
msgid "Settings"
msgstr "Paramètres"

#. %s is the expiration time in minutes.
#: includes/class-xclickpw-email.php:48
#, php-format
msgid "This link will expire in <strong>%s minutes</strong>."
msgstr "Ce lien expirera dans <strong>%s minutes</strong>."

#: includes/class-xclickpw-handler.php:126
msgid "Too many login attempts. Try again later."
msgstr "Trop de tentatives de connexion. Réessayez plus tard."

#: includes/class-xclickpw-settings.php:342
msgid "Total Successful Logins"
msgstr "Total des connexions réussies"

#. %s is the site name.
#: includes/class-xclickpw-email.php:42
#, php-format
msgid "Welcome back to %s!"
msgstr "Bon retour sur %s !"

#: includes/class-xclickpw-settings.php:115
msgid "WooCommerce Integration"
msgstr "Intégration WooCommerce"

#. Author of the plugin
msgid "Xplodman"
msgstr "Xplodman"

#. %s is the site name.
#: includes/class-xclickpw-email.php:39
#, php-format
msgid "🔑 Your Secure Login Link - %s"
msgstr "🔑 Votre lien de connexion sécurisé - %s"
