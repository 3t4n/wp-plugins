jQuery(document).ready(function(a){a("#user_pass").closest(".user-pass-wrap").remove(),a("#loginform").on("submit",function(e){e.preventDefault();e=a("#user_login").val();e?a.ajax({url:password_less_login_data.ajax_url,type:"POST",data:{action:"password_less_login",nonce:password_less_login_data.nonce,user_email:e},success:function(e){e.success,alert(e.data)},error:function(){alert("An error occurred. Please try again.")}}):alert("Please enter your username or email address.")}),a("#xclickpw-password-less-login").on("submit",function(e){e.preventDefault();e=a("#xclickpw-email").val();let s=a(".xclickpw-message");e?a.ajax({type:"POST",url:password_less_login_data.ajax_url,data:{action:"password_less_login",user_email:e,nonce:password_less_login_data.nonce},beforeSend:function(){s.text("Sending login link...").css("color","#0073aa")},success:function(e){e.success?s.text(e.data).css("color","green"):s.text(e.data).css("color","red")},error:function(){s.text("Something went wrong. Please try again.").css("color","red")}}):s.text("Please enter a valid email.").css("color","red")})});