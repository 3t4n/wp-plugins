/**
 * Define the internationalization functionality
 *
 * Loads and defines the internationalization files for this plugin
 * so that it is ready for translation.
 *
 * @link       https://puredevs.com
 * @since      1.0.0
 *
 * @package    Secure_User_Registration_by_PureDevs
 * @subpackage Secure_User_Registration_by_PureDevs/includes
 */

/**
 * Define the internationalization functionality.
 *
 * Loads and defines the internationalization files for this plugin
 * so that it is ready for translation.
 *
 * @since      1.0.0
 * @package    Secure_User_Registration_by_PureDevs
 * @subpackage Secure_User_Registration_by_PureDevs/includes
 * @author     puredevs <admin@puredevs.com>
 */
class Pdsrw_Secure_User_Registration_by_PureDevs_i18n {


	/**
	 * Load the plugin text domain for translation.
	 *
	 * @since    1.0.0
	 */
	public function pdsrw_load_plugin_textdomain() {

		load_plugin_textdomain(
			'secure-user-registration-by-puredevs',
			false,
			dirname( dirname( plugin_basename( __FILE__ ) ) ) . '/languages/'
		);

	}



}
