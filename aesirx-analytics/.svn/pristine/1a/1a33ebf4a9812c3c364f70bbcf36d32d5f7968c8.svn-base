@-webkit-keyframes flash {
  from {
    opacity: 0;
  }
  20% {
    opacity: 0;
  }
  22% {
    opacity: 0.6;
  }
  24% {
    opacity: 0.2;
  }
  26% {
    opacity: 0.9;
  }
  30% {
    opacity: 0;
  }
}
@keyframes flash {
  from {
    opacity: 0;
  }
  20% {
    opacity: 0;
  }
  22% {
    opacity: 0.6;
  }
  24% {
    opacity: 0.2;
  }
  26% {
    opacity: 1;
  }
  30% {
    opacity: 0;
  }
}
