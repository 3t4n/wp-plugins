\n\r\n  onDrop = (files, rejected) => {\r\n    if (rejected.length > 0) throw new Error('Upload failed:', rejected);\r\n    if (files.length > 1) {\r\n      alert('Please upload one file at a time');\r\n      throw new Error('Upload failed. Reason: Multiple files');\r\n    }\r\n    if (files[0].size === 0) {\r\n      alert('The file you uploded seems to be empty.\\nPlease check the file and try again.');\r\n      throw new Error('Upload failed. Reason: Empty file');\r\n    }\r\n\r\n    const reader = new FileReader();\r\n    const fileType = this.getFileType(files);\r\n\r\n    reader.onload = (e) => {\r\n      const { mapData } = this.props.mapObject;\r\n      const newMapData = [].concat(mapData);\r\n\r\n      this.onDropHelper(e.target.result, fileType).forEach((json) => {\r\n        newMapData.push(json);\r\n\r\n        const featureCollection = this.addToMbDrawHelper(json);\r\n        this.props.Draw.add(featureCollection);\r\n      });\r\n\r\n      const lastGeometryUploaded = newMapData[newMapData.length - 1]\r\n      this.props.dispatch(changeMapData(newMapData));\r\n      this.props.dispatch(selectGeometry(lastGeometryUploaded.id));\r\n    }\r\n\r\n    files.forEach((file) => {\r\n      reader.readAsText(file);\r\n    });\r\n  }\r\n\r\n  addToMbDrawHelper = (feature) => {\r\n    return {\r\n        \"type\" : \"FeatureCollection\",\r\n        \"features\" : [feature]\r\n    }\r\n  }\r\n\r\n  render() {\r\n\r\n    var currentGeometry = false;\r\n    this.props.mapObject.mapData.forEach(function(feature) {\r\n      if(feature.id===this.props.mapActions.selectGeometry) {\r\n        currentGeometry = feature;\r\n      }\r\n    }.bind(this))\r\n\r\n    return (\r\n      <div className=\"wp-mapbox-gl-js-edit-panel\">\r\n        <div className=\"wp-mapbox-gl-js-tabs-left\">\r\n          <ul>\r\n            <li className={this.state.currentTab==='marker' ? 'wp-mapbox-gl-js-active' : ''} onClick={ () => { this.setState({currentTab: 'marker'}); this.props.dispatch(selectGeometry(false)) }}>Markers</li>\r\n            <li className={this.state.currentTab==='fill' ? 'wp-mapbox-gl-js-active' : ''} onClick={ () => { this.setState({currentTab: 'fill'}); this.props.dispatch(selectGeometry(false)) }}>Fills</li>\r\n            <li className={this.state.currentTab==='line' ? 'wp-mapbox-gl-js-active' : ''} onClick={ () => { this.setState({currentTab: 'line'}); this.props.dispatch(selectGeometry(false)) }}>Lines</li>\r\n            <li className={this.state.currentTab==='upload' ? 'wp-mapbox-gl-js-active' : ''} onClick={ () => { this.setState({currentTab: 'upload'}); this.props.dispatch(selectGeometry(false)) }}>Import/Export</li>\r\n          </ul>\r\n        </div>\r\n        <div className=\"wp-mapbox-gl-js-tabs-right\">\r\n          <GeometryEdit\r\n            type={this.state.currentTab}\r\n            selectGeometry={selectGeometry}\r\n            currentGeometry={currentGeometry}\r\n            setMapObject={this.setMapObject}\r\n            addToMbDrawHelper={this.addToMbDrawHelper}\r\n            onDrop={this.onDrop}\r\n            {...this.props} />\r\n        </div>\r\n      </div>\r\n    );\r\n  }\r\n}\r\n\r\nexport default EditPanel;\r\n\n\n\n// WEBPACK FOOTER //\n// ./src/components/EditPanel.js","var rng = require('./lib/rng');\nvar bytesToUuid = require('./lib/bytesToUuid');\n\n// **`v1()` - Generate time-based UUID**\n//\n// Inspired by https://github.com/LiosK/UUID.js\n// and http://docs.python.org/library/uuid.html\n\nvar _nodeId;\nvar _clockseq;\n\n// Previous uuid creation time\nvar _lastMSecs = 0;\nvar _lastNSecs = 0;\n\n// See https://github.com/broofa/node-uuid for API details\nfunction v1(options, buf, offset) {\n  var i = buf && offset || 0;\n  var b = buf || [];\n\n  options = options || {};\n  var node = options.node || _nodeId;\n  var clockseq = options.clockseq !== undefined ? options.clockseq : _clockseq;\n\n  // node and clockseq need to be initialized to random values if they're not\n  // specified.  We do