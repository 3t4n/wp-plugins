con_url.split('/wp-mapbox-gl-js/admin/wp-mapmaker/public/img/')[1];\r\n        var tabColorAndName = imageSplit.split('/');\r\n        var imageColor = '';\r\n        var imageName = tabColorAndName[1].split('-wp_mapbox_gl_js_sizing')[0];\r\n        if(tabColorAndName.length===3) {\r\n          imageColor = tabColorAndName[1];\r\n          imageName = imageColor+'/'+tabColorAndName[2].split('-wp_mapbox_gl_js_sizing')[0];\r\n        }\r\n        this.setState({\r\n          currentEditorTab:tabColorAndName[0],\r\n          currentImage : this.props.currentGeometry.properties.marker_icon_url,\r\n          currentColor : imageColor\r\n        }, () => {\r\n            this.selectImage(imageName);\r\n        });\r\n      } else {\r\n        var imageURL = this.props.currentGeometry.properties.marker_icon_url.split('-wp_mapbox_gl_js_sizing')[0];\r\n        this.setState({\r\n          currentEditorTab: 'uploaded',\r\n          currentImage : this.props.currentGeometry.properties.marker_icon_url\r\n        }, () => {\r\n            this.selectImage(imageURL);\r\n        });\r\n      }\r\n    }\r\n  }\r\n\r\n  // componentWillReceiveProps(nextProps) {\r\n  // }\r\n\r\n  fetchMoreMedia() {\r\n    this.props.dispatch(fetchMedia(this.state.mediaPage+1));\r\n    this.setState({mediaPage:this.state.mediaPage+1});\r\n  }\r\n\r\n  selectValue(e) {\r\n    if(e.value!=='custom-creator') {\r\n      this.props.setMapObject('markerIcon',[e.value,'bottom'])\r\n    } else {\r\n      this.toggleCustomCreator();\r\n    }\r\n  }\r\n\r\n  selectImage(image) {\r\n    var canvas = document.getElementById('wp_mapbox_gl_js_canvas');\r\n    var ctx = canvas.getContext('2d');\r\n    var img  = document.getElementById('wp_mapbox_gl_js_canvas_img');\r\n    img.width = 100;\r\n    img.height = 100;\r\n    this.setState({iconSize:100})\r\n    img.onload = function() {\r\n      canvas.width  = img.width;\r\n      canvas.height = img.height;\r\n      ctx.clearRect(0, 0, canvas.width, canvas.height);\r\n      ctx.drawImage(img, 0, 0, img.width, img.height);\r\n    };\r\n    if(this.props.currentGeometry.properties.marker_icon_url.indexOf('/wp-mapbox-gl-js/admin/wp-mapmaker/public/img/')>-1) {\r\n      img.src = $('#wp_mapbox_gl_js_plugin_url').val()+'/wp-mapbox-gl-js/admin/wp-mapmaker/public/img/'+this.state.currentEditorTab+'/'+image;\r\n      this.setState({currentImage:$('#wp_mapbox_gl_js_plugin_url').val()+'/wp-mapbox-gl-js/admin/wp-mapmaker/public/img/'+this.state.currentEditorTab+'/'+image, iconSize:100})\r\n    } else {\r\n      img.src = image;\r\n      this.setState({currentImage:image, iconSize:100})\r\n    }\r\n  }\r\n\r\n  selectUploadedImage(image) {\r\n    var canvas = document.getElementById('wp_mapbox_gl_js_canvas');\r\n    var ctx = canvas.getContext('2d');\r\n    var img  = document.getElementById('wp_mapbox_gl_js_canvas_img');\r\n    img.width = 100;\r\n    img.height = 100;\r\n    img.onload = function() {\r\n      canvas.width  = img.width;\r\n      canvas.height = img.height;\r\n      ctx.drawImage(img, 0, 0, img.width, img.height);\r\n    };\r\n    img.src = image.source_url;\r\n    this.setState({colourChanged:false, currentImage:image.source_url, iconSize:100})\r\n  }\r\n\r\n  adjustIconSize(range) {\r\n    var img  = document.getElementById('wp_mapbox_gl_js_canvas_img');\r\n    img.width = range;\r\n    img.height = range;\r\n    this.setState({iconSize:range})\r\n  }\r\n\r\n  setIcon(e,imageURL) {\r\n    e.preventDefault();\r\n    var img = document.getElementById('wp_mapbox_gl_js_canvas_img');\r\n    this.props.setMapObject('markerIcon',[img.src+'-wp_mapbox_gl_js_sizing-'+img.width+'-'+img.width,this.state.iconAnchor])\r\n    this.props.closeIconCreator();\r\n  }\r\n\r\n  fileUpload(e) {\r\n    // Uses WP REST API\r\n\t\tvar formData = new FormData();\r\n\t\tformData.append( 'file', e.target.files[0] );\r\n    this.props.dispatch(createMedia(formData,'uploaded'));\r\n  }\r\n\r\n  changeColour(e) {\r\n    e.preventDefault();\r\n\r\n    v