ewMapData.push(thisFeature);\r\n          }\r\n        }.bind(this))\r\n        this.props.dispatch(changeMapData(newMapData));\r\n        break;\r\n      case 'extrusion_height':\r\n        var newMapData = [];\r\n        this.props.mapObject.mapData.forEach(function(feature) {\r\n          var thisFeature = JSON.parse(JSON.stringify(feature));\r\n          if (thisFeature.id===this.props.mapActions.selectGeometry) {\r\n            thisFeature.properties.height = e;\r\n            newMapData.push(thisFeature);\r\n          } else {\r\n            newMapData.push(thisFeature);\r\n          }\r\n        }.bind(this))\r\n        this.props.dispatch(changeMapData(newMapData));\r\n        break;\r\n      default:\r\n        break;\r\n    }\r\n  }\r\n\r\n  getFileType = (files) => {\r\n    const fileType = files[0].type ? files[0].type : files[0].name.split('.')[files[0].name.split('.').length - 1];\r\n    return fileType;\r\n  }\r\n\r\n  onDropHelper = (uploadedFile, fileType) => {\r\n    let convertedFile;\r\n    let { createdFeaturesCounter } = this.state;\r\n\r\n    switch (fileType) {\r\n      case 'application/json':\r\n        convertedFile = JSON.parse(uploadedFile);\r\n        break;\r\n\r\n      case 'geojson':\r\n        convertedFile = JSON.parse(uploadedFile);\r\n        break;\r\n\r\n      case 'text/csv':\r\n        csv2geojson.csv2geojson(uploadedFile, (err, data) => {\r\n          if (err) throw new Error(err.message);\r\n          convertedFile = data;\r\n        });\r\n        break;\r\n\r\n      case 'kml':\r\n        const kml = new xml.DOMParser().parseFromString(uploadedFile);\r\n        convertedFile = kml2geojson.kml(kml);\r\n        break;\r\n\r\n      default:\r\n        alert('Valid file types include:\\n.kml, .geojson, .json, .csv');\r\n        throw new Error('Invalid file type');\r\n      }\r\n\r\n    if (convertedFile.features.length > 0) {\r\n      convertedFile.features.forEach((f) => {\r\n        const { name, description, marker_title,