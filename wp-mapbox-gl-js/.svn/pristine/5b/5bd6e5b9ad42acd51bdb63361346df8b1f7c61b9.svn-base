.toUpperCase() + string.slice(1);\r\n}\r\n\r\nclass PropertyEditor extends Component {\r\n\r\n  constructor(props) {\r\n    super(props);\r\n    this.state = {\r\n      modifiedFeature : false,\r\n      newProperty : ''\r\n    }\r\n  }\r\n\r\n  componentDidMount() {\r\n    var currentGeometry = JSON.parse(JSON.stringify(this.props.currentGeometry))\r\n    this.setState({modifiedFeature:currentGeometry});\r\n  }\r\n\r\n  changeProperty(key, e) {\r\n    var thisFeature = JSON.parse(JSON.stringify(this.state.modifiedFeature));\r\n    thisFeature.properties[key] = e.target.value;\r\n    this.setState({modifiedFeature : thisFeature});\r\n  }\r\n\r\n  addProperty(e) {\r\n    e.preventDefault();\r\n    var thisFeature = JSON.parse(JSON.stringify(this.state.modifiedFeature));\r\n    thisFeature.properties[this.state.newProperty] = '';\r\n    this.setState({newProperty:'',modifiedFeature:thisFeature});\r\n  }\r\n\r\n  removeProperty(key, e) {\r\n    e.preventDefault();\r\n    var thisFeature = JSON.parse(JSON.stringify(this.state.modifiedFeature));\r\n    delete thisFeature.properties[key];\r\n    this.setState({newProperty:'',modifiedFeature:thisFeature});\r\n  }\r\n\r\n  setProperties(e) {\r\n    e.preventDefault();\r\n    const { modifiedFeature } = this.state;\r\n    if(modifiedFeature) {\r\n      var newFeatures = [];\r\n      this.props.mapObject.mapData.forEach(function(feature) {\r\n        if(feature.id===modifiedFeature.id) {\r\n          newFeatures.push(modifiedFeature);\r\n        } else {\r\n          newFeatures.push(feature);\r\n        }\r\n      })\r\n      this.props.dispatch(changeMapData(newFeatures));\r\n    }\r\n    this.props.closePropertyEditor();\r\n  }\r\n\r\n  render() {\r\n\r\n    var currentGeometryPropertiesAsArray = [];\r\n    for (var prop in this.state.modifiedFeature.properties) {\r\n      if(prop!=='opacity'&&prop!=='rgb'&&prop!=='description'&&prop!=='popup_open'&&prop!=='marker_icon_url'&&prop!=='marker_title'&&prop!=='category'&&prop!=='marker_icon_anchor'&&prop!=='color') {\r\n        currentGeometryPropertiesAsArray.push({\r\n          key : prop,\r\n          value : this.state.modifiedFeature.properties[prop]\r\n        })\r\n      }\r\n    }\r\n    console.log(currentGeometryPropertiesAsArray);\r\n\r\n    return (\r\n      <div style={{width:window.innerWidth-160,height:window.innerHeight,marginLeft:-($('#wp-mapbox-gl-js-geometry-options').offset().left-160),marginTop:-($('#wp-mapbox-gl-js-geometry-options').offset().top+($(\".edit-post-layout__content\").length ? $(\".edit-post-layout__content\").scrollTop() : 0))}} className={\"wp-mapbox-gl-js-property-editor now-active\"}>\r\n        <div style={{height:window.innerHeight/1.5}} className=\"wp-mapbox-gl-js-property-editor-container\">\r\n          <h3>Property Editor</h3>\r\n          <p>Here, you can edit the properties attached to your feature. The properties built into WP Mapbox GL JS are not listed here.</p>\r\n          <p><strong>This is an advanced feature. Get in touch if you have trouble with it.</strong></p>\r\n          <table>\r\n            <tbody>\r\n              {currentGeometryPropertiesAsArray.map((prop, index) => {\r\n                return (\r\n                  <tr key={\"table-row-\"+index}>\r\n                    <td><strong>{prop.key}</strong></td>\r\n                    <td><input type=\"text\" value={prop.value} onChange={this.changeProperty.bind(this,prop.key)} /></td>\r\n                    <td>{prop.key!=='name'&&prop.key!=='description' ? <button className=\"button\" onClick={this.removeProperty.bind(this,prop.key)}>Remove Property</button> : false }</td>\r\n                  </tr>\r\n                )\r\n              })}\r\n              <tr style={{marginTop:'20px'}}>\r\n                <td></td>\r\n                <td><input type=\"text\" value={this.state.newProperty} onChange={(e) => this.setState({newProperty:e.target.value})} /></td>\r\n                <td><button onClick={this.addProperty.bind(this)} className=\"button\">Add Property</button></td>\r\n              </tr>\r\n            </tbody>\r\n          </table>\r\n          <div style={{marginBottom:'70px'}} className=\"wp_mapbox_gl_js_actions\">\r\n            <button className=\"button\" style={{marginRight:'10px'}} onClick={(e) => { e.preventDefault(); this.props.closePropertyEditor(); }}>Cancel</button>\r\n            <button className=\"button button-primary\" onClick={this.setProperties.bind(this)}>Update Properties</button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    )\r\n  }\r\n}\r\n\r\nexport default PropertyEditor;\r\n\n\n\n// WEBPACK FOOTER //\n// ./src/components/PropertyEditor.js","//  Chance.js 1.0.16\n//  http://chancejs.com\n//  (c) 2013 Victor Quinn\n//  Chance may be freely distributed or modified under the MIT license.\n\n(function () {\n\n    // Constants\n    var MAX_INT = 9007199254740992;\n    var MIN_INT = -MAX_INT;\n    var NUMBERS = '0123456789';\n    var CHARS_LOWER = 'abcdefghijklmnopqrstuvwxyz';\n    var CHARS_UPPER = CHARS_LOWER.toUpperCase();\n    var HEX_POOL  = NUMBERS + \"abcdef\";\n\n    // Errors\n    function UnsupportedError(message) {\n        this.name = 'UnsupportedError';\n        this.message = message || 'This feature is not supported on this platform';\n    }\n\n    UnsupportedError.prototype = new Error();\n    UnsupportedError.prototype.constructor = UnsupportedError;\n\n    // Cached array helpers\n    var slice = Array.prototype.slice;\n\n    // Constructor\n    function Chance (seed) {\n        if (!(this instanceof Chance)) {\n            if (!seed) { seed = null; } // handle other non-truthy seeds, as described in issue #322\n            return seed === null ? new Chance() : new Chance(seed);\n        }\n\n        // if user has provided a function, use that as the generator\n        if (typeof seed === 'function') {\n            this.random = seed;\n            return this;\n        }\n\n        if (arguments.length) {\n            // set a