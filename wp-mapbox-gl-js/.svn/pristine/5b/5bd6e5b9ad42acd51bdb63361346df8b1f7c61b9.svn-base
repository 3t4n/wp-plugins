\r\n      return stateCopy;\r\n    case CHANGE_POPUPHTML:\r\n      stateCopy['popupHTML'] = action.payload;\r\n      return stateCopy;\r\n    case CHANGE_MARKER:\r\n      stateCopy['markerIcon'] = action.payload;\r\n      return stateCopy;\r\n    case CHANGE_MARKER_COLOR:\r\n      stateCopy['markerColor'] = action.payload;\r\n      return stateCopy;\r\n    case CHANGE_CONTROL:\r\n      stateCopy['controls'][action.payload.type] = action.payload.onoroff;\r\n      return stateCopy;\r\n    default:\r\n      return state\r\n  }\r\n}\r\n\r\nexport default mapObject\r\n\n\n\n// WEBPACK FOOTER //\n// ./src/reducers/reducer_map_object.js","import {\r\n  DRAW_ON_MAP,\r\n  SELECT_GEOMETRY,\r\n  SELECT_POPUP_EDIT_GEOMETRY,\r\n} from '../actions/actions_map'\r\n\r\nconst mapActions = (state = {\r\n  draw : false,\r\n  selectGeometry : false,\r\n  popupEditGeometry : false\r\n}, action) => {\r\n  var stateCopy = JSON.parse(JSON.stringify(state));\r\n  switch (action.type) {\r\n    case DRAW_ON_MAP:\r\n      stateCopy['draw'] = action.payload;\r\n      return stateCopy;\r\n    case SELECT_GEOMETRY:\r\n      stateCopy['selectGeometry'] = action.payload;\r\n      return stateCopy;\r\n    case SELECT_POPUP_EDIT_GEOMETRY:\r\n      stateCopy['popupEditGeometry'] = action.payload;\r\n      return stateCopy;\r\n    default:\r\n      return state\r\n  }\r\n}\r\n\r\nexport default mapActions\r\n\n\n\n// WEBPACK FOOTER //\n// ./src/reducers/reducer_map.js","import {\r\n  ADD_MEDIA,\r\n  ADD_MEDIAS\r\n} from '../actions/actions_media'\r\n\r\nconst media = (state = {\r\n  uploaded : [],\r\n  defaults : [],\r\n  maki : [],\r\n  mapkey : []\r\n}, action) => {\r\n  switch (action.type) {\r\n    case ADD_MEDIA:\r\n      var newState = JSON.parse(JSON.stringify(state));\r\n      newState[action.payload.meta.wp_mapbox_gl_js_media[0]].push(action.payload);\r\n      return newState;\r\n    case ADD_MEDIAS:\r\n      var newState = JSON.parse(JSON.stringify(state));\r\n      var ids = [];\r\n      for (var type in newState) {\r\n        newState[type].forEach(function(thisMedia) {\r\n          ids.push(thisMedia.id);\r\n        })\r\n      }\r\n      action.payload.uploaded.forEach(function(thisMedia) {\r\n        if(ids.indexOf(thisMedia.id)===-1) {\r\n          newState.uploaded.push(thisMedia);\r\n        }\r\n      })\r\n      action.payload.defaults.forEach(function(thisMedia) {\r\n        if(ids.indexOf(thisMedia.id)===-1) {\r\n          newState.defaults.push(thisMedia);\r\n        }\r\n      })\r\n      action.payload.maki.forEach(function(thisMedia) {\r\n        if(ids.indexOf(thisMedia.id)===-1) {\r\n          newState.maki.push(thisMedia);\r\n        }\r\n      })\r\n      action.payload.mapkey.forEach(function(thisMedia) {\r\n        if(ids.indexOf(thisMedia.id)===-1) {\r\n          newState.mapkey.push(thisMedia);\r\n        }\r\n      })\r\n      return newState;\r\n    default:\r\n      return state\r\n  }\r\n}\r\n\r\nexport default media\r\n\n\n\n// WEBPACK FOOTER //\n// ./src/reducers/reducer_media.js","import { connect } from 'react-redux'\r\nimport AppComponent from '../components/App'\r\nimport $ from 'jquery';\r\n\r\nconst mapStateToProps = state => {\r\n  // Every time mapObject changes, save it to the DOM\r\n  $('#wp_mapbox_gl_js_map_object').val(JSON.stringify(state.mapObject));\r\n  return {\r\n    mapObject : state.mapObject,\r\n    mapActions : state.mapActions\r\n  }\r\n}\r\n\r\nconst App = connect(\r\n  mapStateToProps\r\n)(AppComponent)\r\n\r\nexport default App\r\n\n\n\n// WEBPACK FOOTER //\n// ./src/containers/App.js","import React, { Component } from 'react';\r\nimport MapboxDraw from '@mapbox/mapbox-gl-draw/dist/mapbox-gl-draw';\r\n\r\nimport Map from '../containers/Map';\r\nimport EditPanel from '../containers/EditPanel';\r\nimport MapModal from './MapModal';\r\n\r\nclass App extends Component {\r\n\r\n  constructor(props) {\r\n    super(props)\r\n\r\n    const Draw = new MapboxDraw({\r\n      controls : {\r\n        combine_features : false,\r\n        uncombine_features : false,\r\n        trash : false\r\n      },\r\n      styles: [{'id': 'gl-draw-polygon-fill-inactive','type': 'fill','filter': ['all',['==', 'active', 'false'],['==', '$type', 'Polygon'],['!=', 'mode', 'static']],'paint': {'fill-color': '#3bb2d0','fill-outline-color': '#3bb2d0','fill-opacity': 0.1}},{'id': 'gl-draw-polygon-fill-active','type': 'fill','filter': ['all', ['==', 'active', 'true'], ['==', '$type', 'Polygon']],'paint': {'fill-color': '#fbb03b','fill-outline-color': '#fbb03b','fill-opacity': 0.1}},{'id': 'gl-draw-polygon-midpoint','type': 'circle','filter': ['all',['==', '$type', 'Point'],['==', 'meta', 'midpoint']],'paint': {'circle-radius': 3,'circle-color': '#fbb03b'}},{'id': 'gl-draw-polygon-stroke-inactive','type': 'line','filter': ['all',['==', 'active', 'false'],['==', '$type', 'Polygon'],['!=', 'mode', 'static']],'layout': {'line-cap': 'round','line-join': 'round'},'paint': {'line-color': '#3bb2d0','line-width': 0}},{'id': 'gl-draw-polygon-stroke-active','type': 'line','filter': ['all', ['==', 'active', 'true'], ['==', '$type', 'Polygon']],'layout': {'line-cap': 'round','line-join': 'round'},'paint': {'line-color': '#fbb03b','line-dasharray': [0.2, 2],'line-width': 2}},{'id': 'gl-draw-line-inactive','type': 'line','filter': ['all',['==', 'active', 'false'],['==', '$type', 'LineString'],['!=', 'mode', 'static']],'layout': {'line-cap': 'round','line-join': 'round'},'paint': {'line-color': '#3bb2d0','line-width': 0}},{'id': 'gl-draw-line-active','type': 'line','filter': ['all',['==', '$type', 'LineString'],['==', 'active', 'true']],'layout': {'line-cap': 'round','line-join': 'round'},'paint': {'line-color': '#fbb03b','line-dasharray': [0.2, 2],'line-width': 2}},{'id': 'gl-draw-polygon-and-line-vertex-stroke-inactive','type': 'circle','filter': ['all',['==', 'meta', 'vertex'],['==', '$type', 'Point'],['!=', 'mode', 'static']],'paint': {'circle-radius': 5,'circle-color': '#fff'}},{'id': 'gl-draw-polygon-and-line-vertex-inactive','type': 'circle','filter': ['all',['==', 'meta', 'vertex'],['==', '$type', 'Point'],['!=', 'mode', 'static']],'paint': {'circle-radius': 3,'circle-color': '#fbb03b'}},{'id': 'gl-draw-point-point-stroke-inactive','type': 'circle','filter': ['all',['==', 'active', 'false'],['==', '$type', 'Point'],['==', 'meta', 'feature'],['!=', 'mode', 'static']],'paint': {'circle-radius': 0,'circle-opacity': 1,'circle-color': '#fff'}},{'id': 'gl-draw-point-inactive','type': 'circle','filter': ['all',['==', 'active', 'false'],['==', '$type', 'Point'],['==', 'meta', 'feature'],['!=', 'mode', 'static']],'paint': {'circle-radius': 0,'circle-color': '#3bb2d0'}},{'id': 'gl-draw-point-stroke-active','type': 'circle','filter': ['all',['==', '$type', 'Point'],['==', 'active', 'true'],['!=', 'meta', 'midpoint']],'paint': {'circle-radius': 0,'circle-color': '#fff'}},{'id': 'gl-draw-point-active','type': 'circle','filter': ['all',['==', '$type', 'Point'],['!=', 'meta', 'midpoint'],['==', 'active', 'true']],'paint': {'circle-radius': 0,'circle-color': '#fbb03b'}},{'id': 'gl-draw-polygon-fill-static','type': 'fill','filter': ['all', ['==', 'mode', 'static'], ['==', '$type', 'Polygon']],'paint': {'fill-color': '#404040','fill-outline-color': '#404040','fill-opacity': 0.1}},{'id': 'gl-draw-polygon-stroke-static','type': 'line','filter': ['all', ['==', 'mode', 'static'], ['==', '$type', 'Polygon']],'layout': {'line-cap': 'round','line-join': 'round'},'paint': {'line-color': '#404040','line-width': 2}},{'id': 'gl-draw-line-static','type': 'line','filter': ['all', ['==', 'mode', 'static'], ['==', '$type', 'LineString']],'layout': {'line-cap': 'round','line-join': 'round'},'paint': {'line-color': '#404040','line-width': 2}},{'id': 'gl-draw-point-static','type': 'circle','filter': ['all', ['==', 'mode', 'static'], ['==', '$type', 'Point']],'paint': {'circle-radius': 0,'circle-color': '#404040'}}]});\r\n\r\n    this.state = {\r\n      Draw : Draw,\r\n      map : false\r\n    }\r\n    var that = this;\r\n    setTimeout(function() {\r\n      that.setState({map:true})\r\n    },500);\r\n  }\r\n\r\n  render() {\r\n    return (\r\n      <div className=\"wp-mapbox-gl-js-mapmaker\">\r\n        <MapModal active={this.props.mapActions.popupEditGeometry} />\r\n        <div>\r\n          <div>\r\n            {this.state.map ? <Map Draw={this.state.Draw} /> : false }\r\n            <EditPanel Draw={this.state.Draw} />\r\n          </div>\r\n        </div>\r\n      </div>\r\n    );\r\n  }\r\n}\r\n\r\nexport default App;\r\n\n\n\n// WEBPACK FOOTER //\n// ./src/components/App.js","import { connect } from 'react-redux'\r\nimport MapComponent from '../components/Map'\r\n\r\nconst mapStateToProps = state => {\r\n  return {\r\n    mapActions : state.mapActions,\r\n    mapObject : state.mapObject,\r\n  }\r\n}\r\n\r\nconst Map = connect(\r\n  mapStateToProps\r\n)(MapComponent)\r\n\r\nexport default Map\r\n\n\n\n// WEBPACK FOOTER //\n// ./src/containers/Map.js","import React, { Component } from 'react';\r\nimport mapboxgl from 'mapbox-gl';\r\nimport MapboxDraw from '@mapbox/mapbox-gl-draw/dist/mapbox-gl-draw';\r\nimport '@mapbox/mapbox-gl-draw/dist/mapbox-gl-draw.css'\r\nimport resolvePath from 'object-resolve-path';\r\nimport _ from 'underscore';\r\nimport $ from 'jquery';\r\nimport MapboxGeocoder from 'mapbox-gl-geocoder';\r\nimport MapboxDirections from '@mapbox/mapbox-gl-directions/dist/mapbox-gl-directions';\r\n\r\nimport CustomCategoryControl from './controls/CustomCategoryControl';\r\nimport CustomLayerControl from './controls/CustomLayerControl';\r\n\r\nimport { selectGeometry, selectPopupEditGeometry } from '../actions/actions_map';\r\nimport { changeZoom, changeCenter, changePitch, changeControl, changeBearing, changeStyle, changeMapData, changeMapCategories, changeDirectionsPrefill, changeMapLayersFilters } from '../actions/index';\r\n\r\nmapboxgl.accessToken = $('#wp_mapbox_gl_js_access_token').val();\r\n\r\nclass Map extends Component {\r\n\r\n  constructor(props) {\r\n    super(props);\r\n    this.state = {\r\n      map : false,\r\n      mapType : '',\r\n      currentMarkers : [],\r\n      mapObject : {},\r\n      pointSource : false,\r\n      fillLayer : false,\r\n      lineLayer : false,\r\n      markers : [],\r\n      geocoderControl : false,\r\n      navControl : false,\r\n      scaleControl : false,\r\n      fullscreenControl : false,\r\n      directionsControl : false,\r\n      customCategoryControl : false,\r\n      customLayerControl : false,\r\n      popup : false,\r\n      dataAdded : false,\r\n      drawingDirections : '',\r\n      scrollZoom: true,\r\n      loadedIcons: [],\r\n      directionsPrefill: {\r\n        origin: [], // [lat, lng]\r\n        destination: [] // [lat, lng]\r\n      },\r\n      geolocaterControl: false\r\n    }\r\n  }\r\n\r\n  // Every time state updates the geoJSON, it should be printed into the external input\r\n\r\n  componentDidMount() {\r\n    var map = new mapboxgl.Map({\r\n      container: 'wp_mapbox_gl_js_map',\r\n      style: this.props.mapObject.style,\r\n      center : this.props.mapObject.center,\r\n      zoom : this.props.mapObject.zoom,\r\n      pitch : this.props.mapObject.pitch,\r\n      bearing : this.props.mapObject.bearing\r\n    });\r\n    $('#wp-mapbox-gl-js-center').val(this.props.mapObject.center.join());\r\n    $('#wp-mapbox-gl-js-pitch').val(this.props.mapObject.pitch);\r\n    $('#wp-mapbox-gl-js-bearing').val(this.props.mapObject.bearing);\r\n    $('#wp-mapbox-gl-js-zoom').val(this.props.mapObject.zoom);\r\n\r\n    this.setState({mapObject:this.props.mapObject});\r\n\r\n    map.on('load',function() {\r\n      this.componentWillReceiveProps(this.props,'first');\r\n      var oneOfDefaultStyles = false;\r\n      var that = this;\r\n      $('#wp-mapbox-gl-js-style option').each(function() {\r\n        if(that.props.mapObject.style===$(this).val()) {\r\n          oneOfDefaultStyles = true;\r\n        }\r\n      });\r\n      if(!oneOfDefaultStyles) {\r\n        $('#wp-mapbox-gl-js-custom-style').val(this.props.mapObject.style);\r\n      } else {\r\n        $('#wp-mapbox-gl-js-style').val(this.props.mapObject.style);\r\n      }\r\n    }.bind(this));\r\n\r\n    map.on('style.load',function() {\r\n\r\n      this.componentWillReceiveProps(this.props,'load');\r\n\r\n      // Geocoder for the autocomplete\r\n      if(!this.state.geocoderLoaded) {\r\n        var geocoder = new MapboxGeocoder({\r\n          accessToken: mapboxgl.accessToken,\r\n          placeholder : 'Add marker by address...'\r\n        });\r\n        geocoder.on('result',function(e) {\r\n          var found = false;\r\n          this.props.mapObject.mapData.forEach(function(feature) {\r\n            if(feature.id === e.result.center.join(',')) {\r\n              found = true;\r\n            }\r\n          })\r\n          if(!found) {\r\n            var thisFeature = [{\r\n              \"type\" : \"Feature\",\r\n              \"id\" : e.result.center.join(','),\r\n              \"geometry\" : {\r\n                \"type\" : \"Point\",\r\n                \"coordinates\" : e.result.center\r\n              },\r\n              \"properties\" : {}\r\n            }]\r\n            if(typeof thisFeature[0].properties.name === 'undefined') {\r\n              thisFeature[0].properties.name = \"\";\r\n              thisFeature[0].properties.description = \"Description\";\r\n              thisFeature[0].properties.color = \"#333\";\r\n              thisFeature[0].properties.marker_icon_url = $('#wp_mapbox_gl_js_plugin_url').val()+\"/wp-mapbox-gl-js/admin/wp-mapmaker/public/img/black_default.png\";\r\n              thisFeature[0].properties.marker_icon_anchor = \"bottom\";\r\n              thisFeature[0].properties.marker_title = \"Marker\";\r\n              thisFeature[0].properties.category = \"\";\r\n              if(thisFeature[0].geometry.type==='Polygon') {\r\n                thisFeature[0].properties.marker_title = 'Fill';\r\n              }\r\n              if(thisFeature[0].geometry.type==='LineString') {\r\n                thisFeature[0].properties.marker_title = 'Line';\r\n              }\r\n              var existingFeatures = JSON.parse(JSON.stringify(this.props.mapObject.mapData));\r\n              existingFeatures = existingFeatures.concat(thisFeature);\r\n              this.props.dispatch(changeMapData(existingFeatures));\r\n            }\r\n          }\r\n        }.bind(this));\r\n        document.getElementById('wp-mapbox-gl-js-autocomplete').innerHTML = '';\r\n        document.getElementById('wp-mapbox-gl-js-autocomplete').appendChild(geocoder.onAdd(map));\r\n        $(document).on('click','.geocoder-icon geocoder-icon-close',function(e) { e.preventDefault() });\r\n        this.setState({geocoderLoaded:true});\r\n      }\r\n\r\n    }.bind(this));\r\n\r\n    // var Draw = new MapboxDraw({\r\n    //   controls : {\r\n    //     combine_features : false,\r\n    //     uncombine_features : false,\r\n    //     trash : false\r\n    //   },\r\n    //   styles: [{'id': 'gl-draw-polygon-fill-inactive','type': 'fill','filter': ['all',['==', 'active', 'false'],['==', '$type', 'Polygon'],['!=', 'mode', 'static']],'paint': {'fill-color': '#3bb2d0','fill-outline-color': '#3bb2d0','fill-opacity': 0.1}},{'id': 'gl-draw-polygon-fill-active','type': 'fill','filter': ['all', ['==', 'active', 'true'], ['==', '$type', 'Polygon']],'paint': {'fill-color': '#fbb03b','fill-outline-color': '#fbb03b','fill-opacity': 0.1}},{'id': 'gl-draw-polygon-midpoint','type': 'circle','filter': ['all',['==', '$type', 'Point'],['==', 'meta', 'midpoint']],'paint': {'circle-radius': 3,'circle-color': '#fbb03b'}},{'id': 'gl-draw-polygon-stroke-inactive','type': 'line','filter': ['all',['==', 'active', 'false'],['==', '$type', 'Polygon'],['!=', 'mode', 'static']],'layout': {'line-cap': 'round','line-join': 'round'},'paint': {'line-color': '#3bb2d0','line-width': 0}},{'id': 'gl-draw-polygon-stroke-active','type': 'line','filter': ['all', ['==', 'active', 'true'], ['==', '$type', 'Polygon']],'layout': {'line-cap': 'round','line-join': 'round'},'paint': {'line-color': '#fbb03b','line-dasharray': [0.2, 2],'line-width': 2}},{'id': 'gl-draw-line-inactive','type': 'line','filter': ['all',['==', 'active', 'false'],['==', '$type', 'LineString'],['!=', 'mode', 'static']],'layout': {'line-cap': 'round','line-join': 'round'},'paint': {'line-color': '#3bb2d0','line-width': 0}},{'id': 'gl-draw-line-active','type': 'line','filter': ['all',['==', '$type', 'LineString'],['==', 'active', 'true']],'layout': {'line-cap': 'round','line-join': 'round'},'paint': {'line-color': '#fbb03b','line-dasharray': [0.2, 2],'line-width': 2}},{'id': 'gl-draw-polygon-and-line-vertex-stroke-inactive','type': 'circle','filter': ['all',['==', 'meta', 'vertex'],['==', '$type', 'Point'],['!=', 'mode', 'static']],'paint': {'circle-radius': 5,'circle-color': '#fff'}},{'id': 'gl-draw-polygon-and-line-vertex-inactive','type': 'circle','filter': ['all',['==', 'meta', 'vertex'],['==', '$type', 'Point'],['!=', 'mode', 'static']],'paint': {'circle-radius': 3,'circle-color': '#fbb03b'}},{'id': 'gl-draw-point-point-stroke-inactive','type': 'circle','filter': ['all',['==', 'active', 'false'],['==', '$type', 'Point'],['==', 'meta', 'feature'],['!=', 'mode', 'static']],'paint': {'circle-radius': 0,'circle-opacity': 1,'circle-color': '#fff'}},{'id': 'gl-draw-point-inactive','type': 'circle','filter': ['all',['==', 'active', 'false'],['==', '$type', 'Point'],['==', 'meta', 'feature'],['!=', 'mode', 'static']],'paint': {'circle-radius': 0,'circle-color': '#3bb2d0'}},{'id': 'gl-draw-point-stroke-active','type': 'circle','filter': ['all',['==', '$type', 'Point'],['==', 'active', 'true'],['!=', 'meta', 'midpoint']],'paint': {'circle-radius': 0,'circle-color': '#fff'}},{'id': 'gl-draw-point-active','type': 'circle','filter': ['all',['==', '$type', 'Point'],['!=', 'meta', 'midpoint'],['==', 'active', 'true']],'paint': {'circle-radius': 0,'circle-color': '#fbb03b'}},{'id': 'gl-draw-polygon-fill-static','type': 'fill','filter': ['all', ['==', 'mode', 'static'], ['==', '$type', 'Polygon']],'paint': {'fill-color': '#404040','fill-outline-color': '#404040','fill-opacity': 0.1}},{'id': 'gl-draw-polygon-stroke-static','type': 'line','filter': ['all', ['==', 'mode', 'static'], ['==', '$type', 'Polygon']],'layout': {'line-cap': 'round','line-join': 'round'},'paint': {'line-color': '#404040','line-width': 2}},{'id': 'gl-draw-line-static','type': 'line','filter': ['all', ['==', 'mode', 'static'], ['==', '$type', 'LineString']],'layout': {'line-cap': 'round','line-join': 'round'},'paint': {'line-color': '#404040','line-width': 2}},{'id': 'gl-draw-point-static','type': 'circle','filter': ['all', ['==', 'mode', 'static'], ['==', '$type', 'Point']],'paint': {'circle-radius': 0,'circle-color': '#404040'}}]});\r\n\r\n    /* MapboxDraw is in src/components/App.js now */\r\n    const Draw = this.props.Draw;\r\n\r\n    map.addControl(Draw,'top-right')\r\n    $('.mapboxgl-ctrl-top-right .mapboxgl-ctrl').addClass('wp-mapbox-gl-js-custom-draw-controls');\r\n    $('.wp-mapbox-gl-js-custom-draw-controls').appendTo('.mapboxgl-control-container');\r\n    // $('.wp-mapbox-gl-js-custom-draw-controls button').hide();\r\n    // $('.wp-mapbox-gl-js-custom-draw-controls').append('<div class=\"wp-mapbox-gl-js-show-editor\"><p><small>Add shapes or points!</small></p></div>');\r\n    // $(document).on('click','.wp-mapbox-gl-js-show-editor',function() {\r\n    //   $('.wp-mapbox-gl-js-custom-draw-controls button').show();\r\n    //   $('.wp-mapbox-gl-js-show-editor').hide();\r\n    // });\r\n\r\n    // Add existing features\r\n    var featureCollection = {\r\n      \"type\" : \"FeatureCollection\",\r\n      \"features\" : this.props.mapObject.mapData\r\n    }\r\n    Draw.add(featureCollection);\r\n\r\n    // Set up events\r\n    map.on('draw.create', function (e) {\r\n      // console.log(e.features);\r\n      var existingFeatures = JSON.parse(JSON.stringify(this.props.mapObject.mapData));\r\n      existingFeatures = existingFeatures.concat(e.features);\r\n      var newFeatures = [];\r\n      existingFeatures.forEach(function(feature,index) {\r\n        var thisFeature = JSON.parse(JSON.stringify(feature));\r\n        if(typeof thisFeature.properties.name === 'undefined') {\r\n          thisFeature.properties.name = \"\";\r\n          thisFeature.properties.description = \"Description\";\r\n          thisFeature.properties.color = \"#333\";\r\n          thisFeature.properties.marker_icon_url = $('#wp_mapbox_gl_js_plugin_url').val()+\"/wp-mapbox-gl-js/admin/wp-mapmaker/public/img/black_default.png\";\r\n          thisFeature.properties.marker_title = \"Marker\";\r\n          thisFeature.properties.category = \"\";\r\n          thisFeature.properties.popup_open = true;\r\n          thisFeature.properties.opacity = 0.4;\r\n          thisFeature.properties.marker_icon_anchor = \"bottom\";\r\n          if(thisFeature.geometry.type==='Polygon') {\r\n            thisFeature.properties.marker_title = 'Fill';\r\n          }\r\n          if(thisFeature.geometry.type==='LineString') {\r\n            thisFeature.properties.marker_title = 'Line';\r\n          }\r\n        }\r\n        newFeatures.push(thisFeature);\r\n      })\r\n      this.props.dispatch(changeMapData(newFeatures));\r\n      this.props.dispatch(selectGeometry(e.features[0].id));\r\n\r\n    }.bind(this));\r\n\r\n    // map.on('draw.delete', function (e) {\r\n    //   // console.log(e.features);\r\n    //   var existingFeatures = JSON.parse(JSON.stringify(this.props.mapObject.mapData));\r\n    //   map.removeSource(e.features[0].id);\r\n    //   map.removeLayer(e.features[0].id);\r\n    //   existingFeatures = existingFeatures.filter(feature => {\r\n    //     return feature.id!==e.features[0].id;\r\n    //   });\r\n    //   this.props.dispatch(changeMapData(existingFeatures));\r\n    // }.bind(this));\r\n\r\n    map.on('draw.modechange', function (e) {\r\n      if(e.mode==='draw_line_string') {\r\n        this.setState({drawingDirections:'Click twice on the last point to end your <strong>line</strong>.'})\r\n      } else if(e.mode==='draw_polygon') {\r\n        this.setState({drawingDirections:'To finish your fill / polygon, click the first <strong>point</strong>.'})\r\n      } else if(e.mode === 'draw_point') {\r\n        this.setState({ drawingDirections: 'Click anywhere on the map to place a <strong>marker</strong>.' });\r\n      } else {\r\n        this.setState({drawingDirections: ''})\r\n      }\r\n    }.bind(this));\r\n\r\n    map.on('draw.update', function (e) {\r\n      var existingFeatures = JSON.parse(JSON.stringify(this.props.mapObject.mapData));\r\n      existingFeatures = existingFeatures.map(feature => {\r\n        var thisFeature = false;\r\n        if(feature.id===e.features[0].id) {\r\n          thisFeature = e.features[0];\r\n          thisFeature.properties = feature.properties;\r\n\r\n          if (typeof feature.fillType === 'string') {\r\n            thisFeature.fillType = feature.fillType;\r\n          }\r\n        } else {\r\n          thisFeature = feature;\r\n        }\r\n        return thisFeature;\r\n      });\r\n      this.props.dispatch(changeMapData(existingFeatures));\r\n    }.bind(this));\r\n\r\n    var that = this;\r\n    $(document).on('click','#changePopupContent',function(e) {\r\n      e.preventDefault();\r\n      var featureID = $(this).data('featureid');\r\n      that.props.dispatch(selectPopupEditGeometry(featureID));\r\n    })\r\n    $(document).on('click','#wp_mapbox_gl_js_set_directions',function(e) {\r\n      // This one is on the map\r\n      e.preventDefault();\r\n      // var featureID = $(this).data('featureId');\r\n      var coords = $(this).data('lngLat').split(',');\r\n      var lngLat = [parseFloat(coords[0]), parseFloat(coords[1])];\r\n\r\n      if (that.state.directionsControl) {\r\n        that.state.directionsControl.setDestination(lngLat);\r\n      } else {\r\n        alert('You must enable the Directions checkbox on the right for the Directions button to work.');\r\n      }\r\n    });\r\n    $(document).on('click','#deleteFeature, #deleteFeatureFromPopup, #make-3d, #make-2d', function(e) {\r\n      e.preventDefault();\r\n      var featureID = $(this).data('featureid');\r\n      var existingFeatures = JSON.parse(JSON.stringify(that.props.mapObject.mapData));\r\n      Draw.delete(featureID);\r\n      map.removeLayer(featureID);\r\n      map.removeSource(featureID);\r\n      existingFeatures = existingFeatures.filter(feature => {\r\n        return feature.id!==featureID;\r\n      });\r\n      if(that.state.popup) {\r\n        that.state.popup.remove();\r\n      }\r\n\r\n      that.props.dispatch(selectGeometry(false))\r\n      that.props.dispatch(selectPopupEditGeometry(false));\r\n      that.props.dispatch(changeMapData(existingFeatures));\r\n\r\n      // Select new feature\r\n      if (e.target.id === 'make-3d' || e.target.id === 'make-2d') {\r\n        const newFeatureId = existingFeatures.filter((feature) => {\r\n          return feature.prevId === featureID;\r\n        })[0];\r\n        that.props.dispatch(selectGeometry(newFeatureId.id))\r\n      }\r\n    });\r\n    // Dataset feature of setting ID to feature that exists\r\n  \t$(document).on('click', '#set_wp_mapbox_gl_js_feature', function(e) {\r\n      e.preventDefault();\r\n  \t\tif($('#wp_mapbox_gl_js_feature_list').val()!==''&&this.props.mapObject.mapData.length===1) {\r\n        var newMapData = JSON.parse(JSON.stringify(this.props.mapObject.mapData));\r\n        // Deletion\r\n        Draw.delete(newMapData[0].id);\r\n        map.removeLayer(newMapData[0].id);\r\n        map.removeSource(newMapData[0].id);\r\n        if(this.state.popup) {\r\n          this.state.popup.remove();\r\n        }\r\n        this.props.dispatch(selectGeometry(false))\r\n        this.props.dispatch(selectPopupEditGeometry(false));\r\n        this.props.dispatch(changeMapData([]));\r\n        // Re-adding\r\n        var that = this;\r\n        newMapData[0].id = $('#wp_mapbox_gl_js_feature_list').val();\r\n        setTimeout(function() {\r\n          Draw.add(newMapData[0]);\r\n          that.props.dispatch(changeMapData(newMapData));\r\n          $('.wp_mapbox_gl_js_dataset_error').html('Success! Please publish or update this post.');\r\n        },1000);\r\n  \t\t} else {\r\n        $('.wp_mapbox_gl_js_dataset_error').html('Either you did not select a feature or this post has more than one feature to associate. See the documentation for help.');\r\n      }\r\n  \t}.bind(this));\r\n    $(document).on('change','#wp-mapbox-gl-js-style',function(e) {\r\n      this.props.dispatch(changeStyle(e.target.value));\r\n    }.bind(this));\r\n    $(document).on('change','#wp-mapbox-gl-js-custom-style',function(e) {\r\n      if(e.target.value!=='') {\r\n        this.props.dispatch(changeStyle(e.target.value));\r\n      }\r\n    }.bind(this));\r\n    $(document).on('change','#wp-mapbox-gl-js-center',function(e) {\r\n      var array = e.target.value.split(',');\r\n      array[0] = parseFloat(array[0]);\r\n      array[1] = parseFloat(array[1]);\r\n      this.props.dispatch(changeCenter(array));\r\n    }.bind(this));\r\n    $(document).on('change','#wp-mapbox-gl-js-zoom',function(e) {\r\n      this.props.dispatch(changeZoom(e.target.value));\r\n    }.bind(this));\r\n    $(document).on('change','#wp-mapbox-gl-js-bearing',function(e) {\r\n      this.props.dispatch(changeBearing(e.target.value));\r\n    }.bind(this));\r\n    $(document).on('change','#wp-mapbox-gl-js-pitch',function(e) {\r\n      this.props.dispatch(changePitch(e.target.value));\r\n    }.bind(this));\r\n    $(document).on('change','#wp_mapbox_gl_js_scroll_zoom',function(e) {\r\n      this.props.dispatch(changeControl(e.target.checked, 'scrollZoom'));\r\n    }.bind(this));\r\n\r\n    $(document).on('change','#wp_mapbox_gl_js_location_search',function(e) {\r\n      this.props.dispatch(changeControl(e.target.checked,'geocoder'));\r\n    }.bind(this));\r\n    $(document).on('change','#wp_mapbox_gl_js_distance',function(e) {\r\n      this.props.dispatch(changeControl(e.target.checked,'scale'));\r\n    }.bind(this));\r\n    $(document).on('change','#wp_mapbox_gl_js_zoompan',function(e) {\r\n      this.props.dispatch(changeControl(e.target.checked,'navigation'));\r\n    }.bind(this));\r\n    $(document).on('change','#wp_mapbox_gl_js_fullscreen',function(e) {\r\n      this.props.dispatch(changeControl(e.target.checked,'fullscreen'));\r\n    }.bind(this));\r\n    $(document).on('change','#wp_mapbox_gl_js_directions',function(e) {\r\n      this.props.dispatch(changeControl(e.target.checked,'directions'));\r\n      this.props.dispatch(changeControl(false,'preFillInput'));\r\n    }.bind(this));\r\n    $(document).on('change','#wp_mapbox_gl_js_category_filter',function(e) {\r\n      this.props.dispatch(changeControl(e.target.checked,'categoryFilter'));\r\n    }.bind(this));\r\n    $(document).on('change','#wp_mapbox_gl_js_layer_filter',function(e) {\r\n      this.props.dispatch(changeControl(e.target.checked,'layerFilter'));\r\n    }.bind(this));\r\n    $(document).on('change','#wp_mapbox_gl_js_layer_select',function(e) {\r\n      this.props.dispatch(changeMapLayersFilters($('#wp_mapbox_gl_js_layer_select').val(),'layerFilter'));\r\n    }.bind(this));\r\n    $(document).on('change','#wp_mapbox_gl_js_directions_pre_fill_input',function(e) {\r\n      this.props.dispatch(changeControl(e.target.checked,'preFillInput'));\r\n    }.bind(this));\r\n    $(document).on('change','#wp_mapbox_gl_js_controls_geolocater',function(e) {\r\n      this.props.dispatch(changeControl(e.target.checked,'geolocaterControl'));\r\n    }.bind(this));\r\n    $(document).on('change','#wp_mapbox_gl_js_location_sidebar',function(e) {\r\n      this.props.dispatch(changeControl(e.target.checked,'locationSidebar'));\r\n    }.bind(this));\r\n    $(document).on('change','#wp-mapbox-gl-js-marker-overlap',function(e) {\r\n      this.props.dispatch(changeControl(!e.target.checked,'markerNoDisappear'));\r\n    }.bind(this));\r\n    $(document).on('click','#wp-mapbox-gl-js-marker-hide',function(e) {\r\n      e.preventDefault();\r\n      var newFeatures = JSON.parse(JSON.stringify(this.props.mapObject.mapData))\r\n      newFeatures.forEach(function(feature) {\r\n        feature.properties.popup_open = false;\r\n      })\r\n      that.props.dispatch(changeMapData(newFeatures));\r\n    }.bind(this));\r\n    $(document).on('change','#wp_mapbox_gl_js_cluster_markers',function(e) {\r\n      this.props.dispatch(changeControl(e.target.checked,'clusterMarkers'));\r\n    }.bind(this));\r\n\r\n\r\n\r\n    $('#category_filter_input_submit').on('click', function(e) {\r\n      e.preventDefault();\r\n      if($('#category_filter_input').val()!=='') {\r\n        var newMapCategories = JSON.parse(JSON.stringify(this.props.mapObject.mapCategories));\r\n        const newCategory = $('#category_filter_input').val();\r\n        if(newMapCategories.indexOf(newCategory)===-1) {\r\n          newMapCategories.push(newCategory);\r\n          this.props.dispatch(changeMapCategories(newMapCategories));\r\n          $('#category_filter_input').val('');\r\n        }\r\n      }\r\n    }.bind(this));\r\n\r\n    map.on('moveend',function() {\r\n      if($('#wp-mapbox-gl-js-set-current-map-view')[0].checked) {\r\n        $('#wp-mapbox-gl-js-zoom').val(map.getZoom().toFixed(4));\r\n        $('#wp-mapbox-gl-js-pitch').val(map.getPitch().toFixed(4));\r\n        $('#wp-mapbox-gl-js-bearing').val(map.getBearing().toFixed(4));\r\n        $('#wp-mapbox-gl-js-center').val(map.getCenter().lng.toFixed(4)+','+map.getCenter().lat.toFixed(4));\r\n        this.props.dispatch(changeCenter([map.getCenter().lng,map.getCenter().lat]));\r\n        this.props.dispatch(changeZoom(map.getZoom()));\r\n        this.props.dispatch(changePitch(map.getPitch()));\r\n        this.props.dispatch(changeBearing(map.getBearing()));\r\n      }\r\n    }.bind(this))\r\n    this.setState({map});\r\n\r\n  }\r\n\r\n  componentWillReceiveProps(nextProps,flag) {\r\n    // console.log({ nextProps, thisProps: this.props })\r\n    const { map } = this.state;\r\n    var markers = [];\r\n\r\n    // Controls\r\n    if(map.loaded()) {\r\n      if(nextProps.mapObject.controls.navigation&&!this.state.navControl) {\r\n        var navControl = new mapboxgl.NavigationControl();\r\n        map.addControl(navControl);\r\n        this.setState({navControl:navControl})\r\n        $('#wp_mapbox_gl_js_zoompan').prop('checked', true);\r\n      } else if(!nextProps.mapObject.controls.navigation&&this.state.navControl) {\r\n        map.removeControl(this.state.navControl)\r\n        this.setState({navControl:false})\r\n        $('#wp_mapbox_gl_js_zoompan').prop('checked', false);\r\n      }\r\n\r\n      if(nextProps.mapObject.controls.geocoder&&!this.state.geocoderControl) {\r\n        var geocoder = new MapboxGeocoder({\r\n            accessToken: mapboxgl.accessToken\r\n        });\r\n        map.addControl(geocoder,'top-left');\r\n        this.setState({geocoderControl:geocoder})\r\n        $('#wp_mapbox_gl_js_location_search').prop('checked', true);\r\n      } else if(!nextProps.mapObject.controls.geocoder&&this.state.geocoderControl) {\r\n        map.removeControl(this.state.geocoderControl);\r\n        this.setState({geocoderControl:false})\r\n        $('#wp_mapbox_gl_js_location_search').prop('checked', false);\r\n      }\r\n\r\n      if(nextProps.mapObject.controls.markerNoDisappear) {\r\n        $('#wp-mapbox-gl-js-marker-overlap').prop('checked', false);\r\n        nextProps.mapObject.mapData.forEach(function(feature) {\r\n          if(feature.geometry.type==='Point') {\r\n            if(map.getSource(feature.id)) {\r\n              map.setLayoutProperty(feature.id,'icon-allow-overlap',true)\r\n            }\r\n          }\r\n        })\r\n      } else {\r\n        $('#wp-mapbox-gl-js-marker-overlap').prop('checked', true);\r\n        nextProps.mapObject.mapData.forEach(function(feature) {\r\n          if(feature.geometry.type==='Point') {\r\n            if(map.getSource(feature.id) && map.getLayer(feature.id)) {\r\n              map.setLayoutProperty(feature.id,'icon-allow-overlap',false)\r\n            }\r\n          }\r\n        })\r\n      }\r\n\r\n      if(nextProps.mapObject.controls.directions&&!this.state.directionsControl) {\r\n        var directions = new MapboxDirections({\r\n            accessToken: mapboxgl.accessToken,\r\n            interactive: false\r\n        });\r\n        directions.on('origin',function(e) {\r\n          var newPreFillInput = JSON.parse(JSON.stringify(this.props.mapObject.preFillDirections));\r\n          newPreFillInput['origin'] = $('#mapbox-directions-origin-input input').val();\r\n          // console.log(newPreFillInput)\r\n          this.props.dispatch(changeDirectionsPrefill(newPreFillInput));\r\n        }.bind(this)).on('destination', function(e) {\r\n          var newPreFillInput = JSON.parse(JSON.stringify(this.props.mapObject.preFillDirections));\r\n          newPreFillInput['destination'] = $('#mapbox-directions-destination-input input').val();\r\n          this.props.dispatch(changeDirectionsPrefill(newPreFillInput));\r\n        }.bind(this)).on('clear',function(e) {\r\n          var newPreFillInput = JSON.parse(JSON.stringify(nextProps.mapObject.preFillDirections));\r\n          newPreFillInput[e.type] = $('#mapbox-directions-'+e.type+'-input input').val();\r\n          this.props.dispatch(changeDirectionsPrefill(newPreFillInput));\r\n        }.bind(this));\r\n        map.addControl(directions,'top-left');\r\n        this.setState({ directionsControl: directions });\r\n        $('#wp_mapbox_gl_js_directions').prop('checked', true);\r\n        $('#wp_mapbox_gl_js_directions_pre_fill_checkbox').show();\r\n        // console.log()\r\n        if(nextProps.mapObject.preFillDirections.origin!==''||nextProps.mapObject.preFillDirections.destination!=='') {\r\n          $('#wp_mapbox_gl_js_directions_pre_fill_checkbox input').prop('checked', true);\r\n        }\r\n      } else if(!nextProps.mapObject.controls.directions&&this.state.directionsControl) {\r\n        map.removeControl(this.state.directionsControl);\r\n        map.removeLayer('directions-route-line');\r\n        map.removeLayer('directions-route-line-alt');\r\n        map.removeLayer('directions-hover-point-casing');\r\n        map.removeLayer('directions-hover-point');\r\n        map.removeLayer('directions-waypoint-point-casing');\r\n        map.removeLayer('directions-waypoint-point');\r\n        map.removeLayer('directions-origin-point');\r\n        map.removeLayer('directions-origin-label');\r\n        map.removeLayer('directions-destination-point');\r\n        map.removeLayer('directions-destination-label');\r\n        if (map.getSource('directions')) map.removeSource('directions');\r\n        this.setState({directionsControl:false})\r\n        $('#wp_mapbox_gl_js_directions').prop('checked', false);\r\n        $('#wp_mapbox_gl_js_directions_pre_fill_checkbox').hide();\r\n      }\r\n\r\n      if(nextProps.mapObject.controls.locationSidebar) {\r\n        $('#wp_mapbox_gl_js_location_sidebar').prop('checked', true);\r\n      } else {\r\n        $('#wp_mapbox_gl_js_location_sidebar').prop('checked', false);\r\n      }\r\n\r\n      if(nextProps.mapObject.controls.clusterMarkers) {\r\n        $('#wp_mapbox_gl_js_cluster_markers').prop('checked', true);\r\n        var mapDataPoints = [];\r\n        nextProps.mapObject.mapData.forEach(function(feature) {\r\n          if(feature.geometry.type==='Point') {\r\n            mapDataPoints.push(feature);\r\n          }\r\n        })\r\n        var featureCollection = {\r\n          type : \"FeatureCollection\",\r\n          features : mapDataPoints\r\n        }\r\n        if(map.getSource('marker-cluster-geojson')) {\r\n          map.getSource('marker-cluster-geojson').setData(featureCollection);\r\n        } else {\r\n          map.addSource('marker-cluster-geojson', {\r\n            type: \"geojson\",\r\n            data: featureCollection,\r\n            cluster: true,\r\n            clusterMaxZoom: 14,\r\n            clusterRadius: 50\r\n          })\r\n          map.addLayer({\r\n              id: \"clusters\",\r\n              type: \"circle\",\r\n              source: \"marker-cluster-geojson\",\r\n              filter: [\"has\", \"point_count\"],\r\n              paint: {\r\n                  \"circle-color\": [ \"step\", [\"get\", \"point_count\"],\r\n                      \"#51bbd6\", 100,\r\n                      \"#f1f075\", 750,\r\n                      \"#f28cb1\"\r\n                  ],\r\n                  \"circle-radius\": [ \"step\", [\"get\", \"point_count\"],\r\n                      20, 100,\r\n                      30, 750,\r\n                      40\r\n                  ]\r\n              }\r\n          });\r\n          map.addLayer({\r\n              id: \"cluster-count\",\r\n              type: \"symbol\",\r\n              source: \"marker-cluster-geojson\",\r\n              filter: [\"has\", \"point_count\"],\r\n              layout: {\r\n                  \"text-field\": \"{point_count_abbreviated}\",\r\n                  \"text-font\": [\"DIN Offc Pro Medium\", \"Arial Unicode MS Bold\"],\r\n                  \"text-size\": 12\r\n              }\r\n          });\r\n          map.addLayer({\r\n              id: \"unclustered-point\",\r\n              type: \"symbol\",\r\n              source: \"marker-cluster-geojson\",\r\n              filter: [\"!\", [\"has\", \"point_count\"]],\r\n              layout : {\r\n                \"icon-image\" : [\"get\", \"marker_icon_url\"],\r\n                \"icon-anchor\" : [\"get\", \"marker_icon_anchor\"],\r\n                'icon-size' : 0.2\r\n              }\r\n          });\r\n          mapDataPoints.forEach(function(feature) {\r\n            map.setPaintProperty(feature.id,'icon-opacity',0)\r\n          })\r\n          map.on('click','unclustered-point',function(e) {\r\n            console.log(e);\r\n            if(this.state.popup) {\r\n              this.state.popup.remove();\r\n            }\r\n            if(e.features[0].geometry.type==='Point') {\r\n\r\n              var popup = new mapboxgl.Popup({\r\n                offset : 20\r\n              })\r\n\r\n              let popupHTML =\r\n                '<div>'+\r\n                  '<div>'+e.features[0].properties.description+'</div>'+\r\n                '</div>';\r\n\r\n              popup.setLngLat({lat: e.features[0].geometry.coordinates[1], lng: e.features[0].geometry.coordinates[0]})\r\n                .setHTML(popupHTML).addTo(map);\r\n\r\n              this.setState({popup})\r\n            }\r\n            this.props.dispatch(selectGeometry(e.features[0].layer.id))\r\n          }.bind(this))\r\n        }\r\n      } else {\r\n        // Hide the clustering layer or remove the source entirely\r\n        $('#wp_mapbox_gl_js_cluster_markers').prop('checked', false);\r\n        if(map.getSource('marker-cluster-geojson')) {\r\n          map.removeLayer('unclustered-point');\r\n          map.removeLayer('cluster-count');\r\n          map.removeLayer('clusters');\r\n          map.removeSource('marker-cluster-geojson');\r\n          nextProps.mapObject.mapData.forEach(function(feature) {\r\n            if(feature.geometry.type==='Point') {\r\n              map.setPaintProperty(feature.id,'icon-opacity',1)\r\n            }\r\n          })\r\n        }\r\n      }\r\n\r\n      // prefill input\r\n\r\n      if(nextProps.mapObject.controls.scale&&!this.state.scaleControl) {\r\n        var scale = new mapboxgl.ScaleControl({\r\n          maxWidth: 80,\r\n          unit: 'metric'\r\n        })\r\n        map.addControl(scale,'top-left');\r\n        this.setState({scaleControl:scale})\r\n        $('#wp_mapbox_gl_js_distance').prop('checked', true);\r\n      } else if(!nextProps.mapObject.controls.scale&&this.state.scaleControl) {\r\n        map.removeControl(this.state.scaleControl);\r\n        this.setState({scaleControl:false})\r\n        $('#wp_mapbox_gl_js_distance').prop('checked', false);\r\n      }\r\n\r\n      if(nextProps.mapObject.controls.fullscreen&&!this.state.fullscreenControl) {\r\n        var fullscreen = new mapboxgl.FullscreenControl();\r\n        map.addControl(fullscreen,'top-right');\r\n        this.setState({fullscreenControl:fullscreen})\r\n        $('#wp_mapbox_gl_js_fullscreen').prop('checked', true);\r\n      } else if(!nextProps.mapObject.controls.fullscreen&&this.state.fullscreenControl) {\r\n        map.removeControl(this.state.fullscreenControl);\r\n        $('#wp_mapbox_gl_js_fullscreen').prop('checked', false);\r\n        this.setState({fullscreenControl:false})\r\n      }\r\n    }\r\n\r\n    // scroll zoom\r\n    if (nextProps.mapObject.controls.scrollZoom) {\r\n      map.scrollZoom.enable();\r\n      $('#wp_mapbox_gl_js_scroll_zoom').prop('checked', true);\r\n      this.setState({ scrollZoom: true });\r\n\r\n    } else if (!nextProps.mapObject.controls.scrollZoom) {\r\n      map.scrollZoom.disable();\r\n      $('#wp_mapbox_gl_js_scroll_zoom').prop('checked', false);\r\n      this.setState({ scrollZoom: false });\r\n    }\r\n\r\n    if(this.props.mapObject.style!==nextProps.mapObject.style) {\r\n      map.setStyle(nextProps.mapObject.style);\r\n    }\r\n\r\n    // Layer filter\r\n    if (nextProps.mapObject.controls.layerFilter && !this.state.customLayerControl) {\r\n      $('#wp_mapbox_gl_js_layer_creator').show();\r\n      $('#wp_mapbox_gl_js_layer_select').html('');\r\n      map.getStyle().layers.forEach(function(layer) {\r\n        if(layer.source==='composite') {\r\n          $('#wp_mapbox_gl_js_layer_select').append('<option id=\"'+layer.id+'\">'+layer.id+'</option>');\r\n        }\r\n      })\r\n      // console.log(nextProps.mapObject.mapLayersFilter)\r\n      const customLayerControl = new CustomLayerControl({\r\n        layers : nextProps.mapObject.mapLayersFilter\r\n      })\r\n      map.addControl(customLayerControl,'top-left');\r\n      this.setState({customLayerControl:customLayerControl})\r\n      $('#wp_mapbox_gl_js_layer_filter').prop('checked', true);\r\n    } else if (!nextProps.mapObject.controls.layerFilter && this.state.customLayerControl) {\r\n      $('#wp_mapbox_gl_js_layer_creator').hide();\r\n      map.removeControl(this.state.customLayerControl);\r\n      this.setState({customLayerControl:false})\r\n      $('#wp_mapbox_gl_js_layer_filter').prop('checked', false);\r\n    }\r\n    // If there is a change to selected layers to filter\r\n    if(this.state.customLayerControl && !_.isEqual(nextProps.mapObject.mapLayersFilter,this.state.mapObject.mapLayersFilter)) {\r\n      this.state.customLayerControl.updateLayers(nextProps.mapObject.mapLayersFilter);\r\n    }\r\n\r\n    // category filter\r\n    if (nextProps.mapObject.controls.categoryFilter && !this.state.customCategoryControl) {\r\n      $('#wp_mapbox_gl_js_category_creator').show();\r\n      const customCategoryControl = new CustomCategoryControl({\r\n        categories : nextProps.mapObject.mapCategories,\r\n        mapData : nextProps.mapObject.mapData\r\n      })\r\n      map.addControl(customCategoryControl,'top-left');\r\n      this.setState({customCategoryControl:customCategoryControl})\r\n      $('#wp_mapbox_gl_js_category_filter').prop('checked', true);\r\n    } else if (!nextProps.mapObject.controls.categoryFilter && this.state.customCategoryControl) {\r\n      $('#wp_mapbox_gl_js_category_creator').hide();\r\n      map.removeControl(this.state.customCategoryControl);\r\n      this.setState({customCategoryControl:false})\r\n      $('#wp_mapbox_gl_js_category_filter').prop('checked', false);\r\n    }\r\n\r\n    // geolocater\r\n    if (nextProps.mapObject.controls.geolocaterControl && !this.state.geolocaterControl) {\r\n      const geolocaterControl = new mapboxgl.GeolocateControl({\r\n        positionOptions: { enableHighAccuracy: true },\r\n        trackUserLocation: true\r\n      });\r\n      map.addControl(geolocaterControl);\r\n      this.setState({ geolocaterControl: geolocaterControl });\r\n      $('#wp_mapbox_gl_js_controls_geolocater').prop('checked', true);\r\n    } else if (!nextProps.mapObject.controls.geolocaterControl && this.state.geolocaterControl) {\r\n      if(this.state.geolocaterControl) {\r\n        map.removeControl(this.state.geolocaterControl);\r\n      }\r\n      this.setState({ geolocaterControl: false });\r\n      $('#wp_mapbox_gl_js_controls_geolocater').prop('checked', false);\r\n    }\r\n\r\n    // Update control's map data and categories if a change\r\n    if(this.props.mapObject.mapCategories!==nextProps.mapObject.mapCategories && this.state.customCategoryControl) {\r\n      this.state.customCategoryControl.updateCategories(nextProps.mapObject.mapCategories);\r\n    }\r\n    if(!_.isEqual(nextProps.mapObject.mapData, this.props.mapObject.mapData) && this.state.customCategoryControl) {\r\n      this.state.customCategoryControl.updateMapData(nextProps.mapObject.mapData);\r\n    }\r\n\r\n    if($('.mapboxgl-popup').length>0) {\r\n      console.log(this.props.mapObject)\r\n      console.log($('.mapboxgl-popup').length);\r\n      var that = this;\r\n      $('.mapboxgl-popup').each(function() {\r\n        $(this).find('.mapboxgl-popup-content').css('background-color',that.props.mapObject.popupStyle.backgroundColor)\r\n          $(this).find('.mapboxgl-popup-content').css('border-color',that.props.mapObject.popupStyle.borderColor)\r\n        $(this).find('.mapboxgl-popup-tip').css('border-top-color',that.props.mapObject.popupStyle.backgroundColor)\r\n      })\r\n    }\r\n\r\n    // Set currently selected geometry popup\r\n    if(nextProps.mapActions.selectGeometry&&nextProps.mapActions.selectGeometry!==this.props.mapActions.selectGeometry) {\r\n        var popup = new mapboxgl.Popup({\r\n          offset : 20\r\n        })\r\n        var thisFeature = false;\r\n        nextProps.mapObject.mapData.forEach(function(feature) {\r\n          if(feature.id===nextProps.mapActions.selectGeometry) {\r\n            thisFeature = feature;\r\n          }\r\n        });\r\n\r\n        if(this.state.popup) {\r\n          this.state.popup.remove();\r\n        }\r\n\r\n        if(thisFeature && thisFeature.geometry.type==='Point') {\r\n          let popupHTML =\r\n            '<div>'+\r\n              '<div>'+thisFeature.properties.description+'</div>'+\r\n              '<div style=\"display:flex;margin-left:-7px;position:absolute;margin-top:50px;\">'+\r\n                '<button id=\"changePopupContent\" class=\"button\" data-featureid=\"'+thisFeature.id+'\"><i class=\"dashicons dashicons-edit\"></i></button>'+ '<br>' +\r\n                '<button id=\"deleteFeatureFromPopup\" class=\"button\" data-featureid=\"'+thisFeature.id+'\"><i class=\"dashicons dashicons-trash\"></i></button>'+\r\n              '</div>'+\r\n            '</div>';\r\n\r\n          popup.setLngLat({lat: thisFeature.geometry.coordinates[1], lng: thisFeature.geometry.coordinates[0]})\r\n            .setHTML(popupHTML).addTo(map);\r\n\r\n          this.setState({popup});\r\n      }\r\n    }\r\n\r\n    // Handling custom map creation and editing\r\n    if(nextProps.mapObject.mapType==='custom'&&(flag==='load'||(!_.isEqual(nextProps.mapObject.mapData,this.props.mapObject.mapData)&&nextProps.mapObject.mapData.length>0))) {\r\n      // Update current open popup\r\n      if(this.state.popup&&this.state.popup.isOpen()) {\r\n        this.state.popup.remove();\r\n        var thisFeature = false;\r\n        nextProps.mapObject.mapData.forEach(function(feature) {\r\n          if(feature.id===nextProps.mapActions.selectGeometry) {\r\n            thisFeature = feature;\r\n          }\r\n        });\r\n        var popup = new mapboxgl.Popup({\r\n          offset : 20\r\n        });\r\n        if (thisFeature && thisFeature.geometry.type==='Point') {\r\n          let popupHTML =\r\n              '<div>'+\r\n                '<div>'+thisFeature.properties.description+'</div>'+\r\n                '<div style=\"display:flex;margin-left:-7px;position:absolute;margin-top:50px;\">'+\r\n                  '<button id=\"changePopupContent\" class=\"button\" data-featureid=\"'+thisFeature.id+'\"><i class=\"dashicons dashicons-edit\"></i></button>'+ '<br>' +\r\n                  '<button id=\"deleteFeatureFromPopup\" class=\"button\" data-featureid=\"'+thisFeature.id+'\"><i class=\"dashicons dashicons-trash\"></i></button>'+\r\n                '</div>'+\r\n              '</div>';\r\n\r\n          popup.setLngLat({lat: thisFeature.geometry.coordinates[1], lng: thisFeature.geometry.coordinates[0]})\r\n            .setHTML(popupHTML).addTo(map);\r\n\r\n          this.setState({popup})\r\n        }\r\n      }\r\n      // Loop and add or modify data\r\n      // console.log(nextProps.mapObject.mapData)\r\n      nextProps.mapObject.mapData.forEach(function(feature,index) {\r\n        var featureCollection = {\r\n          \"type\" : \"FeatureCollection\",\r\n          \"features\" : [feature]\r\n        }\r\n        // console.log(feature);\r\n        // If only a marker icon or color or anchor has changed\r\n        if(map.getSource(feature.id) && typeof this.props.mapObject.mapData[index] !== 'undefined' && (feature.properties.marker_icon_anchor!==this.props.mapObject.mapData[index].properties.marker_icon_anchor||feature.properties.marker_icon_url!==this.props.mapObject.mapData[index].properties.marker_icon_url||feature.properties.color!==this.props.mapObject.mapData[index].properties.color ||feature.properties.base_height !==this.props.mapObject.mapData[index].properties.base_height ||feature.properties.height !==this.props.mapObject.mapData[index].properties.height  || feature.properties.opacity !== this.props.mapObject.mapData[index].properties.opacity || feature.properties.rgb !== this.props.mapObject.mapData[index].properties.rgb)) {\r\n          if(typeof feature.properties.opacity === 'undefined') {\r\n            feature.properties.opacity = 0.4;\r\n          }\r\n          if(feature.geometry.type==='Point') {\r\n            var canvas = document.getElementById('wp_mapbox_gl_js_canvas_stage');\r\n            var ctx = canvas.getContext('2d');\r\n            var img  = document.getElementById('wp_mapbox_gl_js_canvas_img');\r\n            if(!map.hasImage(feature.properties.marker_icon_url)) {\r\n              img.onload = function() {\r\n                canvas.width  = img.width;\r\n                canvas.height = img.height;\r\n                ctx.drawImage(img, 0, 0, img.width, img.height);\r\n                map.addImage(feature.properties.marker_icon_url, ctx.getImageData(0, 0, img.width, img.height) );\r\n                map.setLayoutProperty(feature.id,'icon-image',feature.properties.marker_icon_url)\r\n                map.setLayoutProperty(feature.id,'icon-anchor',feature.properties.marker_icon_anchor)\r\n              };\r\n              img.src = feature.properties.marker_icon_url.split('-wp_mapbox_gl_js_sizing-')[0];\r\n            } else {\r\n              map.setLayoutProperty(feature.id,'icon-image',feature.properties.marker_icon_url)\r\n              map.setLayoutProperty(feature.id,'icon-anchor',feature.properties.marker_icon_anchor)\r\n            }\r\n            if(nextProps.mapObject.controls.clusterMarkers) {\r\n              map.setPaintProperty(feature.id,'icon-opacity',0)\r\n            }\r\n          }\r\n          if(feature.geometry.type==='Polygon') {\r\n            if (feature.fillType === 'extrusion') {\r\n              if (typeof feature.properties.height === 'string' || typeof feature.properties.base_height === 'string') {\r\n                feature.properties.height = parseInt(feature.properties.height);\r\n                feature.properties.base_height = parseInt(feature.properties.base_height);\r\n              }\r\n\r\n              map.setPaintProperty(feature.id, 'fill-extrusion-height', feature.properties.height);\r\n              map.setPaintProperty(feature.id, 'fill-extrusion-base', feature.properties.base_height);\r\n              map.setPaintProperty(feature.id, 'fill-extrusion-color', feature.properties.color);\r\n              map.setPaintProperty(feature.id, 'fill-extrusion-opacity', feature.properties.opacity);\r\n            } else {\r\n              map.setPaintProperty(feature.id, 'fill-color',feature.properties.color)\r\n              map.setPaintProperty(feature.id, 'fill-opacity',feature.properties.opacity)\r\n            }\r\n          }\r\n          if(feature.geometry.type==='LineString') {\r\n            map.setPaintProperty(feature.id,'line-color',feature.properties.color)\r\n            map.setPaintProperty(feature.id,'line-opacity',feature.properties.opacity)\r\n          }\r\n        }\r\n\r\n        if(typeof map.getSource(feature.id)==='undefined') {\r\n          if(typeof feature.properties.opacity === 'undefined') {\r\n            feature.properties.opacity = 0.4;\r\n          }\r\n          map.addSource(feature.id, {\r\n            \"type\": \"geojson\",\r\n            \"data\": featureCollection\r\n          });\r\n          if(feature.geometry.type==='Point') {\r\n            // Add the icon image, then add layer\r\n            if(this.state.loadedIcons.indexOf(feature.properties.marker_icon_url)===-1 && !map.hasImage(feature.properties.marker_icon_url)) {\r\n              // This prevents from ignoring icon on quick first load\r\n              var loadedIcons = JSON.parse(JSON.stringify(this.state.loadedIcons));\r\n              loadedIcons.push(feature.properties.marker_icon_url);\r\n              this.setState({loadedIcons});\r\n\r\n              var canvas = document.getElementById('wp_mapbox_gl_js_canvas_stage');\r\n              var ctx = canvas.getContext('2d');\r\n              var img = document.getElementById('wp_mapbox_gl_js_canvas_img_stage');\r\n              img.onload = function() {\r\n    