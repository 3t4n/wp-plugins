.current-rates{background:#fff;color:#000;margin:0 auto;max-width:600px}.current-rates th{background:#aaa;color:#fff;padding:.25em 1em}.current-rates td{padding:.25em 1em;text-align:center}.current-rates td:first-of-type{font-weight:700}.current-rates td span{position:relative}.current-rates td span:after{content:"";display:block;height:12px;left:-20px;position:absolute;top:7px;width:15px}.current-rates td span.diff-arrow-up{color:#0f6e0f}.current-rates td span.diff-arrow-up:after{background-image:url(data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIxNiIgaGVpZ2h0PSIxNiIgZmlsbD0ibm9uZSI+PHBhdGggc3Ryb2tlPSIjMEJDNDY2IiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiIGQ9Im0yIDExLjUgMy44NzYtMy45NyAyLjY5MyAyLjUyNEwxMy45NTUgNC41TTkuNSA0LjVIMTRWOSIvPjwvc3ZnPg==)}.current-rates td span.diff-arrow-down{color:red}.current-rates td span.diff-arrow-down:after{background:url(data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIxNiIgaGVpZ2h0PSIxNiIgZmlsbD0ibm9uZSI+PHBhdGggc3Ryb2tlPSIjRjczRTRBIiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiIGQ9Im0yIDUgMy44NzYgMy45NyAyLjY5My0yLjUyNUwxMy45NTUgMTJNOS41IDEySDE0VjcuNSIvPjwvc3ZnPg==);left:-21px}.current-rates tr:nth-child(odd){background:#eee}
