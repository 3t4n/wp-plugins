/**
 * The following styles get applied both on the front of your site
 * and in the editor.
 *
 * Replace them with your own styles or remove the file completely.
 */

.current-rates {
	max-width: 600px;
    margin: 0 auto;
	background: #fff;
	color: #000;
	th {
		background: #aaa;
		color: #fff;
		padding: .25em 1em;
	}
	td{
		text-align: center;
		padding: .25em 1em;
		&:nth-of-type(1){
			font-weight: bold;
		}
		span{
			position: relative;
			&:after{
				content: "";
				display: block;
				height: 12px;
				left: -20px;
				position: absolute;
				top: 7px;
				width: 15px;
				}
			&.diff-arrow-up{
				color: #0f6e0f;
				&::after{
					background-image: url("data:image/svg+xml;base64,");
				}
			}
			&.diff-arrow-down{
				color: #ff0000;
				&::after{
					left: -21px;
					background: url("data:image/svg+xml;base64,");
				}
				
			}
		}
	}
	tr:nth-child(odd){
		background: #eee;
	}
}
