.sc-generator{width:100%;height:600px;display:flex;flex-direction:row;font-family:Roboto,sans-serif}.sc-generator-sidebar{width:350px;padding-right:16px;max-width:100%;position:relative;border-right:1px solid #f7f7f7}.sc-generator-sidebar .required-message{background-color:rgba(218,0,46,.2);padding:10px 18px;border-radius:5px;margin-bottom:15px;height:40px;transition:height .3s ease}.sc-generator-sidebar .required-message.out{padding:0 18px;margin-bottom:0;height:0;overflow:hidden}.sc-generator-sidebar .required-message span{color:#da002e;margin-left:.5rem}.sc-generator-sidebar .react-autosuggest__container,.sr-generator-sidebar .react-autosuggest__container{position:relative}.sc-generator-sidebar__search{width:334px;padding:12px 16px;font-size:14px;outline:none;border:none;background:#ebebeb;border-radius:3px}.sc-generator-sidebar-selected{margin-top:16px;padding-top:16px;border-top:1px solid #f7f7f7}.sc-generator-sidebar-selected__details{display:block;width:100%;padding:8px 16px;font-size:14px;text-align:left;background:#bfe5ff;border-radius:3px}.sc-generator-control label.required:after{content:"*";color:red;margin-left:8px}.sc-generator-sidebar-results{width:334px;max-height:250px;border-radius:3px;border:none;box-shadow:0 0 6px -1px #b3b3b3;z-index:100;position:absolute;top:40px;left:0;overflow-y:auto;background:#fff;-webkit-box-shadow:0 0 6px -1px #b3b3b3;-moz-box-shadow:0 0 6px -1px #b3b3b3}.sc-generator-sidebar-results ul{padding:0;margin:0;list-style:none}.react-autosuggest__suggestion{padding:8px 16px;font-size:14px;cursor:pointer;-webkit-user-select:none;-ms-user-select:none;user-select:none}.react-autosuggest__suggestion--highlighted,.react-autosuggest__suggestion:focus,.react-autosuggest__suggestion:hover{background:#bfe5ff}.sc-generator-container{width:650px;height:100%;max-width:100%;display:flex;flex-direction:column;flex-grow:1;padding:16px;overflow-y:auto}.sc-generator-options{width:100%;height:532px;border-top:2px solid #f7f7f7;overflow-y:auto;padding:8px;margin-top:16px}.sc-generator-control{width:100%;margin-top:12px}.sc-generator-preview .webapp-preview__img{width:100%}.sc-generator-control__label{width:100%;font-size:14px}.sc-generator-control__input{border:1px solid #bbb;border-radius:3px;outline:none;padding:8px}.sc-generator-control__input,.sc-generator-control__select{width:100%;margin-top:4px;font-size:14px}.sc-generator-control__input--check{width:auto;cursor:pointer}.sc-generator-preview{width:100%;height:500px;overflow-y:auto;padding:32px}.sc-generator-output{width:100%}.sc-generator-output__alert{position:absolute;top:0;left:0;display:flex;align-items:center;justify-content:center;width:100%;height:100%;background:rgba(191,229,255,.6);border-radius:8px}.sc-generator-output__copy{border:none;background:transparent;color:#09f;display:block;margin-bottom:16px;padding:0;outline:none;cursor:pointer}.sc-generator-output__source{position:relative;width:100%;margin-top:8px;background:#f8f8f8;padding:24px;border-radius:8px;border:none;resize:none;cursor:pointer}.sc-generator-empty{width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:18px}.sc-generator-empty span{font-size:40px;color:#ff8200}.sc-generator-options::-webkit-scrollbar{width:8px;height:8px}.sc-generator-options::-webkit-scrollbar-button{width:0;height:0}.sc-generator-options::-webkit-scrollbar-thumb{background:#e1e1e1;border:0 #fff;border-radius:50px}.sc-generator-options::-webkit-scrollbar-thumb:active,.sc-generator-options::-webkit-scrollbar-thumb:hover{background:#ababab}.sc-generator-options::-webkit-scrollbar-track{background:#fff;border:0 #fff;border-radius:49px}.sc-generator-options::-webkit-scrollbar-track:active,.sc-generator-options::-webkit-scrollbar-track:hover{background:#fff}.sc-generator-options::-webkit-scrollbar-corner{background:transparent}.sc-generator-sidebar-results::-webkit-scrollbar{width:8px;height:8px}.sc-generator-sidebar-results::-webkit-scrollbar-button{width:0;height:0}.sc-generator-sidebar-results::-webkit-scrollbar-thumb{background:#e1e1e1;border:0 #fff;border-radius:50px}.sc-generator-sidebar-results::-webkit-scrollbar-thumb:active,.sc-generator-sidebar-results::-webkit-scrollbar-thumb:hover{background:#ababab}.sc-generator-sidebar-results::-webkit-scrollbar-track{background:#fff;border:0 #fff;border-radius:49px}.sc-generator-sidebar-results::-webkit-scrollbar-track:active,.sc-generator-sidebar-results::-webkit-scrollbar-track:hover{background:#fff}.sc-generator-sidebar-results::-webkit-scrollbar-corner{background:transparent}.sc-generator,.sc-generator *{box-sizing:border-box}.sc-generator .arc-en-ciel img{width:100%}
