{"version":3,"sources":["webpack://src/components/ShortcodeGenerator/styles.css","webpack://src/index.css"],"names":[],"mappings":"AAAA,cACI,UAAW,CACX,YAAa,CACb,YAAa,CACb,kBAAmB,CACnB,6BACJ,CAGA,sBACI,WAAY,CACZ,kBAAmB,CACnB,cAAe,CACf,iBAAkB,CAClB,8BACJ,CAEA,wCACI,kCAAsC,CACtC,iBAAkB,CAClB,iBAAkB,CAClB,kBAAmB,CACnB,WAAY,CACZ,0BACJ,CAEA,4CACI,cAAe,CACf,eAAgB,CAChB,QAAS,CACT,eACJ,CAEA,6CACI,aAAc,CACd,iBACJ,CAMA,wGACI,iBACJ,CAEA,8BACI,WAAY,CACZ,iBAAkB,CAClB,cAAe,CACf,YAAa,CACb,WAAY,CACZ,kBAAmB,CACnB,iBACJ,CAEA,+BACI,eAAgB,CAChB,gBAAiB,CACjB,4BACJ,CAEA,wCACI,aAAc,CACd,UAAW,CACX,gBAAiB,CACjB,cAAe,CACf,eAAgB,CAChB,kBAAmB,CACnB,iBACJ,CAEA,2CACI,WAAY,CACZ,SAAU,CACV,eACJ,CAEA,8BACI,WAAY,CACZ,gBAAiB,CACjB,iBAAkB,CAClB,WAAY,CACZ,+BAAmD,CACnD,WAAY,CACZ,iBAAkB,CAClB,QAAS,CACT,MAAO,CACP,eAAgB,CAChB,eAAiB,CACjB,uCAA2D,CAC3D,oCACJ,CAEA,iCACI,SAAU,CACV,QAAS,CACT,eACJ,CAEA,+BACI,gBAAiB,CACjB,cAAe,CACf,cAAe,CACf,wBAAiB,CAAjB,oBAAiB,CAAjB,gBACJ,CAEA,sHAGI,kBACJ,CAKA,wBACI,WAAY,CACZ,WAAY,CACZ,cAAe,CACf,YAAa,CACb,qBAAsB,CACtB,WAAY,CACZ,YAAa,CACb,eACJ,CAEA,sBACI,UAAW,CACX,YAAa,CACb,4BAA6B,CAC7B,eAAgB,CAChB,WAAY,CACZ,eACJ,CAEA,sBACI,UAAW,CACX,eACJ,CAEA,2CACI,UACJ,CAEA,6BACI,UAAW,CACX,cACJ,CAEA,6BAEI,qBAAyB,CACzB,iBAAkB,CAClB,YAAa,CAEb,WAEJ,CAEA,2DATI,UAAW,CAIX,cAAe,CAEf,cAOJ,CAEA,oCACI,UAAW,CACX,cACJ,CAEA,sBACI,UAAW,CACX,YAAa,CACb,eAAgB,CAChB,YACJ,CAEA,qBACI,UACJ,CAEA,4BACI,iBAAkB,CAClB,KAAM,CACN,MAAO,CACP,YAAa,CACb,kBAAmB,CACnB,sBAAuB,CACvB,UAAW,CACX,WAAY,CACZ,+BAAoC,CACpC,iBACJ,CAEA,2BACI,WAAY,CACZ,sBAAuB,CACvB,UAAc,CACd,aAAc,CACd,kBAAmB,CACnB,SAAU,CACV,YAAa,CACb,cACJ,CAEA,6BACI,iBAAkB,CAClB,UAAW,CACX,cAAe,CACf,kBAAmB,CACnB,YAAa,CACb,iBAAkB,CAClB,WAAY,CACZ,WAAY,CACZ,cACJ,CAEA,oBACI,UAAW,CACX,WAAY,CACZ,YAAa,CACb,qBAAsB,CACtB,kBAAmB,CACnB,sBAAuB,CACvB,cACJ,CAEA,yBACI,cAAe,CACf,aACJ,CAKA,yCACI,SAAU,CACV,UACJ,CAEA,gDACI,OAAU,CACV,QACJ,CAEA,+CACI,kBAAmB,CACnB,aAAwB,CACxB,kBACJ,CAMA,2GACI,kBACJ,CAEA,+CACI,eAAmB,CACnB,aAAwB,CACxB,kBACJ,CAMA,2GACI,eACJ,CAEA,gDACI,sBACJ,CAEA,iDACI,SAAU,CACV,UACJ,CAEA,wDACI,OAAU,CACV,QACJ,CAEA,uDACI,kBAAmB,CACnB,aAAwB,CACxB,kBACJ,CAMA,2HACI,kBACJ,CAEA,uDACI,eAAmB,CACnB,aAAwB,CACxB,kBACJ,CAMA,2HACI,eACJ,CAEA,wDACI,sBACJ,CC9TA,8BACI,qBACJ,CAEA,+BACI,UACJ","file":"kiosque-builder-apps.css","sourcesContent":[".sc-generator {\n    width: 100%;\n    height: 600px;\n    display: flex;\n    flex-direction: row;\n    font-family: Roboto, sans-serif;\n}\n\n/* Search */\n.sc-generator-sidebar {\n    width: 350px;\n    padding-right: 16px;\n    max-width: 100%;\n    position: relative;\n    border-right: 1px solid #f7f7f7;\n}\n\n.sc-generator-sidebar .required-message {\n    background-color: rgba(218, 0, 46, .2);\n    padding: 10px 18px;\n    border-radius: 5px;\n    margin-bottom: 15px;\n    height: 40px;\n    transition: height .3s ease;\n}\n\n.sc-generator-sidebar .required-message.out {\n    padding: 0 18px;\n    margin-bottom: 0;\n    height: 0;\n    overflow: hidden;\n}\n\n.sc-generator-sidebar .required-message span {\n    color: #da002e;\n    margin-left: 0.5rem;\n}\n\n.sr-generator-sidebar .react-autosuggest__container {\n    position: relative;\n}\n\n.sc-generator-sidebar .react-autosuggest__container {\n    position: relative;\n}\n\n.sc-generator-sidebar__search {\n    width: 334px;\n    padding: 12px 16px;\n    font-size: 14px;\n    outline: none;\n    border: none;\n    background: #ebebeb;\n    border-radius: 3px;\n}\n\n.sc-generator-sidebar-selected {\n    margin-top: 16px;\n    padding-top: 16px;\n    border-top: 1px solid #f7f7f7;\n}\n\n.sc-generator-sidebar-selected__details {\n    display: block;\n    width: 100%;\n    padding: 8px 16px;\n    font-size: 14px;\n    text-align: left;\n    background: #bfe5ff;\n    border-radius: 3px;\n}\n\n.sc-generator-control label.required:after {\n    content: \"*\";\n    color: red;\n    margin-left: 8px;\n}\n\n.sc-generator-sidebar-results {\n    width: 334px;\n    max-height: 250px;\n    border-radius: 3px;\n    border: none;\n    box-shadow: 0px 0px 6px -1px rgba(179, 179, 179, 1);\n    z-index: 100;\n    position: absolute;\n    top: 40px;\n    left: 0;\n    overflow-y: auto;\n    background: white;\n    -webkit-box-shadow: 0px 0px 6px -1px rgba(179, 179, 179, 1);\n    -moz-box-shadow: 0px 0px 6px -1px rgba(179, 179, 179, 1);\n}\n\n.sc-generator-sidebar-results ul {\n    padding: 0;\n    margin: 0;\n    list-style: none;\n}\n\n.react-autosuggest__suggestion {\n    padding: 8px 16px;\n    font-size: 14px;\n    cursor: pointer;\n    user-select: none;\n}\n\n.react-autosuggest__suggestion:hover,\n.react-autosuggest__suggestion:focus,\n.react-autosuggest__suggestion--highlighted {\n    background: #bfe5ff;\n}\n\n/* End of Search*/\n\n/* Preview */\n.sc-generator-container {\n    width: 650px;\n    height: 100%;\n    max-width: 100%;\n    display: flex;\n    flex-direction: column;\n    flex-grow: 1;\n    padding: 16px;\n    overflow-y: auto;\n}\n\n.sc-generator-options {\n    width: 100%;\n    height: 532px;\n    border-top: 2px solid #f7f7f7;\n    overflow-y: auto;\n    padding: 8px;\n    margin-top: 16px;\n}\n\n.sc-generator-control {\n    width: 100%;\n    margin-top: 12px;\n}\n\n.sc-generator-preview .webapp-preview__img {\n    width: 100%;\n}\n\n.sc-generator-control__label {\n    width: 100%;\n    font-size: 14px;\n}\n\n.sc-generator-control__input {\n    width: 100%;\n    border: 1px solid #bbbbbb;\n    border-radius: 3px;\n    outline: none;\n    margin-top: 4px;\n    padding: 8px;\n    font-size: 14px;\n}\n\n.sc-generator-control__select {\n    width: 100%;\n    font-size: 14px;\n    margin-top: 4px;\n}\n\n.sc-generator-control__input--check {\n    width: auto;\n    cursor: pointer;\n}\n\n.sc-generator-preview {\n    width: 100%;\n    height: 500px;\n    overflow-y: auto;\n    padding: 32px;\n}\n\n.sc-generator-output {\n    width: 100%;\n}\n\n.sc-generator-output__alert {\n    position: absolute;\n    top: 0;\n    left: 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 100%;\n    height: 100%;\n    background: rgba(191, 229, 255, 0.6);\n    border-radius: 8px;\n}\n\n.sc-generator-output__copy {\n    border: none;\n    background: transparent;\n    color: #0099ff;\n    display: block;\n    margin-bottom: 16px;\n    padding: 0;\n    outline: none;\n    cursor: pointer;\n}\n\n.sc-generator-output__source {\n    position: relative;\n    width: 100%;\n    margin-top: 8px;\n    background: #f8f8f8;\n    padding: 24px;\n    border-radius: 8px;\n    border: none;\n    resize: none;\n    cursor: pointer;\n}\n\n.sc-generator-empty {\n    width: 100%;\n    height: 100%;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    font-size: 18px;\n}\n\n.sc-generator-empty span {\n    font-size: 40px;\n    color: #ff8200;\n}\n\n/* End of Preview */\n\n/* Sidebars */\n.sc-generator-options::-webkit-scrollbar {\n    width: 8px;\n    height: 8px;\n}\n\n.sc-generator-options::-webkit-scrollbar-button {\n    width: 0px;\n    height: 0px;\n}\n\n.sc-generator-options::-webkit-scrollbar-thumb {\n    background: #e1e1e1;\n    border: 0px none #ffffff;\n    border-radius: 50px;\n}\n\n.sc-generator-options::-webkit-scrollbar-thumb:hover {\n    background: #ababab;\n}\n\n.sc-generator-options::-webkit-scrollbar-thumb:active {\n    background: #ababab;\n}\n\n.sc-generator-options::-webkit-scrollbar-track {\n    background: #ffffff;\n    border: 0px none #ffffff;\n    border-radius: 49px;\n}\n\n.sc-generator-options::-webkit-scrollbar-track:hover {\n    background: #ffffff;\n}\n\n.sc-generator-options::-webkit-scrollbar-track:active {\n    background: #ffffff;\n}\n\n.sc-generator-options::-webkit-scrollbar-corner {\n    background: transparent;\n}\n\n.sc-generator-sidebar-results::-webkit-scrollbar {\n    width: 8px;\n    height: 8px;\n}\n\n.sc-generator-sidebar-results::-webkit-scrollbar-button {\n    width: 0px;\n    height: 0px;\n}\n\n.sc-generator-sidebar-results::-webkit-scrollbar-thumb {\n    background: #e1e1e1;\n    border: 0px none #ffffff;\n    border-radius: 50px;\n}\n\n.sc-generator-sidebar-results::-webkit-scrollbar-thumb:hover {\n    background: #ababab;\n}\n\n.sc-generator-sidebar-results::-webkit-scrollbar-thumb:active {\n    background: #ababab;\n}\n\n.sc-generator-sidebar-results::-webkit-scrollbar-track {\n    background: #ffffff;\n    border: 0px none #ffffff;\n    border-radius: 49px;\n}\n\n.sc-generator-sidebar-results::-webkit-scrollbar-track:hover {\n    background: #ffffff;\n}\n\n.sc-generator-sidebar-results::-webkit-scrollbar-track:active {\n    background: #ffffff;\n}\n\n.sc-generator-sidebar-results::-webkit-scrollbar-corner {\n    background: transparent;\n}\n",".sc-generator, .sc-generator *  {\n    box-sizing: border-box;\n}\n\n.sc-generator .arc-en-ciel img {\n    width: 100%;\n}\n"]}