  },\n  {\n    name: 'Classes List',\n    module: 'classes',\n    action: 'classes-list',\n    description: '',\n    code: 'aec_classes_list',\n    params: [\n      { name: 'id-etablishment-branch', required: false },\n      { name: 'id-period', required: false },\n      { name: 'id-classification', required: false },\n      { name: 'id-subject', required: false },\n      { name: 'id-main-level', required: false },\n      { name: 'id-class-type', required: false },\n      { name: 'level-id', required: false },\n      { name: 'id-class-format', required: false },\n      { name: 'location', required: false },\n      { name: 'show-all-establishment', required: false }\n    ]\n  },\n  {\n    name: 'Courses Selection Tiles',\n    module: 'classes',\n    action: 'courses-selection-tiles',\n    description: '',\n    code: 'aec_courses_selection_tiles',\n    params: [\n      { name: 'etablishment-branch-id', required: false },\n      { name: 'period-id', required: false },\n      { name: 'classification-id', required: true },\n      { name: 'subject-id', required: false },\n      { name: 'main-level', required: false },\n      { name: 'class-type-id', required: true },\n      { name: 'levels-to-filter-by', required: false },\n      { name: 'localization', required: false },\n      { name: 'class-format-id', required: false },\n      { name: 'show-filter-choices', required: false },\n      { name: 'show-all-establishment', required: false }\n    ]\n  },\n  {\n    name: 'Courses Catalog',\n    module: 'classes',\n    action: 'courses-catalog',\n    description: '',\n    code: 'aec_courses_catalog',\n    params: [\n      { name: 'etablishment-branch-id', required: false },\n      { name: 'period-id', required: false },\n      { name: 'classification-id', required: false },\n      { name: 'subject-id', required: false },\n      { name: 'class-type-id', required: false },\n      { name: 'level-id', required: false },\n      { name: 'class-format-id', required: false },\n      { name: 'localization', required: false },\n      { name: 'sidebar', required: false },\n      { name: 'show-filter-choices', required: false },\n      { name: 'show-all-establishment', required: false }\n    ]\n  },\n  {\n    name: 'Classes Search Box',\n    module: 'classes',\n    action: 'courses-search-bar',\n    description: '',\n    code: 'aec_classes_search_box',\n    params: [\n      { name: 'default-url', required: false },\n      { name: 'show-all-establishment', required: false }\n    ]\n  },\n  {\n    name: 'Shopping Cart',\n    module: 'cart',\n    action: 'cart-form',\n    description: '',\n    code: 'aec_shopping_cart',\n    params: []\n  },\n  {\n    name: 'Exam Type List',\n    module: 'examination',\n    action: 'examination-type-list',\n    description: '',\n    code: 'aec_examination_type_list',\n    params: [\n      { name: 'examination-type-ids', required: false },\n      { name: 'etablishment-branch-id', required: false, type: 'select' },\n      { name: 'period-ids', required: false }\n    ]\n  },\n  {\n    name: 'Exam Type Detail',\n    module: 'examination',\n    action: 'examination-type-detail',\n    description: '',\n    code: 'aec_examination_type_detail',\n    params: [\n      { name: 'examination-type-id', required: false },\n      { name: 'etablishment-branch-id', required: false }\n    ]\n  },\n  {\n    name: 'Exam Detail',\n    module: 'examination',\n    action: 'examination-detail',\n    description: '',\n    code: 'aec_examination_detail',\n    params: [\n      { name: 'examination-id', required: false }\n    ]\n  },\n  {\n    name: 'Newsletter',\n    module: 'newsletter',\n    action: 'subscribe-form',\n    description: '',\n    code: 'aec_newsletter',\n    params: []\n  },\n  {\n    name: 'Unsubscribe Newsletter',\n    module: 'newsletter',\n    action: 'unsubscribe-form',\n    description: '',\n    code: 'aec_unsubscribe_newsletter',\n    params: []\n  }\n];\n\nexport const formInputs = [\n  {\n    label: 'Establishment',\n    id: 'etablishment-branch',\n    params: ['id-etablishment-branch', 'etablishment-branch-id'],\n    type: 'multiple',\n    dataName: 'establishments'\n  },\n  {\n    label: 'Establishment',\n    id: 'etablishment-branch',\n    params: ['etablishment-branch-id'],\n    type: 'select',\n    dataName: 'establishments'\n  },\n  {\n    label: 'Classifications',\n    id: 'classification',\n    params: ['id-classification', 'classification-id'],\n    type: 'multiple',\n    dataName: 'classifications'\n  },\n  {\n    label: 'Class Types',\n    id: 'class-type',\n    params: ['id-class-type', 'class-type-id', 'class-types-to-filter-by'],\n    type: 'multiple',\n    dataName: 'classTypes'\n  },\n  {\n    label: 'Examination Types',\n    id: 'examination-types',\n    params: ['examination-type-ids'],\n    type: 'multiple',\n    dataName: 'examinationTypes'\n  },\n  {\n    label: 'Main Level',\n    id: 'main-level',\n    params: ['id-main-level', 'main-level'],\n    type: 'multiple',\n    dataName: 'mainLevels'\n  },\n  {\n    label: 'Level',\n    id: 'level',\n    params: ['id-level', 'level-id', 'levels-to-filter-by'],\n    type: 'multiple',\n    dataName: 'levels'\n  },\n  {\n    label: 'Subject',\n    id: 'subject',\n    params: ['id-subject', 'subject-id'],\n    type: 'select',\n    dataName: 'subjects'\n  },\n  {\n    label: 'Class Format',\n    id: 'classFormat',\n    params: ['id-class-format', 'class-format-id'],\n    type: 'select',\n    dataName: 'classFormats'\n  },\n  {\n    label: 'Event Type',\n    id: 'event-type',\n    params: ['event-type'],\n    type: 'select',\n    dataName: 'eventTypes'\n  },\n  {\n    label: 'Event Tags',\n    id: 'event-tag-ids',\n    params: ['event-tag-ids'],\n    type: 'multiple',\n    dataName: 'eventTags',\n    requiredVersion: '2024.3'\n  },\n  {\n    label: 'Product Type',\n    id: 'product-type',\n    params: ['product-type', 'product-type-id'],\n    type: 'select',\n    dataName: 'products'\n  },\n  {\n    label: 'Private Product Type',\n    id: 'private-product-type-id',\n    params: ['product-type-id'],\n    type: 'select',\n    dataName: 'privateType'\n  },\n  {\n    label: 'Donation Type',\n    id: 'donation-product-type-ids',\n    params: ['product-type-ids'],\n    type: 'multiple',\n    dataName: 'donationType'\n  },\n  {\n    label: 'Donation Type',\n    id: 'donation-product-type-id',\n    params: ['product-type-id'],\n    type: 'select',\n    dataName: 'donationType'\n  },\n  {\n    label: 'Event',\n    id: 'event-id',\n    params: ['event-id'],\n    type: 'select',\n    dataName: 'events'\n  },\n  {\n    label: 'Period',\n    id: 'period',\n    params: ['id-period', 'period-id', 'period-ids'],\n    type: 'multiple',\n    dataName: 'periods'\n  },\n  {\n    label: 'Events URL',\n    id: 'event-url',\n    params: ['detail_link'],\n    type: 'text'\n  },\n  {\n    label: 'Default URL',\n    id: 'default-url',\n    params: ['default-url'],\n    type: 'text'\n  },\n  {\n    label: 'Registration form container ID',\n    id: 'registration-form-container-id',\n    params: ['registration-form-container-id'],\n    type: 'text'\n  },\n  {\n    label: 'Height',\n    id: 'height',\n    params: ['height'],\n    type: 'text'\n  },\n  {\n    label: 'Width',\n    id: 'width',\n    params: ['image-width'],\n    type: 'text'\n  },\n  {\n    label: 'Address',\n    id: 'address',\n    params: ['address'],\n    type: 'text'\n  },\n  {\n    label: 'Marker Message',\n    id: 'marker-message',\n    params: ['marker-message'],\n    type: 'text'\n  },\n  {\n    label: 'Columns',\n    id: 'quantity-column',\n    params: ['quantity-column'],\n    type: 'number'\n  },\n  {\n    label: 'Events by row',\n    id: 'num-events-by-row',\n    params: ['num-events-by-row'],\n    type: 'number'\n  },\n  {\n    label: 'Custom Class',\n    id: 'class',\n    params: ['class'],\n    type: 'text'\n  },\n  {\n    label: 'Display Details',\n    id: 'display-details',\n    params: ['display-details'],\n    type: 'checkbox'\n  },\n  {\n    label: 'Display Filters',\n    id: 'show-filter-choices',\n    params: ['show-filter-choices'],\n    type: 'checkbox'\n  },\n  {\n    label: 'Display Sidebar',\n    id: 'sidebar',\n    params: ['sidebar'],\n    type: 'checkbox'\n  },\n  {\n    label: 'Display Category Title',\n    id: 'show-category-title',\n    params: ['show-category-title'],\n    type: 'checkbox'\n  },\n  {\n    label: 'Active tag',\n    id: 'tag-active',\n    params: ['tag-active'],\n    type: 'select',\n    dataName: 'tags'\n  },\n  {\n    label: 'Localization',\n    id: 'localization',\n    params: ['location', 'localization'],\n    type: 'select',\n    dataName: 'localizations'\n  },\n  {\n    label: 'Exam ID',\n    id: 'examination-id',\n    params: ['examination-id'],\n    type: 'number'\n  },\n  {\n    label: 'Examination Types',\n    id: 'examination-type-id',\n    params: ['examination-type-id'],\n    type: 'select',\n    dataName: 'examinationType'\n  },\n  {\n    label: 'Email To Unsubscribe',\n    id: 'email-to-unsubscribe',\n    params: ['email-to-unsubscribe'],\n    type: 'select',\n    dataName: 'email-to-unsubscribe'\n  },\n  {\n    label: 'Front Desk Account',\n    id: 'is-for-front-desk-account',\n    params: ['is-for-front-desk-account'],\n    type: 'checkbox'\n  },\n  {\n    label: 'Show all Establishment',\n    id: 'show-all-establishment',\n    params: ['show-all-establishment'],\n    type: 'checkboxYN'\n  },\n  {\n    label: 'Hide text',\n    id: 'hide-text',\n    params: ['hide-text'],\n    type: 'checkbox'\n  },\n  {\n    label: 'Default View Mode',\n    id: 'default-view-mode',\n    params: ['default-view-mode'],\n    type: 'select',\n    dataName: 'viewModes'\n  },\n  {\n    label: 'Course ID',\n    id: 'course-id',\n    params: ['course-id'],\n    type: 'number'\n  },\n  {\n    label: 'Show events',\n    id: 'events-to-show',\n    params: ['events-to-show'],\n    type: 'select',\n    dataName: 'eventsToShow',\n    requiredVersion: '2024.3'\n  },\n];\n","let keys = {\n  baseUrl: window.aecAppWPURL,\n  extranetUrl: window.aecExtranetURL,\n  apiToken: window.aecExtranetWebAppsAPIKey,\n  language: window.currentLanguage || 'en_US',\n  aecInstance: window.clientInstance,\n};\n\nexport default keys;\n","function _defineProperties(target, props) {\n  for (var i = 0; i < props.length; i++) {\n    var descriptor = props[i];\n    descriptor.enumerable = descriptor.enumerable || false;\n    descriptor.configurable = true;\n    if (\"value\" in descriptor) descriptor.writable = true;\n    Object.defineProperty(target, descriptor.key, descriptor);\n  }\n}\n\nexport default function _createClass(Constructor, protoProps, staticProps) {\n  if (protoProps) _defineProperties(Constructor.prototype, protoProps);\n  if (staticProps) _defineProperties(Constructor, staticProps);\n  return Constructor;\n}","export default function _classPrivateFieldBase(receiver, privateKey) {\n  if (!Object.prototype.hasOwnProperty.call(receiver, privateKey)) {\n    throw new TypeError(\"attempted to use private field on non-instance\");\n  }\n\n  return receiver;\n}","var id = 0;\nexport default function _classPrivateFieldKey(name) {\n  return \"__private_\" + id++ + \"_\" + name;\n}","export class YesNoHelper {\n    static #YES = 'Y';\n    static #NO = 'N';\n\n    static isYes(value) {\n        return value === YesNoHelper.#YES;\n    }\n\n    static isNo(value) {\n        return value === YesNoHelper.#NO;\n    }\n\n    static getYesNo(value) {\n        return value ? YesNoHelper.#YES : YesNoHelper.#NO;\n    }\n}\n","export default function _classCallCheck(instance, Constructor) {\n  if (!(instance instanceof Constructor)) {\n    throw new TypeError(\"Cannot call a class as a function\");\n  }\n}","const AEC_INSTANCE_INFO = window['AECClientInstanceInfo'];\nconst AEC_BUILD_VERSION = AEC_INSTANCE_INFO?.['version'] || '';\nconst IS_LOCAL = AEC_INSTANCE_INFO?.['isLocal'] === '1';\nconst ALLOWED_VERSION = new Set(['review', 'master', 'evolution']);\n\nconst isVersionAllowed = (requiredVersion) => IS_LOCAL || ALLOWED_VERSION.has(AEC_BUILD_VERSION) || (AEC_BUILD_VERSION.localeCompare(requiredVersion) >= 0);\n\nexport default {isVersionAllowed};\n","import './styles.css';\n\nimport React, {useState, useEffect, useRef, Fragment} from 'react';\nimport axios from 'axios';\nimport Select from 'react-select';\nimport {CopyToClipboard} from 'react-copy-to-clipboard';\nimport {FontAwesomeIcon} from '@fortawesome/react-fontawesome';\nimport {faCopy} from '@fortawesome/free-regular-svg-icons';\nimport {faCubes} from '@fortawesome/free-solid-svg-icons';\nimport {\n    components,\n    formInputs,\n    classMainLevel,\n    identifyPanelTags,\n    classLocalizationsOptions,\n    defaultViewModeOptions,\n    eventsToShowOptions\n} from './constants';\nimport keys from '../../config/keys';\nimport {YesNoHelper} from \"../../utils/yesNo.helper\";\nimport AecClientInstanceInfo from \"./aec-client-instance-info\";\n\nfunction serializeValues(values) {\n    return values.join('|');\n}\n\nfunction generateOptions(events) {\n    let list, dates, options = [];\n\n    if (events) list = events.sort((a, b) => new Date(b.date) - new Date(a.date));\n\n    dates = list.map((i) => i.date.slice(0, 7));\n    dates = dates.filter((e, i, a) => a.indexOf(e) === i);\n    dates.forEach((date) =>\n        options.push({\n            title: date,\n            data: [],\n        })\n    );\n\n    list.forEach((item) => {\n        const index = options.findIndex((o) => o.title === item.date.slice(0, 7));\n        options[index] = {\n            ...options[index],\n            label: `${item.date.slice(8, -2)} - ${item.name}`,\n            value: item.id\n        }\n    });\n\n    return options;\n}\n\nexport function ShortcodeGenerator() {\n    const copyRef = useRef(null);\n    const [isFetching, setFetching] = useState(false);\n    const [isCopiedMessageActive, setIsCopiedMessageActive] = useState(false);\n    const [resources, setResources] = useState({});\n    const [selectedComponent, setSelectedComponent] = useState(null);\n    const [selectedComponentValues, setSelectedComponentValues] = useState([]);\n    const [requireParam, setRequireParam] = useState(false);\n\n    useEffect(() => {\n        const fetchData = async () => {\n            const requestHeader = {\n                'EXTRANET_URL': /(\\w+\\.extranet-aec.com)/.exec(keys.extranetUrl)[0],\n                'Content-Type': 'application/json',\n                API_KEY: keys.apiToken,\n            };\n            let newResources = {};\n\n            try {\n                setFetching(true);\n\n                const [\n                    {data: classifications},\n                    {data: classTypes},\n                    {data: levels},\n                    {data: subjects},\n                    {data: establishments},\n                    {data: periods},\n                    {data: products},\n                    {data: events},\n                    {data: eventTags},\n                    {data: examinationTypes},\n                    {data: classFormats},\n                ] = await Promise.all([\n                    axios.get(\n                        `${keys.baseUrl}private/wp-editor/v1/classes/classifications`,\n                        {\n                            headers: requestHeader,\n                        }\n                    ),\n                    axios.get(`${keys.baseUrl}private/wp-editor/v1/classes/types`, {\n                        headers: requestHeader,\n                    }),\n                    axios.get(`${keys.baseUrl}private/wp-editor/v1/classes/levels`, {\n                        headers: requestHeader,\n                    }),\n                    axios.get(`${keys.baseUrl}private/wp-editor/v1/classes/subjects`, {\n                        headers: requestHeader,\n                    }),\n                    axios.get(`${keys.baseUrl}private/wp-editor/v1/establishments`, {\n                        headers: requestHeader,\n                    }),\n                    axios.get(`${keys.baseUrl}private/wp-editor/v1/classes/periods`, {\n                        headers: requestHeader,\n                    }),\n                    axios.get(\n                        `${keys.baseUrl}private/wp-editor/v1/product/product_type`,\n                        {\n                            headers: requestHeader,\n                        }\n                    ),\n                    axios.get(`${keys.baseUrl}private/wp-editor/v1/events`, {\n                        headers: requestHeader,\n                    }),\n                    AecClientInstanceInfo.isVersionAllowed('2024.3')\n                    && axios.get(`${keys.baseUrl}private/wp-editor/v1/events/event_tags`, {\n                        headers: requestHeader,\n                    }),\n                    axios.get(`${keys.baseUrl}private/wp-editor/v1/examination/examination_type`, {\n                        headers: requestHeader,\n                    }),\n                    axios.get(`${keys.baseUrl}private/wp-editor/v1/classes/formats`, {\n                        headers: requestHeader,\n                    }),\n                ]);\n\n                if (classifications)\n                    newResources.classifications = [\n                        {\n                            label: 'All',\n                            value: '0',\n                        },\n                        ...classifications.map((item) => ({\n                            label: item.name,\n                            value: item.id,\n                        })),\n                    ];\n\n                if (classTypes)\n                    newResources.classTypes = [\n                        {\n                            label: 'All',\n                            value: '0',\n                        },\n                        ...classTypes.map((item) => ({\n                            label: item.name,\n                            value: item.id,\n                        })),\n                    ];\n\n                if (levels)\n                    newResources.levels = [\n                        {\n                            label: 'All',\n                            value: '0',\n                        },\n                        ...levels.map((item) => ({\n                            label: item.name,\n                            value: item.id,\n                        })),\n                    ];\n\n\n                if (subjects)\n                    newResources.subjects = [\n                        {\n                            label: 'All',\n                            value: '0',\n                        },\n                        ...subjects.map((item) => ({\n                            label: item.name,\n                            value: item.id,\n                        })),\n                    ];\n\n                if (establishments) {\n                    newResources.establishments = [\n                        {\n                            label: 'All',\n                            value: '0'\n                        },\n                        ...establishments.map((item) => ({\n                            label: item.name,\n                            value: item.id,\n                        })),\n                    ];\n                }\n\n                if (periods)\n                    newResources.periods = [\n                        {\n                            label: 'All',\n                            value: '0',\n                        },\n                        ...periods.map((item) => ({\n                            label: item.name,\n                            value: item.id,\n                        })),\n                    ];\n\n                if (examinationTypes) {\n                    const allOptionForExaminationType = {label: 'All', value: '0'};\n                    const optionsFromExaminationTypes = examinationTypes.map(item => ({label: item.name, value: item.id}));\n                    newResources.examinationTypes = [allOptionForExaminationType, ...optionsFromExaminationTypes];\n                    newResources.examinationType = [...optionsFromExaminationTypes];\n                }\n\n                if (events) newResources.events = [...generateOptions(events)];\n\n                if (eventTags) {\n                    newResources.eventTags = [\n                        ...eventTags.map((item) => ({\n                            label: item.name,\n                            value: item.id,\n                        })),\n                    ];\n                }\n\n                if (products) {\n                    newResources.products = [\n                        ...products.map((item) => ({\n                            label: item.name,\n                            value: item.id,\n                        })),\n                    ];\n\n\n                    newResources.eventTypes = [\n                        {\n                            label: 'All',\n                            value: '0',\n                        },\n                        ...products\n                            .filter((product) => product.groupType === 'event_ticket')\n                            .map((item) => ({\n                                label: item.name,\n                                value: item.id,\n                            })),\n                    ];\n\n                    newResources.donationType = [\n                        ...products\n                            .filter((product) => product.groupType === 'donation')\n                            .map((item) => ({\n                                label: item.name,\n                                value: item.id,\n                            })),\n                    ];\n\n                    newResources.privateType = [\n                        ...products\n                            .filter((product) => product.groupType === 'private_class' && YesNoHelper.isYes(product.active) )\n                            .map((item) => ({\n                                label: item.name,\n                                value: item.id,\n                            })),\n                    ];\n\n                }\n\n                if(classFormats) {\n                    newResources.classFormats = [\n                        ...classFormats.map(item => ({\n                            label: item.name,\n                            value: item.id\n                        }))\n                    ];\n                }\n\n                newResources.mainLevels = [\n                    ...Object.values(classMainLevel).map((v) => ({\n                        label: v,\n                        value: v,\n                    })),\n                ];\n\n                newResources.tags = [\n                    ...Object.keys(identifyPanelTags).map((key) => ({\n                        label: identifyPanelTags[key],\n                        value: key\n                    }))\n                ];\n\n                newResources.localizations = [\n                    ...Object.values(classLocalizationsOptions).map((option) => ({\n                        label: option,\n                        value: option === 'NONE' ? '' : option,\n                    })),\n                ];\n\n                newResources.viewModes = [\n                    ...Object.keys(defaultViewModeOptions).map((key) => ({\n                        label: key,\n                        value: defaultViewModeOptions[key]\n                    })),\n                ];\n\n                newResources.eventsToShow = [\n                    ...Object.keys(eventsToShowOptions).map((key) => ({\n                        label: key,\n                        value: eventsToShowOptions[key]\n                    })),\n                ];\n\n                setResources(newResources);\n                setFetching(false);\n            } catch (e) {\n                setFetching(false);\n            }\n        };\n        fetchData();\n    }, []);\n\n    useEffect(() => {\n        setRequireParam(someInputIsRequired());\n    });\n\n    function handleValueChange(value, type, index) {\n        const values = [...selectedComponentValues];\n        let nextValue = value;\n\n        if (type === 'select') {\n            nextValue = value.value;\n        } else if (type === 'multiple') {\n            nextValue = value ? serializeValues(value.map((v) => v.value)) : '';\n        } else if(type === 'checkboxYN')\n        {\n            nextValue = YesNoHelper.getYesNo(value);\n        }\n\n        values[index] = nextValue;\n        setSelectedComponentValues(values);\n    }\n\n    function someInputIsRequired() {\n        let isSomeInputRequired = false;\n        if (selectedComponent && selectedComponent.params) {\n            selectedComponent.params.forEach((v, vIndex) => {\n                if (v.required && (!selectedComponentValues[vIndex] || selectedComponentValues[vIndex] === \"\")) {\n                    isSomeInputRequired = true;\n                }\n            });\n        }\n\n        return isSomeInputRequired;\n    }\n\n    function handleCopy() {\n        setIsCopiedMessageActive(true);\n        setTimeout(() => {\n            setIsCopiedMessageActive(false);\n        }, 1000);\n    }\n\n    function getSource() {\n        let params = '';\n\n        if (selectedComponent.params) {\n            selectedComponent.params.forEach((v, vIndex) => {\n                if (selectedComponentValues[vIndex])\n                    params += ` ${v.name}=\"${selectedComponentValues[vIndex] || ''}\"`;\n            });\n        };\n        return `[${selectedComponent.code}${params}]`;\n    }\n\n    function getPreview() {\n        let params = '';\n        if (selectedComponent.requireUser) {\n            if (selectedComponent.imgPreview) {\n                return `<img className=\"webapp-preview__img\" src=\"../wp-content/plugins/aec-kiosque/includes/components/build${selectedComponent.imgPreview}\" />`\n            }\n            return `<div></div>`;\n        }\n\n        if (selectedComponent.params) {\n            selectedComponent.params.forEach((v, vIndex) => {\n                if (selectedComponentValues[vIndex]) {\n                    params += ` data-param-${v.name}=\"${\n                        selectedComponentValues[vIndex] || ''\n                    }\"`;\n                }\n            });\n        }\n\n        return `<div data-module=\"${selectedComponent.module}\" data-action=\"${\n            selectedComponent.action\n        }\" ${params} data-show-loading=\"true\" data-param-lang=\"${keys.language}\" ${\n            selectedComponent.action === 'register'\n                ? `data-param-instance=\"${keys.aecInstance}\"`\n                : ''\n        }></div>`;\n    }\n\n    function renderOptions() {\n        if (!selectedComponent || !selectedComponent.params) return null;\n\n        return selectedComponent.params.map((p, pIndex) => {\n            let input;\n            const isEditorInputID = p.editorInputID;\n\n            if(isEditorInputID)\n            {\n                input = formInputs.find((i) => i.id === p.editorInputID);\n            }\n            else\n            {\n                const hasSpecificType = !!p.type;\n                input = formInputs.find((i) => i.params.includes(p.name) && (!hasSpecificType || i.type === p.type));\n            }\n\n            let defaultValue;\n            if (!input || (input.requiredVersion && !AecClientInstanceInfo.isVersionAllowed(input.requiredVersion))) return null;\n            if (window['AECKiosque'] && window['AECKiosque'].getOption && p.defaultValue) {\n                defaultValue = p.defaultValue || window['AECKiosque'].getOption(p.defaultValue);\n            }\n\n            return (\n                <div key={`${input.id}-${pIndex}`} className={`sc-generator-control ${requireParam ? 'alert-required' : ''}`}>\n                    <label\n                        htmlFor={`${input.id}-${pIndex}`}\n                        className={`sc-generator-control__label ${p.required ? 'required' : ''}`}\n                    >\n                        {input.label}\n                    </label>\n                    {['select', 'multiple'].includes(input.type) ? (\n                        <Select\n                            options={\n                                resources[input.dataName]\n                                    ? resources[input.dataName].map((c) => ({\n                                        value: c.value,\n                                        label: c.label,\n                                    }))\n                                    : []\n                            }\n                            isMulti={input.type === 'multiple'}\n                            onChange={(value) => handleValueChange(value, input.type, pIndex)}\n                            name={`${input.id}-${pIndex}`}\n                            id={`${input.id}-${pIndex}`}\n                            className={`sc-generator-control__select ${p.required ? 'required' : ''}`}\n                        />\n                    ) : (input.type === 'checkbox') ? (\n                        <input\n                            onChange={() => {\n                                const checked = !!selectedComponentValues[pIndex];\n                                handleValueChange(!checked, input.type, pIndex);\n                            }}\n                            name={`${input.id}-${pIndex}`}\n                            id={`${input.id}-${pIndex}`}\n                            checked={selectedComponentValues[pIndex]}\n                            className={`sc-generator-control__input sc-generator-control__input--check ${p.required ? 'required' : ''}`}\n                            type={'checkbox'}\n                        />\n                    ) : (input.type === 'checkboxYN') ? (\n                        <input\n                            onChange={() => {\n                                const checked = YesNoHelper.isYes(selectedComponentValues[pIndex]);\n                                handleValueChange(!checked, input.type, pIndex);\n                            }}\n                            name={`${input.id}-${pIndex}`}\n                            id={`${input.id}-${pIndex}`}\n                            checked={YesNoHelper.isYes(selectedComponentValues[pIndex])}\n                            className={`sc-generator-control__input sc-generator-control__input--check ${p.required ? 'required' : ''}`}\n                            type={'checkbox'}\n                        />\n                    ) : (\n                        <input\n                            onChange={(e) =>\n                                handleValueChange(e.target.value, input.type, pIndex)\n                            }\n                            name={`${input.id}-${pIndex}`}\n                            id={`${input.id}-${pIndex}`}\n                            value={(defaultValue && !selectedComponentValues[pIndex]) ? handleValueChange(defaultValue, input.type, pIndex) : selectedComponentValues[pIndex]}\n                            className={`sc-generator-control__input ${p.required ? 'required' : ''}`}\n                            type={input.type}\n                        />\n                    )}\n                </div>\n            );\n        });\n    }\n\n    const displayGenerator = () => {\n        if (!keys.apiToken || !keys.baseUrl)\n            return (\n                <div className=\"sc-generator-empty\">\n                    No API Secret or API URL where provided.\n                    <br/>\n                    Please contact support for help.\n                </div>\n            );\n\n        if (isFetching) return <div className=\"sc-generator-empty\">Loading...</div>;\n\n        return (\n            <Fragment>\n                <div className=\"sc-generator-sidebar\">\n                    <div className={`required-message ${(requireParam ? '' : 'out')}`}>\n                        Fill in the required fields\n                        <span>*</span>\n                    </div>\n                    <Select\n                        options={\n                            components.map((component) => ({\n                                value: component.name,\n                                label: component.name\n                            }))\n                        }\n                        onChange={(selectedComponent) => {\n                            setSelectedComponentValues([]);\n                            let actualComponent = components.find(component => {\n                                return component.name === selectedComponent.value;\n                            })\n                            setSelectedComponent(actualComponent);\n                        }}\n                        name={'components-select'}\n                        className={'sc-generator-control__select'}\n                    />\n\n                    {selectedComponent ? (\n                        <div className=\"sc-generator-options\">{renderOptions()}</div>\n                    ) : null}\n                </div>\n\n                {selectedComponent ? (\n                    <div className=\"sc-generator-container\">\n                        <div className=\"sc-generator-preview\">\n                            {\n                                (!requireParam) ? (\n                                    <div\n                                        className=\"kiosque-aec arc-en-ciel\"\n                                        dangerouslySetInnerHTML={{__html: getPreview()}}\n                                    />\n                                ) : ''\n                            }\n                        </div>\n                        <div className=\"sc-generator-output\">\n                            {\n                                (!requireParam) ? (\n                                    <CopyToClipboard\n                                        ref={copyRef}\n                                        text={getSource()}\n                                        onCopy={handleCopy}\n                                    >\n                                        <div className=\"sc-generator-output__source\">\n                                            {isCopiedMessageActive ? (\n                                                <div className=\"sc-generator-output__alert\">\n                                                    Copied to clipboard\n                                                </div>\n                                            ) : null}\n                                            <button\n                                                className=\"sc-generator-output__copy\"\n                                            >\n                                                <FontAwesomeIcon icon={faCopy}/>\n                                            </button>\n                                            {getSource()}\n                                        </div>\n                                    </CopyToClipboard>\n                                ) : ''\n                            }\n                        </div>\n                    </div>\n                ) : (\n                    <div className=\"sc-generator-empty\">\n            <span>\n              <FontAwesomeIcon icon={faCubes}/>\n            </span>\n                        Select a component to start building\n                    </div>\n                )}\n            </Fragment>\n        );\n    };\n\n    return <div className=\"sc-generator\">{displayGenerator()}</div>;\n}\n\nexport default ShortcodeGenerator;\n","import ShortcodeGenerator from \"./ShortcodeGenerator\";\n\nexport default ShortcodeGenerator;\n","import React from \"react\";\nimport ShortcodeGenerator from './components/ShortcodeGenerator'\n\nfunction App() {\n  return (\n    <div className=\"App\">\n      <ShortcodeGenerator />\n    </div>\n  );\n}\n\nexport default App;\n","import React from \"react\";\nimport ReactDOM from \"react-dom\";\nimport App from \"./App\";\nimport ShortcodeGenerator from \"./components/ShortcodeGenerator\";\nimport \"./index.css\";\n\nconst rootEl = document.getElementById(\"kiosque-builder-root\");\nconst shortcodeGeneratorEl = document.getElementById(\n  \"kiosque-builder-sc-generator\"\n);\n\nif (rootEl)\n  ReactDOM.render(\n    <React.StrictMode>\n      <App />\n    </React.StrictMode>,\n    rootEl\n  );\n\nif (shortcodeGeneratorEl)\n  ReactDOM.render(\n    <React.StrictMode>\n      <ShortcodeGenerator />\n    </React.StrictMode>,\n    shortcodeGeneratorEl\n  );\n"],"sourceRoot":""}