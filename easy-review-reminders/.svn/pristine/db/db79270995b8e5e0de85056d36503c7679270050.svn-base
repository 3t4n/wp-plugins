if ( ! defined( 'ABSPATH' ) ) {
	exit;
}

get_header(); ?>
	
	<?php do_action( 'err_before_unsubscribed' ); ?>

	<header class="entry-header">
		<h1 class="entry-title"><?php _e( 'Unsubscribed!', 'easy-review-reminders' ); ?> </h1>
	</header>

	<div class="entry-content">
		<p><?php _e( 'Thank you. You have successfully been removed from any future communications about review reminders.', 'easy-review-reminders' ); ?> </p>
	</div>

	<?php do_action( 'err_after_unsubscribed' ); ?>

<?php get_footer();