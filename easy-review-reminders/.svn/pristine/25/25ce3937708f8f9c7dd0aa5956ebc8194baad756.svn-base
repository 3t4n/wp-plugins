/* Bundled Products & Composited Products*/
table.err_product_details tr.bundled_item td.name,
table.err_product_details tr.composited_item td.name{
    padding-left: 32px !important;
}

/* Status Colors */
.status{
    cursor: default;
    padding: 2px 8px;
    color: #fff;
    font-size: 12px;
    -webkit-border-radius: 3px;
    -moz-border-radius: 3px;
    border-radius: 3px;
    border: none;
}
.pending{
    background: #006799;
}
.reviewed, .email-sent{
    background: #5cb85c;
}
.email-pending{ background: #f0ad4e }
.not-reviewed{
    background: #5D5D5D;
}
.cancelled, .email-failed{
    background: #d9534f;
}

/* Table Style */
table.table{
    width: 100%;
    border-spacing: 0px;
}
table.table thead tr th,
table.table tfoot tr th{
    width: 25%;
    text-align: left;
    border-color: #f8f8f8;
    background: #f8f8f8;
    padding: 8px;
    font-size: 11px;
    text-align: left;
    color: #555;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    -khtml-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    user-select: none;
}
table.table tbody tr td{
    border-bottom: 1px dotted #ececec;
    line-height: 26px;
    vertical-align: middle; 
    padding: 8px;
    text-align: left;
    line-height: 26px;
    vertical-align: middle;
    border-bottom: 1px dotted #ececec;
    border-color: #fff;
}
table.table label{
    cursor: default;
    padding: 2px 8px;
    color: #fff;
    font-size: 12px;
    -webkit-border-radius: 3px;
    -moz-border-radius: 3px;
    border-radius: 3px;
    border: none;
}
td.err-reminder-status.column-err-reminder-status{
    vertical-align: middle;
}
/* Email Status */
div#err-review-reminders-email-status-box div.inside{   
    margin: 0px;
    padding: 0px;
}
/* Restore Link Box */
#err-review-reminders-reminder-restore-link input[type=text]{
    width: 100%;
}
#err-review-reminders-reminder-restore-link a.copyLink{
    float: right;
}

/* Customer Details */
#err-review-reminders-user-details-box .column{
    width: 30%;
    padding: 0 2% 0 0;
    float: left;
}
#err-review-reminders-user-details-box.closed div.inside{
    display: none;
}
#err-review-reminders-user-details-box div.inside{   
    display: flex;
}
#err-review-reminders-user-details-box div.inside h4{
    color: #333;
    margin: 1.33em 0 0;
    font-size: 18px;
    font-family: "Helvetica Neue",Helvetica,Arial,sans-serif;
    font-weight: 500;
    line-height: 1.1;
}
.err-reminder-customer label,
#err-review-reminders-user-details-box label{
    display: block;
    padding: 0 0 3px;
    margin: 10px 0px 5px;
    font-weight: bold;
}
.err-reminder-customer label{
    display: inline;
}

/* Ordered reminder Details */
#err-review-reminders-product-details-box .inside{
    margin: 0px;
    padding: 0px;
}
table.err_product_details thead tr th{
    background: #f8f8f8;
    padding: 8px;
    font-size: 11px;
    text-align: left;
    color: #555;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    -khtml-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    user-select: none;
}
table.err_product_details thead tr th.line_cost{   
    width: 10em;
}
table.err_product_details thead tr th.item{
    min-width: 200px;
}
table.err_product_details tbody tr td.thumb{
    width: 27px;
}
table.err_product_details tbody tr td.thumb img{   
    padding: 1px;
    margin: 0;
    border: 1px solid #dfdfdf;
    vertical-align: middle;
    width: 21px;
    height: 21px;
}
table.err_product_details thead tr th.quantity,
table.err_product_details tbody tr td.quantity,
table.err_product_details thead tr th.line_cost,
table.err_product_details tbody tr td.line_cost{
    text-align: center;
}
table.err_product_details tbody tr td{
    padding: 8px;
    text-align: left;
    line-height: 26px;
    vertical-align: middle;
    border-bottom: 1px dotted #ececec;
}
table.err_product_details tbody tr td.name table.display_meta{
    margin: .5em 0 0;
}
table.err_product_details tbody tr td.name table.display_meta td{
    border: 0;
    line-height: 1.5em;
}
#err-review-reminders-product-details-box .err-product-data-row{
    border-bottom: 1px solid #DFDFDF;
    padding: 12px;
    background: #f8f8f8;
    line-height: 2em;
    margin: 0px;
    padding: 0px;
    float: none;
}
#err-review-reminders-product-details-box .err-product-totals-items{
    float: left;
    width: 100%;
}
#err-review-reminders-product-details-box .err-product-totals-items table.wc-order-totals{
    float: right;
}
#err-review-reminders-product-details-box .err-product-totals-items table.wc-order-totals td{
    font-size: 1em!important;
    font-weight: bold;
    color: #000;
    text-align: center;
    font-size: 1em!important;
    text-align: center;
    padding: 8px;
    width: 7em;
}
#err-review-reminders-product-details-box .err-product-data-row table.wc-order-totals td.total span.amount{
    font-weight: 700;
    white-space: nowrap;
}
#err-review-reminders-product-details-box .err-coupons{
    float: left;
    width: 100%;
}
#err-review-reminders-product-details-box table.coupons{
    float: right;
}
#err-review-reminders-product-details-box table.coupons thead th{   
    width: 10em;
    font-size: 11px;
}
#err-review-reminders-product-details-box table.coupons td{
    text-align: center;
}

/*reminder totals*/
#err-review-reminders-product-details-box .err-product-data-row.err-reminder-totals{
    position: relative;
    float: none;
    display: table;
    width: 100%;
    webkit-box-sizing: border-box;
    -moz-box-sizing: border-box;
    box-sizing: border-box;
}
#err-review-reminders-product-details-box .err-product-data-row.err-reminder-totals table.totals{
    float: right;
    padding: 20px 35px;
    width: 340px;
}
#err-review-reminders-product-details-box .err-product-data-row.err-reminder-totals table.totals th,
#err-review-reminders-product-details-box .err-product-data-row.err-reminder-totals table.totals td {
    padding: 4px 10px;
    text-align: left;
}
#err-review-reminders-product-details-box .err-product-data-row.err-reminder-totals table.totals h2{
    margin: 0px;
    padding: 0px;
    font-weight: 600;
}
#err-review-reminders-product-details-box .err-product-data-row.err-reminder-totals .woocommerce-remove-coupon{
    display: none;
}