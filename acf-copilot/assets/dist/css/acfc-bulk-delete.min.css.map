.acfc-admin.acfc-bulk-delete-container {
	-webkit-box-align: center;
	-webkit-align-items: center;
	-ms-flex-align: center;
	align-items: center;
	display: -webkit-box;
	display: -webkit-flex;
	display: -ms-flexbox;
	display: flex;
	gap: 9px;
	position: absolute;
	right: 9px;
	top: 8px;
}

.acfc-admin.acfc-bulk-delete-select-all {
	background-color: rgb(237.3983050847, 237.9661016949, 239.1016949153);
	border: 1px solid #e0e1e3;
	border-radius: 2px;
	cursor: pointer;
	padding: 6px;
	width: 94px;
}

.acfc-admin.acfc-bulk-delete-select-all:focus,
.acfc-admin.acfc-bulk-delete-select-all:hover {
	border-color: #2271b1;
}

.acfc-admin.acfc-bulk-delete-selected {
	color: #93003c !important;
}

.acfc-admin.acfc-bulk-delete-checkbox {
	border-radius: 2px;
	cursor: pointer;
	padding: 6px;
	position: absolute;
	right: 18px;
	text-align: center;
	top: 9px;
}

