
    /* Stili delle tab */
    .tab {
      display: none;
    }

    /* Stili dei link delle tab */
    .tab-label {
      background-color: #f1f1f1;
      padding: 8px 16px;
      cursor: pointer;
      border: none;
      outline: none;
      font-weight: bold;
	  text-decoration:none;		
    }

    /* Stili della tab attiva */
    .tab-label.active {
      background-color: #fff;
	  background-color:#fff;	
	  text-decoration:none;	
    }

    /* Stili delle tabelle */
    .tab-content {
      display: none;
      padding: 16px;
	  background-color:#fff;
	  margin-top:6px;
	  
	  	
    }

    /* Stili della tab attiva */
    .tab-content.active {
      display: block;
		
    }
    

.link-info-box {
      display: inline-block;
      background-color: #fff;
      padding: 5px 20px 7px 20px;
      color: #02a1f0;
      font-weight: 700;
      border-radius: 5px;
      margin-right: 5px;
      margin-bottom: 10px;
      border: 1px solid #02a1f0;
    }

    .link-info-box i {
      margin-left: 5px;
    }

    @media (min-width: 768px) {
      .link-info-box {
        width: 50%;
      }
    }

    @media (min-width: 1024px) {
      .link-info-box {
        width: 25%;
      }
    }

		.link-info-box a{
		text-decoration:none;
	}

  
    .row-avatar {
      display: flex;
      align-items: flex-start;
    }
    
    .column {
      padding: 10px;
    }
    
    img {
      max-width: 100%;
      height: auto;
      margin-right: 10px;
    }
    
    .column p {
      margin: 0;
    }

	.thankyou-rightside {
		background-color:#ffffff !important;
	}
	.icon-headset-developress {
		color:#009704;
	}	
	
	.icon-tab-big {
		font-size:21px;
		margin-right:20px;
	}

