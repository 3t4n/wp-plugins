jQuery(document).ready(function($) {
    $('.edit-menu-item-custom').select2({
        width: '100%', // Opzionale: Questo fa sì che Select2 diventi largo quanto il suo contenitore
        dropdownAutoWidth: true // Opzionale: Questo consente al menu a discesa di estendersi per adattarsi al contenuto più lungo
    });
});
