return ['project-id-version'=>'DeveloPress Sticky Footer Bar Pro','report-msgid-bugs-to'=>'','pot-creation-date'=>'2024-03-24 17:00+0000','po-revision-date'=>'2024-04-15 18:23+0000','last-translator'=>'Roberto Paolucci','language-team'=>'English (United States)','language'=>'en_US','plural-forms'=>'nplurals=2; plural=n != 1;','mime-version'=>'1.0','content-type'=>'text/plain; charset=UTF-8','content-transfer-encoding'=>'8bit','x-generator'=>'Loco https://localise.biz/','x-loco-version'=>'2.6.7; wp-6.4.3','x-domain'=>'developress_sticky_footer_bar','messages'=>['Active'=>'Active','Active the sticky bar'=>'Activate the sticky bar','Background color'=>'Background color','Choose on which type of device to show the footer bar.'=>'Choose on which type of device to show the footer bar.','Close link in the side menu'=>'Close link in the side menu','Color of menu items. Use the color picker to set it'=>'Color of menu items. Use the color picker to set it','Contact Form'=>'Contact Form','Create a footer bar, fixed to the scroll, which contains menu items. The goal is to provide a menu-level user experience similar to apps. The configuration is very simple and the customization extensive without programming knowledge.'=>'Create a footer bar, fixed to the scroll, which contains menu items. The goal is to provide a menu-level user experience similar to apps. The configuration is very simple and the customization is extensive without programming knowledge.','Custom CSS'=>'Custom CSS','DeveloPress Sticky Footer Bar Pro'=>'DeveloPress Sticky Footer Bar Pro','developress.it/roberto_paolucci'=>'developress.it/roberto_paolucci','Display on all devices?'=>'Display on all devices?','Documentation'=>'Documentation','Everywhere'=>'Everywhere','Fantastic! This menu will be shown in the "Sticky Footer Bar" of this web site.'=>'Fantastic! This menu will be shown in the "Sticky Footer Bar" of this web site.','Font color of menu items'=>'Font color of menu items','Font size for menu items. Use this field to set it. Add only "number" without "px".'=>'Font size for menu items. Use this field to set it. Add only "number" without "px".','Font size for other strings. Use this field to set it. Add only "number" without "px".'=>'Font size for other strings. Use this field to set it. Add only "number" without "px".','Font size of menu items'=>'Font size of menu items','Font size othe label'=>'Font size of the label','Footer bar background color. Use the color picker to set it'=>'Footer bar background color. Use the color picker to set it','Hamburger menu title'=>'Hamburger menu title','https://developress.it/developress-plugin/developress-sticky-footer-bar-pro/documentation/'=>'https://developress.it/developress-plugin/developress-sticky-footer-bar-pro/documentation/','Icon size'=>'Icon size','If you have any question or need support, do not hesitate to contact me. Provide as much information as possible and try to be precise. Only in this way can I give you the best support'=>'If you have any question or need support, do not hesitate to contact me. Provide as much information as possible and try to be precise. Only in this way can I give you the best support','If you have basic knowledge of HTML and CSS, you can add styling rules inside the box below. For example, you can add a different color and size to the icons.'=>'If you have basic knowledge of HTML and CSS, you can add styling rules inside the box below. For example, you can add a different color and size to the icons.','In this section you can configure the text color, bar background and other settings.'=>'In this section you can configure the text color, bar background, and other settings.','Need support?'=>'Need support?','Number of items horizontal bar'=>'Number of items horizontal bar','Only desktop'=>'Only desktop','Only phone'=>'Only phone','Only phone and tablet'=>'Only phone and tablet','Only tablet'=>'Only tablet','Roberto Paolucci - DeveloPress.it'=>'Roberto Paolucci - DeveloPress.it','Select icon'=>'Select icon','Settings'=>'Settings','Should this menu be assigned to the "Sticky Footer Bar"? If so, assign the "Stikybar" position to this menu and then save the menu.'=>'Should this menu be assigned to the "Sticky Footer Bar"? If so, assign the "Stikybar" position to this menu and then save the menu.','Size of icons in px. Use the field to set it. Add only "number" without "px".'=>'Size of icons in px. Use the field to set it. Add only "number" without "px".','Specifies the number of entries in the horizontal bar. The rest will be added in the side menu.'=>'Specifies the number of entries in the horizontal bar. The rest will be added in the side menu.','StickyBar Settings'=>'StickyBar Settings','Style and settings'=>'Style and settings','Thanks for using the plugin! The plugin allows you to create a fixed scroll bar and customize it as you want by adding menu items and working on the style'=>'Thanks for using the plugin! The plugin allows you to create a fixed scroll bar and customize it as you want by adding menu items and working on the style','Translation for the closing link of the side menu. By default, it is "Close".'=>'Translation for the closing link of the side menu. By default, it is "Close".','Translation of the text of the link to the hamburger menu. By default, it is "Menu".'=>'Translation of the text of the link to the hamburger menu. By default, it is "Menu".','When you have completed all the configurations, add the check mark in the box below to activate the footer bar.'=>'When you have completed all the configurations, add the check mark in the box below to activate the footer bar.','You can select the menu item icon, directly on the menu management page (at the bottom of each item)'=>'You can select the menu item icon, directly on the menu management page (at the bottom of each item)']];
