/* Styles for the table */
#ar-cpt-ct-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
}

#ar-cpt-ct-table th,
#ar-cpt-ct-table td {
    border: 1px solid #ccc; 
    padding: 10px; 
    text-align: left; 
}

/* Table header */
#ar-cpt-ct-table th {
    background-color: #f4f4f4; 
    font-weight: bold;
}

/* Alternate row background */
#ar-cpt-ct-table tr:nth-child(even) {
    background-color: #f9f9f9; 
}

/* Row hover effect */
#ar-cpt-ct-table tr:hover {
    background-color: #f1f1f1; 
}
