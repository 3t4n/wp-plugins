#: fg-fix-serialized-strings.php:33 fg-fix-serialized-strings.tpl.php:1
msgid "Fix Serialized Strings"
msgstr "Réparation des chaînes sérialisées"

#: fg-fix-serialized-strings.php:70
#, php-format
msgid "%d string fixed in postmeta table"
msgid_plural "%d strings fixed in postmeta table"
msgstr[0] "%d chaîne réparée dans la table postmeta"
msgstr[1] "%d chaînes réparées dans la table postmeta"

#: fg-fix-serialized-strings.php:93
#, php-format
msgid "%d string fixed in options table"
msgid_plural "%d strings fixed in options table"
msgstr[0] "%d chaîne réparée dans la table options"
msgstr[1] "%d chaînes réparées dans la table options"

#: fg-fix-serialized-strings.php:127
#, php-format
msgid "%d widget restored"
msgid_plural "%d widgets restored"
msgstr[0] "%d widget restauré"
msgstr[1] "%d widgets restaurés"

#: fg-fix-serialized-strings.php:129
msgid "The restored widgets will be found in the inactive widgets section."
msgstr ""
"Les widgets restaurés seront trouvés dans la section des widgets désactivés."

#: fg-fix-serialized-strings.tpl.php:3
msgid ""
"Fix the serialized strings in the postmeta and options tables by "
"recalculating all the string lengths"
msgstr ""
"Répare les chaînes sérialisées dans les tables postmeta et options en "
"recalculant toutes les longueurs des chaînes"

#: fg-fix-serialized-strings.tpl.php:4
msgid "As it will change your database, please do a backup first."
msgstr ""
"Comme la base de données va être modifiée, veuillez faire une sauvegarde au "
"préalable."

#: fg-fix-serialized-strings.tpl.php:8
msgid "Fix serialized strings"
msgstr "Réparation des chaînes sérialisées"
