displayName\n\nexport { Checkbox }\n","import {Checkbox} from \"@/components/ui/checkbox\";\nimport {Label} from \"@/components/ui/label\";\nimport {Controller} from \"react-hook-form\";\n\ninterface Props {\n    control: any;\n    type: \"add\" | \"update\" | \"delete\";\n    prefix?: string;\n\n}\n\n\nexport const GoogleSheetSettingCheckbox = ({control, type, prefix = ''}: Props) => {\n\n    let name;\n    switch (type) {\n        case \"add\":\n            name = prefix + \"add\";\n            break;\n        case \"update\":\n            name = prefix + \"update\";\n            break;\n        case \"delete\":\n            name = prefix + \"delete\";\n            break;\n    }\n\n    let label: string;\n    switch (type) {\n        case \"add\":\n            label = \"Sync Page Creations\";\n            break;\n        case \"update\":\n            label = \"Sync Page Updates\";\n            break;\n        case \"delete\":\n            label = \"Sync Page Deletions\";\n            break;\n    }\n\n    let tooltipContent;\n    switch (type) {\n        case \"add\":\n            tooltipContent = \"Automatically create new pages when new rows are added to the Google Sheet.\";\n            break;\n        case \"update\":\n            tooltipContent = \"Update existing pages when corresponding rows in the Google Sheet are modified.\";\n            break;\n        case \"delete\":\n            tooltipContent = \"Delete pages when the corresponding rows are removed from the Google Sheet.\";\n            break;\n    }\n\n    return (\n        <Controller name={name} control={control} render={({field}) => {\n            return <div className=\"flex items-start\">\n                <div className=\"flex items-center h-5\">\n                    <Checkbox checked={field.value} onCheckedChange={checked => field.onChange(checked)}\n                              className={`h-4 w-4 rounded border-gray-300 `}\n/>\n                </div>\n                <div className=\"ml-2 text-sm\">\n                    <Label className={'font-medium text-gray-700'}>{label}</Label>\n                    <p className=\"text-gray-500\">{tooltipContent}</p>\n                </div>\n\n\n            </div>\n        }}></Controller>\n\n    )\n}","import useWordpressAjax from \"@/hooks/fetch/use-wordpress-ajax-fetch\";\nimport {z} from \"zod\";\nimport {useQuery, UseQueryResult} from \"@tanstack/react-query\";\n\n// Define the Zod schema for the response\nexport const GoogleSheetScheduledDataSchema = z.object({\n    next_sync_timestamp: z.number().optional(), // optional, in case of no event\n    schedule_interval: z.string().optional(),\n    time_until_next_sync: z.string().optional(),\n    memory_limit_bytes: z.number().optional(),\n    pretty_memory_limit: z.string().optional(),\n});\n\n// Infer the response type from the schema\nexport type GoogleSheetScheduledData = z.infer<typeof GoogleSheetScheduledDataSchema>;\n\n// Define the hook for fetching the scheduled Google Sheet sync data\nconst useGoogleSheetScheduledData = (): UseQueryResult<GoogleSheetScheduledData | void> => {\n    // Fetcher function using the WordPress AJAX handler\n    const fetcher = useWordpressAjax<GoogleSheetScheduledData>(\"lpagery_get_google_sheet_scheduled_data\", GoogleSheetScheduledDataSchema, \"Fetching Google Sheet scheduled data failed\");\n\n    return useQuery({\n        queryKey: [`google-sheet-sheduled-data`],\n        queryFn: () => fetcher({})\n    })\n};\n\nexport default useGoogleSheetScheduledData;\n","import {useFormContext} from \"react-hook-form\";\nimport {DashboardFormType} from \"@/model/dashboard/dashboard-form-model\";\nimport {FormSwitch} from \"@/components/ui/form-switch\";\nimport {useEffect} from \"react\";\nimport {GoogleSheetUrlInput} from \"@/components/dashboard/save/upload/GoogleSheetUrlInput\";\nimport {LicenseAwareWrapper} from \"@/components/common/LicenseAwareWrapper\";\nimport {FormFieldWrapper} from \"@/components/common/FormFieldWrapper\";\nimport {GoogleSheetSettingCheckbox} from \"@/components/dashboard/save/upload/GoogleSheetSettingCheckbox\";\nimport {ArrowTopRightOnSquareIcon, InformationCircleIcon,} from \"@heroicons/react/24/outline\";\nimport {Button} from \"@/components/ui/button\";\nimport useGoogleSheetScheduledData from \"@/hooks/dashboard/query/use-google-sheet-scheduled-data\";\nimport {ProBadge} from \"@/components/common/ProBadge\";\nimport {useSubscription} from \"@/hooks/subscription/use-subscription\";\n\n\nexport default function GoogleSheetDashboardArea() {\n    const {control, formState: {errors}, register, watch, resetField} = useFormContext<DashboardFormType>()\n    const sub =  useSubscription()\n\n    // This is a workaround to prevent the sync_settings.enabled field from being reset to \"on\"\n\n    const syncEnabled = watch(\"input.sheet.sync_settings.enabled\");\n\n    useEffect(() => {\n        if (typeof syncEnabled !== \"boolean\") {\n            resetField(\"input.sheet.sync_settings.enabled\");\n        }\n    }, [syncEnabled]);\n\n    const scheduledDataResponse = useGoogleSheetScheduledData();\n\n    if (!scheduledDataResponse.data || scheduledDataResponse.isLoading) {\n        return null;\n    }\n\n    const {\n        schedule_interval,\n        time_until_next_sync,\n    } = scheduledDataResponse.data;\n\n\n\n    return (\n        <section className={\"space-y-4\"}>\n            <div className=\"space-y-2\">\n                <FormFieldWrapper label={\"Google Sheet URL\"} license={\"standard\"}\n                    error={(errors as any)?.input?.sheet?.url?.message}>\n\n                    <GoogleSheetUrlInput\n                        control={control}\n                        name=\"input.sheet.url\"\n                    />\n\n\n                </FormFieldWrapper>\n            </div>\n            <LicenseAwareWrapper license={\"extended\"}>\n                <div className=\"flex items-center justify-between\">\n                    <div className=\"flex flex-col\">\n                        <span className={`text-sm font-medium text-custom-blue-400`}>Enable Google Sheet Sync  {!sub.extended && <ProBadge/>} </span>\n\n                        <span className=\"text-sm text-gray-500 mt-1\">Sync data between your Google Sheet and this page</span>\n                    </div>\n                    <FormSwitch\n                        control={control}\n                        data-testid=\"google-sheet-sync-switch\"\n                        {...register(\"input.sheet.sync_settings.enabled\")}\n\n                    />\n                </div>\n                {syncEnabled && (\n                    <div className=\"mt-6 bg-gray-50 rounded-lg p-6 border border-gray-200 shadow-sm\">\n                        <h3 className=\"text-lg font-semibold text-gray-900 mb-4\">Google Sheet Sync Settings</h3>\n\n                        <fieldset className=\"mb-6\">\n                            <div className=\"space-y-5\">\n                                <GoogleSheetSettingCheckbox control={control} type={\"add\"}\n                                                            prefix={\"input.sheet.sync_settings.\"}/>\n                                <GoogleSheetSettingCheckbox control={control} type={\"update\"}\n                                                            prefix={\"input.sheet.sync_settings.\"}/>\n                                <GoogleSheetSettingCheckbox control={control} type={\"delete\"}\n                                                            prefix={\"input.sheet.sync_settings.\"}/>\n                            </div>\n                        </fieldset>\n\n                        <div className=\"space-y-4 text-sm\">\n                            <div className=\"bg-blue-50 p-4 rounded-md\">\n                                <div className=\"flex\">\n                                    <InformationCircleIcon className=\"h-5 w-5 text-blue-400 flex-shrink-0\"/>\n                                    <p className=\"ml-3 text-blue-700\">\n                                        Next Sync: <strong>{time_until_next_sync}</strong>. After\n                                        that: <strong>{schedule_interval}. </strong>\n                                        The interval can be changed in the Settings.\n\n                                    </p>\n\n                                </div>\n                            </div>\n\n                        </div>\n                        {((errors as any)?.input?.sheet?.sync_settings?.root) && (\n                            <div className=\"text-red-500 text-sm\">\n                                {(errors as any)?.input.sheet.sync_settings.root.message}\n                            </div>\n                        )}\n\n                        <div className=\"mt-6 flex items-center space-x-4\">\n                            <Button variant=\"link\" size=\"sm\" className={`flex items-center text-custom-blue-400 `} asChild>\n                                <a href=\"https://intercom.help/lpagery/en/collections/10674172-create-update-and-delete-pages-automatically-google-sheet-sync\" target=\"_blank\">\n                                    <ArrowTopRightOnSquareIcon className=\"h-4 w-4 mr-2\"/>\n                                    Learn More About Sheet Sync\n                                </a>\n                            </Button>\n                        </div>\n                    </div>\n                )}\n            </LicenseAwareWrapper>\n        </section>\n    );\n}\n","import {Radio, RadioGroup} from '@headlessui/react'\nimport {FileUpload} from \"@/components/ui/file-upload\";\nimport RadiusSelectArea from \"@/components/dashboard/save/upload/RadiusSelectArea\";\nimport {DashboardFormType} from \"@/model/dashboard/dashboard-form-model\";\nimport {Controller, useFormContext} from \"react-hook-form\";\nimport GoogleSheetDashboardArea from \"@/components/dashboard/save/upload/GoogleSheetDashboardArea\";\nimport {CloudIcon, DocumentArrowUpIcon, MapPinIcon} from '@heroicons/react/24/outline'\n\nimport {useSubscription} from \"@/hooks/subscription/use-subscription\";\nimport {CheckCircleIcon} from \"@heroicons/react/20/solid\";\nimport {ProBadge} from \"@/components/common/ProBadge\";\nimport {ErrorBoundaryWrapper} from \"@/components/layout/error/ErrorBoundaryWrapper\";\n\n\nconst inputTypeOptions = [\n    {id: 'file', title: 'CSV / XLSX', description: 'Upload a simple CSV or Excel file.', icon: DocumentArrowUpIcon},\n    {id: 'radius', title: 'Radius', description: 'Create pages for cities around you.', icon: MapPinIcon},\n    {\n        id: 'sheet',\n        title: 'Google Sheet',\n        description: 'Connect to a Google Sheet and sync data.',\n        icon: CloudIcon\n    },\n]\n\ninterface Props {\n    onboarding?: boolean;\n}\n\nexport const UploadFileArea = ({onboarding = false}: Props) => {\n    const subscription = useSubscription();\n    const {control, formState: {errors}} = useFormContext<DashboardFormType>()\n    console.log(errors)\n    return (\n        <Controller name={'input.source'} control={control} render={({field}) => {\n\n            if (onboarding) {\n                return <div className={'pt-8'}>\n                    {field.value === 'file' && <div>\n                        <FileUpload allowedExtensions={['csv', 'xlsx', 'xls']} onboarding={onboarding}/>\n                        {(errors.input as any)?.file && <p className=\"text-red-500 text-sm\">{(errors.input as any)?.file?.message}</p>}\n                    </div>}\n                </div>\n            }\n            return (<>\n                <RadioGroup defaultValue={field.value}\n                            className=\"mt-6 grid grid-cols-1 gap-y-6 sm:grid-cols-3 sm:gap-x-4\"\n                            onChange={(value) => {\n                                field.onChange(value)\n                            }}\n                >\n\n                    {inputTypeOptions.map((option) => {\n                        const disabled = option.id !== 'file' && subscription.free;\n                        return (\n                            <Radio\n                                key={option.id}\n                                value={option.id}\n                                aria-label={option.title}\n                                data-testid={'card-' + option.id}\n                                aria-description={option.description}\n                                disabled={disabled}\n                                className={`group relative flex rounded-lg border border-gray-300 bg-white p-4 shadow-sm focus:outline-none ${field.value === option.id ? 'text-gray-900' : ''\n                                } ${disabled ? 'opacity-50 cursor-not-allowed pointer-events-none' : 'cursor-pointer'}`}\n                            >\n                                <div className=\"relative pl-8 w-full\">\n                                    <div className=\"flex justify-between items-start\">\n                                        <dt className=\"text-sm font-semibold leading-6 text-gray-900\">\n                                            <div\n                                                className=\"absolute left-0 top-0 flex h-5 w-5 items-center justify-center\">\n                                                <option.icon className=\"h-5 w-5 text-[#4C88BA]\" aria-hidden=\"true\"/>\n                                            </div>\n                                            {option.title}\n                                            {disabled && <ProBadge/>}\n                                        </dt>\n                                        <CheckCircleIcon\n                                            aria-hidden=\"true\"\n                                            className=\"h-5 w-5 text-[#4C88BA] [.group:not([data-checked])_&]:invisible\"\n                                        />\n                                    </div>\n                                    <dd className=\"text-xs leading-5 text-gray-500 mt-1\">{option.description}</dd>\n                                </div>\n                                <span\n                                    aria-hidden=\"true\"\n                                    className=\"pointer-events-none absolute -inset-px rounded-lg border border-transparent group-data-[focus]:border group-data-[checked]:border-[#4c88ba]\"\n                                />\n                            </Radio>\n                        );\n                    })}\n                </RadioGroup>\n                <div className={'pt-8'}>\n                    {field.value === 'file' && <ErrorBoundaryWrapper>\n                        <FileUpload allowedExtensions={['csv', 'xlsx', 'xls']} />\n                        {(errors.input as any)?.file && <p className=\"text-red-500 text-sm\">{(errors.input as any)?.file?.message}</p>}\n                    </ErrorBoundaryWrapper>}\n                    {field.value === 'radius' && <ErrorBoundaryWrapper>\n                        <RadiusSelectArea/>\n                    </ErrorBoundaryWrapper>}\n\n                    {field.value === 'sheet' && <ErrorBoundaryWrapper>\n                        <GoogleSheetDashboardArea/>\n                    </ErrorBoundaryWrapper>}\n                </div>\n            </>)\n        }}/>\n\n\n    )\n}","import {wordpressAjaxFetch} from '@/hooks/fetch/wordpress-ajax-fetch';\nimport {z} from \"zod\";\nimport {getNonce} from \"@/hooks/fetch/use-nonce\";\n\nexport const GoogleSheetExistsResponseSchema = z.object({\n    found: z.boolean()\n});\n\nexport type GoogleSheetExistsResponse = z.infer<typeof GoogleSheetExistsResponseSchema>\n\nexport const checkGoogleSheetExists = async (url?: string) => {\n    return wordpressAjaxFetch<GoogleSheetExistsResponse, {\n        doc_url?: string\n    }>({\n        action: \"lpagery_exists_google_doc\",\n        schema: GoogleSheetExistsResponseSchema,\n        body: {doc_url: encodeURIComponent(url || '')},\n        nonce: getNonce()\n    });\n}","import {z} from \"zod\";\nimport {checkGoogleSheetExists} from \"@/hooks/dashboard/query/use-google-sheet-exists\";\n\nexport const GoogleSheetUrlSchema = z.string().url({message : 'Invalid URL'}).refine(async (url) => {\n    const exists = await checkGoogleSheetExists(url);\n    return exists.found;\n}, {message: \"Google Sheet does not exist. Make Sure that the Google Sheet is publicly accessible and not uploaded as an XLSX File.\"});\n\n\n\nexport const GoogleSheetSyncSettingSchema = z.object({\n    enabled: z.boolean().default(false),\n    add: z.boolean().optional(),\n    update: z.boolean().optional(),\n    delete: z.boolean().optional(),\n});","import {z} from \"zod\";\nimport {LocationSchema} from \"@/hooks/dashboard/query/use-locations\";\nimport {OptionalNumber} from \"@/lib/zod-utils\";\nimport {PostStatusSchema} from \"@/types/post-status\";\nimport {GoogleSheetSyncSettingSchema, GoogleSheetUrlSchema} from \"@/model/google-sheet-model\";\n\nexport const RadiusFormValuesSchema = z.object({\n    location: LocationSchema,\n    population: OptionalNumber,\n    kilometers: OptionalNumber,\n    amount: OptionalNumber,\n})\n\n\nexport const GoogleSheetFormValuesSchema = z.object({\n    url: GoogleSheetUrlSchema.optional(),\n    sync_settings: GoogleSheetSyncSettingSchema\n})\n\n\nexport type GoogleSheetFormValues = z.infer<typeof GoogleSheetFormValuesSchema>;\nexport type RadiusFormValues = z.infer<typeof RadiusFormValuesSchema>;\n\nconst InputFormValuesSchema = z.discriminatedUnion('source', [\n    z.object({\n        source: z.literal('radius'),\n        radius: RadiusFormValuesSchema.refine(\n            (data) => !!data.location,\n            {\n                message: \"Location is required when radius is selected\",\n                path: [\"location\"]\n            }\n        )\n    }),\n    z.object({\n        source: z.literal('file'),\n        file: z.instanceof(File, {message: \"File needs to be uploaded when CSV/XLSX is selected\"})\n    }),\n    z.object({\n        source: z.literal('sheet'),\n        sheet: GoogleSheetFormValuesSchema.extend({\n            url: GoogleSheetUrlSchema\n        }).refine(\n            (data) => !data.sync_settings.enabled || (data.sync_settings.add || data.sync_settings.update),\n            {\n                message: \"Either create or update must be set\",\n                path: [\"sync_settings\"]\n            }\n        )\n    })\n])\n\n\n\n\nexport const DashboardSettingsSchema = z.object({\n    purpose: z.string().optional(),\n    template: z.number().min(1, {message: \"Template is required\"}),\n    parent: z.number().optional(),\n    slug: z.string().min(1).refine((slug) => {\n        return slug.includes('{') && slug.includes('}');\n    }, {\n        message: \"Slug must contain at least one placeholder wrapped in {braces} like {city} or {service}\",\n    }),\n    taxonomy_terms: z.record(z.array(z.number()).optional()).optional(),\n    status: PostStatusSchema,\n    date: z.date().optional(),\n});\nexport const DashboardCreateSchema = z.object({\n    config: DashboardSettingsSchema,\n    input: InputFormValuesSchema,\n});\nexport const OnboardingSchema = DashboardCreateSchema.extend({\n  template_created: z.boolean()\n})\nexport const DashboardUpdateSelectionSchema = z.object({\n    process: z.number().optional(),\n    template: z.number().min(1, {message: \"Template Page is required\"}),\n});\n\n\nexport const UpdateTypeSchema = z.enum(['look', 'content', 'settings']);\n\nexport const SelectionStepSchema = z.object({\n    updateSelection: DashboardUpdateSelectionSchema,\n})\nexport const TypeStepSchema = z.object({\n    updateType: z.array(UpdateTypeSchema).min(1, {message: \"At least one update type is required\"}),\n})\n\nexport const InputStepSchema = z.object({\n    input: InputFormValuesSchema\n})\n\nexport const ConfigStepSchema = z.object({\n   config: DashboardSettingsSchema\n})\n\nexport const DashboardUpdateSchema = z\n    .object({})\n    .and(SelectionStepSchema)\n    .and(TypeStepSchema)\n    .and(ConfigStepSchema.partial()) // Make ConfigStep optional initially\n    .and(InputStepSchema.partial())  // Make InputStep optional initially\n    .superRefine((data, ctx) => {\n        if (data.updateType.includes('content') && !data.input) {\n            ctx.addIssue({\n                code: z.ZodIssueCode.custom,\n                message: 'Input step is required when update type contains \"content\".',\n                path: ['input'],\n            });\n        }\n\n        // Check if 'settings' is in updateType, then ConfigStepSchema is required\n        if (data.updateType.includes('settings') && !data.config) {\n            ctx.addIssue({\n                code: z.ZodIssueCode.custom,\n                message: 'Config step is required when update type contains \"settings\".',\n                path: ['config'],\n            });\n        }\n    });\n\nexport type DashboardSettingsType = z.infer<typeof DashboardSettingsSchema>\n\nexport type InputFormValues = z.infer<typeof InputFormValuesSchema>;\nexport type DashboardCreateType = z.infer<typeof DashboardCreateSchema>;\nexport type OnboardingType = z.infer<typeof OnboardingSchema>;\nexport type DashboardUpdateType = z.infer<typeof DashboardUpdateSchema>;\nexport type DashboardFormType = DashboardCreateType | DashboardUpdateType;\nexport type SelectionStepType = z.infer<typeof SelectionStepSchema>;\nexport type TypeStepType = z.infer<typeof TypeStepSchema>;\nexport type UpdateType = z.infer<typeof UpdateTypeSchema>;","export default {\n  createDocument: function createDocument(content) {\n    // if (!content) {\n    // \tthrow new Error('No *.xml content')\n    // }\n    // A weird bug: it won't parse XML unless it's trimmed.\n    // https://github.com/catamphetamine/read-excel-file/issues/21\n    return new DOMParser().parseFromString(content.trim(), 'text/xml');\n  }\n};\n//# sourceMappingURL=xmlBrowser.js.map","// DEFLATE is a comp