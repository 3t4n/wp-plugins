t.addEventListener(\"keydown\",d),()=>document.removeEventListener(\"keydown\",d)},[f]),o.useEffect(()=>{if(A.current)return()=>{L.current&&(L.current.focus({preventScroll:!0}),L.current=null,z.current=!1)}},[A.current]),o.createElement(\"section\",{ref:t,\"aria-label\":`${pt} ${mt}`,tabIndex:-1,\"aria-live\":\"polite\",\"aria-relevant\":\"additions text\",\"aria-atomic\":\"false\",suppressHydrationWarning:!0},P.map((d,h)=>{var j;let[y,R]=d.split(\"-\");return B.length?o.createElement(\"ol\",{key:d,dir:ot===\"auto\"?_t():ot,tabIndex:-1,ref:A,className:g,\"data-sonner-toaster\":!0,\"data-theme\":W,\"data-y-position\":y,\"data-lifted\":Y&&B.length>1&&!w,\"data-x-position\":R,style:{\"--front-toast-height\":`${((j=nt[0])==null?void 0:j.height)||0}px`,\"--width\":`${he}px`,\"--gap\":`${at}px`,...ut,...Te(i,D)},onBlur:p=>{z.current&&!p.currentTarget.contains(p.relatedTarget)&&(z.current=!1,L.current&&(L.current.focus({preventScroll:!0}),L.current=null))},onFocus:p=>{p.target instanceof HTMLElement&&p.target.dataset.dismissible===\"false\"||z.current||(z.current=!0,L.current=p.relatedTarget)},onMouseEnter:()=>C(!0),onMouseMove:()=>C(!0),onMouseLeave:()=>{lt||C(!1)},onDragEnd:()=>C(!1),onPointerDown:p=>{p.target instanceof HTMLElement&&p.target.dataset.dismissible===\"false\"||J(!0)},onPointerUp:()=>J(!1)},B.filter(p=>!p.position&&h===0||p.position===d).map((p,_)=>{var O,G;return o.createElement(ve,{key:p.id,icons:st,index:_,toast:p,defaultRichColors:F,duration:(O=l==null?void 0:l.duration)!=null?O:et,className:l==null?void 0:l.className,descriptionClassName:l==null?void 0:l.descriptionClassName,invert:a,visibleToasts:ft,closeButton:(G=l==null?void 0:l.closeButton)!=null?G:S,interacting:lt,position:d,style:l==null?void 0:l.style,unstyled:l==null?void 0:l.unstyled,classNames:l==null?void 0:l.classNames,cancelButtonStyle:l==null?void 0:l.cancelButtonStyle,actionButtonStyle:l==null?void 0:l.actionButtonStyle,removeToast:ct,toasts:B.filter(k=>k.position==p.position),heights:nt.filter(k=>k.position==p.position),setHeights:it,expandByDefault:w,gap:at,loadingIcon:X,expanded:Y,pauseWhenPageIsHidden:rt,swipeDirections:e.swipeDirections})})):null}))});export{$e as Toaster,ue as toast,Oe as useSonner};\n//# sourceMappingURL=index.mjs.map","import {motion} from \"framer-motion\";\nimport {Button} from \"@/components/ui/button\";\nimport {useHeaderContext} from \"@/context/header-context\";\n\ninterface ProgressPagesProps {\n\n    mode: 'create' | 'update'\n    onClose: () => void\n}\n\n\nexport const SuccessSheetTriggered = ({mode, onClose}: ProgressPagesProps) => {\n\n\n    const {setHeader} = useHeaderContext()\n\n    // Checkmark animation variants\n    const checkmarkVariants = {\n        hidden: {pathLength: 0, opacity: 0},\n        visible: {\n            pathLength: 1,\n            opacity: 1,\n            transition: {duration: 0.5, ease: \"easeInOut\"}\n        }\n    }\n    return (<motion.div\n        key=\"complete\"\n        initial={{opacity: 0, scale: 0.5}}\n        animate={{opacity: 1, scale: 1}}\n        transition={{duration: 0.5}}\n        className=\"flex flex-col items-center justify-center h-full\"\n    >\n        <div className=\"w-24 h-24 rounded-full bg-green-100 flex items-center justify-center mb-4\">\n            <motion.svg\n                className=\"w-16 h-16 text-green-500\"\n                viewBox=\"0 0 24 24\"\n                initial=\"hidden\"\n                animate=\"visible\"\n            >\n                <motion.path\n                    d=\"M5 13l4 4L19 7\"\n                    fill=\"transparent\"\n                    strokeWidth=\"2\"\n                    stroke=\"currentColor\"\n                    strokeLinecap=\"round\"\n                    strokeLinejoin=\"round\"\n                    variants={checkmarkVariants}\n                />\n            </motion.svg>\n        </div>\n        <div className=\"flex flex-col items-center justify-center\">\n            {mode === 'create' ? (\n                <>\n                    <h2 className=\"text-2xl font-semibold mb-4 text-center\">Your Google Sheet Sync settings have been saved. The initial sync will start now and your pages will be created.</h2>\n                    <p className=\"text-sm text-gray-500 mb-4 text-center\">It can take some time for all pages to be created. You can check the status of your pages in the \"Manage\" section.</p>\n                </>\n            ) : (\n                <>\n                    <h2 className=\"text-2xl font-semibold mb-4 text-center\">Your Google Sheet Sync settings have been saved. The initial sync will start now and your pages will be updated.</h2>\n                    <p className=\"text-sm text-gray-500 mb-4 text-center\">It can take some time for all pages to be updated. You can check the status of your pages in the \"Manage\" section.</p>\n                </>\n            )}\n        </div>\n        <div className=\"flex flex-col sm:flex-row gap-4\">\n            <Button className=\"mt-4\" data-testid=\"go-to-manage-button\" onClick={() => {\n                setHeader('manage')\n                onClose()\n            }} variant=\"outline\">\n                Close\n            </Button>\n        </div>\n\n    </motion.div>)\n}","import {CellValue} from \"read-excel-file\";\n\n// Helper function to sanitize strings similar to WordPress's sanitize_title_with_dashes\nfunction sanitizeSlug(str: string): string {\n    return str\n        .toLowerCase()\n        .replace(/\\s+/g, '-')         // Replace spaces with hyphens first\n        .replace(/[^a-z0-9-]/g, '')   // Remove special characters except hyphens\n        .replace(/-+/g, '-')          // Replace multiple hyphens with single hyphen\n        .trim();                      // Trim leading/trailing spaces\n}\n\nexport function replaceValues(\n    slugTemplate: string,\n    row: Record<string, any>,\n    headers?: string[],\n    sanitizeKeys: boolean = false\n): string {\n    // If sanitizeKeys is true, create sanitized versions of the data\n    if (sanitizeKeys) {\n        if (Array.isArray(row) && headers) {\n            headers = headers.map(header => sanitizeSlug(header));\n        } else if (!Array.isArray(row)) {\n            const sanitizedRow: Record<string, CellValue> = {};\n            Object.entries(row).forEach(([key, value]) => {\n                sanitizedRow[sanitizeSlug(key)] = value;\n            });\n            row = sanitizedRow;\n        }\n    }\n\n    return slugTemplate.replace(/{([^}]+)}/g, (_, key) => {\n        const lookupKey = sanitizeKeys ? \n            // For the lookup key, we need to find the original key that matches the sanitized version\n            Object.keys(row).find(k => sanitizeSlug(k) === sanitizeSlug(key)) || key :\n            key;\n        \n        if (Array.isArray(row) && headers) {\n            const index = headers.indexOf(lookupKey);\n            if (index !== -1 && row[index] !== undefined) {\n                return String(row[index]);\n            }\n        } else if (!Array.isArray(row)) {\n            const value = (row as Record<string, CellValue>)[lookupKey];\n            if (value !== undefined) {\n                return String(value);\n            }\n        }\n        return `{${key}}`;\n    });\n}\n","'use client'\nimport {useEffect, useState} from \"react\"\nimport {Button} from \"@/components/ui/button\"\nimport {\n    ArrowLeftIcon,\n    ArrowRightIcon,\n    ExclamationTriangleIcon,\n    EyeIcon,\n    EyeSlashIcon\n} from \"@heroicons/react/24/outline\"\nimport {Switch} from \"@/components/ui/switch\"\nimport {Label} from \"@/components/ui/label\"\nimport {DuplicateWarning} from \"@/components/dashboard/save/confirm/components/DuplicateWarning\";\nimport {ModalWrapper} from \"@/components/dashboard/save/components/ModalWrapper\";\nimport {ConfirmCreateTable} from \"@/components/dashboard/save/confirm/components/table/ConfirmCreateTable\";\nimport {WarningDialog} from \"@/components/common/WarningDialog\";\nimport {ProgressPages} from \"@/components/dashboard/save/confirm/components/progress/progresspages\";\nimport {FormDataWithExtractResult} from \"@/hooks/generation/extract/use-extract-data\";\nimport {useUpsertLpageryProcess} from \"@/hooks/dashboard/confirm/use-create-process\";\nimport {useQueryClient} from \"@tanstack/react-query\";\nimport {DashboardUpdateType, UpdateType} from \"@/model/dashboard/dashboard-form-model\";\nimport {ErrorBoundaryWrapper} from \"@/components/layout/error/ErrorBoundaryWrapper\";\nimport {InformationCircleIcon} from '@heroicons/react/20/solid'\nimport {useSubscription} from \"@/hooks/subscription/use-subscription\";\nimport {toast} from \"sonner\";\nimport {Field, Select} from '@headlessui/react'\nimport { SuccessSheetTriggered } from \"./progress/success_sheet_triggered\"\nimport {useImageProcessingEnabled} from \"@/hooks/settings/use-image-processing-enabled\";\nimport usePost from \"@/hooks/dashboard/query/use-post\";\nimport {replaceValues} from \"@/hooks/generation/replace/replace-values\";\n\ntype ExistingPageUpdateAction = 'create' | 'ignore' | 'update';\n\ninterface Props {\n    onboarding?: boolean;\n    mode: 'create' | 'update';\n    result: FormDataWithExtractResult;\n    isOpen: boolean;\n    setIsOpen: (opened: boolean) => void;\n    onClose?: () => void;\n    onStart?: () => void;\n    process_id?: number;\n    includeParentAsIdentifierProp?: boolean;\n}\n\nexport function ConfirmCreationModal({ mode, result, isOpen, setIsOpen, process_id, onClose, onStart, onboarding = false, includeParentAsIdentifierProp = false }: Props) {\n    const isUpdateMode = mode === 'update';\n\n    const form = result.formData\n    const { data: upsertProcessResponse, upsertProcess, error: processError, isPending: upsertProcessPending } = useUpsertLpageryProcess();\n\n    const {data: settingsData} = useImageProcessingEnabled()\n    const [extractResultLoading, setExtractResultLoading] = useState(false)\n    const [checkingTimeouted, setCheckingTimeouted] = useState(false);\n    const [showOnlyManualEdits, setShowOnlyManualEdits] = useState(false);\n    const [includeParentAsIdentifier, setIncludeParentAsIdentifier] = useState(includeParentAsIdentifierProp)\n    let template_id = form.config?.template;\n\n    let updateTypes: UpdateType[] = []\n    const isSheetSync = form.input?.source === 'sheet' && form.input?.sheet?.sync_settings?.enabled;\n\n    if (isUpdateMode) {\n        const updateForm = form as DashboardUpdateType\n        template_id = updateForm.updateSelection.template;\n        updateTypes = updateForm.updateType;\n    }\n\n    const { data: postData } = usePost(template_id);\n    const singularPostType = postData?.type?.singular ?? 'Page';\n    const pluralPostType = postData?.type?.plural ?? 'Pages';\n\n\n    const {free, extended} = useSubscription()\n    const [isCreating, setIsCreating] = useState(false)\n    const [isWarningOpen, setIsWarningOpen] = useState(false)\n    const [previewMode, setPreviewMode] = useState(false)\n    const [overwriteManualChanges, setOverwriteManualChanges] = useState(false)\n    \n    const [pagesToCreate, setPagesToCreate] = useState(result.extractResult?.data?.length || 0)\n\n    const [isSheetSyncTriggered, setIsSheetSyncTriggered] = useState(false)\n    const queryClient = useQueryClient()\n    const [existingPageUpdateAction, setExistingPageUpdateAction] = useState<ExistingPageUpdateAction>('create');\n\n\n    useEffect(() => {\n        if(isOpen) {\n            setIncludeParentAsIdentifier(includeParentAsIdentifierProp);\n            setShowOnlyManualEdits(false)\n            setCheckingTimeouted(false)\n            setOverwriteManualChanges(false)\n            setExistingPageUpdateAction('create')\n\n        }\n    }, [isOpen]);\n\n    useEffect(() => {\n        if(postData && postData.type?.hierarchical && includeParentAsIdentifier) {\n            setPagesToCreate(new Set(result.extractResult?.data?.map(entry => entry.slug + (replaceValues((entry.config_data?.parent ||\"\"), entry.placeholder_data) || ''))).size || 0)\n        } else {\n            setPagesToCreate(new Set(result.extractResult?.data?.map(entry => entry.slug)).size || 0)\n\n        }\n    }, [result, postData, includeParentAsIdentifier]);\n\n\n\n    const initializePageCreation = async () => {\n        await queryClient.cancelQueries({queryKey: ['confirm-dialog']})\n        if (!isUpdateMode || process_id) {\n            await upsertProcess(form, overwriteManualChanges, updateTypes.includes('look'),includeParentAsIdentifier, process_id, existingPageUpdateAction)\n        } else {\n            setIsCreating(true)\n        }\n    }\n\n\n    useEffect(() => {\n        if (upsertProcessResponse && upsertProcessResponse.success && upsertProcessResponse.process_id) {\n            if(isSheetSync) {\n               setIsSheetSyncTriggered(true)\n            } else {\n                setIsCreating(true)\n            }\n        }\n    }, [upsertProcessResponse, processError])\n\n    useEffect(() => {\n        if(isCreating) {\n            onStart && onStart()\n        }\n    }, [onStart,isCreating]);\n\n    const [imageToastShown, setImageToastShown] = useState(false);\n\n    useEffect(() => {\n        if(settingsData) {\n            const hasImageHeaders = result.extractResult.headers.find(value => value.type === 'image');\n            const shouldShowToast = !settingsData.image_processing && hasImageHeaders && !imageToastShown;\n            \n            if(shouldShowToast && extended) {\n                toast.error(\n                    'Image processing is disabled. Please enable it in the settings to continue.',\n                    {\n                        id: 'image-processing-disabled',\n                        position: 'top-center'\n                    }\n                );\n                setImageToastShown(true);\n            }\n        }\n    }, [settingsData, imageToastShown]);\n\n    const close = () => {\n        setIsOpen(false)\n    }\n    const handleCloseProgress = () => {\n        setIsCreating(false);\n        onClose && onClose()\n        // Add a small delay before closing the main modal\n        setTimeout(() => close(), 120);\n    };\n\n    const renderWarning = () => {\n\n        const maybeShowModifiedWarning = (updateTypes.includes('content') || updateTypes.includes('look')) && isUpdateMode && (result.extractResult.manuallyUpdated && result.extractResult.manuallyUpdated > 0);\n        return (\n            <div>\n                <p className={'text-sm text-gray-500'}>\n                    Are you sure you want\n                    to {isUpdateMode ? 'update' : 'create'} {previewMode ? 'one ' + singularPostType : (pagesToCreate + ' ' + pluralPostType)}?\n                </p>\n                {maybeShowModifiedWarning  && overwriteManualChanges ?\n                    <p className={'text-sm text-red-500'}>{result.extractResult.manuallyUpdated} {pluralPostType} with manual changes\n                        will be overwritten</p> : <></>}\n                {maybeShowModifiedWarning && !overwriteManualChanges ? (<p className={'text-sm text-gray-500'}>{result.extractResult.manuallyUpdated} {pluralPostType} with manual changes\n                        will be preserved and not overwritten</p>) : <></>}\n                {extractResultLoading ? (\n                    <p className={'text-sm bg-yellow-50 p-4 rounded-md text-yellow-700'}>Validation checks for duplicate slugs are in progress. We recommend waiting for the check to complete, but you can proceed if you're confident no duplicates exist. If duplicates are found, they will be skipped or numbered automatically (\"-2\" suffix).</p>\n                ) : <></>}\n\n            </div>\n        )\n    }\n\n    function renderOverwriteDataSwitch() {\n        if (!isUpdateMode || !((updateTypes?.includes('content') || updateTypes?.includes('look')) && result.extractResult.manuallyUpdated && result.extractResult.manuallyUpdated > 0)) {\n            return null;\n        }\n\n        return (\n            <div className=\"flex items-start space-x-4 mt-2 border-gray-200 border-b pb-4 bg-yellow-50 p-4 rounded-lg\">\n                <ExclamationTriangleIcon className=\"h-6 w-6 text-yellow-600 shrink-0 mt-1\" />\n                <div className=\"flex-1\">\n                    <div className=\"flex items-center gap-2 text-base font-medium text-yellow-700\">\n                        <span>{result.extractResult.manuallyUpdated} {pluralPostType.toLowerCase()} contain manual edits. These {pluralPostType.toLowerCase()} will be</span>\n                        <div className=\"relative\">\n                            <Field>\n                                <Select \n                                    data-testid=\"overwrite-manual-changes-select\"\n                                    value={overwriteManualChanges ? \"overwrite\" : \"preserve\"}\n                                    onChange={(e) => setOverwriteManualChanges(e.target.value === \"overwrite\")}\n                                    className=\"w-[140px] bg-white border border-gray-300 rounded-md py-2 px-3 text-left cursor-default focus:outline-none focus:ring-1 focus:ring-custom-blue-600 focus:border-custom-blue-600 data-[hover]:shadow cursor-pointer\"\n                                >\n                                    <option \n                                        value=\"preserve\" \n                                        data-testid=\"preserve-manual-changes-select-option\"\n                                        className=\"py-2 px-3 hover:bg-blue-50 cursor-pointer text-gray-900\"\n                                    >\n                                        Preserved\n                                    </option>\n                                    <option \n                                        value=\"overwrite\" \n                                        data-testid=\"overwrite-manual-changes-select-option\"\n                                        className=\"py-2 px-3 hover:bg-blue-50 cursor-pointer text-gray-900\"\n                                    >\n                                        Overwritten\n                                    </option>\n                                </Select>\n                            </Field>\n                        </div>\n                    </div>\n                    \n                    <p className=\"text-sm text-gray-600 mt-2\">\n                        {overwriteManualChanges \n                            ? `Overwritten: Any custom changes made to the manually modified ${pluralPostType.toLowerCase()} will be lost.`\n                            : `Preserved: Existing manual changes will be kept, and these ${pluralPostType.toLowerCase()} will not be updated.`\n                        }\n                    </p>\n\n                    {overwriteManualChanges && (\n                        <p className=\"text-sm text-red-500 mt-2 flex items-center gap-2\">\n                            <ExclamationTriangleIcon className=\"h-4 w-4\" />\n                            Warning: This will permanently replace any custom changes you made to the modified {pluralPostType.toLowerCase()}.\n                        </p>\n                    )}\n                    \n                    <Button\n                        variant=\"link\"\n                        size=\"sm\"\n                        onClick={() => setShowOnlyManualEdits(!showOnlyManualEdits)}\n                        className=\"mt-2 p-0 text-gray-600 hover:text-gray-800 underline\"\n                    >\n                        {showOnlyManualEdits ? `Show All ${pluralPostType}` : `Show Only Modified ${pluralPostType}`}\n                    </Button>\n                </div>\n            </div>\n        );\n    }\n\n    function renderPreviewSwitch() {\n        return !isUpdateMode &&\n            <div className=\"flex items-center justify-between mt-2 border-gray-200 border-b pb-4\">\n                <div className=\"flex items-start space-x-4\">\n                    {previewMode ? (\n                        <EyeIcon className=\"h-5 w-5 mt-1 text-gray-500\" />\n                    ) : (\n                        <EyeSlashIcon className=\"h-5 w-5 mt-1 text-gray-500\" />\n                    )}\n                    <div>\n                        <Label className=\"text-sm font-medium leading-6 text-gray-900\">\n                            {previewMode ? \"Preview Mode enabled\" : \"Preview Mode disabled\"}\n                        </Label>\n                        <p className=\"text-sm text-gray-500\">\n                            {previewMode ? \"Use the switch to update all pages.\" : \"Use the switch to update only the first page.\"}\n                        </p>\n                    </div>\n                </div>\n                <Switch\n                    id=\"preview-mode\"\n                    checked={previewMode}\n                    onCheckedChange={setPreviewMode}\n                    className=\"group relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent bg-gray-200 transition-colors duration-200 ease-in-out focus:outline-none\"\n                >\n                    <span\n                        aria-hidden=\"true\"\n                        className=\"pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out group-data-[state=checked]:translate-x-5\"\n                    />\n                </Switch>\n            </div>;\n    }\n\n\n    return (\n        <>\n            <ModalWrapper isOpen={isOpen} onClose={() => {\n            }}>\n                <div className=\"p-6 space-y-4 flex-grow flex flex-col\">\n\n\n\n                    {!isCreating && !isSheetSyncTriggered ? (\n                        <>\n                            <div className=\"sm:flex-col col sm:items-center justify-between\">\n                                <div className=\"sm:flex-auto\">\n                                    <h1 className=\"text-4xl font-bold leading-6 text-gray-900\">\n                                        {isUpdateMode ? \"Confirm Update\" : \"Confirm Creation\"}\n                                    </h1>\n                                    <p className=\"mt-4 text-sm text-gray-700 max-w-3xl\">\n                                        Every row represents one {singularPostType.toLowerCase()} to be {isUpdateMode ? \"updated\" : \"generated\"}.\n                                    </p>\n                                </div>\n                            </div>\n                            <ConfirmCreateTable result={result} process_id={process_id}\n                                slug={result.formData.config?.slug} mode={mode} showOnlyManualEdits={showOnlyManualEdits} />\n                            {free && result.extractResult.headers.find(value => value.licenseNeeded && value.type === 'data') &&<div className=\"rounded-md bg-blue-50 p-4 mb-4\">\n                                <div className=\"flex\">\n                                    <div className=\"shrink-0\">\n                                        <InformationCircleIcon className=\"size-5 text-blue-400\" aria-hidden=\"true\" />\n                                    </div>\n                                    <div className=\"ml-3 flex-1 md:flex md:justify-between\">\n                                       <p className=\"text-sm text-blue-700\">\n                                            Free version supports up to 3 placeholder columns. Additional columns will be ignored.\n                                        </p>\n                                        <p className=\"mt-3 text-sm md:ml-6 md:mt-0\">\n                                            <a href=\"https://lpagery.io/pricing?utm_source=free_version&utm_medium=banner_onboarding&utm_campaign=free\" target={'_blank'} className=\"whitespace-nowrap font-medium text-blue-700 hover:text-