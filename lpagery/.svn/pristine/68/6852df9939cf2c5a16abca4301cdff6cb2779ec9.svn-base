 useFormContext} from \"react-hook-form\";\nimport {MapPinIcon} from \"@heroicons/react/24/outline\";\nimport {DashboardFormType} from \"@/model/dashboard/dashboard-form-model\";\n\ninterface PageSelectProps {\n    name: string;\n}\n\nexport interface Location {\n    id: string;\n    label: string;\n    lat: number;\n    lon: number;\n}\n\nexport const LocationSelect = React.forwardRef<HTMLButtonElement, PageSelectProps>(({}, ref) => {\n    const [open, setOpen] = useState(false);\n    const [searchValue, setSearchValue] = useState(\"\");\n    const [locations, setLocations] = useState<Location[]>()\n    const [selectedLocation, setSelectedLocation] = useState<Location>()\n    const [debouncedSearchValue, setDebouncedSearchValue] = useState(searchValue);\n    const {control, watch} = useFormContext<DashboardFormType>()\n\n    const fieldWatch = watch('input.radius.location')\n    const locationResponse = useLocations(debouncedSearchValue)\n\n    useEffect(() => {\n        if (locationResponse.locations) {\n            setLocations(locationResponse.locations);\n        }\n    }, [locationResponse]);\n\n    useEffect(() => {\n        const handler = setTimeout(() => {\n            setDebouncedSearchValue(searchValue);\n        }, 300);\n\n        return () => {\n            clearTimeout(handler);\n        };\n    }, [searchValue]);\n\n    useEffect(() => {\n        if (fieldWatch && !selectedLocation) {\n            setSelectedLocation(fieldWatch);\n        }\n    }, [fieldWatch, selectedLocation]);\n\n    return (\n        <Controller name={'input.radius.location'} control={control} render={({field}) => {\n            return (<Popover open={open} onOpenChange={setOpen}>\n                <PopoverTrigger asChild>\n                    <Button\n                        ref={ref}\n                        variant=\"outline\"\n                        role=\"combobox\"\n                        aria-expanded={open}\n                        className=\"flex h-10 w-full items-center justify-between rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 [&>span]:line-clamp-1\"\n                    >\n                        <div className=\"flex items-center w-full\">\n                            <MapPinIcon className=\"mr-2 h-4 w-4 shrink-0 opacity-50\"/>\n                            <span className={`${selectedLocation ? \"\" : \"text-muted-foreground\"} truncate`}>\n                                {selectedLocation ? selectedLocation.label : \"Enter location\"}\n                            </span>\n                        </div>\n                    </Button>\n                </PopoverTrigger>\n\n                <PopoverContent className=\"w-[600px] p-0\">\n                    <Command>\n                        <CommandInput\n                            placeholder=\"Search Locations...\"\n                            onInput={(event) => {\n                                setSearchValue(event.currentTarget.value);\n                            }}\n                        />\n                        <CommandList>\n                            <CommandEmpty>No places found.</CommandEmpty>\n                            <CommandGroup>\n                                {locations?.map((location: Location) => (\n                                    <CommandItem\n                                        key={location.id}\n                                        value={location.label + location.id}\n                                        onSelect={() => {\n                                            field.onChange(location);\n                                            setSelectedLocation(location);\n                                            setOpen(false);\n                                        }}\n                                    >\n                                        <Check\n                                            className={cn(\n                                                \"mr-2 h-4 w-4\",\n                                                selectedLocation?.id === location.id ? \"opacity-100\" : \"opacity-0\"\n                                            )}\n                                        />\n                                        {location.label}\n                                    </CommandItem>\n                                ))}\n                            </CommandGroup>\n                        </CommandList>\n                    </Command>\n                </PopoverContent>\n            </Popover>)\n        }}/>\n    );\n});\n\nLocationSelect.displayName = 'LocationSelect';\n","/**\n * v0 by Vercel.\n * @see https://v0.dev/t/Ew8m4Z3EZqN\n * Documentation: https://v0.dev/docs#integrating-generated-code-into-your-nextjs-app\n */\n\nimport {LocationSelect} from \"@/components/dashboard/save/upload/LocationAutocomplete\";\nimport {useFormContext} from \"react-hook-form\";\nimport {FormFieldWrapper} from \"@/components/common/FormFieldWrapper\";\nimport {DashboardFormType} from \"@/model/dashboard/dashboard-form-model\";\nimport {Input} from \"@/components/ui/input\";\n\n\nexport default function RadiusSelectArea() {\n    const {formState: {errors}, register} = useFormContext<DashboardFormType>()\n\n    return (\n\n        <div className={'space-y-4'}>\n            <div className=\"sm:col-span-4 space-y-2\">\n                <FormFieldWrapper label={'Location'} license={'standard'}\n                                  error={(errors.input as any)?.radius?.location?.message}\n                                  description={'Enter the central location for your radius search'}>\n                    <LocationSelect {...register('input.radius.location')} />\n\n                </FormFieldWrapper>\n\n            </div>\n            <div className=\"grid grid-cols-1 sm:grid-cols-1 md:grid-cols-1 lg:grid-cols-3 gap-4\">\n                <FormFieldWrapper label={'Minimum Population'} license={'standard'}\n                                  error={(errors.input as any)?.radius?.population?.message}\n                                  description={'Set the minimum population for cities to include'}>\n                    <Input placeholder={'e.g. 10000'} type={'number'} step={1}\n                           min={0} {...register('input.radius.population', {\n                        valueAsNumber: true,\n                    })} />\n                </FormFieldWrapper>\n                <FormFieldWrapper label={'Radius (km)'} license={'standard'}\n                                  error={(errors.input as any)?.radius?.kilometers?.message}\n                                  description={'Specify the search radius in kilometers'}>\n                    <Input placeholder={'e.g. 25'} type={'number'} step={1}\n                           min={0} {...register('input.radius.kilometers', {\n                        valueAsNumber: true,\n                    })} />\n                </FormFieldWrapper>\n                <FormFieldWrapper label={'Max Fetched Cities'} license={'standard'}\n                                  error={(errors.input as any)?.radius?.amount?.message}\n                                  description={'Limit the number of cities to fetch'}>\n                    <Input placeholder={'e.g. 50'} type={'number'} step={1}\n                           min={0} {...register('input.radius.amount', {\n                        valueAsNumber: true,\n                    })} />\n                </FormFieldWrapper>\n            </div>\n        </div>\n    )\n}","import {Control, Controller} from \"react-hook-form\";\nimport {Switch} from \"@/components/ui/switch\";\nimport React from \"react\";\n\ninterface Props extends React.ComponentPropsWithoutRef<typeof Switch> {\n    control: Control<any>;\n    name: string;\n}\n\ninterface ControlledProps extends React.ComponentPropsWithoutRef<typeof Switch> {\n    field: any;\n}\n\nconst