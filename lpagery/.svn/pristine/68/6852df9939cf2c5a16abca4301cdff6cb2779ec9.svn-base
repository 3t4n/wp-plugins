e = _step.value,\n        id = _step$value.id,\n        _data = _step$value.data;\n    xl.file(\"worksheets/sheet\".concat(id, \".xml\"), _data);\n  }\n\n  return zip.generateAsync({\n    type: 'blob',\n    mimeType: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',\n    compression: 'deflate'\n  });\n}\n//# sourceMappingURL=writeXlsxFileBrowser.js.map","import {Button} from \"@/components/ui/button\";\nimport {\n    ArrowDownOnSquareIcon,\n    ArrowLeftIcon,\n    ArrowRightIcon,\n    ArrowTopRightOnSquareIcon\n} from \"@heroicons/react/24/outline\";\nimport {InformationCircleIcon} from '@heroicons/react/20/solid'\n// @ts-ignore\nimport SourcefileImage from '@/assets/onboarding/SourceFileNeu2.png';\n// @ts-ignore\nimport SourcefileThumbnail from '@/assets/onboarding/SourceThumbnail.png';\nimport {UploadFileArea} from \"@/components/dashboard/save/upload/UploadFileArea\";\nimport {useFormContext} from \"react-hook-form\";\nimport {DashboardFormType} from \"@/model/dashboard/dashboard-form-model\";\nimport {useRef, useState} from \"react\";\nimport {Video} from \"@/components/ui/video\";\nimport writeXlsxFile from \"write-excel-file\";\n\ninterface Step1Props {\n    handleNextStep: () => void;\n    handlePreviousStep: () => void;\n}\n\nconst downloadSampleFile = async (e: React.MouseEvent) => {\n    e.preventDefault();\n    const data = [\n        [\n            { value: 'service', type: String },\n            { value: 'city', type: String }\n        ],\n        [\n            { value: 'Window Cleaning', type: String },\n            { value: 'Manhattan', type: String }\n        ],\n        [\n            { value: 'Floor Cleaning', type: String }, \n            { value: 'Brooklyn', type: String }\n        ]\n    ];\n\n    await writeXlsxFile(data, {\n        fileName: 'lpagery-sample-source-file.xlsx',\n        sheet: 'Sample Data'\n    });\n};\n\n\n// Construct the URL with parameters\nconst sourceFileCreatorUrl = `https://lpagery.io/lpagery-source-file-generator-v2/`;\n\nexport function Step3({ handleNextStep, handlePreviousStep }: Step1Props) {\n    const { watch } = useFormContext<DashboardFormType>();\n    const uploadedFile = watch('input.file');\n\n    return (\n        <div className=\"max-w-3/4 mx-auto\">\n            <div className=\"bg-white rounded-lg shadow-lg border p-3 sm:p-8 space-y-4 sm:space-y-8\">\n                <div className=\"space-y-3 sm:space-y-4\">\n                    <UploadFileArea onboarding={true} />\n                    <div className=\"rounded-md bg-blue-50 p-3 sm:p-4\">\n                        <div className=\"flex flex-col sm:flex-row\">\n                            <div className=\"shrink-0 mb-2 sm:mb-0\">\n                                <InformationCircleIcon className=\"size-4 sm:size-5 text-blue-400\" aria-hidden=\"true\" />\n                            </div>\n                            <div className=\"sm:ml-3 flex-1 flex flex-col sm:flex-row sm:justify-between\">\n                                <p className=\"text-xs sm:text-sm text-blue-700 mb-2 sm:mb-0\">\n                                   Our Free version supports up to 3 placeholder columns. Additional columns will be ignored.\n                                </p>\n                                <p className=\"sm:ml-6\">\n                                    <a href=\"https://lpagery.io/pricing?utm_source=free_version&utm_medium=banner_onboarding&utm_campaign=free\" \n                                       className=\"text-xs sm:text-sm whitespace-nowrap font-medium text-blue-700 hover:text-blue-600\">\n                                        Upgrade to Pro\n                                        <span aria-hidden=\"true\"> &rarr;</span>\n                                    </a>\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <div className=\"flex flex-col sm:flex-row justify-between pt-3 sm:pt-4 space-y-3 sm:space-y-0\">\n                    <Button onClick={handlePreviousStep} variant=\"outline\" className=\"w-full sm:w-auto\" event=\"Onboarding Back On Upload Source File\">\n                        <ArrowLeftIcon className=\"h-4 w-4 sm:h-5 sm:w-5 mr-2\" aria-hidden=\"true\" /> Back\n                    </Button>\n                    <Button\n                        onClick={handleNextStep}\n                        className=\"w-full sm:w-auto bg-custom-blue-400 text-white\"\n                        disabled={!uploadedFile}\n                        event=\"Onboarding Last Step: Review & Create Pages\"\n                        data-testid=\"last-step-create-pages\"\n                    >\n                        Last Step: Review & Create Pages <ArrowRightIcon className=\"h-4 w-4 sm:h-5 sm:w-5 ml-2\" aria-hidden=\"true\" />\n                    </Button>\n                </div>\n            </div>\n        </div>\n    )\n}\n\n// Add this export for the right side explanation\nexport const Step3Explanation = () => {\n    const [showScrollIndicator, setShowScrollIndicator] = useState(true);\n\n    // Add ref for the scrollable container\n    const scrollContainerRef = useRef<HTMLDivElement>(null);\n\n    const handleScroll = (e: React.UIEvent<HTMLDivElement>) => {\n        const target = e.target as HTMLDivElement;\n        const isNearBottom = target.scrollHeight - target.scrollTop <= target.clientHeight + 100;\n        setShowScrollIndicator(!isNearBottom);\n    };\n\n    // Add scroll to bottom handler\n    const scrollToBottom = () => {\n        if (scrollContainerRef.current) {\n            scrollContainerRef.current.scrollTo({\n                top: scrollContainerRef.current.scrollHeight,\n                behavior: 'smooth'\n            });\n        }\n    };\n\n    return (\n        <div className=\"static h-full\">\n            <div\n                ref={scrollContainerRef}\n                onScroll={handleScroll}\n                className=\"px-4 lg:px-12 pt-4 lg:pt-12 overflow-y-auto scrollbar-thin scrollbar-thumb-gray-300 scrollbar-track-gray-100 hover:scrollbar-thumb-gray-400\"\n            >\n                <div className=\"relative\">\n                    <div className=\"space-y-6 pb-16\">\n                        <div className=\"w-full rounded-lg shadow-lg\">\n                            <Video\n                                src=\"https://c59trvp5ocfyno80.public.blob.vercel-storage.com/LPageryOnboardingVideos/Source%20FIle-EtOlVdoHnF19lQCLnDJI0rXcC1inKg.mp4\"\n                                poster={SourcefileThumbnail}\n                            />\n                        </div>\n\n                        <ol className=\"relative border-l border-gray-200 space-y-6 pr-4 ml-4\">\n                            <li className=\"ml-8\">\n                                <span className=\"absolute flex items-center justify-center w-6 h-6 lg:w-8 lg:h-8 bg-custom-blue-400 rounded-full -left-3 lg:-left-4 ring-4 ring-white\">\n                                    <span className=\"text-white text-xs lg:text-sm\">1</span>\n                                </span>\n                                <h2 className=\"text-base lg:text-lg font-bold mb-2 text-custom-blue-400\">Understanding Source Files</h2>\n                                <p className=\"text-gray-600 text-xs lg:text-sm mb-3 lg:mb-4\">\n                                    A source file is your way to tell LPagery exactly what pages to create and what content should appear on each page. It's a simple spreadsheet where:\n                                    <ul className=\"list-disc ml-4 mt-2\">\n                                        <li>Each <strong>row</strong> tells LPagery to create a new page with specific content</li>\n                                        <li>Each <strong>column</strong> represents different pieces of content that you want to customize on each page (like location, service type, or any other variable). The column headers must be the placeholders you set up in the previous step.</li>\n                                    </ul>\n                                </p>\n                                <p className=\"text-gray-600 text-xs lg:text-sm mt-2\">\n                                    For example, if you want to create pages for different locations, each row would represent a new location page, and the columns would contain that location's specific details (city name, state, services offered, etc.).\n                                </p>\n                            </li>\n\n                            <li className=\"ml-8\">\n                                <span className=\"absolute flex items-center justify-center w-6 h-6 lg:w-8 lg:h-8 bg-custom-blue-400 rounded-full -left-3 lg:-left-4 ring-4 ring-white\">\n                                    <span className=\"text-white text-xs lg:text-sm\">2</span>\n                                </span>\n                                <h2 className=\"text-base lg:text-lg font-bold mb-2 text-custom-blue-400\">Creating Your Source File</h2>\n                                <p className=\"text-gray-600 text-xs lg:text-sm mb-3 lg:mb-4\">\n                                    You have three ways to create your source file:\n                                </p>\n                                <ol className=\"list-decimal list-inside space-y-2 ml-4 text-xs lg:text-sm text-gray-600\">\n                                    <li>Use Excel or Google Sheets</li>\n                                    <li>Use our <a className=\"text-custom-blue-400 font-semibold\" href=\"https://lpagery.io/lpagery-source-file-generator-v2/\" target=\"_blank\" rel=\"noopener noreferrer\">Source File Creator</a></li>\n                                    <li>Download and modify our sample file</li>\n                                </ol>\n\n                                <div className=\"flex flex-col sm:flex-row gap-3 lg:gap-4 mt-4\">\n                                    <Button\n                                        variant=\"outline\"\n                                        asChild\n                                        className=\"text-custom-blue-400 border-custom-blue-400 w-full sm:w-auto text-xs lg:text-sm\"\n                                        event=\"Onboarding Open Source File Creator\"\n                                    >\n                                        <a\n                                            href={sourceFileCreatorUrl}\n                                            target=\"_blank\"\n                                            rel=\"noopener noreferrer\"\n                                        >\n                                            Open Source File Creator <ArrowTopRightOnSquareIcon className=\"h-3 w-3 lg:h-4 lg:w-4 ml-1\" />\n                                        </a>\n                                    </Button>\n                                    <Button\n                                        variant=\"outline\"\n                                        onClick={downloadSampleFile}\n                                        data-testid=\"download-sample-file\"\n                                        event=\"Onboarding Download Sample File\"\n                                        className=\"text-custom-blue-400 border-custom-blue-400 w-full sm:w-auto text-xs lg:text-sm\"\n                                    >\n                                        Download Sample File <ArrowDownOnSquareIcon className=\"h-3 w-3 lg:h-4 lg:w-4 ml-1\" />\n                                    </Button>\n                                </div>\n                            </li>\n\n                            <li className=\"ml-8\">\n                                <span className=\"absolute flex items-center justify-center w-6 h-6 lg:w-8 lg:h-8 bg-custom-blue-400 rounded-full -left-3 lg:-left-4 ring-4 ring-white\">\n                                    <span className=\"text-white text-xs lg:text-sm\">3</span>\n                                </span>\n                                <h2 className=\"text-base lg:text-lg font-bold mb-2 text-custom-blue-400\">Example: How It Works</h2>\n                                <p className=\"text-gray-600 text-xs lg:text-sm\">\n                                    Here's a simple example that would create 2 different pages for a cleaning business.\n                                    In a real scenario, you would list all your services and locations:\n                                </p>\n                                <img\n                                    src={SourcefileImage}\n                                    alt=\"Source File Example\"\n                                    className=\"rounded-lg shadow-lg w-full h-auto max-h-32 lg:max-h-40 object-contain mt-3 lg:mt-4\"\n                                />\n                                <p className=\"text-gray-600 text-xs lg:text-sm mt-2\">\n                                    In this example, we will create 2 pages. The columns (<code>service</code> and <code>city</code>)\n                                    will be available as variables that match the placeholders you set up in your template (like {'{service}'} and {'{city}'}).\n                                    This will create unique pages for \"Window Cleaning in Manhattan\" and \"Floor Cleaning in Brooklyn\".\n                                </p>\n                            </li>\n\n                            <li className=\"ml-8\">\n                                <span className=\"absolute flex items-center justify-center w-6 h-6 lg:w-8 lg:h-8 bg-custom-blue-400 rounded-full -left-3 lg:-left-4 ring-4 ring-white\">\n                                    <span className=\"text-white text-xs lg:text-sm\">4</span>\n                                </span>\n                                <h2 className=\"text-base lg:text-lg font-bold mb-2 text-custom-blue-400\">Upload Your File</h2>\n                                <p className=\"text-gray-600 text-xs lg:text-sm\">\n                                    Once your file is ready, simply drag and drop it into the upload area on the left, or click to select it from your computer.\n                                </p>\n                            </li>\n                        </ol>\n                    </div>\n                </div>\n            </div>\n\n            {/* Updated scroll indicator to be clickable */}\n            {showScrollIndicator && (\n                <div\n                    className=\"fixed lg:absolute bottom-0 left-0 right-0 h-16 lg:h-24 cursor-pointer\"\n                    onClick={scrollToBottom}\n                >\n                    <div className=\"absolute inset-0 bg-gradient-to-t from-white via-white/80 to-transparent shadow-lg\" />\n                    <div className=\"absolute bottom-4 left-1/2 -translate-x-1/2 animate-bounce\">\n                        <svg\n                            xmlns=\"http://www.w3.org/2000/svg\"\n                            className=\"h-4 w-4 lg:h-6 lg:w-6 text-custom-blue-400\"\n                            fill=\"none\"\n                            viewBox=\"0 0 24 24\"\n                            stroke=\"currentColor\"\n                        >\n                            <path\n                                strokeLinecap=\"round\"\n                                strokeLinejoin=\"round\"\n                                strokeWidth={2}\n                                d=\"M19 14l-7 7m0 0l-7-7m7 7V3\"\n                            />\n                        </svg>\n                    </div>\n                </div>\n            )}\n        </div>\n    )\n}","export default \"__VITE_ASSET__CEf5h2JM__\"","'use client'\nimport {useEffect, useState} from 'react'\nimport {InfoIcon, Layout, PenLine, Users} from 'lucide-react'\n// @ts-ignore\nimport CreatedPagesImage from '@/assets/onboarding/created_pages.png';\n// @ts-ignore\nimport SourcefileImage from '@/assets/onboarding/sourcefile.png';\n\n// @ts-ignore\nimport TemplatePageImage from '@/assets/onboarding/template_page.png';\nimport {FormDataWithExtractResult, useExtractData} from \"@/hooks/generation/extract/use-extract-data\";\nimport {FormProvider, useForm} from \"react-hook-form\";\nimport {\n    DashboardCreateSchema,\n    DashboardCreateType,\n    InputFormValues,\n    OnboardingSchema, OnboardingType\n} from \"@/model/dashboard/dashboard-form-model\";\nimport {zodResolver} from \"@hookform/resolvers/zod\";\nimport Step1 from \"@/components/onboarding/steps/Step1\";\nimport {Step2, Step2Explanation} from \"@/components/onboarding/steps/Step2\";\nimport {Step4Content} from \"@/components/onboarding/steps/Step4\";\nimport {ConfirmCreationModal} from \"@/components/dashboard/save/confirm/components/ConfirmCreationModal\";\nimport usePostTitleAsSlug from \"@/hooks/dashboard/query/use-post-title-as-slug\";\nimport {Step1Explanation} from './steps/Step1';\nimport {Step3, Step3Explanation} from './steps/Step3';\nimport {Step4Explanation} from './steps/Step4';\n// @ts-ignore\nimport Logo from '@/assets/LP_Logo_horizontal_2022_RZ.png'\nimport { usePostHog } from 'posthog-js/react';\nimport { Button } from '@/components/ui/button';\n\ninterface Props {\n    onOnboardingFinished: () => void\n}\n\nexport default function Onboarding({ onOnboardingFinished }: Props) {\n    const posthog = usePostHog();\n    const [currentStep, setCurrentStep] = useState(() => {\n        // Initialize from sessionStorage or default to 1\n        const step = Number(sessionStorage.getItem('onboarding_step')) || 1\n        // If step is 3 or 4, set it to 2\n        return step >= 4 ? 3 : step\n    })\n    \n    // Update sessionStorage whenever currentStep changes\n    useEffect(() => {\n        sessionStorage.setItem('onboarding_step', currentStep.toString())\n    }, [currentStep])\n\n    const [expandedStep, setExpandedStep] = useState<number>(0)\n    const [error, setError] = useState<string>()\n    const handleNextStep = () => {\n        const nextStep = Math.min(steps.length, currentStep + 1)\n        setCurrentStep(nextStep)\n        setExpandedStep(nextStep - 1)  // Expand the new active step\n    }\n\n    const handlePreviousStep = () => {\n        const prevStep = Math.max(1, currentStep - 1)\n        setCurrentStep(prevStep)\n        setExpandedStep(prevStep - 1)  // Expand the new active step\n    }\n\n    useEffect(() => {\n        window.scrollTo({ top: 0, behavior: 'smooth' });\n    }, []);\n\n    function skipOnboarding() {\n        sessionStorage.removeItem('onboarding_step');\n        sessionStorage.removeItem('onboarding_form');\n        posthog.capture('Onboarding skipped');\n        onOnboardingFinished();\n    }\n\n    const steps = [\n        {\n            title: 'Let\\'s create your first pages in under 5 minutes!',\n            icon: InfoIcon,\n            component: <Step1 \n                handleNextStep={handleNextStep} \n                onSkipOnboarding={skipOnboarding}\n            />,\n            description: \"Below you can see how LPagery works. We will guide you through the process and get your first set of pages running in under 5 minutes.\"\n        },\n        {\n            title: 'Step 1: Create & Select Your Template Page',\n            icon: Layout,\n            component: <Step2 handleNextStep={handleNextStep} handlePreviousStep={handlePreviousStep} />,\n            description: \"Choose a template that will serve as the foundation for your pages.\"\n        },\n        {\n            title: 'Step 2: Upload your Source File',\n            icon: PenLine,\n            component: <Step3 handleNextStep={handleNextStep} handlePreviousStep={handlePreviousStep} />,\n            description: \"Upload your data file containing the information for your pages.\"\n        },\n        {\n            title: 'Step 3: Review & Bulk Create Pages',\n            icon: Users,\n            component: <Step4Content\n                handleNextStep={() => {\n                    setCreationDashboardModalOpened(true)\n                }}\n                handlePreviousStep={handlePreviousStep}\n            />,\n            description: \"Nearly done! Click the button below to review and create your pages.\"\n        },\n    ]\n\n    const explanationComponents = [\n        <Step1Explanation />,\n        <Step2Explanation />,\n        <Step3Explanation />,\n        <Step4Explanation />\n    ];\n\n    const toggleExpand = (index: number) => {\n        setExpandedStep(expandedStep === index ? -1 : index)\n    }\n\n\n    const [formResult, setFormResult] = useState<FormDataWithExtractResult>()\n\n    const methods = useForm<DashboardCreateType>({\n        resolver: zodResolver(OnboardingSchema),\n        defaultValues: (() => {\n            // Try to get saved form data from sessionStorage\n            const savedForm = sessionStorage.getItem('onboarding_form')\n            if (savedForm) {\n                return JSON.parse(savedForm)\n            }\n            // Fall back to default values if nothing is saved\n            return {\n                template_created: false,\n                config: {\n                    purpose: 'My first set of pages',\n                    template: 0,\n                    slug: '',\n                    status: 'private',\n                    categories: [],\n                    tags: [],\n                },\n                input: {\n                    source: 'file',\n                } as InputFormValues,\n            } as OnboardingType\n        })()\n    });\n\n    // Save form values whenever they change\n    const formValues = methods.watch();\n    useEffect(() => {\n        // Create a copy of formValues and remove file data before storing\n        const valuesToStore = JSON.parse(JSON.stringify(formValues));\n        if (valuesToStore.input?.file) {\n            delete valuesToStore.input.file;\n        }\n        sessionStorage.setItem('onboarding_form', JSON.stringify(valuesToStore));\n    }, [formValues]);\n\n    const { getValues, handleSubmit, watch } = methods;\n    const templateWatch = watch('config.template');\n\n    const { data: slugResponse } = usePostTitleAsSlug(templateWatch)\n\n    useEffect(() => {\n        if (slugResponse) {\n            methods.setValue('config.slug', slugResponse.slug)\n        }\n    }, [slugResponse]);\n\n    const { extractData } = useExtractData(getValues('config'));\n\n    const [creationDashboardModalOpened, setCreationDashboardModalOpened] = useState(true)\n\n    const onSubmit = async () => {\n        const data = methods.getValues();\n\n        try {\n            const result = await extractData(data.input, data.config.slug)\n            setFormResult({ formData: data, extractResult: result });\n        } catch (e: any) {\n            console.log(JSON.stringify(e))\n            setError(JSON.stringify(e))\n        }\n    };\n\n    function classNames(...classes: string[]) {\n        return classes.filter(Boolean).join(' ')\n    }\n\n    // Add this after the steps array definition\n    const stepperSteps = [\n        { id: 'Step 1', name: 'Select Template Page', href: '#', status: 'complete' },\n        { id: 'Step 2', name: 'Upload Source File', href: '#', status: 'upcoming' },\n        { id: 'Step 3', name: 'Create Pages', href: '#', status: 'upcoming' },\n    ]\n\n    return (\n        <>\n            <FormProvider {...methods}>\n                <form onSubmit={handleSubmit(onSubmit)}>\n                    <div className=\"flex flex-col lg:flex-row\">\n                        {/* Left side: Essential steps */}\n                        <div className={classNames(\n                            \"bg-white relative flex flex-col min-h-[calc(100vh-50px)]\",\n                            currentStep === 1 ? \"w-full\" : \"w-full lg:w-[60%]\"\n                        )}>\n                            {/* Logo - absolute positioned to top */}\n                            <div className=\"absolute top-4 sm:top-8 left-4 sm:left-8\">\n                                <img\n                                    src={Logo}\n                                    alt=\"LPagery Logo\"\n                                    className=\"h-16 sm:h-24 w-auto\"\n                                />\n                            </div>\n\n                            {/* Main content - with conditional max-width */}\n                            <div className={classNames(\n                                \"flex-1 pt-32 sm:pt-48\",\n                                currentStep === 1 ? \"max-w-3/4 mx-auto w-full px-4 sm:px-8\" : \"max-w-6xl mx-auto w-full px-4 sm:px-8\"\n                            )}>\n                                {/* Welcome message - only on first step */}\n                                {currentStep === 1 && (\n                                    <div className=\"flex items-center justify-center mb-8 sm:mb-16\">\n                                        <span className=\"font-semibold text-4xl sm:text-6xl text-custom-blue-400 text-center whitespace-pre-line\">\n                                            Welcome to LPagery 👋\n                                        </span>\n                                    </div>\n                                )}\n\n                                {/* Progress stepper - only show after step 1 */}\n                                {currentStep > 1 && (\n                                    <div className=\"mb-12 sm:mb-24\">\n                                        <div className=\"bg-white\">\n                                            <nav aria-label=\"Progress\">\n                                                <ol role=\"list\" className=\"space-y-4 md:flex md:space-x-8 md:space-y-0\">\n                                                    {stepperSteps.map((step, index) => {\n                                                        const status = \n                                                            index + 1 < currentStep - 1 ? 'complete' :\n                                                            index + 1 === currentStep - 1 ? 'current' : 'upcoming'\n                                                        \n                                                        return (\n                                                            <li key={step.name} className=\"md:flex-1\">\n                                                                {status === 'complete' ? (\n                                                                    <div className=\"flex flex-col border-l-4 border-custom-blue-400 py-2 pl-4 md:border-l-0 md:border-t-4 md:pb-0 md:pl-0 md:pt-4\">\n                                                                        <span className=\"text-sm font-medium text-custom-blue-400\">{step.id}</span>\n                                                                        <span className=\"text-sm font-medium\">{step.name}</span>\n                                                                    </div>\n                                                                ) : status === 'current' ? (\n                                                                    <div\n                                                                        aria-current=\"step\"\n                                                                        className=\"flex flex-col border-l-4 border-custom-blue-400 py-2 pl-4 md:border-l-0 md:border-t-4 md:pb-0 md:pl-0 md:pt-4\"\n                                                                    >\n                                                                        <span className=\"text-sm font-medium text-custom-blue-400\">{step.id}</span>\n                                                                        <span className=\"text-sm font-medium\">{step.name}</span>\n                                                                    </div>\n                                                                ) : (\n                                                                    <div className=\"flex flex-col border-l-4 border-gray-200 py-2 pl-4 md:border-l-0 md:border-t-4 md:pb-0 md:pl-0 md:pt-4\">\n                                                                        <span className=\"text-sm font-medium text-gray-500\">{step.id}</span>\n                                                                        <span className=\"text-sm font-medium\">{step.name}</span>\n                                                                    </div>\n                                                                )}\n                                                            </li>\n                                                        )\n                                                    })}\n                                                </ol>\n                                            </nav>\n                                        </div>\n                                    </div>\n                                )}\n\n                                {/* Main content area */}\n                                <div className=\"space-y-8\">\n                                    {/* Title */}\n                                    <div className=\"text-center\">\n                                        <h2 className=\"font-bold text-4xl text-custom-blue-400 mb-3\">\n                                            {currentStep === 1\n                                                ? steps[0].title\n                                                : steps[currentStep - 1].title\n                                            }\n                                        </h2>\n                                        <p className=\"text-gray-500 text-sm max-w-2xl mx-auto\">\n                                            <>\n                                            {steps[currentStep - 1].description}\n                                            </>\n                                        </p>\n                                    </div>\n\n                                    {/* Main input content */}\n                                    <div className=\"mt-8\">\n                                        {steps[currentStep - 1].component}\n                                        {error && <span className=\"text-red-500 text-sm\">{error}</span>}\n                                    </div>\n                                </div>\n\n                                {/* Skip button - hide on step 1 */}\n                                {currentStep > 1 && (\n                                    <div className=\"text-center text-sm text-gray-500 pb-4 mt-16\">\n                                        <Button\n                                            onClick={skipOnboarding}\n                                            variant=\"secondary\"\n                                            className=\"hover:text-gray-700\"\n                                        >\n                                            Skip Onboarding\n                                        </Button>\n                                    </div>\n                                )}\n                            </div>\n                        </div>\n\n                        {/* Right side: Help content with subtle background */}\n                        {currentStep > 1 && (\n                            <div className=\"w-full lg:w-[40%] bg-blue-50 relative shadow-lg overflow-y-auto\">\n                                <div className={classNames(\n                                    \"h-full flex flex-col space-y-8 min-h-screen lg:min-h-[calc(100vh-50px)]\",\n                                    currentStep === 4 ? \"pt-2\" : \"justify-center\"\n                                )}>\n                                    {explanationComponents[currentStep - 1]}\n                                </div>\n                            </div>\n                        )}\n                    </div>\n                </form>\n            </FormProvider>\n            {formResult && (\n                <ConfirmCreationModal\n                    onboarding={true}\n                    mode={'create'}\n                    result={formResult}\n                    onClose={onOnboardingFinished}\n                    onStart={() => {\n                        localStorage.setItem('lpagery_intro_showed_free', 'true');\n                    }}\n                    setIsOpen={setCreationDashboardModalOpened}\n                    isOpen={creationDashboardModalOpened}\n                />\n            )}\n        </>\n    )\n}\n","import {useEffect, useState} from \"react\";\nimport {HeaderContext, SelectableHeaderType} from \"@/context/header-context\";\nimport {Create} from \"@/components/dashboard/create/create\";\n// @ts-ignore\nimport LPageryLogo from '@/assets/LP_Logo_horizontal_2022_RZ.png';\nimport {SettingsArea} from \"@/components/dashboard/settings/SettingsArea\";\nimport {Toaster} from \"sonner\";\nimport {ManageArea} from \"@/components/dashboard/manage/ManageArea\";\nimport Header from \"@/components/header/header\";\nimport {Sidebar} from \"@/components/sidebar/sidebar\";\nimport BottomProCtaArea from \"@/components/common/ButtomProCtaArea\";\nimport {useSubscription} from \"@/hooks/subscription/use-subscription\";\nimport {ManageUpdateContext} from \"@/context/manage-update-context\";\nimport Update from \"@/components/dashboard/update/update\";\nimport Onboarding from \"@/components/onboarding/Onboarding\";\nimport {ErrorBoundaryWrapper} from \"@/components/layout/error/ErrorBoundaryWrapper\";\n\nexport const HeaderLayout = () => {\n\n    const [updateProcessId, setUpdateProcessId] = useState(0);\n    const [updateTemplateId, setUpdateTemplateId] = useState(0);\n    const subscription = useSubscription();\n    const introShowed = Boolean(localStorage.getItem('lpagery_intro_showed_free'));\n    const [showIntro, setShowIntro] = useState(!introShowed && subscription.free);\n\n\n    const headerTexts: { key: SelectableHeaderType, header: string, subheader: string }[] = [\n        {\n            key: \"create\",\n            header: 'Create New Pages',\n            subheader: 'Create a new set of pages with your template page and source data.'\n        },\n        {\n            key: \"update\",\n            header: 'Update Existing Pages',\n            subheader: 'Make changes to your existing pages you created with LPagery. You can update the content, style, and settings of the created pages.'\n        },\n        {\n            key: \"manage\",\n            header: 'Manage Created Pages',\n            subheader: 'Here you find all sets of created pages which you can easily manage.'\n        },\n        {\n            key: \"settings\",\n            header: 'Settings',\n            subheader: 'Manage settings and preferences for the created pages and syncs.'\n        },\n    ];\n    const getInitialHeader = (): SelectableHeaderType => {\n        const params = new URLSearchParams(window.location.search);\n        const headerParam = params.get('view');\n        const storageItem = localStorage.getItem('lpagery_selected_header');\n        \n        const isValidHeader = (header: string | null) => \n            header && headerTexts.some(item => item.key === header);\n\n        if (isValidHeader(headerParam)) {\n            return headerParam as SelectableHeaderType;\n        }\n\n        if (isValidHeader(storageItem)) {\n            return storageItem as SelectableHeaderType;\n        }\n\n        return \"create\";\n    };\n\n    const [header, setHeader] = useState<SelectableHeaderType>(getInitialHeader());\n\n    useEffect(() => {\n        if (header) {\n            localStorage.setItem('lpagery_selected_header', header);\n        }\n    }, [header]);\n\n\n\n    const show_sidebar = header === \"create\";\n    const found_header = headerTexts.find((item) => item.key === header);\n    const header_text = found_header?.header || '';\n    const subheader_text = found_header?.subheader || '';\n\n    // Sync URL with header state\n    useEffect(() => {\n        const updatePostId = window.sessionStorage.getItem('lpagery_update_post_id');\n        if (updatePostId) {\n            setUpdateTemplateId(Number(updatePostId));\n            window.sessionStorage.removeItem('lpagery_update_post_id');\n        }\n        const params = new URLSearchParams(window.location.search);\n        const headerParam = params.get('view');\n        const storageItem = localStorage.getItem('lpagery_selected_header')\n        if (headerParam && headerTexts.some(item => item.key === headerParam)) {\n            setHeader(headerParam as SelectableHeaderType);\n        }\n        if (storageItem && headerTexts.some(item => item.key === storageItem)) {\n            setHeader(storageItem as SelectableHeaderType);\n        }\n    }, []);\n\n    // Listen for browser history changes\n    useEffect(() => {\n        const handlePopState = () => {\n            const params = new URLSearchParams(window.location.search);\n            const headerParam = params.get('view');\n            if (headerParam && headerTexts.some(item => item.key === headerParam)) {\n                setHeader(headerParam as SelectableHeaderType);\n            }\n        };\n\n        window.addEventListener('popstate', handlePopState);\n        return () => window.removeEventListener('popstate', handlePopState);\n    }, []);\n\n    // Update URL when header changes\n    useEffect(() => {\n        const params = new URLSearchParams(window.location.search);\n\n        // Update URL to match current header\n        params.set('view', header);\n        const newUrl = `${window.location.pathname}?${params.toString()}`;\n        window.history.pushState({}, '', newUrl);\n\n        const event = new CustomEvent('lpageryHeaderChange', { detail: { header } });\n        window.dispatchEvent(event);\n    }, [header]);\n\n    if (showIntro) {\n        return <Onboarding onOnboardingFinished={() => {\n            localStorage.setItem('lpagery_intro_showed_free', 'true');\n            setShowIntro(false)\n        }}/>;\n    }\n\n    return (\n        <ManageUpdateContext.Provider value={{\n            processId: updateProcessId,\n            setProcessId: setUpdateProcessId,\n            templateId: updateTemplateId,\n            setTemplateId: setUpdateTemplateId\n        }}>\n            <HeaderContext.Provider value={{header, setHeader}}>\n\n                <div className=\" relative bg-gray-50 \" style={{marginLeft: \"-20px\"}}>\n                    <div className=\"pb-4\">\n                        <Header/>\n                        <header className=\"py-2 mt-16\">\n                            <div className=\"mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n                                <h1 className=\"text-3xl font-bold tracking-tight \">{header_text}</h1>\n                                <p className=\"text-lg mt-2 leading-tight tracking-tight text-gray-500\">{subheader_text}</p>\n                            </div>\n                        </header>\n                        <Toaster richColors={true} position={'top-right'} style={{zIndex: 1000001}}/>\n                        <main className=\"relative mx-auto max-w-7xl px-4 pb-12 sm:px-6 lg:px-8\">\n                            <div className=\"flex\">\n                                <div\n                                    className={`rounded-lg min-h-[60vh] py-6 ${show_sidebar ? 'w-3/4 pr-8' : 'w-full'}`}>\n                                    {header === 'create' && (\n                                        <ErrorBoundaryWrapper>\n                                            <Create/>\n                                        </ErrorBoundaryWrapper>\n                                    )}\n                                    {header === 'update' && (\n                                        <ErrorBoundaryWrapper>\n                                            <Update/>\n                                        </ErrorBoundaryWrapper>\n                                    )}\n                                    {header === 'settings' && (\n                                        <ErrorBoundaryWrapper>\n                                            <SettingsArea/>\n                                        </ErrorBoundaryWrapper>\n                                    )}\n                                    {header === 'manage' && (\n                                        <ErrorBoundaryWrapper>\n                                            <ManageArea/>\n                                        </ErrorBoundaryWrapper>\n                                    )}\n                                </div>\n                                {show_sidebar && (\n                                    <div className=\"w-1/4  mt-6\">\n                                        <Sidebar/>\n                                    </div>\n                                )}\n                            </div>\n                        </main>\n                        {subscription.free && <BottomProCtaArea/>}\n                    </div>\n                </div>\n\n            </HeaderContext.Provider>\n        </ManageUpdateContext.Provider>\n    )\n}\n","import './App.css';\nimport {HeaderLayout} from \"@/components/layout/HeaderLayout\";\nimport {ErrorBoundaryWrapper} from \"@/components/layout/error/ErrorBoundaryWrapper\";\n\nfunction App() {\n    return (\n\n        <ErrorBoundaryWrapper>\n\n\n            <HeaderLayout/>\n        </ErrorBoundaryWrapper>\n    )\n}\n\nexport default App;\n","\"use client\";\n\n// src/index.ts\nimport * as Devtools from \"./ReactQueryDevtools.js\";\nimport * as DevtoolsPanel from \"./ReactQueryDevtoolsPanel.js\";\nvar ReactQueryDevtools2 = process.env.NODE_ENV !== \"development\" ? function() {\n  return null;\n} : Devtools.ReactQueryDevtools;\nvar ReactQueryDevtoolsPanel2 = process.env.NODE_ENV !== \"development\" ? function() {\n  return n