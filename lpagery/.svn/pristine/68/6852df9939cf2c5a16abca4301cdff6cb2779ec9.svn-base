 w-3.5 items-center justify-center\">\n      <DropdownMenuPrimitive.ItemIndicator>\n        <Circle className=\"h-2 w-2 fill-current\" />\n      </DropdownMenuPrimitive.ItemIndicator>\n    </span>\n    {children}\n  </DropdownMenuPrimitive.RadioItem>\n))\nDropdownMenuRadioItem.displayName = DropdownMenuPrimitive.RadioItem.displayName\n\nconst DropdownMenuLabel = React.forwardRef<\n  React.ElementRef<typeof DropdownMenuPrimitive.Label>,\n  React.ComponentPropsWithoutRef<typeof DropdownMenuPrimitive.Label> & {\n    inset?: boolean\n  }\n>(({ className, inset, ...props }, ref) => (\n  <DropdownMenuPrimitive.Label\n    ref={ref}\n    className={cn(\n      \"px-2 py-1.5 text-sm font-semibold\",\n      inset && \"pl-8\",\n      className\n    )}\n    {...props}\n  />\n))\nDropdownMenuLabel.displayName = DropdownMenuPrimitive.Label.displayName\n\nconst DropdownMenuSeparator = React.forwardRef<\n  React.ElementRef<typeof DropdownMenuPrimitive.Separator>,\n  React.ComponentPropsWithoutRef<typeof DropdownMenuPrimitive.Separator>\n>(({ className, ...props }, ref) => (\n  <DropdownMenuPrimitive.Separator\n    ref={ref}\n    className={cn(\"-mx-1 my-1 h-px bg-muted\", className)}\n    {...props}\n  />\n))\nDropdownMenuSeparator.displayName = DropdownMenuPrimitive.Separator.displayName\n\nconst DropdownMenuShortcut = ({\n  className,\n  ...props\n}: React.HTMLAttributes<HTMLSpanElement>) => {\n  return (\n    <span\n      className={cn(\"ml-auto text-xs tracking-widest opacity-60\", className)}\n      {...props}\n    />\n  )\n}\nDropdownMenuShortcut.displayName = \"DropdownMenuShortcut\"\n\nexport {\n  DropdownMenu,\n  DropdownMenuTrigger,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuCheckboxItem,\n  DropdownMenuRadioItem,\n  DropdownMenuLabel,\n  DropdownMenuSeparator,\n  DropdownMenuShortcut,\n  DropdownMenuGroup,\n  DropdownMenuPortal,\n  DropdownMenuSub,\n  DropdownMenuSubContent,\n  DropdownMenuSubTrigger,\n  DropdownMenuRadioGroup,\n}\n","// EditSheetSyncMenuItem.tsx\n\nimport {DropdownMenuItem} from \"@/components/ui/dropdown-menu\";\n\ninterface Props extends React.ComponentPropsWithoutRef<typeof DropdownMenuItem> {\n    onClick: () => void;\n    children: React.ReactNode;\n    inset?: boolean;\n}\n\nexport const ClickableMenuItem = ({onClick, children, className, inset, ...props}: Props) => {\n    return (\n        <DropdownMenuItem \n            onClick={onClick} \n            className={className}\n            inset={inset}\n            {...props}\n        >\n            {children}\n        </DropdownMenuItem>\n    );\n};\n","import {ProcessListItem} from \"@/hooks/manage/use-search-processes\";\nimport {DropdownMenuItem} from \"@/components/ui/dropdown-menu\";\nimport {useNonce} from \"@/hooks/fetch/use-nonce\";\nimport {ArrowDownTrayIcon} from \"@heroicons/react/20/solid\";\n\ninterface Props {\n    process: ProcessListItem;\n    onClick?: () => void;\n}\n\n\nexport const DownloadDataExcelMenuItem = ({process}: Props) => {\n\n    const nonce = useNonce();\n    const downloadUrl = `admin-ajax.php?action=lpagery_download_excel&id=${process.id}&_ajax_nonce=${nonce}`;\n    return (<a target={'_blank'} href={downloadUrl}\n        data-testid={'process-download-excel-menu-item-' + process.id}\n               className=\"text-inherit no-underline hover:no-underline focus:no-underline cursor-pointer\"><DropdownMenuItem>\n        <ArrowDownTrayIcon aria-hidden=\"true\" className=\"mr-3 h-5 w-5 text-gray-400 group-hover:text-gray-500\" />\n\n        Download Data\n    </DropdownMenuItem></a>)\n}","import {ProcessListItem} from \"@/hooks/manage/use-search-processes\";\nimport {DropdownMenuItem} from \"@/components/ui/dropdown-menu\";\nimport {useNonce} from \"@/hooks/fetch/use-nonce\";\nimport {DocumentTextIcon} from \"@heroicons/react/20/solid\";\n\ninterface Props {\n    process: ProcessListItem;\n    onClick?: () => void;\n}\n\n\nexport const ExportTemplateMenuItem = ({process}: Props) => {\n\n    const nonce = useNonce();\n    const downloadUrl = `admin-ajax.php?action=lpagery_download_post_json&process_id=${process.id}&_ajax_nonce=${nonce}`;\n    return (<a target={'_blank'} href={downloadUrl}\n        data-testid={'process-export-template-menu-item-' + process.id}\n               className=\"text-inherit no-underline hover:no-underline focus:no-underline \"><DropdownMenuItem>\n        <DocumentTextIcon\n            aria-hidden=\"true\"\n            className=\"mr-3 h-5 w-5 text-gray-400 group-hover:text-gray-500\"\n        />Export\n        Template Page\n    </DropdownMenuItem></a>)\n}","import {ProcessListItem} from \"@/hooks/manage/use-search-processes\";\nimport {DropdownMenuItem} from \"@/components/ui/dropdown-menu\";\nimport {toast} from \"sonner\";\nimport {CodeXmlIcon} from \"lucide-react\";\n\ninterface Props {\n    process: ProcessListItem;\n    onClick?: () => void;\n}\n\n\nexport const CopyShortcodeMenuItem = ({process}: Props) => {\n\n    return (<DropdownMenuItem onClick={() => {\n        const shortcode = '[lpagery_urls id=\"' + process.id + '\"]';\n        navigator.clipboard.writeText(shortcode).then(() => {\n            toast.success('Shortcode copied to clipboard');\n        })\n    }}> <CodeXmlIcon aria-hidden=\"true\" className=\"mr-3 h-5 w-5 text-gray-400 group-hover:text-gray-500\"/>\n        Copy Shortcode</DropdownMenuItem>)\n}","import useWordpressAjax from \"@/hooks/fetch/use-wordpress-ajax-fetch\";\nimport {z} from \"zod\";\nimport {GoogleSheetSyncStatusTypeSchema} from \"@/types/sync-status\";\nimport {useQuery} from \"@tanstack/react-query\";\n\nconst GoogleSheetSyncDetailsSchema = z.object({\n    count_data: z.boolean(),\n    last_sync: z.number().optional().nullable(),\n    sync_enabled: z.boolean(),\n    next_sync: z.number(),\n    google_sheet_data: z.object({\n        url: z.string().url().optional().nullable(),\n        add: z.boolean(),\n        update: z.boolean(),\n        delete: z.boolean(),\n    }).optional(),\n    status: GoogleSheetSyncStatusTypeSchema,\n    error: z.string().optional().nullable(),\n});\n\nexport type GoogleSheetSyncDetails = z.infer<typeof GoogleSheetSyncDetailsSchema>;\n\nexport const useSheetSyncDetails = (process_id: number) => {\n\n    const fetcher = useWordpressAjax<GoogleSheetSyncDetails, {\n        process_id: number\n    }>(\n        \"lpagery_get_google_sheet_sync_overview\", \n        GoogleSheetSyncDetailsSchema,\n        \"Fetching sheet sync details failed\"\n    );\n\n\n    return useQuery({\n        queryKey: [`processes`, 'sheet', 'details', process_id],\n        queryFn: () => fetcher({body: {process_id}})\n    })\n}\n","import {z} from \"zod\";\nimport useWordpressAjaxMutation from \"@/hooks/fetch/use-mutation\";\nimport {GoogleSheetUrlSchema} from \"@/model/google-sheet-model\";\nimport {useMutation, useQueryClient} from \"@tanstack/react-query\";\n\nexport const GoogleSheetSyncDetailsSaveSchema = z.object({\n    id: z.number(),\n    google_sheet_data: z.object({\n        sync_enabled: z.boolean(),\n        url: GoogleSheetUrlSchema.optional(),\n        add: z.boolean(),\n        update: z.boolean(),\n        delete: z.boolean()\n    }).refine(data => {\n        if (!data.sync_enabled) {\n            return true;\n        }\n        return !!data?.url;\n\n    }, {path: ['url'], message: \"Sheet URL needs to be provided when Google Sheet sync is enabled\"}).refine(\n        (data) => !data.sync_enabled || (data.add || data.update),\n        {\n            message: \"Either create or update must be set\",\n            path: []\n        }\n    ),\n});\nexport type GoogleSheetSyncDetailsSave = z.infer<typeof GoogleSheetSyncDetailsSaveSchema>;\n\nconst ResponseSchema = z.object({\n    success: z.boolean(),\n    process_id: z.number().optional()\n})\ntype Response = z.infer<typeof ResponseSchema>;\n\nexport const useSaveSheetSyncDetails = (process_id: number) => {\n    const queryClient = useQueryClient();\n    const saveSheetDetailsMutation = useWordpressAjaxMutation<GoogleSheetSyncDetailsSave, Response>(\"lpagery_save_process_sheet_data\", GoogleSheetSyncDetailsSaveSchema, ResponseSchema);\n    const mutation = useMutation({\n        mutationKey: [`lpagery_sheet_details`, process_id],\n        mutationFn: async (settings: GoogleSheetSyncDetailsSave) => {\n            const result = await saveSheetDetailsMutation({body: settings});\n            if (!ResponseSchema.parse(result).success) {\n                throw new Error(\"Failed to save sheet sync details\");\n            }\n        },\n        onSuccess: async () => {\n            await queryClient.invalidateQueries({\n                queryKey: [\"processes\"],\n            });\n        }\n    })\n    return mutation\n}","/**\n * v0 by Vercel.\n * @see https://v0.dev/t/Ew8m4Z3EZqN\n * Documentation: https://v0.dev/docs#integrating-generated-code-into-your-nextjs-app\n */\n\nimport {FormProvider, useForm} from \"react-hook-form\";\nimport {FormSwitch} from \"@/components/ui/form-switch\";\nimport {useEffect} from \"react\";\nimport {Label} from \"@/components/ui/label\";\nimport {GoogleSheetUrlInput} from \"@/components/dashboard/save/upload/GoogleSheetUrlInput\";\nimport {FormFieldWrapper} from \"@/components/common/FormFieldWrapper\";\nimport {GoogleSheetSettingCheckbox} from \"@/components/dashboard/save/upload/GoogleSheetSettingCheckbox\";\nimport {zodResolver} from \"@hookform/resolvers/zod\";\nimport {ProcessListItem} from \"@/hooks/manage/use-search-processes\";\nimport {useSheetSyncDetails} from \"@/hooks/manage/use-sheet-sync-details\";\nimport {\n    GoogleSheetSyncDetailsSave,\n    GoogleSheetSyncDetailsSaveSchema,\n    useSaveSheetSyncDetails\n} from \"@/hooks/manage/use-save-sheet-sync-details\";\nimport {toast} from \"sonner\";\nimport {Button} from \"@/components/ui/button\";\nimport {ChevronDown} from \"lucide-react\";\nimport {toPrettyStatus} from \"@/types/sync-status\";\nimport {Disclosure, DisclosureButton, DisclosurePanel} from \"@headlessui/react\";\nimport {Loader} from \"@/components/common/Loader\";\n\n\ninterface Props {\n    process: ProcessListItem;\n    onSubmitted?: () => void;\n    onCancel?: () => void;\n}\n\nexport default function EditGoogleSheetForm({process, onSubmitted, onCancel}: Props) {\n\n    const syncDetailsResponse = useSheetSyncDetails(process.id);\n    const methods = useForm<GoogleSheetSyncDetailsSave>({\n        resolver: zodResolver(GoogleSheetSyncDetailsSaveSchema),\n        defaultValues: {} as GoogleSheetSyncDetailsSave,\n    });\n\n    const syncEnabled = methods.watch('google_sheet_data.sync_enabled');\n    const {\n        control,\n        handleSubmit,\n        register,\n        reset,\n        formState: {errors, isDirty}\n    } = methods\n\n    useEffect(() => {\n        if (!syncDetailsResponse.data) {\n            return;\n        }\n        if (syncDetailsResponse.data.google_sheet_data) {\n            reset({\n                id: process.id,\n                google_sheet_data: {\n                    url: syncDetailsResponse.data.google_sheet_data.url || undefined,\n                    sync_enabled: syncDetailsResponse.data.sync_enabled,\n                    add: syncDetailsResponse.data.google_sheet_data.add,\n                    update: syncDetailsResponse.data.google_sheet_data.update,\n                    delete: syncDetailsResponse.data.google_sheet_data.delete,\n                }\n            })\n        } else {\n            reset({\n                id: process.id,\n                google_sheet_data: {\n\n                    sync_enabled: syncDetailsResponse.data.sync_enabled,\n                    add: false,\n                    update: false,\n                    delete: false,\n                }\n            })\n        }\n\n\n    }, [syncDetailsResponse.data]);\n\n    const saveProcessMutation = useSaveSheetSyncDetails(process.id);\n    const onSubmit = (data: GoogleSheetSyncDetailsSave) => {\n        const promise = saveProcessMutation.mutateAsync(data);\n        toast.promise(promise, {\n            loading: 'Saving...',\n            success: 'Saved!',\n            error: 'Failed to save'\n        })\n        if (onSubmitted) {\n            promise.then(onSubmitted);\n        }\n    }\n    if (syncDetailsResponse.isLoading) {\n        return <Loader/>\n    }\n\n    if (syncDetailsResponse.isError) {\n        return <div>An error occured: {syncDetailsResponse.error?.toString()}</div>\n    }\n\n    return (\n        <FormProvider {...methods}>\n            <form onSubmit={handleSubmit(onSubmit)}>\n                <div className=\"mt-12 rounded-lg \">\n\n                    <div className='space-y-8'>\n                        <div className=\"flex items-center justify-between\">\n                            <div className=\"flex flex-col\">\n                                <span className={\"text-sm font-medium text-gray-900\"}>Enable Google Sheet Sync</span>\n                                <span\n                                    className=\"text-sm text-gray-500\">Sync data between your Google Sheet and this page</span>\n                            </div>\n                            <FormSwitch control={control} {...register('google_sheet_data.sync_enabled')}/>\n                        </div>\n                        <div className={!syncEnabled ? 'opacity-50 pointer-events-none' : ''}>\n\n\n                            <div className=\"sm:col-span-4 space-y-2\">\n                                <FormFieldWrapper label={'Google Sheet URL'} license={'extended'}>\n                                    <GoogleSheetUrlInput\n                                        name={'google_sheet_data.url'}\n                                        control={control}\n\n                                    />\n                                    {errors.google_sheet_data?.url?.message &&\n                                        <div className=\"text-red-500\">{errors.google_sheet_data?.url?.message}</div>}\n\n                                </FormFieldWrapper>\n                            </div>\n                            <fieldset className=\"mb-6 mt-6\">\n                                <div className=\"space-y-5\">\n\n\n                                    <GoogleSheetSettingCheckbox control={control} type=\"add\"\n                                                                prefix=\"google_sheet_data.\"/>\n                                    <GoogleSheetSettingCheckbox control={control} type=\"update\"\n                                                                prefix=\"google_sheet_data.\"/>\n                                    <GoogleSheetSettingCheckbox control={control} type=\"delete\"\n                                                                prefix=\"google_sheet_data.\"/>\n                                    {errors.google_sheet_data?.root?.message &&   <div className=\"text-red-500\">{errors.google_sheet_data?.root?.message}</div>}\n\n                                </div>\n                            </fieldset>\n                            {syncDetailsResponse?.data ? (\n                                <div className={'space-y-2'}>\n                                    <div className=\"flex items-center\" aria-hidden=\"true\">\n                                        <div className=\"w-full border-t border-gray-300\"></div>\n                                    </div>\n\n                                    <Label htmlFor=\"last-sync\"\n                                           className=\"text-sm font-medium text-gray-600\">Last\n                                        Sync</Label>\n                                    {syncDetailsResponse.data.last_sync && syncDetailsResponse.data.last_sync > 0 ? (\n                                        <p className=\"text-sm text-gray-800\">{new Date(syncDetailsResponse.data.last_sync * 1000).toLocaleString()}</p>\n                                    ) : (\n                                        <p className=\"text-sm text-gray-500\">No sync data\n                                            available</p>\n                                    )}\n\n                                    <Label htmlFor=\"last-sync\"\n                                           className=\"text-sm font-medium text-gray-600\">Next\n                                        Sync</Label>\n                                    {syncDetailsResponse.data.next_sync > 0 ? (\n                                        <p className=\"text-sm text-gray-800\">{new Date(syncDetailsResponse.data.next_sync * 1000).toLocaleString()}</p>\n                                    ) : (\n                                        <p className=\"text-sm text-gray-500\">No sync data\n                                            available</p>\n                                    )}\n\n                                    <Label htmlFor=\"last-sync\"\n                                           className=\"text-sm font-medium text-gray-600\">Status</Label>\n                                    {syncDetailsResponse.data.next_sync > 0 ? (\n                                        <p className=\"text-sm text-gray-800\">{toPrettyStatus(syncDetailsResponse.data.status)}</p>\n                                    ) : (\n                                        <p className=\"text-sm text-gray-500\">No sync data\n                                            available</p>\n                                    )}\n                                    {syncDetailsResponse.data.error && (\n                                        <Disclosure>\n                                            {({open}) => (\n                                                <>\n                                                    <DisclosureButton\n                                                        className=\"flex items-center text-sm font-medium text-red-600 hover:text-red-700 focus:outline-none\">\n                                                        <span>{open ? 'Hide Error' : 'Show Error'}</span>\n                                                        <ChevronDown\n                                                            className={`${\n                                                                open ? 'transform rotate-180' : ''\n                                                            } w-5 h-5 ml-1 transition-transform duration-200`}\n                                                        />\n                                                    </DisclosureButton>\n                                                    <DisclosurePanel\n                                                        className=\"mt-2 p-4 bg-red-50 text-red-700 border border-red-200 rounded\">\n                                                        {syncDetailsResponse.data?.error}\n                                                    </DisclosurePanel>\n                                                </>\n                                            )}\n                                        </Disclosure>\n                                    )}\n                                </div>\n                            ) : null}\n\n\n                        </div>\n                        <div className='flex items-center justify-end gap-4'>\n                            <Button variant='outline' onClick={(e) => {\n                                e.preventDefault()\n                                onCancel?.()\n                            }}>\n                                Cancel\n                            </Button>\n                            <Button loading={saveProcessMutation.isPending} disabled={!isDirty || methods.formState.isValidating}>\n                                {syncEnabled ? 'Save' : 'Disable Sheet Sync'}\n                            </Button>\n\n                        </div>\n                    </div>\n                </div>\n\n            </form>\n        </FormProvider>\n\n    )\n}","// EditSheetSyncDialog.tsx\n\n\nimport {ProcessListItem} from \"@/hooks/manage/use-search-processes\";\nimport {Dialog, Transition} from \"@headlessui/react\";\nimport React from \"react\";\nimport {CloudIcon} from \"@heroicons/react/24/outline\";\nimport EditGoogleSheetForm from \"@/components/dashboard/manage/menu/EditGoogleSheetForm\";\n\ninterface Props {\n    process: ProcessListItem;\n    isOpen: boolean;\n    onClose: () => void;\n}\n\nexport const EditSheetSyncDialog = ({ process, isOpen, onClose }: Props) => {\n    return (\n        <Transition appear show={isOpen} as={React.Fragment}>\n            <Dialog as=\"div\" className=\"relative z-20\" onClose={onClose}>\n                <Transition.Child\n                    as={React.Fragment}\n                    enter=\"ease-out duration-300\"\n                    enterFrom=\"opacity-0\"\n                    enterTo=\"opacity-100\"\n                    leave=\"ease-in duration-200\"\n                    leaveFrom=\"opacity-100\"\n                    leaveTo=\"opacity-0\"\n                >\n                    <div className=\"fixed inset-0 bg-black/30 backdrop-blur-sm\" aria-hidden=\"true\" />\n                </Transition.Child>\n                <div className=\"fixed inset-0 overflow-y-auto\">\n                    <div className=\"flex min-h-full items-center justify-center p-4 text-center\">\n                        <Transition.Child\n                            as={React.Fragment}\n                            enter=\"ease-out duration-300\"\n                            enterFrom=\"opacity-0 scale-95\"\n                            enterTo=\"opacity-100 scale-100\"\n                            leave=\"ease-in duration-200\"\n                            leaveFrom=\"opacity-100 scale-100\"\n                            leaveTo=\"opacity-0 scale-95\"\n                        >\n                            <Dialog.Panel className=\"w-full max-w-2xl transform overflow-hidden rounded-2xl bg-white p-6 text-left align-middle shadow-xl transition-all\">\n                                <div className=\"sm:flex sm:items-start\">\n                                    <div className=\"mx-auto flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-blue-100 sm:mx-0 sm:h-10 sm:w-10\">\n                                        <CloudIcon aria-hidden=\"true\" className=\"h-6 w-6 text-blue-600\" />\n                                    </div>\n                                    <div className=\"mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left\">\n                                        <Dialog.Title as=\"h3\" className=\"text-lg font-medium leading-6 text-gray-900\">\n                                            Google Sheet Settings\n                                        </Dialog.Title>\n                                        <p className=\"text-sm text-gray-500\">\n                                            Adjust your Google Sheet settings below.\n                                        </p>\n                                        <div className=\"mt-2\">\n\n                                            <div>\n                                                <EditGoogleSheetForm\n                                                    process={process}\n                                                    onCancel={onClose}\n                                                    onSubmitted={onClose}\n\n\n                                                />\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </Dialog.Panel>\n                        </Transition.Child>\n                    </div>\n                </div>\n            </Dialog>\n        </Transition>\n    );\n};\n","import {motion} from \"framer-motion\";\n\ninterface ProgressPagesProps {\n    label: string\n}\n\nexport const DeleteFinished = ({ label} : ProgressPagesProps) => {\n    // Checkmark animation variants\n    const checkmarkVariants = {\n        hidden: { pathLength: 0, opacity: 0 },\n        visible: {\n            pathLength: 1,\n            opacity: 1,\n            transition: { duration: 0.5, ease: \"easeInOut\" }\n        }\n    }\n    return (<motion.div\n        key=\"complete\"\n        initial={{opacity: 0, scale: 0.5}}\n        animate={{opacity: 1, scale: 1}}\n        transition={{duration: 0.5}}\n        className=\"flex flex-col items-center justify-center h-full\"\n    >\n        <div className=\"w-24 h-24 rounded-full bg-green-100 flex items-center justify-center mb-4\">\n            <motion.svg\n                className=\"w-16 h-16 text-green-500\"\n                viewBox=\"0 0 24 24\"\n                initial=\"hidden\"\n                animate=\"visible\"\n            >\n                <motion.path\n                    d=\"M5 13l4 4L19 7\"\n                    fill=\"transparent\"\n                    strokeWidth=\"2\"\n                    stroke=\"currentColor\"\n                    strokeLinecap=\"round\"\n                    strokeLinejoin=\"round\"\n                    variants={checkmarkVariants}\n                />\n            </motion.svg>\n        </div>\n        <h2 className=\"text-2xl font-semibold mb-4\">{label}</h2>\n\n    </motion.div>)\n}","// use-fetch-pages-by-process.ts\n\nimport {z} from \"zod\";\nimport {NumberParser} from \"@/lib/zod-utils\";\nimport useWordpressAjax from \"@/hooks/fetch/use-wordpress-ajax-fetch\";\n\nexport const ResponseSchema = z.object({\n    id: NumberParser,\n});\n\nexport type Response = z.infer<typeof ResponseSchema>;\n\nexport const useFetchPagesByProcess = (processId: number) => {\n    const fetcher = useWordpressAjax<Response[], { id: number }>(\n        \"lpagery_get_posts_by_process_id\",\n        z.array(ResponseSchema),\n        \"Fetching pages by process failed\"\n    );\n\n    const fetchPages = async () => {\n        return await fetcher({ body: { id: processId } });\n    };\n\n    return { fetchPages };\n};\n","import {z} from \"zod\";\nimport useWordpressAjaxMutation from \"@/hooks/fetch/use-mutation\";\nimport {useFetchPagesByProcess} from \"@/hooks/manage/use-fetch-pages-by-process\";\nimport { useMutation } from '@tanstack/react-query';\n\nconst DeleteProcessSchema = z.object({\n    id: z.number(),\n    delete_posts: z.boolean()\n});\n\ntype DeleteProcessType = z.infer<typeof DeleteProcessSchema>;\n\ninterface Props {\n    process_id: number,\n}\n\nexport const useDeleteProcess = ({process_id}: Props) => {\n    const deleteProcessMutation = useWordpressAjaxMutation<DeleteProcessType>(\n        \"lpagery_delete_process\",\n        DeleteProcessSchema\n    );\n    const { fetchPages } = useFetchPagesByProcess(process_id);\n\n    const mutation = useMutation({\n        mutationFn: async (delete_posts: boolean) => {\n            const data = await fetchPages();\n            if (!data) {\n                throw new Error('Failed to fetch pages');\n            }\n            return await deleteProcessMutation({body: {id: process_id, delete_posts}});\n        }\n    });\n\n    return mutation;\n}","'use client'\n\nimport {Dialog, DialogBackdrop, DialogPanel, DialogTitle} from '@headlessui/react'\nimport {ExclamationTriangleIcon} from '@heroicons/react/24/outline'\nimport {Checkbox} from '@/components/ui/checkbox'\nimport {useEffect, useRef, useState} from 'react'\nimport {Button} from \"@/components/ui/button\";\nimport {Label} from \"@/components/ui/label\";\nimport {ProcessListItem} from \"@/hooks/manage/use-search-processes\";\nimport {DeleteProgress} from \"@/components/dashboard/manage/menu/dialogs/DeleteProgress\";\nimport {DeleteFinished} from \"@/components/dashboard/manage/menu/dialogs/DeleteFinished\";\nimport {useDeleteProcess} from \"@/hooks/manage/use-delete-process\";\nimport {useQueryClient} from \"@tanstack/react-query\";\n\nexport default function DeleteConfirmDialog({isOpen, onCloseCallback, process}: {\n    isOpen: boolean; onCloseCallback: () => void, process: ProcessListItem;\n}) {\n    const [isChecked, setIsChecked] = useState(false);\n\n    const {mutate: deleteProcessTrigger, isPending: deleteProcessLoading, isSuccess: deleteProcessSuccess, error: deleteProcessError} = useDeleteProcess({process_id: process.id});\n\n    const queryClient = useQueryClient()\n    const post_count =useRef<number>(0)\n\n    useEffect(() => {\n        post_count.current = process.post_count\n    }, [process.post_count]);\n    const onClose = async () => {\n        await queryClient.invalidateQueries({\n            queryKey: [\"processes\"]\n        });\n        onCloseCallback()\n    }\n\n    useEffect(() => {\n        if(isOpen){\n            setIsChecked(false)\n        }\n    },[isOpen]);\n\n    const handleCheckboxChange = (checked: boolean) => {\n        setIsChecked(checked);\n    };\n\n    const handleDelete = async () => {\n        deleteProcessTrigger(isChecked);\n    }\n\n    return (\n        <Dialog open={isOpen} onClose={onClose} className=\"relative z-10\">\n            <DialogBackdrop\n                transition\n                className=\"fixed inset-0 bg-black/30 backdrop-blur-sm transition-opacity data-[closed]:opacity-0 data-[enter]:duration-300 data-[leave]:duration-200 data-[enter]:ease-out data-[leave]:ease-in\"\n            />\n\n            <div className=\"fixed inset-0 z-10 w-screen overflow-y-auto\">\n                <div className=\"flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0\">\n                    <DialogPanel\n                        transition\n                        className=\"relative transform overflow-hidden rounded-lg bg-white px-4 pb-4 pt-5 text-left shadow-xl transition-all data-[closed]:translate-y-4 data-[closed]:opacity-0 data-[enter]:duration-300 data-[leave]:duration-200 data-[enter]:ease-out data-[leave]:ease-in sm:my-8 sm:w-full sm:max-w-lg sm:p-6 data-[closed]:sm:translate-y-0 data-[closed]:sm:scale-95\"\n                    >\n                        {deleteProcessError && (\n                            <div className=\"mb-4 p-4 text-sm text-red-800 bg-red-100 rounded-lg\">\n                                {deleteProcessError.message}\n                            </div>\n                        )}\n                        {!deleteProcessSuccess && (\n\n                            <div className=\"sm:flex sm:items-start\">\n                                <div\n                                    className=\"mx-auto flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-red-100 sm:mx-0 sm:h-10 sm:w-10\">\n                                    <ExclamationTriangleIcon aria-hidden=\"true\" className=\"h-6 w-6 text-red-600\"/>\n                                </div>\n                                <div className=\"mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left\">\n                                    <DialogTitle as=\"h3\" className=\"text-base font-semibold leading-6 text-gray-900\">\n                                        Delete Page Creation?\n                                    </DialogTitle>\n                                    <div className=\"mt-2\">\n                                        <p className=\"text-sm text-gray-500\">\n\n                                            The created pages will NOT be deleted unless you check the checkbox below.\n                                        </p>\n                                    </div>\n                                    <div className=\"flex items-center space-x-2 mt-4\">\n\n                                        <Checkbox data-testid=\"delete-pages-checkbox\" id=\"delete-pages\" checked={isChecked}\n                                                  onCheckedChange={handleCheckboxChange}/>\n                                        <Label\n                                            htmlFor=\"delete-pages\"\n                                            className=\"text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70\"\n                                        >\n                                            Delete all {process.post_count} Pages from this creation\n                                        </Label>\n\n                                    </div>\n                                </div>\n\n                            </div>\n                        )}\n                        {deleteProcessSuccess && (\n                            <DeleteFinished label={isChecked ? 'Pages Deleted Successfully' : 'Entry Deleted Successfully'}/>\n                        )}\n                        <div className=\"mt-5 sm:mt-4 sm:flex sm:flex-row-reverse\">\n                            {!deleteProcessSuccess && <Button\n                                data-testid=\"delete-pages-button\"\n                                type=\"button\"\n                                loading={deleteProcessLoading}\n                                onClick={handleDelete}\n                                className=\"inline-flex w-full justify-center rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500 sm:ml-3 sm:w-auto\"\n                            >\n                                {isChecked ? `Delete ${ post_count.current} Pages` : 'Delete Page Creation Entry'}\n                            </Button>}\n                            <Button\n                                data-testid=\"delete-pages-close-button\"\n                                type=\"button\"\n                                onClick={onClose}\n                                className=\"mt-3 inline-flex w-full justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 sm:mt-0 sm:w-auto\"\n                            >\n                                {deleteProcessSuccess ? 'Close' : 'Cancel'}\n                            </Button>\n                        </div>\n                    </DialogPanel>\n                </div>\n            </div>\n        </Dialog>\n    )\n}\n","import {createContext} from \"react\";\n\n\nexport type ManageUpdateContextType = {\n    processId: number;\n    setProcessId: (processId: number) => void;\n    templateId: number;\n    setTemplateId: (templateId: number) => void;\n}\nexport const ManageUpdateContext = createContext<ManageUpdateContextType>({\n    processId: 0, setProcessId: () => {\n    },\n    templateId: 0, setTemplateId: () => {\n    }\n});","import useWordpressAjaxMutation from \"@/hooks/fetch/use-mutation\";\nimport {z} from \"zod\";\nimport {useMutation, useQueryClient} from \"@tanstack/react-query\";\n\nexport const ProcessPurposeSaveSchema = z.object({\n    purpose: z.string().min(1),\n    id: z.number()\n});\n\n\nconst ResponseSchema = z.object({\n    process_id: z.number(),\n    success: z.boolean()\n})\n\ntype Response = z.infer<typeof ResponseSchema>;\nexport type ProcessPurposeSave = z.infer<typeof ProcessPurposeSaveSchema>;\nexport const useSaveProcessPurpose = () => {\n    const savePurposeMutation = useWordpressAjaxMutation<ProcessPurposeSave, Response>(\"lpagery_upsert_process\", ProcessPurposeSaveSchema, ResponseSchema);\n\n    const client = useQueryClient()\n    const mutate = useMutation({\n        mutationKey: [\"save_process_purpose\"],\n        mutationFn: async (purposeSave: ProcessPurposeSave) => {\n            const result = await savePurposeMutation({body: purposeSave});\n            if(!result || !result.success) {\n                throw new Error(\"Failed to save purpose\");\n            }\n        },onSuccess: async () => {\n            await client.invalidateQueries({\n                queryKey: [\"processes\", \"search\"]\n            });\n        }\n    })\n\n    return mutate\n}","import {useForm} from \"react-hook-form\";\nimport {zodResolver} from \"@hookform/resolvers/zod\";\nimport {Button} from \"@/components/ui/button\";\nimport {Label} from \"@/components/ui/label\";\nimport {toast} from \"sonner\";\nimport {\n    ProcessPurposeSave,\n    ProcessPurposeSaveSchema,\n    useSaveProcessPurpose\n} from \"@/hooks/manage/use-save-process-purpose\";\n\ninterface Props {\n    processId: number;\n    currentPurpose: string;\n    onSubmitted?: () => void;\n    onCancel?: () => void;\n}\n\nexport default function EditProcessPurposeForm({ processId, currentPurpose, onSubmitted, onCancel }: Props) {\n    const {\n        register,\n        handleSubmit,\n        formState: { errors, isDirty },\n    } = useForm<ProcessPurposeSave>({\n        resolver: zodResolver(ProcessPurposeSaveSchema),\n        defaultValues: { id: processId, purpose: currentPurpose || \"\" },\n    });\n\n    const saveProcessPurpose = useSaveProcessPurpose();\n\n    const onSubmit = (data: ProcessPurposeSave) => {\n        const promise = saveProcessPurpose.mutateAsync(data);\n\n        promise.then(() => {\n            onSubmitted?.();\n        });\n        toast.promise(promise, {\n            loading: \"Saving purpose...\",\n            success: \"Purpose saved successfully!\",\n            error: \"Failed to save purpose.\",\n        });\n    };\n\n    return (\n        <form onSubmit={handleSubmit(onSubmit)}>\n            <div className=\"space-y-6\">\n                <div className=\"space-y-4\">\n                    <Label htmlFor=\"purpose\" className=\"text-sm font-medium text-gray-700\">\n                        Purpose\n                    </Label>\n                    <textarea\n                        id=\"purpose\"\n                        data-testid={'process-purpose-input'}\n                        {...register(\"purpose\")}\n                        className={`w-full rounded-md border ${\n                            errors.purpose ? \"border-red-500\" : \"border-gray-300\"\n                        } focus:ring focus:ring-indigo-200`}\n                        rows={4}\n                    />\n                    {errors.purpose && <p className=\"text-sm text-red-500\">{errors.purpose.message}</p>}\n                </div>\n                <div className=\"flex items-center justify-end gap-4\">\n                    <Button variant=\"outline\" onClick={(e) => { e.preventDefault(); onCancel?.(); }}>\n                        Cancel\n                    </Button>\n                    <Button type=\"submit\" disabled={!isDirty} loading={ saveProcessPurpose.isPending} data-testid={'process-purpose-submit'}>\n                        Save Purpose\n                    </Button>\n                </div>\n            </div>\n        </form>\n    );\n}\n","// EditSheetSyncDialog.tsx\n\n\nimport {ProcessListItem} from \"@/hooks/manage/use-search-processes\";\nimport {Dialog, Transition} from \"@headlessui/react\";\nimport React from \"react\";\nimport {PencilLine} from \"lucide-react\";\nimport EditProcessPurposeForm from \"@/components/dashboard/manage/menu/EditProcessPurposeForm\";\n\ninterface Props {\n    process: ProcessListItem;\n    isOpen: boolean;\n    onClose: () => void;\n}\n\nexport const EditPurposeDialog = ({process, isOpen, onClose}: Props) => {\n    return (\n        <Transition appear show={isOpen} as={React.Fragment}>\n            <Dialog as=\"div\" className=\"relative z-20\" onClose={onClose}>\n                <Transition.Child\n                    as={React.Fragment}\n                    enter=\"ease-out duration-300\"\n                    enterFrom=\"opacity-0\"\n                    enterTo=\"opacity-100\"\n                    leave=\"ease-in duration-200\"\n                    leaveFrom=\"opacity-100\"\n                    leaveTo=\"opacity-0\"\n                >\n                    <div className=\"fixed inset-0 bg-black/30 backdrop-blur-sm\" aria-hidden=\"true\"/>\n                </Transition.Child>\n                <div className=\"fixed inset-0 overflow-y-auto\">\n                    <div className=\"flex min-h-full items-center justify-center p-4 text-center\">\n                        <Transition.Child\n                            as={React.Fragment}\n                            enter=\"ease-out duration-300\"\n                            enterFrom=\"opacity-0 scale-95\"\n                            enterTo=\"opacity-100 scale-100\"\n                            leave=\"ease-in duration-200\"\n                            leaveFrom=\"opacity-100 scale-100\"\n                            leaveTo=\"opacity-0 scale-95\"\n                        >\n                            <Dialog.Panel\n                                className=\"w-full max-w-md transform overflow-hidden rounded-lg bg-white p-6 text-left align-middle shadow-xl transition-all\"\n                            >\n                                <div className=\"sm:flex sm:items-start\">\n                                    <div\n                                        className=\"mx-auto flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-blue-100 sm:mx-0 sm:h-8 sm:w-8\"\n                                    >\n                                        <PencilLine aria-hidden=\"true\" className=\"h-5 w-5 text-blue-600\" />\n                                    </div>\n                                    <div className=\"mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left\">\n                                        <Dialog.Title as=\"h3\" className=\"text-lg font-medium leading-6 text-gray-900\">\n                                            Change Purpose/Name\n                                        </Dialog.Title>\n                                        <p className=\"text-sm text-gray-500\">\n                                            Set a new Purpose/Name for this Set of Pages\n                                        </p>\n                                        <div className=\"mt-2\">\n                                            <EditProcessPurposeForm\n                                                processId={process.id}\n                                                currentPurpose={process.purpose_with_name}\n                                                onSubmitted={onClose}\n                                                onCancel={onClose}\n                                            />\n                                        </div>\n                                    </div>\n                                </div>\n                            </Dialog.Panel>\n                        </Transition.Child>\n                    </div>\n                </div>\n            </Dialog>\n        </Transition>\n    );\n};\n","import { z } from 'zod';\nimport useWordpressAjaxMutation from \"@/hooks/fetch/use-mutation\";\nimport { useMutation, useQueryClient } from \"@tanstack/react-query\";\n\nconst StartSyncSchema = z.object({\n    process_id: z.number()\n});\n\ntype StartSyncParams = z.infer<typeof StartSyncSchema>;\n\nexport const useStartSync = () => {\n    const queryClient = useQueryClient();\n    const startSyncMutation = useWordpressAjaxMutation<StartSyncParams>(\n        \"lpagery_start_sync_for_process\",\n        StartSyncSchema\n    );\n\n    return useMutation({\n        mutationKey: ['sync'],\n        mutationFn: async (params: StartSyncParams) => {\n            await startSyncMutation({ body: params });\n        },\n        onSuccess: async () => {\n            await queryClient.invalidateQueries({ queryKey: ['sync'] });\n        }\n    });\n}; ","import { z } from 'zod';\nimport useWordpressAjaxMutation from \"@/hooks/fetch/use-mutation\";\nimport { useMutation, useQueryClient } from \"@tanstack/react-query\";\n\nconst ReassignTemplateSchema = z.object({\n    process_id: z.number(),\n    template_id: z.number()\n});\n\ntype ReassignTemplateParams = z.infer<typeof ReassignTemplateSchema>;\n\nconst ResponseSchema = z.object({\n    success: z.boolean(),\n    exception: z.string().optional()\n});\n\ntype Response = z.infer<typeof ResponseSchema>;\n\nexport const useReassignTemplate = (process_id: number) => {\n    const queryClient = useQueryClient();\n    const reassignTemplateMutation = useWordpressAjaxMutation<ReassignTemplateParams, Response>(\n        \"lpagery_reassign_template\",\n        ReassignTemplateSchema,\n        ResponseSchema\n    );\n\n    return useMutation({\n        mutationKey: ['reassign_template', process_id],\n        mutationFn: async (template_id: number) => {\n            const result = await reassignTemplateMutation({ body: { process_id, template_id } });\n            if (!result?.success) {\n                throw new Error(result?.exception || \"Failed to reassign template\");\n            }\n            return result;\n        },\n        onSuccess: async () => {\n            await queryClient.invalidateQueries({\n                queryKey: [\"processes\", \"search\"]\n            });\n        }\n    });\n}; ","import React from 'react';\nimport {Dialog, Transition} from \"@headlessui/react\";\nimport {ProcessListItem} from \"@/hooks/manage/use-search-processes\";\nimport {useReassignTemplate} from \"@/hooks/manage/use-reassign-template\";\nimport {toast} from \"sonner\";\nimport {Button} from \"@/components/ui/button\";\nimport {FileText} from \"lucide-react\";\nimport {PageSelect} from \"@/components/dashboard/save/components/PageSelect\";\nimport {FormProvider, useForm} from \"react-hook-form\";\nimport {cn} from \"@/lib/utils\";\n\ninterface Props {\n    isOpen: boolean;\n    onClose: () => void;\n    process: ProcessListItem;\n}\n\nexport const ReassignTemplateDialog = ({isOpen, onClose, process}: Props) => {\n    const methods = useForm({\n        defaultValues: {\n            template: 0\n        }\n    });\n    const {mutateAsync: reassignTemplate, isPending} = useReassignTemplate(process.id);\n    const selectedTemplate = methods.watch('template');\n\n    const handleReassign = async () => {\n        if (!selectedTemplate) {\n            toast.error(\"Please select a template\");\n            return;\n        }\n\n        try {\n            await reassignTemplate(selectedTemplate);\n            toast.success(\"Template reassigned successfully\");\n            onClose();\n        } catch (error) {\n            toast.error(\"Failed to reassign template\");\n        }\n    };\n\n    return (\n        <Transition appear show={isOpen} as={React.Fragment}>\n            <Dialog as=\"div\" className=\"relative z-40\" onClose={onClose}>\n                <Transition.Child\n                    as={React.Fragment}\n                    enter=\"ease-out duration-300\"\n                    enterFrom=\"opacity-0\"\n                    enterTo=\"opacity-100\"\n                    leave=\"ease-in duration-200\"\n                    leaveFrom=\"opacity-100\"\n                    leaveTo=\"opacity-0\"\n                >\n                    <div className=\"fixed inset-0 bg-black/30 backdrop-blur-sm\" aria-hidden=\"true\"/>\n                </Transition.Child>\n                <div className=\"fixed inset-0 overflow-y-auto\">\n                    <div className=\"flex min-h-full items-center justify-center p-4 text-center\">\n                        <Transition.Child\n                            as={React.Fragment}\n                            enter=\"ease-out duration-300\"\n                            enterFrom=\"opacity-0 scale-95\"\n                            enterTo=\"opacity-100 scale-100\"\n                            leave=\"ease-in duration-200\"\n                            leaveFrom=\"opacity-100 scale-100\"\n                            leaveTo=\"opacity-0 scale-95\"\n                        >\n                            <Dialog.Panel\n                                className=\"w-full max-w-md transform overflow-hidden rounded-lg bg-white p-6 text-left align-middle shadow-xl transition-all\"\n                            >\n                                <div className=\"sm:flex sm:items-start\">\n                                    <div\n                                        className=\"mx-auto flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-blue-100 sm:mx-0 sm:h-8 sm:w-8\"\n                                    >\n                                        <FileText aria-hidden=\"true\" className=\"h-5 w-5 text-blue-600\"/>\n                                    </div>\n                                    <div className=\"mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left flex-1 min-w-0\">\n                                        <Dialog.Title as=\"h3\" className=\"text-lg font-medium leading-6 text-gray-900\">\n                                            Reassign Template\n                                        </Dialog.Title>\n                                        <div className=\"mt-2\">\n                                            <p className=\"text-sm text-gray-500\">\n                                                Select a new template page for this page set. To adapt the new template, please update the page set with the update look option.\n                                            </p>\n                                            <p className=\"mt-2 text-sm font-bold text-red-600\">\n                                                Warning: You must select the same post type as the original template.\n                                            </p>\n                                        </div>\n                                        <div className=\"mt-4 max-w-full\">\n                                            <FormProvider {...methods}>\n                                                <PageSelect\n                                                    name=\"template\"\n                                                    type=\"template\"\n                                                    mode=\"create\"\n                                                />\n                                            </FormProvider>\n                                        </div>\n                                        <div className=\"mt-5 sm:mt-4 sm:flex sm:flex-row-reverse\">\n                                            <Button\n                                                type=\"button\"\n                                                onClick={handleReassign}\n                                                disabled={isPending || !selectedTemplate}\n                                                className=\"inline-flex w-full justify-center sm:ml-3 sm:w-auto\"\n                                            >\n                                                Reassign\n                                            </Button>\n                                            <Button\n                                                type=\"button\"\n                                                variant=\"secondary\"\n                                                onClick={onClose}\n                                                className=\"mt-3 inline-flex w-full justify-center sm:mt-0 sm:w-auto\"\n                                            >\n                                                Cancel\n                                            </Button>\n                                        </div>\n                                    </div>\n                                </div>\n                            </Dialog.Panel>\n                        </Transition.Child>\n                    </div>\n                </div>\n            </Dialog>\n        </Transition>\n    );\n}; ","import {useMutation, useQueryClient} from \"@tanstack/react-query\";\nimport useWordpressAjax from \"@/hooks/fetch/use-wordpress-ajax-fetch\";\nimport {z} from \"zod\";\n\nconst AssignPageSetResponseSchema = z.object({\n    success: z.boolean(),\n    process_id: z.number().optional(),\n    exception: z.string().optional()\n});\n\nexport const useAssignPageSetToMe = () => {\n    const queryClient = useQueryClient();\n    const fetcher = useWordpressAjax<z.infer<typeof AssignPageSetResponseSchema>, { process_id: number }>(\n        \"lpagery_assign_page_set_to_me\",\n        AssignPageSetResponseSchema,\n        \"Failed to assign page set\"\n    );\n\n    return useMutation({\n        mutationFn: ({process_id}: { process_id: number }) => fetcher({body: {process_id}}),\n        onSuccess: () => {\n            queryClient.invalidateQueries({queryKey: ['processes']});\n        }\n    });\n}; ","import {\n    DropdownMenu,\n    DropdownMenuContent,\n    DropdownMenuLabel,\n    DropdownMenuSeparator,\n    DropdownMenuTrigger\n} from \"@/components/ui/dropdown-menu\";\nimport {Button} from \"@/components/ui/button\";\nimport {FileText, MoreHorizontal, PencilLine, UserPlus} from \"lucide-react\";\nimport {ProcessListItem} from \"@/hooks/manage/use-search-processes\";\nimport {ClickableMenuItem} from \"@/components/dashboard/manage/menu/items/ClickableMenuItem\";\nimport {DownloadDataExcelMenuItem} from \"@/components/dashboard/manage/menu/items/DownloadDataExcelMenuItem\";\nimport {ExportTemplateMenuItem} from \"@/components/dashboard/manage/menu/items/ExportTemplateMenuItem\";\nimport {CopyShortcodeMenuItem} from \"@/components/dashboard/manage/menu/items/CopyShortcodeMenuItem\";\nimport React, {useContext, useState} from \"react\";\nimport {EditSheetSyncDialog} from \"@/components/dashboard/manage/menu/dialogs/EditSheetSyncDialog\";\nimport DeleteConfirmDialog from \"@/components/dashboard/manage/menu/dialogs/DeleteConfirmDialog\";\nimport {CloudArrowDownIcon, TrashIcon} from \"@heroicons/react/24/solid\";\nimport {ArrowPathIcon, CloudIcon} from \"@heroicons/react/24/outline\";\nimport {HeaderContext} from \"@/context/header-context\";\nimport {ManageUpdateContext} from \"@/context/manage-update-context\";\nimport {useSubscription} from \"@/hooks/subscription/use-subscription\";\nimport {ProBadge} from \"@/components/common/ProBadge\";\nimport {EditPurposeDialog} from \"@/components/dashboard/manage/menu/dialogs/EditPurposeDialog\";\nimport {useStartSync} from \"@/hooks/dashboard/sync/use-start-sync\";\nimport {toast} from \"sonner\";\nimport {ReassignTemplateDialog} from \"@/components/dashboard/manage/menu/dialogs/ReassignTemplateDialog\";\nimport {useAssignPageSetToMe} from \"@/hooks/dashboard/manage/use-assign-page-set-to-me\";\n\ninterface Props {\n    process: ProcessListItem\n}\n\nexport const ProcessTableDropdownMenu = ({process}: Props) => {\n    const [isSheetSyncDialogOpen, setIsSheetSyncDialogOpen] = useState(false);\n    const [isChangePurposeDialogOpen, setIsChangePurposeDialogOpen] = useState(false);\n    const [isDeleteDialogOpen, setIsDeleteDialogOpen] = useState(false);\n    const [isReassignTemplateDialogOpen, setIsReassignTemplateDialogOpen] = useState(false);\n    const [open, setOpen] = useState(false);\n    const {setHeader} = useContext(HeaderContext)\n    const {setProcessId, setTemplateId} = useContext(ManageUpdateContext)\n    const {extended} = useSubscription();\n    const startSync = useStartSync()\n    const assignToMe = useAssignPageSetToMe();\n\n    return (\n        <>\n            <DropdownMenu open={open} onOpenChange={setOpen}>\n                <DropdownMenuTrigger asChild data-testid={'process-table-menu-trigger-' + process.id}>\n                    <Button variant=\"ghost\" className=\"h-8 w-8 p-0\">\n                        <span className=\"sr-only\">Open menu</span>\n                        <MoreHorizontal className=\"h-4 w-4\"/>\n                    </Button>\n                </DropdownMenuTrigger>\n                <DropdownMenuContent align=\"end\">\n                    <DropdownMenuLabel>Actions</DropdownMenuLabel>\n                    {process.user.name === null && (\n                        <ClickableMenuItem data-testid={'process-assign-to-me-menu-item-' + process.id} onClick={() => {\n                            const promise = assignToMe.mutateAsync({process_id: process.id});\n                            toast.promise(promise, {\n                                loading: 'Assigning page set...',\n                                success: 'Page set assigned to you',\n                                error: 'Failed to assign page set'\n                            });\n                            setOpen(false);\n                        }}>\n                            <UserPlus className=\"mr-3 h-5 w-5 text-gray-400 group-hover:text-gray-500\"/>\n                            Assign to Me\n                        </ClickableMenuItem>\n                    )}\n                    {process.post.deleted && <ProAwareMenuText>\n                        <ClickableMenuItem data-testid={'process-reassign-template-menu-item-' + process.id}\n                                           onClick={() => {\n                                               if (extended) {\n                                                   setIsReassignTemplateDialogOpen(true)\n                                                   setOpen(false)\n                                               }\n                                           }}>\n                            <FileText className=\"mr-3 h-5 w-5 text-gray-400 group-hover:text-gray-500\"/>\n                            Reassign Template\n                        </ClickableMenuItem>\n                    </ProAwareMenuText>}\n                    {(process.post_count > 0 && !process.post.deleted) ? <ProAwareMenuText>\n                        <ClickableMenuItem data-testid={'process-update-menu-item-' + process.id} onClick={() => {\n                            if (extended) {\n                                setProcessId(process.id)\n                                setTemplateId(process.post_id)\n                                setHeader('update')\n                                setOpen(false)\n                            }\n                        }}>\n                            <ArrowPathIcon aria-hidden=\"true\"\n                                           className=\"mr-3 h-5 w-5 text-gray-400 group-hover:text-gray-500\"/>\n                            Update Pages\n                        </ClickableMenuItem>\n                    </ProAwareMenuText> : <></>}\n                    <ClickableMenuItem data-testid={'process-purpose-change-menu-item-' + process.id} onClick={() => {\n                        setIsChangePurposeDialogOpen(true)\n                        setOpen(false)\n                    }}>\n                        <PencilLine className=\"mr-3 h-5 w-5 text-gray-400 group-hover:text-gray-500\"/>\n                        Change Purpose/Name\n                    </ClickableMenuItem>\n                    {(!!process.google_sheet_url || process.google_sheet_sync_enabled) &&\n                        <>\n                            <ProAwareMenuText>\n                                <ClickableMenuItem onClick={() => {\n                                    if (extended) {\n                                        setIsSheetSyncDialogOpen(true)\n                                        setOpen(false)\n                                    }\n                                }}>\n                                    <CloudIcon aria-hidden=\"true\"\n                                               className=\"mr-3 h-5 w-5 text-gray-400 group-hover:text-gray-500\"/>\n                                    <span>Google Sheet Sync Settings</span>\n                                </ClickableMenuItem>\n                            </ProAwareMenuText>\n                            {process.google_sheet_sync_enabled && <ProAwareMenuText>\n                                <ClickableMenuItem onClick={() => {\n                                    if (extended) {\n                                        const promise = startSync.mutateAsync({process_id: process.id})\n                                        toast.promise(promise, {\n                                            loading: 'Starting Sync...',\n                                            success: 'Sync Started',\n                                            error: 'Failed to sync'\n                                        })\n                                    }\n                                }}>\n                                    <CloudArrowDownIcon aria-hidden=\"true\"\n                                                        className=\"mr-3 h-5 w-5 text-gray-400 group-hover:text-gray-500\"/>\n                                    <span>Sync Now</span>\n                                </ClickableMenuItem>\n                            </ProAwareMenuText>}\n                        </>}\n                    <DropdownMenuSeparator/>\n                    <ProAwareMenuText>\n                        <DownloadDataExcelMenuItem process={process} onClick={() => setOpen(false)}/>\n                    </ProAwareMenuText>\n\n                    <ExportTemplateMenuItem process={process} onClick={() => setOpen(false)}/>\n                    <DropdownMenuSeparator/>\n                    <ProAwareMenuText>\n                        <CopyShortcodeMenuItem process={process} onClick={() => setOpen(false)}/>\n                    </ProAwareMenuText>\n                    <DropdownMenuSeparator/>\n                    <ProAwareMenuText>\n                        <ClickableMenuItem data-testid={'process-delete-menu-item-' + process.id} onClick={() => {\n                            if (extended) {\n                                setIsDeleteDialogOpen(true)\n                                setOpen(false)\n                            }\n                        }}>\n                            <TrashIcon aria-hidden=\"true\"\n                                       className=\"mr-3 h-5 w-5 text-gray-400 group-hover:text-gray-500\"/>\n                            <span>Delete Pages</span>\n                        </ClickableMenuItem>\n                    </ProAwareMenuText>\n                </DropdownMenuContent>\n            </DropdownMenu>\n            {isSheetSyncDialogOpen && <EditSheetSyncDialog\n                process={process}\n                isOpen={isSheetSyncDialogOpen}\n                onClose={() => setIsSheetSyncDialogOpen(false)}\n            />}\n\n\n            {isDeleteDialogOpen && <DeleteConfirmDialog process={process} isOpen={isDeleteDialogOpen}\n                                                        onCloseCallback={() => setIsDeleteDialogOpen(false)}/>}\n\n            {isChangePurposeDialogOpen && <EditPurposeDialog process={process} isOpen={isChangePurposeDialogOpen}\n                                                             onClose={() => setIsChangePurposeDialogOpen(false)}/>}\n\n            {isReassignTemplateDialogOpen && <ReassignTemplateDialog\n                process={process}\n                isOpen={isReassignTemplateDialogOpen}\n                onClose={() => setIsReassignTemplateDialogOpen(false)}\n            />}\n        </>\n    );\n}\n\nconst ProAwareMenuText = ({children}: React.PropsWithChildren) => {\n    const {extended} = useSubscription();\n\n    const handlePremiumFeatureClick = (e: React.MouseEvent) => {\n\n        if (!extended) {\n            e.preventDefault();\n            e.stopPropagation();\n            const bottomCta = document.querySelector('#bottom-pro-cta');\n            if (bottomCta) {\n                bottomCta.scrollIntoView({behavior: 'smooth', block: 'start'});\n            }\n        }\n    };\n\n    if (!extended) {\n        return (\n            <div onClick={handlePremiumFeatureClick}\n                 className=\"flex items-center justify-between opacity-70 cursor-pointer w-full\">\n                <div>{children}</div>\n                <ProBadge/>\n            </div>\n        );\n    } else {\n        return <div className=\" cursor-pointer \">{children}</div>;\n    }\n};","import {GoogleSheetSyncStatus} from \"@/types/sync-status\";\n\ninterface Props {\n    status: GoogleSheetSyncStatus\n}\n\nexport const SheetSyncStatusBadge = ({status}: Props) => {\n    let color = 'gray';\n    let text = 'PLANNED';\n\n    switch (status) {\n        case 'PLANNED':\n            color = 'gray';\n            text = 'Planned';\n            break;\n        case 'DOWNLOADING_DATA':\n            color = 'gray';\n            text = 'Downloading Data';\n            break;\n        case 'PAUSED_WAITING_FOR_NEXT_BATCH':\n            color = 'gray';\n            text = 'Paused - waiting for next batch';\n            break;\n        case 'CRON_STARTED':\n            color = 'yellow';\n            text = 'Cron Started';\n            break;\n        case 'RUNNING':\n            color = 'yellow';\n            text = 'Running';\n            break;\n        case 'FINISHED':\n            color = 'green';\n            text = 'Finished';\n            break;\n        case 'ERROR':\n            color = 'red';\n            text = 'Error';\n            break;\n        case 'PAST_DUE':\n            color = 'red';\n            text = 'Past due';\n            break;\n        case 'WAITING_FOR_PROCESSING':\n            color = 'yellow';\n            text = 'Waiting to be processed';\n            break;\n    }\n    return (\n        <span\n            className={`inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset bg-${color}-50 text-${color}-700 ring-${color}-600/20`}>\n            {text}\n        </span>\n    )\n\n}","import React from \"react\"; \n\nconst PlayListAddIcon = (props: React.SVGProps<SVGSVGElement>) => (\n  <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" width={24} height={24} color={\"#003049\"} fill={\"none\"} {...props}>\n    <path d=\"M1.99988 7H20.9999\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinejoin=\"round\" />\n    <path d=\"M16.4999 2L13.4999 7\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinejoin=\"round\" />\n    <path d=\"M9.49988 2L6.49988 7\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinejoin=\"round\" />\n    <path d=\"M11.5001 21C7.02172 21 4.78255 21 3.3913 19.6088C2.00006 18.2175 2.00006 15.9783 2.00006 11.5C2.00006 7.02166 2.00006 4.78249 3.3913 3.39124C4.78255 2 7.02172 2 11.5001 2C15.9784 2 18.2176 2 19.6088 3.39124C21.0001 4.78249 21.0001 7.02166 21.0001 11.5\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" />\n    <path opacity=\"0.4\" d=\"M14 18H22M18 22L18 14\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" />\n  </svg>\n);\n\nexport default PlayListAddIcon;","import {z} from \"zod\";\nimport useWordpressAjax from \"@/hooks/fetch/use-wordpress-ajax-fetch\";\nimport {useQuery} from \"@tanstack/react-query\";\nimport { ColumnFiltersState } from \"@tanstack/react-table\";\nimport {NumberParser} from \"@/lib/zod-utils\";\n\n\n\nconst ProcessQueueItemSchema = z.object({\n    id: NumberParser,\n    slug: z.string(),\n    retry_count: NumberParser,\n    error: z.string().nullish(),\n   \n});\n\nexport type ProcessQueueItem = z.infer<typeof ProcessQueueItemSchema>;\n\nexport const useSearchProcessQueue = (process_id: number, filter: ColumnFiltersState, type: 'error' | 'queue' | 'all') => {\n\n    const slug = String(filter?.find(value => value.id === 'slug')?.value || '');\n    const fetcher = useWordpressAjax<ProcessQueueItem[], {\n        process_id: number, \n        slug?: string,\n        type: 'error' |'queue' | 'all',\n    }>(\n        \"lpagery_search_queue_items\", \n        z.array(ProcessQueueItemSchema),\n        \"Fetching queue items failed\"\n    );\n\n\n    return useQuery({\n        queryKey: [`processes`, 'queue', process_id, type, slug],\n        queryFn: () => fetcher({body: {\n            process_id, \n            slug,\n            type,\n        }}),\n        placeholderData: (prev) => prev,\n        staleTime: 0,\n        refetchInterval: 10000,\n    });\n}","\"use client\";\n\nimport * as React from \"react\";\n\nimport {\n    ColumnDef,\n    ColumnFiltersState,\n    flexRender,\n    getCoreRowModel,\n    getPaginationRowModel,\n    SortingState,\n    useReactTable,\n    VisibilityState,\n} from \"@tanstack/react-table\";\n\nimport {Input} from \"@/components/ui/input\";\nimport {Table, TableBody, TableCell, TableHead, TableHeader, TableRow,} from \"@/components/ui/table\";\nimport {Skeleton} from \"@/components/common/Skeleton\";\nimport {TableFooter} from \"@/components/dashboard/save/confirm/components/table/TableFooter\";\n\nimport {ProcessQueueItem, useSearchProcessQueue} from \"@/hooks/manage/use-search-process-queue\";\nimport {Select} from \"@headlessui/react\";\n\nconst columns: ColumnDef<ProcessQueueItem>[] = [\n    {\n        accessorKey: \"slug\",\n        header: \"Page URL\",\n        cell: ({row}) => {\n            return <div className=\"font-medium\"\n                        data-testid={'process-slug-' + row.original.id}>{row.original.slug}</div>\n        },\n    },\n    {\n        accessorKey: \"retry_count\",\n        header: \"Attempts\",\n        cell: ({row}) => {\n            return <div className=\"text-center\"\n                        data-testid={'process-retry-count-' + row.original.id}>{row.original.retry_count}</div>\n        },\n    },\n    {\n        accessorKey: \"error\",\n        header: \"Status / Error Message\",\n        cell: ({row}) => {\n            return <div className=\"text-sm text-red-600\"\n                        data-testid={'process-error-' + row.original.id}>{row.original.error}</div>\n        },\n    }\n];\n\ninterface SyncQueueTableProps {\n    process_id: number;\n    type: 'error' | 'queue' | 'all';\n}\n\nexport function SyncQueueTable({process_id, type: typeParam}: SyncQueueTableProps) {\n    const [sorting, setSorting] = React.useState<SortingState>([]);\n    const [columnFilters, setColumnFilters] = React.useState<ColumnFiltersState>([]);\n    const [columnVisibility, setColumnVisibility] =\n        React.useState<VisibilityState>({});\n    const [rowSelection, setRowSelection] = React.useState({});\n    const [pagination, setPagination] = React.useState({\n        pageIndex: 0,\n        pageSize: 20,\n    });\n\n    const [type, setType] = React.useState(typeParam);\n\n    const {data, isLoading} = useSearchProcessQueue(process_id, columnFilters, type);\n\n    const tableData = React.useMemo(() => {\n        return isLoading ? [] : (data || []);\n    }, [data, isLoading]);\n\n    const table = useReactTable({\n        data: tableData,\n        columns,\n        onSortingChange: setSorting,\n        onColumnFiltersChange: setColumnFilters,\n        onColumnVisibilityChange: setColumnVisibility,\n        onRowSelectionChange: setRowSelection,\n        getCoreRowModel: getCoreRowModel(),\n        getPaginationRowModel: getPaginationRowModel(),\n        manualPagination: false,\n        manualSorting: true,\n        manualFiltering: true,\n        state: {\n            sorting,\n            columnFilters,\n            columnVisibility,\n            rowSelection,\n            pagination,\n        },\n        onPaginationChange: setPagination,\n    });\n\n\n    return (\n        <div className=\"w-full\">\n            <div className=\"flex items-center py-4 space-x-4\">\n                <Input\n                    data-testid={'search-slug'}\n                    placeholder=\"Search by page URL...\"\n                    value={(table.getColumn(\"slug\")?.getFilterValue() as string) ?? \"\"}\n                    onChange={(event) =>\n                        table.getColumn(\"slug\")?.setFilterValue(event.target.value)\n                    }\n                    className=\"max-w-md\"\n                />\n\n                <Select value={type} name={'filter-type'} \n                        className=\"w-[140px] bg-white border border-gray-300 rounded-md py-2 px-3 text-left cursor-default focus:outline-none focus:ring-1 focus:ring-custom-blue-600 focus:border-custom-blue-600 data-[hover]:shadow cursor-pointer\"\n                        data-testid={'filter-queue-type'}\n                        onChange={event => {\n                            setType(event.target.value as 'error' | 'queue' | 'all')\n                        }}>\n\n                    <option className=\"py-2 px-3 hover:bg-blue-50 cursor-pointer text-gray-900\" value={'all'}>All\n                        Items\n                    </option>\n                    <option className=\"py-2 px-3 hover:bg-blue-50 cursor-pointer text-gray-900\" value={'queue'}>In\n                        Queue\n                    </option>\n                    <option className=\"py-2 px-3 hover:bg-blue-50 cursor-pointer text-gray-900\" value={'error'}>Failed\n                        Items\n                    </option>\n                </Select>\n\n\n            </div>\n            {data?.length && data.length === 1000 ?\n                <div className=\"text-sm text-gray-500\">Showing max 1000 items</div> : <></>}\n\n            <div className=\"rounded-md border\">\n\n                <Table>\n                    <TableHeader>\n                        {table.getHeaderGroups().map((headerGroup) => (\n                            <TableRow key={headerGroup.id} className=\"bg-gray-50\">\n                                {headerGroup.headers.map((header) => {\n                                    return (\n                                        <TableHead key={header.id} className=\"py-3 px-4 text-left font-semibold\">\n                                            {header.isPlaceholder\n                                                ? null\n                                                : flexRender(\n                                                    header.column.columnDef.header,\n                                                    header.getContext()\n                                                )}\n                                        </TableHead>\n                                    );\n                                })}\n                            </TableRow>\n                        ))}\n                    </TableHeader>\n                    <TableBody>\n                        {isLoading ? (\n                            <TableRow>\n                                <TableCell\n                                    colSpan={columns.length}\n                                    className=\"h-24 text-center\"\n                                >\n                                    <Skeleton/>\n                                </TableCell>\n                            </TableRow>\n                        ) : tableData.length > 0 ? (\n                            table.getRowModel().rows.map((row) => (\n                                <TableRow\n                                    key={row.id}\n                                    data-state={row.getIsSelected() && \"selected\"}\n                                >\n                                    {row.getVisibleCells().map((cell) => (\n                                        <TableCell key={cell.id} className=\"py-3 px-4\">\n                                            {flexRender(\n                                                cell.column.columnDef.cell,\n                                                cell.getContext()\n                                            )}\n                                        </TableCell>\n                                    ))}\n                                </TableRow>\n                            ))\n                        ) : (\n                            <TableRow>\n                                <TableCell colSpan={columns.length} className=\"h-24 text-center\">\n                                    <div className=\"text-sm text-gray-500\">No items found</div>\n                                </TableCell>\n                            </TableRow>\n                        )}\n                    </TableBody>\n                </Table>\n            </div>\n            <div className=\"sticky mt-2 bottom-0 bg-white \">\n                <TableFooter\n                    currentPage={pagination.pageIndex + 1}\n                    totalPages={Math.ceil((tableData?.length || 0) / pagination.pageSize)}\n                    itemsPerPage={pagination.pageSize}\n                    totalItems={tableData?.length || 0}\n                    goToPage={(page: number) => table.setPageIndex(page - 1)}\n                    nextPage={() => table.nextPage()}\n                    previousPage={() => table.previousPage()}\n                />\n            </div>\n        </div>\n    );\n}\n","// EditSheetSyncDialog.tsx\n\n\nimport {ProcessListItem} from \"@/hooks/manage/use-search-processes\";\nimport {Dialog, Transition} from \"@headlessui/react\";\nimport React from \"react\";\nimport {SyncQueueTable} from \"./SyncQueueTable\";\nimport {ErrorBoundaryWrapper} from \"@/components/layout/error/ErrorBoundaryWrapper\";\n\ninterface Props {\n    process: ProcessListItem;\n    type: 'error' | 'queue' | 'all';\n    isOpen: boolean;\n    onClose: () => void;\n}\n\nexport const SyncQueueDialog = ({process, type, isOpen, onClose}: Props) => {\n    return (\n        <Transition appear show={isOpen} as={React.Fragment}>\n            <Dialog as=\"div\" className=\"relative z-20\" onClose={onClose}>\n                <Transition.Child\n                    as={React.Fragment}\n                    enter=\"ease-out duration-300\"\n                    enterFrom=\"opacity-0\"\n                    enterTo=\"opacity-100\"\n                    leave=\"ease-in duration-200\"\n                    leaveFrom=\"opacity-100\"\n                    leaveTo=\"opacity-0\"\n                >\n                    <div className=\"fixed inset-0 bg-black/30 backdrop-blur-sm\" aria-hidden=\"true\"/>\n                </Transition.Child>\n                <div className=\"fixed inset-0 overflow-y-auto\">\n                    <div className=\"flex min-h-full items-center justify-center p-4 text-center\">\n                        <Transition.Child\n                            as={React.Fragment}\n                            enter=\"ease-out duration-300\"\n                            enterFrom=\"opacity-0 scale-95\"\n                            enterTo=\"opacity-100 scale-100\"\n                            leave=\"ease-in duration-200\"\n                            leaveFrom=\"opacity-100 scale-100\"\n                            leaveTo=\"opacity-0 scale-95\"\n                        >\n                            <Dialog.Panel\n                                className=\"w-full max-w-5xl transform overflow-hidden rounded-2xl bg-white p-6 text-left align-middle shadow-xl transition-all\">\n                                <div className=\"w-full\">\n\n                                    <div className=\"mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left\">\n                                        <Dialog.Title as=\"h3\" className=\"text-lg font-semibold leading-6 text-gray-900\">\n                                            Sync Queue Status\n                                        </Dialog.Title>\n                                        <p className=\"text-sm text-gray-500 mt-1\">\n                                            {process.purpose_with_name}\n                                        </p>\n                                        <div className=\"mt-4\">\n\n                                            <div>\n                                                <ErrorBoundaryWrapper>\n                                                    <SyncQueueTable process_id={process.id} type={type}/>\n                                                </ErrorBoundaryWrapper>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </Dialog.Panel>\n                        </Transition.Child>\n                    </div>\n                </div>\n            </Dialog>\n        </Transition>\n    );\n};\n","import {ProcessListItem} from \"@/hooks/manage/use-search-processes\";\nimport {Tooltip, TooltipContent, TooltipProvider, TooltipTrigger} from \"@/components/ui/tooltip\";\nimport {useWpmlInstalled} from \"@/hooks/use-wpml-installed\";\nimport { SyncQueueDialog } from \"./menu/dialogs/sync_queue/SyncQueueDialog\";\nimport { useState } from \"react\";\n\ninterface Props {\n    process: ProcessListItem;\n}\n\nexport const SyncStatsCell = ({process}: Props) => {\n    const wpmlInstalled = useWpmlInstalled()\n    const [isOpen, setIsOpen] = useState(false);\n    const [type, setType] = useState<'all' | 'error' | 'queue'>('all');\n    let url = `edit.php?post_type=${process.post.type}&lpagery_process=${process.id}&orderby=date&order=desc`;\n\n    if(wpmlInstalled) {\n        let languageCode = \"all\";\n        if(process.post.language_code) {\n            languageCode = process.post.language_code;\n        }\n        url += `&lang=${languageCode}`;\n    }\n    return (\n        <>\n        <div className=\"flex flex-col\">\n            {process.post_count > 0 && <TooltipProvider>\n                    <Tooltip>\n                        <TooltipTrigger asChild>\n                            <a\n                                href={url}\n                            >\n                                {process.post_count} Created\n                            </a>\n                        </TooltipTrigger>\n                        <TooltipContent>\n                            <p>Number of pages successfully created</p>\n                        </TooltipContent>\n                    </Tooltip>\n                    </TooltipProvider>}\n                {process.in_queue > 0 && <TooltipProvider>\n                    <Tooltip>\n                        <TooltipTrigger asChild>\n                            <span className=\"cursor-pointer\" data-testid={\"queued-count-\" + process.id} onClick={() => {setIsOpen(true); setType('queue')}}>{process.in_queue} Queued</span>\n                        </TooltipTrigger>\n                        <TooltipContent>\n                            <p>Number of pages waiting to be processed</p>\n                        </TooltipContent>\n                    </Tooltip>\n                </TooltipProvider>}\n                {process.errored > 0 && <TooltipProvider>\n                    <Tooltip>\n                        <TooltipTrigger asChild>\n                            <span className=\"cursor-pointer\" data-testid={\"error-count-\" + process.id} onClick={() => {setIsOpen(true); setType('error')}}>{process.errored} Error</span>\n                        </TooltipTrigger>\n                        <TooltipContent>\n                            <p>Number of pages that failed to be created</p>\n                        </TooltipContent>\n                    </Tooltip>\n                </TooltipProvider>} \n            </div>  \n            {isOpen && <SyncQueueDialog process={process} type={type} isOpen={isOpen} onClose={() => setIsOpen(false)} />}  \n         </>\n    )\n}\n","\"use client\";\n\nimport * as React from \"react\";\nimport {useContext} from \"react\";\n\nimport {\n    ColumnDef,\n    ColumnFiltersState,\n    flexRender,\n    getCoreRowModel,\n    SortingState,\n    useReactTable,\n    VisibilityState,\n    getPaginationRowModel,\n} from \"@tanstack/react-table\";\n\nimport {Input} from \"@/components/ui/input\";\nimport {Table, TableBody, TableCell, TableHead, TableHeader, TableRow,} from \"@/components/ui/table\";\nimport {ProcessListItem, useSearchProcesses} from \"@/hooks/manage/use-search-processes\";\nimport {Select, SelectContent, SelectItem, SelectTrigger, SelectValue} from \"@/components/ui/select\";\nimport {useFetchTemplatePages} from \"@/hooks/manage/use-fetch-template-pages\";\nimport useUsers from \"@/hooks/dashboard/query/use-users\";\nimport {ProcessTableDropdownMenu} from \"@/components/dashboard/manage/menu/ProcessTableDropdownMenu\";\nimport {SheetSyncStatusBadge} from \"@/components/dashboard/manage/SheetSyncStatusBadge\";\nimport PlayListAddIcon from \"@/Icons/play-list-add-twotone-rounded\";\nimport {Button} from \"@/components/ui/button\";\nimport {SparklesIcon} from \"@heroicons/react/24/outline\";\nimport {HeaderContext} from \"@/context/header-context\";\nimport {Skeleton} from \"@/components/common/Skeleton\";\nimport {SyncStatsCell} from \"@/components/dashboard/manage/SyncStatsCell\";\nimport {PostLinkWithFlag} from \"@/components/common/PostLinkWithFlag\";\nimport {FlagImage} from \"@/components/common/FlagImage\";\nimport {getSubscription} from \"@/hooks/subscription/use-subscription\";\nimport {TableFooter} from \"@/components/dashboard/save/confirm/components/table/TableFooter\";\n\n\nconst columns: ColumnDef<ProcessListItem>[] = [\n    {\n        accessorKey: \"purpose\",\n        header: \"Purpose/Name\",\n        cell: ({row}) => {\n            const displayPurpose = row.original.purpose_with_name;\n            return <div data-testid={'process-purpose-' + row.original.id}>{displayPurpose}</div>\n        },\n\n    },\n    {\n        accessorKey: \"user\",\n        header: \"User\",\n        cell: ({row}) => {\n            const name = row.original.user.name ?? 'Deleted User';\n            return <div data-testid={'process-user-' + row.original.id}>{name}</div>\n        },\n    },\n    {\n        accessorKey: \"template\",\n        header: \"Template\",\n        cell: ({row}) => {\n            const {post} = row.original;\n            return post.deleted ? (\n                <span data-testid={'process-template-' + row.original.id}>{post.title}</span>\n            ) : (\n                <PostLinkWithFlag post={post}/>\n            );\n        },\n    },\n    {\n        accessorKey: \"post_count\",\n        header: \"# Pages\",\n        cell: ({row}) => {\n            return (\n                <SyncStatsCell process={row.original} data-testid={'process-post-count-' + row.original.id}></SyncStatsCell>\n\n            );\n        },\n    },\n    {\n        accessorKey: \"created\",\n        header: \"Date\",\n        cell: ({row}) => <div data-testid={'process-created-' + row.original.id}>{row.getValue(\"created\")}</div>,\n    },\n    {\n        accessorKey: \"google_sheet_sync_status\",\n        header: \"Sync Status\",\n        cell: ({row}) => {\n            const {extended} = getSubscription()\n            if (!extended) {\n                return <></>\n            }\n            const {google_sheet_sync_enabled, google_sheet_sync_status} = row.original;\n\n            if (!google_sheet_sync_enabled) return <></>\n\n\n            return <div data-testid={'process-sync-status-' + row.original.id}>\n                <SheetSyncStatusBadge status={google_sheet_sync_status}/>\n                </div>\n\n        },\n    },\n    {\n        id: \"actions\",\n        header: \"Actions\",\n        cell: ({row}) => {\n            return (\n                <ProcessTableDropdownMenu process={row.original}/>\n            );\n        },\n    },\n];\n\nexport function ProcessTable() {\n    const [sorting, setSorting] = React.useState<SortingState>(() => {\n        const saved = localStorage.getItem('processTable.sorting');\n        return saved ? JSON.parse(saved) : [];\n    });\n    const [columnFilters, setColumnFilters] = React.useState<ColumnFiltersState>(() => {\n        const saved = localStorage.getItem('processTable.columnFilters');\n        return saved ? JSON.parse(saved) : [];\n    });\n    const [columnVisibility, setColumnVisibility] =\n        React.useState<VisibilityState>({});\n    const [rowSelection, setRowSelection] = React.useState({});\n    const [pagination, setPagination] = React.useState({\n        pageIndex: 0,\n        pageSize: 10,\n    });\n\n    const {data, isLoading} = useSearchProcesses(columnFilters);\n\n    const tableData = React.useMemo(() => {\n        return isLoading ? [] : (data || []);\n    }, [data, isLoading]);\n\n    const table = useReactTable({\n        data: tableData,\n        columns,\n        onSortingChange: setSorting,\n        onColumnFiltersChange: setColumnFilters,\n        onColumnVisibilityChange: setColumnVisibility,\n        onRowSelectionChange: setRowSelection,\n        getCoreRowModel: getCoreRowModel(),\n        getPaginationRowModel: getPaginationRowModel(),\n        manualPagination: false,\n        manualSorting: true,\n        manualFiltering: true,\n        state: {\n            sorting,\n            columnFilters,\n            columnVisibility,\n            rowSelection,\n            pagination,\n        },\n        onPaginationChange: setPagination,\n    });\n\n    const templatePageFilterResponse = useFetchTemplatePages();\n    const userFilterResponse = useUsers();\n\n\n    const {setHeader} = useContext(HeaderContext)\n\n    React.useEffect(() => {\n        localStorage.setItem('processTable.sorting', JSON.stringify(sorting));\n    }, [sorting]);\n\n    React.useEffect(() => {\n        localStorage.setItem('processTable.columnFilters', JSON.stringify(columnFilters));\n    }, [columnFilters]);\n\n    return (\n        <div className=\"w-full\">\n            <div className=\"flex items-center py-4 space-x-4\">\n                <Input\n                    data-testid={'search-processes'}\n                    placeholder=\"Search Created Pages...\"\n                    value={(table.getColumn(\"purpose\")?.getFilterValue() as string) ?? \"\"}\n                    onChange={(event) =>\n                        table.getColumn(\"purpose\")?.setFilterValue(event.target.value)\n                    }\n                    className=\"max-w-sm\"\n                />\n\n               \n\n                <Select value={(table.getColumn(\"template\")?.getFilterValue() as string) ?? \"\"} name={'filter-page'}\n                        onValueChange={value => {\n                            table.getColumn(\"template\")?.setFilterValue(value)\n                        }}>\n                    <SelectTrigger data-testid={'filter-template'}>\n                        <SelectValue placeholder=\"All Pages\"/>\n                    </SelectTrigger>\n                    <SelectContent>\n                        <SelectItem value={'-1'}>All Pages</SelectItem>\n                        {templatePageFilterResponse?.data?.map(page => {\n                            return <SelectItem key={String(page.id)} value={String(page.id)}>\n                                <div className=\"flex items-center\">\n                                    {page.language_code &&\n\n                                        <FlagImage language_code={page.language_code}/>\n                                    }\n                                    {page.title}\n                                </div>\n                            </SelectItem>\n                        })}\n\n                    </SelectContent>\n                </Select>\n                <Select value={(table.getColumn(\"user\")?.getFilterValue() as string) ?? \"\"} name={'filter-user'}\n                        onValueChange={value => {\n                            table.getColumn(\"user\")?.setFilterValue(value)\n                        }}>\n                    <SelectTrigger data-testid={'filter-user'}>\n                        <SelectValue placeholder=\"All Users\"/>\n                    </SelectTrigger>\n                    <SelectContent>\n                        <SelectItem value={'-1'}>All Users</SelectItem>\n\n                        {userFilterResponse?.data?.map(user => {\n                            return <SelectItem key={String(user.id)} value={String(user.id)}>{user.label}</SelectItem>\n                        })}\n\n                    </SelectContent>\n                </Select>\n                <Select \n                    value={(table.getColumn(\"post_count\")?.getFilterValue() as string) ?? \"non-empty\"}\n                    name={'filter-empty-sets'}\n                    onValueChange={value => {\n                        table.getColumn(\"post_count\")?.setFilterValue(value)\n                    }}\n                >\n                    <SelectTrigger data-testid={'filter-empty-sets'}>\n                        <SelectValue placeholder=\"Show Empty Sets\"/>\n                    </SelectTrigger>\n                    <SelectContent>\n                        <SelectItem value=\"all\">Show All</SelectItem>\n                        <SelectItem value=\"non-empty\">Hide Empty Sets</SelectItem>\n                        <SelectItem value=\"empty\">Show Only Empty Sets</SelectItem>\n                    </SelectContent>\n                </Select>\n\n            </div>\n\n            <>\n                <div className=\"rounded-md border\">\n                    <Table>\n                        <TableHeader>\n                            {table.getHeaderGroups().map((headerGroup) => (\n                                <TableRow key={headerGroup.id}>\n                                    {headerGroup.headers.map((header) => {\n                                        return (\n                                            <TableHead key={header.id}>\n                                                {header.isPlaceholder\n                                                    ? null\n                                                    : flexRender(\n                                                        header.column.columnDef.header,\n                                                        header.getContext()\n                                                    )}\n                                            </TableHead>\n                                        );\n                                    })}\n                                </TableRow>\n                            ))}\n                        </TableHeader>\n                        <TableBody>\n                            {isLoading ? (\n                                <TableRow>\n                                    <TableCell\n                                        colSpan={columns.length}\n                                        className=\"h-24 text-center\"\n                                    >\n                                        <Skeleton />\n                                    </TableCell>\n                                </TableRow>\n                            ) : table.getPageCount() > 0 ? (\n                                table.getRowModel().rows.map((row) => (\n                                    <TableRow\n                                        key={row.id}\n                                        data-testid={`process-row-${row.original.id}`}\n                                        data-state={row.getIsSelected() && \"selected\"}\n                                    >\n                                        {row.getVisibleCells().map((cell) => (\n                                            <TableCell key={cell.id}>\n                                                {flexRender(\n                                                    cell.column.columnDef.cell,\n                                                    cell.getContext()\n                                                )}\n                                            </TableCell>\n                                        ))}\n                                    </TableRow>\n                                ))\n                            ) : (\n                                <TableRow>\n                                    <TableCell\n                                        colSpan={columns.length}\n                                        className=\"h-24 text-center\"\n                                    >\n                                        {!isLoading ? <button\n                                            type=\"button\"\n                                            className=\"relative block w-full rounded-lg  p-12 text-center hover:border-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2\"\n                                        >\n                                            <PlayListAddIcon className=\"mx-auto h-12 w-12\"/>\n                                            <div className=\"mt-2\">\n                                                <span className=\"mt-2 block text-sm font-semibold text-gray-900\">You have no pages created yet.</span>\n                                                <p className=\"text-sm text-gray-500\">Here you will be able to manage\n                                                    your pages. Get started by creating your first pages.</p>\n                                                <Button className=\"mt-6\" onClick={() => {\n                                                    setHeader(\"create\")\n                                                }}>Create Pages <SparklesIcon\n                                                    className=\"ml-2 h-6 w-6 text-white\"/></Button>\n                                            </div>\n\n                                        </button> : <Skeleton/>}\n                                    </TableCell>\n                                </TableRow>\n                            )}\n                        </TableBody>\n                    </Table>\n                </div>\n                <div className=\"sticky mt-2 bottom-0 bg-white \">\n                    <TableFooter\n                        currentPage={pagination.pageIndex + 1}\n                        totalPages={Math.ceil((tableData?.length || 0) / pagination.pageSize)}\n                        itemsPerPage={pagination.pageSize}\n                        totalItems={tableData?.length || 0}\n                        goToPage={(page: number) => table.setPageIndex(page - 1)}\n                        nextPage={() => table.nextPage()}\n                        previousPage={() => table.previousPage()}\n                    />\n                </div>\n            </>\n        </div>\n    );\n}\n","import {ProcessTable} from \"@/components/dashboard/manage/ProcessTable\";\nimport {ErrorBoundaryWrapper} from \"@/components/layout/error/ErrorBoundaryWrapper\";\nimport {Card} from \"@/components/ui/card\";\n\nexport const ManageArea = () => {\n    return (\n        <div className=\"relative\">\n            <Card className=\"w-full p-12\">\n                <ErrorBoundaryWrapper>\n                <ProcessTable></ProcessTable>\n                </ErrorBoundaryWrapper>\n            </Card>\n        </div>\n\n    )\n}","import React from \"react\"; \n\nconst CodeIcon = (props: React.SVGProps<SVGSVGElement>) => (\n  <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" width={24} height={24} color={\"#003049\"} fill={\"none\"} {...props}>\n    <path d=\"M8 12H8.00897H8ZM11.9955 12H12.0045H11.9955ZM15.991 12H16H15.991Z\" fill=\"#D9D9D9\" />\n    <path d=\"M8 12H8.00897M11.9955 12H12.0045M15.991 12H16\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n    <path d=\"M18 3H18.5C19.6046 3 20.5 3.89543 20.5 5V9.33333C20.5 9.76607 20.6404 10.1871 20.9 10.5333L22 12L20.9 13.4667C20.6404 13.8129 20.5 14.2339 20.5 14.6667V19C20.5 20.1046 19.6046 21 18.5 21H18\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n    <path d=\"M6 3H5.5C4.39543 3 3.5 3.89543 3.5 5V9.33333C3.5 9.76607 3.35964 10.1871 3.1 10.5333L2 12L3.1 13.4667C3.35964 13.8129 3.5 14.2339 3.5 14.6667V19C3.5 20.1046 4.39543 21 5.5 21H6\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n  </svg>\n);\n\nexport default CodeIcon;","import React from \"react\"; \n\nconst StructureAddIcon = (props: React.SVGProps<SVGSVGElement>) => (\n  <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" width={24} height={24} color={\"#003049\"} fill={\"none\"} {...props}>\n    <path d=\"M21 22C21.5523 22 22 21.5523 22 21V17C22 16.4477 21.5523 16 21 16H16C15.4477 16 15 16.4477 15 17V21C15 21.5523 15.4477 22 16 22H21Z\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinejoin=\"round\" />\n    <path d=\"M21 8C21.5523 8 22 7.55228 22 7V3C22 2.44772 21.5523 2 21 2H16C15.4477 2 15 2.44772 15 3V7C15 7.55228 15.4477 8 16 8H21Z\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinejoin=\"round\" />\n    <path d=\"M9 12H7M7 12H5M7 12V14M7 12V10M12 12C12 14.7614 9.76142 17 7 17C4.23858 17 2 14.7614 2 12C2 9.23858 4.23858 7 7 7C9.76142 7 12 9.23858 12 12Z\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n    <path d=\"M11.9947 4H9C7.89543 4 7 4.89543 7 6V6.49575M12 20H9C7.89543 20 7 19.1046 7 18V17.5072\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n  </svg>\n);\n\nexport default StructureAddIcon;","import React from \"react\"; \n\nconst SourceCodeIcon = (props: React.SVGProps<SVGSVGElement>) => (\n  <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" width={24} height={24} color={\"#003049\"} fill={\"none\"} {...props}>\n    <path d=\"M18 8L21 11.5L18 15\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n    <path d=\"M6 8L3 11.5L6 15\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n    <path d=\"M9.5 20L14.5 4\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n  </svg>\n);\n\nexport default SourceCodeIcon;","export default \"__VITE_ASSET__CZE_q5WD__\"","import {Disclosure, DisclosureButton, DisclosurePanel, Popover, PopoverButton, PopoverPanel} from '@headlessui/react'\nimport {\n    ArrowPathIcon,\n    Bars3Icon,\n    Cog6ToothIcon,\n    FingerPrintIcon,\n    PlusIcon,\n    RocketLaunchIcon,\n    Square3Stack3DIcon,\n    WrenchScrewdriverIcon,\n    XMarkIcon\n} from '@heroicons/react/24/outline'\nimport {ChevronDownIcon} from '@heroicons/react/20/solid'\nimport CodeIcon from \"@/Icons/code-stroke-standard\";\nimport StructureAddIcon from \"@/Icons/structure-add-stroke-standard\";\nimport SourceCodeIcon from \"@/Icons/source-code-stroke-standard\";\nimport {useContext} from \"react\";\nimport {HeaderContext, SelectableHeaderType} from \"@/context/header-context\";\nimport {useSubscription} from \"@/hooks/subscription/use-subscription\"\n// @ts-ignore\nimport logoImage from '@/assets/lpagery-logo-white-name.png';\n\nconst navigation  = [\n    { name: 'Create Pages', key: 'create', icon: PlusIcon },\n    { name: 'Update Pages', key: 'update',  icon: ArrowPathIcon },\n    { name: 'Manage Pages', key: \"manage\",  icon: Square3Stack3DIcon },\n    { name: 'Settings', key: 'settings', icon: Cog6ToothIcon },\n]\n\n\nconst solutions = [\n    { name: 'Source File Creator', description: 'Create a source file to create your pages without needing an external tool', href: '#', icon: CodeIcon },\n    { name: 'Keyword Combinator', description: \"Automatically create keyword combinations for your source file\", href: '#', icon: StructureAddIcon },\n    { name: 'Shortcode Builder', description: 'Easily create shortcodes to display the created pages everywhere on your website', href: '#', icon: SourceCodeIcon },\n    { name: 'Template Page Creator', description: \"Easily create a new template page\", href: '#', icon: FingerPrintIcon },\n\n    { name: 'More Coming Soon', description: 'We will add more tools to the tools section', href: '#', icon: ArrowPathIcon, disabled: true },\n]\n\n\nfunction classNames(...classes: string[]): string {\n    return classes.filter(Boolean).join(' ')\n}\n\nexport default function Header() {\n    const sub = useSubscription()\n    const headerContext = useContext(HeaderContext);\n\n    return (\n        <>\n            <div className=\" bg-custom-blue-400 pb-2 \" >\n                <Disclosure as=\"nav\" className=\"bg-custom-blue-400 \">\n                    <div className=\"mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n                        <div className=\"flex h-16 justify-between\">\n                            <div className=\"flex\">\n                                <div className=\"flex flex-shrink-0 items-center\">\n                                    <img\n                                        alt=\"LPagery Logo\"\n                                        src={logoImage}\n                                        className=\"block h-12 w-auto lg:hidden\"\n                                    />\n                                    <img\n                                        alt=\"LPagery Logo\"\n                                        src={logoImage}\n                                        className=\"hidden h-12 w-auto lg:block\"\n                                    />\n                                </div>\n                                <div className=\"hidden sm:-my-px sm:ml-16 sm:flex sm:space-x-4\">\n                                    {navigation.map((item) => (\n\n                                        item.name === 'Tools' ? (\n                                            <Popover key={item.name} className=\"relative\">\n                                                <PopoverButton\n                                                    className={classNames(\n                                                        headerContext.header === item.key\n                                                            ? 'font-semibold before:absolute text-custom-blue-100 before:bottom-0 before:left-0 before:right-0 before:h-0.5 before:bg-gradient-to-r before:from-[#4C88BA] before:to-[#85C9B3]'\n                                                            : 'font-normal text-custom-blue-100 hover:text-custom-blue-100',\n                                                        'relative inline-flex items-center px-4 py-2 text-sm h-16 leading-8'\n                                                    )}\n                                                >\n                                                    <WrenchScrewdriverIcon className=\"mr-1.5 h-5 w-5\" aria-hidden=\"true\" />\n                                                    <span>Tools</span>\n                                                    <ChevronDownIcon className=\"ml-1.5 h-5 w-5\" aria-hidden=\"true\" />\n                                                </PopoverButton>\n\n                                                <PopoverPanel className=\"absolute left-1/2 z-10 mt-5 flex w-screen max-w-max -translate-x-1/2 px-4\">\n                                                    <div className=\"w-screen max-w-md flex-auto overflow-hidden rounded-lg bg-white text-sm leading-6 shadow-lg ring-1 ring-gray-900/5\">\n                                                        <div className=\"p-4\">\n                                                            {solutions.map((item) => (\n                                                                <div key={item.name} className={`group relative flex gap-x-6 rounded-lg p-4 ${item.disabled ? 'opacity-50 cursor-not-allowed' : 'hover:bg-gray-50'}`}>\n                                                                    <div className={`mt-1 flex h-11 w-11 flex-none items-center justify-center rounded-lg bg-gray-50 ${item.disabled ? '' : 'group-hover:bg-white'}`}>\n                                                                        <item.icon className={`h-6 w-6 ${item.disabled ? 'text-gray-400' : 'text-gray-600 group-hover:text-indigo-600'}`} aria-hidden=\"true\" />\n                                                                    </div>\n                                                                    <div>\n                                                                        <span className={`font-semibold ${item.disabled ? 'text-gray-400' : 'text-gray-900'}`}>\n                                                                            {item.name}\n                                                                            {!item.disabled && <span className=\"absolute inset-0\" />}\n                                                                        </span>\n                                                                        <p className={`mt-1 ${item.disabled ? 'text-gray-400' : 'text-gray-600'}`}>{item.description}</p>\n                                                                    </div>\n                                                                </div>\n                                                            ))}\n                                                        </div>\n\n                                                    </div>\n                                                </PopoverPanel>\n                                            </Popover>\n                                        ) : (\n                                            <a\n                                                key={ item.name}\n                                                aria-current={headerContext.header === item.key ? 'page' : undefined}\n                                                onClick={() => {\n                                                    headerContext.setHeader(item.key as SelectableHeaderType);\n                                                }}\n                                                className={classNames(\n                                                    headerContext.header === item.key\n                                                        ? 'font-semibold text-custom-blue-100 relative before:content-[\"\"] before:absolute before:bottom-0 before:left-0 before:right-0 before:h-0.5 before:bg-gradient-to-r before:from-[#4C88BA] before:to-[#85C9B3]'\n                                                        : 'font-normal text-custom-blue-100 hover:text-custom-blue-100',\n                                                    'inline-flex items-center px-4 py-2 text-sm h-16 leading-8 cursor-pointer'\n                                                )}\n                                            >\n                                                <item.icon className=\"mr-1.5 h-5 w-5\" aria-hidden=\"true\"/>\n                                                {item.name}\n                                            </a>\n                                        )\n                                    ))}\n                                </div>\n                            </div>\n                           <div className=\"flex items-center\">\n                               {sub.free &&  <button\n                                    type=\"button\"\n                                    onClick={(e) => {\n                                        e.preventDefault();\n                                        window.open('https://lpagery.io/pricing?utm_source=free_version&utm_medium=header_cta&utm_campaign=free', '_blank');\n                                    }}\n                                    className=\"rounded-md bg-gradient-to-r text-sm from-[#4C88BA] to-[#4C88BA] px-3 py-2 text-white shadow-sm hover:opacity-80 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#4C88BA] flex items-center\"\n                                >\n                                    <span>Get All Features with LPagery Pro</span>\n                                    <RocketLaunchIcon className=\"h-5 w-5 ml-2\" aria-hidden=\"true\" />\n                                </button>}\n                                <div className=\"ml-4 -mr-2 flex items-center sm:hidden\">\n                                    {/* Mobile menu button */}\n                                    <DisclosureButton className=\"group relative inline-flex items-center justify-center rounded-md bg-white p-2 text-gray-400 hover:bg-gray-100 hover:text-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2\">\n                                        <span className=\"absolute -inset-0.5\" />\n                                        <span className=\"sr-only\">Open main menu</span>\n                                        <Bars3Icon aria-hidden=\"true\" className=\"block h-6 w-6 group-data-[open]:hidden\" />\n                                        <XMarkIcon aria-hidden=\"true\" className=\"hidden h-6 w-6 group-data-[open]:block\" />\n                                    </DisclosureButton>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n                    <DisclosurePanel className=\"sm:hidden\">\n                        <div className=\"space-y-1 pb-3 pt-2\">\n                            {navigation.map((item) => (\n                                <DisclosureButton\n                                    key={item.name}\n                                    as=\"a\"\n                                    onClick={() => {\n                                        headerContext.setHeader(item.key as SelectableHeaderType);\n                                    }}\n\n                                    aria-current={ headerContext.header === item.key ? 'page' : undefined}\n                                    className={classNames(\n                                        headerContext.header === item.key\n                                            ? 'bg-gradient-to-r from-[#4C88BA] to-[#85C9B3] text-white'\n                                            : 'text-gray-600 hover:bg-gray-50 hover:text-gray-800',\n                                        'flex items-center py-2 pl-3 pr-4 text-base font-medium'\n                                    )}\n                                >\n                                    <item.icon className=\"mr-3 h-6 w-6\" aria-hidden=\"true\" />\n                                    {item.name}\n                                </DisclosureButton>\n                            ))}\n                        </div>\n                    </DisclosurePanel>\n                </Disclosure>\n\n            </div>\n\n        </>\n    )\n}\n","import {Card} from \"@/components/ui/card\";\nimport {\n    AdjustmentsHorizontalIcon,\n    ArrowPathIcon,\n    ChatBubbleLeftRightIcon,\n    DocumentArrowUpIcon,\n    PlayIcon,\n    StarIcon,\n    TableCellsIcon\n} from '@heroicons/react/24/outline'\nimport {useSubscription} from \"@/hooks/subscription/use-subscription\";\n\ntype SidebarAction = {\n    id: string;\n    title: string;\n    href: string;\n    icon: React.ElementType;\n    iconForeground: string;\n    iconBackground: string;\n    description: string;\n    onClick?: (e: React.MouseEvent) => void;\n}\nexport const Sidebar = () => {\n    const subscription = useSubscription();\n\n    const sidebarActions: SidebarAction[] = [\n        {\n            id: 'getting-started',\n            title: 'Getting Started Guide',\n            href: 'https://intercom.help/lpagery/en/articles/10007293-getting-started-with-lpagery',\n            icon: PlayIcon,\n            iconForeground: 'text-blue-700',\n            iconBackground: 'bg-blue-50',\n            description: 'Complete guide to set up and use LPagery effectively in under 5 minutes.',\n        },\n        {\n            id: 'create-template',\n            title: 'How to Create a Template Page',\n            href: 'https://intercom.help/lpagery/en/articles/10011295-create-a-template-page',\n            icon: DocumentArrowUpIcon,\n            iconForeground: 'text-green-700',\n            iconBackground: 'bg-green-50',\n            description: 'Learn how to create and customize template pages for your projects.',\n        },\n        {\n            id: 'create-source',\n            title: 'How to Create a Source File',\n            href: 'https://intercom.help/lpagery/en/articles/10010144-create-a-source-file',\n            icon: TableCellsIcon,\n            iconForeground: 'text-purple-700',\n            iconBackground: 'bg-purple-50',\n            description: 'Step-by-step guide to create and structure your source files.',\n        },\n        {\n            id: 'restart-onboarding',\n            title: 'Restart Onboarding',\n            href: '#',\n            onClick: () => {\n                sessionStorage.removeItem('onboarding_form');\n                sessionStorage.removeItem('onboarding_step');\n                localStorage.removeItem('lpagery_intro_showed_free');\n                window.location.reload();\n            },\n            icon: ArrowPathIcon,\n            iconForeground: 'text-orange-700',\n            iconBackground: 'bg-orange-50',\n            description: 'Want to see the introduction again? Restart the onboarding process here.',\n        },\n    ];\n\n    const proSidebarActions: SidebarAction[] = [\n        {\n            id: 'getting-started',\n            title: 'Get Started with LPagery',\n            href: 'https://intercom.help/lpagery/en/articles/10007293-getting-started-with-lpagery',\n            icon: PlayIcon,\n            iconForeground: 'text-green-700',\n            iconBackground: 'bg-green-50',\n            description: 'Learn how to set up LPagery and start generating landing pages in minutes.',\n        },\n        {\n            id: 'adjust-settings',\n            title: 'Adjust Creation Settings via Source File',\n            href: 'https://intercom.help/lpagery/en/articles/10011846-adjust-page-settings-via-source-file',\n            icon: AdjustmentsHorizontalIcon,\n            iconForeground: 'text-orange-700',\n            iconBackground: 'bg-orange-50',\n            description: 'You can assign settings to your pages via a source file. This way you can have different settings for different pages in one go.',\n        },\n        {\n            id: 'grow-together',\n            title: 'Grow Together With Us',\n            href: 'https://lpagery.io/become-an-affiliate/',\n            icon: ChatBubbleLeftRightIcon,\n            iconForeground: 'text-indigo-700',\n            iconBackground: 'bg-indigo-50',\n            description: 'Join our partner program and earn 20% commission on all payments made through your affiliate link.',\n        },\n        {\n            id: 'share-experience',\n            title: 'Share Your Experience',\n            href: 'https://wordpress.org/support/plugin/lpagery/reviews/?filter=5',\n            icon: StarIcon,\n            iconForeground: 'text-yellow-700',\n            iconBackground: 'bg-yellow-50',\n            description: 'Has LPagery helped improve your workflow? We\\'d love to hear your story and feature it to inspire others.',\n        },\n    ].filter(action => action.id !== 'adjust-settings' || subscription.extended);\n\n    const classNames = (...classes: string[]): string => classes.filter(Boolean).join(' ');\n\n    return (\n        <div className=\"space-y-4\">\n            {(!subscription.free ? proSidebarActions : sidebarActions).map((action) => (\n                <Card key={action.title}\n                    className=\"p-6 relative group rounded-lg shadow-sm focus-within:ring-2 focus-within:ring-inset focus-within:ring-indigo-500\">\n                    <div>\n                        <span\n                            className={classNames(\n                                action.iconBackground,\n                                action.iconForeground,\n                                'inline-flex rounded-lg p-3 ring-4 ring-white'\n                            )}\n                        >\n                            <action.icon className=\"h-6 w-6\" aria-hidden=\"true\" />\n                        </span>\n                    </div>\n                    <div className=\"mt-4\">\n                        <h3 className=\"text-base font-semibold leading-6 text-gray-900\">\n                            <a\n                                href={action.href}\n                                target=\"_blank\"\n                                rel=\"noopener noreferrer\"\n                                onClick={(e) => {\n                                    if (action.onClick) {\n                                        e.preventDefault();\n                                        action.onClick(e);\n                                    }\n                                }}\n                                className=\"focus:outline-none\"\n                            >\n                                <span className=\"absolute inset-0\" aria-hidden=\"true\" />\n                                {action.title}\n                            </a>\n                        </h3>\n                        <p className=\"mt-2 text-sm text-gray-500\">{action.description}</p>\n                    </div>\n                    <span\n                        className=\"pointer-events-none absolute right-6 top-6 text-gray-300 group-hover:text-gray-400\"\n                        aria-hidden=\"true\"\n                    >\n                        <svg className=\"h-6 w-6\" fill=\"currentColor\" viewBox=\"0 0 24 24\">\n                            <path\n                                d=\"M20 4h1a1 1 0 00-1-1v1zm-1 12a1 1 0 102 0h-2zM8 3a1 1 0 000 2V3zM3.293 19.293a1 1 0 101.414 1.414l-1.414-1.414zM19 4v12h2V4h-2zm1-1H8v2h12V3zm-.707.293l-16 16 1.414 1.414 16-16-1.414-1.414z\" />\n                        </svg>\n                    </span>\n                </Card>\n            ))}\n        </div>\n    );\n};\n","import { CheckCircleIcon } from '@heroicons/react/20/solid'\nimport { RocketLaunchIcon } from '@heroicons/react/24/outline'\n\nconst benefits = [\n    'All Page Settings',\n    'Radius Input',\n    'Google Sheet Integration',\n    'Bulk Update Created Pages',\n    'Unlimited Placeholders',\n    'Custom Post Type Support',\n    'Custom Taxonomy Support',\n    'Interlink Pages',\n    'Dynamic Content (Spintax)',\n    'Image Processing',\n]\n\nexport default function BottomProCtaArea() {\n    return (\n        <div id=\"bottom-pro-cta\" className=\"bg-gray-900 py-24 sm:py-32\">\n            <div className=\"relative isolate\">\n                <div className=\"mx-auto max-w-7xl sm:px-6 lg:px-8\">\n                    <div className=\"mx-auto flex max-w-2xl flex-col gap-16 bg-white/5 px-6 py-16 ring-1 ring-white/10 sm:rounded-3xl sm:p-8 lg:mx-0 lg:max-w-none lg:flex-row lg:items-start lg:py-20 xl:gap-x-20 xl:px-20\">\n                        <div className='flex flex-col items-start'>\n                            <img\n                                alt=\"Your Company\"\n                                src=\"https://lpagery.io/wp-content/uploads/2024/07/LP_Logo_horizontal_white_2022_RZ.png\"\n                                className=\"h-16 mb-8 self-start\"\n                            />\n                            <img\n                                alt=\"\"\n                                src=\"https://lindemann-lindemann.de/wp-content/uploads/2024/08/Design-ohne-Titel-13.png\"\n                                className=\"h-96 w-full flex-none rounded-2xl object-cover  lg:aspect-square lg:h-auto lg:max-w-sm\"\n                            />\n                        </div>\n                        <div className=\"w-full flex-auto\">\n                            <h2 className=\"text-3xl font-bold tracking-tight text-white sm:text-4xl\">Get the most out of LPagery</h2>\n                            <p className=\"mt-6 text-lg leading-8 text-gray-300\">\n                                Our pro features will help you get the most out of LPagery.\n                            </p>\n                            <ul\n                                role=\"list\"\n                                className=\"mt-10 grid grid-cols-1 gap-x-8 gap-y-3 text-base leading-7 text-white sm:grid-cols-2\"\n                            >\n                                {benefits.map((benefit) => (\n                                    <li key={benefit} className=\"flex gap-x-3\">\n                                        <CheckCircleIcon aria-hidden=\"true\" className=\"h-7 w-5 flex-none text-[#4C88BA]\" />\n                                        {benefit}\n                                    </li>\n                                ))}\n                            </ul>\n                            <div className=\"mt-10\">\n                                <button\n                                    type=\"button\"\n                                    onClick={(e) => {\n                                        e.preventDefault();\n                                        window.open('https://lpagery.io/pricing?utm_source=free_version&utm_medium=bottom_cta&utm_campaign=free', '_blank');\n                                    }}\n                                    className=\"rounded-md bg-gradient-to-r text-sm from-[#4C88BA] to-[#4C88BA] px-4 py-3 font-semibold text-white shadow-sm hover:opacity-80 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#4C88BA] flex items-center\"\n                                >\n                                    <span>Get All Features with LPagery Pro</span>\n                                    <RocketLaunchIcon className=\"h-5 w-5 ml-2\" aria-hidden=\"true\" />\n                                </button>\n                                <p className=\"text-xs text-gray-400 mt-2\">7-Day Risk-Free Money Back Guarantee</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div\n                    aria-hidden=\"true\"\n                    className=\"absolute inset-x-0 -top-16 -z-10 flex transform-gpu justify-center overflow-hidden blur-3xl\"\n                >\n                    <div\n                        style={{\n                            clipPath:\n                                'polygon(73.6% 51.7%, 91.7% 11.8%, 100% 46.4%, 97.4% 82.2%, 92.5% 84.9%, 75.7% 64%, 55.3% 47.5%, 46.5% 49.4%, 45% 62.9%, 50.3% 87.2%, 21.3% 64.1%, 0.1% 100%, 5.4% 51.1%, 21.4% 63.9%, 58.9% 0.2%, 73.6% 51.7%)',\n                        }}\n                        className=\"aspect-[1318/752] w-[82.375rem] flex-none bg-gradient-to-r from-[#4C88BA] to-[#85C9B3] opacity-25\"\n                    />\n                </div>\n            </div>\n        </div>\n    )\n}","import {Step} from \"@/components/dashboard/update/update\";\n\n\nfunction classNames(...classes: string[]) {\n    return classes.filter(Boolean).join(' ');\n}\n\nconst Progress = ({steps, currentStep}: { steps: Step[]; currentStep: number }) => (\n    <nav aria-label=\"Progress\">\n        <ol role=\"list\" className=\"space-y-4 md:flex md:space-x-8 md:space-y-0 px-6\">\n            {steps.map((step, stepIdx) => {\n                const status = stepIdx < currentStep ? 'complete' :\n                    stepIdx === currentStep ? 'current' : 'upcoming';\n\n                return (\n                    <li key={step.name} className=\"md:flex-1\">\n                        <a\n                            href={step.href}\n                            className={classNames(\n                                'group flex flex-col border-l-4 py-2 pl-4 hover:border-custom-blue-400 md:border-l-0 md:border-t-4 md:pb-0 md:pl-0 md:pt-4',\n                                status === 'complete' ? 'border-custom-blue-400' :\n                                    status === 'current' ? 'border-[#4c88ba]' :\n                                        'border-gray-200 hover:border-gray-300'\n                            )}\n                            aria-current={status === 'current' ? 'step' : undefined}\n                        >\n                            <span\n                                className={classNames(\n                                    'text-sm font-medium',\n                                    status === 'complete' ? 'text-custom-blue-400 group-hover:text-custom-blue-400' :\n                                        status === 'current' ? 'text-[#4c88ba]' :\n                                            'text-gray-500 group-hover:text-gray-700'\n                                )}\n                            >\n                                {\"Step \" + (stepIdx + 1)}\n                            </span>\n                            <span className={classNames(\n                                \"text-sm font-medium\",\n                                status === 'current' ? 'text-[#4c88ba]' : ''\n                            )}>{step.name}</span>\n                        </a>\n                    </li>\n                )\n            })}\n        </ol>\n    </nav>\n\n);\n\nexport default Progress;\n","import React from \"react\"; \n\nconst TextAlignJustifyLeftIcon = (props: React.SVGProps<SVGSVGElement>) => (\n  <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" width={24} height={24} color={\"#003049\"} fill={\"none\"} {...props}>\n    <path d=\"M3 3H10.4118\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n    <path d=\"M3 9H10.4118\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n    <path d=\"M3 15H21\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n    <path d=\"M3 21H21\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n  </svg>\n);\n\nexport default TextAlignJustifyLeftIcon;","import React from \"react\"; \n\nconst Setup01Icon = (props: React.SVGProps<SVGSVGElement>) => (\n  <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" width={24} height={24} color={\"#003049\"} fill={\"none\"} {...props}>\n    <path d=\"M19 2V4.85857C17.1962 3.09032 14.7255 2 12 2C6.47715 2 2 6.47715 2 12C2 13.4222 2.29689 14.7751 2.83209 16M5 22V19.1414C6.80375 20.9097 9.27455 22 12 22C17.5228 22 22 17.5228 22 12C22 10.5778 21.7031 9.22492 21.1679 8\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n    <path d=\"M10.5721 6.68377L10.2 7.8L9.2641 8.39194L8.02099 8.08435C7.59312 7.97848 7.1464 8.16524 6.92119 8.54413L6.42396 9.38065C6.17813 9.79425 6.26167 10.3243 6.62281 10.6422L7.44777 11.3684V12.6316L6.62308 13.3578C6.26202 13.6757 6.17853 14.2057 6.42434 14.6192L6.92163 15.4559C7.14683 15.8347 7.59356 16.0215 8.02142 15.9156L9.26453 15.6081L10.1511 16.1053L10.4908 17.2781C10.6146 17.7057 11.0061 18 11.4513 18H12.5491C12.9943 18 13.3859 17.7057 13.5097 17.2781L13.8493 16.1053L14.7355 15.6081L15.9786 15.9156C16.4064 16.0215 16.8532 15.8347 17.0784 15.4559L17.6014 14.5759C17.8355 14.1821 17.772 13.6795 17.4474 13.3563L16.5845 12.4972L16.585 11.5028L17.4478 10.6437C17.7725 10.3205 17.836 9.81793 17.6019 9.42411L17.0788 8.54413C16.8536 8.16524 16.4069 7.97848 15.979 8.08435L14.7359 8.39194L13.8 7.8L13.4279 6.68377C13.2918 6.27543 12.9097 6 12.4792 6H11.5208C11.0903 6 10.7082 6.27543 10.5721 6.68377Z\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n    <circle cx=\"12\" cy=\"12\" r=\"1.5\" stroke=\"currentColor\" strokeWidth=\"1.5\" />\n  </svg>\n);\n\nexport default Setup01Icon;","import {createContext, useContext} from 'react';\n\ninterface FormStepContextType {\n    attemptedNext: boolean;\n    setAttemptedNext: (attempted: boolean) => void;\n}\n\nexport const FormStepContext = createContext<FormStepContextType | undefined>(undefined);\n\nexport const useFormStepContext = () => {\n    const context = useContext(FormStepContext);\n    if (!context) {\n        throw new Error('useFormStepContext must be used within a FormStepProvider');\n    }\n    return context;\n};\n\n\n","import React from \"react\";\nimport {CheckCircleIcon, EyeIcon} from \"@heroicons/react/24/outline\";\nimport TextAlignJustifyLeftIcon from \"@/Icons/text-align-justify-left-stroke-standard\";\nimport Setup01Icon from \"@/Icons/setup-01-stroke-standard\";\nimport {TypeStepType, UpdateType} from \"@/model/dashboard/dashboard-form-model\";\nimport {Controller, useFormContext} from \"react-hook-form\";\nimport {useFormStepContext} from \"@/components/dashboard/update/FormStepContext\";\n\ninterface CardSetting {\n    id: UpdateType;\n    title: string;\n    description: string;\n    icon: React.ReactNode;\n}\n\nconst cardSettings  : CardSetting[] = [\n    {\n        id: 'look',\n        title: 'Update Look & Static Content',\n        description: 'Apply template page changes to all pages created with this template.',\n        icon: <EyeIcon className=\"h-5 w-5 text-[#4C88BA]\" aria-hidden=\"true\"/>,\n    },\n    {\n        id: 'settings',\n        title: 'Update Settings',\n        description: 'Adjust settings like parents, tags and categories of the created pages.',\n        icon: <Setup01Icon className=\"h-5 w-5 text-[#4C88BA]\" aria-hidden=\"true\"/>,\n    },\n    {\n        id: 'content',\n        title: 'Update Content',\n        description: 'Update existing pages with new content or create additional pages using updated content from your data source of choice.',\n        icon: <TextAlignJustifyLeftIcon className=\"h-5 w-5 text-[#4C88BA]\" aria-hidden=\"true\"/>,\n    },\n]\n\n\nexport function SelectUpdateType() {\n    const {control, formState: {errors}} = useFormContext<TypeStepType>()\n    const {attemptedNext} = useFormStepContext();\n    \n    return (\n        <Controller\n            name={'updateType'}\n            control={control}\n            render={({field}) => {\n                const handleInputTypeChange = (option: CardSetting) => {\n                    const currentValue = field.value || [];\n                    const newValue = currentValue.includes(option.id)\n                        ? currentValue.filter(id => id !== option.id)\n                        : [...currentValue, option.id];\n                    field.onChange(newValue);\n                }\n\n                const selectedInputTypes = (field.value || [])\n                    .map((id: UpdateType) => cardSettings.find(setting => setting.id === id))\n                    .filter(Boolean) as CardSetting[];\n\n                return <div className=\"space-y-2\">\n                    <div>\n                        <fieldset>\n                            <div className=\"mt-6 grid grid-cols-1 gap-y-6 sm:grid-cols-3 sm:gap-x-4\">\n                                {cardSettings.map((option) => (\n                                    <div\n                                        key={option.id}\n                                        className={`relative flex rounded-lg border ${selectedInputTypes.find(item => item.id === option.id)\n                                            ? 'border-[#4c88ba] shadow-lg'\n                                            : 'border-gray-300'} bg-white p-4 shadow-sm focus:outline-none cursor-pointer`}\n                                        onClick={() => handleInputTypeChange(option)}\n                                    >\n                                        <div className=\"relative pl-8 w-full flex flex-col justify-between h-full\">\n                                            <div>\n                                                <div className=\"flex justify-between items-start\">\n                                                    <dt className=\"font-semibold leading-6 text-gray-900\">\n                                                        <div\n                                                            className=\"absolute left-0 top-0 flex h-6 w-6 items-center justify-center\">\n                                                            {option.icon}\n                                                        </div>\n                                                        {option.title}\n                                                    </dt>\n                                                    <CheckCircleIcon\n                                                        className={`h-6 w-6 text-[#4C88BA] ${selectedInputTypes.find(item => item.id === option.id) ? 'visible' : 'invisible'}`}\n                                                        aria-hidden=\"true\"/>\n                                                </div>\n                                                <dd className=\"text-xs leading-5 text-gray-500 mt-1\">\n                                                    {option.description}\n                                                </dd>\n                                            </div>\n                                        </div>\n                                    </div>\n                                ))}\n                            </div>\n                        </fieldset>\n                        {errors.updateType && attemptedNext && (\n                            <p className=\"mt-2 text-sm text-red-600\" id=\"updateType-error\">\n                                {errors.updateType.message}\n                            </p>\n                        )}                    </div>\n                </div>;\n            }}\n        />\n    )\n}","import React, {useEffect, useState} from \"react\";\nimport {\n    AdjustmentsHorizontalIcon,\n    CalendarIcon,\n    DocumentDuplicateIcon,\n    EyeIcon,\n    FolderOpenIcon,\n    LinkIcon,\n    PencilIcon,\n    TagIcon,\n} from \"@heroicons/react/24/outline\";\nimport {useFormContext} from \"react-hook-form\";\nimport {DashboardSettingsType, DashboardUpdateType} from \"@/model/dashboard/dashboard-form-model\";\nimport usePost from \"@/hooks/dashboard/query/use-post\";\nimport useTaxonomyTerms, {FetchTaxonomyTermsResponseItem} from \"@/hooks/dashboard/query/use-taxonomy-terms\";\nimport useTaxonomies from \"@/hooks/dashboard/query/use-taxonomies\";\nimport {PagesToBeUpdated} from \"@/hooks/dashboard/update/use-pages-to-be-updated-for-update-modal\";\n\nconst CHANGE_ICONS = {\n    look: EyeIcon,\n    content: PencilIcon,\n    template: DocumentDuplicateIcon,\n    parent: FolderOpenIcon,\n    slug: LinkIcon,\n    taxonomy: TagIcon,\n    status: AdjustmentsHorizontalIcon,\n    date: CalendarIcon,\n} as const;\n\ntype ChangeType = keyof typeof CHANGE_ICONS;\n\ninterface ChangeItem {\n    id: string;\n    icon: React.ComponentType<React.SVGProps<SVGSVGElement>>;\n    title: string;\n    text: string;\n    oldValue?: string;\n    newValue?: string;\n}\n\ninterface Props {\n    previousConfig?: DashboardSettingsType;\n    existingPages?: PagesToBeUpdated\n}\n\n// Utility functions\nconst createChange = (\n    type: ChangeType,\n    id: string,\n    title: string,\n    text: string\n): ChangeItem => ({\n    id,\n    icon: CHANGE_ICONS[type],\n    title,\n    text,\n});\n\nexport const useUpdateChanges = ({existingPages, previousConfig}: Props) => {\n    const [items, setItems] = useState<ChangeItem[]>([]);\n    const {watch} = useFormContext<DashboardUpdateType>();\n    const configWatch = watch('config');\n    const updateTypeWatch = watch('updateType');\n\n    const [loading, setLoading] = useState(true);\n\n    // Get combined set of taxonomy types\n    const allTaxonomyTypes = React.useMemo(() => new Set<string>([\n        ...(previousConfig?.taxonomy_terms ? Object.keys(previousConfig.taxonomy_terms) : []),\n        ...(configWatch?.taxonomy_terms ? Object.keys(configWatch.taxonomy_terms) : []),\n    ]), [previousConfig?.taxonomy_terms, configWatch?.taxonomy_terms]);\n\n\n    const allTaxonomyTerms = useTaxonomyTerms();\n    const taxonomiesResponse = useTaxonomies()\n\n    const previousParentResponse = usePost(previousConfig?.parent);\n    const newParentResponse = usePost(configWatch?.parent);\n\n    const previousTemplateResponse = usePost(previousConfig?.template);\n    const newTemplateResponse = usePost(configWatch?.template);\n\n    \n\n    const detectUpdateTypeChanges = (updateType: string[] | undefined): ChangeItem[] => {\n        const changes: ChangeItem[] = [];\n        \n        if (updateType?.includes('look')) {\n            changes.push(createChange(\n                'look',\n                'look',\n                'Look & Static Content Update',\n                'The look and static content of the created pages will be updated according to the template page.'\n            ));\n        }\n\n        if (updateType?.includes('content')) {\n            changes.push(createChange(\n                'content',\n                'content',\n                'Content Update',\n                'New input will be applied, new pages will be created and existing pages will be updated.'\n            ));\n        }\n\n        return changes;\n    };\n\n    // Memoize the taxonomy changes detection\n    const detectTaxonomyChanges = React.useCallback((\n        prevConfig: DashboardSettingsType,\n        currConfig: DashboardSettingsType,\n        taxonomyName: string\n    ): ChangeItem | null => {\n        const prevTerms = prevConfig.taxonomy_terms?.[taxonomyName] || [];\n        const currTerms = currConfig.taxonomy_terms?.[taxonomyName] || [];\n        \n        if (JSON.stringify(prevTerms) === JSON.stringify(currTerms)) {\n            return null;\n        }\n\n        const data = allTaxonomyTerms.data;\n        let terms: FetchTaxonomyTermsResponseItem[] = []\n        if (data) {\n            terms = data[taxonomyName] || [];\n        }\n\n        const termMap = new Map<number, string>();\n        for (const term of terms) {\n            termMap.set(term.id, term.name);\n        }\n\n\n        const addedTerms = currTerms.filter(id => !prevTerms.includes(id));\n        const removedTerms = prevTerms.filter(id => !currTerms.includes(id));\n\n        const addedTermNames = addedTerms.map(id => termMap.get(id) || `ID ${id}`);\n        const removedTermNames = removedTerms.map(id => termMap.get(id) || `ID ${id}`);\n\n        const taxonomy = taxonomiesResponse.data?.find(tax => tax.name === taxonomyName);\n\n\n        const taxonomyLabel = taxonomy?.label || taxonomyName;\n        let changeText = '';\n        if (addedTermNames.length > 0) {\n            changeText += `Added ${taxonomyLabel}: ${addedTermNames.join(', ')}. `;\n        }\n        if (removedTermNames.length > 0) {\n            changeText += `Removed ${taxonomyLabel}: ${removedTermNames.join(', ')}.`;\n        }\n        if (changeText === '') {\n            changeText = `${taxonomyLabel} have been updated.`;\n        }\n\n        return {\n            id: taxonomyName,\n            icon: TagIcon,\n            title: `${taxonomyLabel.charAt(0).toUpperCase() + taxonomyLabel.slice(1)} Changed`,\n            text: changeText,\n        };\n    }, [allTaxonomyTerms.data, taxonomiesResponse.data]);\n\n    // Split the effect into two parts - one for loading state and one for data updates\n    useEffect(() => {\n        const isLoading = [\n            previousParentResponse.isLoading,\n            newParentResponse.isLoading,\n            previousTemplateResponse.isLoading,\n            newTemplateResponse.isLoading,\n            taxonomiesResponse.isLoading,\n            allTaxonomyTerms.isLoading\n        ].some(Boolean);\n        \n        setLoading(isLoading);\n    }, [\n        previousParentResponse.isLoading,\n        newParentResponse.isLoading,\n        previousTemplateResponse.isLoading,\n        newTemplateResponse.isLoading,\n        taxonomiesResponse.isLoading,\n        allTaxonomyTerms.isLoading\n    ]);\n\n    useEffect(() => {\n        if (loading) return;\n\n        // Early return if updateTypeWatch only contains 'look'\n        if (updateTypeWatch?.length === 1 && updateTypeWatch[0] === 'look') {\n            setItems(detectUpdateTypeChanges(updateTypeWatch));\n            return;\n        }\n\n        const newItems: ChangeItem[] = [\n            ...detectUpdateTypeChanges(updateTypeWatch),\n        ];\n\n        if (previousConfig && configWatch) {\n            // Template change\n            if (previousConfig.template !== configWatch.template) {\n                newItems.push(createChange(\n                    'template',\n                    'template',\n                    'Template Changed',\n                    `Template has changed from \"${previousTemplateResponse.data?.title || previousConfig.template || 'N/A'}\" to \"${newTemplateResponse.data?.title || configWatch.template || 'N/A'}\".`\n                ));\n            }\n\n            // Parent change\n            if (previousConfig.parent !== configWatch.parent) {\n                newItems.push(createChange(\n                    'parent',\n                    'parent',\n                    'Parent Changed',\n                    `Parent has changed from \"${previousParentResponse.data?.title || previousConfig.parent || 'No Parent'}\" to \"${newParentResponse.data?.title || configWatch.parent || 'No Parent'}\".`\n                ));\n            }\n\n            // Slug change\n            if (previousConfig.slug !== configWatch.slug) {\n                newItems.push(createChange(\n                    'slug',\n                    'slug',\n                    'Slug Changed',\n                    `Slug has changed from \"${previousConfig.slug}\" to \"${configWatch.slug}\".`\n                ));\n            }\n\n            // Status change\n            if (previousConfig.status !== configWatch.status) {\n                newItems.push(createChange(\n                    'status',\n                    'status',\n                    'Status Changed',\n                    `Status will be changed to \"${configWatch.status}\".`\n                ));\n            }\n\n            // Date change\n            const prevDate = previousConfig.date ? new Date(previousConfig.date).getTime() : null;\n            const currDate = configWatch.date ? new Date(configWatch.date).getTime() : null;\n            if (prevDate !== currDate) {\n                newItems.push(createChange(\n                    'date',\n                    'date',\n                    'Date Changed',\n                    `Publish Date has changed from \"${previousConfig.date?.toLocaleDateString() || '-'}\" to \"${configWatch.date?.toLocaleDateString() || '-'}\".`\n                ));\n            }\n\n            // Dynamic taxonomy changes\n            allTaxonomyTypes.forEach(taxonomy_name => {\n                const change = detectTaxonomyChanges(previousConfig, configWatch, taxonomy_name);\n                if (change) {\n                    newItems.push(change);\n                }\n            });\n        }\n\n        setItems(newItems);\n    }, [\n        loading,\n        configWatch,\n        previousConfig,\n        previousParentResponse.data,\n        newParentResponse.data,\n        previousTemplateResponse.data,\n        newTemplateResponse.data,\n        updateTypeWatch,\n        allTaxonomyTypes,\n        detectTaxonomyChanges\n    ]);\n\n    return {items, loading};\n};\n","import {DashboardSettingsType} from \"@/model/dashboard/dashboard-form-model\";\nimport {Loader} from \"@/components/common/Loader\";\nimport {useUpdateChanges} from \"@/hooks/dashboard/update/use-update-changes\";\nimport {NoSymbolIcon} from \"@heroicons/react/24/solid\";\nimport {\n    PagesToBeUpdated,\n    usePagesToBeUpdatedForUpdateModal\n} from \"@/hooks/dashboard/update/use-pages-to-be-updated-for-update-modal\";\nimport {useFormContext} from \"react-hook-form\";\n\ninterface Props {\n    previousConfig?: DashboardSettingsType;\n\n}\n\n\nfunction ConfirmUpdate({previousConfig }: Props) {\n    const {getValues} = useFormContext()\n\n    const formData = getValues();\n    const {data: existingPages, isLoading: existingPagesLoading} = usePagesToBeUpdatedForUpdateModal(\n        formData?.updateSelection?.template, \n        formData?.updateSelection?.process\n    );\n\n    const {items, loading} = useUpdateChanges({previousConfig, existingPages});\n\n    if (loading || existingPagesLoading) {\n        return (\n            <div className=\"flex flex-col items-center justify-center p-8 space-y-4\">\n                <Loader  />\n                <p className=\"text-gray-600 text-center\">\n                    Analyzing changes and preparing update summary...\n                </p>\n            </div>\n        );\n    }\n\n    return (\n        <div className=\"space-y-8\">\n            <div className=\"overflow-hidden rounded-md bg-white border\">\n                {items.length === 0 && (\n                    <div className=\"px-6 py-4 flex items-center space-x-2\">\n                        <div className=\"sm:flex\">\n                            <div className=\"mb-4 flex-shrink-0 sm:mb-0 sm:mr-4\">\n                                <NoSymbolIcon className=\"h-8 w-8 text-gray-600\" aria-hidden=\"true\"/>\n                            </div>\n                            <div>\n                                <p className=\"text-sm leading-6 text-gray-600\">No changes will be applied</p>\n                            </div>\n                        </div>\n                    </div>\n                )}\n                <ul role=\"list\" className=\"divide-y divide-gray-200\">\n                    {items.map((item) => (\n                        <li key={item.id} className=\"px-6 py-4 flex items-center space-x-2\">\n                            <div className=\"sm:flex\">\n                                <div className=\"mb-4 flex-shrink-0 sm:mb-0 sm:mr-4\">\n                                    <item.icon className=\"h-8 w-8 text-gray-600\" aria-hidden=\"true\"/>\n                                </div>\n                                <div>\n                                    <h4 className=\"text-lg font-bold\">{item.title}</h4>\n                                    <p className=\"text-sm leading-6 text-gray-600\">{item.text}</p>\n                                </div>\n                            </div>\n                        </li>\n                    ))}\n                </ul>\n            </div>\n        </div>\n    );\n}\n\nexport default ConfirmUpdate;\n","import {Check, ChevronDown} from \"lucide-react\";\nimport {cn} from \"@/lib/utils\";\nimport {Button} from \"@/components/ui/button\";\nimport {Command, CommandEmpty, CommandGroup, CommandInput, CommandItem, CommandList,} from \"@/components/ui/command\";\nimport {Popover, PopoverContent, PopoverTrigger,} from \"@/components/ui/popover\";\nimport {useContext, useEffect, useState} from \"react\";\nimport {Controller, useFormContext} from \"react-hook-form\";\nimport {ProcessListItem, useSearchProcesses} from \"@/hooks/manage/use-search-processes\";\nimport {ManageUpdateContext} from \"@/context/manage-update-context\";\n\n\ninterface PageSelectProps {\n    name: string;\n    templateId: number;\n}\n\nexport function ProcessSelect({ name, templateId }: PageSelectProps) {\n    const { control, setValue } = useFormContext();\n    const [open, setOpen] = useState(false);\n    const [searchValue, setSearchValue] = useState(\"\");\n    const [processes, setProccesses] = useState<ProcessListItem[]>([]);\n    \n    const processesResponse = useSearchProcesses([\n        { id: \"template\", value: templateId }, \n        { id: \"purpose\", value: searchValue }\n    ], false);\n    \n    const { processId: processIdFromContext, templateId: templateIdFromContext } = useContext(ManageUpdateContext);\n\n    useEffect(() => {\n        if (processesResponse.data) {\n            if (processesResponse.data.length === 1) {\n                if (!(templateIdFromContext && !processIdFromContext)) {\n                    const fieldValue = processesResponse.data[0].id;\n                    setValue(name, fieldValue);\n                }\n            }\n            const processesData = processesResponse.data;\n            processesData.unshift({\n                id: 0,\n                purpose_with_name: 'All Pages',\n            } as ProcessListItem);\n            setProccesses(processesData);\n        }\n    }, [processesResponse.data, control, name, templateIdFromContext, processIdFromContext]);\n\n    return (\n        <Controller\n            name={name}\n            control={control}\n            render={({ field }) => {\n                const selectedProcess = processes.find(\n                    (process: ProcessListItem) => process.id === field.value\n                );\n\n                return (\n                    <Popover open={open} onOpenChange={setOpen}>\n                        <PopoverTrigger asChild>\n                            <Button\n                                variant=\"outline\"\n                                role=\"combobox\"\n                                aria-expanded={open}\n                                className=\"flex h-10 w-full items-center justify-between rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 [&>span]:line-clamp-1\"\n                            >\n                                <span\n                                    className={`${selectedProcess ? \"\" : \"text-muted-foreground\"} truncate`}>\n                                    {selectedProcess ? selectedProcess.purpose_with_name : \"All Pages\"}\n                                </span>\n                                <ChevronDown className=\"ml-auto h-4 w-4 shrink-0 opacity-50\" />\n                            </Button>\n                        </PopoverTrigger>\n                        <PopoverContent className=\"w-[600px] p-0\">\n                            <Command>\n                                <CommandInput\n                                    placeholder=\"Search Created Page Set...\"\n                                    onInput={(event) => {\n                                        setSearchValue(event.currentTarget.value);\n                                    }}\n                                />\n                                <CommandList>\n                                    <CommandEmpty>No pages found.</CommandEmpty>\n                                    <CommandGroup>\n\n                                        {processes.map((process: ProcessListItem) => (\n                                            <CommandItem\n                                                key={process.id}\n                                                value={(process.purpose_with_name) + process.id}\n                                                onSelect={() => {\n                                                    field.onChange(process.id);\n                                                    setOpen(false);\n                                                }}\n                                            >\n                                                <Check\n                                                    className={cn(\n                                                        \"mr-2 h-4 w-4\",\n                                                        field.value === process.id ? \"opacity-100\" : \"opacity-0\"\n                                                    )}\n                                                />\n                                                {process.purpose_with_name}\n                                            </CommandItem>\n                                        ))}\n                                    </CommandGroup>\n                                </CommandList>\n                            </Command>\n                        </PopoverContent>\n                    </Popover>\n                );\n            }}\n        />\n    );\n}\n","import {PageSelect} from \"@/components/dashboard/save/components/PageSelect\";\nimport {ProcessSelect} from \"@/components/dashboard/save/components/ProcessSelect\";\nimport {useFormContext} from \"react-hook-form\";\nimport {FormFieldWrapper} from \"@/components/common/FormFieldWrapper\";\nimport {SelectionStepType} from \"@/model/dashboard/dashboard-form-model\";\nimport {ExclamationTriangleIcon} from \"@heroicons/react/20/solid\";\nimport {useSubscription} from \"@/hooks/subscription/use-subscription\";\n\nfunction TemplatePage() {\n    const { watch, formState: { errors } } = useFormContext<SelectionStepType>();\n    const templateWatch = watch('updateSelection.template');\n    const processWatch = watch('updateSelection.process');\n\n    const { extended } = useSubscription();\n    return (\n        <div className=\"relative space-y-8\">\n            <div className='space-y-8'>\n                <div className=\"sm:col-span-6 space-y-2\">\n                    <div className=\"w-full\">\n                        <FormFieldWrapper label={'1. Select Template Page'} license={'extended'}\n                            error={errors.updateSelection?.template?.message}>\n                            <PageSelect\n                                name={'updateSelection.template'}\n                                type={'template'}\n                                mode={'update'}\n                            />\n                        </FormFieldWrapper>\n                    </div>\n                    <p className=\"text-xs leading-6 text-gray-500\">\n                        Select the template page for the pages you want to update.\n                    </p>\n                </div>\n\n                <div className=\"sm:col-span-6 space-y-2\">\n                    <div className=\"w-full\">\n                        <FormFieldWrapper label={'2. Select Page Set'} license={'extended'}\n                            error={errors.updateSelection?.process?.message}>\n                            <ProcessSelect name={'updateSelection.process'} templateId={templateWatch} />\n\n                        </FormFieldWrapper>\n                    </div>\n                    <p className=\"text-xs leading-6 text-gray-500\">\n                        Select the page creation set you want to update.\n                    </p>\n\n                    {templateWatch && (processWatch === 0 || !processWatch) && extended && (\n                        <div className=\"rounded-md bg-yellow-50 p-4 mt-4\">\n                            <div className=\"flex\">\n                                <div className=\"shrink-0\">\n                                    <ExclamationTriangleIcon className=\"size-5 text-yellow-400\" aria-hidden=\"true\" />\n                                </div>\n                                <div className=\"ml-3\">\n                                    <h3 className=\"text-sm font-medium text-yellow-800\">Attention needed</h3>\n                                    <div className=\"mt-2 text-sm text-yellow-700\">\n                                        <p>\n                                            If \"All Pages\" is selected, it's only possible to update the page look and static content of the created pages.\n                                        </p>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    )}\n                </div>\n            </div>\n        </div>\n    );\n}\n\nexport default TemplatePage;\n","import {UploadFileArea} from \"@/components/dashboard/save/upload/UploadFileArea\";\n\nfunction ContentDetails() {\n    return (\n        <UploadFileArea ></UploadFileArea>\n    );\n}\n\nexport default ContentDetails;\n","import {PostSettingsForm} from \"@/components/dashboard/save/PostSettingsForm\";\n\nexport const ChangeSettings = () => {\n    return (\n        <PostSettingsForm mode={\"update\"} submittedCallback={() => {}}></PostSettingsForm>\n    )\n}","import useWordpressAjax from \"@/hooks/fetch/use-wordpress-ajax-fetch\";\nimport {z} from \"zod\";\nimport {NumberParser, StringOrNumberParser} from \"@/lib/zod-utils\";\nimport {useQuery, UseQueryResult} from \"@tanstack/react-query\";\n\nconst userSchema = z.object({\n    name: z.string().nullish(),\n    email: z.string().email().nullish(),\n});\n\nconst googleSheetDataSchema = z.object({\n    add: z.boolean(),\n    url : z.string().url().optional(),\n    update: z.boolean(),\n    delete: z.boolean(),\n}).nullable();\n\nconst processSchema = z.object({\n    id: NumberParser,\n    post_id: NumberParser,\n    user: userSchema,\n    post_count: NumberParser,\n    display_purpose: StringOrNumberParser,\n    raw_purpose: StringOrNumberParser,\n    google_sheet_sync_error: z.nullable(z.string()),\n    next_google_sheet_sync: NumberParser.optional().nullable(),\n    last_google_sheet_sync: NumberParser.optional().nullable(),\n    google_sheet_sync_status: z.string(),\n    queue_count: z.string(),\n    processed_queue_count: z.string(),\n    google_sheet_sync_enabled: z.boolean(),\n    include_parent_as_identifier: z.boolean(),\n    created: z.string(), // Use z.string() if you expect a date string\n});\n\nconst configDataSchema = z.object({\n    taxonomy_terms: z.record(z.array(NumberParser).optional()).optional(),\n    status: z.string(),\n    parent_path: NumberParser,\n    slug: z.string(),\n});\n\nconst ProcessDetailsSchema = z.object({\n    process: processSchema,\n    data: z.array(z.unknown()), // Adjust as necessary based on expected structure\n    config_data: configDataSchema,\n    google_sheet_data: googleSheetDataSchema.nullable().optional(),\n});\ntype Response = z.infer<typeof ProcessDetailsSchema>;\nexport const useProcessConfig = (process_id?: number): UseQueryResult<Response | void> => {\n\n    const fetcher = useWordpressAjax<Response, { id?: number }>(\"lpagery_get_process_details\", ProcessDetailsSchema, \"Fetch Config failed\");\n\n    return useQuery({\n        queryKey: [`process`, 'details', process_id],\n        enabled: !!process_id,\n        queryFn: () => fetcher({body: {id: process_id}})\n    })\n\n}","// use-combine-input-and-existing-pages.ts\n\nimport {\n    ExtractResult,\n    ExtractResultDataEntry,\n    ExtractResultDataEntrySchema,\n    ExtractResultSchema,\n    Header,\n    HeaderSchema,\n} from \"@/hooks/generation/extract/use-extract-data\";\nimport {useCallback} from \"react\";\nimport {PagesToBeUpdated, PageToBeUpdated,} from \"@/hooks/dashboard/update/use-pages-to-be-updated-for-update-modal\";\nimport {DashboardSettingsType, DashboardUpdateType} from \"@/model/dashboard/dashboard-form-model\";\nimport {getConfigData,} from \"@/hooks/generation/get-config-data\";\n\n\nexport const useCombineInputAndExistingPages = (formData: DashboardUpdateType, includeParentAsIdentifier?: boolean, existingPages?: PagesToBeUpdated): {\n    combineInputAndExistingData: (\n        newExtractData: ExtractResult,\n        previousSettings?: DashboardSettingsType\n    ) => Promise<ExtractResult>;\n} => {\n\n    const combineInputAndExistingData = useCallback(\n        async (\n            newExtractData: ExtractResult,\n            previousSettings?: DashboardSettingsType\n        ): Promise<ExtractResult> => {\n            const createKey = (slug: string, parent_search_term_param: string) => {\n                const parent_search_term = parent_search_term_param || \"0\";\n                if(includeParentAsIdentifier) {\n                    return `${slug}|||${parent_search_term}`;\n                }\n                return slug;\n            }\n\n            if (!existingPages) {\n                return newExtractData\n            }\n            const updateTypes = formData.updateType\n\n            \n\n            const existingPagesMap = new Map<string, PageToBeUpdated>();\n            existingPages?.forEach((page) => {\n                const key = createKey(page.slug, page.parent_search_term || \"\");\n                existingPagesMap.set(key, page);\n            });\n\n\n            const newExtractDataMap = new Map<string, ExtractResultDataEntry>();\n            newExtractData.data?.forEach((entry) => {\n                if (entry.slug) {\n                    const key = createKey(entry.slug, entry.config_data?.parent || \"\");\n                    newExtractDataMap.set(key, entry);\n                }\n            });\n\n\n\n            // Collect all unique keys (slug_parent combinations)\n            const allKeys = new Set<string>([\n                ...existingPagesMap.keys(),\n                ...newExtractDataMap.keys(),\n            ]);\n\n            const combinedDataEntries: ExtractResultDataEntry[] = [];\n\n            let rowIdCounter = 1; // Initialize row_id counter\n\n            let manuallyUpdatedCount = 0;\n\n\n            // Combine data based on the slug_parent key\n            allKeys.forEach((key) => {\n                const isNewPage = newExtractDataMap.has(key) && !existingPagesMap.has(key);\n                const isExistingPageWithNewData = newExtractDataMap.has(key) && existingPagesMap.has(key);\n                const isExistingPageWithoutNewData = !newExtractDataMap.has(key) && existingPagesMap.has(key);\n\n                if (isNewPage) {\n                    // First: Use the new data's placeholder_data if only in newExtractDataMap\n                    const entry = newExtractDataMap.get(key)!;\n                    entry.row_id = rowIdCounter++;\n                    combinedDataEntries.push(ExtractResultDataEntrySchema.parse(entry));\n                } else {\n                    const pageToBeUpdated = existingPagesMap.get(key)!;\n                    if (pageToBeUpdated?.page_manually_updated_at && (isExistingPageWithNewData || updateTypes.includes('look'))) {\n                        manuallyUpdatedCount++;\n                    }\n                    if (isExistingPageWithNewData) {\n                        // Second: Combine new data's placeholder_data with existing page's id\n                        const entry = newExtractDataMap.get(key)!;\n                        // const previousConfig = getPreviousConfig(pageToBeUpdated);\n                        // addToChangedHeaders(changedHeadersKeys, previousConfig, entry.config_data)\n\n\n                        entry.page_to_be_updated = pageToBeUpdated\n                        entry.row_id = rowIdCounter++;\n\n                        combinedDataEntries.push(ExtractResultDataEntrySchema.parse(entry));\n                    } else {\n                        if (isExistingPageWithoutNewData && (updateTypes.includes('settings') || updateTypes.includes('look'))) {\n                            // Third: Create an entry with page_id_to_be_updated if only in existingPagesMap\n\n                            // let previousConfig = getPreviousConfig(pageToBeUpdated);\n                            const newConfigData = formData.config ? getConfigData(formData.config) : undefined;\n\n                            // addToChangedHeaders(changedHeadersKeys, previousConfig, newConfigData)\n\n                            combinedDataEntries.push(ExtractResultDataEntrySchema.parse({\n                                page_to_be_updated: pageToBeUpdated,\n                                slug: key.split('|||')[0],\n                                placeholder_data: {},\n                                row_id: rowIdCounter++,\n                                config_data: {\n                                    ...(formData.config ? getConfigData(formData.config) : {}),\n                                    parent: pageToBeUpdated.parent_search_term || \"\"\n                                },\n                            }));\n                        }\n                    }\n\n                }\n            });\n\n\n            // const configHeaders = generateHeadersForDiffValues(changedHeadersKeys)\n\n\n            // Ensure the result conforms to the ExtractResultSchema\n            const pageToBeUpdatedHeader = generatePageToBeUpdatedHeader();\n            const modifiedHeader = generateModifiedHeader();\n\n            // sort by modified true first\n\n            // combinedDataEntries.sort((a, b) => {\n            //     if (!a.page_to_be_updated && b.page_to_be_updated) return -1;\n            //     if (a.page_to_be_updated && !b.page_to_be_updated) return 1;\n            //     return (b.page_to_be_updated?.page_manually_updated_at?.getTime() || 0) - (a.page_to_be_updated?.page_manually_updated_at?.getTime() || 0);\n            // });\n\n            return ExtractResultSchema.parse({\n                headers: [\n                    pageToBeUpdatedHeader,\n                    ...(manuallyUpdatedCount > 0 && (formData.updateType.includes('look') || formData.updateType.includes('content')) ? [modifiedHeader] : []),\n                    ...newExtractData.headers\n                ],\n                data: combinedDataEntries,\n                manuallyUpdated: manuallyUpdatedCount\n            } as ExtractResult);\n        },\n        [existingPages, formData]\n    );\n\n    return {combineInputAndExistingData};\n};\n\n\n// @ts-ignore\nconst generateHeadersForDiffValues = (changedHeaderKeys: string[]): Header[] => {\n\n    return Array.from(new Set(changedHeaderKeys)).map((key) => {\n        return HeaderSchema.parse({\n            name: key,\n            type: 'config_changed',\n            licenseNeeded: false,\n            label: key.charAt(0).toUpperCase() + key.slice(1) + ' Changed',\n        });\n    })\n}\n\nconst generatePageToBeUpdatedHeader = (): Header => {\n    return HeaderSchema.parse({\n        name: 'page_to_be_updated',\n        type: 'page_to_be_updated',\n        label: 'Page to be Updated',\n        licenseNeeded: false\n    });\n\n}\n\nconst generateModifiedHeader = (): Header => {\n    return HeaderSchema.parse({\n        name: 'modified',\n        type: 'modified',\n        label: 'Manual Changes',\n        licenseNeeded: false\n    });\n\n}\n\n// const addToChangedHeaders = (changedHeaders: string[], oldConfig: ExtractResultConfigData, newConfig?: ExtractResultConfigData) => {\n//\n//     if (!oldConfig || !newConfig) return;\n//\n//     if (oldConfig.template !== newConfig.template) {\n//         changedHeaders.push('template')\n//     }\n//     if (oldConfig.parent !== newConfig.parent && !(oldConfig.parent === \"\" && newConfig.parent === \"0\") && !(oldConfig.parent === \"0\" && newConfig.parent === \"\")) {\n//         changedHeaders.push('parent')\n//     }\n//     // if (oldConfig.slug !== newConfig.slug) {\n//     //     changedHeaders.push('slug')\n//     // }\n//     // if (!arraysEqual(oldConfig.categories || [], newConfig.categories || [])) {\n//     //     changedHeaders.push('categories')\n//     // }\n//     // if (!arraysEqual(oldConfig.tags || [], newConfig.tags ||[])) {\n//     //     changedHeaders.push('tags')\n//     // }\n//     if (oldConfig.status !== newConfig.status && newConfig.status !== \"-1\") {\n//         changedHeaders.push('status')\n//     }\n//     if (oldConfig.date !== newConfig.date) {\n//         changedHeaders.push('date')\n//     }\n// }\n\n// const getPreviousConfig = (oldPage: PageToBeUpdated): ExtractResultConfigData => {\n//     const taxonomy_terms = oldPage.taxonomies.reduce((acc, taxonomy) => {\n//         acc[taxonomy.name] = taxonomy.terms.map(term => term.toString());\n//         return acc;\n//     }, {} as Record<string, string[]>);\n//     return {\n//         template: oldPage.template.toString(),\n//         parent: oldPage.parent.toString(),\n//         slug: oldPage.slug,\n//         taxonomy_terms: taxonomy_terms,\n//         status: oldPage.status,\n//         date: ''\n//     }\n// }","import {Card} from \"@/components/ui/card\";\n\nimport Setup01Icon from \"@/Icons/setup-01-stroke-standard\";\n\nimport TextAlignJustifyLeftIcon from \"@/Icons/text-align-justify-left-stroke-standard\";\n\nimport {UpdateType} from \"@/model/dashboard/dashboard-form-model\";\nimport { EyeIcon } from \"@heroicons/react/24/outline\";\n\ninterface SidecardsProps {\n    selectedTypes: UpdateType[];\n    showAll?: boolean;\n}\n\nexport const Sidecards = ({selectedTypes, showAll}: SidecardsProps) => {\n    \n    const allSidebarActions = {\n        look: {\n            title: 'How to Update Page Look',\n            href: 'https://intercom.help/lpagery/en/articles/10011725-update-the-look-static-content-of-created-pages',\n            icon: EyeIcon,\n            iconForeground: 'text-blue-700',\n            iconBackground: 'bg-blue-50',\n            description: 'Learn how to update the appearance of your pages.',\n        },\n        settings: {\n            title: 'How to Update Settings',\n            href: 'https://intercom.help/lpagery/en/articles/10012198-update-the-settings-of-created-pages',\n            icon: Setup01Icon,\n            iconForeground: 'text-purple-700',\n            iconBackground: 'bg-purple-50',\n            description: 'Learn how to update page settings effectively.',\n        },\n        content: {\n            title: 'How to Update Content',\n            href: 'https://intercom.help/lpagery/en/articles/10012196-update-the-content-of-created-pages',\n            icon: TextAlignJustifyLeftIcon,\n            iconForeground: 'text-green-700',\n            iconBackground: 'bg-green-50',\n            description: 'Learn how to update page content efficiently.',\n        }\n    };\n\n    // Determine which actions to show\n    const sidebarActions = showAll \n        ? Object.values(allSidebarActions)\n        : selectedTypes.map(type => allSidebarActions[type]);\n\n    const classNames = (...classes: string[]): string => classes.filter(Boolean).join(' ');\n\n    return (\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n            {sidebarActions.map((action) => (\n                <Card key={action.title}\n                      className=\"p-6 relative group rounded-lg focus-within:ring-2 focus-within:ring-inset focus-within:ring-indigo-500\">\n                    <div>\n                        <span\n                            className={classNames(\n                                action.iconBackground,\n                                action.iconForeground,\n                                'inline-flex rounded-lg p-3 ring-4 ring-white'\n                            )}\n                        >\n                            <action.icon className=\"h-6 w-6\" aria-hidden=\"true\"/>\n                        </span>\n                    </div>\n                    <div className=\"mt-4\">\n                        <h3 className=\"text-base font-semibold leading-6 text-gray-900\">\n                            <a href={action.href} className=\"focus:outline-none\" target=\"_blank\">\n                                <span className=\"absolute inset-0\" aria-hidden=\"true\"/>\n                                {action.title}\n                            </a>\n                        </h3>\n                        <p className=\"mt-2 text-sm text-gray-500\">{action.description}</p>\n                    </div>\n                    <span\n                        className=\"pointer-events-none absolute right-6 top-6 text-gray-300 group-hover:text-gray-400\"\n                        aria-hidden=\"true\"\n                    >\n                        <svg className=\"h-6 w-6\" fill=\"currentColor\" viewBox=\"0 0 24 24\">\n                            <path\n                                d=\"M20 4h1a1 1 0 00-1-1v1zm-1 12a1 1 0 102 0h-2zM8 3a1 1 0 000 2V3zM3.293 19.293a1 1 0 101.414 1.414l-1.414-1.414zM19 4v12h2V4h-2zm1-1H8v2h12V3zm-.707.293l-16 16 1.414 1.414 16-16-1.414-1.414z\"/>\n                        </svg>\n                    </span>\n                </Card>\n            ))}\n        </div>\n    );\n};","import {RocketLaunchIcon} from '@heroicons/react/24/outline'\nimport {CheckCircleIcon} from '@heroicons/react/20/solid'\n\nconst updateBenefits = [\n    'Bulk Update All Created Pages at Once',\n    'Update Existing Pages with New Content',\n    'Change Page Settings in Bulk',\n    'Add New Pages to Existing Page Sets',\n    'Update Look & Static Content of All Pages',\n    'Preserve Existing Content'\n];\nexport function UpgradePrompt() {\n    return  <div className=\"absolute inset-0  backdrop-blur-[3px] z-10 rounded-lg flex items-center justify-center\">\n    <div className=\"max-w-3/4 w-3/4 text-left px-6 py-8 bg-gray-900/80  shadow-lg rounded-lg ring-1 ring-white/10\">\n        <div className=\"max-w-2xl mx-auto\">\n            <h2 className=\"text-3xl font-bold tracking-tight text-white sm:text-4xl mb-6\">\n                Unlock Bulk Update Features\n            </h2>\n            <p className=\"text-lg text-gray-300 mb-8\">\n                Upgrade to LPagery Pro (Extended or Ultimate Plan) to update multiple pages at once and save hours of work.\n            </p>\n        </div>\n        <ul className=\"mt-8 mb-10 grid grid-cols-1 gap-4 text-base leading-7 text-white sm:grid-cols-2 max-w-2xl mx-auto\">\n            {updateBenefits.map((benefit) => (\n                <li key={benefit} className=\"flex gap-x-3 text-left\">\n                    <CheckCircleIcon className=\"h-7 w-5 flex-none text-[#4C88BA]\" />\n                    {benefit}\n                </li>\n            ))}\n        </ul>\n        <button\n            onClick={(e) => {\n                e.preventDefault();\n                window.open('https://lpagery.io/pricing?utm_source=free_version&utm_medium=update_page&utm_campaign=free', '_blank');\n            }}\n            className=\"rounded-md bg-gradient-to-r from-[#4C88BA] to-[#4C88BA] px-6 py-3 font-semibold text-white shadow-sm hover:opacity-80 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#4C88BA] flex items-center mx-auto\"\n        >\n            <span>Upgrade to LPagery Pro</span>\n            <RocketLaunchIcon className=\"h-5 w-5 ml-2\" />\n        </button>\n        <p className=\"text-xs text-gray-400 mt-2 text-center\">7-Day Risk-Free Money Back Guarantee</p>\n\n    </div>\n    </div>\n}\n","'use client'\n\nimport React, {useContext, useEffect, useRef, useState} from 'react';\nimport {Button} from \"@/components/ui/button\";\nimport {Card} from \"@/components/ui/card\";\n\nimport Progress from './Progress';\nimport {SelectUpdateType} from \"@/components/dashboard/update/steps/UpdateType\";\nimport ConfirmUpdate from \"@/components/dashboard/update/steps/ConfirmUpdate\";\nimport TemplatePage from \"@/components/dashboard/update/steps/TemplatePage\";\nimport ContentDetails from \"@/components/dashboard/update/steps/ContentDetails\";\nimport {ChangeSettings} from \"@/components/dashboard/update/ChangeSettings\";\nimport {FormProvider, useForm} from \"react-hook-form\";\nimport {\n    ConfigStepSchema,\n    DashboardSettingsType,\n    DashboardUpdateType,\n    InputFormValues,\n    InputStepSchema,\n    SelectionStepSchema,\n    TypeStepSchema,\n    UpdateType\n} from \"@/model/dashboard/dashboard-form-model\";\nimport {zodResolver} from \"@hookform/resolvers/zod\";\nimport {z, ZodObject} from \"zod\";\nimport {FormStepContext} from \"@/components/dashboard/update/FormStepContext\";\nimport {useProcessConfig} from \"@/hooks/dashboard/update/use-process-config\";\nimport {Loader} from \"@/components/common/Loader\";\nimport {PostStatus} from \"@/types/post-status\";\nimport {ExtractResult, FormDataWithExtractResult, useExtractData} from \"@/hooks/generation/extract/use-extract-data\";\nimport {ManageUpdateContext} from \"@/context/manage-update-context\";\nimport {ConfirmCreationModal} from \"@/components/dashboard/save/confirm/components/ConfirmCreationModal\";\nimport {useCombineInputAndExistingPages} from \"@/hooks/generation/extract/use-combine-input-and-existing-pages\";\nimport {usePagesToBeUpdatedForUpdateModal} from \"@/hooks/dashboard/update/use-pages-to-be-updated-for-update-modal\";\nimport {useSubscription} from \"@/hooks/subscription/use-subscription\";\nimport {Sidecards} from \"@/components/dashboard/update/Sidecards\";\n\nimport {UpgradePrompt} from './UpgradePrompt';\nimport {ErrorBoundaryWrapper} from \"@/components/layout/error/ErrorBoundaryWrapper\";\nimport {useQueryClient} from '@tanstack/react-query';\nimport {useEvictImageSearchCache} from \"@/hooks/media/use-evict-image-search-cache\";\n\nexport type StepType = 'template' | 'type' | 'settings' | 'content' | 'confirm';\n\nexport interface Step {\n    id: StepType;\n    name: string;\n    href?: string;\n    component: React.ReactNode;\n    description: string;\n    active: boolean | UpdateType;\n    schema: ZodObject<any>;\n}\n\n\nconst Update = () => {\n    const [formData, setFormData] = useState<DashboardUpdateType>({} as DashboardUpdateType);\n    const [creationDashboardModalOpened, setCreationDashboardModalOpened] = useState(false);\n\n    const [currentStep, setCurrentStep] = useState(0);\n    const [processId, setProcessId] = useState<number>();\n    const {data: processResponse, isLoading: processLoading} = useProcessConfig(processId);\n    const previousProcessData = useRef<DashboardSettingsType>();\n    const {extractData, loading: extractLoading} = useExtractData(formData.config);\n    const [formResult, setFormResult] = useState<FormDataWithExtractResult>();\n    const {processId: processIdFromContext, templateId: templateIdFromContext} = useContext(ManageUpdateContext);\n    const [includeParentAsIdentifier, setIncludeParentAsIdentifier] = useState(false)\n\n    const {data: existingPages, isLoading: existingPagesLoading} = usePagesToBeUpdatedForUpdateModal(\n        formData?.updateSelection?.template,\n        formData?.updateSelection?.process\n    );\n    useEffect(() => {\n        queryClient.removeQueries({queryKey: ['pages-to-be-updated']});\n    }, []);\n\n    const {combineInputAndExistingData} = useCombineInputAndExistingPages(formData, processResponse?.process?.include_parent_as_identifier, existingPages)\n    const [submitted, setSubmitted] = useState(false)\n    const {extended} = useSubscription()\n    const queryClient = useQueryClient()\n    const evictImageSearchCache = useEvictImageSearchCache()\n\n    useEffect(() => {\n        if (formResult) {\n            queryClient.removeQueries({queryKey: ['confirm-dialog']});\n            setCreationDashboardModalOpened(true);\n        }\n    }, [formResult]);\n\n    const steps: Step[] = [\n        {\n            id: 'template',\n            name: 'Select Template Page and Page Set',\n            component: <TemplatePage/>,\n            description: \"Select the template page with which you created the pages you want to update.\",\n            active: true,\n            schema: SelectionStepSchema\n        },\n        {\n            id: 'type',\n            name: 'Select Update Types',\n            component: <SelectUpdateType/>,\n            description: \"Choose the types of update you want to perform. You can select multiple types at the same time.\",\n            active: true,\n            schema: TypeStepSchema\n        },\n        {\n            id: 'settings',\n            name: 'Change Settings',\n            component: <ChangeSettings/>,\n            description: \"Change the settings of the pages you selected.\",\n            active: 'settings',\n            schema: ConfigStepSchema\n        },\n        {\n            id: 'content',\n            name: 'Upload New/Updated Source Data',\n            component: <ContentDetails/>,\n            description: \"Choose the source data you want to use to update the content of the pages.\",\n            active: 'content',\n            schema: InputStepSchema\n        },\n        {\n            id: 'confirm',\n            name: 'Review Updates',\n            component: <ConfirmUpdate previousConfig={previousProcessData.current}/>,\n            description: \"These changes will be applied to the selected pages.\",\n            active: true,\n            schema: z.object({})\n        },\n    ];\n\n    const [activeItems, setActiveItems] = useState<Step[]>([]);\n\n    const methods = useForm<DashboardUpdateType>({\n        resolver: zodResolver(activeItems[currentStep]?.schema || z.object({})),\n        defaultValues: {\n            updateType: ['look'],\n            input: {\n                sheet: {\n                    sync_settings: {\n                        enabled: false,\n                        add: false,\n                    }\n                }\n            }\n        }\n    });\n\n\n    const processWatch = methods.watch('updateSelection.process');\n    const templateWatch = methods.watch('updateSelection.template');\n\n\n    useEffect(() => {\n        let updateSelection = {};\n        if (processIdFromContext) {\n            updateSelection = {process: processIdFromContext};\n        }\n        if (templateIdFromContext) {\n            updateSelection = {...updateSelection, template: templateIdFromContext};\n        }\n        if (templateIdFromContext && !processIdFromContext) {\n            methods.setValue('updateType', ['look']);\n        }\n        if (processIdFromContext || templateIdFromContext) {\n            methods.reset({...methods.getValues(), updateSelection: updateSelection});\n        }\n    }, [processIdFromContext, templateIdFromContext]);\n\n    useEffect(() => {\n        if (processResponse) {\n            let reset = {};\n            const values = methods.getValues();\n            const googleSheetData = processResponse.google_sheet_data;\n            const config = {\n                input: {\n                    source: 'file'\n                },\n                config: {\n                    template: processResponse.process.post_id,\n                    parent: processResponse.config_data.parent_path,\n                    slug: processResponse.config_data.slug,\n                    status: '-1' as PostStatus,\n                    taxonomy_terms: processResponse.config_data.taxonomy_terms,\n                    purpose: processResponse.process.raw_purpose\n                }\n            };\n            previousProcessData.current = config.config;\n            reset = {...config};\n            if (googleSheetData && googleSheetData?.url)  {\n                const inputConfig = {\n                    input: {\n                        source: 'sheet',\n                        sheet: {\n                            url: googleSheetData?.url,\n                            sync_settings: {\n                                enabled: processResponse?.process.google_sheet_sync_enabled,\n                                add: googleSheetData.add,\n                                update: googleSheetData.update,\n                                delete: googleSheetData.delete\n                            }\n                        }\n                    } as InputFormValues\n                };\n                reset = {...config, ...inputConfig};\n            }\n            methods.reset({...values, ...reset});\n\n            setIncludeParentAsIdentifier(processResponse.process.include_parent_as_identifier ?? false);\n        }\n    }, [processResponse]);\n\n    const filterSteps = (updateType: UpdateType[]) => {\n        return steps.filter(step => {\n            if (step.id === 'type' && !processWatch) {\n                // Exclude 'type' step when processId is empty\n                return false;\n            }\n            if (step.active === true) {\n                return true;\n            }\n            if (updateType && step.active !== false) {\n                return updateType.includes(step.active);\n            }\n            return false;\n        });\n    };\n\n    const updateTypeWatch = methods.watch('updateType');\n    useEffect(() => {\n        const updateType = updateTypeWatch || ['look'];\n        const filteredSteps = filterSteps(updateType);\n        setActiveItems(filteredSteps);\n    }, [updateTypeWatch]);\n\n    useEffect(() => {\n        // Only modify updateType if we're on the first step\n        if (currentStep === 0) {\n            const templateOnly = !processWatch && templateWatch;\n            // If we only have a template selected, keep or set 'look' as the update type\n            if (templateOnly) {\n                methods.setValue('updateType', ['look']);\n            }\n            // If we have a process selected, allow user to choose update types\n            else if (processWatch) {\n                methods.setValue('updateType', []);\n            }\n        }\n    }, [processWatch, templateWatch, methods, currentStep]);\n\n    useEffect(() => {\n        if (formData.updateSelection?.process) {\n            setProcessId(formData.updateSelection.process);\n        } else {\n            setProcessId(undefined);\n        }\n    }, [formData]);\n\n    const [attemptedNext, setAttemptedNext] = useState(false);\n\n    const handleNext = async (e: React.MouseEvent<HTMLElement>) => {\n        e.preventDefault();\n        const isStepValid = await methods.trigger();\n        const templateSelected = methods.watch('updateSelection.template');\n        const updateTypesSelected = methods.watch('updateType');\n\n        // Disable next button in first step if no template is selected\n        if (currentStep === 0 && !templateSelected) {\n            setAttemptedNext(true);\n            return;\n        }\n\n        // Disable next button in second step if no update type is selected\n        if (currentStep === 1 && (!updateTypesSelected || updateTypesSelected.length === 0)) {\n            setAttemptedNext(true);\n            return;\n        }\n\n        if (isStepValid) {\n            setFormData({...formData, ...methods.getValues()});\n            setCurrentStep(prev => Math.min(prev + 1, activeItems.length - 1));\n            setAttemptedNext(false);\n        } else {\n            setAttemptedNext(true);\n        }\n    };\n\n    const handleBack = (e: React.MouseEvent<HTMLElement>) => {\n        e.preventDefault();\n        setCurrentStep(prev => Math.max(prev - 1, 0));\n    };\n\n\n    const currentStepComponent = activeItems[currentStep]?.component;\n\n    const onSubmit = async () => {\n        await evictImageSearchCache.mutateAsync();\n        const data = methods.getValues();\n\n        let existing: ExtractResult = {headers: [], data: []};\n        if (data.input && data.config && data.updateType.includes('content')) {\n            existing = await extractData(data.input, data.config.slug);\n        }\n\n        const extractResult = await combineInputAndExistingData(existing, previousProcessData.current);\n        setFormResult({formData, extractResult});\n        setSubmitted(true);\n\n    };\n\n    return (\n        <div className=\"space-y-6 relative\" id=\"update-wrapper\">\n            <FormProvider {...methods}>\n                <FormStepContext.Provider value={{attemptedNext, setAttemptedNext}}>\n                    <form onSubmit={methods.handleSubmit(onSubmit)}>\n                        <Card className=\"p-6 py-10\">\n                            {!extended && <UpgradePrompt/>}\n\n                            <Progress steps={activeItems} currentStep={currentStep}/>\n                            <div className='p-6'>\n                                <div className=\"mt-12\">\n                                    <h2 className=\"text-xl font-semibold mb-2\">{activeItems[currentStep]?.name}</h2>\n                                    <p className=\"text-sm text-gray-600\">{activeItems[currentStep]?.description}</p>\n\n                                </div>\n                                <div className='mt-8 space-y-8'>\n                                    {(processLoading && processId && processId > 0) ? <Loader/> : (\n                                        <>\n                                            <ErrorBoundaryWrapper>\n                                                {currentStepComponent}\n                                            </ErrorBoundaryWrapper>\n                                            <div className=\"flex justify-end mt-8 space-x-4\">\n                                                {currentStep > 0 &&\n                                                    <Button onClick={handleBack} variant=\"outline\">Back</Button>}\n                                                {currentStep < activeItems.length - 1 ? (\n                                                    <Button\n                                                        onClick={handleNext}\n                                                        data-testid={'update-next-button'}\n                                                        disabled={\n                                                            !extended ||\n                                                            (currentStep === 0 && !methods.watch('updateSelection.template')) ||\n                                                            (currentStep === 1 && (!methods.watch('updateType') || methods.watch('updateType').length === 0))\n                                                        }\n                                                    >\n                                                        Next\n                                                    </Button>\n                                                ) : (\n                                                    <Button type=\"submit\" data-testid={'update-review-button'} loading={extractLoading} disabled={existingPagesLoading}>Review & Update\n                                                        Pages</Button>\n                                                )}\n\n                                            </div>\n                                        </>\n                                    )}\n                                </div>\n                            </div>\n                        </Card>\n                    </form>\n                </FormStepContext.Provider>\n            </FormProvider>\n\n            {(\n                // Only show cards when we're explicitly on or past the 'type' step\n                currentStep > 0 && (  // This ensures we're past the first step\n                    <Sidecards\n                        selectedTypes={methods.watch('updateType') || []}\n                        showAll={processWatch !== undefined}\n                    />\n                )\n            )}\n\n            {formResult && submitted && (\n                <ConfirmCreationModal\n                    mode={'update'}\n                    result={formResult}\n                    setIsOpen={setCreationDashboardModalOpened}\n                    isOpen={creationDashboardModalOpened}\n                    process_id={processId}\n                    includeParentAsIdentifierProp={includeParentAsIdentifier}\n                />\n            )}\n        </div>\n    );\n};\n\nexport default Update;\n","export default \"__VITE_ASSET__BzFUh4Bw__\"","export default \"__VITE_ASSET__V6DgPwtw__\"","export default \"__VITE_ASSET__B06QNdGv__\"","import {Button} from \"@/components/ui/button\";\nimport {ArrowRightIcon} from \"@heroicons/react/24/outline\";\n// @ts-ignore\nimport SourcefileImage from '@/assets/onboarding/SourceFileNeu2.png';\n// @ts-ignore\nimport TemplatePageImage from '@/assets/onboarding/TemplatePageCleaning.png';\n// @ts-ignore\nimport CreatedPagesImage from '@/assets/onboarding/ResultCleaningNeu.png';\nimport { usePostHog } from \"posthog-js/react\";\n\ninterface Step1Props {\n    handleNextStep: () => void;\n    onSkipOnboarding: () => void;\n}\n\nconst Step1 = ({handleNextStep, onSkipOnboarding}: Step1Props) => {\n    return (\n        <div className=\"w-full max-w-7xl mx-auto px-2 sm:px-4 lg:px-8\">\n            <div className=\"bg-white rounded-lg shadow-lg p-3 sm:p-6 lg:p-8 space-y-4 sm:space-y-6\">\n                <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-3 lg:gap-8\">\n                    <div className=\"bg-white p-3 sm:p-4 lg:p-6 rounded-lg shadow-sm border border-gray-200\">\n                        <img src={TemplatePageImage} alt=\"Template Page\" className=\"h-24 sm:h-32 lg:h-48 w-full object-contain object-center mb-3 sm:mb-4 rounded-lg\"/>\n                        <h3 className=\"text-base sm:text-lg font-semibold mb-1 sm:mb-2\">Step 1: Design Your Template</h3>\n                        <p className=\"text-gray-600 text-xs sm:text-sm\">Create a template page that will serve as the blueprint for all generated pages.</p>\n                    </div>\n                    <div className=\"bg-white p-3 sm:p-4 lg:p-6 rounded-lg shadow-sm border border-gray-200\">\n                        <img src={SourcefileImage} alt=\"Source File\" className=\"h-24 sm:h-32 lg:h-48 w-full object-contain object-center mb-3 sm:mb-4 rounded-lg\"/>\n                        <h3 className=\"text-base sm:text-lg font-semibold mb-1 sm:mb-2\">Step 2: Upload Your Source File</h3>\n                        <p className=\"text-gray-600 text-xs sm:text-sm\">Upload your file (CSV or XLSX format) containing the data for each page you want to generate.</p>\n                    </div>\n                    <div className=\"bg-white p-3 sm:p-4 lg:p-6 rounded-lg shadow-sm border border-gray-200\">\n                        <img src={CreatedPagesImage} alt=\"Created Pages\" className=\"h-24 sm:h-32 lg:h-48 w-full object-contain object-center mb-3 sm:mb-4 rounded-lg\"/>\n                        <h3 className=\"text-base sm:text-lg font-semibold mb-1 sm:mb-2\">Step 3: Generate Pages</h3>\n                        <p className=\"text-gray-600 text-xs sm:text-sm\">LPagery combines your source file with the template to create multiple pages automatically.</p>\n                    </div>\n                </div>\n                <div className=\"flex flex-col sm:flex-row justify-center pt-4 sm:pt-6 space-y-3 sm:space-y-0 sm:space-x-4\">\n                    <Button\n                        onClick={onSkipOnboarding}\n                        event={'Onboarding skipped from Step 1'}\n                        variant=\"outline\"\n                        className=\"w-full sm:w-auto hover:text-gray-700\"\n                    >\n                        Skip Onboarding\n                    </Button>\n                    <Button \n                        onClick={handleNextStep} \n                        className=\"w-full sm:w-auto bg-custom-blue-400 text-white\" \n                        data-testid=\"start-with-step-1\" \n                        event=\"Onboarding Start\"\n                    >\n                        Start With Step 1: Select Your Template Page <ArrowRightIcon className=\"h-5 w-5 ml-2\" aria-hidden=\"true\"/>\n                    </Button>\n                </div>\n            </div>\n        </div>\n    )\n}\n\nexport const Step1Explanation = () => {\n    return (\n        <div className=\"space-y-6 pl-12 pr-12\">\n            {/* Video Section */}\n            <div className=\"w-full aspect-video\">\n                <iframe\n                    className=\"w-full h-full rounded-lg shadow-lg\"\n                    src=\"https://www.youtube.com/embed/yvfAxmKavzk?si=bNjvwB-j2AB1vYfr\"\n                    title=\"Tutorial Video\"\n                    allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\"\n                    allowFullScreen\n                ></iframe>\n            </div>\n            \n        </div>\n    )\n}\n\nexport default Step1;","export default \"__VITE_ASSET__Cwmhcmle__\"","import {PlayIcon} from \"@heroicons/react/24/outline\";\nimport {useRef, useState} from \"react\";\n\ninterface Props {\n    src: string;\n    poster: string;\n}\nexport const Video = ({src, poster}: Props) => {\n    const videoRef = useRef<HTMLVideoElement>(null);\n    const [isPlaying, setIsPlaying] = useState(false);\n\n    return <div className=\"w-full aspect-video relative\">\n        <video\n            ref={videoRef}\n            className=\"w-full h-full rounded-lg shadow-lg\"\n            src={src}\n            controls={isPlaying}\n            poster={poster}\n            onClick={(e) => {\n                const video = e.currentTarget;\n                if (video) {\n                    video.play().then(() => {\n                        setIsPlaying(true);\n                    })\n                }\n            }}\n        >\n            Your browser does not support video playback.\n        </video>\n        {!isPlaying && (\n            <div\n                className=\"absolute inset-0 flex items-center justify-center cursor-pointer bg-black bg-opacity-30\"\n                onClick={() => {\n                    if (videoRef.current) {\n                        videoRef.current.play().then(() => {\n                            setIsPlaying(true);\n                        })\n                    }\n                }}\n            >\n                <div className=\"w-16 h-16 bg-white bg-opacity-80 rounded-full flex items-center justify-center\">\n                    <PlayIcon className=\"h-8 w-8 text-black\"/>\n                </div>\n            </div>\n        )}\n    </div>\n}","import { z } from 'zod';\nimport useWordpressAjaxMutation from \"@/hooks/fetch/use-mutation\";\nimport { useMutation, useQueryClient } from \"@tanstack/react-query\";\n\nconst OnboardingTemplateResponseSchema = z.object({\n    success: z.boolean(),\n    page_id: z.number()\n});\n\ntype OnboardingTemplateResponse = z.infer<typeof OnboardingTemplateResponseSchema>;\n\nexport const useCreateOnboardingTemplate = () => {\n    const queryClient = useQueryClient();\n    const createTemplateMutation = useWordpressAjaxMutation<{}, OnboardingTemplateResponse>(\n        \"lpagery_create_onboarding_template_page\",\n        z.object({}),\n        OnboardingTemplateResponseSchema\n    );\n\n    return useMutation({\n        mutationKey: ['onboarding_template'],\n        mutationFn: async () => {\n            const result = await createTemplateMutation({ body: {} });\n            if (!result?.success) {\n                throw new Error(\"Failed to create onboarding template\");\n            }\n            return result;\n        },\n        onSuccess: () => {\n            queryClient.invalidateQueries({ queryKey: ['posts'] });\n        }\n    });\n}; ","import {Button} from \"@/components/ui/button\";\nimport {ArrowLeftIcon, ArrowRightIcon, CheckCircleIcon, ArrowTopRightOnSquareIcon, PlusIcon} from \"@heroicons/react/24/outline\";\n// @ts-ignore\nimport {PageSelect} from \"@/components/dashboard/save/components/PageSelect\";\n// @ts-ignore\nimport TemplatePageImage from '@/assets/onboarding/TemplatePageCleaning.png';\n// @ts-ignore\nimport TemplatePageThumbnail from '@/assets/onboarding/Step1Thumbnail.png';\nimport {useFormContext} from \"react-hook-form\";\nimport {useEffect, useRef, useState} from \"react\";\nimport {Video} from \"@/components/ui/video\";\nimport { Label } from \"@/components/ui/label\";\nimport { useCreateOnboardingTemplate } from \"@/hooks/onboarding/use-create-onboarding-template\";\nimport { usePostHog } from \"posthog-js/react\";\n\ninterface Step3Props {\n    handleNextStep: () => void;\n    handlePreviousStep: () => void;\n}\n\nexport function Step2({handleNextStep, handlePreviousStep}: Step3Props) {\n    const {register, watch, reset, getValues} = useFormContext();\n    const slugWatch = watch('config.slug');\n    const templateWatch = watch('config.template');\n    const posthog = usePostHog();\n\n    const slugWithoutPlaceholders = slugWatch && !slugWatch.includes(\"{\") \n\n    \n\n    const createOnboardingTemplate = useCreateOnboardingTemplate();\n\n    const onClickCreateNewTemplate =async () => {\n        const result = await createOnboardingTemplate.mutateAsync();\n        if (result?.success) {\n            window.open(`/wp-admin/post.php?post=${result.page_id}&action=edit`, '_blank');\n            reset({\n                ...getValues(),\n                template_created: true,\n                config: {\n                    ...getValues().config,\n                    template: result.page_id\n                }\n            });\n        }\n    };\n\n    useEffect(() => {\n        if (slugWithoutPlaceholders) {\n            posthog.capture('Onboarding Selected Template Without Placeholders')\n        }\n    }, [slugWithoutPlaceholders, posthog])\n\n    // Update the example title to be more explicit\n    const exampleTitle = \"Example Title: The Best {service} in {city}\";\n\n    return (\n        <div className=\"max-w-3/4 mx-auto\">\n            <div className=\"bg-white rounded-lg shadow-lg border overflow-hidden\">\n                {/* Create New Template Section */}\n                <div className=\"p-3 sm:p-6 bg-gray-50 border-b\">\n                    {watch('template_created') ? (\n                        <div className=\"flex flex-col sm:flex-row items-start sm:items-center p-3 sm:p-4 mb-3 sm:mb-4 bg-green-50 border border-green-200 rounded-lg\">\n                            <CheckCircleIcon className=\"h-5 w-5 sm:h-6 sm:w-6 text-green-700 mb-2 sm:mb-0 sm:mr-3\" />\n                            <div>\n                                <h4 className=\"text-green-700 text-base sm:text-lg font-bold\">Template Created Successfully!</h4>\n                                <p className=\"text-green-700 text-xs sm:text-sm\">\n                                    Your new template page is ready. We've selected it for you below.\n                                </p>\n                            </div>\n                        </div>\n                    ) : (\n                        <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between space-y-3 sm:space-y-0\">\n                            <div className=\"space-y-1\">\n                                <Label className=\"text-base sm:text-lg font-bold\">Create New Template Page</Label>\n                                <p className=\"text-xs sm:text-sm text-gray-500\">\n                                    <span className=\"font-bold\">We'll set up a new page for you with placeholder title:</span>\n                                    <br/>\n                                    <span className=\"font-mono text-gray-800 text-xs sm:text-sm\">\"{exampleTitle}\"</span>\n                                </p>\n                            </div>\n                            <Button\n                                loading={createOnboardingTemplate.isPending}\n                                data-testid=\"create-new-template-page\"\n                                className=\"w-full sm:w-auto inline-flex items-center bg-custom-blue-400 text-white hover:bg-custom-blue-500\"\n                                onClick={onClickCreateNewTemplate}\n                                event=\"Onboarding Create New Template Page\"\n                            >\n                                Create New Template Page \n                                <PlusIcon className=\"h-4 w-4 sm:h-5 sm:w-5 ml-2\"/>\n                            </Button>\n                        </div>\n                    )}\n                </div>\n\n                {/* Select Template Section */}\n                <div className=\"p-3 sm:p-6\">\n                    <div className=\"space-y-3 sm:space-y-4\">\n                        <PageSelect \n                            {...register('config.template')} \n                            type={'template'} \n                            onTriggerClick={() => {\n                                posthog.capture('Onboarding Select Template')\n                            }}\n                            mode={'create'} \n                        />\n                        \n                        <div>\n                            {templateWatch > 0 ? (\n                                <a \n                                    href={`/wp-admin/post.php?post=${templateWatch}&action=edit`} \n                                    target=\"_blank\" \n                                    onClick={() => {\n                                        posthog.capture('Onboarding View Template Page')\n                                    }}\n                                    rel=\"noopener noreferrer\"\n                                    className=\"inline-flex items-center text-xs sm:text-sm text-custom-blue-400 hover:text-custom-blue-500 transition-colors\"\n                                >\n                                    View Template Page\n                                    <ArrowTopRightOnSquareIcon className=\"h-3 w-3 sm:h-4 sm:w-4 ml-1\" />\n                                </a>\n                            ) : null}\n                        </div>\n                    </div>\n                </div>\n\n                {/* Navigation */}\n                <div className=\"px-3 sm:px-6 py-3 sm:py-4 bg-gray-50 border-t\">\n                    <div className=\"flex flex-col sm:flex-row justify-between space-y-3 sm:space-y-0\">\n                        <Button onClick={handlePreviousStep} variant=\"outline\" className=\"w-full sm:w-auto\" event=\"Onboarding Back On Select Template\">\n                            <ArrowLeftIcon className=\"h-4 w-4 sm:h-5 sm:w-5 mr-2\" aria-hidden=\"true\"/> Back\n                        </Button>\n                        <Button\n                            onClick={handleNextStep}\n                            className=\"w-full sm:w-auto bg-custom-blue-400 text-white\"\n                            disabled={!slugWatch?.includes(\"{\") || !templateWatch || templateWatch === -1}\n                            event=\"Onboarding Upload Source File\"\n                            data-testid=\"next-step-source-file\"\n                        >\n                            Next Step: Upload Source File <ArrowRightIcon className=\"h-4 w-4 sm:h-5 sm:w-5 ml-2\" aria-hidden=\"true\"/>\n                        </Button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    );\n}\n\n// Updated Step3Explanation component\nexport const Step2Explanation = () => {\n    const [showScrollIndicator, setShowScrollIndicator] = useState(true);\n    const scrollContainerRef = useRef<HTMLDivElement>(null);\n\n    const handleScroll = (e: React.UIEvent<HTMLDivElement>) => {\n        const target = e.target as HTMLDivElement;\n        const isNearBottom = target.scrollHeight - target.scrollTop <= target.clientHeight + 100;\n        setShowScrollIndicator(!isNearBottom);\n    };\n\n    const scrollToBottom = () => {\n        if (scrollContainerRef.current) {\n            scrollContainerRef.current.scrollTo({\n                top: scrollContainerRef.current.scrollHeight,\n                behavior: 'smooth'\n            });\n        }\n    };\n\n    return (\n        <div className=\"static h-full\">\n            <div className=\"h-8 lg:h-16\"/>\n\n            <div\n                ref={scrollContainerRef}\n                onScroll={handleScroll}\n                className=\"px-4 lg:px-12 pt-4 lg:pt-12 overflow-y-auto scrollbar-thin scrollbar-thumb-gray-300 scrollbar-track-gray-100 hover:scrollbar-thumb-gray-400\"\n            >\n                <div className=\"relative\">\n                    <div className=\"space-y-6 pb-16\">\n                        <div className=\"w-full rounded-lg shadow-lg\">\n                            <Video\n                                src=\"https://c59trvp5ocfyno80.public.blob.vercel-storage.com/LPageryOnboardingVideos/OnboardingTemplate-XSAeQdZkbGRy3MOU774LSS53OQt2ri.mp4\"\n                                poster={TemplatePageThumbnail}\n                            />\n                        </div>\n\n                        <ol className=\"relative border-l border-gray-200 space-y-6 pr-4 ml-4\">\n                            <li className=\"ml-8\">\n                                <span className=\"absolute flex items-center justify-center w-6 h-6 lg:w-8 lg:h-8 bg-custom-blue-400 rounded-full -left-3 lg:-left-4 ring-4 ring-white\">\n                                    <span className=\"text-white text-xs lg:text-sm\">1</span>\n                                </span>\n                                <h2 className=\"text-base lg:text-lg font-bold mb-2 text-custom-blue-400\">About Placeholders</h2>\n                                <div className=\"space-y-3 lg:space-y-4\">\n                                    <p className=\"text-gray-600 text-xs lg:text-sm\">\n                                        Placeholders like {'{city}'} and {'{service}'} will be replaced with data from your source file.\n                                        Add them in your:\n                                    </p>\n                                    <ul className=\"list-disc ml-4 space-y-2 text-xs lg:text-sm text-gray-600\">\n                                        <li>\n                                            <span className=\"font-medium\">WordPress Page Title</span> (Required)\n                                            <br/>\n                                            Example: \"The Best {'{service}'} in {'{city}'}\"\n                                        </li>\n                                        <li>\n                                            <span className=\"font-medium\">Page Content</span>\n                                            <br/>\n                                            Example: \"Looking for {'{service}'} in {'{city}'}?\"\n                                        </li>\n                                        <li>\n                                            <span className=\"font-medium\">SEO Fields</span>\n                                            <br/>\n                                            Meta title, description, etc.\n                                        </li>\n                                    </ul>\n                                </div>\n                            </li>\n\n                            <li className=\"ml-8\">\n                                <span className=\"absolute flex items-center justify-center w-6 h-6 lg:w-8 lg:h-8 bg-custom-blue-400 rounded-full -left-3 lg:-left-4 ring-4 ring-white\">\n                                    <span className=\"text-white text-xs lg:text-sm\">2</span>\n                                </span>\n                                <h2 className=\"text-base lg:text-lg font-bold mb-2 text-custom-blue-400\">Example Template</h2>\n                                <div>\n                                    <img\n                                        src={TemplatePageImage}\n                                        alt=\"Template Page Example\"\n                                        className=\"rounded-lg shadow-lg w-full object-cover\"\n                                    />\n                                </div>\n                            </li>\n                        </ol>\n                    </div>\n                </div>\n            </div>\n\n            {showScrollIndicator && (\n                <div\n                    className=\"fixed lg:absolute bottom-0 left-0 right-0 h-16 lg:h-24 cursor-pointer\"\n                    onClick={scrollToBottom}\n                >\n                    <div className=\"absolute inset-0 bg-gradient-to-t from-white via-white/80 to-transparent shadow-lg\"/>\n                    <div className=\"absolute bottom-4 left-1/2 -translate-x-1/2 animate-bounce\">\n                        <svg\n                            xmlns=\"http://www.w3.org/2000/svg\"\n                            className=\"h-4 w-4 lg:h-6 lg:w-6 text-custom-blue-400\"\n                            fill=\"none\"\n                            viewBox=\"0 0 24 24\"\n                            stroke=\"currentColor\"\n                        >\n                            <path\n                                strokeLinecap=\"round\"\n                                strokeLinejoin=\"round\"\n                                strokeWidth={2}\n                                d=\"M19 14l-7 7m0 0l-7-7m7 7V3\"\n                            />\n                        </svg>\n                    </div>\n                </div>\n            )}\n        </div>\n    );\n};\n","export default \"__VITE_ASSET__BnO56_j7__\"","import {Button} from \"@/components/ui/button\";\nimport {ArrowLeftIcon} from \"@heroicons/react/24/outline\";\nimport {useRef, useState} from 'react';\n// @ts-ignore\nimport ReviewThumbnail from '@/assets/onboarding/CreateThumbnail.png';\nimport {Video} from \"@/components/ui/video\";\n\ninterface Step4Props {\n    handleNextStep: () => void;\n    handlePreviousStep: () => void;\n}\nexport function Step4Content({handleNextStep, handlePreviousStep}: Step4Props) {\n    return (\n        <div className=\"max-w-3/4 mx-auto\">\n            <div className=\"bg-white rounded-lg shadow-lg border p-8 space-y-8\">\n\n\n                <div className=\"flex gap-4\">\n                    <Button \n                        type=\"button\"\n                        onClick={handlePreviousStep}\n                        variant=\"outline\"\n                        className=\"w-full\"\n                        event=\"Onboarding Back On Review & Create Pages\"\n                    >\n                        <ArrowLeftIcon className=\"h-5 w-5 mr-2\" aria-hidden=\"true\" /> Back\n                    </Button>\n                    <Button \n                        type=\"submit\" \n                        onClick={handleNextStep}\n                        data-testid=\"last-step-review-create-pages\"\n                        className=\"w-full bg-custom-blue-400 text-white\"\n                        event=\"Onboarding Review & Create Pages\"\n                    >\n                        Review & Create Pages!\n                    </Button>\n                </div>\n            </div>\n        </div>\n    )\n}\n\n// Add this export for the right side explanation\nexport const Step4Explanation = () => {\n    const [showScrollIndicator, setShowScrollIndicator] = useState(true);\n    const scrollContainerRef = useRef<HTMLDivElement>(null);\n    \n    const handleScroll = (e: React.UIEvent<HTMLDivElement>) => {\n        const target = e.target as HTMLDivElement;\n        const isNearBottom = target.scrollHeight - target.scrollTop <= target.clientHeight + 100;\n        setShowScrollIndicator(!isNearBottom);\n    };\n\n    const [isPlaying, setIsPlaying] = useState(false);\n\n    return (\n        <div className=\"static h-full\">\n            <div \n                ref={scrollContainerRef}\n                onScroll={handleScroll}\n                className=\"pl-12 pt-12 pb-12 absolute inset-0 pr-12 overflow-y-auto scrollbar-thin scrollbar-thumb-gray-300 scrollbar-track-gray-100 hover:scrollbar-thumb-gray-400\"\n            >\n                <div className=\"relative\">\n                    <div className=\"space-y-6 pl-4 pb-16\">\n                        <Video\n                            src=\"https://c59trvp5ocfyno80.public.blob.vercel-storage.com/LPageryOnboardingVideos/Create-Nlpd7ZF76Jqyxy1XKlKXLZ1vruPzZd.mp4\"\n                            poster={ReviewThumbnail}\n                        />\n\n                        <ol className=\"relative border-l border-gray-200 space-y-6 pr-4 ml-4\">\n                            <li className=\"ml-8\">\n                                <span className=\"absolute flex items-center justify-center w-8 h-8 bg-custom-blue-400 rounded-full -left-4 ring-4 ring-white\">\n                                    <span className=\"text-white text-sm\">1</span>\n                                </span>\n                                <h2 className=\"text-lg font-bold mb-2 text-custom-blue-400\">Review Your Setup</h2>\n                                <p className=\"text-gray-600 text-sm\">\n                                    You've successfully:\n                                    <ul className=\"list-disc ml-4 mt-2 space-y-1\">\n                                        <li>Uploaded your source file with your page data</li>\n                                        <li>Selected a template page with placeholders</li>\n                                    </ul>\n                                </p>\n                            </li>\n\n                            <li className=\"ml-8\">\n                                <span className=\"absolute flex items-center justify-center w-8 h-8 bg-custom-blue-400 rounded-full -left-4 ring-4 ring-white\">\n                                    <span className=\"text-white text-sm\">2</span>\n                                </span>\n                                <h2 className=\"text-lg font-bold mb-2 text-custom-blue-400\">What Happens Next</h2>\n                                <p className=\"text-gray-600 text-sm\">\n                                    When you click \"Review & Create Pages\":\n                                    <ul className=\"list-disc ml-4 mt-2 space-y-1\">\n                                        <li>You'll see a preview of all pages to be created</li>\n                                        <li>Review the generated URLs and content</li>\n                                        <li>Confirm to create all pages at once</li>\n                                    </ul>\n                                </p>\n                            </li>\n                        </ol>\n                    </div>\n                </div>\n            </div>\n        </div>\n    )\n}","export default \"__VITE_ASSET__BODpmYKy__\"","/*!\n\nJSZip v3.10.1 - A JavaScript class for generating and reading zip files\n<http://stuartk.com/jszip>\n\n(c) 2009-2016 Stuart Knightley <stuart [at] stuartk.com>\nDual licenced under the MIT license or GPLv3. See https://raw.github.com/Stuk/jszip/main/LICENSE.markdown.\n\nJSZip uses the library pako released under the MIT license :\nhttps://github.com/nodeca/pako/blob/main/LICENSE\n*/\n\n!function(e){if(\"object\"==typeof exports&&\"undefined\"!=typeof module)module.exports=e();else if(\"function\"==typeof define&&define.amd)define([],e);else{(\"undefined\"!=typeof window?window:\"undefined\"!=typeof global?global:\"undefined\"!=typeof self?self:this).JSZip=e()}}(function(){return function s(a,o,h){function u(r,e){if(!o[r]){if(!a[r]){var t=\"function\"==typeof require&&require;if(!e&&t)return t(r,!0);if(l)return l(r,!0);var n=new Error(\"Cannot find module '\"+r+\"'\");throw n.code=\"MODULE_NOT_FOUND\",n}var i=o[r]={exports:{}};a[r][0].c