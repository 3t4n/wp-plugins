rocessPending}><ArrowLeftIcon\n                                    className=\"h-5 w-5 mr-2\" />Go Back</Button>\n                                <Button onClick={() => setIsWarningOpen(true)} disabled={extractResultLoading && !checkingTimeouted} loading={upsertProcessPending} data-testid=\"confirm-create-button\" event={onboarding ? \"Onboarding Confirm Creation\" : \"Confirm Creation\"}>\n                                    {previewMode\n                                        ? isUpdateMode\n                                            ? `Update Preview ${singularPostType}`\n                                            : `Create Preview ${singularPostType}`\n                                        : isUpdateMode\n                                            ? `Update ${pagesToCreate} ${pagesToCreate === 1 ? singularPostType : pluralPostType}`\n                                            : `Create ${pagesToCreate} ${pagesToCreate === 1 ? singularPostType : pluralPostType}`}\n                                    <ArrowRightIcon className=\"h-5 w-5 ml-2\" />\n                                </Button>\n\n                            </div>\n                           \n                        </>\n                    ) : isSheetSyncTriggered ? (\n                        <SuccessSheetTriggered mode={mode} onClose={handleCloseProgress} />\n                    ) : (\n                        <ProgressPages\n                            result={result}\n                            template_id={template_id}\n                            overwriteManualChanges={overwriteManualChanges}\n                            process_id={upsertProcessResponse?.process_id}\n                            onClose={handleCloseProgress}\n                            mode={isUpdateMode ? 'update' : 'create'}\n                            previewMode={previewMode}\n                            existingPageUpdateAction={existingPageUpdateAction}\n                        />\n                    )}\n                </div>\n            </ModalWrapper>\n            <WarningDialog\n                onboarding={onboarding}\n                isOpen={isWarningOpen}\n                onClose={() => setIsWarningOpen(false)}\n                onConfirm={async () => {\n                    setIsWarningOpen(false)\n                    await initializePageCreation()\n                }}\n                title={isUpdateMode ? \"Confirm \" + pluralPostType + \" Update\" : \"Confirm \" + pluralPostType + \" Creation\"}\n                message={renderWarning()}\n                confirmButtonText={isUpdateMode ? \"Update \" + pluralPostType : \"Create \" + pluralPostType}\n            />\n        </>\n    )\n}\n","import React from 'react';\n\nvar isCheckBoxInput = (element) => element.type === 'checkbox';\n\nvar isDateObject = (value) => value instanceof Date;\n\nvar isNullOrUndefined = (value) => value == null;\n\nconst isObjectType = (value) => typeof value === 'object';\nvar isObject = (value) => !isNullOrUndefined(value) &&\n    !Array.isArray(value) &&\n    isObjectType(value) &&\n    !isDateObject(value);\n\nvar getEventValue = (event) => isObject(event) && event.target\n    ? isCheckBoxInput(event.target)\n        ? event.target.checked\n        : event.target.value\n    : event;\n\nvar getNodeParentName = (name) => name.substring(0, name.search(/\\.\\d+(\\.|$)/)) || name;\n\nvar isNameInFieldArray = (names, name) => names.has(getNodeParentName(name));\n\nvar isPlainObject = (tempObject) => {\n    const prototypeCopy = tempObject.constructor && tempObject.constructor.prototype;\n    return (isObject(prototypeCopy) && prototypeCopy.hasOwnProperty('isPrototypeOf'));\n};\n\nvar isWeb = typeof window !== 'undefined' &&\n    typeof window.HTMLElement !== 'undefined' &&\n    typeof document !== 'undefined';\n\nfunction cloneObject(data) {\n    let copy;\n    const isArray = Array.isArray(data);\n    const isFileListInstance = typeof FileList !== 'undefined' ? data instanceof FileList : fa