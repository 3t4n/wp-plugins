bel>\n>(({ className, ...props }, ref) => (\n  <SelectPrimitive.Label\n    ref={ref}\n    className={cn(\"py-1.5 pl-8 pr-2 text-sm font-semibold\", className)}\n    {...props}\n  />\n))\nSelectLabel.displayName = SelectPrimitive.Label.displayName\n\nconst SelectItem = React.forwardRef<\n  React.ElementRef<typeof SelectPrimitive.Item>,\n  React.ComponentPropsWithoutRef<typeof SelectPrimitive.Item>\n>(({ className, children, ...props }, ref) => (\n  <SelectPrimitive.Item\n    ref={ref}\n    className={cn(\n      \"relative flex w-full cursor-default select-none items-center rounded-sm py-1.5 pl-8 pr-2 text-sm outline-none focus:bg-accent focus:text-accent-foreground data-[disabled]:pointer-events-none data-[disabled]:opacity-50\",\n      className\n    )}\n    {...props}\n  >\n    <span className=\"absolute left-2 flex h-3.5 w-3.5 items-center justify-center\">\n      <SelectPrimitive.ItemIndicator>\n        <Check className=\"h-4 w-4\" />\n      </SelectPrimitive.ItemIndicator>\n    </span>\n\n    <SelectPrimitive.ItemText>{children}</SelectPrimitive.ItemText>\n  </SelectPrimitive.Item>\n))\nSelectItem.displayName = SelectPrimitive.Item.displayName\n\nconst SelectSeparator = React.forwardRef<\n  React.ElementRef<typeof SelectPrimitive.Separator>,\n  React.ComponentPropsWithoutRef<typeof SelectPrimitive.Separator>\n>(({ className, ...props }, ref) => (\n  <SelectPrimitive.Separator\n    ref={ref}\n    className={cn(\"-mx-1 my-1 h-px bg-muted\", className)}\n    {...props}\n  />\n))\nSelectSeparator.displayName = SelectPrimitive.Separator.displayName\n\nexport {\n  Select,\n  SelectGroup,\n  SelectValue,\n  SelectTrigger,\n  SelectContent,\n  SelectLabel,\n  SelectItem,\n  SelectSeparator,\n  SelectScrollUpButton,\n  SelectScrollDownButton,\n}\n","import { ProBadge } from \"@/components/common/ProBadge\";\nimport { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from \"@/components/ui/select\";\nimport { useSubscription } from \"@/hooks/subscription/use-subscription\";\nimport { Field } from \"@headlessui/react\";\n\nexport type ExistingPageUpdateAction = 'create' | 'ignore' | 'update';\n\ninterface ExistingPageUpdateActionSelectorProps {\n    action: ExistingPageUpdateAction;\n    onChange: (action: ExistingPageUpdateAction) => void;\n    pluralPostType: string;\n}\n\nexport function ExistingPageUpdateActionSelector({ action, onChange, pluralPostType }: ExistingPageUpdateActionSelectorProps) {\n    const {extended} = useSubscription();\n    const getActionDescription = (action: ExistingPageUpdateAction) => {\n        switch (action) {\n            case 'create':\n                return `New ${pluralPostType.toLowerCase()} will be created with \"-2\" suffix`;\n            case 'ignore':\n                return `Existing ${pluralPostType.toLowerCase()} will be skipped`;\n            case 'update':\n                return <span className=\"text-red-500\">Existing {pluralPostType.toLowerCase()} will be overwritten with the template design and provided data and integrated into this page set</span>;\n        }\n    };\n\n    return (\n        <div className=\"flex items-center gap-2\">\n            <p className=\"text-sm text-gray-700\">These {pluralPostType.toLowerCase()} will be</p>\n            <Field className=\"inline-block\">\n                <Select value={action} onValueChange={onChange}>\n                    <SelectTrigger data-testid=\"duplicate-slug-action-select\" className=\"min-w-[140px] bg-white text-gray-500\" >\n                        <SelectValue />\n                    </SelectTrigger>\n                    <SelectContent>\n                        <SelectItem value=\"create\" className=\"text-gray-500\" data-testid=\"duplicate-slug-action-select-create\">\n                            Created\n                        </SelectItem>\n                        {extended ? (\n                            <>\n                                <SelectItem value=\"ignore\" className=\"text-gray-500\" data-testid=\"duplicate-slug-action-select-ignore\">\n                                    Ignored\n                                </SelectItem>\n                                <SelectItem value=\"update\" className=\"text-gray-500\" data-testid=\"duplicate-slug-action-select-update\">\n                                    Updated\n                                </SelectItem>\n                            </>\n                        ) : (\n                            <>\n                                <SelectItem value=\"ignore\" className=\"text-gray-500\" disabled>\n                                    <>\n                                        Ignored\n                                        <ProBadge/>\n                                    </>\n                                </SelectItem>\n                                <SelectItem value=\"update\" className=\"text-gray-500\" disabled>\n                                    <>\n                                        Updated\n                                        <ProBadge/>\n                                    </>\n                                </SelectItem>\n                            </>\n                        )}\n                    </SelectContent>\n                </Select>\n            </Field>\n            <p className=\"text-sm text-gray-700\">\n                ({getActionDescription(action)})\n            </p>\n        </div>\n    );\n}","import {ExclamationTriangleIcon} from '@heroicons/react/24/outline';\nimport React, {Fragment, useEffect, useMemo, useState} from 'react';\nimport {Dialog, DialogBackdrop, DialogPanel, DialogTitle, Transition, Field, Select} from '@headlessui/react';\nimport {Button} from '@/components/ui/button';\nimport {DuplicatedSlugs, useCheckBeforeProcessing} from '@/hooks/dashboard/confirm/use-check-before-processing';\nimport {CheckIcon} from 'lucide-react';\nimport {Loader} from \"@/components/common/Loader\";\nimport usePost from \"@/hooks/dashboard/query/use-post\";\nimport {DashboardSettingsType} from \"@/model/dashboard/dashboard-form-model\";\nimport {ExtractResult} from \"@/hooks/generation/extract/use-extract-data\";\nimport {findBestTitlePlaceholder} from \"@/lib/find-best-title-placeholder\";\nimport {useSubscription} from \"@/hooks/subscription/use-subscription\";\nimport {\n    DuplicateWarningEnableParentIdentifierArea\n} from \"@/components/dashboard/save/confirm/components/DuplicateWarningEnableParentIdentifierArea\";\nimport { ExistingPageUpdateAction, ExistingPageUpdateActionSelector } from './ExistingPageUpdateActionSelector';\n\n\ninterface DuplicateWarningProps {\n    onCreatePages: () => void;\n    mode: 'create' | 'update';\n    config?: DashboardSettingsType;\n    setExtractResultLoading: (loading: boolean) => void;\n    setCheckingTimeoutedCallback: (timeouted: boolean) => void;\n    extractResult: ExtractResult;\n    process_id?: number;\n    template_id?: number;\n    existingPageUpdateAction: ExistingPageUpdateAction;\n    setExistingPageUpdateAction: (action: ExistingPageUpdateAction) => void;\n    includeParentAsIdentifier: boolean;\n    onIncludeParentAsIdentifierChange?: (value: boolean) => void;\n}\n\n\nexport function DuplicateWarning({\n                                     onCreatePages,\n                                     mode,\n                                     config,\n                                     extractResult,\n                                     process_id,\n                                     template_id,\n                                     setExtractResultLoading,\n                                     setCheckingTimeoutedCallback,\n                                     existingPageUpdateAction,\n                                     setExistingPageUpdateAction,\n                                     includeParentAsIdentifier,\n                                     onIncludeParentAsIdentifierChange\n\n                                 }: DuplicateWarningProps) {\n    const [isOpen, setOpen] = useState(false);\n    const [checkingTimeouted, setCheckingTimeouted] = useState(false);\n    const maxDisplaySlugs = 20;\n    const {data: templatePostData} = usePost(template_id || config?.template || 0);\n    const singularPostType = templatePostData?.type?.singular ?? 'Page';\n    const pluralPostType = templatePostData?.type?.plural ?? 'Pages';\n    const postTypeHierarchical = templatePostData?.type?.hierarchical;\n    const {extended} = useSubscription()\n\n\n    useEffect(() => {\n        setCheckingTimeoutedCallback(checkingTimeouted)\n    }, [checkingTimeouted]);\n    \n    const checkResponse = useCheckBeforeProcessing({\n        mode,\n        config,\n        data: extractResult,\n        process_id,\n        template_id,includeParentAsIdentifier\n    });\n\n    const confirmationMessages = useMemo(() => {\n        if (!checkResponse.data) return [];\n\n        const data = checkResponse.data as DuplicatedSlugs;\n        const messages: {\n            message: React.ReactNode\n            slugs?: Array<{\n                value: string,\n                permalink?: string\n            }>;\n        }[] = [];\n\n        const addConfirmationMessage = (message: React.ReactNode, slugs?: Array<{value: string, permalink?: string}>) => {\n            messages.push({\n                message: <div className=\"text-sm text-yellow-700\">{message}</div>,\n                slugs\n            });\n        };\n\n        const firstPlaceholder = findBestTitlePlaceholder(extractResult);\n        if (!data.title_contains_placeholder) {\n            addConfirmationMessage(\n                <>\n                    It seems like no placeholder from the input sheet is included in the title of the template {singularPostType.toLowerCase()} (<HighlightedText>{templatePostData?.title}</HighlightedText> - <a href={templatePostData?.permalink} target=\"_blank\" className=\"text-blue-500 hover:text-blue-700\">Edit {singularPostType}</a>).\n                    Please add at least one placeholder like  <HighlightedText>{`{${firstPlaceholder}}`}</HighlightedText> to the title generate {pluralPostType.toLowerCase()} with different titles.\n                </>\n            );\n        }\n\n        if (!data.slug_contains_placeholder) {\n            addConfirmationMessage(\n                <>\n                    It seems like no placeholder from the input sheet is included in the configured slug (<HighlightedText>{config?.slug}</HighlightedText>).\n                    Please add at least one placeholder like <HighlightedText>{`{${firstPlaceholder}}`}</HighlightedText> to the slug to generate {pluralPostType.toLowerCase()} with different slugs.\n                </>\n            );\n        }\n\n        if (data.missing_placeholders && data.missing_placeholders.length > 0) {\n            addConfirmationMessage(\n                <>\n                    The following placeholders in the configured slug (<HighlightedText>{config?.slug}</HighlightedText>) are not present in your data: {' '}\n                    {data.missing_placeholders.map((placeholder, index) => (\n                        <span key={index}>\n                            <HighlightedText>{`{${placeholder}}`}</HighlightedText>\n                            {index < data.missing_placeholders!.length - 1 ? ', ' : ''}\n                        </span>\n                    ))}\n                    . Please add these columns to your data or remove them from the slug.\n                </>\n            );\n        }\n\n        if (data.duplicates && data.duplicates.length > 0) {\n            const slugs = data.duplicates.map(\n                (duplicate) => `${duplicate.value} at rows ${duplicate.rows.join(', ')}`\n            );\n            addConfirmationMessage(\n                `Duplicate ${pluralPostType.toLowerCase()} ${(extended && postTypeHierarchical) ? 'with identical slugs and parent ' + pluralPostType.toLowerCase() : 'with identical slugs'} have been detected in the current file. Each ${singularPostType.toLowerCase()} must have a unique slug${(extended && postTypeHierarchical) ? ' within its parent context' : ''}. When duplicates are found, only one instance will be processed and others will be skipped.`,\n                slugs.map(slug => ({ value: slug }))\n            );\n        }\n\n        if (data.numeric_slugs && data.numeric_slugs.length > 0) {\n            const slugs = data.numeric_slugs.map(\n                (duplicate) => `${duplicate.value} at row ${duplicate.row}`\n            );\n            addConfirmationMessage(\n                <>\n                    Numeric slugs detected in the current file. WordPress will automatically attach a number to the slug. For example, <HighlightedText>1234</HighlightedText> becomes <HighlightedText>1234-2</HighlightedText>.\n                </>,\n                slugs.map(slug => ({ value: slug }))\n            );\n        }\n\n        const existing_slugs_in_other_set = data.existing_slugs?.filter((slug) => slug.exists_in_other_set);\n        const existing_slugs_not_managed_by_lpagery = data.existing_slugs?.filter((slug) => !slug.exists_in_other_set);\n\n        if (existing_slugs_not_managed_by_lpagery && existing_slugs_not_managed_by_lpagery.length > 0) {\n            const slugs =existing_slugs_not_managed_by_lpagery.map((slug) => ({\n                value: slug.post_name,\n                permalink: slug.permalink\n            }));\n            addConfirmationMessage(\n                <>\n                    <div className=\"space-y-3\">\n                       Duplicate {pluralPostType.toLowerCase()} detected{(postTypeHierarchical) ? ' with matching parent and slug' : ' with matching slug'} in the WordPress instance.\n                        <ExistingPageUpdateActionSelector\n                            action={existingPageUpdateAction}\n                            onChange={setExistingPageUpdateAction}\n                            pluralPostType={pluralPostType}\n                        />\n                    </div>\n                </>,\n                slugs.map(slug => ({ value: slug.value, permalink: slug.permalink }))\n            );\n        }\n\n        if (existing_slugs_in_other_set && existing_slugs_in_other_set.length > 0) {\n            const slugs = existing_slugs_in_other_set.map((slug) => ({\n                value: slug.post_name,\n                permalink: slug.permalink\n            }));\n            addConfirmationMessage(\n                <p>Duplicate {pluralPostType.toLowerCase()} detected{(postTypeHierarchical) ? ' with matching parent and slug' : ' with matching slug'} in other LPagery page set. New {pluralPostType.toLowerCase()} will be created with \"-2\" suffix</p>,\n                slugs\n            );\n        }\n\n        if (data.attachment_slug_equals && data.attachment_slug_equals.length > 0) {\n            const slugs = data.attachment_slug_equals.map((slug) => ({\n                value: slug.post_name,\n                permalink: slug.permalink\n            }));\n            addConfirmationMessage(\n                `Existing Attachments with the same slug detected. Continuing will cause WordPress to add numbers to the URLs. We recommend removing the existing ${pluralPostType.toLowerCase()} or changing the slugs of the new ${pluralPostType.toLowerCase()}.`,\n                slugs\n            );\n        }\n\n        if (data.exception) {\n            addConfirmationMessage(data.exception);\n        }\n\n        return messages;\n    }, [checkResponse.data, config?.slug, templatePostData?.title, templatePostData?.permalink, existingPageUpdateAction, setExistingPageUpdateAction]);\n\n    useEffect(() => {\n        setExtractResultLoading(checkResponse.isLoading);\n        \n        const timer = setTimeout(() => {\n            if (checkResponse.isLoading) {\n                setCheckingTimeouted(true);\n            }\n        }, 10000);\n\n        return () => clearTimeout(timer);\n    }, [checkResponse.isLoading]);\n\n    if (checkResponse.isLoading || !checkResponse.data) {\n        return (\n            <div className=\"flex flex-col items-center justify-center h-32\">\n                <div className=\"flex items-center\">\n                    <Loader/>\n                    <span className=\"ml-2 text-gray-700\">Performing checks for potential duplicated slugs...</span>\n                </div>\n                {checkingTimeouted && (\n                    <div className=\"mt-4 text-center\">\n                        <p className=\"text-sm text-gray-600 mb-2\">We are still checking for potential duplicated slugs. This can take some time depending on the size of your website and source file. You can proceed anyway if you are sure that the slugs are unique.</p>\n\n                    </div>\n                )}\n            </div>\n        );\n    }\n\n    if (confirmationMessages.length === 0) {\n        // Show parent identifier warning if needed\n        if (checkResponse.data?.found_duplicated_slugs_with_different_parents && !includeParentAsIdentifier && extended) {\n            return (\n                <div className=\"space-y-4\">\n                    <DuplicateWarningEnableParentIdentifierArea pluralPostType={pluralPostType} onIncludeParentAsIdentifierChange={onIncludeParentAsIdentifierChange}/>\n                </div>\n            );\n        }\n        return <div className=\"rounded-md bg-green-50 p-4 mt-4\">\n            <div className=\"flex\">\n                <div className=\"flex-shrink-0\">\n                    <CheckIcon\n                        className=\"h-5 w-5 text-green-400\"\n                        aria-hidden=\"true\"\n                    />\n                </div>\n                <div className=\"ml-3\">\n                    <h3 className=\"text-sm font-medium text-green-800\">\n                        No Issues Detected\n                    </h3>\n                    <p className=\"mt-2 text-sm text-green-700\">All checks passed successfully.</p>\n                </div>\n            </div>\n        </div>\n    }\n\n    return (\n        <div className=\"space-y-4\">\n            {checkResponse.data?.found_duplicated_slugs_with_different_parents && !includeParentAsIdentifier && extended && (\n                <DuplicateWarningEnableParentIdentifierArea pluralPostType={pluralPostType} onIncludeParentAsIdentifierChange={onIncludeParentAsIdentifierChange}/>\n            )}\n            <div className=\"rounded-md bg-yellow-50 p-4\">\n                <div className=\"flex\">\n                    <div className=\"flex-shrink-0\">\n                        <ExclamationTriangleIcon\n                            className=\"h-5 w-5 text-yellow-400\"\n                            aria-hidden=\"true\"\n                        />\n                    </div>\n                    <div className=\"ml-3\">\n                        <h3 className=\"text-sm font-medium text-yellow-800\">\n                            Issues Detected\n                        </h3>\n                        <div className=\"mt-2 space-y-4\">\n                            {confirmationMessages.map((item, idx) => (\n                                <div key={idx} className=\"text-sm text-yellow-700\">\n                                    {item.message}\n                                    {item.slugs && item.slugs.length > 0 && (\n                                        <div className=\"mt-2\">\n                                            {item.slugs.slice(0, maxDisplaySlugs).map((slug, index) => (\n                                                <span\n                                                    key={index}\n                                                    className=\"inline-flex items-center rounded-full bg-yellow-100 px-2.5 py-0.5 text-xs font-medium text-yellow-800 mx-1 my-1\"\n                                                >\n                                                    {slug.permalink ? (\n                                       