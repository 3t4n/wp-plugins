ction)return e=\"AbortError\",t=n.file,i=n.inputElem,r=s.reason,void(U(o.error)&&o.error({name:e},t,i,r));if(\"skip\"===s.action)return void u();\"object\"==typeof s.config&&(n.instanceConfig=d.extend(n.instanceConfig,s.config))}else if(\"skip\"===s)return void u()}var a=n.instanceConfig.complete;n.instanceConfig.complete=function(e){U(a)&&a(e,n.file,n.inputElem),u()},v.parse(n.file,n.instanceConfig)}}function u(){h.splice(0,1),e()}}),a&&(n.onmessage=function(e){e=e.data;void 0===v.WORKER_ID&&e&&(v.WORKER_ID=e.workerId);\"string\"==typeof e.input?n.postMessage({workerId:v.WORKER_ID,results:v.parse(e.input,e.config),finished:!0}):(n.File&&e.input instanceof File||e.input instanceof Object)&&(e=v.parse(e.input,e.config))&&n.postMessage({workerId:v.WORKER_ID,results:e,finished:!0})}),(f.prototype=Object.create(u.prototype)).constructor=f,(l.prototype=Object.create(u.prototype)).constructor=l,(c.prototype=Object.create(c.prototype)).constructor=c,(p.prototype=Object.create(u.prototype)).constructor=p,v});","\nexport const getConfigHeaders = () => {\n\n        return [\n            {name: \"lpagery_parent\", label : \"Parent\"},\n            {name: \"lpagery_status\", label : \"Status\"},\n            {name: \"lpagery_publish_date\", label : \"Publish Date\"},\n            {name: \"lpagery_template\", label : \"Template\"},\n        ]\n\n}\n\n","export const getTaxonomyNameByHeader = (header: string): string => {\n    const taxonomy = header.replace(\"lpagery_taxonomy_\", \"\");\n    if(header === 'lpagery_categories') {\n        return 'category';\n    }\n    if(header === 'lpagery_tags') {\n        return 'post_tag';\n    }\n    return taxonomy;\n}","import {DashboardSettingsType} from \"@/model/dashboard/dashboard-form-model\";\nimport {getConfigHeaders} from \"@/hooks/dashboard/confirm/functional-columns/common/get-config-headers\";\nimport {PostStatus, PostStatusSchema} from \"@/types/post-status\";\nimport {z} from \"zod\";\nimport {getTaxonomyNameByHeader} from \"@/hooks/generation/get-taxonomy-name-by-header\";\nimport {FetchTaxonomiesResponseItem} from \"@/hooks/dashboard/query/use-taxonomies\";\n\nexport const ExtractResultConfigDataSchema = z.object({\n    template: z.string().optional(),\n    parent: z.string().optional(),\n    slug: z.string().optional(),\n    taxonomy_terms: z.record(z.array(z.string()).optional()).optional(),\n    status: PostStatusSchema.optional(),\n    date: z.string().optional(),\n});\n\nexport type ExtractResultConfigData = z.infer<typeof ExtractResultConfigDataSchema>;\nexport const getConfigData = (settings: DashboardSettingsType, data?: Record<string, string>, taxonomies?: FetchTaxonomiesResponseItem[]): ExtractResultConfigData => {\n    const config_headers = getConfigHeaders();\n    let parent = settings.parent ? String(settings.parent) : '';\n    let template = settings.template ? String(settings.template) : '';\n    const taxonomy_terms = settings.taxonomy_terms\n        ? Object.fromEntries(\n            Object.entries(settings.taxonomy_terms).map(([key, values]) => [\n                key,\n                (values ?? []).map(String),\n            ])\n        )\n        : {};\n    let status: PostStatus | undefined = settings.status ? settings.status : undefined;\n    let date = settings.date ? settings.date.toISOString() : '';\n\n\n    if (!taxonomy_terms[\"category\"]) {\n        taxonomy_terms[\"category\"] = [];\n    }\n\n    if (!taxonomy_terms[\"post_tag\"]) {\n        taxonomy_terms[\"post_tag\"] = [];\n    }\n\n    if (data) {\n        config_headers.forEach(header => {\n            const key = header.name;\n            if (data[key]) {\n                switch (key) {\n                    case \"lpagery_parent\":\n                        parent = data[key];\n                        break;\n                    case \"lpagery_template\":\n                        template = data[key];\n                        break;\n                    case \"lpagery_status\":\n                        if (data[key] === 'published') {\n                            status = 'publish';\n                        } else {\n                            status = PostStatusSchema.safeParse(data[key]).success ? (data[key] as PostStatus) : status;\n                        }\n                        break;\n                    case \"lpagery_publish_date\":\n                        date = data[key];\n                        break;\n                }\n            }\n        });\n\n        Object.keys(data).forEach(key => {\n            const taxonomyNameByHeader = getTaxonomyNameByHeader(key);\n            const foundTaxonomy = taxonomies?.find(taxonomy => taxonomy.name === taxonomyNameByHeader);\n            if (!foundTaxonomy) {\n                return;\n            }\n            if (!taxonomy_terms[foundTaxonomy.name]) {\n                taxonomy_terms[foundTaxonomy.name] = [];\n            }\n            taxonomy_terms[foundTaxonomy.name]?.push(...data[key].split(\"|\"));\n        })\n    }\n\n\n    const result: ExtractResultConfigData = ExtractResultConfigDataSchema.parse({\n        template: template,\n        parent: parent,\n        slug: settings.slug,\n        taxonomy_terms: taxonomy_terms,\n        status: status,\n        date: date\n    });\n    return result;\n}\n","import useWordpressAjax from \"@/hooks/fetch/use-wordpress-ajax-fetch\";\nimport {z} from \"zod\";\nimport {useQuery} from \"@tanstack/react-query\";\nimport {useSubscription} from \"@/hooks/subscription/use-subscription\";\n\n\nexport const FetchTaxonomiesResponseItemSchema = z.object({\n    name: z.string(),\n    label: z.string()\n});\n\nexport const FetchTaxonomiesResponseSchema = z.array(FetchTaxonomiesResponseItemSchema);\n\nexport type FetchTaxonomiesResponseItem = z.infer<typeof FetchTaxonomiesResponseItemSchema>;\n\nconst useTaxonomies = () => {\n    const {extended} = useSubscription()\n    const fetcher = useWordpressAjax<FetchTaxonomiesResponseItem[], {}>(\n        \"lpagery_get_taxonomies\", \n        FetchTaxonomiesResponseSchema,\n        \"Fetching taxonomies failed\"\n    );\n\n    return useQuery({\n        queryKey: [`taxonomies`],\n        staleTime: 1000 * 60,\n        enabled: extended,\n        queryFn: () => fetcher({body: {}})\n    })\n}\nexport default useTaxonomies;\n","import useWordpressAjax from \"@/hooks/fetch/use-wordpress-ajax-fetch\";\nimport {useQuery, UseQueryResult} from \"@tanstack/react-query\";\nimport {z} from \"zod\";\nimport {NumberParser, StringToDateType} from \"@/lib/zod-utils\";\nimport {PostStatusSchema} from \"@/types/post-status\";\n\n// Define the raw taxonomy structure as received from the server\n\nconst UpdatedBySchema = z.object({\n    name : z.string(),\n    email: z.string()\n})\n\n\nexport const PageToBeUpdatedSchema = z.object({\n    id: NumberParser,\n    title: z.string(),\n    process_id: NumberParser.optional(),\n    parent: NumberParser,\n    status: PostStatusSchema,\n    template: NumberParser,\n    slug: z.string(),\n    permalink: z.string().url().optional(),\n    language_code: z.string().optional(),\n    parent_search_term: z.string().nullish(),\n    page_manually_updated_at: StringToDateType.optional().nullable(),\n    page_manually_updated_by: UpdatedBySchema.optional()\n});\n\n// Define the schema for the transformed taxonomy structure\n\n\n// Define an array schema for pages\nconst PagesToBeUpdatedSchema = z.array(PageToBeUpdatedSchema);\n\n\nexport type PagesToBeUpdated = z.infer<typeof PagesToBeUpdatedSchema>;\nexport type PageToBeUpdated = z.infer<typeof PageToBeUpdatedSchema>;\n\nexport const usePagesToBeUpdatedForUpdateModal = (\n    template_id?: number,\n    process_id?: number\n): UseQueryResult<PagesToBeUpdated> => {\n    const fetcher = useWordpressAjax<typeof PagesToBeUpdatedSchema._type, { template_id: number; process_id?: number }>(\n        \"lpagery_get_existing_posts_for_update_modal\",\n        PagesToBeUpdatedSchema,\n        \"Fetch Existing Pages failed\"\n    );\n    \n    return useQuery({\n        queryKey: [ `pages-to-be-updated`, template_id, process_id],\n        enabled: !!template_id,\n        staleTime: Infinity,\n        refetchOnWindowFocus: false,\n        queryFn: async () => {\n            const response = await fetcher({ body: { template_id: template_id!!, process_id } });\n            return PagesToBeUpdatedSchema.parse(response.map(page => ({\n                ...page,\n                slug: decodeURIComponent(page.slug)\n            })));\n        },\n    });\n};\n","\nexport const getFunctionalHeaders = () => {\n\n        return [\n            {name: \"lpagery_author\", label : \"Author\"},\n            {name: \"lpagery_content\", label : \"Content\"},\n            {name: \"lpagery_ignore\", label : \"Ignore\"},\n            {name: \"page_to_be_updated\", label : \"Page To Be Updated\"},\n        ]\n\n}\n\n","import {Subscription} from \"@/hooks/subscription/use-subscription\";\nimport {FetchTaxonomiesResponseItem} from \"@/hooks/dashboard/query/use-taxonomies\";\nimport {getFunctionalHeaders} from \"@/hooks/dashboard/confirm/functional-columns/common/get-functional-headers\";\nimport {getConfigHeaders} from \"@/hooks/dashboard/confirm/functional-columns/common/get-config-headers\";\nimport {getTaxonomyNameByHeader} from \"@/hooks/generation/get-taxonomy-name-by-header\";\nimport {Header, HeaderSchema} from \"@/hooks/generation/extract/use-extract-data\";\n\nexport const buildHeaders = (headers: string[], sub: Subscription, taxonomies?: FetchTaxonomiesResponseItem[]): Header[] => {\n    const result: Header[] = [];\n    const funcHeaders = getFunctionalHeaders();\n    const configHeaders = getConfigHeaders();\n    result.push(HeaderSchema.parse({name: 'generated_slug', label: 'Generated Slug', type: 'slug', licenseNeeded: false}));\n\n    headers.forEach((header, index) => {\n            const foundFuncHeader = funcHeaders.find((funcHeader) => funcHeader.name === header);\n            const foundConfigHeader = configHeaders.find((configHeader) => configHeader.name === header);\n\n            const maxColumnsExceeded = !!sub.allowed_placeholders && sub.allowed_placeholders < index + 1;\n            const is_taxonomy_header = header.startsWith('lpagery_taxonomy') || header === 'lpagery_categories' || header === 'lpagery_tags';\n            if (foundConfigHeader) {\n                result.push(HeaderSchema.parse({\n                    name: header,\n                    label: foundConfigHeader.label,\n                    type: 'config',\n                    licenseNeeded: !sub.extended\n                }));\n            } else if (foundFuncHeader) {\n                result.push(HeaderSchema.parse({\n                    name: header,\n                    label: foundFuncHeader.label,\n                    type: 'functional',\n                    licenseNeeded: !sub.extended\n                }));\n            } else if (isImageColumn(header)) {\n                result.push(HeaderSchema.parse({name: header, label: header, type: 'image', licenseNeeded: !sub.extended}));\n            } else if (is_taxonomy_header) {\n                const taxonomyNameByHeader = getTaxonomyNameByHeader(header);\n                const taxonomy = taxonomies?.find(taxonomy => taxonomy.name === taxonomyNameByHeader);\n                if (taxonomy) {\n                    result.push(HeaderSchema.parse({\n                        name: taxonomy.name,\n                        label: taxonomy.label,\n                        type: 'taxonomy',\n                        licenseNeeded: !sub.extended\n                    }));\n                }\n            } else {\n                result.push(HeaderSchema.parse({\n                    name: header,\n                    label: header,\n                    type: 'data',\n                    licenseNeeded: maxColumnsExceeded\n                }));\n            }\n        }\n    );\n\n    return result.sort((a, b) => {\n        const order = {\n            page_to_be_updated: 0,\n            modified: 1,\n            data: 2,\n            image: 2,\n            config: 4,\n            config_changed:5,\n            functional: 6,\n            taxonomy: 7,\n            slug: 8,\n        };\n        return order[a.type] - order[b.type];\n    });\n}\n\n\nconst isImageColumn = (header: string) => {\n    return ['.png', '.jpg', '.jpeg', '.heic', '.gif', '.svg', '.webp'].some(ending => header.endsWith(ending))\n}","import {RadiusFormValues} from \"@/model/dashboard/dashboard-form-model\";\n\nexport function getCityUrlParams(input: RadiusFormValues, nonce: string, action: string) {\n    const params = new URLSearchParams();\n    if (input.location.lat !== undefined) {\n        params.append('latitude', input.location.lat.toString());\n    }\n    if (input.location.lon !== undefined) {\n        params.append('longitude', input.location.lon.toString());\n    }\n    if (input.kilometers !== undefined && !isNaN(input.kilometers)) {\n        params.append('radius', input.kilometers.toString());\n    }\n    if (input.population !== undefined && !isNaN(input.population)) {\n        params.append('min_population', input.population.toString());\n    }\n    if (input.amount !== undefined && !isNaN(input.amount)) {\n        params.append('max_results', input.amount.toString());\n    }\n\n    params.append('_ajax_nonce', nonce);\n    params.append('action', action);\n    return params;\n}\n","import {useCallback, useState} from \"react\";\nimport {\n    DashboardFormType,\n    DashboardSettingsType,\n    InputFormValues,\n    RadiusFormValues\n} from \"@/model/dashboard/dashboard-form-model\";\nimport readXlsxFile from \"read-excel-file\";\nimport Papa from 'papaparse';\nimport {useNonce} from \"@/hooks/fetch/use-nonce\";\nimport {z} from \"zod\";\nimport {replaceValues} from \"@/hooks/generation/replace/replace-values\";\nimport {sanitizeTitle} from \"@/hooks/generation//replace/sanitize-title\";\nimport {ExtractResultConfigDataSchema, getConfigData} from \"@/hooks/generation/get-config-data\";\nimport useTaxonomies, {FetchTaxonomiesResponseItem} from \"@/hooks/dashboard/query/use-taxonomies\";\nimport {PageToBeUpdatedSchema} from \"@/hooks/dashboard/update/use-pages-to-be-updated-for-update-modal\";\nimport {Subscription, useSubscription} from \"@/hooks/subscription/use-subscription\";\nimport {buildHeaders} from \"@/hooks/generation/build-headers\";\nimport {getAjaxUrl} from \"@/lib/get-ajax-url\";\nimport {getCityUrlParams} from \"@/hooks/generation/get-city-params\";\nimport {toast} from \"sonner\";\n\ntype CellValue = string | number | Date | null;\n\nconst PlaceholderDataSchema = z.record(z.string().optional().nullable());\nexport type PlaceholderData = z.infer<typeof PlaceholderDataSchema>;\n\n\nexport const ExtractResultDataEntrySchema = z.object({\n    placeholder_data: PlaceholderDataSchema,\n    config_data: ExtractResultConfigDataSchema.optional(),\n    // previous_config: ExtractResultConfigDataSchema.optional(),\n    slug: z.string().optional(),\n    row_id: z.number(),\n    page_to_be_updated: PageToBeUpdatedSchema.optional(),\n}).refine((obj) => obj.placeholder_data !== undefined || obj.page_to_be_updated !== undefined, {\n    message: \"At least one of 'data' or 'page_id_to_be_updated' must be set\",\n});\n\nexport type ExtractResultDataEntry = z.infer<typeof ExtractResultDataEntrySchema>;\n\nexport const HeaderSchema = z.object({\n    name: z.string().min(1),\n    label: z.string().optional(),\n    licenseNeeded: z.boolean(),\n    type: z.enum(['functional', 'config', 'data', 'image', 'page_to_be_updated', 'config_changed', 'taxonomy', 'modified', 'slug']),\n})\n\nexport type Header = z.infer<typeof HeaderSchema>;\n\nexport const ExtractResultSchema = z.object({\n    headers: z.array(HeaderSchema), // Ensures all headers are non-empty strings\n    data: z.array(ExtractResultDataEntrySchema), // Ensures all data rows are objects\n    manuallyUpdated: z.number().optional(),\n});\nexport type ExtractResult = z.infer<typeof ExtractResultSchema>;\n\nexport type FormDataWithExtractResult = { extractResult: ExtractResult, formData: DashboardFormType };\n\nconst RadiusResponseItemSchema = z.object({\n    name: z.string().optional().nullable(),\n    population: z.number().optional().nullable(),\n    distance: z.string().optional().nullable(),\n    latitude: z.number().optional().nullable(),\n    longitude: z.number().optional().nullable(),\n});\n\nconst RadiusResponseSchema = z.object({\n    cities: z.array(RadiusResponseItemSchema),\n});\ntype ExtractRawResult = { data: any[]; headers: string[] };\nconst cleanupHeader = (header: string) => {\n    return header.toLowerCase().replace(\"{\", \"\").replace(\"}\", \"\").replace(/(\\r\\n|\\n|\\r)/gm, \"\").trim();\n}\nconst cleanupData = (data: any[]): any[] => {\n    return data.map((row) => {\n        return Object.fromEntries(Object.entries(row).map(([key, value]) => {\n            return [cleanupHeader(key), value];\n        }));\n    });\n\n}\n\nconst extractFromSheet = async (input: InputFormValues, nonce: string): Promise<ExtractRawResult> => {\n    if (input.source !== 'sheet') {\n        throw new Error('Invalid input source for sheet extraction');\n    }\n    const params = new URLSearchParams({\n        doc_url: encodeURIComponent(input.sheet.url),\n        action: \"lpagery_get_google_doc\",\n        _ajax_nonce: nonce,\n    });\n\n    const response = await fetch(getAjaxUrl() + \"?\" + params.toString());\n    const data = await response.json();\n    const downloadUrl = data?.downloadUrl;\n    const sheetResponse = await fetch(downloadUrl);\n    const sheetJson = await sheetResponse.json();\n    const headers = sheetJson.headers;\n\n    return {data: (sheetJson.data), headers};\n};\n\n\nconst extractFromRadius = async (input: RadiusFormValues, nonce: string): Promise<ExtractRawResult> => {\n\n    const params = getCityUrlParams(input, nonce, \"lpagery_get_cities\");\n\n    const response = await fetch(\"admin-ajax.php?\" + params.toString());\n    const body = await response.json();\n\n    const data = RadiusResponseSchema.parse(body);\n    const result = Array.from(new Map(data.cities.filter(value => {\n        return value.latitude !== null && value.longitude !== null && value.population !== null && value.name !== null && value.distance !== null;\n    }).map((value) => {\n        return [value.name, {\n            city: value.name,\n            population: value.population,\n            distance: value.distance,\n            latitude: value.latitude,\n            longitude: value.longitude,\n        }];\n    })).values()).sort((a, b) => (b.population || 0) - (a.population || 0));\n    const headers = Object.keys(result[0]);\n    return {data: result, headers};\n};\n\nconst extractFromFile = async (file: File): Promise<ExtractRawResult> => {\n    if (file.name.endsWith(\".csv\")) {\n        return new Promise((resolve, reject) => {\n            Papa.parse(file, {\n                header: true,\n                dynamicTyping: false,\n                complete: function (results) {\n                    const headers = results.meta.fields || [];\n                    resolve({data: results.data, headers});\n                },\n                error: function (err: Error) {\n                    reject(err);\n                }\n            });\n        });\n    } else if (file.name.endsWith(\".xlsx\")) {\n        const rows = await readXlsxFile(file) as CellValue[][];\n        const headers = rows.length > 0 ? rows[0].map(cell => String(cell)) : [];\n\n        // Transform the rows into an array of objects\n        const data = rows.slice(1).map(row => {\n            const rowObject: Record<string, any> = {};\n            headers.forEach((header, index) => {\n                rowObject[header] = row[index] ?? null;\n            });\n            return rowObject;\n        });\n        return {data, headers};\n    }\n    return {data: [], headers: []};\n};\n\n\nexport const useExtractData = (settings?: DashboardSettingsType): {\n    loading: boolean,\n    extractData: (input: InputFormValues, slug: string) => Promise<ExtractResult>,\n} => {\n    const [loading, setLoading] = useState<boolean>(false);\n    const {data: taxonomiesData} = useTaxonomies();\n    const nonce = useNonce();\n    const sub = useSubscription()\n\n    const extractData = useCallback(async (input: InputFormValues, slug: string): Promise<ExtractResult> => {\n        setLoading(true);\n\n        try {\n            let result: ExtractRawResult = {data: [], headers: []};\n            if (input.source === 'file' && input.file) {\n                result = await extractFromFile(input.file);\n            } else if (input.source === 'radius') {\n                result = await extractFromRadius(input.radius, nonce);\n            } else if (input.source === 'sheet') {\n                result = await extractFromSheet(input, nonce);\n            }\n            return transform(cleanupData(result.data), slug, sub, result.headers.map(cleanupHeader), taxonomiesData, settings,);\n        } catch (e: any) {\n            if(e.message.includes(\"Duplicate headers\")){\n                toast.error(e.message);\n                throw e;\n            } else {\n                toast.error(\"Failed to extract data. Please try another file or another method. \" + e.message);\n                throw e;\n            }\n        } finally {\n            setLoading(false);\n        }\n    }, [settings, taxonomiesData]);\n\n    return {loading, extractData};\n};\n\n\nfunction transform(\n    rows: (CellValue[] | Record<string, CellValue>)[],\n    slug: string,\n    sub: Subscription,\n    headers: string[],\n    taxonomies?: FetchTaxonomiesResponseItem[],\n    settings?: DashboardSettingsType,\n): ExtractResult {\n    const finalHeaders: string[] = [];\n    headers.forEach((header) => {\n        if (header !== null && header !== undefined && String(header).trim() !== '') {\n            finalHeaders.push(cleanupHeader(header));\n        }\n    });\n\n    const duplicateHeaders = finalHeaders.filter((header, index) => finalHeaders.indexOf(header) !== index);\n\n    if (duplicateHeaders.length > 0) {\n        throw new Error(`Duplicate headers found in the input sheet. Make sure to only include unique headers in your sheet: ${duplicateHeaders.join(', ')}`);\n    }\n\n    // Map data rows to objects with string values\n    const dataEntries: ExtractResultDataEntry[] = rows.map(\n        (row: CellValue[] | Record<string, CellValue>, index: number) => {\n            const record: Record<string, string> = {};\n            finalHeaders.forEach((headerName: string) => {\n                let value: CellValue;\n\n                if (Array.isArray(row)) {\n                    const colIndex = finalHeaders.indexOf(headerName);\n                    value = row[colIndex];\n                } else {\n                    value = (row as Record<string, CellValue>)[headerName];\n                }\n                value = (value === null || value === undefined) ? '' : String(value).trim();\n                const filtered_key = headerName.replace(/(\\r\\n|\\n|\\r)/gm, \"\").trim()\n                record[filtered_key] = value\n            });\n\n\n            const recordIsEmpty = Object.values(record).every(value => value === '');\n            if (recordIsEmpty) {\n                return undefined;\n            }\n\n            const replaced = replaceValues(slug, record, finalHeaders, true);\n            const sanitized = sanitizeTitle(replaced);\n\n            let configData = undefined;\n            if (settings) {\n\n                configData = getConfigData(settings, record, taxonomies);\n            }\n\n\n            return ExtractResultDataEntrySchema.parse({\n                placeholder_data: record,\n                slug: sanitized,\n                row_id: index + 1,\n                config_data: configData,\n            });\n        }\n    ).filter((entry) => entry !== undefined) as ExtractResultDataEntry[];\n\n    // Return the result matching ExtractResultSchema\n    return ExtractResultSchema.parse({\n        headers: buildHeaders(finalHeaders, sub, taxonomies),\n        data: dataEntries,\n    });\n}\n\n\n","// src/hooks/useDashboardForm.ts\n\nimport {SubmitHandler, useFormContext} from \"react-hook-form\";\nimport {useEffect, useRef, useState} from \"react\";\nimport {DashboardCreateSchema, DashboardUpdateSchema} from \"@/model/dashboard/dashboard-form-model\";\nimport {ExtractResult, useExtractData} from \"@/hooks/generation/extract/use-extract-data\";\nimport {z} from \"zod\";\nimport { toast } from \"sonner\";\n\nexport const useDashboardForm = (mode: 'update' | 'create') => {\n\n    // Use the appropriate schema based on the mode\n    const formSchema = mode === 'update' ? DashboardUpdateSchema : DashboardCreateSchema;\n\n    // Use the appropriate type based on the mode\n    type FormDataType = z.infer<typeof formSchema>;\n\n    // Initialize the form with the correct resolver and default values\n    const methods = useFormContext<FormDataType>();\n\n    const {setValue, watch, getValues} = methods;\n\n    const templateWatch = watch('config.template');\n\n    const inputTypeWatch = watch('input.source');\n    const [extractResult, setExtractResult] = useState<ExtractResult>();\n    const [submitted, setSubmitted] = useState(false);\n    const sync_intialized = useRef(false);\n\n    useEffect(() => {\n        if (mode === \"create\") {\n            setValue('config.parent', 0);\n        }\n    }, [templateWatch, mode]);\n\n    useEffect(() => {\n        if(inputTypeWatch === 'sheet' && !sync_intialized.current && mode ===\"create\") {\n            setValue('input.sheet.sync_settings.add', true);\n            setValue('input.sheet.sync_settings.delete', true);\n            setValue('input.sheet.sync_settings.update', true);\n            sync_intialized.current = true;\n        }\n\n    }, [setValue, inputTypeWatch, mode]);\n\n\n    const {extractData, loading : saveLoading} = useExtractData(getValues('config'));\n\n    const onSubmit: SubmitHandler<FormDataType> = async (data) => {\n        if (data.input && data.config) {\n            const extractedResult = await extractData(data.input, data.config.slug);\n\n            if(extractedResult.data.length === 0) {\n                toast.error('No data extracted from the source. Please check the source file for issues and try again.');\n                return;\n            }\n            setExtractResult(extractedResult);\n        }\n        setSubmitted(true);\n\n    };\n\n    return {\n        onSubmit,\n        extractResult,\n        submitted,\n        saveLoading,\n        ...methods,\n    };\n};\n","import {Select, SelectContent, SelectItem, SelectTrigger, SelectValue} from \"@/components/ui/select\";\nimport {Controller, useFormContext} from \"react-hook-form\";\nimport {DashboardFormType} from \"@/model/dashboard/dashboard-form-model\";\n\ninterface Props {\n    mode: 'update' | 'create';\n\n}\n\nexport const StatusSelect = ({mode}: Props) => {\n    const {control} = useFormContext<DashboardFormType>();\n\n    const handleStatusChange = (value: string, onChange: (value: string) => void) => {\n        onChange(value); // Calls react-hook-form's `onChange` method\n    };\n\n    return (\n        <Controller\n            control={control}\n            name={'config.status'}\n            render={({field: {onChange, value}}) => (\n                <Select onValueChange={(val) => handleStatusChange(val, onChange)} value={value}>\n                    <SelectTrigger id=\"page-status\" data-testid={'status-select'}>\n                        <SelectValue placeholder=\"Publish\"/>\n                    </SelectTrigger>\n                    <SelectContent>\n                        {mode === 'update' && <SelectItem value=\"-1\">Keep Status</SelectItem>}\n                        <SelectItem value=\"publish\">Publish</SelectItem>\n                        <SelectItem value=\"draft\">Draft</SelectItem>\n                        <SelectItem value=\"private\">Private</SelectItem>\n                        <SelectItem value=\"future\">Future</SelectItem>\n                    </SelectContent>\n                </Select>\n            )}\n        />\n    );\n};\n","import * as React from \"react\";\nfunction ArrowRightIcon({\n  title,\n  titleId,\n  ...props\n}, svgRef) {\n  return /*#__PURE__*/React.createElement(\"svg\", Object.assign({\n    xmlns: \"http://www.w3.org/2000/svg\",\n    viewBox: \"0 0 24 24\",\n    fill: \"currentColor\",\n    \"aria-hidden\": \"true\",\n    \"data-slot\": \"icon\",\n    ref: svgRef,\n    \"aria-labelledby\": titleId\n  }, props), title ? /*#__PURE__*/React.createElement(\"title\", {\n    id: titleId\n  }, title) : null, /*#__PURE__*/React.createElement(\"path\", {\n    fillRule: \"evenodd\",\n    d: \"M12.97 3.97a.75.75 0 0 1 1.06 0l7.5 7.5a.75.75 0 0 1 0 1.06l-7.5 7.5a.75.75 0 1 1-1.06-1.06l6.22-6.22H3a.75.75 0 0 1 0-1.5h16.19l-6.22-6.22a.75.75 0 0 1 0-1.06Z\",\n    clipRule: \"evenodd\"\n  }));\n}\nconst ForwardRef = /*#__PURE__*/ React.forwardRef(ArrowRightIcon);\nexport default ForwardRef;","import * as React from \"react\";\nfunction CloudArrowDownIcon({\n  title,\n  titleId,\n  ...props\n}, svgRef) {\n  return /*#__PURE__*/React.createElement(\"svg\", Object.assign({\n    xmlns: \"http://www.w3.org/2000/svg\",\n    viewBox: \"0 0 24 24\",\n    fill: \"currentColor\",\n    \"aria-hidden\": \"true\",\n    \"data-slot\": \"icon\",\n    ref: svgRef,\n    \"aria-labelledby\": titleId\n  }, props), title ? /*#__PURE__*/React.createElement(\"title\", {\n    id: titleId\n  }, title) : null, /*#__PURE__*/React.createElement(\"path\", {\n    fillRule: \"evenodd\",\n    d: \"M10.5 3.75a6 6 0 0 0-5.98 6.496A5.25 5.25 0 0 0 6.75 20.25H18a4.5 4.5 0 0 0 2.206-8.423 3.75 3.75 0 0 0-4.133-4.303A6.001 6.001 0 0 0 10.5 3.75Zm2.25 6a.75.75 0 0 0-1.5 0v4.94l-1.72-1.72a.75.75 0 0 0-1.06 1.06l3 3a.75.75 0 0 0 1.06 0l3-3a.75.75 0 1 0-1.06-1.06l-1.72 1.72V9.75Z\",\n    clipRule: \"evenodd\"\n  }));\n}\nconst ForwardRef = /*#__PURE__*/ React.forwardRef(CloudArrowDownIcon);\nexport default ForwardRef;","import * as React from \"react\";\nfunction NoSymbolIcon({\n  title,\n  titleId,\n  ...props\n}, svgRef) {\n  return /*#__PURE__*/React.createElement(\"svg\", Object.assign({\n    xmlns: \"http://www.w3.org/2000/svg\",\n    viewBox: \"0 0 24 24\",\n    fill: \"currentColor\",\n    \"aria-hidden\": \"true\",\n    \"data-slot\": \"icon\",\n    ref: svgRef,\n    \"aria-labelledby\": titleId\n  }, props), title ? /*#__PURE__*/React.createElement(\"title\", {\n    id: titleId\n  }, title) : null, /*#__PURE__*/React.createElement(\"path\", {\n    fillRule: \"evenodd\",\n    d: \"m6.72 5.66 11.62 11.62A8.25 8.25 0 0 0 6.72 5.66Zm10.56 12.68L5.66 6.72a8.25 8.25 0 0 0 11.62 11.62ZM5.105 5.106c3.807-3.808 9.98-3.808 13.788 0 3.808 3.807 3.808 9.98 0 13.788-3.807 3.808-9.98 3.808-13.788 0-3.808-3.807-3.808-9.98 0-13.788Z\",\n    clipRule: \"evenodd\"\n  }));\n}\nconst ForwardRef = /*#__PURE__*/ React.forwardRef(NoSymbolIcon);\nexport default ForwardRef;","import * as React from \"react\";\nfunction TrashIcon({\n  title,\n  titleId,\n  ...props\n}, svgRef) {\n  return /*#__PURE__*/React.createElement(\"svg\", Object.assign({\n    xmlns: \"http://www.w3.org/2000/svg\",\n    viewBox: \"0 0 24 24\",\n    fill: \"currentColor\",\n    \"aria-hidden\": \"true\",\n    \"data-slot\": \"icon\",\n    ref: svgRef,\n    \"aria-labelledby\": titleId\n  }, props), title ? /*#__PURE__*/React.createElement(\"title\", {\n    id: titleId\n  }, title) : null, /*#__PURE__*/React.createElement(\"path\", {\n    fillRule: \"evenodd\",\n    d: \"M16.5 4.478v.227a48.816 48.816 0 0 1 3.878.512.75.75 0 1 1-.256 1.478l-.209-.035-1.005 13.07a3 3 0 0 1-2.991 2.77H8.084a3 3 0 0 1-2.991-2.77L4.087 6.66l-.209.035a.75.75 0 0 1-.256-1.478A48.567 48.567 0 0 1 7.5 4.705v-.227c0-1.564 1.213-2.9 2.816-2.951a52.662 52.662 0 0 1 3.369 0c1.603.051 2.815 1.387 2.815 2.951Zm-6.136-1.452a51.196 51.196 0 0 1 3.273 0C14.39 3.05 15 3.684 15 4.478v.113a49.488 49.488 0 0 0-6 0v-.113c0-.794.609-1.428 1.364-1.452Zm-.355 5.945a.75.75 0 1 0-1.5.058l.347 9a.75.75 0 1 0 1.499-.058l-.346-9Zm5.48.058a.75.75 0 1 0-1.498-.058l-.347 9a.75.75 0 0 0 1.5.058l.345-9Z\",\n    clipRule: \"evenodd\"\n  }));\n}\nconst ForwardRef = /*#__PURE__*/ React.forwardRef(TrashIcon);\nexport default ForwardRef;","import useWordpressAjax from \"@/hooks/fetch/use-wordpress-ajax-fetch\";\nimport {z} from \"zod\";\nimport {NumberParser} from \"@/lib/zod-utils\";\nimport {useQuery} from \"@tanstack/react-query\";\n\n\nexport const FetchTaxonomiesResponseItemSchema = z.object({\n    id: NumberParser,\n    name: z.string()\n});\n\n\nconst FetchTaxonomiesResponseSchema = z.record(z.string(), z.array(FetchTaxonomiesResponseItemSchema)).or(z.array(z.any()))\n\nexport type FetchTaxonomyTermsResponseItem = z.infer<typeof FetchTaxonomiesResponseItemSchema>;\n\nconst useTaxonomyTerms = () => {\n    const fetchTaxonomyTerms = useWordpressAjax<Record<string, FetchTaxonomyTermsResponseItem[]>, {}>(\n        \"lpagery_get_taxonomy_terms\",\n        FetchTaxonomiesResponseSchema,\n        \"Fetching taxonomy terms failed\"\n    );\n\n    return useQuery({\n        staleTime: 1000,\n        queryKey: [`taxonomy_terms`],\n        queryFn: () => fetchTaxonomyTerms({body: {}}),\n    });\n}\n\n\nexport default useTaxonomyTerms;","import * as React from \"react\"\nimport { cva, type VariantProps } from \"class-variance-authority\"\n\nimport { cn } from \"@/lib/utils\"\n\nconst badgeVariants = cva(\n  \"inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2\",\n  {\n    variants: {\n      variant: {\n        default:\n          \"border-transparent bg-primary text-primary-foreground hover:bg-primary/80\",\n        secondary:\n          \"border-transparent bg-secondary text-secondary-foreground hover:bg-secondary/80\",\n        destructive:\n          \"border-transparent bg-destructive text-destructive-foreground hover:bg-destructive/80\",\n        outline: \"text-foreground\",\n      },\n    },\n    defaultVariants: {\n      variant: \"default\",\n    },\n  }\n)\n\nexport interface BadgeProps\n  extends React.HTMLAttributes<HTMLDivElement>,\n    VariantProps<typeof badgeVariants> {}\n\nfunction Badge({ className, variant, ...props }: BadgeProps) {\n  return (\n    <div className={cn(badgeVariants({ variant }), className)} {...props} />\n  )\n}\n\nexport { Badge, badgeVariants }\n","\"use client\";\n\nimport * as React from \"react\";\nimport {X} from \"lucide-react\";\n\nimport {Badge} from \"@/components/ui/badge\";\nimport {Command, CommandGroup, CommandItem, CommandList,} from \"@/components/ui/command\";\nimport {Input} from \"@/components/ui/input\";\nimport {Command as CommandPrimitive} from \"cmdk\";\n\nexport type Option<key> = {\n    value: key;\n    label: string;\n};\n\ninterface MultiSelectProps<key> extends  React.ComponentPropsWithoutRef<typeof CommandPrimitive> {\n    options: Option<key>[];\n    selected: key[];\n    onSelectionChange: (key: key[]) => void;\n    placeholder?: string;\n}\n\nexport const MultiSelect = React.forwardRef(<key,>(\n    { options, selected, onSelectionChange, placeholder = \"Select options...\", ...props }: MultiSelectProps<key>,\n    ref: React.ForwardedRef<HTMLDivElement>\n) => {\n    const inputRef = React.useRef<HTMLInputElement>(null);\n    const [open, setOpen] = React.useState(false);\n    const [inputValue, setInputValue] = React.useState(\"\");\n\n    const handleUnselect = React.useCallback((option: key) => {\n        onSelectionChange(selected.filter((s) => s !== option));\n    }, [onSelectionChange, selected]);\n\n    const getOptionByKey = (key: key) => {\n        return options.find(opt => opt.value === key)\n    }\n\n    const handleKeyDown = React.useCallback(\n        (e: React.KeyboardEvent<HTMLDivElement>) => {\n            const input = inputRef.current;\n            if (input) {\n                if (e.key === \"Delete\" || e.key === \"Backspace\") {\n                    if (input.value === \"\") {\n                        onSelectionChange(selected.slice(0, -1));\n                    }\n                }\n                if (e.key === \"Escape\") {\n                    input.blur();\n                }\n            }\n        },\n        [onSelectionChange, selected]\n    );\n\n    const selectables = options.filter(\n        (option) => !selected.includes(option.value)\n    );\n\n    return (\n        <Command\n            onKeyDown={handleKeyDown}\n            className=\"overflow-visible bg-transparent\"\n            {...props}\n            onSubmit={(e) => { e.preventDefault(); if (props.onSubmit) props.onSubmit(e); }}\n        >\n            <div className=\"group rounded-md text-sm ring-offset-background \">\n                <Input\n                    ref={inputRef as React.RefObject<HTMLInputElement>}\n                    value={inputValue}\n                    onChange={(e) => setInputValue(e.target.value)}\n                    onBlur={() => setOpen(false)}\n                    onFocus={() => setOpen(true)}\n                    placeholder={placeholder}\n                    className=\"w-full bg-transparent outline-none placeholder:text-muted-foreground\"\n                />\n            </div>\n            <div className=\"flex flex-wrap gap-1 \">\n                {selected.map((selectedKey) => (\n                    <Badge key={String(selectedKey)} variant=\"secondary\" className=\"mt-2\">\n                        {getOptionByKey(selectedKey)?.label}\n                        {(\n                            <button\n                                className=\"rounded-full outline-none ring-offset-background\"\n                                onKeyDown={(e) => {\n                                    if (e.key === \"Enter\") {\n                                        handleUnselect(selectedKey);\n                                    }\n                                }}\n                                onMouseDown={(e) => {\n                                    e.preventDefault();\n                                    e.stopPropagation();\n                                }}\n                                onClick={(e) => {\n                                    e.preventDefault()\n                                    handleUnselect(selectedKey)\n                                }}\n                            >\n                                <X className=\"h-3 w-3 text-muted-foreground hover:text-foreground\" />\n                            </button>\n                        )}\n                    </Badge>\n                ))}\n            </div>\n            <div className=\"relative\">\n                <CommandList ref={ref}>\n                    {open && selectables.length > 0 ? (\n                        <div className=\"absolute top-0 z-10 w-full rounded-md border bg-popover text-popover-foreground shadow-md outline-none animate-in mt-2\">\n                            <CommandGroup className=\"overflow-auto\">\n                                {options.filter(option => !selected.some((s) => s === option.value)).filter(option => option.label.toLowerCase().includes(inputValue.toLowerCase())).map((option) => {\n                                    return (\n                                        <CommandItem\n                                            key={String(option.value)}\n                                            onMouseDown={(e: React.MouseEvent) => {\n                                                e.preventDefault();\n                                                e.stopPropagation();\n                                            }}\n                                            onSelect={() => {\n                                                setInputValue(\"\");\n                                                onSelectionChange([...selected, option.value]);\n\n                                            }}\n                                            className={`cursor-pointer}`}\n                                        >\n                                            {option.label}\n                                        </CommandItem>\n                                    );\n                                })}\n                            </CommandGroup>\n                        </div>\n                    ) : null}\n                </CommandList>\n            </div>\n        </Command>\n    );\n})","import useTaxonomyTerms, {FetchTaxonomyTermsResponseItem} from \"@/hooks/dashboard/query/use-taxonomy-terms\";\nimport {useEffect, useState} from \"react\";\nimport {MultiSelect} from \"@/components/ui/multiselect\";\nimport {Controller, useFormContext} from \"react-hook-form\";\nimport {FetchTaxonomiesResponseItem} from \"@/hooks/dashboard/query/use-taxonomies\";\nimport usePost from \"@/hooks/dashboard/query/use-post\";\n\ninterface Props {\n    name: string;\n    templateId: number;\n    taxonomy: FetchTaxonomiesResponseItem;\n}\n\nexport const TaxonomySelect = ({name,templateId, taxonomy}: Props) => {\n    const {control} = useFormContext();\n    const taxonomiesResponse = useTaxonomyTerms();\n    const [taxonomies, setTaxonomies] = useState<FetchTaxonomyTermsResponseItem[]>([]);\n    const { data: postData } = usePost(templateId);\n    const pluralPostType = postData?.type?.plural ?? 'Pages';\n\n    useEffect(() => {\n        if (taxonomiesResponse.data) {\n            setTaxonomies(taxonomiesResponse.data[taxonomy.name] || []);\n        }\n    }, [taxonomiesResponse.data, taxonomy.name]);\n\n    const options = taxonomies.map(tax => ({\n        value: tax.id,\n        label: tax.name,\n    }));\n\n    return (\n        <Controller\n            name={name}\n            control={control}\n            render={({field}) => (\n                <MultiSelect\n                    options={options}\n                    selected={field.value || []}\n                    placeholder={`Click to select ${taxonomy.label} for your created ${pluralPostType}`}\n                    onSelectionChange={(values) => {\n                        field.onChange(values);\n                    }}\n                />\n            )}\n        />\n    );\n};\n","import useWordpressAjax from \"@/hooks/fetch/use-wordpress-ajax-fetch\";\nimport {z} from \"zod\";\nimport {useQuery} from \"@tanstack/react-query\";\nimport {useSubscription} from \"@/hooks/subscription/use-subscription\";\n\n\nexport const FetchTaxonomiesResponseItemSchema = z.object({\n    name: z.string(),\n    label: z.string()\n});\n\nexport const FetchTaxonomiesResponseSchema = z.array(FetchTaxonomiesResponseItemSchema);\n\nexport type FetchTaxonomiesResponseItem = z.infer<typeof FetchTaxonomiesResponseItemSchema>;\n\nconst useTaxonomiesForPostType = (post_type?: string) => {\n    const fetcher = useWordpressAjax<FetchTaxonomiesResponseItem[], {\n        post_type?: string\n    }>(\n        \"lpagery_get_taxonomies\", \n        FetchTaxonomiesResponseSchema,\n        \"Fetching taxonomies for post type failed\"\n    );\n\n    const {extended} = useSubscription()\n    return useQuery({\n        queryKey: [`taxonomies`, post_type],\n        staleTime: 1000,\n        placeholderData: (previousData) => previousData || [\n            {\n                name: 'category',\n                label: 'Categories'\n            },\n            {\n                name: 'post_tag',\n                label: 'Tags'\n            }],\n        enabled: !!post_type && extended,\n        queryFn: () => fetcher({body: {post_type}})\n    })\n}\nexport default useTaxonomiesForPostType;","import {FormFieldWrapper} from \"@/components/common/FormFieldWrapper\";\nimport {TaxonomySelect} from \"@/components/dashboard/save/components/TaxonomySelect\";\nimport {FieldError} from \"react-hook-form\";\nimport useTaxonomiesForPostType from \"@/hooks/dashboard/query/use-taxonomies-for-post-type\";\nimport usePost from \"@/hooks/dashboard/query/use-post\";\n\ninterface TaxonomySectionProps {\n    templateId: number;\n    taxonomyErrors?: Record<string, FieldError | undefined>;\n}\n\nexport const TaxonomySection = ({ templateId, taxonomyErrors }: TaxonomySectionProps) => {\n    const { data: postData } = usePost(templateId);\n    const { data: taxonomiesData } = useTaxonomiesForPostType(postData?.type?.name);\n\n    if (!taxonomiesData?.length) return null;\n\n    return (\n        <>\n            {taxonomiesData.map((taxonomy) => (\n                <FormFieldWrapper\n                    key={taxonomy.name}\n                    label={taxonomy.label}\n                    license=\"standard\"\n                    error={taxonomyErrors?.[taxonomy.name]?.message}\n                    optional={true}\n                    className={\"sm:col-span-6\"}\n                >\n                    <TaxonomySelect\n                        templateId={templateId}\n                        name={`config.taxonomy_terms.${taxonomy.name}`}\n                        taxonomy={taxonomy}\n                    />\n                </FormFieldWrapper>\n            ))}\n        </>\n    );\n}; ","import {Button} from \"@/components/ui/button\";\nimport {useFormContext} from \"react-hook-form\";\nimport {DashboardFormType} from \"@/model/dashboard/dashboard-form-model\";\nimport {getCityUrlParams} from \"@/hooks/generation/get-city-params\";\nimport {useNonce} from \"@/hooks/fetch/use-nonce\";\nimport {getAjaxUrl} from \"@/lib/get-ajax-url\";\n\nexport const DownloadRadiusDataButton = () => {\n    const {watch, getValues} = useFormContext<DashboardFormType>();\n    const nonce = useNonce();\n\n    const isEnabled = watch('input.source') === 'radius' && !!watch('input.radius.location');\n\n    const getDownloadUrl = () => {\n        const ajaxUrl = getAjaxUrl();\n        const input = getValues(\"input.radius\");\n        if (!input?.location) {\n            return \"#\"; // Fallback URL when no valid location\n        }\n        const params = getCityUrlParams(input, nonce, \"lpagery_download_cities\");\n        return `${ajaxUrl}?${params.toString()}`;\n    };\n\n    return (\n        <Button \n            variant={'outline'} \n            className={`w-full sm:w-auto ${!isEnabled ? 'opacity-50 cursor-not-allowed' : ''}`} \n            asChild\n        >\n            <a\n                href={isEnabled ? getDownloadUrl() : undefined}\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                aria-disabled={!isEnabled}\n                style={{pointerEvents: isEnabled ? \"auto\" : \"none\"}}\n                className={!isEnabled ? 'pointer-events-none' : ''}\n            >\n                Download Radius Data\n            </a>\n        </Button>\n    );\n};\n","import { FormFieldWrapper } from \"@/components/common/FormFieldWrapper\";\nimport { Input } from \"@/components/ui/input\";\nimport { PageSelect } from \"@/components/dashboard/save/components/PageSelect\";\nimport { SlugInput } from \"@/components/dashboard/save/components/SlugInput\";\nimport { DateTimePicker } from \"@/components/ui/date-time-picker\";\nimport { UploadFileArea } from \"@/components/dashboard/save/upload/UploadFileArea\";\nimport { Button } from \"@/components/ui/button\";\nimport { useDashboardForm } from \"@/hooks/dashboard/use-dashboard-form\";\nimport { useEffect } from \"react\";\nimport { DashboardFormType } from \"@/model/dashboard/dashboard-form-model\";\nimport { StatusSelect } from \"@/components/dashboard/save/components/StatusSelect\";\nimport { ArrowRightIcon } from \"@heroicons/react/24/solid\";\nimport { FieldError } from \"react-hook-form\";\nimport { TaxonomySection } from \"@/components/dashboard/save/components/TaxonomySection\";\nimport { DownloadRadiusDataButton } from \"@/components/dashboard/save/DownloadRadiusDataButton\";\nimport { ExtractResult } from \"@/hooks/generation/extract/use-extract-data\";\nimport { useSubscription } from \"@/hooks/subscription/use-subscription\";\nimport { ErrorBoundaryWrapper } from \"@/components/layout/error/ErrorBoundaryWrapper\";\nimport usePost from \"@/hooks/dashboard/query/use-post\";\n\ninterface Props {\n    mode: 'update' | 'create';\n    submittedCallback: (extractResult: ExtractResult, result: DashboardFormType) => void\n}\n\nexport const PostSettingsForm = ({ mode, submittedCallback }: Props) => {\n    const {\n        onSubmit,\n        extractResult,\n        submitted,\n        saveLoading,\n        ...methods\n    } = useDashboardForm(mode);\n    const { control, handleSubmit, register, formState: { errors, isValidating, isSubmitting }, getValues, watch } = methods;\n    const taxonomyErrors = errors.config?.taxonomy_terms as Record<string, FieldError | undefined> | undefined;\n\n    const { data: templatePost } = usePost(mode === 'create' ? watch('config.template') : watch('updateSelection.template'));\n\n    const templateWatch = mode === 'create' ? watch('config.template') : watch('updateSelection.template');\n    const parentWatch = watch('config.parent');\n\n    const statusWatch = watch('config.status');\n    const inputSourceWatch = watch('input.source');\n\n    const { extended } = useSubscription();\n\n    const singularPostType = templatePost?.type?.singular ?? 'Page';\n    const pluralPostType = templatePost?.type?.plural ?? 'Pages';\n\n\n    useEffect(() => {\n        if (submitted && extractResult) {\n            submittedCallback(extractResult, getValues());\n        }\n    }, [submitted, extractResult])\n\n    const content = (\n        <div className=\"space-y-8\" data-testid=\"post-settings-form\">\n            <div className=\"mt-6 space-y-6\">\n                <FormFieldWrapper label=\"Purpose/Name\" license=\"free\"\n                    description={`This is just an internal name and helps you organize and manage your created ${pluralPostType}.`}\n                    optional={true}\n                    error={errors.config?.purpose?.message}\n                    className={\"sm:col-span-6\"}>\n                    <Input placeholder=\"e.g., City Pages for Your Service\" {...register('config.purpose')} data-testid=\"purpose-input\" />\n                </FormFieldWrapper>\n\n                {mode === \"create\" && (<FormFieldWrapper label={`Template ${singularPostType}`} license=\"free\"\n                    error={errors.config?.template?.message}\n                    className={\"sm:col-span-6\"}>\n                    <PageSelect\n                        type={'template'}\n                        mode={mode}\n                        data-testid=\"template-select\"\n                        {...register('config.template')} />\n                </FormFieldWrapper>)}\n\n                <FormFieldWrapper label=\"URL Slug\" license=\"standard\"\n                    error={errors.config?.slug?.message}\n                    description={`Enter a unique identifier for your ${singularPostType} URL. It must contain at least one placeholder.`}\n                    className={\"sm:col-span-6\" + (!extended ? ' cursor-pointer' : '')}>\n                    <SlugInput {...register('config.slug')} parent_id={parentWatch}\n                        template_id={templateWatch} mode={mode}/>\n                </FormFieldWrapper>\n\n                <FormFieldWrapper label={`${singularPostType} Status`} license=\"standard\"\n                    error={errors.config?.status?.message}\n                    className={\"sm:col-span-6\" + (!extended ? ' cursor-pointer' : '')}>\n                    <div className=\"w-full\">\n                        <StatusSelect mode={mode} />\n                        {statusWatch === 'future' &&\n                            <div className={'mt-4'}>\n                                <DateTimePicker hourCycle={24} {...register('config.date')}\n                                    control={control} />\n                            </div>}\n                        {errors.config?.date &&\n                            <p className=\"text-red-500 text-sm\">{errors.config.date.message}</p>}\n                    </div>\n                </FormFieldWrapper>\n\n                <FormFieldWrapper label={`Parent ${singularPostType}`} license=\"standard\"\n                    error={errors.config?.parent?.message}\n                    description={`Select a parent ${singularPostType} to create the ${singularPostType} under - only available if the template post type is hierarchical.`}\n                    optional={true}\n                    className={\"sm:col-span-6\" + (!extended ? ' cursor-pointer' : '')}>\n                    <PageSelect\n                        mode={mode}\n                        disabled={!templatePost?.type?.hierarchical}\n                        type={'parent'}\n                        selectedTemplateId={templateWatch} {...register('config.parent')} />\n                </FormFieldWrapper>\n\n                <TaxonomySection\n                    templateId={templateWatch}\n                    taxonomyErrors={taxonomyErrors}\n                />\n            </div>\n\n            {mode === \"create\" &&\n                <div className=\"sm:col-span-4 space-y-2 \">\n                    <fieldset>\n                        <div className=\"border-b border-gray-200 pb-5\">\n                            <h3 className=\"text-xl font-semibold leading-6 text-gray-900\">2. Input Selection</h3>\n                            <p className=\"mt-1 text-sm leading-6 text-gray-600\">Choose the type of input for your data.</p>\n                        </div>\n                        <UploadFileArea />\n                    </fieldset>\n                </div>\n            }\n        </div>\n    );\n\n    if (mode === 'update') {\n        return content;\n    }\n\n    return (\n        <form onSubmit={handleSubmit(onSubmit)}>\n            <ErrorBoundaryWrapper>\n                {content}\n                {mode === \"create\" &&\n                    <div className=\"mt-6 flex flex-wrap items-center justify-end gap-4 sm:gap-x-6\">\n                        {inputSourceWatch === 'radius' && (\n                            <ErrorBoundaryWrapper>\n                                <DownloadRadiusDataButton />\n                            </ErrorBoundaryWrapper>\n                        )}\n                        <Button\n                            type=\"submit\"\n                            loading={saveLoading}\n                            disabled={isValidating || isSubmitting}\n                            className=\"w-full sm:w-auto flex items-center justify-center\"\n                            data-testid=\"create-pages-button\"\n                        >\n                            Review & Create {pluralPostType}\n                            <ArrowRightIcon\n                                className=\"h-5 w-5 ml-2\"\n                                aria-hidden=\"true\"\n                            />\n                        </Button>\n                    </div>\n                }\n            </ErrorBoundaryWrapper>\n        </form>\n    );\n};","import{get as t,set as e}from\"react-hook-form\";const s=(e,s,o)=>{if(e&&\"reportValidity\"in e){const r=t(o,s);e.setCustomValidity(r&&r.message||\"\"),e.reportValidity()}},o=(t,e)=>{for(const o in e.fields){const r=e.fields[o];r&&r.ref&&\"reportValidity\"in r.ref?s(r.ref,o,t):r.refs&&r.refs.forEach(e=>s(e,o,t))}},r=(s,r)=>{r.shouldUseNativeValidation&&o(s,r);const f={};for(const o in s){const n=t(r.fields,o),a=Object.assign(s[o]||{},{ref:n&&n.ref});if(i(r.names||Object.keys(s),o)){const s=Object.assign({},t(f,o));e(s,\"root\",a),e(f,o,s)}else e(f,o,a)}return f},i=(t,e)=>t.some(t=>t.startsWith(e+\".\"));export{r as toNestErrors,o as validateFieldsNatively};\n//# sourceMappingURL=resolvers.mjs.map\n"