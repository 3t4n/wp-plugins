 \"@/hooks/dashboard/confirm/functional-columns/cell/use-image-cell-data\";\n\ninterface ImageNotFoundProps {\n    data?: ImageHeaderResponse | void,\n    headerImageName: string\n}\n\nexport default function ImageNotFound({\n                                          data, headerImageName\n                                      }: ImageNotFoundProps) {\n\n    const label = data?.download_url_missing ? 'Download Filename missing' : 'Image not found'\n    return (\n        <a href={data?.header_image_id ? 'upload.php?item=' + data.header_image_id : 'upload.php'} target={'_blank'} className={'cursor-pointer'}>\n            <TooltipProvider>\n                <Tooltip>\n                    <TooltipTrigger>\n                        <div className=\"flex space-x-2 items-center border  rounded-lg p-2 cursor-default\">\n                            <ImageNotFound01Icon width={24} height={24}/>\n                            <span className=\"text-xs text-muted-foreground\">{label}</span>\n                        </div>\n                    </TooltipTrigger>\n                    {data?.file_name &&\n                        <TooltipContent>\n                            <div className=\"flex flex-col items-start\">\n                                <p className=\"text-sm text-muted-foreground\">\n                                    The image <span className=\"font-bold\">{data.file_name}</span> could not be found\n                                </p>\n                                <p className=\"text-sm text-muted-foreground\">Please check the path of the image and\n                                    correct\n                                    it in the source file.</p>\n                            </div>\n                        </TooltipContent>}\n                    {data?.download_url_missing &&\n                        <TooltipContent>\n                            <div className=\"flex flex-col items-start\">\n                                <p className=\"text-sm text-muted-foreground\">\n                                    The image <span className=\"font-bold\">{headerImageName}</span> is missing the\n                                    LPagery Download Filename\n                                </p>\n                                <p className=\"text-sm text-muted-foreground\">Please go ahead to the Media Library and\n                                    add the names for the files to be downloaded </p>\n                            </div>\n                        </TooltipContent>}\n\n                </Tooltip>\n            </TooltipProvider>\n        </a>\n    )\n}","import ImageNotFound01Icon from \"@/Icons/image-not-found-01-stroke-standard\";\nimport {Tooltip, TooltipContent, TooltipProvider, TooltipTrigger} from \"@/components/ui/tooltip\";\n\n\nexport default function ImageProcessingDisabled() {\n    return (\n        <TooltipProvider>\n            <Tooltip>\n                <TooltipTrigger>\n                    <div className=\"flex space-x-2 items-center border rounded-lg p-2 cursor-default\">\n                        <ImageNotFound01Icon width={24} height={24}/>\n                        <span className=\"text-xs text-muted-foreground\">Image processing disabled</span>\n                    </div>\n                </TooltipTrigger>\n                <TooltipContent>\n                    <div className=\"flex flex-col items-start\">\n                        <p className=\"text-sm text-muted-foreground\">\n                            Image processing is currently disabled in the settings\n                        </p>\n                    </div>\n                </TooltipContent>\n            </Tooltip>\n        </TooltipProvider>\n    )\n}","import useWordpressAjax from \"@/hooks/fetch/use-wordpress-ajax-fetch\";\nimport {useQuery} from \"@tanstack/react-query\";\nimport {z} from \"zod\";\n\nconst ImageProcessingSchema = z.object({\n    image_processing: z.boolean(),\n});\n\nexport const useImageProcessingEnabled = () => {\n    const fetcher = useWordpressAjax<z.infer<typeof ImageProcessingSchema>>(\n        \"lpagery_get_settings\",\n        ImageProcessingSchema,\n        \"Fetching settings failed\"\n    );\n    return useQuery({\n        queryKey: [`settings`,'image_processing'],\n        staleTime: 1000 * 60,\n        placeholderData: { image_processing: true },\n        throwOnError: false,\n        queryFn: () => fetcher({})\n    })\n\n}","import {useHeaderImageData} from \"@/hooks/dashboard/confirm/functional-columns/header/use-header-image-data\";\nimport {ImageSkeleton} from \"@/components/ui/image-skeleton\";\nimport {ImageWrapper} from \"@/components/dashboard/save/confirm/components/ImageWrapper\";\nimport ImageNotFound from \"@/components/dashboard/save/confirm/components/cell/ImageNotFoundCell\";\nimport ImageProcessingDisabled from \"@/components/dashboard/save/confirm/components/cell/ImageProcessingDisabled\";\nimport {useImageProcessingEnabled} from \"@/hooks/settings/use-image-processing-enabled\";\n\ninterface Props {\n    name: string\n}\n\nexport const ImageHeader = ({name}: Props) => {\n    const imageResponse = useHeaderImageData(name);\n    const {data: settingsResponse} = useImageProcessingEnabled()\n\n    if (imageResponse.isLoading || !imageResponse.data || !settingsResponse) {\n        return <ImageSkeleton/>\n    }\n    if(!settingsResponse.image_processing) {\n        return <ImageProcessingDisabled/>\n    }\n\n    if (!!imageResponse.data && !imageResponse.data.image_exists) {\n        return (\n            <ImageWrapper>\n\n                <ImageNotFound headerImageName={name}/>\n\n            </ImageWrapper>\n        )\n    }\n    return (\n        <ImageWrapper>\n            <img className=\"rounded-lg shadow-lg\" alt={'header'} src={imageResponse.data.url!!} width={64}\n                 height={64}></img>\n        </ImageWrapper>\n    )\n}","import useWordpressAjax from \"@/hooks/fetch/use-wordpress-ajax-fetch\";\n\nimport {z} from 'zod';\nimport {useQuery} from \"@tanstack/react-query\";\n\nconst TaxonomyNameResponseSchema = z.object({\n    taxonomy_name: z.string(),\n});\ntype TaxonomyNameResponse = z.infer<typeof TaxonomyNameResponseSchema>;\nexport const useTaxonomyHeaderData = (header: string) => {\n\n    const fetcher = useWordpressAjax<TaxonomyNameResponse, {\n        taxonomy: string\n    }>(\n        \"lpagery_get_taxonomy_name\", \n        TaxonomyNameResponseSchema,\n        \"Fetching taxonomy name failed\"\n    );\n\n    return useQuery({\n        queryKey: ['confirm-dialog','header', `taxonomy`, header],\n        queryFn: (params) => fetcher({\n            body: {\n                taxonomy: header,\n            }, signal: params.signal\n        })\n    })\n}","import {useTaxonomyHeaderData} from \"@/hooks/dashboard/confirm/functional-columns/header/use-taxonomy-header-data\";\nimport {Loader} from \"@/components/common/Loader\";\n\ninterface Props {\n    name: string\n}\n    export const TaxonomyHeader = ({name} : Props) => {\n    const taxonomyResponse = useTaxonomyHeaderData(name);\n    if(taxonomyResponse.isLoading) {\n        return <Loader />\n    }\n    if(!taxonomyResponse.data) {\n        return <div>-</div>\n    }\n\n    return (\n        <div className=\"flex justify-between items-center\">\n            <div className=\"text-sm font-medium text-gray-900\">\n                {taxonomyResponse.data.taxonomy_name} (Taxonomy)\n            </div>\n        </div>\n    )\n}","import {ImageHeader} from \"@/components/dashboard/save/confirm/components/header/ImageHeader\";\nimport {TaxonomyHeader} from \"@/components/dashboard/save/confirm/components/header/TaxonomyHeader\";\nimport {Header} from \"@/hooks/generation/extract/use-extract-data\";\nimport {ProBadge} from \"@/components/common/ProBadge\";\n\ninterface ColumnHeaderProps {\n    header: Header\n}\n\nexport const ColumnHeader = ({header}: ColumnHeaderProps) => {\n\n    if(header.licenseNeeded) {\n        return (\n            <div className=\"flex items-center\">\n                <span>{header.name}</span>\n                <ProBadge></ProBadge>\n            </div>\n        )\n    }\n    if (header.type === 'image') {\n        return <ImageHeader name={header.name}/>\n    }\n\n    const isTaxonomyHeader = header.name.startsWith('lpagery_taxonomy_')\n    if (isTaxonomyHeader) {\n        return <TaxonomyHeader name={header.name}/>\n    }\n\n    const label = header.label;\n\n\n    return (\n        <div className=\"flex justify-between items-center\">\n            <div className=\"text-sm font-medium text-gray-900\">{label}</div>\n        </div>\n    )\n}","import {z} from \"zod\";\n\nexport const NumberParser = z.union([\n    z.string().transform((val) => {\n        const num = Number(val);\n        if (!isNaN(num)) {\n            return num;\n        }\n        throw new Error(\"Failed to parse number \" + val);\n    }),\n    z.number()\n]);\n\nexport const OptionalNumber = z.union([z.number().int().positive().min(1), z.nan()]).optional()\n\n// Define a schema that parses the date string\nexport const StringToDateType = z.preprocess(\n    (arg) => {\n        if (typeof arg === \"string\" || arg instanceof String) {\n            const parsedDate = new Date(arg as string);\n            if (!isNaN(parsedDate.getTime())) {\n                return parsedDate;\n            }\n        }\n        return arg;\n    },\n    z.date().refine((date) => !isNaN(date.getTime()), {\n        message: \"Invalid date format\"\n    })\n);\n\nexport const StringOrNumberParser = z.union([\n    z.string(),\n    z.number().transform(val => val.toString())\n])\n","import {z} from \"zod\";\nimport useWordpressAjax from \"@/hooks/fetch/use-wordpress-ajax-fetch\";\nimport {useRemoveUnusedKeysFromRow} from \"@/hooks/common/use-remove-unused-keys\";\nimport {NumberParser} from \"@/lib/zod-utils\";\nimport {useQuery} from \"@tanstack/react-query\";\nimport {ExtractResultDataEntry} from \"@/hooks/generation/extract/use-extract-data\";\nimport {useHeaderImageData} from \"@/hooks/dashboard/confirm/functional-columns/header/use-header-image-data\";\n\nconst ImageHeaderResponseSchema = z.object({\n    url: z.string().url().optional().nullable(),\n    image_exists: z.boolean(),\n    download: z.boolean().optional(),\n    copy: z.boolean().optional(),\n    download_url_missing: z.boolean().optional(),\n    header_image_id: NumberParser.optional(),\n    file_name: z.string().optional().nullable(),\n})\nexport type ImageHeaderResponse = z.infer<typeof ImageHeaderResponseSchema>;\n\nexport const useImageCellData = (header: string, data: ExtractResultDataEntry) => {\n    const fetcher = useWordpressAjax<ImageHeaderResponse, {\n        header_name: string,\n        data: string\n    }>(\"lpagery_get_image_urls\", ImageHeaderResponseSchema, \"Fetch Image Cell Data failed\");\n    const {data: headerData, isLoading: headerIsLoading} = useHeaderImageData(header);\n    const removeUnusedKeysFromRow = useRemoveUnusedKeysFromRow();\n    const cleared_data = removeUnusedKeysFromRow(data, {header}, {value: headerData?.download_filename ?? undefined});\n\n    const query = useQuery({\n        queryKey: ['confirm-dialog','row', `image`, header, data.row_id],\n        queryFn: (params) => fetcher({body: {header_name: header, data: JSON.stringify(cleared_data)}, signal: params.signal}),\n        enabled: !headerIsLoading,\n    });\n\n    if (headerIsLoading) {\n        return {\n            ...query,\n            isLoading: true,\n            isFetching: true,\n        };\n    }\n\n    return query;\n}","import {useImageCellData} from \"@/hooks/dashboard/confirm/functional-columns/cell/use-image-cell-data\";\nimport {Loader} from \"@/components/common/Loader\";\nimport ImageNotFound from \"@/components/dashboard/save/confirm/components/cell/ImageNotFoundCell\";\nimport {ImageWrapper} from \"@/components/dashboard/save/confirm/components/ImageWrapper\";\nimport {ArrowDownTrayIcon, ClipboardDocumentIcon, DocumentIcon} from \"@heroicons/react/24/outline\";\nimport {ExtractResultDataEntry, Header} from \"@/hooks/generation/extract/use-extract-data\";\nimport ImageProcessingDisabled from \"./ImageProcessingDisabled\";\nimport {useImageProcessingEnabled} from \"@/hooks/settings/use-image-processing-enabled\";\n\ninterface Props {\n    row: ExtractResultDataEntry,\n    header: Header,\n}\n\nexport const ImageCell = ({row, header}: Props) => {\n    const imageResponse = useImageCellData(header.name, row);\n    const {data: settingsResponse, error: settingsError} = useImageProcessingEnabled()\n\n\n    if ((imageResponse.isLoading || !settingsResponse) && !settingsError) {\n        return <Loader/>\n    }\n\n    let imageComp;\n    const imageData = imageResponse.data;\n\n    if(settingsResponse && !settingsResponse.image_processing) {\n        return <ImageProcessingDisabled/>\n    }\n    if (!imageData || !imageData.url) {\n        imageComp = <ImageNotFound data={imageData} headerImageName={header.name}/>\n    } else {\n        imageComp = (\n            <div className=\"relative\">\n                <img\n                    data-testid={`image-cell-image-${row.row_id}`}\n                    width={64}\n                    height={64}\n                    src={imageData.url}\n                    alt={imageData.file_name ?? \"Image\"}\n                    className=\"rounded-lg shadow-lg\"\n                />\n                {/* Badge for image download */}\n                {imageData.download && !imageData.image_exists && (\n                    <ArrowDownTrayIcon\n                        data-testid={`image-cell-download-${row.row_id}`}\n                        className=\"absolute top-0 right-0 h-5 w-5 text-blue-500\"\n                        title={`This image will be downloaded and added with the name ${imageData.file_name}`}\n                    />\n                )}\n                {/* Badge for image exists */}\n                {imageData.image_exists && (\n                    <DocumentIcon\n                        data-testid={`image-cell-exists-${row.row_id}`}\n                        className=\"absolute top-0 right-0 h-5 w-5 text-blue-500\"\n                        title={`An image with the name ${imageData.file_name} already exists`}\n                    />\n                )}\n                {/* Badge for image copy */}\n                {imageData.copy && !imageData.image_exists && (\n                    <ClipboardDocumentIcon\n                        data-testid={`image-cell-copy-${row.row_id}`}\n                        className=\"absolute top-0 right-0 h-5 w-5 text-blue-500\"\n                        title={`This image will be copied with the name ${imageData.file_name}`}\n                    />\n                )}\n            </div>\n        );\n    }\n\n    return <ImageWrapper>{imageComp}</ImageWrapper>\n}\n","import React from 'react';\n\nexport const NoSymbolIcon: React.FC<React.SVGProps<SVGSVGElement>> = (props) => {\n    return (\n        <svg\n            xmlns=\"http://www.w3.org/2000/svg\"\n            fill=\"none\"\n            viewBox=\"0 0 24 24\"\n            strokeWidth={1.5}\n            stroke=\"currentColor\"\n            className=\"size-6\"\n            {...props} // Spread additional props here\n        >\n            <path\n                strokeLinecap=\"round\"\n                strokeLinejoin=\"round\"\n                d=\"M18.364 18.364A9 9 0 0 0 5.636 5.636m12.728 12.728A9 9 0 0 1 5.636 5.636m12.728 12.728L5.636 5.636\"\n            />\n        </svg>\n    );\n};\n","import {NoSymbolIcon} from \"@/Icons/no-symbol\";\n\nexport const NotFoundCell = () => {\n    return <NoSymbolIcon className=\"h-5 w-5 text-gray-400\" />\n}","import {z} from \"zod\";\nimport useWordpressAjax from \"@/hooks/fetch/use-wordpress-ajax-fetch\";\nimport {useRemoveUnusedKeysFromRow} from \"@/hooks/common/use-remove-unused-keys\";\nimport {useQuery} from \"@tanstack/react-query\";\nimport {ExtractResultDataEntry} from \"@/hooks/generation/extract/use-extract-data\";\n\nconst AuthorResponseSchema = z.object({\n    author: z.object({\n        name: z.string(),\n    }).optional()\n\n})\ntype AuthorResponse = z.infer<typeof AuthorResponseSchema>;\n\nexport const useAuthorCellData = (data: ExtractResultDataEntry) => {\n    const fetcher = useWordpressAjax<AuthorResponse, { data: string }>(\"lpagery_get_authors\", AuthorResponseSchema, \"Fetch Author Cell Data failed\");\n    const removeUnusedKeysFromRow = useRemoveUnusedKeysFromRow();\n    const cleared_data = removeUnusedKeysFromRow(data, {header: \"lpagery_author\"});\n\n    return useQuery({\n        queryKey: ['confirm-dialog','row', `author`, data.row_id],\n        queryFn: (params) => {\n            return fetcher({body: {data: JSON.stringify(cleared_data)}, signal: params.signal})\n        }\n    })\n}","import {Loader} from \"@/components/common/Loader\";\nimport {NotFoundCell} from \"@/components/dashboard/save/confirm/components/cell/NotFoundCell\";\nimport {useAuthorCellData} from \"@/hooks/dashboard/confirm/functional-columns/cell/use-author-cell-data\";\nimport {ExtractResultDataEntry} from \"@/hooks/generation/extract/use-extract-data\";\n\ninterface Props {\n    row : ExtractResultDataEntry,\n}\nexport const AuthorCell = ({ row }: Props) => {\n    const authorResponse = useAuthorCellData(row);\n\n    if(authorResponse.isLoading) {\n        return <Loader></Loader>\n    }\n\n    if(!authorResponse.data?.author?.name) {\n        return <NotFoundCell/>\n    }\n    return <div>{authorResponse.data.author.name}</div>\n\n}","import useWordpressAjax from \"@/hooks/fetch/use-wordpress-ajax-fetch\";\nimport {useRemoveUnusedKeysFromRow} from \"@/hooks/common/use-remove-unused-keys\";\nimport {z} from \"zod\";\nimport {useQuery} from \"@tanstack/react-query\";\nimport {ExtractResultDataEntry} from \"@/hooks/generation/extract/use-extract-data\";\n\nconst PageHeaderResponseSchema = z.object({\n    post: z.object({\n        title: z.string(),\n        permalink: z.string().url().optional()\n    }).optional()\n})\ntype PageHeaderResponse = z.infer<typeof PageHeaderResponseSchema>;\nexport const usePageCellData = (header: \"lpagery_template\" | \"lpagery_parent\", data: ExtractResultDataEntry, template_id: number) => {\n\n\n    const page_config_value = header === \"lpagery_parent\" ? data.config_data?.parent : data.config_data?.template || '';\n\n    const fetcher = useWordpressAjax<PageHeaderResponse, {\n        page_config_value?: string,\n        template_id: number,\n        data: string\n    }>(\n        \"lpagery_search_posts_by_slug\", \n        PageHeaderResponseSchema,\n        \"Fetching page cell data failed\"\n    );\n    const removeUnusedKeysFromRow = useRemoveUnusedKeysFromRow();\n    const cleared_data = removeUnusedKeysFromRow(data, {value: page_config_value});\n\n\n    return useQuery({\n        queryKey: ['confirm-dialog','row', header, data.row_id, page_config_value],\n        queryFn: (params) => fetcher({\n            body: {\n                page_config_value: page_config_value,\n                template_id: template_id,\n                data: JSON.stringify(cleared_data)\n            }, signal: params.signal\n        })\n    })\n}","import {usePageCellData} from \"@/hooks/dashboard/confirm/functional-columns/cell/use-page-cell-data\";\nimport {Loader} from \"@/components/common/Loader\";\nimport {NotFoundCell} from \"@/components/dashboard/save/confirm/components/cell/NotFoundCell\";\nimport {ExtractResultDataEntry} from \"@/hooks/generation/extract/use-extract-data\";\n\ninterface Props {\n    row: ExtractResultDataEntry,\n    header: \"lpagery_template\" | \"lpagery_parent\",\n    template_id: number,\n}\n\nexport const PageCell = ({row, header, template_id}: Props) => {\n    const pageDataResponse = usePageCellData(header, row, template_id);\n    if (pageDataResponse.isLoading) {\n        return <Loader></Loader>\n    }\n\n    if (!pageDataResponse.data?.post?.title) {\n        return <NotFoundCell/>\n    }\n\n    return <a target={'_blank'} href={pageDataResponse.data.post.permalink}>{pageDataResponse.data.post.title}</a>\n}","import useWordpressAjax from \"@/hooks/fetch/use-wordpress-ajax-fetch\";\nimport {useRemoveUnusedKeysFromRow} from \"@/hooks/common/use-remove-unused-keys\";\n\nimport {z} from 'zod';\nimport {useQuery} from \"@tanstack/react-query\";\nimport {ExtractResultDataEntry} from \"@/hooks/generation/extract/use-extract-data\";\n\nconst TaxonomyResponseSchema = z.object({\n    hierarchical_taxonomies: z.record(\n        z.string(),\n        z.array(\n            z.object({\n                taxonomies: z.array(z.string()), // Array of strings (e.g., \"catparent\", \"child\")\n                exists: z.boolean(), // Boolean value for \"exists\"\n            })\n        )\n    )\n});\ntype TaxonomyResponse = z.infer<typeof TaxonomyResponseSchema>;\nexport const useTaxonomyCellData = ( data: ExtractResultDataEntry) => {\n\n    const fetcher = useWordpressAjax<TaxonomyResponse, {\n        terms: string,\n        data: string\n    }>(\"lpagery_get_hierarchical_taxonomies\", TaxonomyResponseSchema, \"Fetch Taxonomy Cell Data failed\");\n    const removeUnusedKeysFromRow = useRemoveUnusedKeysFromRow();\n\n    const taxonomyTerms = data.config_data?.taxonomy_terms;\n\n\n    const options : {value: string}[] = []\n    if (taxonomyTerms) {\n        Object.keys(taxonomyTerms).forEach((key) => {\n            const terms = taxonomyTerms[key];\n            if (terms) {\n               terms.forEach((term) => {\n                     options.push({value: term})\n               })\n            }\n        });\n    }\n\n    const cleared_data = removeUnusedKeysFromRow(data, ...options);\n    return useQuery({\n        queryKey: ['confirm-dialog','row', `taxonomies`, data.row_id],\n        enabled: !!taxonomyTerms,\n        queryFn: (params) => fetcher({\n            body: {\n                terms: JSON.stringify(taxonomyTerms),\n                data: JSON.stringify(cleared_data)\n            },\n            signal: params.signal\n        })\n    })\n}","import {Loader} from \"@/components/common/Loader\";\nimport {useTaxonomyCellData} from \"@/hooks/dashboard/confirm/functional-columns/cell/use-taxonomy-cell-data\";\nimport {NotFoundCell} from \"@/components/dashboard/save/confirm/components/cell/NotFoundCell\";\nimport {ExtractResultDataEntry, Header} from \"@/hooks/generation/extract/use-extract-data\";\n\ninterface Props {\n    row: ExtractResultDataEntry,\n    header: Header\n}\n\nexport const TaxonomyCell = ({row, header}: Props) => {\n    const taxonomyResponse = useTaxonomyCellData(row);\n\n    if (taxonomyResponse.isLoading) {\n        return <Loader></Loader>\n    }\n    const hierarchicalTaxonomy = taxonomyResponse.data?.hierarchical_taxonomies[header.name];\n    if (!hierarchicalTaxonomy) {\n        return <NotFoundCell/>\n    }\n\n    return (\n        <ul className=\"list-disc ml-6\">\n            {hierarchicalTaxonomy.map((tax, index) => (\n                <li key={index}>\n                    <div className=\"inline-flex items-center\">\n                        {tax.taxonomies.map((subTax, i) => (\n                            <span key={i} className=\"flex items-center\">\n                        {i > 0 && <span className=\"mx-1\">→</span>}\n                                <span className=\"font-medium\">{subTax}</span>\n                    </span>\n                        ))}\n                        {!tax.exists && <span className=\"text-green-600 ml-2\">(+) New</span>}\n                    </div>\n                </li>\n            ))}\n        </ul>\n    )\n}","import {NotFoundCell} from \"@/components/dashboard/save/confirm/components/cell/NotFoundCell\";\nimport {ExtractResultDataEntry} from \"@/hooks/generation/extract/use-extract-data\";\n\ninterface Props {\n    row: ExtractResultDataEntry,\n}\n\nexport const StatusCell = ({row}: Props) => {\n\n\n    const status = row.config_data?.status\n\n    if (!status) {\n        return <div>-</div>\n    }\n\n\n    if ([\"publish\", \"private\", \"draft\", \"future\"].includes(status?.toLowerCase())) {\n        return <div>{status.toLowerCase()}</div>\n    }\n    return <NotFoundCell/>\n}","import {ExtractResultDataEntry} from \"@/hooks/generation/extract/use-extract-data\";\n\ninterface Props {\n    row: ExtractResultDataEntry\n}\n\nfunction renderFromConfig(row: ExtractResultDataEntry) {\n    if (row.config_data?.date) {\n        return <div>{row.config_data.date}</div>\n    }\n    return <div>-</div>\n}\n\nexport const PublishStateCell = ({row}: Props) => {\n    const publishDate = row.placeholder_data[\"lpagery_publish_date\"]\n    if (!publishDate) {\n        return renderFromConfig(row);\n    }\n    const utcDate = new Date(publishDate as string | Date);\n\n    if (!isNaN(utcDate.getTime())) {\n        return <div>{utcDate.toLocaleString()}</div>;\n    }\n    return renderFromConfig(row);\n}","import useWordpressAjax from \"@/hooks/fetch/use-wordpress-ajax-fetch\";\nimport {useRemoveUnusedKeysFromRow} from \"@/hooks/common/use-remove-unused-keys\";\nimport {z} from \"zod\";\nimport {useQuery} from \"@tanstack/react-query\";\nimport {ExtractResultDataEntry} from \"@/hooks/generation/extract/use-extract-data\";\n\nconst PageHeaderResponseSchema = z.object({\n    slug: z.string(),\n    post: z.object({\n        language_code: z.string().optional(),\n        title: z.string(),\n        permalink: z.string().url().optional()\n    }).optional()\n})\ntype PageHeaderResponse = z.infer<typeof PageHeaderResponseSchema>;\nexport const usePageToBeUpdatedCellData = (data: ExtractResultDataEntry, process_id?: number, slug?: string) => {\n    const fetcher = useWordpressAjax<PageHeaderResponse, {\n        process_id?: number,\n        data?: string,\n        page_id_to_be_updated?: number,\n    }>(\"lpagery_get_post_to_be_updated\", PageHeaderResponseSchema, \"Fetch Page to be Updated Cell Data failed\");\n    \n    const removeUnusedKeysFromRow = useRemoveUnusedKeysFromRow();\n    const cleared_data = process_id ? removeUnusedKeysFromRow(data, {value: slug}) : undefined;\n\n    const query = useQuery({\n        queryKey: ['confirm-dialog','row', 'page_to_be_updated', data.row_id],\n        enabled: !data.page_to_be_updated?.id,\n        queryFn: (params) => fetcher({\n            body: {\n                process_id: process_id,\n                data: cleared_data ? JSON.stringify(cleared_data) : undefined,\n                page_id_to_be_updated: data.page_to_be_updated?.id,\n            }, signal: params.signal\n        })\n    });\n\n    if(data.page_to_be_updated?.id) {\n        return {\n            isLoading: false,\n            isError: false,\n            data: {\n                slug: slug,\n                post: {\n                    title: data.page_to_be_updated.title,\n                    permalink: data.page_to_be_updated.permalink,\n                    language_code: data.page_to_be_updated.language_code\n                }\n            }\n        }\n    }\n\n    return query;\n}","import {getFlagUrl} from \"@/lib/utils\";\n\ninterface Props {\n    language_code: string,\n}\n\nexport const FlagImage = ({language_code}: Props) => {\n    return (\n        <img\n            src={getFlagUrl(language_code)}\n            alt={language_code}\n            className=\"mr-2 h-4 w-4\"\n        />)\n}","import {FlagImage} from \"@/components/common/FlagImage\";\n\ninterface Props {\n    post: {\n        language_code?: string,\n        title: string,\n        permalink?: string\n    }\n}\n\nexport const PostLinkWithFlag = ({post}: Props) => {\n    return <a href={post.permalink} target=\"_blank\" rel=\"noopener noreferrer\" className=\"flex items-center\">\n        {post.language_code && (\n            <FlagImage language_code={post.language_code}/>\n        )}\n        <span>{post.title}</span>\n    </a>\n}","import {Loader} from \"@/components/common/Loader\";\nimport {NotFoundCell} from \"@/components/dashboard/save/confirm/components/cell/NotFoundCell\";\nimport {\n    usePageToBeUpdatedCellData\n} from \"@/hooks/dashboard/confirm/functional-columns/cell/use-page-to-be-updated-cell-data\";\nimport {PlusIcon} from \"@heroicons/react/24/outline\";\nimport {Tooltip, TooltipContent, TooltipProvider, TooltipTrigger} from \"@/components/ui/tooltip\";\nimport {ExtractResultDataEntry} from \"@/hooks/generation/extract/use-extract-data\";\nimport {PostLinkWithFlag} from \"@/components/common/PostLinkWithFlag\";\n\ninterface Props {\n    process_id?: number,\n    slug?: string,\n    row: ExtractResultDataEntry,\n}\n\nexport const PageToBeUpdatedCell = ({slug, process_id, row}: Props) => {\n\n    const pageDataResponse = usePageToBeUpdatedCellData(row, process_id, slug);\n\n    if (pageDataResponse.isLoading) {\n        return <Loader></Loader>\n    }\n\n    if (pageDataResponse.isError) {\n        return <NotFoundCell></NotFoundCell>\n    }\n    if (!pageDataResponse.data?.post?.title) {\n        return <TooltipProvider>\n            <Tooltip>\n                <TooltipTrigger asChild>\n                    <PlusIcon className=\"h-5 w-5 text-gray-400\"/>\n                </TooltipTrigger>\n                <TooltipContent side=\"right\" align=\"start\" className=\"relative\">\n                    <p>No page with slug {pageDataResponse.data?.slug} found. A new page will be created</p>\n                </TooltipContent>\n            </Tooltip>\n        </TooltipProvider>\n\n    }\n\n    return <PostLinkWithFlag post={pageDataResponse.data.post}/>\n}\n","import {ExtractResultDataEntry} from \"@/hooks/generation/extract/use-extract-data\";\n\ninterface Props {\n    row: ExtractResultDataEntry\n}\n\nexport const SlugCell = ({row}: Props) => {\n    return <div>{row.slug}</div>\n}","import {ExtractResultDataEntry} from \"@/hooks/generation/extract/use-extract-data\";\n\ninterface Props {\n    row: ExtractResultDataEntry,\n}\n\nexport const ManualChangesCell = ({row}: Props) => {\n    const pageToBeUpdated = row.page_to_be_updated;\n    if (!pageToBeUpdated?.page_manually_updated_at) {\n        return <p>-</p>\n    }\n    const classes = `grid items-center `;\n\n    const name = pageToBeUpdated.page_manually_updated_by ? pageToBeUpdated.page_manually_updated_by?.name || '' + \" (\" + pageToBeUpdated.page_manually_updated_by?.email || '' + \")\" : undefined\n    return (\n        <div className={classes}>\n            <p>{pageToBeUpdated?.page_manually_updated_at?.toLocaleDateString()}</p>\n            {name && <p> By {name}</p>}\n        </div>\n\n    )\n\n}","import {ImageCell} from \"@/components/dashboard/save/confirm/components/cell/ImageCell\";\nimport {AuthorCell} from \"@/components/dashboard/save/confirm/components/cell/AuthorCell\";\nimport {PageCell} from \"@/components/dashboard/save/confirm/components/cell/PageCell\";\nimport {TaxonomyCell} from \"@/components/dashboard/save/confirm/components/cell/TaxonomyCell\";\nimport {StatusCell} from \"@/components/dashboard/save/confirm/components/cell/StatusCell\";\nimport {PublishStateCell} from \"@/components/dashboard/save/confirm/components/cell/PublishStateCell\";\nimport {ExtractResultDataEntry, Header} from \"@/hooks/generation/extract/use-extract-data\";\nimport {PageToBeUpdatedCell} from \"@/components/dashboard/save/confirm/components/cell/PageToBeUpdatedCell\";\nimport {SlugCell} from \"@/components/dashboard/save/confirm/components/cell/SlugCell\";\nimport {ManualChangesCell} from \"@/components/dashboard/save/confirm/components/cell/ManualChangesCell\";\nimport {useSubscription} from \"@/hooks/subscription/use-subscription\";\n\ninterface Props {\n    mode: 'create' | 'update',\n    row: ExtractResultDataEntry,\n    header: Header,\n    template_id: number,\n    slug?: string,\n    process_id?: number,\n}\n\nexport const Cell = ({mode, row, header, slug, process_id, template_id}: Props) => {\n\n    const {extended} = useSubscription()\n    if (header.type === \"slug\") {\n        return <SlugCell row={row}/>\n    }\n\n\n    let defaultValue = row.placeholder_data[header.name];\n\n\n    if (defaultValue && defaultValue?.length > 30) {\n        defaultValue = defaultValue?.substring(0, 30) + '...';\n    }\n\n    if (!extended) {\n        if (header.licenseNeeded) {\n            return <div className={'opacity-70'}>{defaultValue}</div>\n        } else {\n            return <div>{defaultValue}</div>\n        }\n    }\n\n    if (header.type === 'image') {\n        return <ImageCell row={row} header={header}/>\n    }\n\n\n    if (header.type === 'taxonomy') {\n        return <TaxonomyCell row={row} header={header}/>\n    }\n\n    if (header.type === 'functional') {\n        switch (header.name) {\n            case 'lpagery_author' : {\n                return <AuthorCell row={row}></AuthorCell>\n            }\n            default: {\n                return <div>{defaultValue}</div>\n            }\n        }\n    }\n    if (header.type === 'config') {\n        switch (header.name) {\n\n            case \"lpagery_parent\" : {\n                return <PageCell row={row} header={'lpagery_parent'} template_id={template_id}/>\n            }\n            case \"lpagery_template\" : {\n                return <PageCell row={row} header={'lpagery_template'} template_id={template_id}/>\n            }\n            case \"lpagery_status\" : {\n                return <StatusCell row={row}/>\n            }\n            case \"lpagery_publish_date\" : {\n                return <PublishStateCell row={row}/>\n            }\n            default: {\n                return <div>{defaultValue}</div>\n            }\n        }\n    }\n\n    // if (header.type === 'config_changed' && process_id) {\n    //     return <ConfigDiffCell header={header} row={row} template_id={template_id}></ConfigDiffCell>\n    // }\n\n    if (header.type === 'page_to_be_updated' && mode === 'update') {\n        return <PageToBeUpdatedCell slug={slug} process_id={process_id} row={row}></PageToBeUpdatedCell>\n    }\n    if (header.type === 'modified' && mode === 'update') {\n        return <ManualChangesCell row={row}></ManualChangesCell>\n    }\n    return <div>{defaultValue}</div>\n\n\n}","import {Button} from \"@/components/ui/button\";\nimport {ChevronLeftIcon, ChevronRightIcon} from \"@heroicons/react/24/outline\";\n\ninterface TableFooterProps {\n    currentPage: number;\n    totalPages: number;\n    itemsPerPage: number;\n    totalItems: number;\n    goToPage: (page: number) => void;\n    nextPage: () => void;\n    previousPage: () => void;\n}\n\nexport function TableFooter({\n                         currentPage,\n                         totalPages,\n                         itemsPerPage,\n                         totalItems,\n                         goToPage,\n                         nextPage,\n                         previousPage,\n                     }: TableFooterProps) {\n    const startItem = (currentPage - 1) * itemsPerPage + 1;\n    const endItem = Math.min(currentPage * itemsPerPage, totalItems);\n\n    if(totalItems === 0) {\n        return null\n    }\n    return (\n        <div className=\"flex items-center justify-between border-gray-200 bg-white py-3\">\n            <div className=\"flex flex-1 justify-between sm:hidden\">\n                <Button onClick={previousPage} disabled={currentPage === 1} variant=\"outline\">\n                    Previous\n                </Button>\n                <Button onClick={nextPage} disabled={currentPage === totalPages} variant=\"outline\">\n                    Next\n                </Button>\n            </div>\n            <div className=\"hidden sm:flex sm:flex-1 sm:items-center sm:justify-between\">\n                <div>\n                    <p className=\"text-sm text-gray-700\">\n                        Showing <span className=\"font-medium\">{startItem}</span> to{' '}\n                        <span className=\"font-medium\">{endItem}</span> of{' '}\n                        <span className=\"font-medium\">{totalItems}</span> results\n                    </p>\n                </div>\n                <div>\n                    <nav\n                        className=\"isolate inline-flex -space-x-px rounded-md shadow-sm\"\n                        aria-label=\"Pagination\"\n                    >\n                        <Button\n                            onClick={() => goToPage(1)}\n                            disabled={currentPage === 1}\n                            variant=\"outline\"\n                            className=\"relative inline-flex items-center px-2 py-2 text-gray-400\"\n                        >\n                            <span className=\"sr-only\">First</span>\n                            <ChevronLeftIcon className=\"h-5 w-5\" aria-hidden=\"true\"/>\n                            <ChevronLeftIcon className=\"h-5 w-5 -ml-2\" aria-hidden=\"true\"/>\n                        </Button>\n                        <Button\n                            onClick={previousPage}\n                            disabled={currentPage === 1}\n                            variant=\"outline\"\n                            className=\"relative inline-flex items-center px-2 py-2 text-gray-400\"\n                        >\n                            <span className=\"sr-only\">Previous</span>\n                            <ChevronLeftIcon className=\"h-5 w-5\" aria-hidden=\"true\"/>\n                        </Button>\n                        <span className=\"px-4 py-2 text-sm text-gray-700\">\n              Page {currentPage} of {totalPages}\n            </span>\n                        <Button\n                            onClick={nextPage}\n                            disabled={currentPage === totalPages}\n                            variant=\"outline\"\n                            className=\"relative inline-flex items-center px-2 py-2 text-gray-400\"\n                        >\n                            <span className=\"sr-only\">Next</span>\n                            <ChevronRightIcon className=\"h-5 w-5\" aria-hidden=\"true\"/>\n                        </Button>\n                        <Button\n                            onClick={() => goToPage(totalPages)}\n                            disabled={currentPage === totalPages}\n                            variant=\"outline\"\n                            className=\"relative inline-flex items-center px-2 py-2 text-gray-400\"\n                        >\n                            <span className=\"sr-only\">Last</span>\n                            <ChevronRightIcon className=\"h-5 w-5 -mr-2\" aria-hidden=\"true\"/>\n                            <ChevronRightIcon className=\"h-5 w-5\" aria-hidden=\"true\"/>\n                        </Button>\n                    </nav>\n                </div>\n            </div>\n        </div>\n    );\n}","'use client';\nimport { createContext, Component, createElement, useContext, useState, useMemo, forwardRef } from 'react';\n\nconst ErrorBoundaryContext = createContext(null);\n\nconst initialState = {\n  didCatch: false,\n  error: null\n};\nclass ErrorBoundary extends Component {\n  constructor(props) {\n    super(props);\n    this.resetErrorBoundary = this.resetErrorBoundary.bind(this);\n    this.state = initialState;\n  }\n  static getDerivedStateFromError(error) {\n    return {\n      didCatch: true,\n      error\n    };\n  }\n  resetErrorBoundary() {\n    const {\n      error\n    } = this.state;\n    if (error !== null) {\n      var _this$props$onReset, _this$props;\n      for (var _len = arguments.length, args = new Array(_len), _key = 0; _key < _len; _key++) {\n        args[_key] = arguments[_key];\n      }\n      (_this$props$onReset = (_this$props = this.props).onReset) === null || _this$props$onReset === void 0 ? void 0 : _this$props$onReset.call(_this$props, {\n        args,\n        reason: \"imperative-api\"\n      });\n      this.setState(initialState);\n    }\n  }\n  componentDidCatch(error, info) {\n    var _this$props$onError, _this$props2;\n    (_this$props$onError = (_this$props2 = this.props).onError) === null || _this$props$onError === void 0 ? void 0 : _this$props$onError.call(_this$props2, error, info);\n  }\n  componentDidUpdate(prevProps, prevState) {\n    const {\n      didCatch\n    } = this.state;\n    const {\n      resetKeys\n    } = this.props;\n\n    // There's an edge case where if the thing that triggered the error happens to *also* be in the resetKeys array,\n    // we'd end up resetting the error boundary immediately.\n    // This would likely trigger a second error to be thrown.\n    // So we make sure that we don't check the resetKeys on the first call of cDU after the error is set.\n\n    if (didCatch && prevState.error !== null && hasArrayChanged(prevProps.resetKeys, resetKeys)) {\n      var _this$props$onReset2, _this$props3;\n      (_this$props$onReset2 = (_this$props3 = this.props).onReset) === null || _this$props$onReset2 === void 0 ? void 0 : _this$props$onReset2.call(_this$props3, {\n        next: resetKeys,\n        prev: prevProps.resetKeys,\n        reason: \"keys\"\n      });\n      this.setState(initialState);\n    }\n  }\n  render() {\n    const {\n      children,\n      fallbackRender,\n      FallbackComponent,\n      fallback\n    } = this.props;\n    const {\n      didCatch,\n      error\n    } = this.state;\n    let childToRender = children;\n    if (didCatch) {\n      const props = {\n        error,\n        resetErrorBoundary: this.resetErrorBoundary\n      };\n      if (typeof fallbackRender === \"function\") {\n        childToRender = fallbackRender(props);\n      } else if (FallbackComponent) {\n        childToRender = createElement(FallbackComponent, props);\n      } else if (fallback !== undefined) {\n        childToRender = fallback;\n      } else {\n        throw error;\n      }\n    }\n    return createElement(ErrorBoundaryContext.Provider, {\n      value: {\n        didCatch,\n        error,\n        resetErrorBoundary: this.resetErrorBoundary\n      }\n    }, childToRender);\n  }\n}\nfunction hasArrayChanged() {\n  let a = arguments.length > 0 && arguments[0] !== undefined ? arguments[0] : [];\n  let b = arguments.length > 1 && arguments[1] !== undefined ? arguments[1] : [];\n  return a.length !== b.length || a.some((item, index) => !Object.is(item, b[index]));\n}\n\nfunction assertErrorBoundaryContext(value) {\n  if (value == null || typeof value.didCatch !== \"boolean\" || typeof value.resetErrorBoundary !== \"function\") {\n    throw new Error(\"ErrorBoundaryContext not found\");\n  }\n}\n\nfunction useErrorBoundary() {\n  const context = useContext(ErrorBoundaryContext);\n  assertErrorBoundaryContext(context);\n  const [state, setState] = useState({\n    error: null,\n    hasError: false\n  });\n  const memoized = useMemo(() => ({\n    resetBoundary: () => {\n      context.resetErrorBoundary();\n      setState({\n        error: null,\n        hasError: false\n      });\n    },\n    showBoundary: error => setState({\n      error,\n      hasError: true\n    })\n  }), [context.resetErrorBoundary]);\n  if (state.hasError) {\n    throw state.error;\n  }\n  return memoized;\n}\n\nfunction withErrorBoundary(component, errorBoundaryProps) {\n  const Wrapped = forwardRef((props, ref) => createElement(ErrorBoundary, errorBoundaryProps, createElement(component, {\n    ...props,\n    ref\n  })));\n\n  // Format for display in DevTools\n  const name = component.displayName || component.name || \"Unknown\";\n  Wrapped.displayName = \"withErrorBoundary(\".concat(name, \")\");\n  return Wrapped;\n}\n\nexport { ErrorBoundary, ErrorBoundaryContext, useErrorBoundary, withErrorBoundary };\n","import * as React from \"react\"\nimport {cva, type VariantProps} from \"class-variance-authority\"\n\nimport {cn} from \"@/lib/utils\"\n\nconst alertVariants = cva(\n  \"relative w-full rounded-lg p-4\",\n  {\n    variants: {\n      variant: {\n        default: \"bg-background text-foreground\",\n        destructive: \"bg-red-50 text-red-800\",\n      },\n    },\n    defaultVariants: {\n      variant: \"default\",\n    },\n  }\n)\n\nconst Alert = React.forwardRef<\n  HTMLDivElement,\n  React.HTMLAttributes<HTMLDivElement> & VariantProps<typeof alertVariants>\n>(({ className, variant, ...props }, ref) => (\n  <div\n    ref={ref}\n    role=\"alert\"\n    className={cn(alertVariants({ variant }), className)}\n    {...props}\n  />\n))\nAlert.displayName = \"Alert\"\n\nconst AlertTitle = React.forwardRef<\n  HTMLParagraphElement,\n  React.HTMLAttributes<HTMLHeadingElement>\n>(({ className, ...props }, ref) => (\n  <h5\n    ref={ref}\n    className={cn(\"mb-1 font-medium leading-none tracking-tight\", className)}\n    {...props}\n  />\n))\nAlertTitle.displayName = \"AlertTitle\"\n\nconst AlertDescription = React.forwardRef<\n  HTMLParagraphElement,\n  React.HTMLAttributes<HTMLParagraphElement>\n>(({ className, ...props }, ref) => (\n  <div\n    ref={ref}\n    className={cn(\"text-sm [&_p]:leading-relaxed\", className)}\n    {...props}\n  />\n))\nAlertDescription.displayName = \"AlertDescription\"\n\nexport { Alert, AlertTitle, AlertDescription }\n","import {useState} from 'react';\nimport {Alert, AlertDescription, AlertTitle} from \"@/components/ui/alert\";\nimport {FallbackProps} from 'react-error-boundary';\nimport {XCircleIcon} from '@heroicons/react/24/outline';\n\nexport function ErrorAlert({ error, resetErrorBoundary }: FallbackProps) {\n    const [isExpanded, setIsExpanded] = useState(false);\n\n    return (\n        <div className=\"w-full max-w-2xl mx-auto\">\n            <Alert\n                variant=\"destructive\"\n                className=\"shadow-lg border border-red-200 transition-all duration-200 \"\n            >\n                <div className=\"flex items-start\">\n                    <div className=\"shrink-0\">\n                        <XCircleIcon className=\"size-5 text-red-500\" aria-hidden=\"true\" />\n                    </div>\n                    <div className=\"ml-3 flex-1 min-w-0\">\n                        <AlertTitle className=\"text-sm font-medium text-red-900 leading-5\">\n                            {error.name || 'Something went wrong'}\n                        </AlertTitle>\n                        <AlertDescription className=\"text-red-700\">\n                            {isExpanded && (\n                                <div className=\"mt-2 text-sm leading-relaxed\">\n                                    <p className=\"break-words\">\n                                        {error.action && <span className=\"font-medium\">{error.action}: </span>}\n                                        {error.message || 'An unexpected error occurred'}\n                                    </p>\n                                </div>\n                            )}\n                            <div className=\"mt-3\">\n                                <button\n                                    onClick={(e) => {\n                                        e.preventDefault();\n                                        e.stopPropagation();\n                                        setIsExpanded(!isExpanded);\n                                    }}\n                                    className=\"text-sm font-medium text-red-800 hover:text-red-900 transition-colors duration-200\"\n                                >\n                                    {isExpanded ? '↑ Show less' : 'Show details ↓'}\n                                </button>\n                            </div>\n                        </AlertDescription>\n                    </div>\n                    <button\n                        onClick={(e) => {\n                            e.stopPropagation();\n                            resetErrorBoundary();\n                        }}\n                        className=\"ml-4 rounded-md bg-red-50 px-3 py-2 text-sm font-medium text-red-800 hover:bg-red-100 transition-colors duration-200\"\n                    >\n                        Dismiss\n                    </button>\n                </div>\n            </Alert>\n        </div>\n    );\n}","// src/components/error/ErrorBoundaryWrapper.tsx\nimport {ErrorBoundary} from 'react-error-boundary';\nimport {useQueryClient, useQueryErrorResetBoundary} from '@tanstack/react-query';\nimport {ErrorAlert} from \"@/components/layout/error/ErrorAlert\";\n\ninterface ErrorBoundaryWrapperProps {\n    children: React.ReactNode;\n    FallbackComponent?: React.ComponentType<any>;\n}\n\nexport function ErrorBoundaryWrapper({ \n    children, \n    FallbackComponent = ErrorAlert \n}: ErrorBoundaryWrapperProps) {\n    const { reset } = useQueryErrorResetBoundary();\n    const queryClient = useQueryClient();\n\n    const onReset = () => {\n        reset();\n        queryClient.resetQueries();\n    };\n\n    return (\n        <ErrorBoundary\n            FallbackComponent={FallbackComponent}\n            onReset={onReset}\n            onError={(error, info) => console.error('Error caught by boundary:', error, info)}\n        >\n            {children}\n        </ErrorBoundary>\n    );\n}","import React, {useRef} from 'react';\nimport {\n    ColumnDef,\n    flexRender,\n    getCoreRowModel,\n    getPaginationRowModel,\n    PaginationState,\n    useReactTable,\n} from '@tanstack/react-table';\nimport {ExtractResultDataEntry, FormDataWithExtractResult} from '@/hooks/generation/extract/use-extract-data';\nimport {Table, TableBody, TableCell, TableHead, TableHeader, TableRow,} from '@/components/ui/table';\nimport {ColumnHeader} from \"@/components/dashboard/save/confirm/components/header/ColumnHeader\";\nimport {Cell} from \"@/components/dashboard/save/confirm/components/cell/Cell\";\nimport {TableFooter} from \"@/components/dashboard/save/confirm/components/table/TableFooter\";\nimport {DashboardUpdateType} from \"@/model/dashboard/dashboard-form-model\";\nimport {ErrorBoundaryWrapper} from \"@/components/layout/error/ErrorBoundaryWrapper\";\nimport {Switch} from \"@/components/ui/switch\";\nimport {Label} from \"@/components/ui/label\";\n\ninterface Props {\n    result: FormDataWithExtractResult;\n    mode: 'create' | 'update';\n    showOnlyManualEdits: boolean;\n    slug?: string;\n    process_id?: number;\n}\nconst SLUG_COLUMN_THRESHOLD = 200;\n\nexport const ConfirmCreateTable: React.FC<Props> = ({ result, mode, process_id, slug, showOnlyManualEdits }) => {\n    const extractResult = result.extractResult;\n    const columnVisibility = useRef({\n        lpagery_row_id: false,\n    });\n    const [showOnlySlugColumn, setShowOnlySlugColumn] = React.useState(extractResult.headers.length >= SLUG_COLUMN_THRESHOLD);\n    // Pagination state\n    const [pagination, setPagination] = React.useState<PaginationState>({\n        pageIndex: 0,\n        pageSize: 10,\n    });\n    let template_id;\n    if (mode === 'update') {\n        const updateData = result.formData as DashboardUpdateType\n        template_id = updateData.updateSelection.template;\n    } else {\n        template_id = result.formData.config!!.template!!;\n    }\n\n    const columns = React.useMemo<ColumnDef<ExtractResultDataEntry, any>[]>(\n        () => {\n\n            // Filter headers if needed before mapping\n            const filteredHeaders = showOnlySlugColumn\n                ? extractResult.headers.filter(header => header.type === 'slug')\n                : extractResult.headers;\n\n            // Map the filtered headers\n            return filteredHeaders.map((header): ColumnDef<ExtractResultDataEntry, any> => ({\n                header: () => {\n                    return (\n                        <ErrorBoundaryWrapper FallbackComponent={() => <p className='text-gray-400'>{header.name}</p>}>\n                            <ColumnHeader header={header} />\n                        </ErrorBoundaryWrapper>\n                    )\n                },\n                accessorFn: (row) => row.placeholder_data[header.name],\n                id: header.name,\n                cell: (info) => {\n                    return (\n                        <ErrorBoundaryWrapper FallbackComponent={() => <p className='text-gray-400'>{info.row.original.placeholder_data[header.name]}</p>}>\n                            <div data-testid={`cell-${header.name}-${info.row.original.row_id}`}>\n                                <Cell\n                                    mode={mode}\n                                    row={info.row.original}\n                                    header={header}\n                                    process_id={process_id}\n                                    slug={slug}\n                                    template_id={template_id}\n                                />\n                            </div>\n                        </ErrorBoundaryWrapper>\n                    )\n                },\n            }));\n        },\n        [extractResult.headers, showOnlySlugColumn, mode, process_id, slug, template_id]\n    );\n\n\n    const data = React.useMemo<ExtractResultDataEntry[]>(() => {\n        // If showOnlyManualEdits is true, filter to show only manually edited rows\n        if (showOnlyManualEdits) {\n            return extractResult.data.filter(row =>\n                // Check if this row has any manual edits\n                !!row.page_to_be_updated?.page_manually_updated_at\n            );\n        }\n        // Otherwise return all data\n        return extractResult.data;\n    }, [extractResult.data, showOnlyManualEdits]);\n\n\n    const table = useReactTable<ExtractResultDataEntry>({\n        data,\n        columns,\n        pageCount: Math.ceil(data.length / pagination.pageSize),\n        state: {\n            pagination,\n            columnVisibility: columnVisibility.current,\n        },\n        onPaginationChange: setPagination,\n        getCoreRowModel: getCoreRowModel(),\n        getPaginationRowModel: getPaginationRowModel(),\n        manualPagination: false,\n        enableHiding: true,\n        autoResetAll: true,\n    });\n\n    const {\n        getHeaderGroups,\n        getRowModel,\n        getPageCount,\n        nextPage,\n        previousPage,\n        setPageIndex,\n        getState,\n    } = table;\n\n    const currentPage = getState().pagination.pageIndex + 1;\n    const totalPages = getPageCount();\n\n    const headerGroups = getHeaderGroups();\n\n    return (\n        <div className=\"mt-8 pt-4 flow-root flex flex-col relative h-full\">\n            {extractResult.headers.length >= SLUG_COLUMN_THRESHOLD && (\n                <div className=\"flex items-center space-x-2 mb-4 px-6\">\n                    <Switch\n                        id=\"show-slug-only\"\n                        checked={showOnlySlugColumn}\n                        onCheckedChange={setShowOnlySlugColumn}\n                    />\n                    <Label htmlFor=\"show-slug-only\">Show only slug column for better performance ({extractResult.headers.length} columns total)</Label>\n\n                </div>\n            )}\n            <div className=\"-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8 flex-grow\">\n                <div className=\"inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8\">\n                    <div className=\"min-h-[400px] px-6 rounded-lg border border-gray-200 relative mb-8\">\n                        <Table>\n                            <TableHeader>\n                                {headerGroups.map((headerGroup) => (\n                                    <TableRow key={headerGroup.id} className=\"whitespace-nowrap\">\n                                        {headerGroup.headers.map((header) => (\n                                            <TableHead key={header.id} className=\"min-w-[200px]\">\n                                                {header.isPlaceholder\n                                                    ? null\n                                                    : flexRender(header.column.columnDef.header, header.getContext())}\n                                            </TableHead>\n                                        ))}\n                                    </TableRow>\n                                ))}\n                            </TableHeader>\n                            <TableBody>\n                                {getRowModel().rows.length > 0 ? (\n                                    getRowModel().rows.map((row) => (\n                                        <TableRow key={row.id}>\n                                            {row.getVisibleCells().map((cell) => (\n                                                <TableCell\n                                                    key={cell.id}\n                                                    className=\"min-w-[200px] whitespace-nowrap overflow-hidden text-ellipsis max-w-[300px]\"\n                                                >\n                                                    {flexRender(cell.column.columnDef.cell, cell.getContext())}\n                                                </TableCell>\n                                            ))}\n                                        </TableRow>\n                                    ))\n                                ) : (\n                                    <TableRow>\n                                        <TableCell\n                                            colSpan={extractResult.headers.length}\n                                            className=\"h-24 text-center\"\n                                        >\n                                            No results.\n                                        </TableCell>\n                                    </TableRow>\n                                )}\n                            </TableBody>\n                        </Table>\n                    </div>\n                </div>\n            </div>\n            <div className=\"sticky mt-2 bottom-0 bg-white border-t\">\n                <TableFooter\n                    currentPage={currentPage}\n                    totalPages={totalPages}\n                    itemsPerPage={pagination.pageSize}\n                    totalItems={data.length}\n                    goToPage={(page: number) => setPageIndex(page - 1)}\n                    nextPage={nextPage}\n                    previousPage={previousPage}\n                />\n            </div>\n        </div>\n    );\n};\n\n\n","import {Dialog, DialogBackdrop, Transition} from '@headlessui/react'\nimport {Fragment, ReactNode} from 'react'\nimport {ExclamationTriangleIcon} from '@heroicons/react/24/outline'\nimport {Button} from \"@/components/ui/button\"\n\ninterface WarningDialogProps {\n    isOpen: boolean;\n    onClose: () => void;\n    onConfirm: () => void;\n    title: string;\n    message: ReactNode;\n    confirmButtonText?: string;\n    onboarding?: boolean;\n}\n\nexport function WarningDialog({ isOpen, onClose, onConfirm, title, message, confirmButtonText, onboarding }: WarningDialogProps) {\n    return (\n        <Transition appear show={isOpen} as={Fragment}>\n            <Dialog as=\"div\" className=\"relative z-20\" onClose={() => {\n                \n            }}>\n                <DialogBackdrop\n                    transition\n                    className=\"fixed inset-0 bg-black/30 backdrop-blur-sm\"\n                />\n                <Transition.Child\n                    as={Fragment}\n                    enter=\"ease-out duration-300\"\n                    enterFrom=\"opacity-0\"\n                    enterTo=\"opacity-100\"\n                    leave=\"ease-in duration-200\"\n                    leaveFrom=\"opacity-100\"\n                    leaveTo=\"opacity-0\"\n                >\n                    <div className=\"fixed inset-0 bg-black/30 backdrop-blur-sm\" aria-hidden=\"true\" />\n                </Transition.Child>\n\n                <div className=\"fixed inset-0 overflow-y-auto\">\n                    <div className=\"flex min-h-full items-center justify-center p-4 text-center\">\n                        <Transition.Child\n                            as={Fragment}\n                            enter=\"ease-out duration-300\"\n                            enterFrom=\"opacity-0 scale-95\"\n                            enterTo=\"opacity-100 scale-100\"\n                            leave=\"ease-in duration-200\"\n                            leaveFrom=\"opacity-100 scale-100\"\n                            leaveTo=\"opacity-0 scale-95\"\n                        >\n                            <Dialog.Panel className=\"w-full max-w-md transform overflow-hidden rounded-2xl bg-white p-6 text-left align-middle shadow-xl transition-all\">\n                                <Dialog.Title\n                                    as=\"h3\"\n                                    className=\"text-lg font-medium leading-6 text-gray-900 flex items-center\"\n                                >\n                                    <ExclamationTriangleIcon className=\"h-6 w-6 text-yellow-400 mr-2\" aria-hidden=\"true\" />\n                                    {title}\n                                </Dialog.Title>\n                                <div className=\"mt-2\">\n                                    <div className=\"\">\n                                        {message}\n                                    </div>\n                                </div>\n\n                                <div className=\"mt-4 flex justify-end space-x-2\">\n                                    <Button variant=\"outline\" onClick={onClose}>\n                                        Cancel\n                                    </Button>\n                                    <Button onClick={onConfirm} data-testid=\"confirm-creation-warn-button\" event={onboarding ? \"Onboarding Confirm Creation Dialog\" : \"Confirm Creation Dialog\"}>\n                                        {confirmButtonText || \"Confirm\"}\n                                    </Button>\n                                </div>\n                            </Dialog.Panel>\n                        </Transition.Child>\n                    </div>\n                </div>\n            </Dialog>\n        </Transition>\n    )\n}\n","import {useCallback} from 'react';\nimport * as Sentry from '@sentry/react';\nimport {ZodType} from \"zod/lib/types\";\nimport {getAjaxUrl} from \"@/lib/get-ajax-url\";\n\n/**\n * Appends key-value pairs to FormData, handling arrays and nested objects.\n */\nfunction appendFormData(formData: FormData, key: any, value: any) {\n    if (value !== undefined && value !== null) {\n        if (Array.isArray(value)) {\n            value.forEach((item) => {\n                formData.append(`${key}[]`, item);\n            });\n        } else if (typeof value === 'object') {\n            Object.entries(value).forEach(([nestedKey, nestedValue]) => {\n                appendFormData(formData, `${key}[${nestedKey}]`, nestedValue);\n            });\n        } else {\n            formData.append(key, value);\n        }\n    }\n}\n\n/**\n * A hook to make API requests with optimized error handling.\n */\nfunction useWordpressAjaxMutation<Body = void, Resp = unknown>(\n    action: string,\n    schema: ZodType,\n    responseSchema?: ZodType,\n    label?: string\n) {\n    return useCallback(\n        async (params: {\n            headers?: Record<string, string>;\n            body: Body;\n            nonce?: string;\n        }): Promise<Resp | void> => {\n            // @ts-ignore\n            const nonce = params.nonce || lpagery_scripts_object.nonce;\n            const formData = new FormData();\n\n            formData.append('action', action);\n            formData.append('_ajax_nonce', nonce);\n\n            const parsedBody =await schema.safeParseAsync(params.body);\n\n            if (!parsedBody.success) {\n                Sentry.captureException(parsedBody.error);\n                throw parsedBody.error;\n            }\n\n            Object.entries(parsedBody.data).forEach(([key, value]) => {\n                appendFormData(formData, key, value);\n            });\n\n            return await executeFetchRequest<Resp>(\n                getAjaxUrl(),\n                formData,\n                params.headers,\n                responseSchema\n            );\n        },\n        [action, schema, responseSchema, label]\n    );\n}\n\nasync function executeFetchRequest<Resp = unknown>(\n    url: string,\n    payload: FormData,\n    headers?: Record<string, string>,\n    responseSchema?: ZodType\n): Promise<Resp | void> {\n    const options: RequestInit = {\n        method: 'POST',\n        headers: {\n            accept: 'application/json',\n            ...(headers ?? {}),\n        },\n        body: payload,\n    };\n    let responseText = '';\n    try {\n        const response = await fetch(url, options);\n\n        if (response.redirected) {\n            window.location.assign(response.url);\n            return;\n        }\n\n        responseText = await response.text();\n\n        if (!response.ok) {\n            const error = new Error(`Request failed with status ${response.status}`);\n            error.name = 'FetchError';\n            throw error;\n        }\n\n        if (responseSchema) {\n            let jsonResponse;\n            try {\n                jsonResponse = JSON.parse(responseText);\n            } catch {\n                const error = new Error('Invalid JSON response ' + responseText);\n                error.name = 'JSONParseError';\n                throw error;\n            }\n\n            const parseResult = responseSchema.safeParse(jsonResponse);\n            if (!parseResult.success) {\n                throw parseResult.error;\n            }\n\n            return parseResult.data as Resp;\n        } else {\n            if (responseText) {\n                throw new Error(responseText)\n            }\n        }\n\n        return;\n   