                     data-testid=\"google-sheet-url-input\"\n                                className=\"pl-10 w-full\"\n                                placeholder=\"https://docs.google.com/spreadsheets/d/...\"\n                                value={field.value || ''}\n                                onChange={(e) => {\n                                    field.onChange(e.target.value);\n                                    trigger(name);\n                                }}\n                            />\n                            {fieldState.isValidating ? (\n                                <div\n                                    className=\"absolute left-2 top-1/2 transform -translate-y-1/2 h-5 w-5 text-gray-400\">\n                                    <Loader/>\n                                </div>\n                            ) : fieldState.invalid || !parseResult.success ? (\n                                <LinkSlashIcon\n                                    className=\"absolute left-3 top-1/2 transform -translate-y-1/2 h-5 w-5 text-red-500\"\n                                />\n                            ) : !fieldState.invalid && field.value ? (\n                                <LinkIcon\n                                    className=\"absolute left-3 top-1/2 transform -translate-y-1/2 h-5 w-5 text-green-500\"\n                                />\n                            ) : (\n                                <LinkIcon\n                                    className=\"absolute left-3 top-1/2 transform -translate-y-1/2 h-5 w-5 text-gray-400\"/>\n                            )}\n                        </div>\n                    </div>\n                )\n            }\n            }\n        />\n    );\n};\n","export default \"__VITE_ASSET__DB5LY1Dx__\"","import {ReactNode} from 'react';\nimport {useSubscription} from \"@/hooks/subscription/use-subscription\";\n// @ts-ignore\nimport ProIcon from '@/assets/pro.svg';\n\ninterface LicenseAwareWrapperPro