 image search cache'\n    );\n    return useMutation({\n        mutationKey: [`evict_image_cache`],\n        mutationFn: async () => {\n            if (!extended) {\n                return;\n            }\n            await evictCacheMutation({body: {}});\n        },\n\n    })\n};","import {Card} from \"@/components/ui/card\";\nimport {ConfirmCreationModal} from \"@/components/dashboard/save/confirm/components/ConfirmCreationModal\";\nimport {FormProvider, useForm} from \"react-hook-form\";\nimport {PostSettingsForm} from \"@/components/dashboard/save/PostSettingsForm\";\nimport {\n    DashboardCreateSchema,\n    DashboardCreateType,\n    DashboardFormType,\n    InputFormValues\n} from \"@/model/dashboard/dashboard-form-model\";\nimport {zodResolver} from \"@hookform/resolvers/zod\";\nimport {useEffect, useState} from \"react\";\nimport {ExtractResult, FormDataWithExtractResult} from \"@/hooks/generation/extract/use-extract-data\";\nimport {ErrorBoundaryWrapper} from \"@/components/layout/error/ErrorBoundaryWrapper\";\nimport usePost from \"@/hooks/dashboard/query/use-post\";\nimport {getUsername} from \"@/hooks/get-usename\";\nimport {useQueryClient} from \"@tanstack/react-query\";\nimport {useEvictImageSearchCache} from \"@/hooks/media/use-evict-image-search-cache\";\n\n\nexport function Create() {\n\n    const [formResult, setFormResult] = useState<FormDataWithExtractResult>()\n    const [creationDashboardModalOpened, setCreationDashboardModalOpened] = useState(false)\n    const evictImageSearchCache = useEvictImageSearchCache()\n\n    const queryClient = useQueryClient()\n\n    useEffect(() => {\n        if (formResult) {\n            queryClient.removeQueries({queryKey: ['confirm-dialog']});\n            setCreationDashboardModalOpened(true)\n        }\n    }, [formResult]);\n\n\n    const submittedCallback = async (extractResult: ExtractResult, result: DashboardFormType) => {\n        await evictImageSearchCache.mutateAsync()\n        setFormResult({\n            formData: result as DashboardCreateType,\n            extractResult\n        })\n    }\n\n    const methods = useForm<DashboardCreateType>({\n        mode: 'onSubmit',\n        resolver: zodResolver(DashboardCreateSchema),\n        defaultValues: {\n            config: {\n                template: 0,\n                slug: '',\n                status: 'publish',\n                categories: [],\n                tags: [],\n\n            },\n            input: {\n                source: 'file'\n\n            } as InputFormValues,\n        } as DashboardCreateType\n    });\n    const {data: templatePost} = usePost(methods.watch('config.template'))\n\n    useEffect(() => {\n        if (templatePost && !methods.watch('config.purpose')) {\n            methods.setValue('config.purpose', templatePost.type?.singular + \" creation at \" + new Date().toLocaleDateString() + \" by \" + getUsername())\n        }\n    }, [templatePost])\n\n    return (\n        <div className=\"relative\">\n            <Card className=\"w-full p-12\">\n                <ErrorBoundaryWrapper>\n                    <div className=\"border-b border-gray-200 pb-5\">\n                        <h3 className=\"text-xl font-semibold leading-6 text-gray-900\">1. Settings</h3>\n                        <p className=\"mt-1 text-sm leading-6 text-gray-600\">Select your template page and the settings\n                            that\n                            the created pages will have.</p>\n\n                    </div>\n                    <FormProvider {...methods}>\n                        <PostSettingsForm mode={\"create\"} submittedCallback={submittedCallback}></PostSettingsForm>\n                    </FormProvider>\n                    {formResult &&\n                        <ConfirmCreationModal mode={'create'} result={formResult}\n                                              setIsOpen={setCreationDashboardModalOpened}\n                                              isOpen={creationDashboardModalOpened}/>}\n                </ErrorBoundaryWrapper>\n            </Card>\n        </div>\n\n    )\n}\n","import useWordpressAjax from \"@/hooks/fetch/use-wordpress-ajax-fetch\";\nimport {z} from \"zod\";\nimport {useQuery} from \"@tanstack/react-query\";\nimport {useSubscription} from \"@/hooks/subscription/use-subscription\";\n\nconst CustomPostTypeSchema = z.object({ \n    name: z.string(),\n    label: z.string(),\n});\nexport type CustomPostType = z.infer<typeof CustomPostTypeSchema>;\n\nexport const CustomPostTypesResponseSchema = z.array(CustomPostTypeSchema);\n\n\nexport type CustomPostTypesResponse = z.infer<typeof CustomPostTypesResponseSchema>;\n\nconst useCustomPostTypes = () => {\n    const sub = useSubscription()\n    const fetcher = useWordpressAjax<CustomPostTypesResponse, { type: string }>(\n        \"lpagery_get_custom_post_types\", \n        CustomPostTypesResponseSchema,\n        \"Fetching custom post types failed\"\n    );\n\n    return useQuery({\n        queryKey: [`custom-post-types`],\n        enabled: !sub.free,\n        staleTime: 1000 * 60,\n        queryFn: () => fetcher({}),\n    })\n\n}\nexport default useCustomPostTypes;","import React, {useEffect, useMemo, useState} from \"react\";\nimport {MultiSelect, Option} from \"@/components/ui/multiselect\";\nimport {Control, Controller} from \"react-hook-form\";\nimport useCustomPostTypes, {CustomPostType} from \"@/hooks/dashboard/query/use-custom-post-types\";\n\ninterface Props {\n    control: Control<any>;\n}\n\nexport const CustomPostTypeSelect = React.forwardRef<HTMLDivElement, Props>(({\n    control\n}, ref) => {\n    const cptResponse = useCustomPostTypes();\n    const [cpts, setCpts] = useState<CustomPostType[]>([]);\n\n    useEffect(() => {\n        if (cptResponse.data) {\n            setCpts(cptResponse.data);\n        }\n    }, [cptResponse.data]);\n\n    const options = useMemo<Option<string>[]>(() => {\n        return cpts.map((value) => ({value : value.name, label: value.label}));\n    }, [cpts]);\n\n    return (\n        <Controller\n            name=\"custom_post_types\"\n            control={control}\n            render={({field}) => (\n                <MultiSelect\n                    data-testid=\"custom-post-type-select\"\n                    ref={ref}\n                    selected={field.value || []}\n                    options={options}\n                    placeholder={\"Select Custom Post Types...\"}\n                    onSelectionChange={(values) => {\n                        field.onChange(values);\n                    }}\n                />\n            )}\n        />\n    );\n});\n","import useWordpressAjax from \"@/hooks/fetch/use-wordpress-ajax-fetch\";\nimport {z} from \"zod\";\nimport {useQuery} from \"@tanstack/react-query\";\n\n\nexport const UserResponseItemSchema = z.object({\n    id: z.number(),\n    label: z.string()\n})\n\n\nexport type UserResponseItem = z.infer<typeof UserResponseItemSchema>;\n\nconst useUsers = () => {\n    const fetcher = useWordpressAjax<UserResponseItem[]>(\n        \"lpagery_get_users_for_settings\", \n        z.array(UserResponseItemSchema),\n        \"Fetching users failed\"\n    );\n\n    return useQuery({\n        queryKey: [`users`],\n        staleTime: 1000 * 60,\n        queryFn: () =>fetcher({})\n    })\n}\nexport default useUsers;","import {Control, Controller} from \"react-hook-form\";\nimport useUsers from \"@/hooks/dashboard/query/use-users\";\nimport {Select, SelectContent, SelectItem, SelectTrigger, SelectValue} from \"@/components/ui/select\";\nimport React from 'react';\n\ninterface UserSelectProps {\n    control: Control<any>;\n    name: string;\n}\n\nexport const UserSelect = React.forwardRef<HTMLButtonElement, UserSelectProps>(({\n    control, \n    name,\n    ...props\n}, ref) => {\n    \n    const usersResponse = useUsers();\n\n    if(usersResponse.isLoading) {\n        return <Select>Loading...</Select>\n    }\n\n    return (\n        <Controller\n            name={name}\n            control={control}\n            render={({field}) => {\n                return (\n                    <Select \n                        value={String(field.value)} \n                        name={name} \n                        onValueChange={value => {\n                            field.onChange(+value)\n                        }}\n                       \n                    >\n                        <SelectTrigger ref={ref} {...props}>\n                            <SelectValue placeholder=\"Select User\"/>\n                        </SelectTrigger>\n                        <SelectContent>\n                            {usersResponse?.data?.map(user => {\n                                return <SelectItem key={String(user.id)} value={String(user.id)}>{user.label}</SelectItem>\n                            })}\n                        </SelectContent>\n                    </Select>\n                );\n            }}\n        />\n    );\n});\n","import {z} from \"zod\";\nimport {NumberParser, StringToDateType} from \"@/lib/zod-utils\";\n\nconst SettingsSchema = z.object({\n    spintax: z.boolean(),\n    image_processing: z.boolean(),\n    google_sheet_sync_force_update: z.boolean(),\n    google_sheet_sync_overwrite_manual_changes: z.boolean(),\n    author_id: z.number(),\n    custom_post_types: z.array(z.string()),\n    google_sheet_sync_interval: z.enum(['hourly', 'daily', 'twicedaily', 'weekly']),\n    hierarchical_taxonomy_handling: z.enum(['last', 'all']),\n    sync_batch_size: NumberParser,\n    google_sheet_sync_enabled: z.boolean()\n});\nexport const SettingsReadSchema = SettingsSchema.extend({\n    next_google_sheet_sync: StringToDateType.optional().nullable(),\n    wp_cron_disabled: z.boolean()\n})\nexport const SettingsSaveSchema = SettingsSchema.extend({\n    next_google_sheet_sync: z.string().optional().nullable(),\n})\n\n\nexport type SettingsSave = z.infer<typeof SettingsSaveSchema>;\nexport type SettingsRead = z.infer<typeof SettingsReadSchema>;\n","import useWordpressAjax from \"@/hooks/fetch/use-wordpress-ajax-fetch\";\nimport {useQuery} from \"@tanstack/react-query\";\nimport {SettingsRead, SettingsReadSchema} from \"@/hooks/settings/schema\";\n\n\nexport const useFetchSettings = () => {\n    const fetcher = useWordpressAjax<SettingsRead>(\n        \"lpagery_get_settings\", \n        SettingsReadSchema,\n        \"Fetching settings failed\"\n    );\n    return useQuery({\n        queryKey: [`settings`],\n        queryFn: () => fetcher({})\n    })\n\n}","import {Control, Controller} from \"react-hook-form\";\nimport {Select} from \"@/components/ui/select\";\nimport React from 'react';\n\ninterface Props {\n    control: Control<any>;\n    name: string;\n    children?: React.ReactNode;\n}\n\nexport const FormSelect = React.forwardRef<HTMLDivElement, Props>(({\n    control, \n    name, \n    children,\n    ...props\n}, ref) => {\n    return (\n        <Controller \n            name={name} \n            control={control} \n            render={({field}) => (\n                <Select \n                    name={name} \n                    onValueChange={value => field.onChange(value)} \n                    value={field.value}\n                    {...props}\n                >\n                    {children}\n                </Select>\n            )}\n        />\n    );\n});","import useWordpressAjaxMutation from \"@/hooks/fetch/use-mutation\";\nimport {useMutation, useQueryClient} from \"@tanstack/react-query\";\nimport {SettingsSave, SettingsSaveSchema} from \"@/hooks/settings/schema\";\n\nexport const useSaveSettings = () => {\n    const queryClient = useQueryClient();\n    const saveSettingsMutation = useWordpressAjaxMutation<SettingsSave>(\"lpagery_save_settings\", SettingsSaveSchema);\n    return useMutation({\n        mutationKey: [`settings`],\n        mutationFn: async (settings: SettingsSave) => {\n            await saveSettingsMutation({body: settings});\n        },\n        onSuccess: async () => {\n            queryClient.removeQueries({queryKey: [`settings`, 'image_processing']});\n            await queryClient.invalidateQueries();\n        }\n    })\n\n}","export const Skeleton = () => {\n    return (\n        <div className=\"animate-pulse flex space-x-4\">\n            <div className=\"rounded-full bg-gray-300 h-12 w-12\"></div>\n            <div className=\"flex-1 space-y-4 py-1\">\n                <div className=\"h-4 bg-gray-300 rounded w-3/4\"></div>\n                <div className=\"space-y-2\">\n                    <div className=\"h-4 bg-gray-300 rounded\"></div>\n                    <div className=\"h-4 bg-gray-300 rounded w-5/6\"></div>\n                </div>\n            </div>\n        </div>\n    );\n}","import {z} from \"zod\";\nimport useWordpressAjaxMutation from \"@/hooks/fetch/use-mutation\";\nimport {useMutation} from \"@tanstack/react-query\";\n\nexport const TrackingPermissionSaveSchema = z.object({\n    sentry: z.boolean(),\n    posthog: z.boolean(),\n    intercom: z.boolean()\n});\nexport type TrackingPermissionsSave = z.infer<typeof TrackingPermissionSaveSchema>;\n\n\nexport const useSaveTrackingPermissions = () => {\n    const saveTrackingPermissionsMutation = useWordpressAjaxMutation<TrackingPermissionsSave, Response>(\"lpagery_save_tracking_permissions\", TrackingPermissionSaveSchema);\n    const mutation = useMutation({\n        mutationKey: [`lpagery_save_tracking_permissions`],\n        mutationFn: async (settings: TrackingPermissionsSave) => {\n            try {\n                await saveTrackingPermissionsMutation({body: settings});\n            } catch (e) {\n                throw new Error(\"Failed to save tracking permissions\");\n            }\n        },\n        onSuccess: async () => {\n            window.location.reload()\n        }\n    })\n    return mutation\n}","interface Permissions {\n    sentry: boolean;\n    posthog: boolean;\n    intercom: boolean;\n}\n\nexport const getTrackingPermissions = () => {\n    // @ts-ignore\n    const trackingPermissions: Permissions = lpagery_scripts_object?.tracking_permissions;\n    return trackingPermissions\n}","import {FormProvider, useForm} from \"react-hook-form\";\nimport {zodResolver} from \"@hookform/resolvers/zod\";\nimport {Button} from \"@/components/ui/button\";\nimport {FormSwitch} from \"@/components/ui/form-switch\";\nimport {toast} from \"sonner\";\nimport {\n    TrackingPermissionSaveSchema,\n    TrackingPermissionsSave,\n    useSaveTrackingPermissions\n} from \"@/hooks/tracking/use-save-tracking-permissions\";\nimport {getTrackingPermissions} from \"@/lib/get-tracking-permissions\";\n\nexport default function EditTrackingPermissionsForm({onSubmitted, onCancel}: {\n    onSubmitted?: () => void;\n    onCancel?: () => void\n}) {\n    const permissions = getTrackingPermissions();\n    const methods = useForm<TrackingPermissionsSave>({\n        resolver: zodResolver(TrackingPermissionSaveSchema),\n        defaultValues: {...permissions},\n    });\n\n    const {control, handleSubmit, watch, formState: {errors, isDirty, isValidating}} = methods;\n\n    const saveMutation = useSaveTrackingPermissions();\n\n    const onSubmit = async (data: TrackingPermissionsSave) => {\n        toast.promise(\n            saveMutation.mutateAsync(data),\n            {\n                loading: \"Saving...\",\n                success: \"Tracking permissions saved! Page will reload in a moment.\",\n                error: \"Failed to save tracking permissions.\",\n            }\n        );\n    };\n\n    return (\n        <FormProvider {...methods}>\n            <form onSubmit={handleSubmit(onSubmit)} className=\"space-y-8\">\n                <div className=\"space-y-4 mt-4\">\n                    {/* PostHog Tracking */}\n                    <div className=\"sm:col-span-4\">\n                        <div className=\"flex items-center justify-between\">\n                            <label htmlFor=\"posthog\" className=\"text-sm font-medium text-gray-900\">\n                                View User Behaviour\n                            </label>\n                            <FormSwitch control={control} name=\"posthog\" />\n                        </div>\n                        <p className=\"mt-1 text-xs leading-6 text-gray-500\">\n                            Allow tracking of user behavior to improve the plugin. We do not track any personal or sensitive data; we just want to understand what our users do to make the plugin better.\n                        </p>\n                        {errors.posthog && <p className=\"text-red-500\">{errors.posthog.message}</p>}\n                    </div>\n\n                    {/* Sentry Error Monitoring */}\n                    <div className=\"sm:col-span-4\">\n                        <div className=\"flex items-center justify-between\">\n                            <label htmlFor=\"sentry\" className=\"text-sm font-medium text-gray-900\">\n                                Error Monitoring\n                            </label>\n                            <FormSwitch control={control} name=\"sentry\" />\n                        </div>\n                        <p className=\"mt-1 text-xs leading-6 text-gray-500\">\n                            Allow monitoring of errors to improve the plugin. We do not track any personal or sensitive data; we just want to understand what errors occur to make the plugin better.\n                        </p>\n                        {errors.sentry && <p className=\"text-red-500\">{errors.sentry.message}</p>}\n                    </div>\n\n                    {/* Intercom */}\n                    <div className=\"sm:col-span-4\">\n                        <div className=\"flex items-center justify-between\">\n                            <label htmlFor=\"intercom\" className=\"text-sm font-medium text-gray-900\">\n                                Intercom Widget\n                            </label>\n                            <FormSwitch control={control} name=\"intercom\" />\n                        </div>\n                        <p className=\"mt-1 text-xs leading-6 text-gray-500\">\n                            Allow Intercom to be shown in the plugin. You can chat with us directly from the plugin to get help or ask questions. Intercom uses cookies to track your session and provide a better experience.\n                        </p>\n                        {errors.intercom && <p className=\"text-red-500\">{errors.intercom.message}</p>}\n                    </div>\n                </div>\n\n                <div className=\"flex items-center justify-end space-x-4\">\n                    <Button variant=\"outline\" onClick={(e) => {\n                        e.preventDefault();\n                        onCancel?.();\n                    }}>\n                        Cancel\n                    </Button>\n                    <Button loading={saveMutation.isPending} disabled={!isDirty || isValidating}>\n                        Save\n                    </Button>\n                </div>\n            </form>\n        </FormProvider>\n    );\n}\n","// EditSheetSyncDialog.tsx\nimport {Dialog, Transition} from \"@headlessui/react\";\nimport React from \"react\";\nimport {AdjustmentsVerticalIcon} from \"@heroicons/react/24/outline\";\nimport EditTrackingPermissionsForm from \"@/components/dashboard/settings/TrackingPermissionsForm\";\n\ninterface Props {\n    isOpen: boolean;\n    onClose: () => void;\n}\n\nexport const TrackingPermissionDialog = ({isOpen, onClose}: Props) => {\n    return (\n        <Transition appear show={isOpen} as={React.Fragment}>\n            <Dialog as=\"div\" className=\"relative z-20\" onClose={onClose}>\n                <Transition.Child\n                    as={React.Fragment}\n                    enter=\"ease-out duration-300\"\n                    enterFrom=\"opacity-0\"\n                    enterTo=\"opacity-100\"\n                    leave=\"ease-in duration-200\"\n                    leaveFrom=\"opacity-100\"\n                    leaveTo=\"opacity-0\"\n                >\n                    <div className=\"fixed inset-0 bg-black/30 backdrop-blur-sm\" aria-hidden=\"true\"/>\n                </Transition.Child>\n                <div className=\"fixed inset-0 overflow-y-auto\">\n                    <div className=\"flex min-h-full items-center justify-center p-4 text-center\">\n                        <Transition.Child\n                            as={React.Fragment}\n                            enter=\"ease-out duration-300\"\n                            enterFrom=\"opacity-0 scale-95\"\n                            enterTo=\"opacity-100 scale-100\"\n                            leave=\"ease-in duration-200\"\n                            leaveFrom=\"opacity-100 scale-100\"\n                            leaveTo=\"opacity-0 scale-95\"\n                        >\n                            <Dialog.Panel\n                                className=\"w-full max-w-2xl transform overflow-hidden rounded-2xl bg-white p-6 text-left align-middle shadow-xl transition-all\">\n                                <div className=\"sm:flex sm:items-start\">\n                                    <div\n                                        className=\"mx-auto flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-blue-100 sm:mx-0 sm:h-10 sm:w-10\">\n                                        <AdjustmentsVerticalIcon aria-hidden=\"true\" className=\"h-6 w-6 text-blue-600\"/>\n                                    </div>\n                                    <div className=\"mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left\">\n                                        <Dialog.Title as=\"h3\" className=\"text-lg font-medium leading-6 text-gray-900\">\n                                            Tracking Permissions\n                                        </Dialog.Title>\n                                        <p className=\"text-sm text-gray-500\">\n                                            Adjust your Tracking Permissions below\n                                        </p>\n                                        <div className=\"mt-2\">\n                                            <div>\n                                                <EditTrackingPermissionsForm onCancel={() => onClose()}></EditTrackingPermissionsForm>\n\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </Dialog.Panel>\n                        </Transition.Child>\n                    </div>\n                </div>\n            </Dialog>\n        </Transition>\n    );\n};\n","import useWordpressAjaxMutation from \"@/hooks/fetch/use-mutation\";\nimport {useMutation, useQueryClient} from \"@tanstack/react-query\";\nimport {z} from \"zod\";\n\nexport const useTriggerSheetSync = () => {\n    const queryClient = useQueryClient();\n    const triggerSheetMutation = useWordpressAjaxMutation<{}>(\"lpagery_trigger_google_sheet_sync\", z.object({}));\n    return useMutation({\n        mutationKey: [`settings`, 'sheet-sync'],\n        mutationFn: async (settings: {}) => {\n            await triggerSheetMutation({body: settings});\n        },\n        onSuccess: async () => {\n            await queryClient.invalidateQueries({queryKey: [`settings`]});\n        }\n    })\n}","import {z} from \"zod\";\nimport useWordpressAjaxMutation from \"@/hooks/fetch/use-mutation\";\nimport {useQueryClient, useMutation} from \"@tanstack/react-query\";\n\nconst ResetDataSchema = z.object({\n    delete_pages: z.boolean()\n});\n\ntype ResetDataType = z.infer<typeof ResetDataSchema>;\n\nexport const useResetData = () => {\n    const queryClient = useQueryClient();\n    const resetDataAjax = useWordpressAjaxMutation<ResetDataType>(\n        \"lpagery_reset_data\",\n        ResetDataSchema\n    );\n\n    return useMutation({\n        mutationFn: async (delete_pages: boolean) => {\n            const result = await resetDataAjax({\n                body: {delete_pages}\n            });\n            return result;\n        },\n        onSuccess: async () => {\n            // Invalidate all queries to refresh data\n            await queryClient.invalidateQueries();\n        }\n    });\n}; ","import {Dialog, DialogBackdrop, DialogPanel, DialogTitle} from '@headlessui/react'\nimport {ExclamationTriangleIcon} from '@heroicons/react/24/outline'\nimport {Checkbox} from '@/components/ui/checkbox'\nimport {useEffect, useState} from 'react'\nimport {Button} from \"@/components/ui/button\";\nimport {Label} from \"@/components/ui/label\";\nimport {toast} from \"sonner\";\nimport { useResetData } from '@/hooks/settings/use-reset-data';\nimport { Input } from \"@/components/ui/input\";\n\nexport const ResetDataDialog = ({isOpen, onClose}: {\n    isOpen: boolean;\n    onClose: () => void;\n}) => {\n    const [deletePages, setDeletePages] = useState(false);\n    const [confirmText, setConfirmText] = useState('');\n    const resetDataMutation = useResetData();\n\n    useEffect(() => {\n        if (isOpen) {\n            setDeletePages(false);\n            setConfirmText('');\n        }\n    }, [isOpen]);\n\n    const handleReset = async () => {\n        try {\n            await resetDataMutation.mutateAsync(deletePages);\n            toast.success('All LPagery data has been reset successfully. Page will reload in 3 seconds.');\n            await new Promise(resolve => setTimeout(resolve, 3000));\n            window.location.reload();\n        } catch (error) {\n            // Error will be shown in the dialog\n        }\n    };\n\n    const isConfirmationValid = confirmText.toLowerCase() === 'i am sure';\n\n    return (\n        <Dialog open={isOpen} onClose={onClose} className=\"relative z-10\">\n            <DialogBackdrop\n                className=\"fixed inset-0 bg-black/30 backdrop-blur-sm\"\n            />\n\n            <div className=\"fixed inset-0 z-10 w-screen overflow-y-auto\">\n                <div className=\"flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0\">\n                    <DialogPanel\n                        className=\"relative transform overflow-hidden rounded-lg bg-white px-4 pb-4 pt-5 text-left shadow-xl sm:my-8 sm:w-full sm:max-w-lg sm:p-6\"\n                    >\n                        {resetDataMutation.error && (\n                            <div className=\"mb-4 p-4 text-sm text-red-800 bg-red-100 rounded-lg\">\n                                {resetDataMutation.error.message}\n                            </div>\n                        )}\n                        <div className=\"sm:flex sm:items-start\">\n                            <div className=\"mx-auto flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-red-100 sm:mx-0 sm:h-10 sm:w-10\">\n                                <ExclamationTriangleIcon className=\"h-6 w-6 text-red-600\"/>\n                            </div>\n                            <div className=\"mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left\">\n                                <DialogTitle as=\"h3\" className=\"text-base font-semibold leading-6 text-gray-900\">\n                                    Reset All LPagery Data?\n                                </DialogTitle>\n                                <div className=\"mt-2\">\n                                    <p className=\"text-sm text-gray-500\">\n                                        This action cannot be undone. This will permanently delete all your settings,\n                                        page sets, and configurations.\n                                    </p>\n                                </div>\n                                <div className=\"flex items-center space-x-2 mt-4\">\n                                    <Checkbox\n                                        id=\"delete-pages\"\n                                        data-testid=\"reset-delete-pages-checkbox\"\n                                        checked={deletePages}\n                                        onCheckedChange={(checked) => setDeletePages(checked as boolean)}\n                                    />\n                                    <Label\n                                        htmlFor=\"delete-pages\"\n                                        className=\"text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70\"\n                                    >\n                                        Also delete all pages created by LPagery\n                                    </Label>\n                                </div>\n                                <div className=\"mt-4\">\n                                    <Label htmlFor=\"confirm-text\" className=\"text-sm font-medium text-gray-700\">\n                                        Type in 'i am sure' to continue\n                                    </Label>\n                                    <Input\n                                        id=\"confirm-text\"\n                                        data-testid=\"reset-confirm-input\"\n                                        type=\"text\"\n                                        value={confirmText}\n                                        onChange={(e) => setConfirmText(e.target.value)}\n                                        onPaste={(e) => e.preventDefault()}\n                                        className=\"mt-1\"\n                                        placeholder=\"i am sure\"\n                                    />\n                                </div>\n                            </div>\n                        </div>\n\n                        <div className=\"mt-5 sm:mt-4 sm:flex sm:flex-row-reverse\">\n                            <Button\n                                data-testid=\"confirm-reset-button\"\n                                type=\"button\"\n                                variant=\"destructive\"\n                                loading={resetDataMutation.isPending}\n                                onClick={handleReset}\n                                disabled={!isConfirmationValid}\n                                className=\"inline-flex w-full justify-center sm:ml-3 sm:w-auto\"\n                            >\n                                {deletePages ? 'Reset Data & Delete Pages' : 'Reset Data'}\n                            </Button>\n                            <Button\n                                data-testid=\"cancel-reset-button\"\n                                type=\"button\"\n                                onClick={onClose}\n                                className=\"mt-3 inline-flex w-full justify-center sm:mt-0 sm:w-auto\"\n                            >\n                                Cancel\n                            </Button>\n                        </div>\n                    </DialogPanel>\n                </div>\n            </div>\n        </Dialog>\n    );\n}; ","import {useForm} from \"react-hook-form\";\nimport {zodResolver} from \"@hookform/resolvers/zod\";\nimport {FormFieldWrapper} from \"@/components/common/FormFieldWrapper\";\nimport {SelectContent, SelectItem, SelectTrigger, SelectValue} from \"@/components/ui/select\";\nimport {DateTimePicker} from \"@/components/ui/date-time-picker\";\nimport {Button} from \"@/components/ui/button\";\nimport {FormSwitch} from \"@/components/ui/form-switch\";\nimport {CustomPostTypeSelect} from \"@/components/dashboard/settings/CustomPostTypeSelect\";\nimport {UserSelect} from \"@/components/dashboard/settings/AuthorSelect\";\nimport {useFetchSettings} from \"@/hooks/settings/use-fetch-settings\";\nimport {useEffect, useState} from \"react\";\nimport {FormSelect} from \"@/components/ui/form-select\";\nimport {useSaveSettings} from \"@/hooks/settings/use-save-settings\";\nimport {toast} from \"sonner\";\nimport {Card} from \"@/components/ui/card\";\nimport {ArrowTopRightOnSquareIcon, Cog6ToothIcon, TableCellsIcon, ExclamationTriangleIcon} from \"@heroicons/react/24/outline\";\nimport {Input} from \"@/components/ui/input\";\nimport {Skeleton} from \"@/components/common/Skeleton\";\nimport {SettingsRead, SettingsReadSchema} from \"@/hooks/settings/schema\";\nimport {useSubscription} from \"@/hooks/subscription/use-subscription\";\nimport {TrackingPermissionDialog} from \"@/components/dashboard/settings/TrackingPermissionDialog\";\nimport {ErrorBoundaryWrapper} from \"@/components/layout/error/ErrorBoundaryWrapper\";\nimport {useTriggerSheetSync} from \"@/hooks/settings/use-trigger-sheet-sync\";\nimport {ResetDataDialog} from \"@/components/dashboard/settings/ResetDataDialog\";\n\n\nexport const SettingsArea = () => {\n\n    const settingsResponse = useFetchSettings();\n\n    const {\n        control,\n        handleSubmit,\n        register,\n        watch,\n        reset,\n        formState: { errors, isDirty }\n    } = useForm<SettingsRead>({\n        resolver: zodResolver(SettingsReadSchema),\n        defaultValues: {\n            hierarchical_taxonomy_handling: 'last',\n            google_sheet_sync_enabled: true,\n            google_sheet_sync_interval: 'hourly',\n            google_sheet_sync_force_update: false,\n            google_sheet_sync_overwrite_manual_changes: false,\n            sync_batch_size: 10,\n            spintax: false,\n            image_processing: true,\n            custom_post_types: [],\n        }\n    });\n\n    useEffect(() => {\n        if (settingsResponse.data) {\n            reset(settingsResponse.data);\n        }\n    }, [settingsResponse.data]);\n\n\n    const saveSettingsMutation = useSaveSettings();\n\n    const { extended } = useSubscription();\n    const [trackingPermissionsDialogOpen, setTrackingPermissionsDialogOpen] = useState(false)\n    const triggerSheetSyncMutation = useTriggerSheetSync();\n    const onSubmit = (data: SettingsRead) => {\n\n        const triggerPromise = saveSettingsMutation.mutateAsync({\n            ...data,\n            next_google_sheet_sync: data.next_google_sheet_sync?.toISOString()\n        });\n        toast.promise(triggerPromise, {\n            loading: 'Saving settings...',\n            success: 'Settings saved successfully',\n            error: 'Failed to save settings'\n        });\n    }\n\n    const [resetDataDialogOpen, setResetDataDialogOpen] = useState(false);\n\n    if (settingsResponse.isLoading) {\n        return <Skeleton></Skeleton>\n    }\n\n    return (\n        <>\n            <Card className={(!extended ? 'opacity-80' : '')}>\n                <ErrorBoundaryWrapper>\n                    <form className=\"p-8 max-w-7xl mx-auto\" onSubmit={handleSubmit(onSubmit)}>\n                        <div className=\"space-y-12\">\n                            <div\n                                className=\"grid grid-cols-1 gap-x-8 gap-y-10 border-b border-gray-900/10 pb-12 md:grid-cols-3\">\n                                <div className=\"flex gap-x-3\">\n                                    <Cog6ToothIcon className=\"h-8 w-8 text-custom-blue-400 flex-shrink-0\" />\n                                    <div>\n                                        <h2 className=\"text-base font-semibold leading-7 text-gray-900\">Personal\n                                            Settings</h2>\n                                        <p className=\"mt-1 text-sm leading-6 text-gray-600\">\n                                            Configure personal settings for your content creation.\n                                        </p>\n                                    </div>\n                                </div>\n\n                                <div className=\"grid  grid-cols-1 gap-x-6 gap-y-8 md:col-span-2 md:pl-8\">\n                                    <div>\n                                        <FormFieldWrapper\n                                            label=\"Spintax\"\n                                            license={'extended'}\n                                            className=\"flex items-center justify-between\"\n                                        >\n                                            <FormSwitch data-testid=\"spintax-switch\" control={control} name={'spintax'} />\n                                        </FormFieldWrapper>\n                                        <p className=\"text-xs leading-6 text-gray-500 max-w-xl\">\n                                            Spintax lets you create unique content by inserting dynamic content. <br/>\n                                            Learn more about spintax <a\n                                                href=\"https://intercom.help/lpagery/en/articles/10012244-insert-dynamic-content-spintax\"\n                                                target=\"_blank\"\n                                                className=\"text-blue-500 inline-flex items-center\">here <ArrowTopRightOnSquareIcon className=\"h-4 w-4 ml-1\" /></a>\n                                        </p>\n                                    </div>\n                                    <div>\n                                        <FormFieldWrapper\n                                            label=\"Image Processing\"\n                                            license={'extended'}\n                                            className=\"flex items-center justify-between\"\n                                        >\n                                            <FormSwitch data-testid=\"image-processing-switch\" control={control} name={'image_processing'} />\n                                        </FormFieldWrapper>\n                                        {watch('image_processing') ? (\n                                            <p className=\"text-xs leading-6 text-gray-500 max-w-xl\">\n                                                Enabled: Image processing is enabled, allowing image replacements in your created pages.\n                                                Learn more about image processing <a\n                                                    href=\"https://intercom.help/lpagery/en/collections/10677566-image-processing\"\n                                                    target=\"_blank\"\n                                                    className=\"text-blue-500 inline-flex items-center\">here <ArrowTopRightOnSquareIcon className=\"h-4 w-4 ml-1\" /></a>\n                                            </p>\n                                        ) : (\n                                            <p className=\"text-xs leading-6 text-gray-500 max-w-xl\">\n                                                Disabled: Image processing is not enabled, and images will not be replaced.\n                                            </p>\n                                        )}\n                                    </div>\n\n                                    <FormFieldWrapper\n                                        label=\"Custom Post Types\"\n                                        error={errors.custom_post_types?.message}\n                                        license={'extended'}\n\n                                        description={<p className=\"   text-xs leading-6 text-gray-500 max-w-xl\">\n                                            Select the custom post types you want to use with LPagery. After selecting\n                                            the custom post types, you will be able to select them in the template page\n                                            selection.\n                                        </p>}\n\n                                    >\n                                        <CustomPostTypeSelect control={control} {...register('custom_post_types')} />\n                                    </FormFieldWrapper>\n\n                                    <FormFieldWrapper\n                                        label=\"Hierarchical Taxonomy Handling\"\n                                        error={errors.custom_post_types?.message}\n                                        license={'extended'}\n\n                                        description={watch('hierarchical_taxonomy_handling') === 'last' ? (\n                                            <p className=\"text-xs leading-6 text-gray-500 max-w-xl\">\n                                                Assign Last: Only the last (deepest) term in the hierarchy will be assigned to the created page. \n                                                For example, with \"Parent {'>'} Child {'>'} Grandchild\", only \"Grandchild\" will be assigned.\n                                            </p>\n                                        ) : (\n                                            <p className=\"text-xs leading-6 text-gray-500 max-w-xl\">\n                                                Assign All: All terms in the hierarchy will be assigned to the created page. \n                                                For example, with \"Parent {'>'} Child {'>'} Grandchild\", all three terms will be assigned.\n                                            </p>\n                                        )}\n\n                                    >\n                                        <FormSelect {...register('hierarchical_taxonomy_handling') } control={control}>\n                                            <SelectTrigger>\n                                                <SelectValue placeholder=\"Assign hierarchical Taxonomies\" defaultValue={'last'}/>\n                                            </SelectTrigger>\n                                            <SelectContent>\n                                                <SelectItem value=\"last\">Assign Last</SelectItem>\n                                                <SelectItem value=\"all\">Assign All</SelectItem>\n                                            </SelectContent>\n                                        </FormSelect>\n                                       \n                                    </FormFieldWrapper>\n\n\n                                    <FormFieldWrapper\n                                        label=\"Select Author\"\n                                        error={errors.author_id?.message}\n                                        license={'extended'}\n                                        description={<p className=\"text-xs leading-6 text-gray-500 max-w-xl\">\n                                            The created pages will have the selected author as the author.\n                                        </p>}\n                                    >\n                                        <UserSelect data-testid=\"author-select\" control={control} {...register('author_id')} />\n                                    </FormFieldWrapper>\n\n                                    {extended && (\n                                        <div>\n                                            <Button\n                                                data-testid=\"tracking-permissions-button\"\n                                                variant={'outline'}\n                                                onClick={(e) => {\n                                                    e.preventDefault()\n                                                    setTrackingPermissionsDialogOpen(true)\n                                                }}\n                                            >\n                                                Change Tracking Permissions\n                                            </Button>\n                                        </div>\n                                    )}\n                                    <div className=\"flex justify-end space-x-4\">\n                                        <Button type=\"submit\" loading={saveSettingsMutation.isPending} disabled={!isDirty}>Save All Settings</Button>\n                                    </div>\n                                </div>\n                            </div>\n\n                            <div\n                                className=\"grid grid-cols-1 gap-x-8 gap-y-10 border-b border-gray-900/10 pb-12 md:grid-cols-3\">\n                                <div className=\"flex gap-x-3\">\n                                    <TableCellsIcon className=\"h-8 w-8 text-custom-blue-400 flex-shrink-0\" />\n                                    <div>\n                                        <h2 className=\"text-base font-semibold leading-7 text-gray-900\">Google Sheet\n                                            Sync\n                                            Settings</h2>\n                                        <p className=\"mt-1 text-sm leading-6 text-gray-600\">\n                                            Configure Google Sheet sync settings.\n                                        </p>\n                                    </div>\n                                </div>\n                              \n\n                                <div className=\"grid grid-cols-1 gap-x-6 gap-y-8 md:col-span-2 md:pl-8\">\n                                    {settingsResponse.data?.wp_cron_disabled && (\n                                        <div className=\"border-l-4 border-yellow-400 bg-yellow-50 p-4\">\n                                            <p className=\"text-xs leading-6 text-gray-600\">\n                                                Important: Since WP Cron is disabled (DISABLE_WP_CRON constant is set), automatic syncing will not work through WordPress. You'll need to configure a server-level cron job to handle the synchronization or remove the constant from wp-config.php.\n                                            </p>\n                                        </div>\n                                    )}\n                                    <div\n\n                                        className={!extended ? 'cursor-pointer' : ''}\n                                    >\n                                        <FormFieldWrapper\n                                            label=\"Google Sheet Sync\"\n                                            license={'extended'}\n                                            className=\"flex items-center justify-between\"\n                                        >\n                                            <FormSwitch\n                                                data-testid=\"google-sheet-enabled-switch\"\n                                                control={control}\n                                                name={'google_sheet_sync_enabled'}\n                                            />\n                                        </FormFieldWrapper>\n                                        {watch('google_sheet_sync_enabled') ? (\n                                            <p className=\"text-xs leading-6 text-gray-500 max-w-xl\">\n                                                Enabled: Google Sheet synchronization is active. Changes in your Google Sheets will be synchronized according to your settings.\n                                                <br />\n                                            </p>\n                                        ) : (\n                                            <p className=\"text-xs leading-6 text-gray-500 max-w-xl\">\n                                                Disabled: Google Sheet synchronization is not active. No automatic\n                                                updates will occur from your Google Sheets.\n                                                <br/>\n                                                <span className=\"text-red-500\">Note: This is global and will disable Google Sheet sync for all Page Sets.</span>\n\n                                            </p>\n                                        )}\n                                    </div>\n\n\n                                    <div\n                                        className={`grid grid-cols-1 gap-y-8 ${!watch('google_sheet_sync_enabled') ? 'opacity-50 pointer-events-none' : ''}`}>\n                                        <div\n\n                                            className={!extended ? 'cursor-pointer' : ''}\n                                        >\n                                            <FormFieldWrapper\n                                                label=\"Google Sheet Sync Interval\"\n                                                error={errors.google_sheet_sync_interval?.message}\n                                                license={'extended'}\n                                                description={<p className=\"text-xs leading-6 text-gray-500 max-w-xl\">\n                                                    Decide how often LPagery should look for changes in your Google\n                                                    Sheet.\n                                                </p>}\n                                            >\n                                                <FormSelect {...register('google_sheet_sync_interval')}\n                                                    control={control}\n                                                    data-testid=\"google-sheet-sync-interval-select\"\n                                                >\n                                                    <SelectTrigger>\n                                                        <SelectValue placeholder=\"Select interval\" />\n                                                    </SelectTrigger>\n                                                    <SelectContent>\n                                                        <SelectItem value=\"hourly\">Hourly</SelectItem>\n                                                        <SelectItem value=\"daily\">Daily</SelectItem>\n                                                        <SelectItem value=\"twicedaily\">Twice Daily</SelectItem>\n                                                        <SelectItem value=\"weekly\">Weekly</SelectItem>\n                                                    </SelectContent>\n                                                </FormSelect>\n                                            </FormFieldWrapper>\n                                        </div>\n                                        <div\n                                            className={!extended ? 'cursor-pointer' : ''}\n                                        >\n                                            <FormFieldWrapper\n                                                label=\"Next Sync\"\n                                                error={errors.next_google_sheet_sync?.message}\n                                                license={'extended'}\n                                                description={<p className=\"text-xs leading-6 text-gray-500 max-w-xl\">\n                                                    The next sync will run at the selected date and time.\n                                                </p>}\n                                            >\n                                                <div className=\"flex gap-4\">\n                                                    {extended ? <DateTimePicker\n                                                        data-testid=\"next-sync-datetime-picker\"\n                                                        control={control}\n                                                        {...register('next_google_sheet_sync')}\n                                                    /> : <Input type=\"text\" disabled value={'disabled'} />}\n                                                    <Button variant={'outline'} data-testid=\"sync-now-button\" onClick={(e) => {\n                                                        e.preventDefault()\n                                                        const triggerPromise = triggerSheetSyncMutation.mutateAsync({})\n                                                        toast.promise(triggerPromise, {\n                                                            loading: 'Starting sync...',\n                                                            success: 'Sync started successfully',\n                                                            error: 'Failed to start sync'\n                                                        });\n                                                    }} loading={triggerSheetSyncMutation.isPending}>Sync Now</Button>\n                                                </div>\n                                            </FormFieldWrapper>\n                                        </div>\n\n                                        <div\n\n                                            className={!extended ? 'cursor-pointer' : ''}\n                                        >\n                                            <FormFieldWrapper\n                                                label=\"Batch Size\"\n                                                error={errors.sync_batch_size?.message}\n                                                license={'extended'}\n                                                description={<p className=\"text-xs leading-6 text-gray-500 max-w-xl\">\n                                                    The number of pages to be processed at a time. Lower this value to\n                                                    reduce the load on your server.\n                                                </p>}\n                                            >\n                                                <Input type={'number'} step={1}\n                                                    min={1} {...register('sync_batch_size')}\n                                                    data-testid=\"sync-batch-size-input\"\n                                                />\n                                            </FormFieldWrapper>\n                                        </div>\n                                        <div\n\n                                            className={!extended ? 'cursor-pointer' : ''}\n                                        >\n                                            <FormFieldWrapper\n                                                label=\"Force Update\"\n                                                license={'extended'}\n                                                className=\"flex items-center justify-between\"\n                                            >\n                                                <FormSwitch data-testid=\"force-update-switch\" control={control} name=\"google_sheet_sync_force_update\" />\n                                            </FormFieldWrapper>\n\n                                            {watch('google_sheet_sync_force_update') ? (\n                                                <p className=\"   text-xs leading-6 text-gray-500 max-w-xl \">\n                                                    Enabled: Each page will be re-generated every time the sync runs,\n                                                    ensuring\n                                                    updates are always applied. This may increase resource usage.\n                                                </p>\n                                            ) : (\n                                                <p className=\"   text-xs leading-6 text-gray-500 max-w-xl \">\n                                                    Disabled: Pages will only update if needed, conserving resources.\n                                                    Learn\n                                                    more <a\n                                                        href=\"https://intercom.help/lpagery/en/articles/10233222-google-sheet-sync-advanced-settings\" target=\"_blank\"\n                                                        className=\"text-blue-500 inline-flex items-center\">here <ArrowTopRightOnSquareIcon\n                                                            className=\"h-4 w-4 ml-1\" /> </a>\n                                                </p>\n                                            )}\n                                        </div>\n\n                                        <div\n\n                                            className={!extended ? 'cursor-pointer' : ''}\n                                        >\n                                            <FormFieldWrapper\n                                                label=\"Overwrite Manual Changes\"\n                                                license={'extended'}\n                                                className=\"flex items-center justify-between\"\n                                            >\n                                                <FormSwitch data-testid=\"overwrite-manual-changes-switch\" control={control}\n                                                    name=\"google_sheet_sync_overwrite_manual_changes\" />\n                                            </FormFieldWrapper>\n\n                                            {watch('google_sheet_sync_overwrite_manual_changes') ? (\n                                                <>\n                                                    <p className=\"   text-xs leading-6 text-gray-500 max-w-xl\">\n                                                        Enabled: Pages with manual edits will be updated with the latest\n                                                        data\n                                                        and template design,\n                                                        overwriting any existing changes.\n                                                    </p>\n                                                    <p className=\"   text-xs leading-6 text-red-500 max-w-xl\">\n                                                        Note: Enabling this will overwrite any manual changes to content\n                                                        or\n                                                        design made in the created pages on the next sync run.\n                                                    </p>\n                                                </>\n                                            ) : (\n                                                <>\n                                                    <p className=\"   text-xs leading-6 text-gray-500 max-w-xl\">\n                                                        Disabled: Only configuration updates will apply to pages with\n                                                        manual\n                                                        changes, preserving manual\n                                                        modifications. Force update will be ignored for these pages with\n                                                        manual\n                                                        changes.\n                                                        Learn\n                                                        more <a\n                                                        href=\"https://intercom.help/lpagery/en/articles/10233222-google-sheet-sync-advanced-settings\" target=\"_blank\"\n                                                        className=\"text-blue-500 inline-flex items-center\">here <ArrowTopRightOnSquareIcon\n                                                        className=\"h-4 w-4 ml-1\" /> </a>\n                                                    </p>\n                                                </>\n                                            )}\n                                        </div>\n                                        {/*<div className=\"sm:col-span-4\">*/}\n                                        {/*    <p className=\"text-sm text-gray-600\">Last Sync Finished: 12 minutes ago</p>*/}\n                                        {/*    <p className=\"text-sm text-gray-600\">Last Sync Duration: 3 Seconds</p>*/}\n                                        {/*</div>*/}\n                                    </div>\n                                </div>\n\n                            </div>\n                            <div className=\"flex justify-end space-x-4\">\n                                <Button data-testid=\"save-settings-button\" type=\"submit\" loading={saveSettingsMutation.isPending} disabled={!isDirty}>Save All Settings</Button>\n                            </div>\n                        </div>\n\n                    </form>\n                </ErrorBoundaryWrapper>\n            </Card>\n\n            <Card className=\"mt-8\">\n                <ErrorBoundaryWrapper>\n                    <div className=\"p-8 max-w-7xl mx-auto\">\n                        <div className=\"grid grid-cols-1 gap-x-8 gap-y-10 md:grid-cols-3\">\n                            <div className=\"flex gap-x-3\">\n                                <ExclamationTriangleIcon className=\"h-8 w-8 text-red-600 flex-shrink-0\" />\n                                <div>\n                                    <h2 className=\"text-base font-semibold leading-7 text-gray-900\">Danger Zone</h2>\n                                    <p className=\"mt-1 text-sm leading-6 text-gray-600\">\n                                        Irreversible and destructive actions.\n                                    </p>\n                                </div>\n                            </div>\n\n                            <div className=\"grid grid-cols-1 gap-x-6 gap-y-8 md:col-span-2 md:pl-8\">\n                                <div className=\"rounded-md border border-red-300 