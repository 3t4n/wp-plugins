.ajaxparentformsearchwrapper {
    max-width: 100% !important;
    overflow-x: hidden;
    padding: 0;
}

.ajaxsearchformparentwrapper {
    width: auto;
    background: #efefef;
    padding: 10px;
    margin: 0 auto 20px auto;
    border: 1px solid #dddddd;
    overflow: hidden;
}

.ajaxsearchformparentwrapper input {
    width: 90%;
    padding: 10px;
    margin: 0 auto;
    display: block;
}

#ajax-search-results {
    display: none;
    margin-top: 10px;
    padding: 10px;
    border: 1px solid #ddd;
    background-color: #f9f9f9;
}

#ajax-search-results {
    width: auto;
    background: #ddd;
    padding: 10px;
}

#ajax-search-results ul {
    list-style: none;
    padding: 10px 10px;
    display: flex;
    background: #efefef;
    margin: 0;
    border-bottom: 1px solid #c4c4c4;
    align-items: center;
    position: relative;
}

#ajax-search-results li a {
    font-weight: bold;
    color: #454545;
    text-decoration: none;
    font-size: 16px;
}

#ajax-search-results li p {
    font-size: 12px;
    color: #555;
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
}

#ajax-search-results li:hover {
    background-color: #f1f1f1;
}

#ajax-search-results li img.post-image {
    max-width: 100%;
    height: 100px;
    width: 100px;
}

#ajax-search-results ul li.imgboxsearchresult {
    margin-right: 10px;
}
#ajax-search-results ul li {
    list-style: none !important;
}

#ajax-search-results ul li.imgboxsearchresult img.post-image {
    height: 50px;
    width: 50px;
    border: 1px solid #b2b2b2;
    border-radius: 100px;
}

#ajax-search-results li.viewmorebtnbox {
    position: absolute;
    right: 20px;
}

#ajax-search-results li.viewmorebtnbox a.viewbtnajaxsearch {
    font-size: 13px !important;
    font-weight: 400 !important;
    background: #fff;
    padding: 5px 10px;
    border-radius: 100px;
}
