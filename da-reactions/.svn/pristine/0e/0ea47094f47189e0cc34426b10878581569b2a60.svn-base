<?php
/**
 * @var string $src
 * @var string $alt
 * @var string $size
 * @var string $style
 */
?>
<img src="<?php echo esc_url( $src ) ?>" alt="<?php echo esc_attr( $alt ) ?>"
     width="<?php echo esc_attr( $size ) ?>"
     height="<?php echo esc_attr( $size ) ?>" <?php echo esc_attr( $style ) ?> />
