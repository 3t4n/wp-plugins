<h1>Ebay Dropship Settings</h1>
<div class="e2wl-content">
    <ul class="nav nav-tabs">
      <?php foreach ($modules as $module): ?>
      <li role="presentation" class="<?php echo esc_attr($current_module == $module['id'] ? 'active' : ''); ?>"><a href="<?php echo esc_url(admin_url('admin.php?page=e2wl_setting&subpage=' . $module['id'])); ?>"><?php echo esc_html($module['name']); ?></a></li>
      <?php endforeach;?>
    </ul>
