:"";s:9:"ss_photos";s:0:"";s:11:"ss_feed_url";s:0:"";s:17:"bg_parallax_image";s:0:"";s:8:"bg_color";s:0:"";}}}s:13:"5e0078daec5b1";O:8:"stdClass":5:{s:4:"node";s:13:"5e0078daec5b1";s:4:"type";s:6:"module";s:6:"parent";s:13:"5e0078daec4d2";s:8:"position";i:0;s:8:"settings";O:8:"stdClass":160:{s:11:"heading_tag";s:2:"h2";s:13:"heading_title";s:78:"مختصری در مورد زندگینامه دکتر الهیار گرامی";s:12:"dual_heading";s:2:"no";s:14:"heading_title2";s:15:"Secondary Title";s:13:"heading_style";s:12:"inline-block";s:17:"heading_alignment";s:5:"right";s:24:"heading_alignment_medium";s:6:"center";s:28:"heading_alignment_responsive";s:6:"center";s:11:"enable_link";s:3:"yes";s:12:"heading_link";s:0:"";s:21:"heading_link_nofollow";s:2:"no";s:17:"heading_sub_title";s:2022:"<p style="text-align: justify;">ایشان در سال یکهزار و سیصد وچهل و پنج در کرمانشاه متولد شدند. بعد از پایان کلاس اول ابتدایی به دلیل شغل پدر به همراه خانواده به شهر تهران منتقل شدند. دوران ابتدایی را در دبستان نهال آرزو گذراندند و در سال ۱۳۵۹  وارد دبیرستان البرز شدند و موفق به پشت سر گذاشتن دوران دبیرستان در سه سال شدند.<br /> ایشان حضور در دبیرستان البرز را به عنوان بهترین و مهیج ترین سال های زندگی خود می دانند و معتقدند تاثیر آن سال ها، همواره در زندگی ایشان در جریان است.  دکتر گرامی آموزش دیدن از آموزگاران بزرگ دبیرستان البرز را با حسی خوشایند همراه می دانند که فرصتی مغتنم برای یادگیری و آموزش به حساب می آمد.</p><p style="text-align: justify;">دکتر الهیار گرامی در سال ۱۳۶۲ پس از اخد مدرک دیپلم، وارد دانشکده دندان پزشکی، دانشگاه علوم پزشکی تهران شدند  و در سال ۱۳۶۸ با راهنمایی استاد فقید دکتر سید مهدی فرمند پایان نامه تحقیقاتی خود را نگارش کردند. ایشان دورانی را که در دانشگاه تهران پشت سرگذاشتند را نیز به عنوان سال های تکرارنشدنی و به یادماندنی عمر خود بر زبان می آورند. دکتر گرامی درهمان سال، پس از قبولی در کنکور در رشته ارتدنسی دانشگاه علوم پزشکی تهران  وارد عرصه تخصص شدند  و توانستند به هدف خود در دوران دندان پزشکی جامه عمل بپوشانند.</p>";s:17:"heading_separator";s:9:"no_spacer";s:25:"heading_separator_postion";