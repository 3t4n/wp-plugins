    position: static;
}
.dv-sr-blog-02 .news-section-left-part .news-item-1 .uabb-blog-post-inner-wrap .uabb-blog-post-content, .dv-sr-blog-02 .news-section-left-part .news-item-3 .uabb-blog-post-inner-wrap .uabb-blog-post-content{
    order: 1;
}
.news-section{position: relative;}
.dv-sr-blog-02 .fl-col-group{position: relative; z-index:10;}
.dv-sr-blog-02 .news-section-left-part .news-item .uabb-blog-post-inner-wrap .uabb-post-thumbnail{
    position: relative;
    max-height: 170px;
    overflow: hidden;
}
.dv-sr-blog-02 .news-section-left-part .news-item .uabb-blog-post-inner-wrap .uabb-post-thumbnail:before{z-index:11;}
.dv-sr-blog-02 .news-section-left-part .news-item-1 .uabb-blog-post-inner-wrap .uabb-post-thumbnail:before, .dv-sr-blog-02 .news-section-left-part .news-item-3 .uabb-blog-post-inner-wrap .uabb-post-thumbnail:before{display: flex;content:"";position: absolute;width: 0;height: 0;border-top: 20px solid transparent;border-right: 20px solid white;border-bottom: 20px solid transparent;top: 50%;margin-top: -20px;}
.dv-sr-blog-02 .news-section-left-part .news-item-2 .uabb-blog-post-inner-wrap .uabb-post-thumbnail:before{left:0; display: flex;content:"";position: absolute;width: 0;height: 0;border-top: 20px solid transparent;border-left: 20px solid white;border-bottom: 20px solid transparent;top: 50%;margin-top: -20px;}
.dv-sr-blog-02 .news-item .uabb-blog-post-inner-wrap .uabb-post-thumbnail{
    opacity: 0.8;
    transition: 0.3s;
}
.dv-sr-blog-02 .news-item:hover .uabb-blog-post-inner-wrap .uabb-post-thumbnail{
    opacity: 1;
}

@media screen and (max-width: 1200px){
