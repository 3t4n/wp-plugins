}
.dv-sr-blog-10 .article-section-content .uabb-blog-post-contents:hover .uabb-blog-post-content{
    -webkit-transform: rotateY(0);
    -moz-transform: rotateY(0);
    -ms-transform: rotateY(0);
    -o-transform: rotateY(0);
    transform: rotateY(0);
    opacity: 1;
