"stdClass":2:{s:3:"css";s:1369:".dv-industry-items .uabb-info-list-wrapper{
    display: flex;
    flex-wrap: wrap;
}
.dv-industry-items .uabb-info-list-wrapper li{
    width: 46%;
    margin: 2%;
    background-color: #555;
    padding: 20px;
    transition: 0.3s;
}
.dv-industry-items .uabb-info-list-wrapper li .uabb-info-list-content-wrapper{
    display: flex;
    align-items: center;
}
.dv-industry-items .uabb-info-list-wrapper li:hover{
    background-color: #fff;
}
.dv-industry-items .uabb-info-list-wrapper li:hover .uabb-info-list-title{
    color:#F15A22;
}

.dv-industry-img .pp-photo-content-inner{
    position: relative;
    overflow: visible!important;
    transition: 0.3s;
}
.dv-industry-img .pp-photo-content-inner:hover{
    transform: scale(1.05);
}
.dv-industry-img .pp-photo-content-inner:before{
    position: absolute;
    content:"";display: block;
    width: 100%;height: 100%;
    right: -40px;
    bottom: -40px;
    background-color: #F15A22;
    z-index: -1;
    transition: 0.3s;
}
.dv-industry-img .pp-photo-content-inner:hover:before{
    right: -20px;
    bottom: -20px;
}
@media screen and (max-width: 768px) {
    .dv-industry-img .pp-photo-content-inner:before{
        display: none;
    }
        .dv-industry-items .uabb-info-list-wrapper li .uabb-info-list-content-wrapper{
