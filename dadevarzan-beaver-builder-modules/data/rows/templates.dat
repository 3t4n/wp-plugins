.dv-sr-blog-02 .news-section-left-part .news-item-1 .uabb-blog-post-inner-wrap .uabb-post-thumbnail,.dv-sr-blog-02 .news-section-left-part .news-item-3 .uabb-blog-post-inner-wrap .uabb-post-thumbnail{
    order: 2;
