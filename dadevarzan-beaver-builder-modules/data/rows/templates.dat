h1576912331156_part_custom_code";s:0:"";s:46:"flrich1576912331211_uabb_particles_custom_code";s:0:"";s:36:"flrich1577007705218_part_custom_code";s:0:"";s:46:"flrich1577007705312_uabb_particles_custom_code";s:0:"";}}}s:8:"settings";O:8:"stdClass":2:{s:3:"css";s:2572:".pp-hover-card.style-12 .pp-hover-card-content .pp-hover-card-description {
   border-right: none !important;
   margin: 0 0 3em 0;
    max-width: 100%;
    padding: 0;
   
}

.pp-hover-card{
    margin: 0;
    transform: skewX(-11.5deg);
    -webkit-transform: skewX(-11.5deg);
    /* overflow: hidden; */
}
.pp-hover-card:hover .pp-more-link-container {
     transform: translateY(-10px);
    -webkit-transform: translateY(-10px);
}


.pp-hover-card:after {
    position: absolute;
    content: '';
    bottom:0;
    left: 0;
    right: 0;
    width: 100%;
    height: 150px;
    z-index: 1;
    transition: all 0.5s;
    -webkit-transition: all 0.5s;
    background: transparent;
    background: -moz-linear-gradient(top, transparent 0%, #000 100%);
    background: -webkit-gradient(left top, left bottom, color-stop(0%, transparent), color-stop(100%, #000));
    background: -webkit-linear-gradient(top, transparent 0%, #000 100%);
    background: -o-linear-gradient(top, transparent 0%, #000 100%);
    background: -ms-linear-gradient(top, transparent 0%, #000 100%);
    background: linear-gradient(to bottom, transparent 0%, #000 100%);
    filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#ffffff', endColorstr='#000000', GradientType=0 );
    opacity: 1;
}
.pp-hover-card:hover:after {
  height: 400px;
   
}


.pp-hover-card-inner {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 50px !important;
   
}

.pp-hover-card-inner .pp-hover-card-content{
    transform: skewX(11deg);
    -webkit-transform: skewX(11deg);
}
.pp-hover-card.style-12 .pp-hover-card-inner:before {
    background: #e31d1b;
    width: 160%;

}
@media screen and (max-width: 1200px){
     .pp-hover-card{
    margin: 0;
    transform: skewX(0);
    -webkit-transform: skewX(0);
    }
    .pp-hover-card-inner .pp-hover-card-content{
        transform: skewX(0);
        -webkit-transform: skewX(0);
    }
}
@media screen and (max-width: 992px){
     .pp-hover-card{
    margin: 0;
    transform: skewX(0);
    -webkit-transform: skewX(0);
    }
    .pp-hover-card-inner .pp-hover-card-content{
        transform: skewX(0);
        -webkit-transform: skewX(0);
    }
}
@media screen and (max-width: 768px){
    .pp-hover-card{
    margin: 0;
    transform: skewX(0);
    -webkit-transform: skewX(0);
    }
    .pp-hover-card-inner .pp-hover-card-content{
        transform: skewX(0);
        -webkit-transform: skewX(0);
    }
}
