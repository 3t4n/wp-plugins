:0:"";s:24:"flrich1543756489003_text";s:0:"";s:24:"flrich1547019958266_text";s:0:"";s:24:"flrich1547020096749_text";s:0:"";}}s:13:"5e0078dac0335";O:8:"stdClass":5:{s:4:"node";s:13:"5e0078dac0335";s:4:"type";s:6:"module";s:6:"parent";s:13:"5e0078dabfeff";s:8:"position";i:11;s:8:"settings";O:8:"stdClass":175:{s:13:"preview_modal";s:1:"0";s:12:"enable_title";s:1:"0";s:5:"title";s:0:"";s:15:"title_alignment";s:4:"left";s:12:"content_type";s:7:"content";s:10:"ct_content";s:1087:"<p><img class="alignright size-full wp-image-23727" src="http://behko.webexir.net/wp-content/uploads/2018/12/BPR-BPI.jpg" alt="" width="240" height="160" /></p><p>مهندسی مجدد فرآیندهای کسب و کار (BPR) یکی از نقاط تمایز ERP با نرم افزارهای MIS می باشد. ERP بهکو توسط یک تیم کارشناسی متخصص از رشته های مختلف و در چارچوب متدلوژی استقرار بهکو که روشی نظام یافته و استاندارد می باشد، طی پنج فاز استقرار می یابد.  یکی از مهمترین فازهای اجرایی، مهندسی فرآیندها می باشد که قبل از پیاده سازی نرم افزار، فرآیندهای کسب و کار را شناسایی کرده و با هدف ایجاد یکپارچگی، افزایش بهره وری، کنترلهای هوشمند و سرعت اجرا، باز مهندسی کرده و پس از تأیید کارفرما، مبنای استقرار نرم افزار قرار خواهند گرفت.</p>";s:8:"ct_photo";s:0:"";s:12:"ct_photo_src";s:0:"";s:8:"ct_video";s:0:"";s:13:"ct_saved_rows";s:4:"4847";s:16:"ct_saved_modules";s:5:"23687";s:17:"ct_page_templates";s:4:"5299";s:9:"video_url";s:0:"";s:11:"video_ratio";s:4:"16_9";s:14:"video_autoplay";s:2:"no";s:22:"youtube_related_videos";s:2:"no";s:23:"youtube_player_controls";s:2:"no";s:10:"iframe_url";s:0:"";s:13:"iframe_height";s:3:"360";s:12:"async_iframe";s:2:"no";s:11:"modal_width";s:3:"700";s:12:"modal_effect";s:13:"uabb-effect-1";s:16:"content_bg_color";s:6:"ffffff";s:13:"overlay_color";s:6:"000000";s:17:"overlay_color_opc";s:2:"75";s:8:"modal_on";s:6:"custom";s:9:"all_align";s:4:"left";s:4:"icon";s:0:"";s:9:"icon_size";s:2:"30";s:10:"icon_color";s:0:"";s:16:"icon_hover_color";s:0:"";s:5:"photo";s:0:"";s:9:"photo_src";s:0:"";s:8:"img_size";s:0:"";s:10:"modal_text";