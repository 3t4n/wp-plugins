    display: flex;
    flex-wrap: wrap;
}
.dv-sr-service-05 .services-part .uabb-module-content a{z-index:15;}
.dv-sr-service-05 .services-part .uabb-module-content{
    border-radius:  10px;
    overflow:  hidden;
    box-shadow: 0 4px 8px rgba(4,4,4,.18);
}
.dv-sr-service-05 .services-part .uabb-module-content .uabb-ultb3-info{
    display:  flex;
    position:  relative;
    z-index:  11;
    flex-wrap:  wrap;
    align-items:  center;
    justify-content:  center;
    padding:  0;
}
.dv-sr-service-05 .services-part .uabb-module-content:hover .uabb-ultb3-info .uabb-ultb3-title{
    margin-bottom: 25px;
    border-color: rgba(255, 255, 255, 0.5);
    background-color: rgba(255, 144, 0, 0.65);
    cursor:  pointer;
}
.dv-sr-service-05 .services-part .uabb-module-content .uabb-ultb3-info .uabb-ultb3-desc{
    order: 1;
    width:  100%;
}
.dv-sr-service-05 .services-part .uabb-module-content .uabb-ultb3-info .uabb-ultb3-desc img{
    transition: all 0.5s;
}
.dv-sr-service-05 .services-part .uabb-module-content:hover .uabb-ultb3-info .uabb-ultb3-desc img{transform: rotateY(270deg);opacity: 0;}
.dv-sr-service-05 .services-part .uabb-module-content .uabb-ultb3-info .uabb-ultb3-title{
    order: 2;
    width: auto;
    padding: 8px 25px;
    border: 1px solid #fff0;
    transition: all 0.5s;
    margin-bottom: 15px;
}
.dv-sr-service-05 .services-part .uabb-module-content:hover:before{opacity:  0;}
.dv-sr-service-05 .services-part .uabb-module-content:hover:after{opacity: 1;}
.dv-sr-service-05 .services-part .uabb-module-content:after{display:block;content:"";position:  absolute;left:  0;right: 0;top: 0;bottom:  0;background: -webkit-linear-gradient(bottom, rgba(0, 0, 0, 0.5) 10%,rgba(0,0,0,0) 100%); /* Chrome10-25,Safari5.1-6 */z-index: 10;transition: all 0.5s;opacity: 0;}
.dv-sr-service-05 .services-part .uabb-module-content:before{display:block;content:"";position:  absolute;left:  0;right: 0;top: 50px;bottom:  0;background: -webkit-linear-gradient(bottom, rgba(0, 0, 0, 0.8) 10%,rgba(0,0,0,0) 100%); /* Chrome10-25,Safari5.1-6 */z-index: 10;transition: all 0.5s;}
.dv-sr-service-05 .services-part .uabb-module-content .uabb-ultb3-img{
    width: 100% !important;
}
@media screen and (max-width: 1200px){
    .dv-sr-service-05 .services-part .uabb-module-content .uabb-ultb3-img{
    height: 100% !important; 
}
}
@media screen and (max-width: 992px){
	.dv-sr-service-05 .fl-col-group-responsive-reversed .fl-col-small.dv-force{
		order: 1;
	}
}
@media screen and (max-width: 768px){
	.dv-sr-service-05 .services-part .uabb-module-content {
		max-width: 540px;
		margin: 0 auto;
	}
	.dv-sr-service-05 .fl-col-group-responsive-reversed .fl-col-small.dv-force{
		order: 12;
	}
}
