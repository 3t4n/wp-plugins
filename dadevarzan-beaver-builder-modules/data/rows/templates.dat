					<style>
					#seihawi-map{
						display: block;
						position: relative;
						direction: rtl;
						text-align: right;
						padding: 0;
						font-family: Tahoma;
						font-size: 11px;
						width: 90%;
						margin: 50px auto;
					}


					#seihawi-map .border path, #seihawi-map .island path{
						fill: #7777;
					}
					#seihawi-map .province path{
						fill: #f9f9f9;
					}
					#seihawi-map .sea path, #seihawi-map .lake path{
						fill: #45baef;
					}
					#seihawi-map .province path:hover, #seihawi-map .island path:hover, #seihawi-map .province path.hover, #seihawi-map .island path.hover{
						fill: #00a745; !important;
						cursor: pointer;
					}

					@media(max-width: 930px){
					}
					@media(max-width: 745px){
					}
					@media(max-width: 515px){
					}
					@media(max-width: 515px){
					}
					@media(max-width: 250px){
					}					
					.state-item text{opacity:0;}
					.state-item:hover text{opacity:1;}
					</style>
