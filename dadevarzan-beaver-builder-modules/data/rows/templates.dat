pe";s:7:"content";s:10:"ct_content";s:675:"<p><img class="size-full wp-image-23717 alignleft" src="http://behko.webexir.net/wp-content/uploads/2018/12/Windwos-Web.jpg" alt="" width="240" height="160" /></p><p>ERP بهکو با تکنولوژی دات نت و تحت ویندوز تولید شده است که ضمن داشتن قابلیتهای بالای ویندوز در پشتیبانی از حجم بالای داده و سرعت اجرای تراکنشها، امکان بهره برداری از نرم افزار تحت وب نیز وجود خواهد داشت. همچنین امکان استفاده از نرم افزار از طریق ابزارهای موبایل و تبلت نیز وجود دارد.</p>";s:8:"ct_photo";s:0:"";s:12:"ct_photo_src";s:0:"";s:8:"ct_video";s:0:"";s:13:"ct_saved_rows";s:4:"4847";s:16:"ct_saved_modules";s:5:"23687";s:17:"ct_page_templates";s:4:"5299";s:9:"video_url";s:0:"";s:11:"video_ratio";s:4:"16_9";s:14:"video_autoplay";s:2:"no";s:22:"youtube_related_videos";s:2:"no";s:23:"youtube_player_controls";s:2:"no";s:10:"iframe_url";s:0:"";s:13:"iframe_height";s:3:"360";s:12:"async_iframe";s:2:"no";s:11:"modal_width";s:3:"900";s:12:"modal_effect";s:13:"uabb-effect-1";s:16:"content_bg_color";s:6:"ffffff";s:13:"overlay_color";s:6:"000000";s:17:"overlay_color_opc";s:2:"75";s:8:"modal_on";s:6:"custom";s:9:"all_align";s:4:"left";s:4:"icon";s:0:"";s:9:"icon_size";s:2:"30";s:10:"icon_color";s:0:"";s:16:"icon_hover_color";s:0:"";s:5:"photo";s:0:"";s:9:"photo_src";s:0:"";s:8:"img_size";s:0:"";s:10:"modal_text";s:10:"Click Here";s:10:"text_color";s:0:"";s:16:"text_hover_color";s:0:"";s:8:"btn_text";s:10:"Click Here";s:9:"btn_style";s:4:"flat";s:15:"btn_border_size";s:0:"";s:30:"btn_transparent_button_options";s:16:"transparent-fade";s:25:"btn_threed_button_options";s:11:"threed_down";s:23:"btn_flat_button_options";s:4:"none";s:8:"btn_icon";s:0:"";s:17:"btn_icon_position";s:6:"before";s:14:"btn_text_color";s:0:"";s:20:"btn_text_hover_color";s:0:"";s:12:"btn_bg_color";s:0:"";s:16:"btn_bg_color_opc";s:0:"";s:18:"btn_bg_hover_color";s:0:"";s:22:"btn_bg_hover_color_opc";s:0:"";s:15:"hover_attribute";s:2:"bg";s:9:"btn_width";s:4:"auto";s:16:"btn_custom_width";s:3:"200";s:17