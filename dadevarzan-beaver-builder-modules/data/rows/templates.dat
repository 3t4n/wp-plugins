    text-align: justify;
}
.dv-sr-text-07 .about-section-text-contet-iiner-page .fl-col-content{
    position: relative;
}
.dv-sr-text-07 .about-section-text-owner{
    position: absolute;
    left: 0;
    bottom: 0;
    right: 0;
}
.dv-sr-text-07 .about-us-counter-parts .uabb-number-text{
    display: flex;
    flex-wrap: wrap;
    align-items: center;
}
.dv-sr-text-07 .about-us-counter-parts .uabb-number-text .uabb-number-before-text{
    margin: 0;
    width: calc(100% - 150px);
    order: 2;
    text-align: right;
}
.dv-sr-text-07 .about-us-counter-parts .uabb-number-text .uabb-number-string.uabb-number-animated{
    width: 150px;
    order: 1;
    margin-top: 8px;
}
.dv-sr-text-07 .about-us-table-section .about-us-table-section-heading{
    background-color: #428bca;
}
.dv-sr-text-07 .about-us-table-section .fl-col-content .about-us-counter-parts:nth-child(odd){
    background-color: #f9f9f9;
}
.dv-sr-text-07 .about-us-table-section .fl-col-content .about-us-counter-parts:nth-child(even){
    background-color: #efefef;
}
.dv-sr-text-07 .about-us-section .fl-col-group > div{
    max-width: inherit;
}
@media (max-width: 992px){
    .dv-sr-text-07 .about-us-counter-parts .uabb-number-text .uabb-number-string.uabb-number-animated{
        width: 50px;margin-left: 20px;
    }
    .dv-sr-text-07 .about-us-counter-parts .uabb-number-text .uabb-number-before-text{
        width: calc(100% - 70px);
    }
}
