    display: flex;
    align-items: top;
}
.dv-benefits .pp-heading-content .pp-sub-heading{
    order: 1;
    width: calc(100% - 100px);
    border-bottom: 2px solid #235aa4;
    padding-bottom: 40px;
}
.dv-left-benefits.dv-benefits .pp-heading-content .pp-sub-heading{
    order: inherit;
}
.dv-benefits .pp-heading-content .pp-sub-heading p{
    padding-left: 15px;
}
.dv-left-benefits.dv-benefits .pp-heading-content .pp-sub-heading p{
    padding-left: 0;
    padding-right: 15px;
}
.dv-benefits .pp-heading-content .pp-heading{
    order: 2;
    width: 100px;
    height: 100px;
    display: flex;
    align-items: center;
    background-color: #235aa4;
    border-radius: 50%;
    position: relative;
    transition: all 0.5s;
    padding: 10px;
}
.dv-left-benefits.dv-benefits .pp-heading-content .pp-heading{
    order: inherit;
}
.dv-benefits .pp-heading-content .pp-sub-heading{
    position: relative;
}
.dv-left-benefits.dv-benefits .pp-heading-content .pp-sub-heading:after{
    display:block;
    content:"";
    right: -29px !important;
    left: inherit !important;
    background-color: #235aa4;
    transform: rotate(-45deg);
    transform-origin: left;
}
.dv-benefits .pp-heading-content .pp-sub-heading:after{
    display: block;
    content: "";
    height: 2px;
    width: 30px;
    position: absolute;
    left: -29px;
    bottom: -3px;
    background-color: #235aa4;
    transform: rotate(45deg);
    transform-origin: right;
}
.dv-benefits .pp-heading-content .pp-heading .heading-title{
    transition: all 0.5s;
}
.dv-benefits:hover .pp-heading-content .pp-heading .heading-title{
    transform: scale(1.1);
}
.dv-benefits:hover .pp-heading-content .pp-heading{
    background-color: #2987c5;
}
@media (max-width: 992px){

.dv-benefits .pp-heading-content .pp-sub-heading{
    padding-bottom: 30px;
}
