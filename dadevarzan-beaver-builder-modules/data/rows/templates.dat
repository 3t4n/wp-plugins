    display: flex;
    flex-wrap: wrap;
}
.dv-sr-blog-05 .news-section-right-part .uabb-blog-post-inner-wrap .uabb-blog-post-content{
    width: calc(100% - 150px);
    order: 1;
    padding: 0;
    text-align: right;
}
.dv-sr-blog-05 .uabb-blog-post-inner-wrap .uabb-blog-post-content .uabb-blog-posts-description{
    color: #191818;
}
.dv-sr-blog-05 .news-section-right-part .uabb-blog-post-inner-wrap .uabb-post-thumbnail{
    order: 2;
    float: left;
    max-width: 130px;
    margin-right: 20px;
}
.dv-sr-blog-05 .news-section-right-part .uabb-blog-post-inner-wrap .uabb-post-thumbnail a{
    display: block;
    line-height: 0;
}
.dv-sr-blog-05 .uabb-post-wrapper .uabb-post-thumbnail img{
    transition: 0.3s;
    -webkit-filter: grayscale(0%);
    filter: grayscale(0%);
}
.dv-sr-blog-05 .uabb-post-wrapper:hover .uabb-post-thumbnail img{
    -webkit-filter: grayscale(100%); /* Safari 6.0 - 9.0 */
    filter: grayscale(100%);
}
.dv-sr-blog-05 .uabb-blog-posts-shadow.clearfix{
    background: no-repeat;
    box-shadow: none;
}
.dv-sr-blog-05 .news-section-left-part .uabb-post-wrapper{
    margin-bottom: 0 !important;
}
.dv-sr-blog-05 .uabb-post-wrapper:hover .uabb-post-heading a{
    text-decoration: underline;
}
@media screen and (max-width: 768px) {
    .dv-sr-blog-05 .news-section-right-part .uabb-blog-post-inner-wrap .uabb-post-thumbnail{
        max-width: inherit;
        width: 100%;
        order: 1;
    }
    .dv-sr-blog-05 .news-section-right-part .uabb-blog-post-inner-wrap .uabb-post-thumbnail a img{
        max-width: inherit;
        height: auto;
        border-radius: 0;
        margin-bottom: 10px;
    }
    .dv-sr-blog-05 .news-section-right-part .uabb-blog-post-inner-wrap .uabb-blog-post-content{
        width: 100%;
        text-align:center;
    }
