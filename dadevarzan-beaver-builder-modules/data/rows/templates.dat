    background: #428bca; /* Old browsers */
    background: -moz-linear-gradient(left, #428bca 0%, #ff9000 100%); /* FF3.6-15 */
    background: -webkit-linear-gradient(left, #428bca 0%,#ff9000 100%); /* Chrome10-25,Safari5.1-6 */
    background: linear-gradient(to right, #428bca 0%,#ff9000 100%); /* W3C, IE10+, FF16+, Chrome26+, Opera12+, Safari7+ */
