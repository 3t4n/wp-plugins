22:"padding_top_responsive";s:0:"";s:23:"padding_responsive_unit";s:2:"px";s:13:"padding_right";s:0:"";s:20:"padding_right_medium";s:0:"";s:24:"padding_right_responsive";s:0:"";s:14:"padding_bottom";s:0:"";s:21:"padding_bottom_medium";s:0:"";s:25:"padding_bottom_responsive";s:0:"";s:12:"padding_left";s:0:"";s:19:"padding_left_medium";s:0:"";s:23:"padding_left_responsive";s:0:"";s:10:"bg_opacity";s:3:"100";s:18:"bg_overlay_opacity";s:2:"50";s:13:"gradient_type";s:6:"linear";s:14:"gradient_color";a:2:{s:7:"primary";s:6:"d81660";s:9:"secondary";s:6:"7d22bd";}s:16:"linear_direction";s:6:"bottom";s:14:"border_opacity";s:3:"100";s:18:"hide_border_mobile";s:2:"no";s:16:"pp_round_corners";a:4:{s:8:"top_left";s:1:"0";s:9:"top_right";s:1:"0";s:11:"bottom_left";s:1:"0";s:12:"bottom_right";s:1:"0";}s:16:"enable_separator";s:2:"no";s:14:"separator_type";s:8:"triangle";s:15:"separator_color";s:6:"ffffff";s:17:"separator_opacity";s:3:"100";s:16:"separator_height";s:3:"100";s:18:"separator_position";s:6:"bottom";s:16:"separator_tablet";s:2:"no";s:23:"separator_height_tablet";s:0:"";s:16:"separator_mobile";s:2:"no";s:23:"separator_height_mobile";s:0:"";s:19:"pp_box_shadow_color";s:6:"000000";s:13:"pp_box_shadow";a:4:{s:8:"vertical";s:1:"0";s:10:"horizontal";s:1:"0";s:4:"blur";s:1:"0";s:6:"spread";s:1:"0";}s:21:"pp_box_shadow_opacity";s:2:"50";s:26:"pp_box_shadow_hover_switch";s:2:"no";s:25:"pp_box_shadow_color_hover";s:6:"000000";s:19:"pp_box_shadow_hover";a:4:{s:8:"vertical";s:1:"0";s:10:"horizontal";s:1:"0";s:4:"blur";s:1:"0";s:6:"spread";s:1:"0";}s:27:"pp_box_shadow_opacity_hover";s:2:"50";s:24:"pp_box_shadow_transition";s:3:"500";s:11:"medium_size";s:7:"default";s:18:"custom_medium_size";s:3:"100";s:15:"responsive_size";s:7:"default";s:22:"custom_responsive_size";s:3:"100";s:11:"connections";a:1:{s:8:"bg_image";s:0:"";}}}s:13:"5e0078daa9705";O:8:"stdClass":5:{s:4:"node";s:13:"5e0078daa9705";s:4:"type";s:6:"module";s:6:"parent";s:13:"5e0078daa96ce";s:8:"position";i:1;s:8:"settings";O:8:"stdClass":85:{s:16:"accordion_source";s:6:"manual";s:5:"items";a:4:{i:0;O:8:"stdClass":12:{s:19:"accordion_font_icon";s:0:"";s:5:"label";s:89:"آیا لازم است شرکت طراح سایت من، همشهری خودم باشد؟";s:12:"content_type";s:7:"content";s:7:"content";s:776:"<p>ممکن است ابتدا به نظر برسد اگر طراح سایت شما، در شهر شما سکونت داشته باشد، دسترسی به او و برگزاری جلسه با وی، راحت‌تر باشد. اما مگر نه این است که یکی از رسالت‌های وب و اینترنت، حذف نیاز به مراجعات حضوری است؟! پس اگر شرکت طراح وبی، واقعا در کار خود، حرفه‌ای باشد لابد ابزارهای آنلاین و مکانیزم‌های عالی غیرحضوری را تدارک دیده تا بدون کوچکترین خللی در کیفیت کار، لزوم جلسات مکرر و مراجعات حضوری پرهزینه را برای مشتری، کاهش دهد.</p>";s:13:"content_photo";s:0:"";s:17:"content_photo_src";s:0:"";s:13:"content_video";s:0:"";s:14:"content_module";s:3:"726";s:11:"content_row";s:3:"251";s:14:"content_layout";s:3:"255";s:1:"0";s:0:"";s:11:"connections";O:8:"stdClass":4:{s:5:"label";s:0:"";s:7:"content";s:0:"";s:13:"content_photo";s:0:"";s:13:"content_video";s:0:"";}}i:1;O:8:"stdClass":12:{s:19:"accordion_font_icon";s:0:"";s:5:"label";s:99:"برای طراحی وب، نیاز به چندبار مراجعه حضوری خواهم داشت؟";s:12:"content_type";s:7:"content";s:7:"content";s:1075:"<p>اگر شرکت طراحی که در تهران انتخاب می کنید، خودش از هیچ مکانیزم آنلاین و ابزار استانداردی استفاده نکرده باشد، لااقل سه بار شما را مجبور به جلسه حضوری در تهران خواهد کرد!</p><ul><li>یکی هنگام جلسه اولیه آشنایی برای بررسی ابعاد پروژه.</li><li>دوم هنگام طراحی برای انتقال سلایق به طراحان گرافیست.</li><li>سوم هنگام پایان پروژه برای تحویل دادن وبسایت به مشتری.</li></ul><p>اما امروزه در دنیا، شرکت های طراح زیادی هستند که پروژه های طراحی وب را از نقاط مختلف دنیا، بسیار با کیفیت‌تر از آنچه در ایران و بدون نیاز به حتی یکبار مراجعه حضوری انجام می‌دهند. ما در داده ورزان، شما را مجبور به حتی یک جلسه حضوری هم نمی کنیم.</p>";s:13:"content_photo";s:0:"";s:17:"content_photo_src";s:0:"";s:13:"content_video";s:0:"";s:14:"content_module";s:3:"726";s:11:"content_row";s:3:"251";s:14:"content_layout";s:3:"255";s:1:"0";s:0:"";s:11:"connections";O:8:"stdClass":4:{s:5:"label";s:0:"";s:7:"content";s:0:"";s:13:"content_photo";s:0:"";s:13:"content_video";s:0:"";}}i:2;O:8:"stdClass":12:{s:19:"accordion_font_icon";s:0:"";s:5:"label";s:94:"بی جلسه، شرکت طراح، درک صحیحی از پروژه، پیدا می کند؟";s:12:"content_type";s:7:"content";s:7:"content";s:1254:"<p>البته که اگر ساز و کار استانداردی را تدارک ندیده باشد، قطعا صرف یک مکالمه کوتاه تلفنی، درک صحیحی از پروژه شما حاصل نخواهد شد. </p><p>اما اگر شرکت طراح مجهز به ابزارهای استاندارد جهانی باشد بله. حتی میتواند به مراتب بهتر و باکیفیت تر از دیگرانی که جلسه حضوری برگزار میکنند پروژه شما را درک کند! همچنانکه امروزه تجربه خرید آنلاین یک موبایل از دیجی کالا، به مراتب نسبت به خرید حضوری آن از یک فروشنده، باکیفیت تر، با آگاهی بالاتر و حساب شده تر است!</p><p>ما در داده ورزان، تحلیل نیازمندی‌های مشتری و نیازسنجی پروژه را بسیار با کیفیت، مکانیزه و آنلاین کرده ایم، مراحل دریافت سلایق و نظرات گرافیکی مشتری را، آموزش کار کردن با پانل مدیریت را و ... همه و همه مکانیزه، آنلاین، در دسترس و الکترونیکی شده است. </p>";s:13:"content_photo";s:0:"";s:17:"content_photo_src";s:0:"";s:13:"content_video";s:0:"";s:14:"content_module";s:3:"726";s:11:"content_row";s:3:"251";s:14:"content_layout";s:3:"255";s:1:"0";s:0:"";s:11:"connections";O:8:"stdClass":4:{s:5:"label";s:0:"";s:7:"content";s:0:"";s:13:"content_photo";s:0:"";s:13:"content_video";s:0:"";}}i:3;O:8:"stdClass":12:{s:19:"accordion_font_icon";s:0:"";s:5:"label";s:92:"بدون جلسه حضوری، چطور میتوانم به شرکت، اعتماد کنم؟";s:12:"content_type";s:7:"content";s:7:"content";s:1443:"<p>واقعا همه ما در کشوری زندگی میکنیم که اعتماد، بزرگترین مانع شکل‌گیری بسیاری روابط کاری است و از بس مشتری قبلا، تجربیات ناخوشایند و بی کیفیتی و بی مروتی دیده است ، حق دارد که شرک و تردید داشته باشد.</p><p>گرچه در دفتر ما به روی همه هموطنان باز است اما لزوما نبایست اصالت یک شرکت ، قدمت فعالیت و اطمینان از معتمد بودن او را از دفتر کارش فهمید.</p><ul><li>همین که می بینید شرکت داده ورزان 15 سال سابقه فعالیت دارد...</li><li>برندهای مطرح و طراز اول کشور، مانند یک و یک ، کفش ملی، اویلا ،فامیلا، محسن، آوازه، بوش، سینجر، دوو الکترونیک، دانشگاه صنعتی شریف و ... از خدمات ما استفاده کرده اند...</li><li>تخصصی بودن ابزارها و مکانیزم های نیازسنجی، تحلیل، طراحی، پیاده سازی و اجرای سایت، که از لحظه اول ارتباط با ما حس خواهید کرد...</li></ul><p>همه و همه کمک می کند که ولو بدون حضور فیزیکی، قدرت و قوت کار و اصالت شرکت طراح را قبول کنید.</p>";s:13:"content_photo";s:0:"";s:17:"content_photo_src";s:0:"";s:13:"content_video";s:0:"";s:14:"content_module";s:3:"726";s:11:"content_row";s:3:"251";s:14:"content_layout";s:3:"255";s:1:"0";s:0:"";s:11:"connections";O:8:"stdClass":4:{s:5:"label";s:0:"";s:7:"content";s:0:"";s:13:"content_photo";s:0:"";s:13:"content_video";s:0:"";}}}s:17:"acf_repeater_name";s:0:"";s:18:"acf_repeater_label";s:0:"";s:20:"acf_repeater_content";s:0:"";s:19:"accordion_icon_size";s:2:"20";s:19:"accordion_open_icon";s:20:"ua-icon ua-icon-plus";s:20:"accordion_close_icon";s:21:"ua-icon ua-icon-cross";s:26:"accordion_toggle_icon_size";s:2:"25";s:27:"accordion_toggle_icon_color";s:6:"666666";s:12:"item_spacing";s:2:"20";s:8:"collapse";s:1:"1";s:10:"open_first";s:1:"1";s:11:"open_custom";s:0:"";s:19:"responsive_collapse";s:2:"no";s:19:"accordion_id_prefix";s:0:"";s:22:"label_bg_color_default";s:0:"";s:21:"label_bg_color_active";s:0:"";s:24:"label_text_color_default";s:6:"3c3c3c";s:23:"label_text_color_active";s:6:"232323";s:12:"label_border";a:4:{s:5:"style";s:4:"none";s:5:"width";a:4:{s:3:"top";s:1:"1";s:5:"right";s:1:"1";s:6:"bottom";s:1:"1";s:4:"left";s:1:"1";}s:5:"color";s:6:"cccccc";s:6:"radius";a:4:{s:8:"top_left";s:1:"0";s:9:"top_right";s:1:"0";s:11:"bottom_left";s:1:"0";s:12:"bottom_right";s:1:"0";}}s:19:"label_border_medium";s:0:"";s:23:"label_border_responsive";s:0:"";s:16:"content_bg_color";s:24:"rgba(238, 238, 238, 0.5)";s:18:"content_text_color";s:6:"333333";s:14:"content_border";a:4:{s:5:"style";s:4:"none";s:5:"width";a:4:{s:3:"top";s:1:"0";s:5:"right";s:1:"1";s:6:"bottom";s:1:"1";s:4:"