abb-module-content{
    border: 1px solid #835c35;
    transition: all 0.5s;
    transform: scale(1);
    max-width: 326px;
    margin: 0 auto;
}
.dv-sr-product-04 .fl-col-group{
    display:  flex;
    flex-wrap:  wrap;
    justify-content:  space-between;
}
.dv-sr-product-04 .fl-col-group .product-cat-item{
    width: 33.333% !important;
    float:  none;
}
.dv-sr-product-04 .product-cat-item:hover .uabb-module-content{
    border: 6px solid #fff;
    border-radius: 7px;
    box-shadow: 0 0 42px rgba(0,0,0,.22);
    transform: scale(1.03);
    transition: none;
}
.dv-sr-product-04 .product-cat-item:hover .uabb-module-content .uabb-infobanner-cta-link{
    bottom:  0;
}
.dv-sr-product-04 .product-cat-item:hover .uabb-module-content .uabb-infobanner-cta-link:hover:after{
    margin-right: 15px;
}
.dv-sr-product-04 .product-cat-item .uabb-module-content .uabb-infobanner-cta-link:after{display:block;content:"\f060";font-family:FontAwesome;margin-right: 5px;transition: all 0.3s;}
.dv-sr-product-04 .product-cat-item .uabb-module-content .uabb-infobanner-cta-link{position:  relative;bottom: -80px;transition: all 0.7s;display: flex;justify-content: center;}
.dv-sr-product-04 .product-cat-item .uabb-module-content .uabb-ultb3-desc{
    transition: all 0.5s;
    position: relative;
    bottom:  0;
}
.dv-sr-product-04 .product-cat-item:hover .uabb-module-content .uabb-ultb3-desc{
    bottom: 20px;
}
.dv-sr-product-04 .product-cat-item .uabb-module-content .uabb-ultb3-desc p{transition: all 0.5s;}
.dv-sr-product-04 .product-cat-item:hover .uabb-module-content .uabb-ultb3-desc p{color:#Fff;}
.dv-sr-product-04 .product-cat-item .uabb-module-content .uabb-ultb3-box-overlay{
    transition: all 0.5s;
}
.dv-sr-product-04 .product-cat-item:hover .uabb-module-content .uabb-ultb3-box-overlay{
    background-color: rgba(255, 255, 255, 0.5);
    z-index: 2;
}
.dv-sr-product-04 .product-cat-item .uabb-module-content:before{
    opacity:  0;
    display: block;
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.7);
    z-index: 2;
}
.dv-sr-product-04 .product-cat-item:hover .uabb-module-content:before{
    opacity:  1;
    transition: all 0.5s;
}

@media screen and (max-width: 992px){
    .dv-sr-product-04 .fl-col-group .product-cat-item {
        width: 50% !important;
    }
}
@media screen and (max-width: 768px){
    .dv-sr-product-04 .fl-col-group .product-cat-item {
