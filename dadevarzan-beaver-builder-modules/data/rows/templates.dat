.dv-sr-product-02 .slick-prev{right:-50px !important; left:auto !important;}
.dv-sr-product-02 .slick-arrow{transform: none !important; width:auto !important; height:auto !important;}
.dv-sr-product-02 .slick-arrow i, .products-section-content .slick-arrow i:hover{font-size:50px !important;}
.dv-sr-product-02 .slick-list{
        height: 320px !important;
        overflow: visible !important;
}
.dv-sr-product-02 .uabb-read-more-text{
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 69px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    background:rgba(1, 152, 141, 0.8);
    transition: all 0.3s;
}
.dv-sr-product-02 .uabb-post-wrapper:hover .uabb-read-more-text{opacity:1;}
.dv-sr-product-02 .uabb-read-more-text a{
    color: #fff !important;
    background-color: rgba(0, 0, 0, 0.2);
    padding: 6px 15px;
    font-size: 15px;
}
.dv-sr-product-02 .uabb-read-more-text span{display:none;}
.dv-sr-product-02 .uabb-post-heading{
    padding: 25px 0;
    height: 70px;
    font-weight: 500;
}
.dv-sr-product-02 .uabb-blog-post-content{
    position: static;
    padding: 0 !important;
}
.dv-sr-product-02 .uabb-post-wrapper:hover .uabb-blog-posts-shadow{
    box-shadow: 0 6px 15px rgba(16,16,16,.34);
}
.dv-sr-product-02 .uabb-post-wrapper .uabb-blog-posts-shadow{
    position:relative;
    max-width: 275px;
    margin: 0 auto;
    box-shadow: 0 4px 8px rgba(16,16,16,.25);
    transition: all 0.5s;
}
@media screen and (max-width: 1200px){
    .dv-sr-product-02 .products-section-content .slick-next{left:-30px !important; right:auto !important;}
    .dv-sr-product-02 .products-section-content .slick-prev{right:-30px !important; left:auto !important;}
}
@media screen and (max-width: 768px){
  .dv-sr-product-02 .products-section-content .slick-next{left:-10px !important; right:auto !important;}
  .dv-sr-product-02 .products-section-content .slick-prev{right:-10px !important; left:auto !important;}
