    -webkit-transform-style: preserve-3d;
    -moz-transform-style: preserve-3d;
    -o-transform-style: preserve-3d;
    -ms-transform-style: preserve-3d;
    transform-style: preserve-3d;
    overflow:  visible;
    height: 260px;
    max-width:  340px;
    margin:  0 auto;
    margin-bottom: 20px;
}
.dv-sr-blog-10 .article-section-content .uabb-blog-post-contents .uabb-post-thumbnail .uabb-post-heading{
    z-index: 10;position:  relative;line-height: 40px;}
.dv-sr-blog-10 .article-section-content .uabb-blog-post-contents .uabb-post-thumbnail .uabb-image-post-section{
    width:  100%;
    height: 220px;
    border-radius: 7px;
    overflow:  hidden;
}
.dv-sr-blog-10 .article-section-content .uabb-blog-post-contents .uabb-post-thumbnail .uabb-image-post-section a{
    display:  block;
    line-height:  0;
    width:  100%;
    height:  100%;
    position:  relative;
}
.dv-sr-blog-10 .article-section-content .uabb-blog-post-contents .uabb-post-thumbnail .uabb-image-post-section a img{
    transform:  none;
    left:  0;
    top: 0;
    bottom:  0;
}
.dv-sr-blog-10 .article-section-content .uabb-blog-post-contents .uabb-post-thumbnail{
    -webkit-transform: rotateY(0);
    -moz-transform: rotateY(0);
    -ms-transform: rotateY(0);
    -o-transform: rotateY(0);
    transform: rotateY(0);
    position:  fixed;
    background-color: #f6f6f6;
    transition-duration: 800ms;
    -webkit-transform-style: preserve-3d;
    -moz-transform-style: preserve-3d;
    -o-transform-style: preserve-3d;
    -ms-transform-style: preserve-3d;
    transform-style: preserve-3d;
}
.dv-sr-blog-10 .article-section-content .uabb-blog-post-contents:hover .uabb-post-thumbnail{
    -webkit-transform: rotateY(180deg);
    -moz-transform: rotateY(180deg);
    -ms-transform: rotateY(180deg);
