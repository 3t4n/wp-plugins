.dv-sr-link-11 .guid-section-part .uabb-module-content .uabb-ultb3-info:before{
    display:block;
    content:"";
    position: absolute;
    left: 0;
    right: 100%;
    top: 0; opacity: 0.5;
    bottom: 0;
