.hp-product-03 .hompage-section-titel .fl-heading .fl-heading-text:after{display:block;content:"";position: absolute;right: 100%;height: 3px;bottom: 40%;width: 100%;background-color: #273d6c;max-width: 100px;margin: 0 auto;}

.hp-product-03{
    position:  relative;
}
.hp-product-03 .fl-row-content-wrap .fl-row-content{
    position:  relative;
    z-index: 2;
}
.hp-product-03:before{display:block;content:"";position:  absolute;left:  0;right:  0;top: 0;height: 70%;background-color: #e4e4e4;z-index: 1;bottom:  0;}
.hp-product-03 .color-pallet-section-text .fl-heading-text{
