.dv-sr-project-03 .fl-col-group{
    display: flex;
    flex-wrap: wrap;
    align-items: center;
}
.dv-sr-project-03 .google-map-section-content:before{
    display: block;
    content: "";
    left: -70px;
    right: 0px;
    top: 0;
    bottom: 0;
    position: absolute;
    z-index: 10;
    background: linear-gradient(135deg, #a4d5ff 0%,#428bca 70%);
}
.dv-sr-project-03 .google-map-section-content{
    position: relative;
}
.dv-sr-project-03 .google-map-section-content .fl-col-content{
    position: relative;
    z-index: 11;
}
.dv-sr-project-03 .google-map{
    position: relative;
    z-index: 11;
}
.dv-sr-project-03 .google-map .uabb-module-content{
    border: 10px solid #d6d6d6;
    margin-top: 40px;
}
.dv-sr-project-03 .google-map-section-content .fl-heading-text{
    margin-right: 60px;
}
@media screen and (max-width: 992px){
    .dv-sr-project-03 .google-map .uabb-module-content{margin:0 !important;}
    .dv-sr-project-03 .google-map-section-content:before{display:none !important;}
    .dv-sr-project-03 .google-map-section-content .fl-col-content{background:linear-gradient(135deg, rgba(184,182,247,1) 0%,rgba(46,59,177,1) 70%);}
