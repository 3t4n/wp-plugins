.dv-sr-products-02 .hompage-products .uabb-post-wrapper:hover .uabb-blog-post-inner-wrap .uabb-post-thumbnail a img{
    box-shadow: 0px 3px 9px 3px rgba(0, 0, 0, 0.2);
}
.dv-sr-products-02 .hompage-products .uabb-post-wrapper:hover .uabb-blog-post-inner-wrap .uabb-post-thumbnail{
    bottom: 40px;
}
.dv-sr-products-02 .hompage-products .uabb-post-wrapper .uabb-blog-post-inner-wrap .uabb-blog-post-content{
    transition: all 0.3s;
    bottom: 0;
}
.dv-sr-products-02 .hompage-products .uabb-post-wrapper:hover .uabb-blog-post-inner-wrap .uabb-blog-post-content{
    bottom: -5px;
}
.dv-sr-products-02 .hompage-products .uabb-blog-post-inner-wrap .uabb-post-thumbnail a img{
    box-shadow: 0 0 9px 3px rgba(0, 0, 0, 0.18);
    display:block;
    max-width: 80%;
    margin: 0 auto;
    border-radius:7px;
    transition: all 0.3s;
}
.dv-sr-products-02 .hompage-products .uabb-blog-posts-shadow{
    border-radius: 7px;
}
.dv-sr-products-02 .hompage-products .uabb-blog-post-inner-wrap .uabb-post-thumbnail{
    margin: 0 auto;
    bottom: 30px;
    overflow: visible;
    transition: all 0.3s;
}
.dv-sr-products-02 .hompage-products .uabb-module-content{
    overflow: visible;
}
