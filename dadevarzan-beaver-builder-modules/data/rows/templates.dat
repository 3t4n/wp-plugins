um";s:0:"";s:19:"padding_medium_unit";s:2:"px";s:22:"padding_top_responsive";s:0:"";s:23:"padding_responsive_unit";s:2:"px";s:13:"padding_right";s:0:"";s:20:"padding_right_medium";s:0:"";s:24:"padding_right_responsive";s:0:"";s:14:"padding_bottom";s:0:"";s:21:"padding_bottom_medium";s:0:"";s:25:"padding_bottom_responsive";s:0:"";s:12:"padding_left";s:0:"";s:19:"padding_left_medium";s:0:"";s:23:"padding_left_responsive";s:0:"";}}s:13:"5e0078dae7f92";O:8:"stdClass":5:{s:4:"node";s:13:"5e0078dae7f92";s:4:"type";s:6:"module";s:6:"parent";s:13:"5e0078dae7f5a";s:8:"position";i:1;s:8:"settings";O:8:"stdClass":54:{s:13:"add_list_item";a:3:{i:0;O:8:"stdClass":20:{s:1:"0";s:0:"";s:15:"list_item_title";s:37:"واردات کالا از ترکیه";s:13:"list_item_url";s:0:"";s:14:"list_item_link";s:2:"no";s:21:"list_item_link_target";s:5:"_self";s:23:"list_item_link_nofollow";s:1:"0";s:21:"list_item_description";s:895:"<p>باتوجه به آخرین آمار ارائه شده از گمرک ایران در سال ۱۳۹۵ واردات از ترکیه جزء ۵ واردات برتر از کشورهای مختلف می باشد، به صورتی که حجم واردات کالا از ترکیه به بیش از یک میلیارد و ۶۰۰ میلیون تن رسیده بود و از لحاظ ارزش دلاری این مقدار معادل بیش از دو میلیارد و ۷۰۰ میلیون دلار کالا می باشد. قوانین واردات کالا از ترکیه مانند سایر رویه های واردات کالا به ایران می باشد البته این به جز بخشی از کنوانسیون ها و بخش نامه های تسهیل کننده گمرکی و البته گه گاه کدورت هایی در بخش حمل و نقل و عوارض راه می باشد.</p>";s:10:"image_type";s:5:"photo";s:4:"icon";s:0:"";s:10:"icon_color";s:0:"";s:12:"photo_source";s:7:"library";s:5:"photo";s:5:"23325";s:9:"photo_url";s:0:"";s:11:"custom_text";s:0:"";s:12:"custom_color";s:0:"";s:11:"connections";O:8:"stdClass":4:{s:15:"list_item_title";s:0:"";s:13:"list_item_url";s:0:"";s:21:"list_item_description";s:0:"";s:5:"photo";s:0:"";}s:20:"list_item_url-search";s:0:"";s:9:"photo_src";s:72:"http://theme.webexir.net/wp-content/uploads/2018/03/dv-sr-text-04-01.jpg";s:30:"as_values_list_item_url-search";s:0:"";s:41:"flrich1523262400562_list_item_description";s:0:"";}i:1;O:8:"stdClass":20:{s:1:"0";s:0:"";s:15:"list_item_title";s:33:"واردات کالا از چین";s:13:"list_item_url";s:0:"";s:14:"list_item_link";s:2:"no";s:21:"list_item_link_target";s:5:"_self";s:23:"list_item_link_nofollow";s:1:"0";s:21:"list_item_description";s:863:"<p>واردات از چین به ایران بر اساس آمار ارئه شده توسط گمرک جمهوری اسلامی ایران در سال ۱۳۹۴ معادل ۱۴٫۴۷ درصد و سهم ارزش دلاری آن ۲۵٫۲۲ درصد بوده است. در سال ۱۳۹۵ سهم وزنی واردات کالا از چین ۱۳٫۳۳ درصد و سهم ارزش دلاری آن ۲۴٫۶۲ درصد می باشد. به عبارت دیگر در سال ۹۵ حجم واردات از چین بیش از ۴۴۵۱ هزار تن با ارزش بیش از ۱۰۷۵۳ میلیون دلار بوده است. شرکت ترخیص کارا تمامی فعالیت ها و امور مربوط به واردات کالا از چین را به نحو احسن و با بالاترین دقت و کیفیت و نیز سریعترنی زمان انجام می دهد.</p>";s:10:"image_type";s:5:"photo";s:4:"icon";s:0:"";s:10:"icon_color";s:0:"";s:12:"photo_source";s:7:"library";s:5:"photo";s:5:"23326";s:9:"photo_url";s:0:"";s:11:"custom_text";s:0:"";s:12:"custom_color";s:0:"";s:11:"connections";O:8:"stdClass":4:{s:15:"list_item_title";s:0:"";s:13:"list_item_url";s:0:"";s:21:"list_item_description";s:0:"";s:5:"photo";s:0:"";}s:20:"list_item_url-search";s:0:"";s:9:"photo_src";s:72:"http://theme.webexir.net/wp-content/uploads/2018/03/dv-sr-text-04-02.jpg";s:30:"as_values_list_item_url-search";s:0:"";s:41:"flrich1523262516343_list_item_description";s:0:"";}i:2;O:8:"stdClass":20:{s:1:"0";s:0:"";s:15:"list_item_title";s:37:"واردات کالا از اروپا";s:13:"list_item_url";s:0:"";s:14:"list_item_link";s:2:"no";s:21:"list_item_link_target";s:5:"_self";s:23:"list_item_link_nofollow";s:1:"0";s:21:"list_item_description";s:872:"<p>کشورهای اروپایی به عنوان یکی مبادی صادرات به ایران می باشند. واردات کالا از اروپا شامل محصولات متنوعی از قبیل خودرو ، دارویی ، آرایشی و بهداشتی ، پوشاک ، تکنولوژی ، صنعت و … می باشد. سهم هر کدام از کشورها در واردات از اروپا بسته به کالاهایی که بازرگانان ایرانی وارد می کنند متفاوت است. به عنوان مثال سهم واردات کالا از کشور آلمان بیشتر صنعتی می باشد و یا برای کشوری مثل فرانسه خودرو می باشد. قوانین و رویه های مربوط به واردات از اروپا تابع ضابطه ها و تعرفه های مشخص گمرکات ایران است.</p>";s:10:"image_type";s:5:"photo";s:4:"icon";s:0:"";s:10:"icon_color";s:0:"";s:12:"photo_source";s:7:"library";s:5:"photo";s:5:"23327";s:9:"photo_url";s:0:"";s:11:"custom_text";s:0:"";s:12:"custom_color";s:0:"";s:11:"connections";O:8:"stdClass":4:{s:15:"list_item_title";s:0:"";s:13:"list_item_url";s:0:"";s:21:"list_item_description";s:0:"";s:5:"photo";s:0:"";}s:20:"list_item_url-search";s:0:"";s:9:"photo_src";s:72:"http://theme.webexir.net/wp-content/uploads/2018/03/dv-sr-text-04-03.jpg";s:30:"as_values_list_item_url-search";s:0:"";s:41:"flrich1523262566974_list_item_description";s:0:"";}}s:13:"icon_position";s:3:"top";s:11:"align_items";s:3:"top";s:11:"mobile_view";s:0:"";s:15:"icon_image_size";s:4:"100%";s:22:"space_between_elements";s:2:"30";s:15:"list_icon_style";s:6:"simple";s:18:"list_icon_bg_color";s:0:"";s:22:"list_icon_bg_color_opc";s:0:"";s:26:"list_icon_bg_border_radius";s:0:"";s:20:"list_icon_bg_padding";s:0:"";s:22:"list_icon_border_style";s:4:"none";s:22:"list_icon_border_width";s:0:"";s:22:"list_icon_border_color";s:0:"";s:19:"list_icon_animation";s:2:"no";s:21:"list_connector_option";s:2:"no";s:20:"list_connector_color";s:0:"";s:20:"list_connector_style";s:5:"solid";s:21:"heading_tag_selection";s:2:"h3";s:19:"heading_font_family";a:2:{s:6:"family";s:8:"IRANSans";s:6:"weight";s:3:"500";}s:17:"heading_font_size";a:4:{s:7:"desktop";s:2:"18";s:8:"simplify";s:6:"expand";s:6:"medium";s:2:"16";s:5:"small";s:2:"14";}s:19:"heading_line_height";a:4:{s:7:"desktop";s:0:"";s:8:"simplify";s:8:"collapse";s:6:"medium";s:0:"";s:5:"small";s:0:"";}s:13:"heading_color";s:0:"";s:18:"heading_margin_top";s:2:"20";s:21:"heading_margin_bottom";s:2:"10";s:23:"description_font_family";a:2:{s:6:"family";s:8:"IRANSans";s:6:"weight";s:3:"400";}s:21:"description_font_size";a:4:{s:7:"desktop";s:2:"14";s:8:"simplify";s:6:"expand";s:6:"medium";s:2:"13";s:5:"small";s:2:"12";}s:23:"descrip