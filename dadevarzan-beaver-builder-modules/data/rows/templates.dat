    top: 50%;
    margin-top: -50px;
}
#dv-value-item:hover .uabb-module-content .uabb-infobox-content i:before{
    background: -webkit-linear-gradient(right top,#f5f5f5, #fff) !important;
    -webkit-background-clip: text !important;
    -webkit-text-fill-color: transparent;

} 
#dv-support-item:hover .uabb-module-content .uabb-infobox-content i:before{
    background: -webkit-linear-gradient(right top,#555, #000) !important;
    -webkit-background-clip: text !important;
    -webkit-text-fill-color: transparent;

} 
#dv-value-item .uabb-module-content .uabb-infobox-title-wrap .uabb-infobox-title,#dv-support-item .uabb-module-content .uabb-infobox-title-wrap .uabb-infobox-title{
    z-index: 10;
    width: 300px;
    position: absolute;
    left: 50%;
    margin-left: -150px;
    top: 70%;}

#dv-value-item:hover .uabb-module-content .uabb-infobox-title-wrap .uabb-infobox-title{color:#fff;}
#dv-value-item .uabb-infobox,#dv-support-item .uabb-infobox {
    border-radius: 7px;
    box-shadow: 0 0 10px 0 rgba(0,0,0,0.1);
    transition: all 0.3s;
    position: relative;
    overflow: hidden;
}
#dv-value-item .uabb-infobox::before , #dv-value-item .uabb-infobox::after {
   content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index:1;
    background-color: rgba(138,0,0,0.75);
    -webkit-transition: all 0.3s;
    -moz-transition: all 0.3s;
    -o-transition: all 0.3s;
    transition: all 0.3s;
    -webkit-transform: translate(-100%,0);
    transform: translate(-100%,0);
    -webkit-transition-timing-function: cubic-bezier(0.75, 0, 0.125, 1);
    transition-timing-function: cubic-bezier(0.75, 0, 0.125, 1);
}
#dv-value-item .uabb-infobox:hover::before, #dv-value-item .uabb-infobox:hover::after {
    -webkit-transform: translate(0,0);
    transform: translate(0,0);
}
#dv-value-item .uabb-infobox::after {
    -webkit-transition-delay: 0.2s;
    transition-delay: 0.2s;
}
