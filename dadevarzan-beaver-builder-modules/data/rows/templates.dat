.products-image-links .uabb-ih-list .uabb-ih-item-1{
    margin-bottom: 60px !important;
}
.products-image-links .uabb-ih-list .uabb-ih-item-0,
.products-image-links .uabb-ih-list .uabb-ih-item-2{
    top: 97px;
    margin: 0 40px !important;
}
.products-image-links .uabb-ih-list .uabb-ih-list-item .uabb-ih-item{
    position: relative;
}
.products-image-links .uabb-ih-list .uabb-ih-list-item .uabb-ih-item:after{
    width: 0;
    height: 0;
    border-top: 90px solid transparent;
    border-left: 40px solid #ffd600;
    border-bottom: 90px solid transparent;
    content: "";
    position: absolute;
    top: -30px;
    left: 100%;
}
.products-image-links .uabb-ih-list .uabb-ih-list-item .uabb-ih-item:before{
    width: 0;
    height: 0;
    border-top: 90px solid transparent;
    border-right: 40px solid #ffd600;
    border-bottom: 90px solid transparent;
    content: "";
    position: absolute;
    top: -30px;
    right: 100%;
}
.products-image-links .uabb-ih-list .uabb-ih-list-item .uabb-ih-item .uabb-ih-image-block{
    background-color: #ffd600;
}
.products-image-links .uabb-ih-list .uabb-ih-list-item .uabb-ih-item .uabb-ih-image-block:before{
    content: "";
    display: block;
    position: absolute;
    top: -30px;
    left: 0;
    right: 0;
    height: 30px;
    background-color: #ffd600;
}
.products-image-links .uabb-ih-list .uabb-ih-list-item .uabb-ih-item .uabb-ih-image-block:after{
    content: "";
    display: block;
    position: absolute;
    bottom:-30px;
    left: 0;
    right: 0;
    height: 30px;
    background-color: #ffd600;
}
@media screen and (max-width: 992px) {
    .products-image-links .uabb-ih-list{
        margin: 0 auto !important;
    }
}
@media screen and (max-width: 768px){
    .products-image-links .fl-module-content{
        margin-bottom:90px !important;
    }
}
@media screen and (max-width: 350px){
    .products-image-links .uabb-ih-list .uabb-ih-list-item{
        margin-bottom: 80px !important;
        top:0 !important;
    }
}
