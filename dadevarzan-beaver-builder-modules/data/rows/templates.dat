    transform: none !important;
}
.dv-activities .uabb-module-content .slick-prev{
    left: 10px !important;
    right: auto !important;
}
.dv-activities .uabb-module-content .slick-next{
    right: 10px !important;
    left: auto !important;
}
.dv-activities .slick-track .uabb-image-carousel-item{
    position: relative;
}
.dv-activities .slick-track .uabb-image-carousel-item .uabb-image-carousel-caption{
    position: absolute;
    z-index: 5;
    top: 0;
    right: 0; left: 0;
    background: -moz-linear-gradient(top, rgba(0,0,0,0.7) 0%, rgba(125,185,232,0) 100%);
    background: -webkit-linear-gradient(top, rgba(0,0,0,0.7) 0%,rgba(125,185,232,0) 100%);
    background: linear-gradient(to bottom, rgba(0,0,0,0.7) 0%,rgba(125,185,232,0) 100%);
    filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#80000000', endColorstr='#007db9e8',GradientType=0 );
    padding: 40px 20px 50px;
}
.dv-activities .slick-track .uabb-image-carousel-item .uabb-image-carousel-content a {
    position: relative;
}
.dv-activities .slick-track .uabb-image-carousel-item .uabb-image-carousel-content a:before {
    position: absolute;
    z-index: 5;
    right: 0;
    bottom: 0;
    left: 0;
    content:"";
    display: block;
    height: 200px;
    background: -moz-linear-gradient(top, rgba(255,255,255,0) 0%, rgba(252,252,252,0) 1%, rgba(0,0,0,0.7) 100%);
    background: -webkit-linear-gradient(top, rgba(255,255,255,0) 0%,rgba(252,252,252,0) 1%,rgba(0,0,0,0.7) 100%);
    background: linear-gradient(to bottom, rgba(255,255,255,0) 0%,rgba(252,252,252,0) 1%,rgba(0,0,0,0.7) 100%);
    filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#00ffffff', endColorstr='#b3000000',GradientType=0 );    
}
.dv-activities .slick-track .uabb-image-carousel-item .uabb-image-carousel-content a:after {
position: absolute;
    z-index: 6;
    bottom: 30px;
    left: 0;
    right: 0;
    margin: 0 auto;
    width: 150px;
    content: "اطلاعات بیشتر";
    display: block;
    color: white;
    border: 1px solid white;
    border-radius: 20px;
    padding: 10px 20px;
}
@media screen and (max-width: 992px){
    .dv-activities .slick-track .uabb-image-carousel-item .uabb-image-carousel-content a:after{
        font-size:13px;
    }
}
@media screen and (max-width: 768px){
    .dv-activities .slick-track .uabb-image-carousel-item .uabb-image-carousel-content a:after{
        font-size:12px;
    }
}
