_spacing_dimension_bottom_medium";s:0:"";s:41:"modal_spacing_dimension_bottom_responsive";s:0:"";s:28:"modal_spacing_dimension_left";s:2:"25";s:35:"modal_spacing_dimension_left_medium";s:0:"";s:39:"modal_spacing_dimension_left_responsive";s:0:"";s:10:"margin_top";s:1:"0";s:11:"margin_unit";s:2:"px";s:17:"margin_top_medium";s:0:"";s:18:"margin_medium_unit";s:2:"px";s:21:"margin_top_responsive";s:0:"";s:22:"margin_responsive_unit";s:2:"px";s:12:"margin_right";s:0:"";s:19:"margin_right_medium";s:0:"";s:23:"margin_right_responsive";s:0:"";s:13:"margin_bottom";s:1:"0";s:20:"margin_bottom_medium";s:0:"";s:24:"margin_bottom_responsive";s:0:"";s:11:"margin_left";s:0:"";s:18:"margin_left_medium";s:0:"";s:22:"margin_left_responsive";s:0:"";s:4:"type";s:11:"modal-popup";s:11:"connections";a:9:{s:5:"title";s:0:"";s:10:"ct_content";s:0:"";s:8:"ct_photo";s:0:"";s:9:"video_url";s:0:"";s:10:"iframe_url";s:0:"";s:5:"photo";s:0:"";s:10:"modal_text";s:0:"";s:8:"btn_text";s:0:"";s:11:"close_photo";s:0:"";}s:30:"flrich1543751243146_ct_content";s:0:"";s:30:"flrich1543751579586_ct_content";s:0:"";s:30:"flrich1543751627133_ct_content";s:0:"";s:30:"flrich1543753035535_ct_content";s:0:"";s:30:"flrich1543753401568_ct_content";s:0:"";s:30:"flrich1543753499544_ct_content";s:0:"";s:30:"flrich1543753614020_ct_content";s:0:"";s:30:"flrich1543754730806_ct_content";s:0:"";s:30:"flrich1543757290456_ct_content";s:0:"";s:30:"flrich1543759142740_ct_content";s:0:"";}}s:13:"5e0078dac03c1";O:8:"stdClass":5:{s:4:"node";s:13:"5e0078dac03c1";s:4:"type";s:6:"module";s:6:"parent";s:13:"5e0078dabfeff";s:8:"position";i:3;s:8:"settings";O:8:"stdClass":176:{s:13:"preview_modal";s:1:"0";s:12:"enable_title";s:1:"0";s:5:"title";s:0:"";s:15:"title_alignment";s:4:"left";s:12:"content_type";s:7:"content";s:10:"ct_content";s:2075:"<p><img class="alignright size-full wp-image-23723" src="http://behko.webexir.net/wp-content/uploads/2018/12/User-Friendly.jpg" alt="" width="240" height="160" /></p><p>امکان فعالیت در ماژول های مختلف (دارای دسترسی) با یک بار لاگین.<br />• امکان فعالیت همزمان روی چندین فرم.<br />• امکان فعالیت همزمان در چندین سال مالی با امکان بارگزاری نرم افزار به تعداد دفعات.<br />• سیستم تقویم کارکنان و مدیران.</p><p>• امکان ارسال و دریافت پیام توسط کاربران به یکدیگر از طریق نرم افزار.<br />• امکان خروجی گرفتن از گزارشات به فرمتهای مختلف.<br />• امکان سفارشی سازی فرمهای لیست طبق سلیقه هر کاربر و ذخیره فرمت برای کاربر.<br />• امکان رنگبندی اطلاعات به سلیقه کاربر جهت تشخیص درست اطلاعات با امکان قالب دهی شرطی.<br />• امکان ایجاد کلید میانبر (Shortcut) توسط کاربر برای افزایش سرعت کاربر.<br />• امکان نگهداری محاسبات استفاده شده توسط ماشین حساب سیستم.<br />• امکان کپی، حذف(Cut) و انتقال ردیفهایی از اسناد به سایر اسناد.<br />• امکان ایجاد نمودار بصورت آسان توسط کاربران و سفارشی سازی آن.<br />• امکان الصاق کردن هر نوع فایل مولتی مدیا به رکوردها و اسناد.<br />• فیلدساز برای ایجاد فیلدهایی که مورد نیاز سازمان می باشد..<br />• بازنشانی رکوردها از اکسل در اسناد مختلف.<br />• گزارش ساز .<br />• وجود جعبه فرم برای کاربران برای دسترسی و جابجایی سریع بین فرمهای باز نرم افزار.</p>";s:8:"ct_photo";s:0:"";s:12:"ct_photo_src";s:0:"";s:8:"ct_video";s:0:"";s:13:"ct_saved_rows";s:4:"4847";s:16:"ct_saved_modules";s:5:"23687";s:17:"ct_page_templates";s:4:"5299";s:9:"video_url";s:0:"";s:11:"video_ratio";s:4:"16_9";s:14:"video_autoplay";s:2:"no";s:22:"youtube_related_videos";s:2:"no";s:23:"youtube_player_controls";s:2:"no";s:10:"iframe_url";s:0:"";s:13:"iframe_height";s:3:"360";s:12:"async_iframe";s:2:"no";s:11:"modal_width";s:3:"900";s:12:"modal_effect";s:13:"uabb-effect-1";s:16:"content_bg_color";s:6:"ffffff";s:13:"overlay_color";s:6:"000000";s:17:"overlay_color_opc";s:2:"75";s:8:"modal_on";s:6:"custom";s:9:"all_align";s:4:"left";s:4:"icon";s:0:"";s:9:"icon_size";s:2:"30";s:10:"icon_color";s:0:"";s:16:"icon_hover_color";s:0:"";s:5:"photo";s:0:"";s:9:"photo_src";s:0:"";s:8:"img_size";s:0:"";s:10:"modal_text";s:10:"Click Here";s:10:"text_color";s:0:"";s:16:"text_hover_color";s:0:"";s:8:"btn_text"