    position: relative;
}

.dv-sr-document-02 .university-requirements-engineering-image.fl-animated .fl-photo-content.fl-photo-img-png:hover {
    transform: rotate3d(0,1,0,35deg);
}

.dv-sr-document-02 .university-requirements-engineering-image .fl-photo-content.fl-photo-img-png {
    transition: all 3s;
}

.dv-sr-document-02 .university-requirements-engineering-image img {
    transition: all 2s;
}

.dv-sr-document-02 .university-requirements-engineering-image.fl-animated .fl-photo-content.fl-photo-img-png img {
    border-radius: 0 3px 3px 0;
    box-shadow: inset 4px 0 10px rgba(0,0,0,.1);
}

.dv-sr-document-02 .university-requirements-engineering-help .fl-cta-title {
    font-size: 1.429em;
    font-weight: 700;
}

.dv-sr-document-02 .university-requirements-engineering-help .fl-module-content.fl-node-content {
    border-radius: 10px;
}
.dv-sr-document-02 .university-requirements-engineering-image .fl-photo-img-jpg img {
    border: 1px solid #676767;
    border-radius: 0 3px 3px 0;
    transition: all 2s;
}

.dv-sr-document-02 .university-requirements-engineering-image .fl-photo-img-jpg {
    transition: transform 2s;
}

.dv-sr-document-02 .university-requirements-engineering-image.fl-animated .fl-photo-img-jpg {
    transform-origin: 100% 100%;
    transform: skewY(2deg) rotateY(14deg);
}

.dv-sr-document-02{
    position: relative;
    z-index: 3
}

@media(min-width: 768px) {
    .university-requirements-engineering-image .fl-photo.fl-photo-align-center {
        transition:all 2s;
        transform: rotate(15deg)
    }
    .university-requirements-engineering-image.fl-animated .fl-photo.fl-photo-align-center {
        background-color: #868686!important;
        width: 70%;
        position: absolute;
        top: -135px;
        left: 100px;
        z-index: 10
    }
    .university-services .fl-module-info-circle .uabb-module-content.uabb-info-circle-wrap .uabb-info-circle-desc.uabb-text-editor {
        max-width: 280px;
        margin: 0 auto;
        padding: 0 10px;
        text-align: justify
    }
}

@media(max-width: 768px) {
    .university-requirements-engineering-image .fl-photo.fl-photo-align-center {
        transition:none;
        transform: none
    }

    .university-requirements-engineering-image.fl-animated .fl-photo.fl-photo-align-center {
        background-color: #868686!important;
        width: 70%;
        position: relative;
        margin: 0 auto
