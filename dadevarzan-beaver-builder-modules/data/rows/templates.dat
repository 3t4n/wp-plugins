";s:21:"margin_top_responsive";s:0:"";s:22:"margin_responsive_unit";s:2:"px";s:12:"margin_right";s:0:"";s:19:"margin_right_medium";s:0:"";s:23:"margin_right_responsive";s:0:"";s:13:"margin_bottom";s:1:"0";s:20:"margin_bottom_medium";s:0:"";s:24:"margin_bottom_responsive";s:0:"";s:11:"margin_left";s:0:"";s:18:"margin_left_medium";s:0:"";s:22:"margin_left_responsive";s:0:"";s:4:"type";s:11:"modal-popup";s:11:"connections";a:9:{s:5:"title";s:0:"";s:10:"ct_content";s:0:"";s:8:"ct_photo";s:0:"";s:9:"video_url";s:0:"";s:10:"iframe_url";s:0:"";s:5:"photo";s:0:"";s:10:"modal_text";s:0:"";s:8:"btn_text";s:0:"";s:11:"close_photo";s:0:"";}s:30:"flrich1543751243146_ct_content";s:0:"";s:30:"flrich1543751579586_ct_content";s:0:"";s:30:"flrich1543751627133_ct_content";s:0:"";s:30:"flrich1543753035535_ct_content";s:0:"";s:30:"flrich1543753401568_ct_content";s:0:"";s:30:"flrich1543753499544_ct_content";s:0:"";s:30:"flrich1543753614020_ct_content";s:0:"";s:30:"flrich1543756579247_ct_content";s:0:"";s:30:"flrich1543758311079_ct_content";s:0:"";s:30:"flrich1543758370846_ct_content";s:0:"";s:30:"flrich1543758424508_ct_content";s:0:"";s:30:"flrich1543758518791_ct_content";s:0:"";s:30:"flrich1543760637394_ct_content";s:0:"";}}s:13:"5e0078dac00ff";O:8:"stdClass":5:{s:4:"node";s:13:"5e0078dac00ff";s:4:"type";s:6:"module";s:6:"parent";s:13:"5e0078dabfe8e";s:8:"position";i:3;s:8:"settings";O:8:"stdClass":176:{s:13:"preview_modal";s:1:"0";s:12:"enable_title";s:1:"0";s:5:"title";s:0:"";s:15:"title_alignment";s:4:"left";s:12:"content_type";s:7:"content";s:10:"ct_content";s:3156:"<p><img class="alignright size-full wp-image-23718" src="http://behko.webexir.net/wp-content/uploads/2018/12/Workflow.jpg" alt="" width="240" height="160" /></p><p>کلیه اسناد و فعالیتها از طریق تعیین مسیر گردش آنها مدیریت می شود. بدون محدودیت در تعداد مسیر گردش برای یک سند، می توان با توجه به حالتهای مختلف و شرایط مختلف سند، مسیرهای گردش متعدد تعریف کرد. مسیر گردش فقط ویژه اسناد نیست بلکه فعالیتها، کارها، شکایات مشتری و .... میتوانند شامل مسیر گردش باشند. لازم به ذکر است که مسیر گردش اسناد بر اساس نقش و سمت سازمانی است و در صورت تغییر سمت افراد، اسناد و کارها نیز بر اساس نقش و سمت جدید در کارتابل وی قرار می گیرد.<br />برخی کاربردها:</p><p>•  پس از صدور یک سند، با توجه به شرایط سند در کارتابل نفرات بعدی جهت تأیید قرار میگیرد. پس از تأیید نقش آخر، به صورت خودکار به کارتابل اقدام کننده جهت اقدام منتقل می شود و چنانچه نیاز به اطلاع رسانی به نقشی باشد به صورت همزمان به کارتابل وی جهت اطلاع منتقل می شود.<br />•  با عبارات شرطی تعیین مسیر گردش سند را به نرم افزار واگذار نمود به عنوان مثال چنانچه در درخواست خرید، کالای از نوع اموال وجود داشت مسیری انتخاب می شود که تأیید مدیر مالی هم دریافت گردد.<br />•  چنانچه نقش کاربری تغییر یابد کلیه اسناد و کارهایی که مربوط به نقش قبل بوده از کارتابل وی حذف شده و اسناد و کارهای متناسب با نقش جدید در کارتابل وی قرار می گیرد.<br />•  در زمان مرخصی و یا زمانهای خاص یک کاربر می تواند برخی از دسترسیهای تأیید خود را روی یک یا چندین نوع سند به نقش یا کاربر دیگری تفویض می کند.<br />•  چنانچه سندی جهت تأیید در کارتابل فردی قرار گرفت چنانچه دسترسی تغییر به این نقش داده شود، تأیید کننده میتواند در سند تغییراتی را اعمال نموده و سپس تأیید نماید و چنانچه دسترسی تأیید نداشته باشد آنرا به صادر کننده همراه با توضیحاتی جهت اعمال تغییرات برگشت دهد.<br />•  یک فعالیت جهت انجام کاری توسط مدیر مافوق در کارتابل فردی قرار میگیرد و پس از انجام کار توسط کاربر مربوطه، مدیر توسط سیستم اعلان از انجام آن مطلع می گردد.</p>";s:8:"ct_photo";s:0:"";s:12:"ct_photo_src";s:0:"";s:8:"ct_video";s:0:"";s:13:"ct_saved_rows";s:4:"4847";s:16:"ct_saved_modules";s:5:"23687";s:17:"ct_page_templates";s:4:"5299";s:9:"video_url";s:0:"";s:11:"video_ratio";s:4:"16_9";s:14:"video_autoplay";s:2:"no";s:22:"youtube_related_videos";s:2:"no";s:23:"youtube_player_controls";s:2:"no";s:10:"iframe_url";s:0:"";s:13:"iframe_height";s:3:"360";s:12:"async_iframe";s:2:"no";s:11:"modal_width";s:3:"900";s:12:"modal_effect";s:13:"uabb-effect-1";s:16:"content_bg_color";s:6:"ffffff";s:13:"overlay_color";s:6:"000000";s:17: