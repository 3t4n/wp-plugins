51:{s:11:"heading_tag";s:2:"h2";s:13:"heading_title";s:34:"طراحی سایت سازمانی";s:12:"dual_heading";s:2:"no";s:14:"heading_title2";s:15:"Secondary Title";s:13:"heading_style";s:12:"inline-block";s:17:"heading_alignment";s:5:"right";s:24:"heading_alignment_medium";s:5:"right";s:28:"heading_alignment_responsive";s:6:"center";s:11:"enable_link";s:3:"yes";s:12:"heading_link";s:0:"";s:21:"heading_link_nofollow";s:2:"no";s:17:"heading_sub_title";s:875:"<p style="text-align: justify;">سازمان ها و ادارات دولتی در راستای پیاده‌سازی دولت الکترونیک و افزایش دسترس‌پذیری برای شهروندان تلاش می‌کنند. تسهیل فرایندهای سازمانی و کاهش بروکراسی اداری نیز از دیگر اهداف ایشان است. از همین‌رو پورتال اطلاع‌رسانی سازمان خود را معمولا در بازه‌های زمانی سه‌ساله، ارتقاء می‌دهند. رعایت الزامات طراحی سایت های دولتی، حساسیت بالای امنیتی و <strong>طراحی حرفه ای UI و UX سایت</strong> ، داده‌ورزان را به یکی از <strong>بهترین شرکت های طراح سایت سازمانی</strong> تبدیل کرده است.</p>";s:17:"heading_separator";s:9:"line_only";s:25:"heading_separator_postion";s:6:"middle";s:18:"heading_line_style";s:5:"solid";s:21:"font_title_line_space";s:2:"20";s:19:"heading_icon_select";s:16:"font_icon_select";s:24:"heading_font_icon_select";s:0:"";s:26:"heading_custom_icon_select";s:0:"";s:30:"heading_custom_icon_select_src";s:0:"";s:20:"font_icon_line_space";s:2:"20";s:10:"line_width";s:3:"300";s:11:"line_height";s:1:"2";s:10:"line_color";s:6:"000000";s:19:"font_icon_font_size";s:2:"16";s:15:"font_icon_color";s:6:"000000";s:18:"font_icon_bg_color";s:0:"";s:17:"field_separator_5";s:0:"";s:22:"font_icon_border_width";s:1:"0";s:22:"font_icon_border_style";s:4:"none";s:22:"font_icon_border_color";s:0:"";s:23:"font_icon_border_radius";s:3:"100";s:17:"field_separator_6";s:0:"";s:28:"separator_heading_top_margin";s:1:"0";s:31:"separator_heading_bottom_margin";s:2:"20";s:18:"heading_color_type";s:5:"solid";s:13:"heading_color";s:0:"";s:24:"heading_gradient_setting";a:4:{s:6:"colors";a:0:{}s:4:"type";s:6:"linear";s:5:"stops";a