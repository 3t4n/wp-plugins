.dv-sr-product-01 .selected-products-content .slick-slide .uabb-post-thumbnail a{display: block;line-height: 0;margin: 0 auto;border-radius: 50%;max-width: 220px;border: 30px solid #dddddd;overflow: hidden;transition: all 0.5s;position: relative;}
.dv-sr-product-01 .selected-products-content .slick-slide .uabb-post-thumbnail a:after{content:"";position:absolute;left: 0;right: 0;top: 0;bottom: 0;border-radius: 50%;color: #fff;display: flex;align-items: center;justify-content: center;font-family: arial;transform: rotateY(180deg);font-size: 30px;font-weight: bold;opacity: 0;transition: all 0.3s;background: url(http://theme.webexir.net/wp-content/uploads/2018/04/product-rotate-logo.png) center center no-repeat #ed1c24;background-size: contain;}
.dv-sr-product-01 .selected-products-content .slick-slide:hover .uabb-post-thumbnail a:after{opacity: 1;}
.dv-sr-product-01 .selected-products-content .slick-slide:hover .uabb-post-thumbnail a{transform: rotateY(180deg);}
.dv-sr-product-01 .selected-products-content .slick-slide .uabb-post-thumbnail a img{background-color: #fff;padding: 20px;}
@media screen and (max-width: 992px) {
    .dv-sr-product-01 .slick-arrow.slick-prev{left: inherit;right: 0;}
    .dv-sr-product-01 .slick-arrow.slick-next{right: inherit;left: 0;}
}
@media screen and (max-width: 500px){

    .dv-sr-product-01 .selected-products-content .slick-slide .uabb-blog-post-content .uabb-post-heading{font-size: 14px;}
