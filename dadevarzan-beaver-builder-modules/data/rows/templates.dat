.dv-sr-link-16{position: relative;}
.dv-sr-link-16:before{display:block;content:"";position: absolute;left: 0;right: 0;top: 0;bottom: 15%;z-index: 0;background-color: #efefef;}
.dv-sr-link-16 .hompage-interactive-banner .uabb-module-content:hover .uabb-new-ib-desc .uabb-new-ib-title{color: transparent;}
.dv-sr-link-16 .hompage-interactive-banner .uabb-module-content:hover .uabb-new-ib-desc .uabb-new-ib-title:after{opacity: 1 !important;}
.dv-sr-link-16 .Canned .hompage-interactive-banner .uabb-module-content .uabb-new-ib-desc .uabb-new-ib-title:after{display: flex;content:"";position: absolute;left: 0;right: 0;top: -60px;width: 150px;height: 150px;margin: 0 auto;align-items: center;border-radius: 50%;transition: all 0.5s;background: url(http://theme.webexir.net/wp-content/uploads/2018/04/Jams.png) center center no-repeat #ff9000;background-size: contain;z-index: 1;opacity: 0;}
.dv-sr-link-16 .cucumber .hompage-interactive-banner .uabb-module-content .uabb-new-ib-desc .uabb-new-ib-title:after{display: flex;content:"";position: absolute;left: 0;right: 0;top: -60px;width: 150px;height: 150px;margin: 0 auto;align-items: center;border-radius: 50%;transition: all 0.5s;background: url(http://theme.webexir.net/wp-content/uploads/2018/04/Jams.png) center center no-repeat #ff9000;background-size: contain;z-index: 1;opacity: 0;}
.dv-sr-link-16 .tomato-paste .hompage-interactive-banner .uabb-module-content .uabb-new-ib-desc .uabb-new-ib-title:after{display: flex;content:"";position: absolute;left: 0;right: 0;top: -60px;width: 150px;height: 150px;margin: 0 auto;align-items: center;border-radius: 50%;transition: all 0.5s;background: url(http://theme.webexir.net/wp-content/uploads/2018/04/Jams.png) center center no-repeat #ff9000;background-size: contain;z-index: 1;opacity: 0;}
.dv-sr-link-16 .Condiments .hompage-interactive-banner .uabb-module-content .uabb-new-ib-desc .uabb-new-ib-title:after{display: flex;content:"";position: absolute;left: 0;right: 0;top: -60px;width: 150px;height: 150px;margin: 0 auto;align-items: center;border-radius: 50%;transition: all 0.5s;background: url(http://theme.webexir.net/wp-content/uploads/2018/04/Jams.png) center center no-repeat #ff9000;background-size: contain;z-index: 1;opacity: 0;}
.dv-sr-link-16 .hompage-interactive-banner .uabb-module-content .uabb-new-ib-desc .uabb-new-ib-title:before{display: flex;content:"";position: absolute;left: 0;right: 0;top: -60px;width: 150px;height: 150px;margin: 0 auto;align-items: center;background: rgba(0, 0, 0, 0.6);border-radius: 50%;z-index: -1;transition: all 0.5s;}
.dv-sr-link-16 .hompage-interactive-banner .uabb-module-content .uabb-new-ib-desc .uabb-new-ib-content p{display: inline-block;border-top: 2px solid #ffcc00;font-weight: 500;}
.dv-sr-link-16 .hompage-interactive-banner .uabb-module-content .uabb-new-ib-desc .uabb-new-ib-content{bottom: calc(50% - 130px);}

@media screen and (max-width: 992px) {
    .dv-sr-link-16 .hompage-interactive-banner .uabb-module-content .uabb-new-ib-desc .uabb-new-ib-content p{font-size: 16px;}
    .dv-sr-link-16 .hompage-interactive-banner .uabb-module-content .uabb-new-ib-desc .uabb-new-ib-content{bottom: calc(50% - 90px);}
    .dv-sr-link-16 .hompage-interactive-banner .uabb-module-content .uabb-new-ib-desc .uabb-new-ib-title{font-size: 14px;}
    .dv-sr-link-16 .hompage-interactive-banner .uabb-module-content .uabb-new-ib-desc .uabb-new-ib-title:before, .hompage-interactive-banner .uabb-module-content .uabb-new-ib-desc .uabb-new-ib-title:after{width: 90px !important;height: 90px !important;top: -35px !important;}
}
@media screen and (max-width: 768px) {
    .dv-sr-link-16 .hompage-interactive-banner .uabb-module-content{max-width: 300px;display: block;min-width: inherit;margin: 0 auto;max-height: 300px;}
}
@media screen and (max-width: 500px){
    .dv-sr-link-16 .hompage-section-titel .fl-heading .fl-heading-text:before, .hompage-section-titel .fl-heading .fl-heading-text:after{display:none;}
    .dv-sr-link-16 .hompage-section-titel .fl-heading .fl-heading-text{font-size: 22px;}
}
