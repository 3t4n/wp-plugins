.footer-row1 p{line-height:25px; text-align:justify;}
.footer-row1 p, .footer-row1 p a{color:#dfdfdf !important;}
.footer-contact-us-content p .en{
    font-family: sans-serif;
}
.footer-power-by .fl-html{
    display:  flex;
    justify-content:  space-between;
    flex-wrap:  wrap;
}
.footer-row1 .menu-item:hover, .footer-row1 .menu-item:hover a{color:#fff !important;}
.footer-row1 .menu-item{
    border-top: none !important;
    font-size: 20px !important;
    color: #ffcc00 !important;
    list-style: disc !important;
    margin-right: 20px !important;
    line-height: 0;
}
.footer-row1 ul li a{font-size: 14px !important;line-height: 30px !important;padding: 0 !important;}
.footer-row-2 p, footer .dadevarzan-powered-links{margin: 0;color: #dfdfdf !important; float: right;line-height: 32px}
.footer-row-2 .power-by-image-container{width: 60px;height:auto;fill: #dfdfdf;position:relative; top:7px}
.footer-row-2 a{color:#ffcc00;}
.dv-powerby .dadevarzan-powered-by{
    text-align: left;
}
@media screen and (max-width: 768px){
.footer-power-by .fl-html{
   font-size:12px;
    justify-content:  center;}
    .dv-powerby .dadevarzan-powered-by{
        text-align:center;
    }
}

