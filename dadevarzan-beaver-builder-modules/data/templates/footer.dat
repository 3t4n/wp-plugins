    font-weight: 500;
    font-size: 20px;
    margin-bottom: 10px;
}
.footer-social-icon .adv-icon-link{ 
    line-height: 0;
    margin-bottom:0 !important;
}
.footer-row-1 a{
    color: #fff;
}
.footer-row-3:after {
    position: absolute;
    left: 0;
    right: 0;
    width: 100%;
    height: 16px;
    content: "";
    background: url(http://fasehawi.webexir.net/wp-content/uploads/2018/06/shape_horizontal.svg) no-repeat center center;
    background-size: cover;
    z-index: 10;
}
.footer-power-by .fl-html{
    display:  flex;
    justify-content:  space-between;
    flex-wrap:  wrap;
}
.footer-row-3 p, footer .dadevarzan-powered-links{margin: 0;color: #000 !important; float: right;line-height: 32px}
.footer-row-3 .power-by-image-container{width: 60px;height:auto;fill: #000;position:relative; top:7px}
.footer-row-3 a{color:#000;}
@media screen and (max-width: 768px){
    .footer-row-2 .menu .menu-item:first-child{
    font-size: 16px;
    }
    .footer-row-1 .fl-col-content{
        border:none;
    }
.footer-power-by .fl-html{
   font-size:12px;
    justify-content:  center;}
}

