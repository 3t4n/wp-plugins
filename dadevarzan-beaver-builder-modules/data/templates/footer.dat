    text-align: left;
}
.footer-contact-us-content .location{color:#ffcc00 !important;}
.footer-row1 p{line-height:25px; text-align:justify;}
.footer-row1 p, .footer-row1 p a{color:#dfdfdf !important;}
 #dv-newsletter-obj input[type="text"]{border-radius:5px;}
.footer-contact-us-content p .en{
    font-family: sans-serif;
}
.footer-power-by .fl-html{
    display:  flex;
    justify-content:  space-between;
    flex-wrap:  wrap;
}
.footer-row1 .fl-heading-text{
    font-size: 16px;
    font-weight: 500;
}
.footer-row1 .menu-item:hover, .footer-row1 .menu-item:hover a{color:#fff !important;}
.footer-row1 .menu-item{
    border-top: none !important;
    font-size: 20px !important;
    color: #74a72a !important;
    list-style: disc !important;
    margin-right: 20px !important;
    line-height: 0;
}
.footer-row1 .fl-heading-text:after{
    display:block;
    content:"";
    width: 100px;
    height:  2px;
    background: #37a83b;
    margin-top: 10px;}
.footer-row1 ul li a{text-align:right; font-size: 14px !important;line-height: 30px !important;padding: 0 !important;}
.footer-header .fl-heading:after{display:block;content:"";width: 100%;height: 2px;background-color: #db1e24;margin-top: 10px;max-width: 100px;}
.footer-row-2 p, footer .dadevarzan-powered-links{margin: 0;color: #dfdfdf !important;line-height: 32px}
.footer-row-2 .power-by-image-container{width: 60px;height:auto;fill: #dfdfdf;position:relative; top:5px}
.footer-row-2 a{color:#ffcc00;}
.instagram-footer-section .eapps-instagram-feed-posts-slider .eapps-instagram-feed-posts-item-template-tile{
    border-radius:  50%;
}
@media screen and (max-width: 768px){
    .footer-powerby .dadevarzan-powered-by{
        text-align:center;
        font-size:12px;
    }
    .footer-power-by .fl-html {
        justify-content: center;
        font-size:12px;
    }
}
@media screen and (max-width: 500px){
    .footer-header .fl-heading{font-size: 16px;}
    header.fl-builder-content .hedear-row2{width:100% !important;}
