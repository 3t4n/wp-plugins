_sub_title";s:0:"";}}}s:8:"settings";O:8:"stdClass":2:{s:3:"css";s:1741:".footer-row1 .menu-item:hover, .footer-row1 .menu-item:hover a{color:#fff !important;}
.footer-header .fl-heading:after{display:block;content:"";width: 100%;height: 2px;background-color: #db1e24;margin-top: 10px;max-width: 100px;}
.footer-row-2 p, footer .dadevarzan-powered-links{margin: 0;color: #dfdfdf !important; float: right;line-height: 32px}
.footer-row-2 .power-by-image-container{width: 65px;height:auto;fill: #dfdfdf;position:relative; top:7px}
.footer-row-2 a{color:#ffcc00;}
.footer-row1 .footer-contact .fl-rich-text p strong{font-weight:normal; color:#ffcc00 !important;}
.footer-row1 .menu-item{
    border-top: none;
    font-size: 25px !important;
    color: #f6bb19 !important;
    list-style: disc;
    margin-right: 20px;
    line-height: 0px;
}
.footer-row1 p, .footer-row1 a{
    font-size: 13px;
    line-height: 25px;
    margin: 0;
    display: inline-block;
}
.footer-row1 ul li a{font-size: 14px;color: #fff;line-height: 30px;padding: 0 !important;}
.footer-row-2 p svg {width: 90px;height: auto;fill: #ffcc00;position: relative;top: 7px;}
.footer-power-by a {color: #ffcc00 !important;}
.footer-row-2 p {margin: 0;color: #dfdfdf;float: right;line-height: 32px;}
.footer-row-2 .footer-social-icon .fl-icon{margin:0; margin-right:10px;}
footer{line-height:25px;}
.footer-row1 .footer-about{text-align:justify;}
.footer-row1 .footer-contact a{color:ffcc00;}
@media screen and (max-width: 992px) {
    .footer-row2 .fl-rich-text p a:last-child{
    float: none;
    margin: 0 auto;
    margin-top: 10px;
}
}
@media screen and (max-width: 768px) {
    .footer-about p {
    text-align: justify;
    line-height: 22px;
}
    .footer-row2 .fl-rich-text p{text-align:center;}
}
