    color:#fff !important;
}
.footer-row1 .menu-item{
    border-top: none !important;
    font-size: 20px !important;
    color: #17a0cd !important;
    list-style: disc !important;
    margin-right: 20px !important;
    line-height: 0;
}
.footer-row1 .fl-heading-text:after{
    display:block;
    content:"";
    width: 100px;
    height:  2px;
    background: #696969;
    margin-top: 10px;
}
.footer-row1 ul li a{
    font-size: 14px !important;
    line-height: 30px !important;
    padding: 0 !important;
}
.footer-header .fl-heading:after{
    display:block;content:"";
    width: 100%;
    height: 2px;
    background-color: #696969;
    margin-top: 10px;
    max-width: 100px;
}
.footer-row-2 p, footer .dadevarzan-powered-links{
    argin: 0;
    color: #333333 !important; 
    float: right;
    line-height: 32px;
}
.footer-row-2 .power-by-image-container{
    width: 60px;height:auto;
    fill: #dfdfdf;
    position:relative; 
    top:7px;
}
.footer-row-2 a{color:#000;font-size:12px;}
.footer-row-2 svg{display:none;}
.instagram-footer-section .eapps-instagram-feed-posts-slider .eapps-instagram-feed-posts-item-template-tile{
    border-radius:  50%;
}

.dv-social-icons .menu-item .menu-item-text span{
    display: none;
}
.dv-social-icons .menu-item .menu-item-text img{
    margin: 0;
}
.dv-social-icons .menu-item a{
    padding: 0 2px !important;
}
@media screen and (max-width: 768px){
    #menu-social-menu{
        display: flex;
    }
}
@media screen and (max-width: 500px){
    .footer-header .fl-heading{font-size: 16px;}
    header.fl-builder-content .hedear-row2{width:100% !important;}
}";s:2:"js";s:0:"";}s:4:"type";s:6:"layout";}}}