    text-align: left;
}
.footer-contact-us-content .location{color:#ffcc00 !important;}
.footer-contact-us-content p .en{
    font-family: sans-serif;
}
.footer-row1 .menu-item{
    border-top: none !important;
    font-size: 20px !important;
    color: #ff6600 !important;
    list-style: disc !important;
    margin-right: 20px !important;
    line-height: 0;
}
.footer-row1 ul li a{
    font-size: 14px !important;
    line-height: 30px !important;
    padding: 0 !important;
}
.footer-row-2 p, footer .dadevarzan-powered-links{
    margin: 0;
    line-height: 32px;
}
.footer-row-2 .power-by-image-container{
    width: 60px;height:auto;fill: #dfdfdf;position:relative; top:5px}
.footer-row-2 a{color:#ffcc00;}
#dv_power_by_layer_1{
    display: none;
}
.footer-power-by .fl-html p{
    display: block;
    border-bottom:1px solid #bbb;
    padding: 8px 0;
    text-align: left;
    margin-bottom: 0;
    font-size: 13px;
    color:#777;
}
.footer-power-by .fl-html .dadevarzan-powered-by{
    display: block;
    color:#777;
    text-align: left;
    font-size: 12px;
}
.footer-power-by .fl-html .dadevarzan-powered-by a{
    color:#777;
    font-size: 12px;
}
#dv-newsletter-obj .uabb-sf-subheading{
    display: none;
}
#dv-newsletter-obj .uabb-form-wrap {
    flex-wrap: wrap;
}
#dv-newsletter-obj .uabb-form-wrap div{
    width: 100%;
    margin-bottom: 10px;
}
#dv-newsletter-obj .uabb-form-wrap .uabb-form-button a{
    padding: 5px 0;
    display: block;
}
.dv-powered .dadevarzan-powered-links{
    text-align: left;
    display: block;
    font-size: 12px;
    line-height: 25px;
}
@media screen and (max-width: 768px){
    .footer-powerby-obj .dadevarzan-powered-by{
        text-align: center;
        font-size:12px;
    }
    .footer-power-by .fl-html{
        font-size:12px;
        justify-content:  center;
    }
}

