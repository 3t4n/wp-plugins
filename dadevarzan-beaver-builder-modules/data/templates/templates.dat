    position:  relative;
    max-width:  255px;
    margin:  0 auto;
}
.top-footer-info-box .pp-infobox .pp-infobox-image{
    margin:  0;
    overflow:  hidden;
}
.top-footer-info-box .pp-infobox .pp-infobox-title-wrapper{
    position:  absolute;
    bottom:  0;
    left:  0;
    right:  0;
    padding: 20px 0;
}
.other-information-section .other-information-section-tabel .fl-col-content{
    box-shadow: 0 4px 9px rgba(15,15,15,.22);
}
.other-information-section .other-information-section-tabel .fl-col-content table{
    border:  none !important;
}
.other-information-section .other-information-section-tabel .fl-col-content table thead{
    background-color: #1e52aa;
}
.other-information-section .other-information-section-tabel .fl-col-content table thead #pp-table-col-1:before{
    display: block;
    content: "";
    position: absolute;
    right: 100%;
    height: 5px;
    bottom: 40%;
    width: 100%;
    background-color: #f37320;
    max-width: 50px;
    margin: 0 auto;
}
.other-information-section .other-information-section-tabel .fl-col-content table thead #pp-table-col-1{
    border: none !important;
    padding: 20px 10px;
    display:  inline-block;
    position:  relative;
    font-size:  20px;
    font-weight:  500;
}
.other-information-section .other-information-section-tabel .fl-col-content table thead #pp-table-col-2{
    font-size: 12px;
    border: none;
    text-align: left;
    padding: 10px;
}
.other-information-section .other-information-section-tabel .fl-col-content table tbody{
}
.other-information-section .other-information-section-tabel .fl-col-content table tbody tr{border-color: #e5e5e5;}
.other-information-section .other-information-section-tabel .fl-col-content table tbody tr td:last-child{
    text-align:  left;
    color:  #620900;
}
.other-information-section .other-information-section-tabel-buttun a{
    text-align: left !important;
    font-weight: 500 !important;
    border: none !important;
}
.other-information-section .other-information-section-tabel .fl-col-content table tbody tr td:first-child .tablesaw-cell-label{
    display:  none !important;
}
.other-information-section .other-information-section-tabel .fl-col-content table tbody tr td:last-child .tablesaw-cell-label{padding:  0;padding-left: 20px;}
.news-section-right-part .uabb-post-wrapper {
    max-width: 500px;
    margin: 0 auto;
}
.news-section-right-part
 .uabb-blog-posts .uabb-post-thumbnail img {
    width: 100%;
}
.news-section-right-part .uabb-blog-post-inner-wrap{
    display: flex;
    flex-wrap: wrap;
}
.news-section-right-part .uabb-blog-post-inner-wrap .uabb-blog-post-content{
    width: calc(100% - 150px);
    order: 1;
    padding: 0;
    text-align: right;
}
.news-section .uabb-blog-post-inner-wrap .uabb-blog-post-content .uabb-blog-posts-description{
    color: #191818;
}
.news-section-right-part .uabb-blog-post-inner-wrap .uabb-post-thumbnail{
    order: 2;
    float: left;
    max-width: 130px;
    margin-right: 20px;
}
.news-section-right-part .uabb-blog-post-inner-wrap .uabb-post-thumbnail a{
    display: block;
    line-height: 0;
}
.news-section  .uabb-blog-posts-shadow.clearfix{
    background: no-repeat;
    box-shadow: none;
}
.news-section-left-part .uabb-post-wrapper{
    margin-bottom: 0 !important;
}

.statistics-section .statistics-section-counter .uabb-number-text .uabb-number-string span{
    width: 80px;
    height: 80px;
    margin:  0 auto;
    display:  flex;
    align-items:  center;
    justify-content:  center;
    background-color:  #ff7014;
    border-radius:  50%;
    position:  relative;
    bottom: 35px;
}
.statistics-section .statistics-section-counter .uabb-number-text .uabb-number-after-text{
    margin-top: -20px;
}
.clearance-steps-section .clearance-steps-part.lf .uabb-imgicon-wrap{
    margin-left: 0;
    margin-right: 20px;
}
.clearance-steps-section .clearance-steps-part.lf .uabb-infobox-content{
    text-align:  right;
}
.clearance-steps-section .clearance-steps-part .uabb-imgicon-wrap{
    margin:  0;
    margin-left:  20px;
    position:  relative;
}
.clearance-steps-section .clearance-steps-part.item-2 .uabb-imgicon-wrap:before{
  content:"2";
}
.clearance-steps-section .clearance-steps-part.item-3 .uabb-imgicon-wrap:before{
  content:"3";
}
.clearance-steps-section .clearance-steps-part.item-4 .uabb-imgicon-wrap:before{
  content:"4";
}
.clearance-steps-section .clearance-steps-part.item-5 .uabb-imgicon-wrap:before{
  content:"5";
}
.clearance-steps-section .clearance-steps-part.item-6 .uabb-imgicon-wrap:before{
  content:"6";
}
.clearance-steps-section .clearance-steps-part .uabb-imgicon-wrap:before{
  content:"1";
  width: 45px;
  height: 45px;
  position:  absolute;
  background-color:  #f37320;
  color:  #fff;
  display:  flex;
  align-items:  center;
  justify-content:  center;
  bottom: -20px;
  border-radius:  50%;
  left:  0;
  font-size: 28px;
  font-weight: bold;
}
.services-section .services-part .uabb-module-content .uabb-ultb3-info{
    position:  relative;
    z-index: 10;
}
.services-section .services-part .uabb-module-content a{z-index:20;}
.services-section .services-part .uabb-module-content .uabb-ultb3-info .uabb-ultb3-title{}
.services-section .services-part .uabb-module-content:hover .uabb-ultb3-info .uabb-ultb3-title:after{
    margin-top: 10px;
    margin-bottom: 10px;
    background-color: #ef6b1c;
}
.services-section .services-part .uabb-module-content .uabb-ultb3-info .uabb-ultb3-title:after{display:block;content:"";height: 2px;width:  200px;margin:  0 auto;background-color: #ff000000;margin-top: 0;margin-bottom: 0;transition: all 0.5s;}
.services-section .services-part .uabb-module-content:before{display:block;content:"";position:  absolute;left:  20px;right:  20px;top: 20px;bottom:  20px;border: 1px solid rgba(255, 255, 255, 0.5);z-index: 10;transition: all 0.5s;}
.services-section .services-part .uabb-module-content:hover:before{
    background-color: rgba(42, 86, 159, 0.7);
    border-color: rgba(42, 86, 159, 0.7);
}
.services-section .services-part .uabb-ultb3-img{
    width:  100% !important;
}
.hompage-section-titel .fl-heading .fl-heading-text {
    position: relative;
    z-index: 10;
    padding: 0 0px 0 100px;
}
.hompage-section-titel .fl-heading .fl-heading-text:before {
    display: block;
    content: "";
    position: absolute;
    left:0;
    height: 5px;
    bottom: 40%;
    width: 100%;
    background-color: #2a569f;
    max-width: 80px;
    margin: 0 auto;
}
.banner-heading-1 .fl-heading-text{
    display: inline-block;
    padding:  20px;
    background-color:  #fff;
    margin-bottom:  20px;
    min-width: 400px;
    text-align: center;
}
.banner-heading-2 .fl-heading-text{
    margin: 0;
    display: block;
    position: relative;
    padding: 3px 20px;
    z-index: 20;
    overflow: hidden;
    background-color: #000;
    min-width: 400px;
    text-align: center;
}
.banner-heading-2 .fl-heading-text:hover:before{right: -40px;}
.banner-heading-2 .fl-heading-text:before{
    display: block;
    content: "";
    position: absolute;
    left: 0;
    right: 43%;
    top: 0;
    bottom: 0;
    background-color: #2a569f;
    z-index: -1;
    transition: all 0.7s;
}
.banner-heading-2 .fl-heading{
    display:  inline-block;
    float:  left;
}


/*  overwrite fl-builder-rtl.css رفع مشکل راست به چپ در قسمت لایو ادیت */
.fl-builder--main-menu-panel {
    left: 10px;
    right: auto;
}
.fl-builder-publish-actions {
	left: auto;
	right: 0;
}
.fl-builder-bar-title {
    border-left: none;
    border-right: 2px solid #D5DADD;
    flex-direction: row-reverse;
}
.fl-theme-builder-preview-select .fl-theme-builder-preview-select-title{
    flex-direction: row;
    -ms-flex-direction: row;    
    text-align: right;
}
.fl-builder--search-results-panel, .fl-builder-panel {
    left: auto;
    right: 20px;
}
/*  overwrite fl-builder-rtl.css */

/*  رفع مشکل کروسل در سایت های راست به چپ  */
.uabb-blog-posts-carousel{direction: ltr;}
.uabb-blog-posts-carousel .uabb-blog-post-content{direction: rtl;}
/*  رفع مشکل کروسل در سایت های راست به چپ  */

.fl-theme-builder-preview-select-open .fl-theme-builder-preview-select-items{
    text-align: right;
}
.fl-lightbox,.fl-builder-bar{direction:ltr!important;}
.fl-builder-settings-fields .fl-field-control-wrapper {
	text-align: left;
}
.fl-lightbox-controls{right:10px;left:auto;}
.fl-page-content .dv-module-header .fl-row-content-wrap:after{
    /* رنگ پس زمنیه هدر سایت*/ 
    background-color: #000000;
    opacity:0.5;
}
.dv-module-header .dv-module-header-title .uabb-heading-text{
    color:white; /* رنگ هدینگ صفحه */ 
}
.dv-module-header .fl-col-content a{
    color:#45e4ff; /* رنگ لینک های موجود در هدینگ صفحه */ 
}
.dv-module-header .fl-col-content a:hover{
    color:#ffe200; /* رنگ لینک های موجود در هدینگ صفحه */ 
}
.dv-module-header .dv-module-header-title .uabb-separator{
    border-color:#ff9000; /* رنگ خط جداکننده تیتر از توضیحات */
}
.dv-module-header .dv-module-header-title .uabb-subheading{
    color:#ccc; /* رنگ توضیحات زیر تیتر */
}
.dv-module-header-breadcrumb{
    color:#ccc; /* رنگ متن بردکرامب  */
    text-align:center;
}
.dv-module-header-breadcrumb.dv-right{
    text-align: right;/* چینش بردکرام در حالت راست چین  */
}
@media screen and (max-width: 992px) {
    .clearance-steps-content .fl-col-content{background:none !important;}
}
@media screen and (max-width: 768px) {
    .news-section-right-part .uabb-blog-post-inner-wrap .uabb-post-thumbnail{
    max-width: inherit;
    width: 100%;
    order: 1;
    margin:0 !important;
}
    .news-section .uabb-blog-posts .uabb-post-thumbnail img{
    width:  100%;
}
    .news-section-right-part .uabb-blog-post-inner-wrap .uabb-post-thumbnail a img{
    max-width: inherit;
    height: auto;
    border-radius: 0;
    margin-bottom: 10px;
}
    .news-section-right-part .uabb-blog-post-inner-wrap .uabb-blog-post-content{
    width: 100%;
    text-align:center;
}
    .dv-module-header-breadcrumb.dv-right{ text-align: center; }
    .dv-module-header .fl-row-content-wrap{background-position:right center;}
}

@media screen and (max-width: 1200px){}
@media screen and (max-width: 992px){}
@media screen and (max-width: 768px){
    .banner-heading-2 .fl-heading-text{
    min-width: inherit !important;
}
    .banner-heading-1 .fl-heading-text{
    min-width: inherit !important; 
}
    .banner-heading-2 .fl-heading-text{
    display: inline-block;
}
    .news-section .uabb-post-wrapper{
    max-width: 500px;
    margin:  0 auto;
}
    .banner-heading-2 .fl-heading{float:none; display:block;}
}
@media screen and (max-width: 500px){
    .statistics-section .fl-col-group .fl-col{width:100% !important;}
