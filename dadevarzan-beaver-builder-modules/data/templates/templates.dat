.fl-module-pp-gravity-form .gfield .textarea{background-color: rgba(255, 255, 255, 0) !important;}.dv-contact-form .gform_footer{
    padding: 0 !important;
}
.dv-contact-form .gform_footer .gform_button{
    padding: 5px 25px !important;
    background: #9d90ff;
    
}
.dv-sr-link-04 .dv-solution-items .uabb-info-list-wrapper{
    flex-wrap: wrap;
    display: flex;
}
.dv-sr-link-04 .dv-solution-items .uabb-info-list-item{
    width: 23%!important;
    background-color: white;
    border:1px solid #ccc;
    margin: 1%!important;
    border-radius: 6px;
    box-shadow: 0 0 0 rgba(0,0,0,0);
    transition: 0.3s;
}
.dv-sr-link-04 .dv-solution-items .uabb-info-list-item:hover{
    box-shadow: 0 0 15px rgba(0,0,0,0.2);
}
.dv-sr-link-04 .dv-solution-items .uabb-info-list-item > div{
    padding: 40px 0px 20px;
}
.dv-sr-link-04 .dv-solution-items .uabb-info-list-item .uabb-info-list-title{
    margin:10px 0;
}
@media screen and (max-width: 992px) {
    .dv-sr-link-04 .dv-solution-items .uabb-info-list-item{
        width: 31%!important;
    }
}
@media screen and (max-width: 768px) {
    .dv-sr-link-04 .dv-solution-items .uabb-info-list-item{
        width: 48%!important;
    }
}
@media screen and (max-width: 500px) {
    .dv-sr-link-04 .dv-solution-items .uabb-info-list-item{
        width: 100%!important;
    }
}
