يريت طرح، مديريت پروژه، طراحي فرآيندها، مشاوره خريد و بهره برداري و تدوين و توسعه نرم افزارهاي مربوطه را در زمينه هاي انرژي، صنايع فلزي و غير فلزي ،صنايع نفت و گاز و پتروشيمي و صنايع نيروگاهي ارائه مي نمايد.</p>";s:17:"heading_separator";s:6:"inline";s:25:"heading_separator_postion";s:6:"middle";s:18:"heading_line_style";s:5:"solid";s:21:"font_title_line_space";s:2:"15";s:19:"heading_icon_select";s:16:"font_icon_select";s:24:"heading_font_icon_select";s:0:"";s:26:"heading_custom_icon_select";s:0:"";s:30:"heading_custom_icon_select_src";s:0:"";s:20:"font_icon_line_space";s:2:"20";s:10:"line_width";s:3:"100";s:11:"line_height";s:1:"4";s:10:"line_color";s:6:"0058a1";s:19:"font_icon_font_size";s:2:"16";s:15:"font_icon_color";s:6:"000000";s:18:"font_icon_bg_color";s:0:"";s:17:"field_separator_5";s:0:"";s:22:"font_icon_border_width";s:1:"0";s:22:"font_icon_border_style";s:4:"none";s:22:"font_icon_border_color";s:0:"";s:23:"font_icon_border_radius";s:3:"100";s:17:"field_separator_6";s:0:"";s:28:"separator_heading_top_margin";s:2:"10";s:31:"separator_heading_bottom_margin";s:2:"20";s:18:"heading_color_type";s:5:"solid";s:13:"heading_color";s:0:"";s:24:"heading_gradient_setting";a:4:{s:6:"colors";a:2:{i:0;s:0:"";i:1;s:0:"";}s:4:"type";s:6:"linear";s:5:"stops";a:2:{i:0;i:0;i:1;i:100;}s:5:"angle";s:3:"180";}s:17:"field_separator_1";s:0:"";s:16:"heading_bg_color";s:0:"";s:19:"field_separator_1_1";s:0:"";s:20:"heading_border_style";s:4:"none";s:20:"heading_border_color";s:6:"000000";s:17:"field_separator_2";s:0:"";s:18:"heading_top_margin";s:1:"0";s:21:"heading_bottom_margin";s:2:"20";s:19:"heading2_color_type";s:5:"solid";s:14:"heading2_color";s:0:"";s:25:"heading2_gradient_setting";a:4:{s:6:"colors";a:2:{i:0;s:0:"";i:1;s:0:"";}s:4:"type";s:6:"linear";s:5:"stops";a:2:{i:0;i:0;i:1;i:100;}s:5:"angle";s:3:"180";}s:19:"field_separator_2_1";s:0:"";s:17:"heading2_bg_color";s:0:"";s:17:"field_separator_3";s:0:"";s:21:"heading2_border_style";s:4:"none";s:21:"heading2_border_color";s:6: