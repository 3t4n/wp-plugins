.guid-section .guid-section-part .uabb-module-content .uabb-ultb3-info:before{
    display:block;
    content:"";
    position: absolute;
    left: 0;
    right: 100%;
    top: 0;
    bottom: 0;
    background: -webkit-linear-gradient(left, rgba(21, 104, 147, 0.8) 0%,rgba(155, 166, 30, 0.8) 100%);
    z-index:  -1;
    transition: all 0.5s;
}
.guid-section .guid-section-part .uabb-module-content .uabb-ultb3-info{
    width: auto;
    margin:  0 auto;
    padding: 15px;
    position:  relative;
}
.guid-section .guid-section-part .uabb-module-content .uabb-ultb3-info .uabb-ultb3-title{
    border-bottom: 2px solid #ffcc00;
    padding-bottom:  20px;
}
.guid-section .guid-section-part .uabb-module-content .uabb-ultb3-info .uabb-ultb3-desc{
    color: rgba(255, 255, 255, 0.6);
}
.guid-section .guid-section-part:hover .uabb-module-content .uabb-ultb3-info .uabb-ultb3-desc{
    color: #ffffff;
}
.news-section .uabb-blog-post-inner-wrap{
    display: flex;
    align-items: center;
    flex-wrap: wrap;
}
.news-section .uabb-blog-post-inner-wrap .uabb-blog-post-content{
    width: calc(100% - 140px);
    order: 1;
    padding: 0;
    text-align: right;
}
.news-section .uabb-blog-post-inner-wrap .uabb-post-thumbnail{
    order: 2;
    float: left;
    max-width: 120px;
    margin-left: 20px;
}
.news-section .uabb-blog-post-inner-wrap .uabb-post-thumbnail a{
    display: block;
    line-height: 0;
}
.news-section .uabb-blog-post-inner-wrap .uabb-post-thumbnail a img{
    width: 100%;
    height: 120px;
    border-radius: 50%;
    max-width: 120px;
}
.brands-section .brands-section-content .pp-image-carousel{
    width: 90%;
    margin: 0 auto;
    position: static;
}
.brands-section .pp-image-carousel .pp-swiper-button-next{
    right: 0px !important;
    color: #858585;
    font-size: 50px;
}
.brands-section .pp-image-carousel .pp-swiper-button-prev{
    left:  0px !important;
    color: #858585;
    font-size: 50px;
}
.color-pallet-section{
    position:  relative;
}
.color-pallet-section .fl-row-content-wrap .fl-row-content{
    position:  relative;
    z-index: 2;
}
.color-pallet-section:before{display:block;content:"";position:  absolute;left:  0;right:  0;top: 0;height: 70%;background-color: #e4e4e4;z-index: 1;bottom:  0;}
.color-pallet-section .color-pallet-section-text .fl-heading-text{
      display: block;
      background: -webkit-linear-gradient(left, rgba(21,104,147,1) 0%,rgba(155,166,30,1) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
}
.color-pallet-section .fl-col-group{
    display:  flex;
    flex-wrap:  wrap;
}
.color-pallet-section .fl-col-group .color-pallet{
    width: 20% !important;
    float: none !important;
}
.color-pallet-section .fl-col-group .color-pallet .fl-module-content > .uabb-module-content:hover{
	box-shadow: -4px 5px 8px rgba(15,15,16,.19);
	transform: translateY(-7px);
}
.color-pallet-section .fl-col-group .color-pallet .fl-module-content > .uabb-module-content{
	box-shadow: -4px 1px 8px rgba(15,15,16,.19);
    transition: 0.5s cubic-bezier(0.22, 0.61, 0.36, 1);
    max-width: 200px;
    margin: 0 auto;
}
.site-part-section .info-banner .uabb-module-content{
    box-shadow: 0px 0px 16px rgba(15,15,16,.19);
    max-width: 326px;
    margin: 0 auto;
}
.site-part-section .info-banner .uabb-module-content .uabb-ultb3-info{
    padding:  0;
}
.site-part-section .info-banner .uabb-module-content .uabb-ultb3-info .uabb-ultb3-title{
    position:  relative;
    display:  flex;
    align-items:  center;
}
.site-part-section .info-banner .uabb-module-content .uabb-ultb3-info .uabb-ultb3-desc{
    width: 60%;
    padding: 0 20px;
    text-align:  justify;
    letter-spacing: -0.6px;
}
.site-part-section .info-banner .uabb-module-content .uabb-ultb3-info .uabb-ultb3-title:before{display:block;content:"";width: 50px;height: 5px;background: -webkit-linear-gradient(left, rgba(21,104,147,1) 0%,rgba(155,166,30,1) 100%); /* Chrome10-25,Safari5.1-6 */float:  right;margin-left:  10px;}
.products-section .uabb-button{
    position: relative !important;
    z-index: 10;
}
.products-section .fl-col-group .interactive-banner img{
    width: 100% !important;
}
.products-section .fl-col-group{
    display: flex;
    flex-wrap: wrap;
}
.products-section .fl-col-group .interactive-banner{
    margin-bottom: 10px !important;
}
.products-section .fl-col-group .interactive-banner .uabb-text-editor{top: 51%;}
.products-section .fl-col-group .interactive-banner .uabb-text-editor p{
    color: rgba(255, 255, 255, 0.7);
    text-align: center !important;
}
.products-section .fl-col-group .interactive-banner .uabb-module-content .uabb-new-ib-title{position:relative;}
.products-section .fl-col-group .interactive-banner .uabb-module-content .uabb-new-ib-title:before{opacity:0;transition:0.3s;display:block;content:"";position: absolute;left: 0;right: 0;height:3px;bottom: -15px;width:70%;background-color:#ffcc00;margin:0 auto;}
.products-section .fl-col-group .interactive-banner .uabb-module-content.uabb-ib2-hover .uabb-new-ib-title:before{opacity:1;}
.products-section:before{display:block;content:"";position: absolute;width: 200px;height: 270px;background: url(../../uploads/2017/10/products-back.png);z-index: 1;right: 0;bottom: -130px;background-size: cover;}
.products-section{position:relative;}
.hompage-section-titel .fl-heading .fl-heading-text{position: relative;z-index: 10;padding: 0 20px;}
.hompage-section-titel .fl-heading .fl-heading-text:before{display:block;content:"";position: absolute;left: 100%;height: 3px;bottom: 40%;width: 100%;background-color: #273d6c;max-width: 100px;margin: 0 auto;}
.hompage-section-titel .fl-heading .fl-heading-text:after{display:block;content:"";position: absolute;right: 100%;height: 3px;bottom: 40%;width: 100%;background-color: #273d6c;max-width: 100px;margin: 0 auto;}


/*  overwrite fl-builder-rtl.css رفع مشکل راست به چپ در قسمت لایو ادیت */
.fl-builder--main-menu-panel {
    left: 10px;
    right: auto;
}
.fl-builder-publish-actions {
	left: auto;
	right: 0;
}
.fl-builder-bar-title {
    border-left: none;
    border-right: 2px solid #D5DADD;
    flex-direction: row-reverse;
}
.fl-theme-builder-preview-select .fl-theme-builder-preview-select-title{
    flex-direction: row;
    -ms-flex-direction: row;    
    text-align: right;
}
.fl-builder--search-results-panel, .fl-builder-panel {
    left: auto;
    right: 20px;
}
/*  overwrite fl-builder-rtl.css */

/*  رفع مشکل کروسل در سایت های راست به چپ  */
.uabb-blog-posts-carousel{direction: ltr;}
.uabb-blog-posts-carousel .uabb-blog-post-content{direction: rtl;}
/*  رفع مشکل کروسل در سایت های راست به چپ  */

.fl-theme-builder-preview-select-open .fl-theme-builder-preview-select-items{
    text-align: right;
}
.fl-lightbox,.fl-builder-bar{direction:ltr!important;}
.fl-builder-settings-fields .fl-field-control-wrapper {
	text-align: left;
}
.fl-lightbox-controls{right:10px;left:auto;}
.fl-page-content .dv-module-header .fl-row-content-wrap:after{
    /* رنگ پس زمنیه هدر سایت*/ 
    background-color: #000000;
    opacity:0.5;
}
.dv-module-header .dv-module-header-title .uabb-heading-text{
    color:white; /* رنگ هدینگ صفحه */ 
}
.dv-module-header .fl-col-content a{
    color:#45e4ff; /* رنگ لینک های موجود در هدینگ صفحه */ 
}
.dv-module-header .fl-col-content a:hover{
    color:#ffe200; /* رنگ لینک های موجود در هدینگ صفحه */ 
}
.dv-module-header .dv-module-header-title .uabb-separator{
    border-color:#ff9000; /* رنگ خط جداکننده تیتر از توضیحات */
}
.dv-module-header .dv-module-header-title .uabb-subheading{
    color:#ccc; /* رنگ توضیحات زیر تیتر */
}
.dv-module-header-breadcrumb{
    color:#ccc; /* رنگ متن بردکرامب  */
    text-align:center;
}
.dv-module-header-breadcrumb.dv-right{
    text-align: right;/* چینش بردکرام در حالت راست چین  */
}
@media screen and (max-width: 1200px){}
@media screen and (max-width: 992px){
    .color-pallet-section .fl-col-group .color-pallet{
    width: 25% !important;
}
}
@media screen and (max-width: 768px){
    .news-section .uabb-module-content .uabb-post-wrapper{
    margin-bottom: 70px;
}
    .news-section .uabb-blog-post-inner-wrap .uabb-post-thumbnail{
    max-width: inherit;
    width: 100%;
    order: 1;
}
    .news-section .uabb-blog-post-inner-wrap .uabb-post-thumbnail a img{
    max-width: inherit;
    height: auto;
    border-radius: 0;
    margin-bottom: 10px;
}
    .news-section .uabb-blog-post-inner-wrap .uabb-blog-post-content{
    width: 100%;
}

    .hompage-section-titel .fl-heading .fl-heading-text{font-size:20px;}
    .hompage-section-titel .fl-heading .fl-heading-text:before, .hompage-section-titel .fl-heading .fl-heading-text:after{display:none;}
    .color-pallet-section .color-pallet-section-text .fl-heading-text{font-size:16px;}
    .dv-module-header-breadcrumb.dv-right{ text-align: center; }
    .dv-module-header .fl-row-content-wrap{background-position:right center;}
    .color-pallet-section .fl-col-group .color-pallet{
    width: 50% !important;
}
}
@media screen and (max-width: 500px){
    .color-pallet-section .fl-col-group .color-pallet{width: 100% !important;}
