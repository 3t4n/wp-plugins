.article-row{
    position:  relative;
}
.article-row:after{
  display:block;
  content:"";
  height: 50px;
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #e8e8e8;
  z-index: 10;
}
.article-row:before{
  display:block;
  content:"";
  height: 50px;
  position:  absolute;
  left:  0;
  right:  0;
  top: 0;
  background-color: #ededed;
  z-index: 10;
}
.article-row .article-section-img{position:relative;}
