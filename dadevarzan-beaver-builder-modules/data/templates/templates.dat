        font-size: 20px;
    }
}
.dv-sr-blog-01 .news-item .uabb-blog-posts-shadow{
    max-width: 275px;
    margin: 0 auto;
    margin-bottom: 20px
}
.dv-sr-blog-01 .news-item .uabb-blog-posts-shadow .uabb-post-thumbnail a{
    display: block;
    width: 100%;
}
.dv-sr-blog-01 .news-item .uabb-blog-posts-shadow .uabb-post-thumbnail a img{
    width: 100%;
}
.dv-sr-blog-01 .news-item .uabb-blog-posts-description{
    font-weight: 400;
    padding: 0 20px;
    height: 77px;
    display: flex;
    align-items: baseline;
    letter-spacing: -0.3px;
    line-height: 25px;
    margin-bottom: 0;
    width: 100%;
    justify-content: center;
    overflow: hidden;
}
.dv-sr-blog-01 .news-item .uabb-post-meta{
    margin: 0;
    padding: 0;
    display: block;
    width: 100%;
    overflow: hidden;
}
.dv-sr-blog-01 .news-item .uabb-blog-post-content{
    display: flex;
    flex-wrap: wrap;
}
.dv-sr-blog-01 .news-item .uabb-post-heading{
    width: 100%;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 10px;
}
.dv-sr-blog-01 .news-item .uabb-post-thumbnail:before{display:block;content:"";width: 50px;height: 50px;position: absolute;left: 0;right: 0;margin: 0 auto;transform: rotate(45deg);background-color: #fff;z-index: 3;bottom: -5px;margin-bottom: -25px;
    transition: 0.3s ease;
}
.dv-sr-blog-01 .news-item.news-item-2 .uabb-post-thumbnail:before, 
.dv-sr-blog-01 .news-item.news-item-4 .uabb-post-thumbnail:before{display:block;content:"";width: 50px;height: 50px;position: absolute;left: 0;right: 0;margin: 0 auto;transform: rotate(45deg);background-color: #fff;z-index: 3;margin-top: -25px;
    top: -5px;
    transition: 0.3s ease;
}
.dv-sr-blog-01 .news-item .uabb-post-thumbnail{
    position:relative;
    overflow: hidden;
    z-index: 1;
    width: 100%;
}
.dv-sr-blog-01 .news-item-1 .uabb-blog-post-inner-wrap:hover .uabb-post-thumbnail:before,
.dv-sr-blog-01 .news-item-3 .uabb-blog-post-inner-wrap:hover .uabb-post-thumbnail:before{
    bottom:0;
}
.dv-sr-blog-01 .news-item-2 .uabb-blog-post-inner-wrap:hover .uabb-post-thumbnail:before,
.dv-sr-blog-01 .news-item-4 .uabb-blog-post-inner-wrap:hover .uabb-post-thumbnail:before{
    top:0;
}

