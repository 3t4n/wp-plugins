.exibition-part-2-section .uabb-post-thumbnail a{display:  block;}
.hompage-section-titel.news-section-title .pp-heading-content{
    display:  flex;
    align-items:  center;
}
.hompage-section-titel.news-section-title .pp-heading-content .pp-heading-separator{margin:0;margin-right: 20px;}
.hompage-section-titel.news-section-title .pp-heading-content .heading-title{
    margin: 0 !important;
}
.news-section-left-part .fl-col-content{
    overflow:  hidden !important;
}
.news-section .uabb-post-wrapper:last-child .uabb-blog-posts-shadow.clearfix:after{display:none;}
.news-section-right-part .uabb-blog-post-inner-wrap .uabb-blog-post-content{
    width: calc(100% - 190px);
    order: 1;
    padding: 0;
    text-align: right;
}
.news-section-right-part .uabb-blog-post-inner-wrap .uabb-blog-post-content .uabb-post-meta{text-align:center;}
.news-section .uabb-blog-post-inner-wrap .uabb-blog-post-content .uabb-blog-posts-description{
    color: #191818;
}
.news-section .uabb-blog-posts-shadow.clearfix:after{display:block;content:"";width: 90%;height:  1px;background-color:  #eeee;margin:  0 auto;position:  relative;top: 11px;}
.news-section .uabb-blog-post-inner-wrap{
    display:  flex;
    align-items:  center;
    flex-wrap: wrap;
}
.news-section-right-part .uabb-blog-post-inner-wrap .uabb-post-thumbnail{
    order: 2;
    float: left;
    max-width: 170px;
    margin-right: 20px;
    box-shadow: 0 0 9px #0000004d;
}
.news-section-right-part .uabb-blog-post-inner-wrap .uabb-post-thumbnail a{
    display: block;
    line-height: 0;
    
}
.news-section  .uabb-blog-posts-shadow.clearfix{
    background: no-repeat;
    box-shadow: none;
}
.news-section-left-part .uabb-post-wrapper{
    margin-bottom: 0 !important;
}

.hompage-section-titel .pp-separator-line{
    background: linear-gradient(to right, rgba(206,52,44,1) 0%,rgba(254,201,1,1) 100%);
    border:  none !important;
    height: 4px;
}
.flip-box-info-section .flip-box-info-item .fl-module-content{
    max-width: 346px;
    margin: 0 auto;
    margin-left: 10px;
    margin-right: 10px;
}
.flip-box-info-section .flip-box-info-item .uabb-module-content .uabb-face a:hover{
    color: #000 !important;
}
.flip-box-info-section .flip-box-info-item .uabb-flip-box .uabb-front .uabb-flip-box-section{
    display:  flex;
    flex-wrap:  wrap;
    align-items: flex-end;
    justify-content: center;
    height:  100%;
}
.flip-box-info-section .flip-box-info-item .uabb-flip-box .uabb-front .uabb-flip-box-section .uabb-face-text-title:after{
    display:  block;
    content: "";
    width:  150px;
    height:  3px;
    background-color:  #ffcc00;
    margin-top:  10px;
}
.flip-box-info-section .flip-box-info-item .uabb-module-content .uabb-face{
    border-radius:  10px;
    overflow:  hidden;
    box-shadow: 0 2px 12px 1px rgba(0, 0, 0, 0.53);
    cursor: context-menu;
}
div#n2-ss-1 .nextend-arrow{
    width:  50px !important;
    height:  50px !important;
}
div#n2-ss-1 .n2-ss-control-bullet .nextend-bullet-bar .n2-ow{
    background-color:  #fff !important;
    padding: 5px;
    margin: 7px;
    border: 5px solid #fff;
}
div#n2-ss-1 .n2-ss-control-bullet .nextend-bullet-bar .n2-ow.n2-active{
    background-color: #ffcc00 !important;
}
.hompage-slider-title .n2-ow p:first-child{
    font-size: 46px !important;
    font-weight:  900 !important;
    text-shadow: 0 0 2px black !important;
}
.slider-more-info a{
    background: -webkit-linear-gradient(left, #ce352d 0%,#eaa12c 100%) !important;
    font-size:  20px !important;
    padding: 10px 40px !important;
    border-radius:  10px !important;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.8) !important;
}
.dv-hp-obj .uabb-ultb3-title,.dv-hp-heading .uabb-heading{
    position: relative;
    margin-bottom: 20px !important;
}
.dv-hp-obj .uabb-ultb3-title:after,.dv-hp-heading .uabb-heading:after{
    display: block;content:"";
    width: 200px;
    height: 4px;
    margin-top: 10px;
    /* Permalink - use to edit and share this gradient: http://colorzilla.com/gradient-editor/#ce342c+0,fec901+100 */
    background: rgb(206,52,44); /* Old browsers */
    background: -moz-linear-gradient(left, rgba(206,52,44,1) 0%, rgba(254,201,1,1) 100%); /* FF3.6-15 */
    background: -webkit-linear-gradient(left, rgba(206,52,44,1) 0%,rgba(254,201,1,1) 100%); /* Chrome10-25,Safari5.1-6 */
    background: linear-gradient(to right, rgba(206,52,44,1) 0%,rgba(254,201,1,1) 100%); /* W3C, IE10+, FF16+, Chrome26+, Opera12+, Safari7+ */
    filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#ce342c', endColorstr='#fec901',GradientType=1 ); /* IE6-9 */
}
.dv-hp-products{
    direction: ltr;
}
.dv-hp-products .owl-item .woopack-product-carousel{
    overflow: hidden;
}
.dv-hp-slogan .uabb-creative-button-wrap a.uabb-button{
    /* Permalink - use to edit and share this gradient: http://colorzilla.com/gradient-editor/#ce342c+0,fec901+100 */
    background: rgb(206,52,44); /* Old browsers */
    background: -moz-linear-gradient(left, rgba(206,52,44,1) 0%, rgba(254,201,1,1) 100%); /* FF3.6-15 */
    background: -webkit-linear-gradient(left, rgba(206,52,44,1) 0%,rgba(254,201,1,1) 100%); /* Chrome10-25,Safari5.1-6 */
    background: linear-gradient(to right, rgba(206,52,44,1) 0%,rgba(254,201,1,1) 100%); /* W3C, IE10+, FF16+, Chrome26+, Opera12+, Safari7+ */
    filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#ce342c', endColorstr='#fec901',GradientType=1 ); /* IE6-9 */
    padding: 10px 60px;
    box-shadow: 1px 1px 20px rgba(0,0,0,0.5);
    border:none !important;
    transition: none !important;
}
.dv-hp-slogan .uabb-infobox-title{
    text-shadow: 0 0 20px rgba(0,0,0,0.6);
}
.dv-news-obj .pp-content-post .fl-photo-img{
    border-radius: 10px;
    border: 1px solid #ccc;
    box-shadow: 0 1px 5px rgba(0,0,0,0.5);
}
.dv-more-link .uabb-infobox-title-wrap{
    text-align:left;
    padding-left: 5px;
}
.dv-main-exh-obj .uabb-infobox-text-wrap{
    padding: 0 20px;
}
@media screen and (max-width: 768px){
.flip-box-info-section .flip-box-info-item .fl-module-content{
    max-width: 346px;
    margin: 0 auto !important;
    margin-bottom:15px !important;
}
    .hompage-slider-title .n2-ow p:last-child{font-size:18px !important;}
    .hompage-slider-title .n2-ow p:first-child{font-size:30px !important;}
    #n2-ss-1.n2-ss-tablet .n2-ss-widget{display:none !important;}
.news-section-right-part .uabb-blog-post-inner-wrap .uabb-post-thumbnail{
    order: 1 !important;
    width: 100%;
    max-width: inherit !important;
    margin:  0 !important;
    margin-bottom:  20px !important;
}
.news-section-right-part .uabb-blog-post-inner-wrap .uabb-blog-post-content{
    order: 2 !important;
    width: 100% !important;
