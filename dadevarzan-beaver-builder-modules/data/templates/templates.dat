    text-align:  justify;
}
.news-section .news-section-content .uabb-blog-post-content .uabb-post-meta{
    text-align:  center;
    margin-top:  5px;
}
.top-footer-banner-content .uabb-gallery-img{
    height: 100px !important;
}
.top-footer-banner-content .uabb-photo-gallery-item {
    position:  relative;
    padding:  0;
}
.top-footer-banner-content .uabb-photo-gallery-item .uabb-photo-gallery-caption{
    max-width: 200px;
    margin: 0 auto;
    position:  absolute;
    bottom:  0;
    left:  0;
    right:  0;
    width: 90%;
    margin: 0 auto;
    background: -webkit-linear-gradient(left, rgba(255, 69, 0, 0.8) 0%,rgba(255, 124, 0, 0.8) 100%) !important;
    padding: 5px 0;
    border-radius: 0 0 7px 7px;
}
.top-footer-banner-content .uabb-photo-gallery-item .uabb-photo-gallery-content{
    max-width: 200px;
    margin: 0 auto;
    width:  90%;
    margin:  0 auto;
    border-radius: 7px;
}
.engineering-services .engineering-services-image{
    position:  absolute;
    left:  0;
    top: 0;
    bottom:  0;
    margin-top: -125px;
    z-index:  10;
}
.engineering-services .engineering-services-image img{
    max-width:  400px !important;
}
.engineering-services .engineering-services-content ul{
    line-height:  30px;
    margin: 20px 0 0 0;
    list-style:  none;
    padding:  0;
}
.engineering-services .engineering-services-content ul li{display:  flex;align-items:  center;color: #272727;font-weight:  400;}
.engineering-services .engineering-services-content ul li:before{display: block;content:"";margin-left:  10px;width: 10px;height: 10px;background-color: #ff4f00;border-radius:  50%;}
.fields-of-activity .fields-of-activity-item > .fl-module-content > .uabb-module-content{box-shadow: 0px 0px 9px 2px rgba(0, 0, 0, 0.2);}
.fields-of-activity .fields-of-activity-item > .fl-module-content > .uabb-module-content .uabb-infobox-content .uabb-infobox-title{
    padding:  15px;
    transition: all 0.5s;
    position:  relative;
    display: flex;
    align-items: center;
    justify-content: center;
}
.fields-of-activity .fields-of-activity-item:hover .uabb-module-content .uabb-infobox-content i:before{
    background: -webkit-linear-gradient(right top,#ff9900, #ff4000) !important;
    -webkit-background-clip: text !important;
    -webkit-text-fill-color: transparent;
}
.fields-of-activity .fields-of-activity-item:hover > .fl-module-content > .uabb-module-content .uabb-infobox-content .uabb-infobox-title{
    padding-right: 40px;
}
.fields-of-activity .fields-of-activity-item:hover > .fl-module-content > .uabb-module-content .uabb-infobox-content .uabb-infobox-title:before{
    width: 40px;
}
.fields-of-activity .fields-of-activity-item > .fl-module-content > .uabb-module-content .uabb-infobox-content .uabb-infobox-title:before{
    display: block;
    content: "";
    width: 0;
    height: 7px;
    background: -webkit-linear-gradient(left, rgb(255, 69, 0) 0%,rgb(255, 124, 0) 100%) !important;
    transition: all 0.5s;
    position: absolute;
    right: 0;
}
.middle-banner .middle-banner-icon .pp-photo-gallery-item a{
    max-width: 60px;
    margin:  0 auto;
}
.middle-banner .middle-banner-heading2 .fl-heading-text{
    display:  flex;
    align-items:  center;
    justify-content:  center;
}
.middle-banner .middle-banner-heading2 .fl-heading-text:after{display:block;content:"";width: 70px;height: 13px;transform:  skew(-15deg);margin-right: 20px;background: -webkit-linear-gradient(left, rgba(255,69,0,1) 0%,rgba(255,123,0,1) 100%); /* Chrome10-25,Safari5.1-6 */}
.middle-banner .middle-banner-heading2 .fl-heading-text:before{display:block;content:"";width: 70px;height: 13px;transform:  skew(-15deg);margin-left: 20px;background: -webkit-linear-gradient(left, rgba(255,69,0,1) 0%,rgba(255,123,0,1) 100%); /* Chrome10-25,Safari5.1-6 */}
.middle-banner .middle-banner-heading .uabb-second-heading-text{font-size: 80px;
    letter-spacing: -1.5px;
    background: -webkit-linear-gradient(right top,#ff9900, #ff4000);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;}
.section-button a{
    box-shadow: 0 0 15px 0px rgba(0, 0, 0, 0.15);
    background: -webkit-linear-gradient(left, rgb(255, 69, 0) 0%,rgb(255, 124, 0) 100%) !important;
    border:  none !important;
    border-radius:0 !important;
}
.product-section .product-details-item .uabb-banner-style13 .mask{
    background: -webkit-linear-gradient(bottom, rgba(255, 69, 0, 0.8) 0%,rgba(255, 124, 0, 0.8) 100%); /* Chrome10-25,Safari5.1-6 */
}
.product-section .product-details-item .uabb-banner-style13 .uabb-inner-mask{
    align-items: center !important;
    justify-content: center !important;
}
.product-section .product-details-item .uabb-banner-style13 .uabb-inner-mask .uabb-ib1-description p{
    transform:  none !important;
    text-align:  center;
}
.product-section .product-details-item .uabb-banner-style13 .uabb-inner-mask .uabb-ib1-description .title{
    color:  #000;
    font-size: 22px;
    font-weight:  bold;
}
.product-section .product-details-item .uabb-banner-style13 .uabb-inner-mask .uabb-ib1-description .discription:before{display:block;content:"";width:  100%;height:  3px;background-color:  #fff;margin: 10px 0;}
.product-section .product-details-item .uabb-banner-style13 .uabb-inner-mask .uabb-ib1-description .discription{
    color: rgba(255, 255, 255, 0.36);
    font-size:  28px;
    font-weight:  bold;
}
.product-section .product-details-item .uabb-banner-style13{
    box-shadow: -2px 2px 3px 0px rgba(0, 0, 0, 0.19);
    position:  relative;
}
.product-section .product-details-item .uabb-banner-style13 .uabb-ib1-title{
    transition: all 300ms linear;
    position:  absolute;
    bottom:  0;
    opacity:1;
    font-size: 20px;
}
.product-section .product-details-item .uabb-banner-style13.uabb-ib1-hover .uabb-ib1-title{opacity:0;}
.fl-page-content p{margin:0; text-align:justify; line-height:25px; color:#272727; font-weight:400}
.hompage-section-titel .fl-heading .fl-heading-text{position: relative;z-index: 10;padding: 0 20px;}
.hompage-section-titel .fl-heading .fl-heading-text:before{display:block;content:"";position: absolute;left: 100%;height: 4px;bottom: 40%;width: 100%;background-color: #ff4f00;max-width: 70px;margin: 0 auto;}
.hompage-section-titel .fl-heading .fl-heading-text:after{display:block;content:"";position: absolute;right: 100%;height: 4px;bottom: 40%;width: 100%;background-color: #ff4f00;max-width: 70px;margin: 0 auto;}

@media screen and (max-width: 1200px){
    .engineering-services .engineering-services-image{
    margin-top: -45px !important;
}
    .engineering-services .engineering-services-image img{
    max-width: 300px !important;
}
}
@media screen and (max-width: 992px){
    .top-footer-banner-content .uabb-photo-gallery-item{margin-bottom:15px;}
    .engineering-services .engineering-services-image{
    display:none !important;
}
    .about-us-section .about-us-titel .fl-heading{
    text-align:  center;
}
    .about-us-section-image .pp-photo-img{
    max-width: 350px !important;
}
}
@media screen and (max-width: 768px){
    .fields-of-activity .fields-of-activity-content .uabb-photo-gallery-item{
    width: 49% !important;
}
}
@media screen and (max-width: 500px){
    .right-news-content .uabb-post-thumbnail, .right-news-content .uabb-blog-post-content{
    float:  none;
    width:  100%;
    padding:  0 !important;
    margin-top: 10px;
}
    .fields-of-activity .fields-of-activity-content .uabb-photo-gallery-item{
    width: 98% !important;
}

}
