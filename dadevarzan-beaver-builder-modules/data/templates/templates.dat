:1:"0";s:4:"blur";s:1:"0";s:6:"spread";s:1:"0";}s:21:"pp_box_shadow_opacity";s:2:"50";s:26:"pp_box_shadow_hover_switch";s:2:"no";s:25:"pp_box_shadow_color_hover";s:6:"000000";s:19:"pp_box_shadow_hover";a:4:{s:8:"vertical";s:1:"0";s:10:"horizontal";s:1:"0";s:4:"blur";s:1:"0";s:6:"spread";s:1:"0";}s:27:"pp_box_shadow_opacity_hover";s:2:"50";s:24:"pp_box_shadow_transition";s:3:"500";s:11:"medium_size";s:7:"default";s:18:"custom_medium_size";s:3:"100";s:15:"responsive_size";s:7:"default";s:22:"custom_responsive_size";s:3:"100";s:11:"connections";a:1:{s:8:"bg_image";s:0:"";}}}s:13:"5cc7db8be8617";O:8:"stdClass":5:{s:4:"node";s:13:"5cc7db8be8617";s:4:"type";s:6:"module";s:6:"parent";s:13:"5cc7db8be85a4";s:8:"position";i:0;s:8:"settings";O:8:"stdClass":30:{s:4:"text";s:1698:"<p>واحد تحقیق و توسعه دابوصنعت بمنظور ایجاد نوآوری در مجموعه فعالیت های شرکت ایجاد گشته است. هدف اصلی این واحد، ارائه محصولات جدید با رویکرد کاهش مصرف انرژی می باشد. به موازات توسعه محصولات جدید، گسترش و یا ایجاد مراحل تولید بمنظور بهینه سازی فرایند تولید محصول نیز در دستور کار واحد تحقیق و توسعه قرار دارد. مهمترین مسئولیت های این واحد را می توان در بهینه سازی عملکرد محصولات، پیش بینی نیازهای بازار، طراحی سیستم های حرارتی برای آینده، طراحی ابزار تولید بهینه، طراحی خط تولید مناسب برای محصولات جدید و بهینه سازی هزینه های تولید خلاصه کرد.</p><ul><li>ارائه خدمات مشاوره ای در طراحی و نظارت بر اجرا</li><li>ارائه مشاوره جهت انتخاب صحیح کارآمدترین محصول</li><li>آموزش نصب، نگهداری و راه اندازی محصول تولیدی</li><li>طراحی و ساخت محصولات بر اساس مشخصات اعلامی و نیاز کارفرما</li><li>طراحی و اجرای پایپینگ (موتورخانه، تصفیه خانه،هوای فشرده، سردخانه آمونیاکی)</li><li>طراحی و اجرای سیستم های آبرسانی، سوخت رسانی و پمپاژ</li><li>طراحی و اجزای کانالهای تهویه مطبوع</li></ul>";s:5:"color";s:0:"";s:10:"typography";s:0:"";s:17:"typography_medium";s:0:"";s:21:"typography_responsive";s:0:"";s:18:"responsive_display";s:0:"";s:18:"visibility_display";s:0:"";s:26:"visibility_user_capability";s:0:"";s:16:"visibility_logic";a:0:{}s: