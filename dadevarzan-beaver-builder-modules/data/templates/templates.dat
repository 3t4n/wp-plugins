    text-shadow: 0 0 10px black;
}
.hompage-slider-section .hompage-slider-section-header-2 .fl-module-content{text-align: left;}
.hompage-slider-section .hompage-slider-section-header-2 .fl-rich-text{
    display: inline-block;
}
.hompage-slider-section .hompage-slider-section-header-2 .fl-rich-text:hover p:after{
    right: -40px;
}
.hompage-slider-section .hompage-slider-section-header-2 .fl-rich-text p:after{
    display:  block;
    content: "";
    position:  absolute;
    left: -30px;
    right: 50%;
    top: 0;
    bottom: 0;
    background-color: #bfbdf2;
    z-index: -1;
    transform: skew(-40deg);
    transition: all 0.7s;
}
.hompage-slider-section .hompage-slider-section-header-2 .fl-rich-text strong{
    display:  inline-block;
    font-size: 40px;
}
.hompage-slider-section .hompage-slider-section-header-2 .fl-rich-text p{margin:0;display:block;position:  relative;padding: 3px 20px;z-index: 20;color: #000;font-size: 20px;font-weight: bold;overflow:  hidden;background-color: #fff;}
.about-us-section .about-us-section-content{position:relative; z-index:12;} 
.about-us-section .about-us-content-text p{text-align:justify; color:#353535; line-height:25px; margin:0;}
.about-us-section .about-us-content-button a{
    font-weight: 500;
    border: none !important;
    background: none !important;
}
.about-us-section .about-us-content-button .fl-button-icon{
    color: #a2a8fd !important;
    margin: 0 !important;
    margin-right: 10px !important;
}
.about-us-section{
    position: relative;
}
.about-us-section:before{
    display: block;
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 80px;
    background-color: #fff;
    z-index: 10;
}
.about-us-section:after{
    display: block;
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    margin-top: -200px !important;
    top: 50%;
    height:400px;
    width:400px;
    margin:0 auto;
    background-color: #fff0;
    z-index: 11;
    border: 12px solid rgba(255, 255, 255, 0.6)
}
.sepah-company-image{
    position: relative;
    z-index: 11;
}
.google-map-section .map-section-text p{
    color: #fff;
    display: block;
    line-height: 30px;
    font-size: 16px;
}
.google-map-section .map-section-text p span{
    font-weight: 500;
}
.google-map-section .fl-col-group{
    display: flex;
    flex-wrap: wrap;
    align-items: center;
}
.google-map-section .google-map-section-content:before{
    display: block;
    content: "";
    left: -70px;
    right: 0px;
    top: 0;
    bottom: 0;
    position: absolute;
    z-index: 10;
    background: linear-gradient(135deg, rgba(184,182,247,1) 0%,rgba(46,59,177,1) 70%);
}
.google-map-section .google-map-section-content{
    position: relative;
}
.google-map-section .google-map-section-content .fl-col-content{
    position: relative;
    z-index: 11;
}
.google-map-section .google-map{
    position: relative;
    z-index: 11;
}
.google-map-section .google-map .uabb-module-content{
    border: 10px solid #d6d6d6;
    margin-top: 40px;
}
.google-map-section .google-map-section-content .fl-heading-text{
    margin-right: 60px;
}
.more-info-carosel-section .more-info-carosel-content{direction:ltr;}
.more-info-carosel-section .more-info-carosel-content .slick-prev{
    right: inherit;
    left: -55px;
}
.more-info-carosel-section .more-info-carosel-content .slick-next{
    left: inherit;
    right: -55px;
}
.more-info-carosel-section .more-info-carosel-content .slick-arrow i{
    color: #d5d5d5;
    font-size: 70px;
}
.more-info-carosel-section .more-info-carosel-content .uabb-blog-posts-shadow{
    position: relative;
    box-shadow: 0 4px 10px 2px rgba(0, 0, 0, 0.2);
}
.more-info-carosel-section .more-info-carosel-content .uabb-blog-posts-shadow .uabb-blog-post-content{
    position: static;
    height: 80px;
    overflow: hidden;
    display: flex; 
    align-items: center;
    justify-content: center;
}
.more-info-carosel-section .more-info-carosel-content .uabb-blog-posts-shadow .uabb-blog-post-content a{
    font-weight: 500;
    font-size: 17px;
}
.more-info-carosel-section .more-info-carosel-content .uabb-blog-posts-shadow:hover .uabb-blog-post-content .uabb-read-more-text{opacity:1;}
.more-info-carosel-section .more-info-carosel-content .uabb-blog-posts-shadow .uabb-blog-post-content .uabb-read-more-text{
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 80px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 204, 0, 0.9);
    font-size: 22px;
    font-weight: 500;
    transition: all 0.5s;
    opacity: 0;
}
.more-info-carosel-section .more-info-carosel-content .uabb-blog-posts-shadow .uabb-blog-post-content .uabb-read-more-text .uabb-next-right-arrow{
    float: left;
    color: #000;
    transform: rotate(180deg);
    margin-right: 10px;
}
.slider-obj .title-1 h2{margin-bottom:20px !important;}
.slider-obj .title-2 h2{
    padding: 20px !important;
    background: url(http://www.tehranautomall.ir/wp-content/uploads/2017/12/titile-2-back.jpg) no-repeat center center !important;
    background-size: cover !important;
}
.slider-obj .title-1, .slider-obj .title-2{
    margin: 0 auto !important;
    text-align: left;
}
.sepah-company-detail-section{
    position: relative;
    overflow: hidden;
}
.sepah-company-detail-section:before{display:block;content:"";position: absolute;left: 0;right: 0;top: 0;height: 170px;background-color: #ededed;z-index: 0;}
.sepah-company-detail-section:after{display:block;content:"";position: absolute;left: 0;right: 0;bottom: 0;height: 100px;background-color: #e8e8e8;z-index: 1;}
.pp-photo-container .pp-photo-content .pp-photo-content-inner{
    overflow: visible !important;
    position: relative;
}
.sepah-company-detail-image .fl-col-content .pp-photo-content :after{
    display: block;
    content: "";
    position: absolute;
    left: -130px;
    right: -74px;
    bottom: -83px;
    top: -137px;
    background: url(http://www.tehranautomall.ir/wp-content/uploads/2017/12/sepah-company-detail-image-shape.png) no-repeat center center;
    background-size: contain;
    z-index: 10;
}
.about-us-text-section p{text-align:justify; color:#353535; line-height:25px; font-size:15px; font-weight:400;}
.parallex-servises-section .pp-more-link .gfield.question{
    border-top: 1px dashed #ccc;
    padding-top: 20px !important;
}
.parallex-servises-section .pp-more-link:hover .pp-infobox-image svg path{
    fill: #ffcc00;
}
.parallex-servises-section .pp-more-link .pp-infobox-image svg{
    width: 110pt;
    height: 110pt;
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: 50%;
}
.parallex-servises-section .fl-col-group{display:flex; flex-wrap:wrap; position:relative;}
.parallex-servises-section .fl-col-group .servise{width:33.333% !important;}
.parallex-servises-section .fl-col-group .servise .pp-infobox-image img{
    background-color: rgba(0, 0, 0, 0.3);
    padding: 10px;
    border-radius: 50%;
}
.parallex-servises-section .fl-col-group:after{
    display: block;
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 100px;
    background: url(http://www.tehranautomall.ir/wp-content/uploads/2017/12/parallax-servise-section-back-left-text.png) no-repeat center center;
    background-size: contain;
}
.parallex-servises-section .fl-col-group:before{
    display: block;
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    right:0;
    width: 100px;
    background: url(http://www.tehranautomall.ir/wp-content/uploads/2017/12/parallax-servise-section-back-right-text.png) no-repeat center center;
    background-size: contain;
}
.news-section .news-section-left-part .news-item .uabb-blog-post-inner-wrap{
    display: flex;
    flex-wrap: wrap;
}
.news-section .news-section-left-part .news-item-2 .uabb-blog-post-inner-wrap .uabb-post-thumbnail{
    order: 1;
}
.news-section .news-section-left-part .news-item-2 .uabb-blog-post-inner-wrap .uabb-blog-post-content{
    order: 2;
}
.news-section .news-section-left-part .news-item-1 .uabb-blog-post-inner-wrap .uabb-post-thumbnail,.news-section .news-section-left-part .news-item-3 .uabb-blog-post-inner-wrap .uabb-post-thumbnail{
    order: 2;
}
.news-section .news-section-left-part .news-item-1 .uabb-blog-post-inner-wrap .uabb-blog-post-content, .news-section .news-section-left-part .news-item-3 .uabb-blog-post-inner-wrap .uabb-blog-post-content{
    order: 1;
}
.news-section{position: relative;}
.news-section .fl-col-group{position: relative; z-index:10;}
.news-section:after{    display: block;
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: #e0e0e0;
    height: 150px;
}
.news-section .news-section-left-part .news-item .uabb-blog-post-inner-wrap .uabb-post-thumbnail{
    position: relative;
    max-height: 170px;
    overflow: hidden;
}
.news-section .news-section-left-part .news-item:hover .uabb-blog-post-inner-wrap .uabb-post-thumbnail:after {
    display: flex;
    content: "بیشتر بخوانید";
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    top: 0;
    background-color: rgba(255, 204, 0, 0.8);
    align-items: center;
    justify-content: center;
    color: #000;
    font-size: 15px;
    font-weight: 500;
    }
.news-section .news-section-left-part .news-item .uabb-blog-post-inner-wrap .uabb-post-thumbnail:after {
    display: flex;
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    top: 0;
    background-color: rgba(0, 0, 0, 0.3);
    align-items: center;
    justify-content: center;
    color: #000;
    transition: all 0.3s;
    }
.news-section .news-section-left-part .news-item .uabb-blog-post-inner-wrap .uabb-post-thumbnail:before{z-index:10;}
.news-section .news-section-left-part .news-item-1 .uabb-blog-post-inner-wrap .uabb-post-thumbnail:before, .news-section .news-section-left-part .news-item-3 .uabb-blog-post-inner-wrap .uabb-post-thumbnail:before{display: flex;content:"";position: absolute;width: 0;height: 0;border-top: 20px solid transparent;border-right: 20px solid white;border-bottom: 20px solid transparent;top: 50%;margin-top: -20px;}
.news-section .news-section-left-part .news-item-2 .uabb-blog-post-inner-wrap .uabb-post-thumbnail:before{left:0; display: flex;content:"";position: absolute;width: 0;height: 0;border-top: 20px solid transparent;border-left: 20px solid white;border-bottom: 20px solid transparent;top: 50%;margin-top: -20px;}
.top-footer-col-section .pp-button-1-text{
    font-size: 30px;
    line-height: 34px;
    font-weight: bold;
}
@media screen and (max-width: 1200px){
    .news-section .news-item .uabb-blog-posts-description{
    max-height: 100px;
    overflow: hidden;
    padding-top: 5px;}
    .news-section .news-item .uabb-blog-post-content{
    padding-top: 10px;}
    .more-info-carosel-section .more-info-carosel-content .slick-arrow i{
    color: #2e3bb1;}
    .more-info-carosel-section .more-info-carosel-content .slick-prev{
    right: inherit;
    left: 0px;
}
    .more-info-carosel-section .more-info-carosel-content .slick-next{
    left: inherit;
    right: 0px;
}
    .sepah-company-detail-image .fl-col-content .pp-photo-content :after{display:none;}
}
@media screen and (max-width: 992px){
    .news-section .news-item .uabb-blog-posts-description{
    max-height: 100px;
    overflow: hidden;
    padding-top: 5px;}
    .news-section .news-item .uabb-blog-post-content{
    padding-top: 10px;}
    .google-map-section .google-map .uabb-module-content{margin:0 !important;}
    .google-map-section .google-map-section-content:before{display:none !important;}
    .google-map-section .google-map-section-content .fl-col-content{background:linear-gradient(135deg, rgba(184,182,247,1) 0%,rgba(46,59,177,1) 70%);}
}
@media screen and (max-width: 768px){
    .hompage-slider-section .hompage-slider-section-header-2 .fl-module-content{
    text-align:  center;
}
    .hompage-slider-section .hompage-slider-section-header-2 .fl-rich-text p{
    font-size: 16px;
}
    .hompage-slider-section .hompage-slider-section-header-2 .fl-rich-text strong{
    font-size: 20px;
}
    .sepah-company-detail-section:after{display:none;}
    .top-footer-col-section .top-footer-col-section-heading .fl-heading-text{
    font-size: 20px;
}
    .top-footer-col-section .top-footer-col-section-content .pp-dual-button-inner a{padding: 5px 0;}
    .top-footer-col-section .top-footer-col-section-content .pp-dual-button-inner a span{
    font-size: 20px;
}
    .news-section .news-item .uabb-blog-posts-description{
    max-height: inherit;
    overflow: visible;
    padding-top: 20px;
    padding-bottom:20px;
    }
    .news-section .news-item .uabb-blog-post-content{
    padding-top: 20px;}
    .parallex-servises-section .fl-col-group .servise{width:50% !important;}
    .about-us-section:after, .about-us-section:before{display:none !important;}
}
@media screen and (max-width: 500px){
    .news-section .news-section-left-part .news-item .uabb-blog-post-inner-wrap .uabb-post-thumbnail:before{display:none !important;}
    .news-section .news-section-left-part .news-item .fl-module-content{
    margin: 10px;
}
    .news-section .news-section-left-part .news-item .uabb-blog-post-inner-wrap .uabb-post-thumbnail{
    order: 1;
}
    .news-section .news-section-left-part .news-item .uabb-blog-post-inner-wrap .uabb-blog-post-content{
    order: 2;
}
    .uabb-thumbnail-position-left .uabb-post-thumbnail, .uabb-thumbnail-position-left .uabb-blog-post-content, .uabb-thumbnail-position-right .uabb-post-thumbnail, .uabb-thumbnail-position-right .uabb-blog-post-content{float:none; width:100% !important;}
    .parallex-servises-section .fl-col-group .servise{width:100% !important;}
