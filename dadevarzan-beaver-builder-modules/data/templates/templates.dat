.hompage-slider-section .hompage-slider-section-header-1 .fl-heading-text{
    text-shadow: 0 0 10px black;
}
.hompage-slider-section .hompage-slider-section-header-2 .fl-module-content{text-align: left;}
.hompage-slider-section .hompage-slider-section-header-2 .fl-rich-text{
    display: inline-block;
}
.hompage-slider-section .hompage-slider-section-header-2 .fl-rich-text:hover p:after{
    right: -40px;
}
.hompage-slider-section .hompage-slider-section-header-2 .fl-rich-text p:after{
    display:  block;
    content: "";
    position:  absolute;
    left: -30px;
    right: 50%;
    top: 0;
    bottom: 0;
    background-color: #0d5794;
    z-index: -1;
    transform: skew(-40deg);
    transition: all 0.7s;
}
.hompage-slider-section .hompage-slider-section-header-2 .fl-rich-text strong{
    display:  inline-block;
    font-size: 30px;
}
.hompage-slider-section .hompage-slider-section-header-2 .fl-rich-text p{margin:0;display:block;position:  relative;padding: 3px 20px;z-index: 20;color: #000;font-size: 20px;font-weight: bold;overflow:  hidden;background-color: #fff;}

@media screen and (max-width: 768px){
        .hompage-slider-section .hompage-slider-section-header-2 .fl-module-content{
