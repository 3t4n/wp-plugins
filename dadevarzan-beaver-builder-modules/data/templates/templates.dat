adow_opacity";s:2:"50";s:26:"pp_box_shadow_hover_switch";s:2:"no";s:25:"pp_box_shadow_color_hover";s:6:"000000";s:19:"pp_box_shadow_hover";a:4:{s:8:"vertical";s:1:"0";s:10:"horizontal";s:1:"0";s:4:"blur";s:1:"0";s:6:"spread";s:1:"0";}s:27:"pp_box_shadow_opacity_hover";s:2:"50";s:24:"pp_box_shadow_transition";s:3:"500";s:11:"medium_size";s:7:"default";s:18:"custom_medium_size";s:3:"100";s:11:"connections";a:1:{s:8:"bg_image";s:0:"";}}}s:13:"5cc7db8bc25b9";O:8:"stdClass":5:{s:4:"node";s:13:"5cc7db8bc25b9";s:4:"type";s:6:"module";s:6:"parent";s:13:"5cc7db8bc257d";s:8:"position";i:0;s:8:"settings";O:8:"stdClass":30:{s:4:"text";s:1604:"<h2 dir="rtl" style="text-align: justify;"><span style="font-size: 12pt;"><strong>شرح وظایف کارشناسان روابط عمومی</strong></span></h2>
<p dir="rtl" style="direction: rtl; text-align: justify;">برخی از وظایف کارشناسان واحد روابط‌عمومی به شرح زیر می باشد:</p>

<ul dir="rtl" style="text-align: justify;">
 	<li dir="RTL">جمع آوری اطلاعات اخبار و آمار لازم به منظور تهیه بروشورها و مجلات داخلی</li>
 	<li dir="RTL">نظارت وکمک در تهیه مقدمات لازم جهت برگزاری جشن‌ها، کنفرانس‌ها، سمینارها و ملاقات‌ها</li>
 	<li dir="RTL">آگاه ساختن مخاطبان از پیشرفت‌ها ونتایج برنامه‌ها وفعالیت‌ها از طریق رسانه‌های جمعی</li>
 	<li dir="RTL">ارتقاء روابط عمومی الکترونیک</li>
 	<li dir="RTL">به‌روزرسانی محتوای وب‌سایت اطلاع‌رسانی</li>
 	<li dir="RTL">ارسال، دریافت و بررسی ایمیل‌های روابط عمومی</li>
 	<li dir="RTL">تهیه فیلم، عکس و خبر از مراسم‌ها</li>
 	<li dir="RTL">پاسخگوئی و پیگیری شکوائیه‌های دریافتی</li>
 	<li dir="RTL">تهیه بانک جامع اطلاعات خبرگزاری‌ها و رسانه‌های گروهی</li>
 	<li dir="RTL">جمع‌آوری آمار و اطلاعات از واحدها و جمع‌بندی آن جهت ارائه گزارش</li>
</ul>";s:5:"color";s:0:"";s:10:"typography";s:0:"";s:17:"typography_medium";s:0:"";s:21:"typography_responsive";s:0:"";s:18:"responsive_display";s:0:"";s:18:"visibility_display";s:0:"";s:26:"visibility_user_capability";s:0:"";s:16:"visibility_logic";a:0:{}s:9:"animation";a:2:{s:5:"style";s:0:"";s:5:"delay";s:3:"0.0";}s:17:"container_element";s:3:"div";s:2:"id";s:0:"";s:5:"class";s:0:"";s:10:"margin_top";s:1:"0";s:11:"margin_unit";s:2:"px";s:17:"margin_top_medium";s:0:"";s:18:"margin_medium_unit";s:2:"px";s:21:"margin_top_responsive";s:0:"";s:22:"margin_responsive_unit";s:2:"px";s:12:"margin_right";s:0:"";s:19:"margin_right_medium";s:0:"";s:23:"margin_right_responsive";s:0:"";s:13:"margin_bottom";s:0:"";s:20:"margin_bottom_medium";s:0:"";s:24:"margin_bottom_responsive";s:0:"";s:11:"margin_left";s:0:"";s:18:"margin_left_medium";s:0:"";s:22:"margin_left_responsive";s:0:"";s:4:"type";s:9:"rich-text";s:11:"connections";a:1:{s:4:"text";s:0:"";}}}s:13:"5cc7db8bc25f4";O:8:"stdClass":5:{s:4:"node";s:13:"5cc7db8bc25f4";s:4:"type";s:6:"module";s:6:"parent";s:13:"5cc7db8bc2541";s:8:"position";i:0;s:8:"settings";O:8:"stdClass":30:{s:4:"text";s:1758:"<h2 dir="rtl" style="text-align: justify;"><span style="font-size: 12pt;"><strong>شرح وظایف مدیر روابط عمومی</strong></span></h2>
<p dir="rtl" style="direction: rtl; text-align: justify;">برخی از وظایف مدیر روابط‌عمومی به شرح زیر می باشد:</p>

<ul dir="rtl">
 	<li style="list-style-type: none;">
<ul style="list-style-type: disc;">
 	<li style="text-align: justify;">نظارت بر حسن اجرای سیاست های سازمان در حوزه روابط عمومی</li>
 	<li style="text-align: justify;">تصمیم‌سازی در خصوص بهبود و گسترش هر چه بیشتر ارتباط متقابل میان مسئولان و کارکنان</li>
 	<li style="text-align: justify;">برنامه ریزی جهت برگزاری همایش‌ها، سمینارها، جشنواره‌ها، مصاحبه‌ها و بازدیدها</li>
 	<li style="text-align: justify;">ارائه مشاوره و همفکری با واحدهای مختلف در خصوص طراحی، گرافیک، انیمیشن، فیلم و سایر موارد هنری</li>
 	<li style="text-align: justify;">مدیریت نیروی انسانی واحد و بررسی و تعیین نیازهای آن</li>
 	<li style="text-align: justify;">تهیه و تدوین برنامه سالانه فعالیت‌های روابط عمومی</li>
 	<li style="text-align: justify;">نظارت شکلی و محتوایی بر سایت و وبلاگ سازمان</li>
 	<li>تصمیم‌سازی در خصوص سیاست‌های خبری، تبلیغی، انتشاراتی و آموزشی</li>
 	<li style="text-align: justify;">سایر امور محوله از سوی مدیر مافوق.</li>
