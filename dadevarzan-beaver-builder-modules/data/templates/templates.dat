    z-index: 100;
}
.top-footer-info-box .pp-infobox{
    position:  relative;
    max-width:  255px;
    margin:  0 auto;
}
.top-footer-info-box .pp-infobox .pp-infobox-image{
    margin:  0;
    overflow:  hidden;
}
.top-footer-info-box .pp-infobox .pp-infobox-title-wrapper{
    position:  absolute;
    bottom:  0;
    left:  0;
    right:  0;
    padding: 20px 0;
}
.news-section .uabb-blog-posts .uabb-post-thumbnail img {
    width: 100%;
}
.news-section .uabb-post-wrapper {
    max-width: 525px;
    margin: 0 auto;
}
.news-section-right-part .uabb-blog-post-inner-wrap{
    display: flex;
    flex-wrap: wrap;
}
.news-section-right-part .uabb-blog-post-inner-wrap .uabb-blog-post-content{
    width: calc(100% - 150px);
    order: 1;
    padding: 0;
    text-align: right;
}
.news-section .uabb-blog-post-inner-wrap .uabb-blog-post-content .uabb-blog-posts-description{
    color: #191818;
}
.news-section-right-part .uabb-blog-post-inner-wrap .uabb-post-thumbnail{
    order: 2;
    float: left;
    max-width: 130px;
    margin-right: 20px;
}
.news-section-right-part .uabb-blog-post-inner-wrap .uabb-post-thumbnail a{
    display: block;
    line-height: 0;
}
.news-section  .uabb-blog-posts-shadow.clearfix{
    background: no-repeat;
    box-shadow: none;
}
.news-section-left-part .uabb-post-wrapper{
    margin-bottom: 0 !important;
}
.statistics-section .statistics-section-item .pp-infobox-description p{
    width: 80px;
    height: 80px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #37a83b;
    border-radius: 50%;
    position: relative;
    bottom: -10px;
    color: rgba(255, 255, 255, 0.6);
    font-weight: 900;
}
.statistics-section .statistics-section-item .pp-infobox{position:relative;}
.statistics-section .statistics-section-item .pp-infobox:before{
    display: block;
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: 50%;
    width: 150px;
    height: 150px;
    margin:  0 auto;
}
.statistics-section .statistics-section-item .pp-infobox .pp-icon-wrapper, .statistics-section .statistics-section-item .pp-infobox .pp-infobox-title-wrapper{
    position:  relative;
}
.statistics-section .statistics-section-item .pp-infobox .pp-icon-wrapper .pp-infobox-image{margin:0;position:  relative;top: 10px;}
.statistics-section .statistics-section-item .pp-infobox .pp-infobox-title-wrapper .pp-infobox-title{
    letter-spacing: -0.6px;
}
.project-section .project-item .uabb-module-content, .project-section .project-item2 .uabb-module-content{
    position:  relative;
}
.project-section .project-item .uabb-module-content:hover:before{
    opacity:  1;
}
.project-section .project-item .uabb-module-content:before{
    display:  block;
    content:  "";
    position:  absolute;
    left: 20px;
    right: 20px;
    top: 20px;
    bottom: 20px;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 10;
    opacity: 0;
    transition: all 0.5s;
}

.project-section .project-item .uabb-module-content .uabb-ultb3-img{
    width:  100% !important;
    height: 100%;
}
.project-section .project-item .uabb-module-content .uabb-ultb3-info{
    transition: all 0.5s;
    z-index:  11;
    position:  absolute;
    bottom: 0;
    left:  0;
    right:  0;
}
.project-section .project-item .uabb-module-content:hover .uabb-ultb3-info .uabb-ultb3-title:after{
    width: 80%;
}
.project-section .project-item .uabb-module-content .uabb-ultb3-info .uabb-ultb3-title:after{display:  block;content:  "";width: 0;margin:  0 auto;height:  3px;background-color: #41a044;margin-top: 15px;transition: all 1.2s;}
.project-section .project-item .uabb-module-content .uabb-ultb3-info .uabb-ultb3-title{
    display:  inline-block;
    position:  relative;
}
.project-section .project-item .uabb-module-content:hover .uabb-ultb3-info{
    transform: scale(1.1);
    bottom: 25%;
}
.hompage-section-titel .fl-heading .fl-heading-text {
    position: relative;
    z-index: 10;
    padding: 0 0px 0 70px;
}
.hompage-section-titel .fl-heading .fl-heading-text:before {
    display: block;
    content: "";
    position: absolute;
    left:0;
    height: 6px;
    bottom: 35%;
    width: 100%;
    background-color: #419f44;
    max-width: 60px;
    margin: 0 auto;
}
.info-banner-section .info-banner-parts .uabb-module-content .uabb-ultb3-info{
    width: 180px;
    margin:  0 auto;
    padding:  0;
    border-bottom:  5px solid #fff;
    padding-bottom: 15px;
    position:  relative;
}
.info-banner-section .info-banner-parts .uabb-module-content{
    align-items:  center;
    max-width: 356px;
    margin: 0 auto;
}
.info-banner-section .info-banner-parts .uabb-module-content:hover .uabb-ultb3-box-overlay{
    background-color: rgba(65, 159, 68, 0.85);
}
.info-banner-section .info-banner-parts .uabb-module-content .uabb-ultb3-box-overlay{
    transition: all 0.5s;
}
.info-banner-section .info-banner-parts .uabb-module-content .uabb-ultb3-info:after{display:block;content:"";width: 60px;height: 5px;background-color: #222222;margin:  0 auto;position:  absolute;bottom: -5px;left: 0px;z-index:  100;opacity:  0;right: -240px;transition: all 0.5s;}
.info-banner-section .info-banner-parts .uabb-module-content .uabb-ultb3-info:before{display:block;content:"";width: 60px;height: 5px;background-color: #419f44;margin:  0 auto;position:  absolute;bottom: -5px;left: 0;right: 0;transition: all 0.5s;}
.info-banner-section .info-banner-parts .uabb-module-content:hover .uabb-ultb3-info:before{display:block;right: 180px;opacity:  0;}
.info-banner-section .info-banner-parts .uabb-module-content:hover .uabb-ultb3-info:after{display:block;opacity: 1;right: 0;}



/*  overwrite fl-builder-rtl.css رفع مشکل راست به چپ در قسمت لایو ادیت */
.fl-builder--main-menu-panel {
    left: 10px;
    right: auto;
}
.fl-builder-publish-actions {
	left: auto;
	right: 0;
}
.fl-builder-bar-title {
    border-left: none;
    border-right: 2px solid #D5DADD;
    flex-direction: row-reverse;
}
.fl-theme-builder-preview-select .fl-theme-builder-preview-select-title{
    flex-direction: row;
    -ms-flex-direction: row;    
    text-align: right;
}
.fl-builder--search-results-panel, .fl-builder-panel {
    left: auto;
    right: 20px;
}
/*  overwrite fl-builder-rtl.css */

/*  رفع مشکل کروسل در سایت های راست به چپ  */
.uabb-blog-posts-carousel{direction: ltr;}
.uabb-blog-posts-carousel .uabb-blog-post-content{direction: rtl;}
/*  رفع مشکل کروسل در سایت های راست به چپ  */

.fl-theme-builder-preview-select-open .fl-theme-builder-preview-select-items{
    text-align: right;
}
.fl-lightbox,.fl-builder-bar{direction:ltr!important;}
.fl-builder-settings-fields .fl-field-control-wrapper {
	text-align: left;
}
.fl-lightbox-controls{right:10px;left:auto;}
.fl-page-content .dv-module-header .fl-row-content-wrap:after{
    /* رنگ پس زمنیه هدر سایت*/ 
    background-color: #000000;
    opacity:0.5;
}
.dv-module-header .dv-module-header-title .uabb-heading-text{
    color:white; /* رنگ هدینگ صفحه */ 
}
.dv-module-header .fl-col-content a{
    color:#45e4ff; /* رنگ لینک های موجود در هدینگ صفحه */ 
}
.dv-module-header .fl-col-content a:hover{
    color:#ffe200; /* رنگ لینک های موجود در هدینگ صفحه */ 
}
.dv-module-header .dv-module-header-title .uabb-separator{
    border-color:#ff9000; /* رنگ خط جداکننده تیتر از توضیحات */
}
.dv-module-header .dv-module-header-title .uabb-subheading{
    color:#ccc; /* رنگ توضیحات زیر تیتر */
}
.dv-module-header-breadcrumb{
    color:#ccc; /* رنگ متن بردکرامب  */
    text-align:center;
}
.dv-module-header-breadcrumb.dv-right{
    text-align: right;/* چینش بردکرام در حالت راست چین  */
}
@media screen and (max-width: 768px) {
    .dv-module-header-breadcrumb.dv-right{ text-align: center; }
    .dv-module-header .fl-row-content-wrap{background-position:right center;}
    .news-section-right-part .uabb-blog-post-inner-wrap .uabb-post-thumbnail{
    max-width: inherit;
    width: 100%;
    order: 1;
}
    .news-section-right-part .uabb-blog-post-inner-wrap .uabb-post-thumbnail a img{
    max-width: inherit;
    height: auto;
    border-radius: 0;
    margin-bottom: 10px;
}
    .news-section-right-part .uabb-blog-post-inner-wrap .uabb-blog-post-content{
    width: 100%;
    text-align:center;
}
}
@media screen and (max-width: 1200px){}
@media screen and (max-width: 992px){}
@media screen and (max-width: 768px){
    .about-us-section2{
    position:  relative;
}
.about-us-section2:before{
  display: block !important;
  content: "" !important;
  position:  absolute;
  left:  0;
  right:  0;
  bottom:  0;
  top: 0;
  background:  url(http://jyane.webexir.net/wp-content/uploads/2018/02/about-us-back2.jpg) no-repeat center center;
  background-size: cover;
  opacity: 0.1;
}
    .about-us-section2 .fl-row-content-wrap{background-image: none !important;}
    .project-section .project-item .uabb-module-content .uabb-ultb3-img{height:auto;}
}
@media screen and (max-width: 500px){
    .project-section .project-item .uabb-module-content .uabb-ultb3-img{
        height: 100%;
    }
    .statistics-section .statistics-section-counter{width:100% !important;}
