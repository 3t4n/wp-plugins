rap {
    display: flex;
    align-items: center;
    flex-wrap: wrap
}

.news-section-right-part .uabb-blog-post-inner-wrap .uabb-blog-post-content {
    width: calc(100% - 140px);
    order: 1;
    padding: 0;
    text-align: right
}

.news-section .uabb-blog-post-inner-wrap .uabb-blog-post-content .uabb-post-heading a {
    font-size: 17px;
    font-weight: 500
}

.news-section .uabb-blog-post-inner-wrap .uabb-blog-post-content .uabb-blog-posts-description {
    color: #191818
}

.news-section-right-part .uabb-blog-post-inner-wrap .uabb-post-thumbnail {
    order: 2;
    float: left;
    max-width: 120px;
    margin-left: 20px
}

.news-section-right-part .uabb-blog-post-inner-wrap .uabb-post-thumbnail a {
    display: block;
    line-height: 0
}

.news-section-right-part .uabb-blog-post-inner-wrap .uabb-post-thumbnail a img {
    width: 100%;
    height: 120px;
    border-radius: 50%;
    max-width: 120px
}

.news-section .uabb-blog-posts-shadow.clearfix {
    background: no-repeat;
    box-shadow: none
}

.news-section-left-part .uabb-post-wrapper {
    margin-bottom: 0!important
}
.search-section .fl-widget {
    margin: 0
}

.social-section .fl-icon {
    margin: 0!important;
    margin-left: 20px!important
}

.social-section {
    float: right!important
}


.about-us-section .hompage-title-content {
    margin-bottom: 20px
}

.about-us-section {
    position: relative
}

.about-us-section .fl-row-content-wrap .about-us-text,.about-us-section .fl-row-content-wrap .about-us-video {
    position: relative;
    z-index: 1
}

.about-us-section:before {
    display: block;
    content: "";
    position: absolute;
    width: 340px;
    height: 460px;
    background: url(../../uploads/2017/09/about-us-back.png);
    z-index: 1;
    left: 0;
    bottom: -130px;
    background-size: cover
}

.about-us-section .about-us-text p {
    margin: 0;
    font-size: 16px;
    color: #272727;
    text-align: justify
}

.mejs-poster img {
    display: block!important
}

.hompage-title-content .fl-heading {
    position: relative
}

.hompage-title-content .fl-heading .fl-heading-text {
    background-color: #fff;
    position: relative;
    z-index: 10;
    padding: 0 20px;
    color: #222
}

.hompage-title-content .fl-heading .fl-heading-text:before {
    display: block;
    content: "";
    position: absolute;
    left: 100%;
    height: 6px;
    bottom: 42%;
    width: 100%;
    background-color: #273d6c;
    max-width: 80px;
    margin: 0 auto
}

.hompage-title-content .fl-heading .fl-heading-text:after {
    display: block;
    content: "";
    position: absolute;
    right: 100%;
    height: 6px;
    bottom: 42%;
    width: 100%;
    background-color: #273d6c;
    max-width: 80px;
    margin: 0 auto
}

.products-section .hompage-title-content .fl-heading .fl-heading-text {
    background-color: #f2f2f2
}

.products-section .uabb-button {
    position: relative!important;
    z-index: 10
}

.products-section .fl-col-group.fl-node-5b56e43b93fe3 .interactive-banner img {
    width: 100%!important
}

.products-section .fl-col-group.fl-node-5b56e43b93fe3 {
    display: flex;
    flex-wrap: wrap
}

.products-section .fl-col-group.fl-node-5b56e43b93fe3 .interactive-banner {
    width: 33.333% !important;
    margin-bottom: 10px!important
}

.products-section .fl-col-group.fl-node-5b56e43b93fe3 .interactive-banner .uabb-text-editor {
    top: 51%
}

.products-section .fl-col-group.fl-node-5b56e43b93fe3 .interactive-banner .uabb-text-editor p {
    text-align: center!important
}

.products-section .fl-col-group.fl-node-5b56e43b93fe3 .interactive-banner .uabb-module-content .uabb-new-ib-title {
    position: relative
}

.products-section .fl-col-group.fl-node-5b56e43b93fe3 .interactive-banner .uabb-module-content .uabb-new-ib-title:before {
    opacity: 0;
    transition: .3s;
    display: block;
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    height: 3px;
    bottom: -15px;
    width: 70%;
    background-color: #e5322d;
    margin: 0 auto
}

.products-section .fl-col-group.fl-node-5b56e43b93fe3 .interactive-banner .uabb-module-content.uabb-ib2-hover .uabb-new-ib-title:before {
    opacity: 1
}

.products-section:before {
    display: block;
    content: "";
    position: absolute;
    width: 200px;
    height: 270px;
    background: url(../../uploads/2017/10/products-back.png);
    z-index: 1;
    right: 0;
    bottom: -130px;
    background-size: cover
}

.products-section {
    position: relative
}

.industrial-section p {
    direction: rtl;
    text-align: justify!important
}

.industrial-section .n2-ss-layer-row {
    direction: ltr
}

.n2-ss-button-container a {
    line-height: 25px!important
}

.n2-ss-button-container a span {
    letter-spacing: 0;
    font-size: 16px
}

.industrial-section div#n2-ss-3 .nextend-arrow-animated-fade {
    width: 70px!important;
    height: 70px!important
}

.brands-section .hompage-title-content .fl-heading .fl-heading-text {
    background-color: #e7e7e7
}

.brands-section .uabb-image-carousel-item img {
    border-radius: 50%;
    max-width: 150px!important;
    margin: 0 auto
}

.brands-section .slick-arrow .fa {
    font-size: 70px!important
}

@media screen and (max-width: 992px) {
    .products-section .fl-col-group.fl-node-5b56e43b93fe3 .interactive-banner {
        width:50%!important
    }

}

@media screen and (max-width: 768px) {
    .comment-section .comment-section-button .uabb-button {
        padding:10px
    }

    .comment-section .comment-section-button .uabb-button span {
        font-size: 16px
    }
    .news-section-right-part .uabb-module-content .uabb-post-wrapper {
        margin-bottom: 70px
    }

    .news-section-right-part .uabb-blog-post-inner-wrap .uabb-post-thumbnail {
        max-width: inherit;
        width: 100%;
        order: 1
    }

    .news-section-right-part .uabb-blog-post-inner-wrap .uabb-post-thumbnail a img {
        max-width: inherit;
        height: auto;
        border-radius: 0;
        margin-bottom: 10px
    }

    .news-section-right-part .uabb-blog-post-inner-wrap .uabb-blog-post-content {
        width: 100%
    }
}

@media screen and (max-width: 550px) {
    .products-section .fl-col-group.fl-node-5b56e43b93fe3 .interactive-banner .uabb-module-content .uabb-new-ib-title {
        font-size:20px
    }

    .products-section .fl-col-group.fl-node-5b56e43b93fe3 .interactive-banner .uabb-text-editor p {
        font-size: 20px
    }

    .products-section .fl-col-group.fl-node-5b56e43b93fe3 .interactive-banner {
        width: 100%!important
    }

    .hompage-title-content .fl-heading .fl-heading-text:before,.hompage-title-content .fl-heading .fl-heading-text:after {
        display: none!important
    }

    .hompage-title-content .fl-heading .fl-heading-text {
        font-size: 22px;
        background: 0 0!important;
        padding: 0
    }

    .about-us-section .hompage-title-content {
        margin: 0
    }

    .about-us-section .fl-row-content-wrap {
        padding: 20px 0
    }

    .social-section {
        float: none!important;
        width: 100%!important
    }

    .social-section .fl-icon-group {
        text-align: center
    }

    .social-section .fl-icon {
        margin: 0 10px!important
    }
}

.fl-search-form {
    display: flex;
    background-color: #fff;
    border-radius: 5px;
    align-items: center
}

.fl-search-form input:focus {
    background-color: #fff
}

.fl-search-form input {
    border: none;
    border-radius: 0 5px 5px 0;
    background-color: #fff
}

.fl-search-form button {
    background: 0 0;
    border: none;
    line-height: 0
}

.fl-search-form button i:before {
    color: #b9b9b9
}


.industrial-section-responsive-content{direction: ltr;}
.industrial-section-responsive-content .slick-prev{
    right: 0 !important;
    left: inherit !important;
}
.industrial-section-responsive-content .slick-next{
    right: inherit !important;
    left: 0 !important;
