رگانی رنگ چی شیمی را تاسیس نمود. امروزه این شرکت با بیش از 30 سال سابقه، با بهره گیری از نیروی انسانی مجرب و متخصص در زمینه بازرگانی و مشاوره فنی انواع رنگدانه از جمله دی اکسید تیتانیوم و افزودنی های پلیمری ارائه دهنده راه حل تامین مواد افزودنی تخصصی صنایع رنگ و رزین، پلیمر، چاپ و ساختمان می باشد، و در حال حاضر فعالیت خود را در سطح بین المللی گسترش داده و هم اکنون نمایندگی انحصاری چندین شرکت تولید کننده معتبر اروپایی و آسیایی را دارا می باشد. <span style="font-size: 12px;"><strong><span style="color: #0000ff;"><a style="color: #0000ff;" href="http://www.rangchi.co/wp-content/uploads/2018/02/Rangchi-Chemie-Trading-Co.pdf">بیشتر...</a></span></strong></span></span></h4>";s:5:"color";s:0:"";s:10:"typography";s:0:"";s:17:"typography_medium";s:0:"";s:21:"typography_responsive";s:0:"";s:18:"responsive_display";s:0:"";s:18:"visibility_display";s:0:"";s:26:"visibility_user_capability";s:0:"";s:16:"visibility_logic";a:0:{}s:9:"animation";a:2:{s:5:"style";s:0:"";s:5:"delay";s:3:"0.0";}s:17:"container_element";s:3:"div";s:2:"id";s:0:"";s:5:"class";s:13:"about-us-text";s:10:"margin_top";s:0:"";s:11:"margin_unit";s:2:"px";s:17:"margin_top_medium";s:0:"";s:18:"margin_medium_unit";s:2:"px";s:21:"margin_top_responsive";s:0:"";s:22:"margin_responsive_unit";s:2:"px";s:12:"margin_right";s:0:"";s:19:"margin_right_medium";s:0:"";s:23:"margin_right_responsive";s:0:"";s:13:"margin_bottom";s:0:"";s:20:"margin_bottom_medium";s:0:"";s:24:"margin_bottom_responsive";s:0:"";s:11:"margin_left";s:0:"";s:18:"margin_left_medium";s:0:"";s:22:"margin_left_responsive";s:0:"";s:4:"type";s:9:"rich-text";s:11:"connections";a:1:{s:4:"text";s:0:"";}s:24:"flrich1524985062485_text";s:0:"";}}s:13:"5cc7db8c064a8";O:8:"stdClass":5:{s:4:"node";s:13:"5cc7db8c064a8";s:4:"type";s:6:"module";s:6:"parent";s:13:"5cc7db8c0643a";s:8:"position";i:10;s:8:"settings";O:8:"stdClass":40:{s:10:"video_type";s:13:"media_library";s:5:"video";s:4:"2119";s:10:"video_webm";s:0:"";s:6:"poster";s:4:"1846";s:10:"poster_src";s:74:"http: