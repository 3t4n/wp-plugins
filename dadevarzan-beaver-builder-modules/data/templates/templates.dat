    display: inline-block;
    visibility: visible;
    margin-right: 50px;
}
.news-letter-section .news-letter-section-button a{padding: 15px 25px;}
.news-letter-section .news-letter-section-text .fl-rich-text p{
    margin: 0;
    font-size:  20px;
    font-weight:  500;
    color:  #fff;
    text-align: center;
}
.news-letter-section .news-letter-section-text .fl-rich-text p span{
    margin:  0 20px;
    font-size: 23px;
    color: rgba(255, 255, 255, 0.8);
}
.news-letter-section .news-letter-section-text .fl-rich-text p i{
    font-family: FontAwesome;
    font-style:  normal;
    position:  relative;
    bottom: 10px;
}
.top-footer-info-box .pp-infobox{
    position:  relative;
    max-width:  255px;
    margin:  0 auto;
}
.top-footer-info-box .pp-infobox .pp-infobox-image{
    margin:  0;
    overflow:  hidden;
}
.top-footer-info-box .pp-infobox .pp-infobox-title-wrapper{
    position:  absolute;
    bottom:  0;
    left:  0;
    right:  0;
    padding: 20px 0;
}
.news-section-right-part .uabb-blog-post-inner-wrap{
    display: flex;
    flex-wrap: wrap;
    align-items: center;
}
.news-section-right-part .uabb-blog-post-inner-wrap .uabb-blog-post-content{
    width: calc(100% - 150px);
    order: 1;
    padding: 0;
    text-align: right;
}
.news-section .uabb-blog-post-inner-wrap .uabb-blog-post-content .uabb-blog-posts-description{
    color: #191818;
}
.news-section-right-part .uabb-blog-post-inner-wrap .uabb-post-thumbnail{
    order: 2;
    float: left;
    max-width: 130px;
    margin-right: 20px;
}
.news-section-right-part .uabb-blog-post-inner-wrap .uabb-post-thumbnail a img{
    width: 100%;
    height: 100%;
}
.news-section-right-part .uabb-blog-post-inner-wrap .uabb-post-thumbnail a{
    display: block;
    line-height: 0;
    border-radius: 50%;
    overflow: hidden;
    width: 110px;
    height: 110px;
}
.news-section  .uabb-blog-posts-shadow.clearfix{
    background: no-repeat;
    box-shadow: none;
}
.news-section-left-part .uabb-post-wrapper{
    margin-bottom: 0 !important;
}

.products-section-content .slick-next{left:-50px !important; right:auto !important;}
.products-section-content .slick-prev{right:-50px !important; left:auto !important;}
.products-section-content .slick-arrow{transform: none !important; width:auto !important; height:auto !important;}
.products-section-content .slick-arrow i, .products-section-content .slick-arrow i:hover{font-size:50px !important;}
.products-section-content .slick-list{
        height: 320px !important;
}
.products-section-content .uabb-read-more-text{
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 69px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    background:rgba(1, 152, 141, 0.8);
    transition: all 0.3s;
}
.products-section-content .uabb-post-wrapper:hover .uabb-read-more-text{opacity:1;}
.products-section-content .uabb-read-more-text a{
    color: #fff !important;
    background-color: rgba(0, 0, 0, 0.2);
    padding: 6px 15px;
    font-size: 15px;
}
.products-section-content .uabb-read-more-text span{display:none;}
.products-section-content .uabb-post-heading{
    padding: 25px 0;
    height: 70px;
    font-weight: 500;
}
.products-section-content .uabb-blog-post-content{
    position: static;
    padding: 0 !important;
}
.products-section-content .uabb-post-wrapper:hover .uabb-blog-posts-shadow{
    box-shadow: 0 6px 15px rgba(16,16,16,.34);
}
.products-section-content .uabb-post-wrapper .uabb-blog-posts-shadow{
    position:relative;
    max-width: 275px;
    margin: 0 auto;
    box-shadow: 0 4px 8px rgba(16,16,16,.25);
    transition: all 0.5s;
}
.services-section .fl-node-content .fl-col-group .fl-col .uabb-infobox-content .left-title-image{
    margin-bottom: 20px;
}
.brands-section .brands-section-titel .pp-heading .title-text{
    text-shadow: 0 4px 8px rgba(16,16,16,.26);
}
.brands-section .brands-company .pp-photo-gallery{display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap;}
.brands-section .brands-company .pp-photo-gallery-item{
    margin:0 auto !important;
    max-width: 185px;
    margin-bottom: 10px;
}
.brands-section .brands-company .pp-photo-gallery-item:hover .pp-gallery-img{
    opacity: 1;
}
.brands-section .brands-company .pp-photo-gallery-item .pp-gallery-img{
    opacity: 0.6;
    transition: all 0.3s;
}
.activity-filds-section .info-banner-item .uabb-module-content:hover:before{opacity: 0;}
.activity-filds-section .info-banner-item .uabb-module-content:before{
    display:  block;
    content: "";
    position:  absolute;
    left:  0;
    right:  0;
    top: 0;
    bottom:  0;
    background-color: rgba(0, 0, 0, 0.4);
    z-index:  10;
    opacity: 1;
    transition: all 0.5s;
}
.activity-filds-section .info-banner-item .uabb-module-content:hover .uabb-ultb3-info{background-color: rgba(255, 255, 255, 1);box-shadow: 0 8px 5px rgba(16,16,17,.3);margin-bottom: 60px !important;}
.activity-filds-section .info-banner-item .uabb-module-content .uabb-ultb3-info{
    margin-bottom: 50px !important;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width:  auto;
    margin:  0 auto;
    padding:  10px;
    background-color: rgba(255, 255, 255, 0.7);
    transition: all 0.3s;
    position:  relative;
    z-index: 11;
    box-shadow: 0 8px 5px rgba(16, 16, 17, 0);
    overflow:  hidden;
}
.activity-filds-section .info-banner-item .uabb-module-content .uabb-ultb3-desc{
    display:  none;
}
.activity-filds-section .info-banner-item .uabb-module-content .uabb-ultb3-title{margin-right: 20px;}
.activity-filds-section .info-banner-item .uabb-module-content:hover .uabb-ultb3-info:before{
    top: 0;
}
.activity-filds-section .info-banner-item .uabb-module-content .uabb-ultb3-info:before{display:block;content:"";right:  0;top: 100%;width: 15px;height:  100%;background-color: #01988d;position:  absolute;transition: all 0.5s;}
.activity-filds-section .info-banner-item .uabb-module-content .uabb-ultb3-info:after{display:block;content:"\f060";font-family: FontAwesome;font-size:  22px;color: #222222;margin-right: 20px;}
.activity-filds-section .info-banner-item .uabb-module-content .uabb-ultb3-img{
    width:  100% !important;
}


/*  overwrite fl-builder-rtl.css رفع مشکل راست به چپ در قسمت لایو ادیت */
.fl-builder--main-menu-panel {
    left: 10px;
    right: auto;
}
.fl-builder-publish-actions {
	left: auto;
	right: 0;
}
.fl-builder-bar-title {
    border-left: none;
    border-right: 2px solid #D5DADD;
    flex-direction: row-reverse;
}
.fl-theme-builder-preview-select .fl-theme-builder-preview-select-title{
    flex-direction: row;
    -ms-flex-direction: row;    
    text-align: right;
}
.fl-builder--search-results-panel, .fl-builder-panel {
    left: auto;
    right: 20px;
}
/*  overwrite fl-builder-rtl.css */

/*  رفع مشکل کروسل در سایت های راست به چپ  */
.uabb-blog-posts-carousel{direction: ltr;}
.uabb-blog-posts-carousel .uabb-blog-post-content{direction: rtl;}
/*  رفع مشکل کروسل در سایت های راست به چپ  */

.fl-theme-builder-preview-select-open .fl-theme-builder-preview-select-items{
    text-align: right;
}
.fl-lightbox,.fl-builder-bar{direction:ltr!important;}
.fl-builder-settings-fields .fl-field-control-wrapper {
	text-align: left;
}
.fl-lightbox-controls{right:10px;left:auto;}
.fl-page-content .dv-module-header .fl-row-content-wrap:after{
    /* رنگ پس زمنیه هدر سایت*/ 
    background-color: #000000;
    opacity:0.5;
}
.dv-module-header .dv-module-header-title .uabb-heading-text{
    color:white; /* رنگ هدینگ صفحه */ 
}
.dv-module-header .fl-col-content a{
    color:#45e4ff; /* رنگ لینک های موجود در هدینگ صفحه */ 
}
.dv-module-header .fl-col-content a:hover{
    color:#ffe200; /* رنگ لینک های موجود در هدینگ صفحه */ 
}
.dv-module-header .dv-module-header-title .uabb-separator{
    border-color:#ff9000; /* رنگ خط جداکننده تیتر از توضیحات */
}
.dv-module-header .dv-module-header-title .uabb-subheading{
    color:#ccc; /* رنگ توضیحات زیر تیتر */
}
.dv-module-header-breadcrumb{
    color:#ccc; /* رنگ متن بردکرامب  */
    text-align:center;
}
.dv-module-header-breadcrumb.dv-right{
    text-align: right;/* چینش بردکرام در حالت راست چین  */
}
@media screen and (max-width: 768px) {
    .dv-module-header-breadcrumb.dv-right{ text-align: center; }
    .dv-module-header .fl-row-content-wrap{background-position:right center;}
}



@media screen and (max-width: 1200px){
  .products-section-content .slick-next{left:-30px !important; right:auto !important;}
  .products-section-content .slick-prev{right:-30px !important; left:auto !important;}
}
@media screen and (max-width: 992px){
  .news-letter-section .news-letter-section-text .fl-rich-text p span{
    font-size: 18px !important;
}
  .activity-filds-section .info-banner-item .uabb-module-content .uabb-ultb3-img{
    height:  100%;
}
}
@media screen and (max-width: 768px){
    .news-section-right-part .uabb-blog-post-inner-wrap .uabb-post-thumbnail{
    order: 1 !important;
    width: 100%;
    max-width: inherit !important;
    margin:  0;
}
    .news-section-right-part .uabb-blog-post-inner-wrap .uabb-post-thumbnail a{
    width:  100% !important;
    height:  100% !important;
    border-radius:  0 !important;
}
    .news-section-right-part .uabb-blog-post-inner-wrap .uabb-blog-post-content{
    width:  100% !important;
    margin-top: 20px;
    text-align: center !important;
}
  .news-letter-section .news-letter-section-text .fl-rich-text p span{
    font-size: 17px !important;
}

  .products-section-content .slick-next{left:-10px !important; right:auto !important;}
  .products-section-content .slick-prev{right:-10px !important; left:auto !important;}
}
@media screen and (max-width: 500px){
}
.Single-Product-text{
    text-align: justify;
    line-height: 25px;
    color: #444;
    font-weight: 400;
