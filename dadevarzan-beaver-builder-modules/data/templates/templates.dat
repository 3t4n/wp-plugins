    transform: rotate(180deg);
    display: inline-block;
}
.dv-sr-blog-09 .news-section-content .uabb-module-content .uabb-post-wrapper{
    max-width:  358px;
    margin:  0 auto;
    margin-bottom:  20px;
}
.dv-sr-blog-09 .news-section-content .uabb-post-wrapper .uabb-blog-posts-shadow{
    border: solid 1px #b5b5b5;
    border-radius: 7px;
    overflow:  hidden;
}
.dv-sr-blog-09 .news-section-content .uabb-post-wrapper:hover .uabb-blog-posts-shadow{
    box-shadow: 0 0 13px rgba(0,0,0,.22);
}
.dv-sr-blog-09 .news-section-content .uabb-post-wrapper .uabb-blog-post-inner-wrap .uabb-post-thumbnail{
    transition: all 0.5s;
    position: relative;
    top: 0;
    height:238px;
}
.dv-sr-blog-09 .news-section-content .uabb-post-wrapper:hover .uabb-blog-post-inner-wrap .uabb-post-thumbnail{
    height:0;
    overflow: hidden;
}
.dv-sr-blog-09 .news-section-content .uabb-post-wrapper .uabb-blog-post-inner-wrap .uabb-blog-post-content{
    transition: all 0.5s;
    position: relative;
    top: 0;
}
.dv-sr-blog-09 .news-section-content .uabb-post-wrapper:hover .uabb-blog-post-inner-wrap .uabb-blog-post-content .uabb-post-meta{opacity:1;}
.dv-sr-blog-09 .news-section-content .uabb-post-wrapper .uabb-blog-post-inner-wrap .uabb-blog-post-content .uabb-post-heading{
    padding-bottom: 10px;
}
.dv-sr-blog-09 .news-section-content .uabb-post-wrapper .uabb-blog-post-inner-wrap .uabb-blog-post-content .uabb-post-meta{
    opacity:  0;
    transition: all 0.5s;
    padding:  10px 0;
}
.dv-sr-blog-09 .news-section-content .uabb-post-wrapper .uabb-blog-post-inner-wrap .uabb-blog-post-content .uabb-blog-posts-description{
    padding: 0;
    text-align:  justify;
    height: 128px;
    overflow: hidden;
    transition: 0.8s;
}
.dv-sr-blog-09 .news-section-content .uabb-post-wrapper:hover .uabb-blog-post-inner-wrap .uabb-blog-post-content .uabb-blog-posts-description{
    height: 330px;
}
.dv-sr-blog-09 .news-section-content .uabb-post-wrapper:hover .uabb-blog-post-inner-wrap .uabb-blog-post-content  .uabb-post-meta,
.dv-sr-blog-09 .news-section-content .uabb-post-wrapper:hover .uabb-blog-post-inner-wrap .uabb-blog-post-content .uabb-read-more-text{
    opacity:  1;
}
.dv-sr-blog-09 .news-section-content .uabb-post-wrapper .uabb-blog-post-inner-wrap .uabb-blog-post-content .uabb-read-more-text{
    text-align:  left;
    opacity:  0;
    transition: all 0.5s;
}
@media screen and (max-width: 768px){
    .dv-sr-blog-09 .news-section-content .uabb-post-wrapper:hover .uabb-blog-post-inner-wrap .uabb-post-thumbnail{
        top: 0 !important;
    }
    .dv-sr-blog-09 .news-section-content .uabb-post-wrapper:hover .uabb-blog-post-inner-wrap .uabb-blog-post-content {
        top: 0 !important;
    }
    .dv-sr-blog-09 .news-section-content .uabb-post-wrapper .uabb-blog-post-inner-wrap .uabb-blog-post-content .uabb-post-heading{
        font-size: 16px;
    }
