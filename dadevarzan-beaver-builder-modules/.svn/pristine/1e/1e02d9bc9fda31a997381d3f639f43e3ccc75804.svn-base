main-menu .menu-item .sub-menu .menu-item .pp-has-submenu-container{
    border-bottom: 1px solid #ebebeb;
}
#menu-main-menu > .menu-item > .sub-menu{
    padding: 15px;
    box-shadow: 0 0 20px rgba(0,0,0,.15);
}
#menu-main-menu .menu-item .sub-menu li a{
    padding: 7px 15px;
}
#menu-main-menu .menu-item .sub-menu li{
    text-align:  right;
}
#menu-main-menu .menu-item .pp-menu-toggle{
    right:  0;
}
#menu-main-menu .menu-item .sub-menu .menu-item-text{
    padding:  0;
}
.fl-builder-content[data-type="header"].fl-theme-builder-header-shrink img{max-height: 70px !important;}
.header-row-1 .header-welcome p{color:#6f6f6f; margin:0;}
.header-row-1 .header-welcome p a{color:#00a5a5;}
.header-row-1 .header-social .fl-icon{margin:0; margin-right:10px;}
.fl-module-adv-testimonials,.fl-module-pp-testimonials{direction:ltr;}
.search-section .fl-widget{
    max-width: 250px;
    margin: 0 auto;}
.fl-search-form{display: flex;background-color: #ebebeb ;border-radius: 5px;align-items: center;}
.fl-search-form input:focus{background-color: #ebebeb ;}
.fl-search-form input{border: none;border-radius: 0px 5px 5px 0;background-color: #ebebeb ;}
.fl-search-form button{background: none;border: none;line-height: 0;}
.fl-search-form button i:before{color: #00a5a5;}
.site-logo-section .pp-photo-img{ max-width: 230px; margin: 0 auto;}
.header-row-1 .fl-col-group{display: flex;align-items: center;flex-wrap: wrap;}
.header-row-1 .header-search-col .fl-widget{margin:0;}
.header-row-1 .header-logo-text{padding: 10px 0;}
.header-row-1 .header-logo-text:before{display:block;content:"";height: 30px;width: 2px;float: right;position: relative;left: 10px;/* Permalink - use to edit and share this gradient: http://colorzilla.com/gradient-editor/#000000+0,000000+100&0.65+0,0+100;Neutral+Density */ /* FF3.6-15 */ /* Chrome10-25,Safari5.1-6 */background: radial-gradient(ellipse at center, rgba(0,0,0,0.65) 0%,rgba(0,0,0,0) 100%); /* W3C, IE10+, FF16+, Chrome26+, Opera12+, Safari7+ */ /* IE6-9 fallback on horizontal gradient */}
.header-row-2 .menu .menu-item .sub-menu{
    left: inherit;
    right: 0;
    text-align: center !important;
}
@media (max-width: 992px){
    #menu-main-menu .menu-item a{
        padding:  10px 8px;
        font-size: 12px;}
}
@media screen and (max-width: 768px) {
    .header-row-1 .header-logo-text .fl-heading{
    text-align: center;
