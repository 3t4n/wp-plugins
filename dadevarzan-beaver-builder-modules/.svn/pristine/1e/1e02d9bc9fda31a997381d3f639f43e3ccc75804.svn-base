    padding: 0 !important;
}
#menu-language-menu{
    display: flex;
    justify-content: flex-start;
}
.pp-advanced-menu-mobile-toggle{
    justify-content: flex-end !important;
}
.shop-card-header-menu .fl-html a{
    font-size:  12px;
    font-weight:  700;
    color: #007236;
}
.shop-card-header-menu .fl-html a i:before{
    font-size: 18px;
    color: #636363;
}
.header-row-2-site-logo-section{z-index:101;}
.hedear-row-2-menu-section #menu-header-row-1-main-manu > .menu-item.pp-has-submenu:before{display:none;}
#menu-header-row-1-main-manu .menu-item .sub-menu{background-color:#f2f2f2; left: inherit; border-top: 3px solid #00692a;}
#menu-header-row-1-main-manu .menu-item .sub-menu .menu-item{text-align:center;}
.hedear-row-2-menu-section #menu-header-row-1-main-manu > .menu-item:hover:before{
    left: 10px;
    right: 10px;
}
.hedear-row-2-menu-section #menu-header-row-1-main-manu > .menu-item:before{display:block;content:"";position: absolute;left: 50%;right: 50%;bottom: 0;height: 2px;background-color: #00692a;transition: all 0.3s;}
.header-row-1 .fl-col-group{display:flex; align-items:center; flex-wrap:wrap;}
.header-row-2{
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.25);
}
.header-row-2 .fl-col-group{display:flex; align-items:center; flex-wrap:wrap;}
.header-row-2-right-col .header-row-2-right-col-image .fl-module-content{
    z-index: 10;
    position: relative;
}
.header-row-2-right-col .header-row-2-right-col-image .fl-module-content:before{
    display: block;
    content: "";
    position: absolute;
    left: -15px;
    right: -15px;
    bottom: -10px;
    height: 140px;
    background-color: #fff;
    border-radius: 50%;
}
.menu-item a.menu-image-title-after.menu-image-not-hovered img, .menu-item a.menu-image-hovered.menu-image-title-after .menu-image-hover-wrapper{max-width:28px; float:right; padding-left:10px; padding-right:0;}
.search-section .fl-widget{margin:0;}
.fl-builder-content[data-type="header"].fl-theme-builder-header-shrink img{max-height:70px !important;}
.fl-theme-builder-header-shrink .header-row-2-right-col .header-row-2-right-col-image .fl-module-content:before{
    left: 15px;
    right: 15px;
    height: 100px;
}



@media screen and (max-width: 1200px){}
@media screen and (max-width: 992px){
    .header-row-2-right-col .header-row-2-right-col-image .fl-module-content:before {
    display: block;
    content: "";
    position: absolute;
    left: -5px;
    right: -5px;
    bottom: -5px;
}
.header-row-2-right-col .header-row-2-right-col-image .fl-module-content{
    margin-bottom: -40px;
    z-index: 10;
    bottom: 20px;
}
}
@media screen and (max-width: 768px){
    .header-row-2-right-col-image .pp-photo-img{display:block; max-width:110px !important; margin:0 auto;}
    .header-row-2-right-col-image .uabb-photo-img{
    max-width: 110px !important;
}
    .header-row-2-right-col .header-row-2-right-col-image .fl-module-content:before{display:none;}
