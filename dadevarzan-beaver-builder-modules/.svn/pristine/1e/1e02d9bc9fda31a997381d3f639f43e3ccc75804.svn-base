    font-size: 18px;
    color: #c30000;
}
.serach-section .fl-search-form{
    border: 1px solid #ebebeb;
}
.serach-section .fl-search-form input, .serach-section .fl-search-form, .serach-section .fl-search-form input:focus{
    background-color: transparent;
}
.serach-section .fl-search-form input::placeholder { /* Chrome, Firefox, Opera, Safari 10.1+ */
    color: white;
    opacity: 1; /* Firefox */
}

.serach-section .fl-search-form input:-ms-input-placeholder { /* Internet Explorer 10-11 */
    color: white;
}

.serach-section .fl-search-form input::-ms-input-placeholder { /* Microsoft Edge */
    color: white;
}
.header-social-section .adv-icon-link{ margin-bottom:0 !important;}
#menu-main-menu .menu-item .sub-menu{
    left: inherit;
    text-align: right;
    background-color: rgba(0, 0, 0, 0.5);
    border-top: 3px solid #c30000;
}
#menu-main-menu .menu-revenue a {color: #ffcc00;}
#menu-main-menu .menu-item .sub-menu .menu-item .sub-menu{right:100%;}
header.fl-theme-builder-header-scrolled img{max-height: 80px !important;}
header.fl-theme-builder-header-scrolled .fl-row-content-wrap {
    background-color: #1f2733c2 !important;
    border-bottom: 2px solid #c30000;
}
header .fl-row-content-wrap{
    transition: all 0.5s;
}

@media (max-width: 768px){
    header.fl-builder-content{position: static !important;
    background-color: #1f2733;
}
