    background-color: #f37320;
    left: 0;
}
#menu-main-menu .menu-item.current_page_item .menu-item-text, #menu-main-menu .menu-item .menu-item-text {
    position: relative;
    display: block;
}
#menu-main-menu .menu-item.current_page_item .menu-item-text:after {
    display: block;
    content: "";
    position: absolute;
    bottom: -30px;
    left: 0;
    right: 0;
    height: 7px;
    background-color: #f37320;
}
#menu-main-menu .menu-item .menu-item-text:after {
    display: block;
    content: "";
    position: absolute;
    bottom: -30px;
    left: 100%;
    right: 0;
    height: 7px;
    background-color: #f37320;
    transition: all 0.5s;
}
.header-row-1 .header-address-box .uabb-module-content .uabb-infobox-text p{
    padding:  0;
}
.header-row-1 .header-address-box.call .uabb-module-content .uabb-infobox-text{
    text-align:  right;
}
.header-row-1 .header-address-box .uabb-module-content .uabb-module-content{
    border-left: 1px solid #d0d0d2;
    margin-left:  10px;
    padding-left: 9px;
}
.header-row-1 .header-address-box .uabb-module-content .uabb-module-content .uabb-icon{
    transform: rotateY(180deg);
}
.header-row-1 .header-address-box.call .uabb-module-content .uabb-infobox-text{
    color:#444444 !important;
}

@media screen and (max-width: 1200px){
  #menu-main-menu .menu-item a{
    padding-left: 36px;
}
}
@media screen and (max-width: 992px){
   #menu-main-menu .menu-item a{
    padding-left: 16px;
    font-size: 15px;
}
  .header-row-1 .header-address-box.call .uabb-module-content .uabb-infobox-text{
    text-align:  right !important;
}
  .site-logo-section .pp-photo{
    text-align:  center;
}
