.dv-login-menu .pp-infolist-title  {
    margin-bottom: 5px;
    margin-top: 0;
    padding-right: 5px;
}
@media screen and (max-width: 992px){
    .main-menu-section .pp-advanced-menu-mobile-toggle {
        justify-content: flex-start;
    }
    #dv-main-menu .sub-menu {
        background-color:rgba(0,0,0,0.2);
    }    
}
@media screen and (max-width: 768px) {
    .dv-login-menu .pp-infolist ul{
        justify-content:center;
    }
    .header-row-2-content .fl-col-content{
        background:none;
    }
}";s:2:"js";s:254:"jQuery(function($) {
