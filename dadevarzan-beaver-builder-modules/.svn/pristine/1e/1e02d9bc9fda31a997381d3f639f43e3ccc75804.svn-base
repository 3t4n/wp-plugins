    padding-right: 0;
    padding-left: 28px;
}
#menu-main-menu .menu-item .pp-has-submenu-container .menu-item-text .pp-menu-toggle{
    right: auto;
    left:  15px;
}
#menu-main-menu .menu-item .sub-menu .menu-image{
    position: absolute;
    margin: 0 !important;
    left: 0;
    bottom: 0;
    max-width: 250px !important;
}
#menu-main-menu > .menu-item > .sub-menu > .menu-item{
    margin-bottom: 10px;
    max-width: 220px;
}
#menu-main-menu > .menu-item > .sub-menu{
    min-height: 340px;
    flex-wrap: wrap;
    border: 1px solid #666;
    border-top: none;
    padding: 10px 20px 10px 20px;
    padding-left: 250px;
    overflow: hidden;
}
#menu-main-menu .menu-item .sub-menu .menu-image a{
    padding: 0;
}
#menu-main-menu .menu-item .sub-menu .menu-image img{
    width:  100%;
    display:  block;
}
#menu-main-menu .menu-item .sub-menu .menu-item{text-align:right;}

.aws-search-form .aws-wrapper{
    display: flex !important;
}
.dv-search-submit{
    background-color: #ef3f3e;
    color: #FFFFFF;
    border: none;
    width: 50px;
}
.dv-search-submit:hover {
    background-color: #ef3f3e;
    color: #FFFFFF;
    border: none;
}
/********header**********/
.product-serach-section .woocommerce-product-search{display:flex;}
#menu-language-menu .menu-item .sub-menu{
    width: 150px !important;
    min-width:  inherit;
    box-shadow: 0 0 3px rgba(0,0,0,.15);
    text-align: center;
    left:  auto;
}
.xoo-wsc-container .xoo-wsc-icon-cross{
    left: 20px;
    right: auto;
}
.dv-search-obj .aws-container .aws-search-field{
    background: transparent;
}
.xoo-wsc-basket {
    display: none;
}
.dv-shop-hr-cart .xoo-wsc-items-count {
    background-color: #a40303;
    color: #ffffff;
    left: 10px;
    top: 10px;
    width: 22px;
    height: 22px;
    line-height: 23px;    
}
.dv-shop-hr-cart {
    position: relative;
    cursor: pointer;
}
.dv-product-category-obj .uabb-module-content .uabb-info-list-wrapper{
    display: flex;
}
.dv-product-category-obj .uabb-module-content .uabb-info-list-wrapper .uabb-info-list-content-wrapper{
    display: flex;
}
.dv-header-logo img{
    max-width:160px;
}
.responsive-product-menu .pp-advanced-menu-mobile-toggle .pp-advanced-menu-mobile-toggle-label{
    margin-left: 0 !important;
    margin-right:  20px;
    font-weight:  500;
    font-size: 13px !important;
}
.social-section-content .fl-col-content{
    flex-direction: row !important;
    justify-content: flex-end !important;
    flex-wrap: wrap !important;
}
.social-section-content .fl-col-content .fl-module{
    width: auto !important;
}
.header-social-section .adv-icon-link{
    margin-bottom:  0 !important;
    line-height: 0;
}
.header-social-section .uabb-module-content{
    line-height: 0;
}
.hamburger-label{padding:0 !important;}
@media screen and (max-width: 992px){
    #menu-main-menu-1 .menu-item .sub-menu .menu-image{
        display:none;
    }
    #menu-main-menu-1 > .menu-item .sub-menu{
        background:none;
        text-align:center;
    }
}
@media screen and (max-width: 768px) {
    #main-menu .menu-item .sub-menu .menu-image{
        display:none !important;
}
    #main-menu .menu-item .sub-menu .menu-item{text-align:center;}
    .header-social-section .uabb-module-content{
    text-align:  center;
}
    #menu-header-links{
    display:  flex;
    align-items:  center;
    justify-content:  center;
}
    .dv-shop-hr-cart .fl-node-content{
        margin:0;
    }    
    .dv-mobile-menu .adv-icon-horizontal .adv-icon-link{
        margin-bottom: 0;
    }
}
";s:2:"js";s:446:"jQuery(function($) {
    $( document ).ready(function() {
        //Adding Search icon to product ajax search
        $('.aws-search-field').after( '<button type="submit" class="dv-search-submit"><i class="fa fa-search"></i></button>' );
        
        $( '.dv-shop-hr-cart' ).append($( '.xoo-wsc-items-count' ));
        $( '.dv-shop-hr-cart' ).click(function() {
            $( ".xoo-wsc-basket" ).click();
        });
    });
});
