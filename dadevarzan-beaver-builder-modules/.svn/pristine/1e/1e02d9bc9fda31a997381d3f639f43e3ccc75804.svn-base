.menu-item-text img {
    width: 30px;
}
.aws-container .aws-search-form .aws-wrapper{
    display: inline-flex;
}
.aws-search-form {
    display: inline-flex;
}
.dv-search-submit{
    background-color: #74a82a;
    color: #FFFFFF;
    border: none;
    width: 50px;
    margin: 0 5px;
}
.dv-search-submit:hover {
    background-color: #1d7715;
    color: #FFFFFF;
    border: none;
}
.dv-menu-icon .menu-item-text img {
    width: 30px !important;
}
.search-section .fa-search {
    font-size: 1.5em;
}
/********header**********/
.product-serach-section .woocommerce-product-search{display:flex;}
#menu-language-menu .menu-item .sub-menu{
    width: 150px !important;
    min-width:  inherit;
    box-shadow: 0 0 3px rgba(0,0,0,.15);
    text-align: center;
    left:  auto;
}
#menu-main-menu .menu-item .sub-menu {
    position: absolute;
    top: 100%;
    right: 0;
    text-align: right !important;
  }
.product-serach-section .woocommerce-product-search{display:flex;}
#menu-language-menu .menu-item .sub-menu{
    width: 150px !important;
    min-width:  inherit;
    box-shadow: 0 0 3px rgba(0,0,0,.15);
    text-align: center;
    left:  auto;
}
#menu-main-product-menu .menu-item .menu-item-text .foundation-icons{
    position: relative;
    top: 4px;
    margin-left: 10px;
}
#menu-main-product-menu .menu-item .menu-item-text{
    padding-right:  0;
    padding-left: 20px;
    width:  100%;
    display: flex;
}
#menu-main-product-menu .menu-item .menu-item-text .fa{
    position:  relative;
    top: 6px;
    margin-left: 15px;
}
#menu-main-product-menu .menu-item .menu-item-text .pp-menu-toggle{
    right:  auto;
    left: 5px;
    transition: all 0.5s;
}
#menu-main-product-menu .menu-item{
    width:  100%;
}
#menu-main-product-menu .menu-item .sub-menu{
    width:  100%;
}
#menu-main-product-menu .menu-item .sub-menu .menu-item .sub-menu{
    left:  auto;
    right:  100%;
}

#menu-main-product-menu .menu-item .sub-menu .menu-item .menu-item-text .pp-menu-toggle{
    transform: rotatex(180deg);
}
#menu-main-product-menu .menu-item:hover > .pp-has-submenu-container > a > .menu-item-text > .pp-menu-toggle ,#menu-main-product-menu .menu-item .sub-menu .menu-item:hover .menu-item-text .pp-menu-toggle{
    transform: rotate(180deg);
}
.xoo-wsc-container .xoo-wsc-icon-cross{
    left: 20px;
    right: auto;
}
.dv-search-obj .aws-container .aws-search-field{
    background: transparent;
}
.xoo-wsc-basket {
    display: none;
}
.dv-shop-hr-cart .xoo-wsc-items-count {
    background-color: #fdc20e;
    color: #ffffff;
    left: 10px;
    top: 10px;
    width: 22px;
    height: 22px;
    line-height: 23px;    
}
.dv-shop-hr-cart {
    position: relative;
    cursor: pointer;
}
.dv-product-category-obj .uabb-module-content .uabb-info-list-wrapper{
    display: flex;
}
.dv-product-category-obj .uabb-module-content .uabb-info-list-wrapper .uabb-info-list-content-wrapper{
    display: flex;
}
.dv-header-logo img{
    max-width:160px;
}
.responsive-product-menu .pp-advanced-menu-mobile-toggle .pp-advanced-menu-mobile-toggle-label{
    margin-left: 0 !important;
    margin-right:  20px;
    font-weight:  500;
    font-size: 13px !important;
}
.main-menu-section .pp-advanced-menu-mobile-toggle .pp-svg-container{
    order: 2;
}
.main-menu-section .pp-advanced-menu-mobile-toggle .pp-advanced-menu-mobile-toggle-label{
    order: 1;
    font-weight:  500;
    margin-right:  20px !important;
    font-size: 13px !important;
}
.social-section-content .fl-col-content{
    flex-direction: row !important;
    justify-content: flex-end !important;
    flex-wrap: wrap !important;
}
.social-section-content .fl-col-content .fl-module{
    width: auto !important;
}
.header-social-section .adv-icon-link{
    margin-bottom:  0 !important;
    line-height: 0;
}
.header-social-section .uabb-module-content{
    line-height: 0;
}
.hamburger-label{padding:0 !important;}
@media screen and (max-width: 992px){
    #menu-header-links{
    display: flex;
    justify-content: center;
}
.header-social-section .uabb-module-content{
    text-align:  right;
}
.main-menu-section .pp-advanced-menu-mobile-toggle{
    display: flex;
    justify-content:  flex-start;
}
}
@media screen and (max-width: 768px) {
    #menu-language-menu,
    #menu-top-header-link{
    display: flex;
    justify-content: center;
}
    .header-social-section .uabb-module-content{
    text-align:  center;
}
    #menu-header-links{
    display:  flex;
    align-items:  center;
    justify-content:  center;
}
    .dv-shop-hr-cart .fl-node-content{
        margin:0;
    }    
    .dv-mobile-menu .adv-icon-horizontal .adv-icon-link{
        margin-bottom: 0;
    }
}

";s:2:"js";s:446:"jQuery(function($) {
    $( document ).ready(function() {
        //Adding Search icon to product ajax search
        $('.aws-search-field').after( '<button type="submit" class="dv-search-submit"><i class="fa fa-search"></i></button>' );
        
        $( '.dv-shop-hr-cart' ).append($( '.xoo-wsc-items-count' ));
        $( '.dv-shop-hr-cart' ).click(function() {
            $( ".xoo-wsc-basket" ).click();
        });
    });
