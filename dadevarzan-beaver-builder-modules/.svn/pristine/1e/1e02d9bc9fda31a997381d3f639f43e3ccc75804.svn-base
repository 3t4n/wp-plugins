.responsive-logo-row, .responsive-menu-row{width:100%;}
.header-row-2 .fl-module-pp-advanced-menu .pp-svg-container{
    position: relative;
    z-index: 10;
}
.fl-builder-content[data-type="header"].fl-theme-builder-header-shrink img {
    max-height: 100px !important;
}
.header-row-2 .menu .menu-item a{transition: all 0.5s;}
.header-row-2 .menu .menu-item .sub-menu{
    background-color: #fff;
    border-top:3px solid red;
    text-align: right;
    left: inherit;
}
.header-row-2 .menu .menu-item .sub-menu .menu-item .sub-menu{
    right: 100%;
}
.header-row-2 .menu .menu-item .menu-item-text{
    padding: 0 !important;
}
.fl-theme-builder-header-shrink .header-row-2 .menu .menu-item a{padding-top:20px !important; padding-bottom:20px !important;}
.fl-theme-builder-header-shrink .header-row-2 .menu .menu-item .sub-menu .menu-item a{padding-top:10px !important; padding-bottom:10px !important;}
.header-row-2 .header-right-menu-section, .header-row-2 .header-left-menu-section{
    position:  relative;
    z-index: 10;
}
.fl-theme-builder-header-shrink .site-logo-section{
    top: 20px;
}
.site-logo-section{
    position:  absolute;
    left:  0;
    right:  0;
    top: 55px;
    z-index: 9;
    transition: all 0.5s;
}
.header-social-section .fl-icon-group .fl-icon{
    margin: 0 15px 0 0 !important;
}
@media screen and (max-width: 1100px){
    .header-row-2 .menu .menu-item a{
    font-size: 15px;
    padding: 10px 8px !important;
}
}

@media screen and (max-width: 1200px){}
@media screen and (max-width: 992px){}
@media screen and (max-width: 768px){
#menu-language-menu a{padding: 0 10px;}
#menu-language-menu{
    display:  flex;
    align-items:  center;
    justify-content:  center;
}
    .header-social-section .fl-icon-group{
    text-align:  center;
