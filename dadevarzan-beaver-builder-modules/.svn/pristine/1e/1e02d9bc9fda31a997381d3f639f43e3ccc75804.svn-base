    position:  relative;
}
.header-row:before{display:block;content:"";position:  absolute;left:  0;right:  0;top: 40px;bottom: 40px;background-color: rgba(0, 0, 0, 0.4); height:64px;}
.header-row .site-logo-section .pp-photo-content-inner{
    box-shadow: 0 0 20px 0px rgba(0, 0, 0, 0.15);
}
.main-menu-section .pp-advanced-menu .sub-menu {
    min-width: 220px;
    right: 0;
    background: rgba(0,0,0,0.5);
    border-top: 3px solid #f01869;
}
.main-menu-section .pp-advanced-menu .sub-menu li{
   text-align:right;
   border-bottom:1px solid #48484866 !important ;

}
.main-menu-section .pp-advanced-menu .sub-menu li:hover{
  background:#3f9e42;
}
#menu-main-menu .menu-item.current_page_item .menu-item-text, #menu-main-menu .menu-item .menu-item-text{
    position:  relative;
    display:  block;
}
#menu-main-menu .menu-item.current_page_item .menu-item-text:after{display:block;content:"";position:  absolute;bottom: -22px;left:  0;right:  0;height:  2px;}
#menu-main-menu .menu-item .menu-item-text:after{display:block;content:"";position:  absolute;bottom: -22px;left:  50%;right:  50%;height:  2px;;transition: all 0.5s;}
#menu-main-menu .menu-item:hover .menu-item-text:after{ left:  0;right:  0;}
@media screen and (max-width: 1200px){
    #menu-main-menu .menu-item a{
        padding-left: 30px;
    }
}
@media screen and (max-width: 992px){
    #menu-main-menu .menu-item a{
        padding-left: 9px;
        font-size: 14px;
    }
}
@media screen and (max-width: 768px){
    .header-row .pp-advanced-menu-mobile-toggle.hamburger{
        text-align:  left;
    }
}
