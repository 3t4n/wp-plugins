    justify-content: flex-start;
}
header.fl-theme-builder-header-scrolled .header-row-2 .fl-row-content-wrap{
    background-color: #ffffff !important;
    border-bottom: none !important;
}
header.fl-theme-builder-header-scrolled .header-row-1{
    display: none;
}


#menu-main-menu > .menu-item:before{
    display: block;content:"";
    position: absolute;left:0;right:0;top:0;bottom:0;
}
#menu-main-menu > .menu-item:hover:before{
    background-color: #ffc602;
    transform: skew(-20deg);
}
#menu-main-menu > .menu-item a{
    position: relative;
}
#menu-main-menu .menu-item.current-menu-item a{
    color: white;
}
#menu-main-menu .menu-item .pp-has-submenu-container a .menu-item-text{
    padding-right: 0;
    padding-left: 20px;
}
#menu-main-menu > .menu-item .menu-item-text .pp-menu-toggle{
    right:auto;
    left:0;
}
#menu-main-menu .menu-item .sub-menu{
    border-top:none !important;
}
#menu-main-menu .sub-menu .menu-item .pp-menu-toggle:before{
    border-color: white;
}
#menu-main-menu .sub-menu .menu-item:hover > .pp-has-submenu-container .pp-menu-toggle{
    border-color: black;
}

.main-menu-section {
    position: relative;
}
.main-menu-section:before {
    background-color: #2d2d2d;
    position: absolute;right: 0;top: 0;bottom: 0;left: 0;
    display: block;
    transform: skew(-20deg)
}
.fl-builder-content[data-type="header"].fl-theme-builder-header-shrink img {
    max-height: 70px !important;
}
#menu-top-menu{display:flex; flex-wrap:wrap;}
#menu-top-menu .menu-item-text {
    letter-spacing: -0.3px;
}
#menu-main-menu .menu-item .sub-menu .menu-item-text{
    padding-right: 0 !important;
}
#menu-main-menu .menu-item .pp-has-submenu-container .menu-item-text{padding-right:20px;}
#menu-main-menu .menu-item .sub-menu .pp-menu-toggle:before{
    transform: rotate(135deg)!important;
    transform-origin: unset;
    left: 0 !important;
}
#menu-main-menu .menu-item .sub-menu .pp-menu-toggle{
    right: auto;
    left: 0;
}
#menu-main-menu .pp-menu-toggle:before {
    margin: 0 !important;
    right: 0;
    top: 10px !important;
}
#menu-main-menu .menu-item .sub-menu .menu-item .sub-menu{right:100%;}
#menu-main-menu .menu-item .sub-menu {
    left: inherit;
    text-align: right;
    box-shadow: 0 0 6px 0px rgba(0, 0, 0, 0.3);
    background-color: rgba(0, 0, 0, 0.8);
}
#menu-main-menu .menu-item.current_page_item a{background:none;}
#menu-main-menu .menu-item a:focus{
   background:  none;
   border:  none;
   outline:  none;
}
.fl-theme-builder-header-shrink .header-row-2 .fl-row-content-wrap{
    padding-bottom: 30px;
}
.main-menu-section{
    position:  absolute;
    bottom: -30px;
    z-index: 10;
    transition: all 0.3s;
    left: 0;
    right: 0;
}
.fl-theme-builder-header-shrink .main-menu-section{
    bottom: -50px;
}
.search-section .fl-search-form{
    max-width:  250px;
    float:  left;
    border-radius: 0;
    background-color: rgba(0,0,0,0.8);
}
.search-section .fl-search-form input,
.search-section .fl-search-form input:focus{
    background-color: transparent;
    color: white;
}
@media screen and (max-width: 1200px){
    #menu-main-menu > .menu-item a{
        padding-left: 10px;
        padding-right: 10px;
    }
}
@media screen and (max-width: 992px){
    .main-menu-section:before{
        transform:none;
    }
}
@media screen and (max-width: 768px){
    .header-menu-row{
        background-color: #2d2d2d;
    }
    #menu-language-menu{
        display:flex;
        justify-content:center;
    }
    .main-menu-section:before{
        background: none;
        position: static;
    }
    .main-menu-section{
    position:relative;
    bottom:0;
    }
    .search-section .fl-search-form{float:none; margin:0 auto;}
    #menu-top-menu{justify-content: center;}
    .header-row-2-content .fl-col-content{background:none;}
}";s:2:"js";s:0:"";}s:4:"type";s:6:"layout";}}}