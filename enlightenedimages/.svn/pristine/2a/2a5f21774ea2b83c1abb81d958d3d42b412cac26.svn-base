.loading{display:flex;justify-content:center;width:100%;min-height:200px;align-items:center}.lds-ring{width:80px;height:80px}.lds-ring div{box-sizing:border-box;display:block;position:absolute;width:64px;height:64px;margin:8px;border-radius:50%;-webkit-animation:lds-ring 1.2s cubic-bezier(.5,0,.5,1) infinite;animation:lds-ring 1.2s cubic-bezier(.5,0,.5,1) infinite;border:8px solid transparent;border-top-color:#fff}.lds-ring div:first-child{-webkit-animation-delay:-.45s;animation-delay:-.45s}.lds-ring div:nth-child(2){-webkit-animation-delay:-.3s;animation-delay:-.3s}.lds-ring div:nth-child(3){-webkit-animation-delay:-.15s;animation-delay:-.15s}@-webkit-keyframes lds-ring{0%{-webkit-transform:rotate(0deg);transform:rotate(0deg)}to{-webkit-transform:rotate(1turn);transform:rotate(1turn)}}@keyframes lds-ring{0%{-webkit-transform:rotate(0deg);transform:rotate(0deg)}to{-webkit-transform:rotate(1turn);transform:rotate(1turn)}}.error-message{margin:20px;color:#000}button span{pointer-events:none}.arrow-accordion{border:solid #000;border-width:0 2px 2px 0;display:inline-block;padding:3px;margin:2px 2px 1px}.right{transform:rotate(-45deg);-webkit-transform:rotate(-45deg)}.left{transform:rotate(135deg);-webkit-transform:rotate(135deg)}.up{transform:rotate(-135deg);-webkit-transform:rotate(-135deg)}.down{transform:rotate(45deg);-webkit-transform:rotate(45deg);margin-left:4px;margin-bottom:3px}.bulk{margin-top:20px;min-height:450px}.bulk-table-wrap{display:flex;flex-wrap:wrap;flex-direction:row;align-content:center;justify-content:flex-start;align-items:center}button.button-primary.trigger-bulk,button.trigger-bulk{font-size:1.3em!important}a.buy-credits{font-weight:400;font-size:.85em}.progress-bar-wrap{position:relative;margin:30px auto;height:auto}.progress-bar{position:relative;width:100%;height:auto;background-color:#d3d3d3;border-radius:20px}.progress-size{position:absolute;min-width:45px;height:100%;background-color:#fff;background-image:repeating-linear-gradient(-63deg,#2271b1,#2271b1 15px,rgba(34,113,177,.5254901960784314) 0,rgba(34,113,177,.5254901960784314) 30px);border-radius:20px;border:1px solid #2271b1;box-sizing:border-box}.progress-stats{color:#fff;text-align:center;position:relative;font-weight:700;text-shadow:1px 1px 1px rgba(0,0,0,.512);line-height:30px}.image-card{flex-grow:0;flex-shrink:1;flex-basis:calc(25% - 1em);display:flex;flex-wrap:nowrap;margin:5px;overflow:hidden;min-width:285px}.thumb{margin-right:10px}.image-card h4{margin:0}.details{display:flex;flex-direction:column;justify-content:flex-start;min-width:150px}.alt-text{margin-bottom:10px;font-weight:700}.file{color:grey;font-size:10px;line-height:12px;overflow-wrap:break-word;text-overflow:ellipsis;overflow:hidden}@media screen and (max-width:1124px){.image-card{flex-grow:0;flex-shrink:1;flex-basis:calc(33% - 1em)}}.bulk-table{width:100%;grid-column-gap:0;-webkit-column-gap:0;column-gap:0;border-spacing:0;border:1px solid #e5e5e5;box-shadow:0 1px 1px rgba(0,0,0,.04)}.bulk-table thead{background-color:#fff;height:50px}.bulk-table tr{background-color:#fff;max-height:100px}.bulk-table tbody tr:nth-child(odd){background-color:#f0f8ff}.bulk-table th{text-align:left}.bulk-table .elim-meta{width:auto}.bulk-table .alt-text{width:25%}.editable{padding:3px;border:1px solid transparent;border-radius:5px;transition:.2s}.editable:hover{cursor:text;background-color:#f7f7f7;border-color:#f1d21e;cursor:pointer}.editable:focus{border:1px solid #f7f7f7;background-color:#fcf8e1;cursor:text}.bulk-table .thumbnail{width:75px}.bulk-table .status{width:25px;text-align:center}.bulk-table td.status{color:green}.bulk-table td.Error{color:red}.bulk-table td.filename{color:#8c8f94;width:25%;max-width:200px;overflow-wrap:break-word;text-overflow:ellipsis;overflow:hidden}.bulk-table td.filename a.image-link{color:#8c8f94;text-decoration:none}.bulk-table .alt-text span{font-weight:400;color:#8c8f94}.bulk-table .alt-text span.existing-alt-text{line-height:20px}.bulk-table td,.bulk-table th{padding:10px}.settings{display:flex;justify-content:space-between}.dashboard{width:100%}.elim-options-table{border-collapse:collapse;text-align:left}.elim-options-table td,.elim-options-table th{vertical-align:top}.elim-options-table input[type=checkbox],.elim-options-table input[type=radio]{margin-right:12px}input[type=checkbox]+label,input[type=radio]:checked+label{font-weight:700}.elim-options-table .description{display:block;font-size:13px;color:grey;margin-left:28px;margin-top:4px}.elim-options-table td p{margin-bottom:10px}.elim-options-table h4{margin-top:5px}.elim-options-table th p{font-weight:400}.filler{height:50px}.sidebar{width:20%;max-width:350px;min-width:200px}.sidebar>div{display:block;padding:30px;margin:10px 0;background-color:#fff;border:1px solid #e5e5e5;box-shadow:0 1px 1px rgba(0,0,0,.04)}.sidebar h3.title{font-weight:700;font-size:1.2em;color:#004785}.sidebar .button-primary{font-weight:700;background-color:#f2da8c;color:#004785}.sidebar .price{font-weight:700;font-size:2em;color:#004785;display:block;margin:20px 0}.enlightened{color:#004784}@font-face{font-family:"Alata";font-style:normal;font-display:swap;font-weight:400;src:url(/static/media/alata-vietnamese-400-normal.6a13a2fd.woff2) format("woff2"),url(/static/media/alata-all-400-normal.0b577d18.woff) format("woff");unicode-range:u+0102-0103,u+0110-0111,u+0128-0129,u+0168-0169,u+01a0-01a1,u+01af-01b0,u+1ea0-1ef9,u+20ab}@font-face{font-family:"Alata";font-style:normal;font-display:swap;font-weight:400;src:url(/static/media/alata-latin-ext-400-normal.bf3e9a74.woff2) format("woff2"),url(/static/media/alata-all-400-normal.0b577d18.woff) format("woff");unicode-range:u+0100-024f,u+0259,u+1e??,u+2020,u+20a0-20ab,u+20ad-20cf,u+2113,u+2c60-2c7f,u+a720-a7ff}@font-face{font-family:"Alata";font-style:normal;font-display:swap;font-weight:400;src:url(/static/media/alata-latin-400-normal.e8434836.woff2) format("woff2"),url(/static/media/alata-all-400-normal.0b577d18.woff) format("woff");unicode-range