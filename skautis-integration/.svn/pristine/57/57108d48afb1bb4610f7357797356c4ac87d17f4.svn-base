.skautis-user-management-table{border-collapse:collapse}.skautis-user-management-table tbody>:nth-child(odd){background-color:#f9f9f9}.skautis-user-management-table td,.skautis-user-management-table th{padding:5px 8px}.skautis-user-management-table th{text-align:left;background:0 0!important}.skautis-user-management-table th span{position:relative}.skautis-user-management-table th span::after{content:"";position:absolute;left:100%;top:50%;width:19px;height:19px;margin-left:1ex;transform:translateY(-50%);background-position:center center;background-repeat:no-repeat}#TB_ajaxContent .content{padding:0 55px 0 0}#connectUserToSkautisModal{max-width:400px}