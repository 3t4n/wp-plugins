/* General styles for the tabs */
#argonz-metabox-tabs {
    font-family: 'Vazir', sans-serif;
    margin-top: 10px;
}

.argonz-tabs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    border-bottom: 2px solid #ccc;
}

.argonz-tabs li {
    margin: 0;
    padding: 0;
}

.argonz-tabs a {
    display: block;
    padding: 10px 20px;
    margin-right: 5px;
    background-color: #f7f7f7;
    border: 1px solid #ccc;
    border-bottom: none;
    text-decoration: none;
    color: #333;
    font-weight: bold;
    border-radius: 5px 5px 0 0;
    transition: background-color 0.3s, color 0.3s;
}

.argonz-tabs a:hover,
.argonz-tabs a.active {
    background-color: #0073aa;
    color: #fff;
}

.argonz-tab-content {
    display: none;
    padding: 20px;
    border: 1px solid #ccc;
    border-radius: 0 0 5px 5px;
    background-color: #fff;
}

.argonz-tab-content.active {
    display: block;
}
