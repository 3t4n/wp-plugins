#: ../admin/easyPixelsCF7Admin.php:55
msgid "Enable Google Ads tracking"
msgstr "Activa el seguiment de Google Ads"

#: ../admin/easyPixelsCF7Admin.php:55
msgid "Enable"
msgstr "Activa"

#: ../admin/easyPixelsCF7Admin.php:67 ../admin/easyPixelsCF7Admin.php:110
msgid "No \"Contact form 7\" forms are found"
msgstr "No s'ha trobat formularis \"Contact Form 7\""

#: ../admin/easyPixelsCF7Admin.php:113
msgid "\"Contact form 7\" plugin is not installed or active."
msgstr "\"Contact Form 7\" no està instal·lat o està inactiu."

#: ../admin/page-basicNotInstalled.php:2 ../admin/page-easyPixelsCF7Admin.php:2
msgid "Contact Form 7 tracking"
msgstr "Seguiment de Contact Form 7"

#: ../admin/page-basicNotInstalled.php:3 ../admin/page-easyPixelsCF7Admin.php:3
msgid ""
"Track Contact Form 7! Works with Google Tag Manager, Google Analytics, "
"Google Ads, Bing, Facebook and Twitter."
msgstr ""
"Realitza el seguiment de Contact Form 7! Funciona amb Google Tag Manager, "
"Google Analytics, Google Ads, Bing, Facebook i Twitter."

#: ../admin/page-basicNotInstalled.php:11
msgid ""
"The plugin \"Easy Pixels by JEVNET\" is required as core of this plugin."
msgstr ""
"És necessari instal·lar el plugin \"Easy Pixels\" com a base d'aquesta "
"extensió."

#: ../admin/page-basicNotInstalled.php:13
msgid "Please, download Easy Pixels and begin to track your forms."
msgstr ""
"Si us plau, descarrega't Easy Pixels i comença a fer el seguiment dels teus "
"formularis."

#: ../admin/page-basicNotInstalled.php:15
msgid "Download Easy Pixels"
msgstr "Descarrega Easy Pixels"

#~ msgid "Easy Pixels by <b>JEVNET</b>"
#~ msgstr "Easy Pixels per <b>JEVNET</b>"
