#: ../admin/easyPixelsCF7Admin.php:56
msgid "Enable Google Ads tracking"
msgstr "Activar seguimiento de Google Ads"

#: ../admin/easyPixelsCF7Admin.php:56
msgid "Enable"
msgstr "Activar"

#: ../admin/easyPixelsCF7Admin.php:76 ../admin/easyPixelsCF7Admin.php:122
msgid "No \"Contact form 7\" forms are found"
msgstr "No se han enconotrado formularios \"Contact Form 7\""

#: ../admin/easyPixelsCF7Admin.php:126
msgid "\"Contact form 7\" plugin is not installed or active."
msgstr "El plugin \"Contact Form 7\" no está instalado o no está activo."

#: ../admin/page-basicNotInstalled.php:2 ../admin/page-easyPixelsCF7Admin.php:2
msgid "Contact Form 7 tracking"
msgstr "Seguimiento de Contact Form 7"

#: ../admin/page-basicNotInstalled.php:3
msgid ""
"Track Contact Form 7! Works with Google Tag Manager, Google Analytics, "
"Google Ads, Bing, Facebook and Twitter."
msgstr ""
"¡Realiza el seguimiento de Contact Form 7! Funciona con Google Tag Manager, "
"Google Analytics, Google Ads, Bing, Facebook y Twitter."

#: ../admin/page-basicNotInstalled.php:11
msgid ""
"The plugin \"Easy Pixels by JEVNET\" is required as core of this plugin."
msgstr ""
"Es necesario instalar el plugin \"Easy Pixels\" de JEVNET como base de esta "
"extensión."

#: ../admin/page-basicNotInstalled.php:13
msgid "Please, download Easy Pixels and begin to track your forms."
msgstr ""
"Por favor, descarga Easy Pixels y empieza a realizar el seguimiento de tus "
"formularios."

#: ../admin/page-basicNotInstalled.php:15
msgid "Download Easy Pixels"
msgstr "Descarga Easy Pixels"

#: ../admin/page-easyPixelsCF7Admin.php:10
msgid ""
"Track Contact Form 7! Works with Google Tag Manager, Google Analytics, "
"Google Ads, Bing, Facebook and Twitter. This plugin sends the events shown "
"at the right side of each form to all platforms with no extra configuration. "
"Automatically it sends the event including the form name and the form id."
msgstr ""
"¡Realiza el seguimiento de Contact Form 7! Funciona con Google Tag Manager, "
"Google Analytics, Google Ads, Bing, Facebook and Twitter.  Envía los eventos "
"mostrados a la izquierda de cada formulario sin más configuraciones extra. "
"Automáticamente envía el evento incluyendo el nombre del formulario y el id "
"del mismo."

#~ msgid "Easy Pixels by <b>JEVNET</b>"
#~ msgstr "Easy Pixels por <b>JEVNET</b>"
