<?php

namespace NativeRent\Common\SDK\Auth;

use NativeRent\Common\SDK\PayloadInterface;

final class AuthPayload implements PayloadInterface {
	/**
	 * Partner domain.
	 *
	 * @var string
	 */
	private $domain;

	/**
	 * Partner email.
	 *
	 * @var string
	 */
	private $email;

	/**
	 * Partner password.
	 *
	 * @var string
	 */
	private $password;

	/**
	 * Secret key generated by plugin.
	 *
	 * @var SecretKey
	 */
	private $secretKey;

	/**
	 * Integration type value (ex. 'wordpress').
	 *
	 * @var string
	 */
	private $integrationType;

	/**
	 * @param  string    $domain Partner domain.
	 * @param  string    $email Partner email.
	 * @param  string    $password Partner password.
	 * @param  SecretKey $secretKey Generated secret key.
	 * @param  string    $integrationType Integration type value.
	 */
	public function __construct(
		$domain,
		$email,
		#[\SensitiveParameter]
		$password,
		#[\SensitiveParameter]
		$secretKey,
		$integrationType
	) {
		$this->domain = $domain;
		$this->email = $email;
		$this->password = $password;
		$this->secretKey = $secretKey;
		$this->integrationType = $integrationType;
	}

	/**
	 * {@inheritDoc}
	 */
	public function jsonSerialize() {
		return [
			'domain' => $this->domain,
			'email' => $this->email,
			'password' => $this->password,
			'secretKey' => $this->secretKey->getKey(),
			'integrationType' => $this->integrationType,
		];
	}
}
