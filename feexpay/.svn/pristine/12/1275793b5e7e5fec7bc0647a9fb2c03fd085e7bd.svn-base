 }


/* .feexPay_payButtonStyles */

.feexPay_payButtonStyles .button_container{
    width:100%;
    display:flex;
    justify-content:center;
    align-items:center;
    flex-direction:column;
  }
  .feexPay_payButtonStyles .button_pay{
    background-color:#112C56;
    color:white;
    text-align:center;
    padding:10px;
    border:none;
    /*width:45%;*/
    display:flex;
    justify-content:center;
    align-items:center;
    flex-direction:row;
    cursor:pointer;
    border-radius:5px;
    margin-top: 0.5rem;

  }
  .feexPay_payButtonStyles .button_text{
     font-size:0.8rem;
     font-weight:500;
    
  }

  @media screen and (max-width:960px) {
  
    .feexPay_payButtonStyles .button_pay{
      /*width:100%;*/
     }


}





/* .feexpay_chargement_loader */

.feexpay_chargement_container{
    width:100vw;
    height:100vh;
    position:fixed;
    top:0px;
    left:0px;
    background-color:#404040a6;
    z-index:1000000000;
    
    flex-direction:column;
    align-items:center;
    justify-coNtent:center;
    
  }
  .feexpay_message_container{
   
    padding:2rem;
    display:flex;
    flex-direction:column;
    align-items:center;
    width:25%;
    height:25%;
    justify-coNtent:center;
    background-color:#D45D00;
    box-shadow:2px 2px 10px 2px #5a5a5a1f;
    transform:translateY(10px);
  }
 

  .feexpay_request_msg{
    font-size:0.9rem;
    color:white;
    font-weight:500;
    margin-top:1rem;
    font-family: 'Poppins', sans-serif;
    text-align:center;

  }

  .feexpay_loader{
    width:50px;
    height:50px;
    border:10px solid white;
    border-top:10px solid #112C56;
    margin:0 auto;
    border-radius:50%;
    animation: spin 2s linear infinite;

  }
  @keyframes spin {
    0%{transform: rorate(0deg)}
    100%{transform:rotate(360deg)}
  }


  
@media screen and (max-width:700px) {
  .feexpay_message_container{
    width:60%;
    height:30%;
  }
}


  




.feexpay_num_imput .margin{
    margin-top:1.5rem;
    margin-bottom:1.5rem;
}

.feexpay_num_imput .num_operator_card{
    width:100%;
    display:flex;
    flex-direction:column;

}
.feexpay_num_imput .num_input_container{
    width:100%;
    display:flex;
    flex-direction:row;
    align-items:center;
    border: 1px solid #ced4da;
    border-radius: 5px;
    /*border-bottom:solid 1.5px #00000071;*/
}
.feexpay_num_imput .flag{
    width:10%;
    text-align: center;
}
.feexpay_num_imput .input_num{
    border:none !important;
    outline:none !important;
    background-color: transparent;
    padding:10px !important;
    width: -webkit-fill-available;
}
.feexpay_num_imput .flag .img_flag{
    width:25px !important;
    text-align: center;
}

.feexpay_num_imput .num_flag_container{
    width:30%;
    padding:0px;
    background-color:white;
    box-shadow:1px 1px 20px 0.2px lightgrey;
    
    flex-direction:column;
    transform:translateY(40%);
    position:absolute;
    
}
.feexpay_num_imput .flag_info_container{
    transition:all 1s;
    display:flex;
    justify-content:center;
    align-items:center;
    padding:3px;
    padding-left:0px;
    cursor:pointer;

}
.feexpay_num_imput .flag_info_container:hover{
    transition:all 1s;
    background-color:whitesmoke;

}
.feexpay_close_btn{
  background-color: crimson;
  border-radius: 5rem;
  transform: translateX(100%) translateY(-100%);
  cursor: pointer;
  height:30px;
  width: 30px;
  background-image: url("https://api.feexpay.me/api/static/cross-23.png");
  background-size: cover;
  background-position: center;
  float: right;
 

}

.feexpay_num_imput .flag_container img{
    width:25px;
}
.feexpay_num_imput .flag_conyainer{
    width:10%;
    padding-top:5px;
}
.feexpay_num_imput .flag_name{
    width:90%;
    text-align:right;
    padding-right:1rem;
    font-size:0.8rem;
}
.feexpay_num_imput .error_text_operator_input{
    font-size: 12.25px;
    color:crimson;
    margin-top:0.5rem;
}
@media screen and (max-width:700px) {
     .feexpay_num_imput .num_flag_container{
         width:85%;
    }

}



/* Mail And Name Input*/

.feexpay_input_simple{
    border: 1px solid #ced4da;
    border-radius: 5px;
    outline:none;
    /*border-bottom: solid 1.5px #00000071;*/
    padding-bottom:10px;
    padding-top:10px;
    padding-left:10px;
    width: -webkit-fill-available;
    margin-bottom: 1.5rem;
    margin-top: 5px;
    background-color: transparent;
}







    @media screen and (max-width:960px){
      
        .feexPayMobilePay .img_mtn{
            margin-right:0px;
        }
        .feexPayMobilePay .choice_operator_img{
           display:flex; 
           align-items:center;
           justify-content:flex-end;  
           flex-direction:row;
        }
        .feexPayMobilePay .choice_mtn{
           display:flex;
     
        }
        .feexPayMobilePay .choice_moov{
            display:flex;
        }
        .feexPayMobilePay .img_mtn{
           margin-right:0px;
        }
     
     
     }




































































@media screen and (max-width:700px) {
    .feexpay_modal_container .modal{
        width:100%;
        height:100%;
        background-color: #f8f9fa !important;
    }
    .feexpay_modal_container .footer_modal_container{
        width:100%;
        
        
    }
}

@media screen and (max-height:850px) and (max-width:700px) {
    .feexpay_modal_container .modal{
        background-color: #f8f9fa !important;
        overflow-y:scroll;
    }
    
}