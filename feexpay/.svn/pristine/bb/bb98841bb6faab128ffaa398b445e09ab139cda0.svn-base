m;\n    transform-origin: center;\n    cursor: pointer;\n    border-radius: 0.25rem !important;\n\n}\n\n.feexpaycardbankchoice:hover {\n    transition: all 1s;\n    border: solid 1.5px orangered;\n}\n\n\n.feexpaycardbankchoice .image_choice {\n    display: flex;\n    flex-direction: row;\n    justify-content: end;\n    align-items: center;\n    position: relatif;\n    right: 1rem;\n    justify-self: flex-end;\n    padding-top: 8px;\n    padding-bottom: 8px;\n    width: 50%;\n\n}\n\n.feexpaycardbankchoice .image_choice img {\n    width: 40;\n}\n\n.feexpaycardbankchoice .input_choice,\n.choice_text {\n    margin-left: 0.5rem;\n}\n\n.feexpaycardbankchoice .img_moov {\n    margin-right: 2rem;\n}\n\n.feexpaycardbankchoice .img_mtn {\n    margin-right: 1rem\n}\n\n.feexpaycardbankchoice .text_container {\n    width: 70%;\n    display: flex;\n    align-items: center;\n    flex-direction: row;\n\n}\n\n\n.feexpaycancel {\n    transition: all 1s;\n    border: solid 1.5px gray;\n    display: flex;\n    flex-direction: row;\n    align-items: center;\n    width: 100%;\n    margin-top: 1rem;\n    transform-origin: center;\n    height: 56px;\n    border-radius: 0.25rem !important;\n}\n\n.feexpaycancel:hover {\n    transition: all 1s;\n    border: solid 1.5px orangered;\n\n}\n\n.feexpaycancel .input_choice,\n.feexpaycancel .choice_text {\n    margin-left: 0.5rem;\n}\n\n\n\n\n\n\n\n\n\n.feexPayMobilePay .choice_operator_card {\n    width: 100%;\n    border-bottom: solid 1.5px #00000071;\n    display: flex;\n    flex-direction: row;\n    align-items: center;\n    justify-content: center;\n\n\n}\n\n.feexPayMobilePay .choice_operator_text {\n    width: 60%;\n    display: flex;\n    align-items: center;\n    font-weight: 700;\n    font-size: 0.8rem;\n\n}\n\n.feexPayMobilePay .choice_operator_img {\n    display: flex;\n    width: 40%;\n    justify-content: flex-end;\n    align-items: center;\n    flex-direction: row;\n\n}\n\n.feexPayMobilePay .choice_operator_img input {\n    margin-right: 0.3rem;\n}\n\n.feexPayMobilePay .choice_operator_img img {\n    width: 45px;\n    padding-top: 8px;\n    padding-bottom: 8px;\n\n}\n\n\n.feexPayMobilePay .choice_mtn {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-direction: row;\n\n\n}\n\n.feexPayMobilePay .choice_moov {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-direction: row;\n}\n\n\n\n.feexPayMobilePay .img_mtn {\n    margin-right: 1rem;\n}\n\n.feexPayMobilePay .error_text_operator {\n    font-size: 0.6rem;\n    color: crimson;\n    margin-top: 0.5rem;\n}\n\n/* feexPayMobilePay */\n\n\n\n.feexPayMobilePay .choice_operator_card {\n    width: 100%;\n    border-bottom: solid 1.5px #00000071;\n    display: flex;\n    flex-direction: row;\n    align-items: center;\n    justify-content: center;\n\n\n}\n\n.feexPayMobilePay .choice_operator_text {\n    width: 60%;\n    display: flex;\n    align-items: center;\n    font-weight: 700;\n    font-size: 0.8rem;\n\n}\n\n.feexPayMobilePay .choice_operator_img {\n    display: flex;\n    width: 40%;\n    justify-content: flex-end;\n    align-items: center;\n    flex-direction: row;\n\n}\n\n.feexPayMobilePay .choice_operator_img input {\n    margin-right: 0.3rem;\n}\n\n.feexPayMobilePay .choice_operator_img img {\n    width: 45px;\n    padding-top: 8px;\n    padding-bottom: 8px;\n\n}\n\n\n.feexPayMobilePay .choice_mtn {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-direction: row;\n\n\n}\n\n.feexPayMobilePay .choice_moov {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-direction: row;\n}\n\n\n\n.feexPayMobilePay .img_mtn {\n    margin-right: 1rem;\n}\n\n.feexPayMobilePay .error_text_operator {\n    font-size: 0.6rem;\n    color: crimson;\n    margin-top: 0.5rem;\n}\n\n@media screen and (max-width:960) {\n\n    .feexPayMobilePay .img_mtn {\n        margin-right: 0;\n    }\n\n    .feexPayMobilePay .choice_operator_img {\n        display: flex;\n        align-items: center;\n        justify-content: flex-end;\n        flex-direction: column;\n    }\n\n    .feexPayMobilePay .choice_mtn {\n        display: flex;\n\n    }\n\n    .feexPayMobilePay .choice_moov {\n        display: flex;\n    }\n\n    .feexPayMobilePay .img_mtn {\n        margin-right: 0;\n    }\n\n\n}\n\n\n/* .feexPay_payButtonStyles */\n.back_button {\n    color: #112C56 !important;\n    border: 1px solid #112C56 !important;\n    margin-right: 5px !important;\n    background-color: white !important;\n}\n\n.feexPay_payButtonStyles .button_container {\n    width: 100%;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    /*flex-direction:column;*/\n}\n\n.feexPay_payButtonStyles .button_pay {\n    background-color: #112C56;\n    color: white;\n    text-align: center;\n    padding: 10;\n    border: none;\n    /*width:45%;*/\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    flex-direction: row;\n    cursor: pointer;\n    border-radius: 5px;\n    margin-top: 0.5rem;\n\n}\n\n.feexPay_payButtonStyles .button_text {\n    font-size: 0.8rem;\n    font-weight: 500;\n\n}\n\n@media screen and (max-width:960) {\n\n    .feexPay_payButtonStyles .button_pay {\n        /*width:100%;*/\n    }\n\n\n}\n\n\n\n\n\n/* .feexpay_chargement_loader */\n\n.feexpay_chargement_container {\n    width: 100vw;\n    height: 100vh;\n    position: fixed;\n    top: 0;\n    left: 0;\n    background-color: #404040a6;\n    z-index: 1000000000;\n\n    flex-direction: column;\n    align-items: center;\n    justify-coNtent: center;\n\n}\n\n.feexpay_message_container {\n    padding: 2rem;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    max-width: 450px;\n    height: fit-content;\n    justify-coNtent: center;\n    background-color: #D45D00;\n    box-shadow: 2px 2px 10 2px #5a5a5a1f;\n    transform: translateY(10);\n}\n\n\n.feexpay_request_msg {\n    font-size: 0.9rem;\n    color: white;\n    font-weight: 500;\n    margin-top: 1rem;\n    font-family: \'Poppins\', sans-serif;\n    text-align: center;\n\n}\n\n.feexpay_loader {\n    width: 50;\n    height: 50;\n    border: 10 solid white;\n    border-top: 10 solid #112C56;\n    margin: 0 auto;\n    border-radius: 50%;\n    animation: spin 2s linear infinite;\n\n}\n\n@keyframes spin {\n    0% {\n        transform: rorate(0deg)\n    }\n\n    100% {\n        transform: rotate(360deg)\n    }\n}\n\n\n\n@media screen and (max-width:700) {\n    .feexpay_message_container {\n        width: 60%;\n        height: 30%;\n    }\n}\n\n\n\n\n\n\n\n.feexpay_num_imput .margin {\n    margin-top: 1.5rem;\n    margin-bottom: 1.5rem;\n}\n\n.feexpay_num_imput .num_operator_card {\n    width: 100%;\n    display: flex;\n    flex-direction: column;\n\n}\n\n.feexpay_num_imput .num_input_container {\n    width: 100%;\n    display: flex;\n    flex-direction: row;\n    align-items: center;\n    border: 1px solid #ced4da;\n    border-radius: 5px;\n    /*border-bottom:solid 1.5px #00000071;*/\n}\n\n.feexpay_num_imput .flag {\n    width: 10%;\n    text-align: center;\n}\n\n.feexpay_num_imput .input_num {\n    border: none !important;\n    outline: none !important;\n    background-color: transparent;\n    padding: 10 !important;\n    width: -webkit-fill-available;\n}\n\n.feexpay_num_imput .flag .img_flag {\n    width: 25px !important;\n    text-align: center;\n}\n\n.feexpay_num_imput .num_flag_container {\n    width: 30%;\n    padding: 0;\n    background-color: white;\n    box-shadow: 1px 1px 20 0.2px lightgrey;\n\n    flex-direction: column;\n    transform: translateY(40%);\n    position: absolute;\n\n}\n\n.feexpay_num_imput .flag_info_container {\n    transition: all 1s;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    padding: 3px;\n    padding-left: 0;\n    cursor: pointer;\n\n}\n\n.feexpay_num_imput .flag_info_container:hover {\n    transition: all 1s;\n    background-color: whitesmoke;\n\n}\n\n.feexpay_close_btn {\n    background-color: crimson;\n    border-radius: 5rem;\n    transform: translateX(100%) translateY(-100%);\n    cursor: pointer;\n    height: 30;\n    width: 30;\n    background-image: url("https://api.feexpay.me/api/static/cross-23.png");\n    background-size: cover;\n    background-position: center;\n    float: right;\n\n\n}\n\n.feexpay_num_imput .flag_container img {\n    width: 25px;\n}\n\n.feexpay_num_imput .flag_conyainer {\n    width: 10%;\n    padding-top: 5px;\n}\n\n.feexpay_num_imput .flag_name {\n    width: 90%;\n    text-align: right;\n    padding-right: 1rem;\n    font-size: 0.8rem;\n}\n\n.feexpay_num_imput .error_text_operator_input {\n    font-size: 12.25px;\n    color: crimson;\n    margin-top: 0.5rem;\n}\n\n@media screen and (max-width:700) {\n    .feexpay_num_imput .num_flag_container {\n        width: 85%;\n    }\n\n}\n\n\n\n/* Mail And Name Input*/\n\n.feexpay_input_simple {\n    border: 1px solid #ced4da;\n    border-radius: 5px;\n    outline: none;\n    /*border-bottom: solid 1.5px #00000071;*/\n    padding-bottom: 10;\n    padding-top: 10;\n    padding-left: 10;\n    width: -webkit-fill-available;\n    margin-bottom: 1.5rem;\n    margin-top: 5px;\n    background-color: transparent;\n}\n\n@media screen and (max-width:960) {\n\n    .feexPayMobilePay .img_mtn {\n        margin-right: 0;\n    }\n\n    .feexPayMobilePay .choice_operator_img {\n        display: flex;\n        align-items: center;\n        justify-content: flex-end;\n        flex-direction: row;\n    }\n\n    .feexPayMobilePay .choice_mtn {\n        display: flex;\n\n    }\n\n    .feexPayMobilePay .choice_moov {\n        display: flex;\n    }\n\n    .feexPayMobilePay .img_mtn {\n        margin-right: 0;\n    }\n\n\n}\n\n.feexpay_card_info_modal {\n    width: 100vw;\n    height: 100vh;\n    position: fixed;\n    top: 0;\n    left: 0;\n    background-color: #404040a6;\n    z-index: 1000000000;\n    flex-direction: column;\n    align-items: center;\n    j