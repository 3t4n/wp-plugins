_lock_container">\n                                        <img\n                                        class="feexpay_img_lock"\n                                        src="${l}"\n                                        alt="icon lock"\n                                        />\n                                    </div>\n                                <div class="feexpay_lock_text">Sécurisé par FeexPay</div>\n                            </div>\n                            <div class="feexpay_lock_text">\n                                <small style="text-align: center !important; width: 80% !important;">En payant par ce plugin, vous acceptez les <a href="https://feexpay.me/termesconditions" target="_blank" style="color: #D45D00 !important; text-decoration: none !important;">conditions générales d'utilisation</a> de FeexPay.</small>\n                            </div>\n                        </div>\n\n                        <div class="footer_modal_container">\n                            <div class="footer_modal"></div>\n                        </div>\n                        </div>\n                    </div>\n\n                    <div\n                        class="feexpay_chargement_container"\n                        style="display:none"\n                    >\n                        <div class="feexpay_message_container" style="background-color:#D45D00">\n                            \n                            <div class="feexpay_loader" style="display:block"></div>\n                            <div class="feexpay_request_msg">En attente de payement</div>\n                            \n                        </div>\n                        <div style="margin-top:1rem;" onClick="window.feexpay_close_all(window.feexpay_message_actived)" class="feexpay_button_close_modal" id='put_in_back' style="display:block">Mettre en arrière plan.</div>\n                    </div>\n                    \n                    <div\n                        class="feexpay_card_info_modal"\n                        style="display:none"\n                    >\n                        <div class="feexpay_message_container" style="background-color:#112C56">\n                           \n                            \n                            <div class="feexpay_request_msg">\n                            <div class="ModalInfos__center">\n                            <p class="ModalInfos__text">\n                                Pour sélectionner d’autres moyens de paiement <strong>(cartes et autres)</strong>, cliquez sur <strong>Changer la méthode de paiement</strong>.\n                            </p>\n                            <p class="ModalInfos__text">\n                                To select other payment methods <strong>(cards and others)</strong>, click on <strong>Change payment method</strong>.</p>\n                            <button class="ModalInfos__btn" onClick="window.closePopupInfos()">Fermer</button>\n                            </div>\n</div>\n                        </div>\n                    </div>\n                    `;let g=document.querySelector(`#${t}`);g.innerHTML="";let v=document.querySelector(".feexpay_button");if(1==c.custom_button){const e='<div class="feexpay_payment_message">En attente de paiement</div>';v=document.querySelector(`#${c.id_custom_button}`),g.innerHTML=e+_}else g.innerHTML=f+_,v=document.querySelector(".feexpay_button");v.addEventListener("click",(e=>{!function(e){e.preventDefault(),document.querySelector(".feexpay_modal_container").style.display="flex"}(e),document.querySelector(".feexpay_payment_message").style.display="none"}))})).catch((e=>{let n=document.querySelector(`#${t}`);1==c.custom_button?null===document.querySelector(`#${c.id_custom_button}`)&&(n.innerHTML='\n                <div class="feexpay_modal_error">\n                    <img class="feexpay_modal_error_img" src="https://api.feexpay.me/api/static/error.svg" alt="error"/>\n                    <div class="feexpay_modal_error_text">\n                       Vos paramètres d\'initialisation sont incorrects.\n                    </div>\n                    <div class="feexpay_modal_error_text_small">\n                       Veuillez vérifiez les différentes valeurs que vous avez entrées.\n                    </div>\n                </div>\n                '):n.innerHTML='\n                <div class="feexpay_modal_error">\n                    <img class="feexpay_modal_error_img" src="https://api.feexpay.me/api/static/error.svg" alt="error"/>\n                    <div class="feexpay_modal_error_text">\n                       Vos identifiants d\'intégration sont incorrects.\n\n                    </div>\n                    <div class="feexpay_modal_error_text_small">\n                       Veuillez vérifiez l\'environnement dans lequel vous êtes. Merci d\'utiliser la clé adéquate à votre environnement (live ou sandbox) actuel\n                    </div>\n                </div>\n                ',console.log(e)}))}()}};window.FeexPayButton=rn})()})();
