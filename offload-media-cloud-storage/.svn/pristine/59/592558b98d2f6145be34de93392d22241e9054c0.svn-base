/SettingsFooter/style.scss","webpack://app/./src/components/ConfirmReset/style.scss","webpack://app/./src/components/ConfirmEnable/style.scss","webpack://app/./src/components/LicenseHeader/style.scss","webpack://app/./src/components/LicenseNavigation/style.scss","webpack://app/./src/components/LicenseContent/style.scss","webpack://app/./src/components/LicenseFooter/style.scss"],"sourcesContent":["$primary_font : 'DM Sans',sans-serif;\r\n$secondary_font : 'Roboto',sans-serif;\r\n$primary_color : #3E5AFA;\r\n$secondary_color : #7A45FD;\r\n$white_color: #FFFFFF;\r\n$primary_text_color: #13263D;\r\n$secondary_text_color: rgba(19, 38, 61, 0.65);\r\n$paragraph_color: rgba(19, 38, 61, 0.75);\n:global(#acoofm_ui_root) {\r\n\t* {\r\n\t\tbox-sizing: border-box;\r\n\t}\r\n\ta {\r\n\t\toutline: none;\r\n\t\tbox-shadow: none;\r\n\t\ttext-decoration: none;\r\n\t\t&:focus,\r\n\t\t&:active,\r\n\t\t&:visited {\r\n\t\t\toutline: none;\r\n\t\t\tbox-shadow: none;\r\n\t\t}\r\n\t}\r\n}\r\n:global(.acoofm_loader) {\r\n\twidth: 100%;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    flex-wrap: wrap;\r\n    margin-top: 15vh;\r\n\th1 {\r\n\t\twidth: 100%;\r\n\t\ttext-align: center;\r\n\t}\r\n\tp {\r\n\t\twidth: 100%;\r\n\t\ttext-align: center;\r\n\t}\r\n}\r\n:global(.toplevel_page_acoofm-admin-ui #wpbody-content) {\r\n\tpadding-top: 78px;\r\n}\r\n:global(.react-select-configure-container .react-select-configure__control) {\r\n\twidth: 100%;\r\n\tbackground: #fafafa;\r\n\tborder: 1px solid rgba(19, 38, 61, 0.14);\r\n\tbox-sizing: border-box;\r\n\tborder-radius: 6px;\r\n\theight: 50px;\r\n\toutline: none;\r\n\tpadding: 0 15px;\r\n\tfont-family: $primary_font;\r\n\tfont-style: normal;\r\n\tfont-weight: normal;\r\n\tfont-size: 16px;\r\n\tline-height: 21px;\r\n\t/* identical to box height */\r\n\r\n\tcolor: $paragraph_color;\r\n}\r\n:global(.react-select-configure-container .react-select-configure__control.react-select-configure__control--is-focused) {\r\n\t