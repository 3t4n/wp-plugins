/**
 * #.# Styles
 *
 * CSS for Backend Post-Type Meta 'quote'.
 */

#quote-meta .form-row {
    color: #666;
    margin-bottom: 10px;
}

#quote-meta .form-row input {
    width: 100%;
}

#quote-meta .form-row:last-child {
    margin-bottom: 0;
}

.la-rating-stars {
    max-width: 300px;
}

.column-quote_rating .la-rating-stars {
    float: left;
    width: 90px;
    margin-right: 5%;
}

.column-quote_rating span {
    white-space: nowrap;
}