#searchform, .searchform {display: none;}

input[type="button"].fueto_button_search
, input[type="submit"].fueto_button_search
, input[type="button"].fueto_button_search:hover
, input[type="submit"].fueto_button_search:hover
    {border: 0px none !important; background-color: transparent !important; border-radius: 0 !important; border: 0px none !important;}

.fueto_search_box{padding: 5px; height: 34px; border: 1px solid #afafaf; background-color: #cbcbcb; overflow: hidden; margin: auto;}

    .fueto_search_box .fueto_input_box{ border: 0px none; float:left; margin: 0px; background-color: #FFFFFF; position: relative;}

		.fueto_search_box .fueto_input_box a{float:left;}
		.fueto_search_box .fueto_input_box .magnifying-glass{background: url('../images/background-magnifying-glass.jpg') no-repeat #FFFFFF; float:left; width:28px; height:31px; background-position: center center; background-size: 28px;}
		.fueto_search_box .fueto_input_box a.fueto-bee{display: block; position: absolute; top:11px; right: 5px; width: 35px; height: 12px;}
        .fueto_search_box .fueto_input_box a.fueto-bee span.fueto-bee{display: block;background: url('../images/background-fueto-bee.png') no-repeat #FFFFFF; background-position: center center; width: 35px; height: 12px;}
		.fueto_search_box .fueto_input_box input{background: #FFFFFF; height: 34px; line-height: 34px; border: 0px none; font-family: Arial; font-size: 18px; padding: 0px 38px 0 5px; margin: 0px; float: left; font-weight: normal; color: #6c6c6c;}

.fueto_search_box .fueto_btn_search{display: block; width: 59px; float: right; margin: 0; text-decoration: none !important;}

.fueto_button_search{background: url('../images/btn_search.png') no-repeat transparent !important; margin: 0 0 0 5px; margin-top: -1px; padding: 0; width: 59px; height: 40px; border: 0px none; cursor: pointer;}

.ui-autocomplete{border-radius: 0 !important; border: 1px solid #7f9db9 !important; padding: 0 !important; font-size: 12px !important; font-family: 'Arial' !important; /*overflow: hidden;*/}

.ui-autocomplete .ui-corner-all{border-radius: 0 !important;}

.ui-menu-item:first-child{border-top: 0px none;}
.ui-menu-item{border-top: 1px solid #7F9DB9;}

.ui-state-hover, .ui-widget-content .ui-state-hover, .ui-widget-header .ui-state-hover, .ui-state-focus, .ui-widget-content .ui-state-focus, .ui-widget-header .ui-state-focus
{background-image: none !important; background-color: #3399ff !important; color: #FFF !important;border: 0 none !important; margin: 0 !important;}
