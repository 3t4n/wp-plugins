.gs_beh_theme3 .beh-tit-cat, .gs_beh_theme5 .beh-tit-cat, .gs_beh_theme6 .beh-tit-cat, .beh-widget-projects .beh-tit-cat, .gs_beh_theme7 .beh-tit-cat, .gs_beh_theme3_style3 .beh-tit-cat {
