}

.gs_beh_popup .beh-cat, .gs_beh_popup .beh-stat {
  margin: 10px 0;
  padding: 0;
}

.gs_beh_popup .beh-cat li:before {
  font-family: "FontAwesome";
  content: "\f046";
  margin: 0 5px 0 0;
  color: rgba(5, 134, 211, 0.7);
}

.gs_beh_popup .beh-cat i:after {
