jQuery(window).bind('load', function(){
    jQuery(".editor-post-publish-button").hide();
    jQuery(".submit").hide();
    jQuery(".view-grid").hide();
    jQuery(".components-icon-button").hide();
    jQuery(".edit-post-sidebar").hide();
    jQuery(".page-title-action").hide();
    jQuery(".wc-shipping-zone-add-method").prop('disabled',true);    
    jQuery(".insert-media").prop('disabled',true);    
    jQuery(".upload_image_button").prop('disabled',true);    
    jQuery(".editor-post-switch-to-draft").prop('disabled',true);    
    jQuery(".components-notice-list").hide();   
    jQuery(".edit-post-header").hide();   
    jQuery(".upload_image_button").hide();    
    jQuery("#template").hide();    
    jQuery(".export_csv").css("pointer-events","none");
    jQuery(".woocommerce-settings__actions").css("pointer-events","none");
    jQuery(".table.wc_input_table .button, table.wc_tax_rates .button").css("pointer-events","none");
    
    // jQuery(".woocommerce-settings__actions").on("click",function(){
    //     window.alert = function() {};
    //     window.location.href =  '?page=error-404.php';
    //     return false;
    // });

    
    
});