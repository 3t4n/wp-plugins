.wp-block-create-block-sp-youtube-channel .ap-url-with-submit{-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;display:flex;margin:0 auto;position:relative}.wp-block-create-block-sp-youtube-channel .ap-url-with-submit .components-base-control{height:74px;width:100%}.wp-block-create-block-sp-youtube-channel .ap-url-with-submit input{border-color:#464646!important;padding:10px 145px 10px 20px;width:100%}.wp-block-create-block-sp-youtube-channel .ap-url-with-submit input:focus{border-color:#464646!important;box-shadow:none!important}.wp-block-create-block-sp-youtube-channel .ap-url-with-submit button{background:#030303;border:none;border-color:transparent!important;box-shadow:none!important;color:#fff;position:absolute;right:0;top:25px}.wp-block-create-block-sp-youtube-channel .ap-url-with-submit button:focus{border-color:transparent!important;box-shadow:none!important}.wp-block-create-block-sp-youtube-channel .ap-url-with-submit button:active{background:#464646!important;color:#fff!important}.wp-block-create-block-sp-youtube-channel .ap-url-with-submit button:hover{color:#fff!important}
