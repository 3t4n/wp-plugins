.button {
  margin-top: 10px;
  padding: 10px 20px;
  background-color: #007cba;
  color: #fff;
  font-size: 16px;
  font-weight: bold;
  border: none;
  cursor: pointer;
}
.button:hover {
  background-color: #005b8f;
}
.clean {
  margin: 0 5px !important;
}
.button-danger {
  background: red !important;
  color: white !important;
}

.tab-content {
  display: none;
}

.tab-content-active {
  display: block;
}