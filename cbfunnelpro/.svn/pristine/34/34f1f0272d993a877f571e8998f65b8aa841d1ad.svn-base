}

.button-red{
	
	background-color:;
	border-color:red;
	color:white;
	opacity:.7;
	padding:5px;
	padding-inline: 6px;
	border-radius:3px;
	box-sizing: border-box;
	
}

.button-red:hover{
	opacity:1;
	cursor:pointer;
	
	
}

.button-grey{
	
