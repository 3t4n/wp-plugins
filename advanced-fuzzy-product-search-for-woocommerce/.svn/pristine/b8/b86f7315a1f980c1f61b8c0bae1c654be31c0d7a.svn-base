#afswFieldsList {
	padding-top: 20px;
}
.woobewoo-table-list table th {
	text-align: left !important;
	border-bottom: 1px solid #dcdcdc !important;
	/*color: #ff5722;*/
}
.woobewoo-table-list table td {
	padding-left: 18px !important;
	text-align: left !important;
}
.woobewoo-table-list table td.dt-center {
	text-align: center !important;
}
.woobewoo-table-list table {
	border-bottom: 1px solid #dcdcdc !important;
}
.woobewoo-table-list .dataTables_length {
	line-height: 30px;
}
.woobewoo-nowrap {
	white-space: nowrap;
}
.ui-widget-overlay {
	background: black !important;
	opacity: 0.3;
}
/* jQuery UI Dialog */
.woobewoo-plugin .ui-dialog-titlebar {
	background-color: #ff5722;
	color: #ffffff !important;
	line-height: normal;
	padding: 15px 20px !important;
	height: auto;
	border: 0;
	border-radius: 0;
	font-size: 22px;
	font-weight: bold;
}
.woobewoo-plugin .ui-dialog-buttonpane {
	background-color: #ff5722 !important;
	padding: 0 20px !important;
}
.woobewoo-plugin .ui-dialog-buttonpane button {
	background-color: #ffffff !important;
	color: #ff5722 !important;
	height: 40px;
	min-height: 40px;
	font-size: 18px;
	padding: 0 10px;
	border-radius: 0 !important;
	box-shadow: none;
	line-height: 35px;
	font-weight: bold !important;
	border: none;
	margin-right: 0 !important;
	margin-left: 10px;
}
.woobewoo-plugin.ui-dialog-buttons {
	padding: 0;
	border: 0 !important;
	border-radius: 0 !important;
}
.woobewoo-plugin .ui-dialog-buttonpane button:disabled {
	cursor: not-allowed;
}
.woobewoo-plugin .ui-dialog-content {
	margin: 10px 0;
	10px 20px !important;
}
.woobewoo-plugin .ui-dialog-titlebar-close {
	right: 20px !important;
	color: transparent;
	outline: none;
	background: transparent;
	border: 0;
}
.woobewoo-plugin .ui-icon-closethick {
	color: #ffffff !important;
	font-size: 20px;
	height: 20px;
	width: 20px;
	background-image: none !important;
	font-family: 'FontAwesome';
	text-indent: 0;
}
.woobewoo-plugin .ui-icon-closethick:before {
	content: "\f00d";
}
.afsw-action-off {
	color: #FF5722 !important;
}
.afsw-action-on {
	color: #11d411 !important;
}
