/**
 * All of the CSS for your admin-specific functionality should be
 * included in this file.
 */

 select option:disabled{
	background-color:#ccc;
}

.bootstrap-wrapper .select2-selection__choice {
    background: #ee6443 !important;
    padding: 7px !important;
    color: #fff;
}

#pisol-cdrw-notices{
    background:#fff;
}

#pisol-cdrw-notices .pi-cdrw-notice{
    padding:10px;
    margin:0px !important;
    font-weight:bold;
}


#pisol-cdrw-notices .pi-cdrw-notice.success{
    background:#4caf50;
    color:#FFF;
}

#pisol-cdrw-notices .pi-cdrw-notice.error{
    background:#f00;
    color:#FFF;
    border-bottom:1px solid #fff;
}

#pisol-cdrw-new-method.pi-blocked:after{
    content:"Saving...";
    display: flex;
    align-items: center;
    justify-content: center;
    width:100%;
    height:100%;
    top:0px;
    position: absolute;
    background-color: rgba(255,255,255,0.6);
    font-size:18px;
    font-weight:bold;
}

.pi-close-notification{
    position: absolute;
    right:30px;
    cursor:pointer;
}

.jc-bs3-container.container{
    width:400px;
    margin-left:auto;
    margin-right:auto;
}

.jc-bs3-container.container .pi-close-notification{
    display: none;
}

#pisol-cdrw-discount-list-view{
    position: relative;
}

.blocktable:after{
    content:'Processing.....';
    width:100%;
    height:100%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    top:0;
    left:0;
    background-color: rgba(255,255,255,0.6);
    font-size:18px;
    font-weight:bold;
}

.select2-selection__choice{
    background:#ee6443!important;
    color:#fff;
    border:0px !important;
    padding:7px !important;
  }
  
  .select2-selection__choice__remove{
    color:#fff !important;
  }

/**
* Row blocking when field is loading
*/
.pi-block-condition-row{
    position: relative;
}

.pi-block-condition-row:after{
    content:"Loading....";
    color:#000;
    display: flex;
    font-weight:bold;
    justify-content: center;
    align-items: center;
    top:0px;
    left:0px;
    position: absolute;
    width:100%;
    height:100%;
    background:rgba(236, 74, 52, 0.2);
}


.btn .dashicons{
    line-height:1.2;
}

table td:has(.btn) .dashicons{
    line-height:1;
}

.table-striped td{
    vertical-align: middle !important;
}