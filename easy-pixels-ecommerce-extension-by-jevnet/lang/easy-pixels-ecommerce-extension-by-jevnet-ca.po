msgstr "Desactivat"

#: admin/easyPixelsWCAdmin.php:57
msgid "Google Tag Manager tracking"
msgstr "Seguiment de Google Tag Manager"

#: admin/easyPixelsWCAdmin.php:60
msgid "Facebook tracking"
msgstr "Seguiment de Facebook"

#: admin/easyPixelsWCAdmin.php:63
msgid "Google Ads tracking"
