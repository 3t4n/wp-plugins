node.type === 'firecrawl') {\n      return renderFirecrawlMenu(node, nodeName);\n    } else if (node.type === 'extractInformation') {\n      return renderExtractInformationMenu(node, nodeName);\n    } else if (node.type === 'research') {\n      return (\n        <Menu.SubMenu key={node.id} title={`Input from ${nodeName}`}>\n          <Menu.Item key={`${node.id}-content`} onClick={() => onInsert(`[[content] from ${node.id}]`)}>\n            Research Results\n          </Menu.Item>\n          <Menu.Item key={`${node.id}-citations`} onClick={() => onInsert(`[[citations] from ${node.id}]`)}>\n            Source Citations\n          </Menu.Item>\n        </Menu.SubMenu>\n      );\n    } else if (node.type === 'output' && node.data.outputType === 'googleDrive') {\n      return (\n        <Menu.SubMenu key={node.id} title={`Input from ${nodeName}`}>\n          <Menu.Item \n            key={`${node.id}-file-link`} \n            onClick={() => onInsert(`[[file_link] from ${node.id}]`)}\n          >\n            File Link\n          </Menu.Item>\n          <Menu.Item \n            key={`${node.id}-file-name`} \n            onClick={() => onInsert(`[[file_name] from ${node.id}]`)}\n          >\n            File Name\n          </Menu.Item>\n          <Menu.Item \n            key={`${node.id}-file-id`} \n            onClick={() => onInsert(`[[file_id] from ${node.id}]`)}\n          >\n            File ID\n          </Menu.Item>\n        </Menu.SubMenu>\n      );\n    } else {\n      return renderDefaultMenuItem(node, nodeName);\n    }\n  };\n\n  const renderWebhookMenu = (node, nodeName) => (\n    <Menu.SubMenu key={node.id} title={`Input from ${nodeName}`}>\n      {node.data.webhookKeys && node.data.webhookKeys.length > 0 ? (\n        node.data.webhookKeys.map(key => (\n          <Menu.Item key={`${node.id}-${key.key}`} onClick={() => onInsert(`[[${key.key}] from ${node.id}]`)}>\n            {key.key}\n          </Menu.Item>\n        ))\n      ) : (\n        <Menu.Item key={`${node.id}-default`} onClick={() => onInsert(`[Input from ${node.id}]`)}>\n          Webhook Data\n        </Menu.Item>\n      )}\n    </Menu.SubMenu>\n  );\n\n  const renderGravityFormsMenu = (node, nodeName) => (\n    <Menu.SubMenu key={node.id} title={`Input from ${nodeName}`}>\n      {node.data.selectedFields.map(field => (\n        <Menu.Item key={`${node.id}-${field.id}`} onClick={() => onInsert(`[[${field.label}] from ${node.id}]`)}>\n          {field.label}\n        </Menu.Item>\n      ))}\n    </Menu.SubMenu>\n  );\n\n  const renderWpCoreMenu = (node, nodeName) => {\n    const wpCoreFields = getWpCoreFields(node.data.selectedWpCoreTrigger);\n    return (\n      <Menu.SubMenu key={node.id} title={`Input from ${nodeName}`}>\n        {wpCoreFields.map(field => (\n          <Menu.Item key={`${node.id}-${field}`} onClick={() => onInsert(`[[${field}] from ${node.id}]`)}>\n            {field}\n          </Menu.Item>\n        ))}\n      </Menu.SubMenu>\n    );\n  };\n\n  const renderRSSMenu = (node, nodeName) => (\n    <Menu.SubMenu key={node.id} title={`Input from ${nodeName}`}>\n      <Menu.SubMenu key={`${node.id}-latest`} title=\"Latest Item\">\n        <Menu.Item key={`${node.id}-latest-title`} onClick={() => onInsert(`[[latest.title] from ${node.id}]`)}>\n          Title\n        </Menu.Item>\n        <Menu.Item key={`${node.id}-latest-link`} onClick={() => onInsert(`[[latest.link] from ${node.id}]`)}>\n          Link\n        </Menu.Item>\n        <Menu.Item key={`${node.id}-latest-description`} onClick={() => onInsert(`[[latest.description] from ${node.id}]`)}>\n          Description\n        </Menu.Item>\n        <Menu.Item key={`${node.id}-latest-media`} onClick={() => onInsert(`[[latest.media_url] from ${node.id}]`)}>\n          Media URL\n        </Menu.Item>\n        <Menu.Item key={`${node.id}-latest-pubDate`} onClick={() => onInsert(`[[latest.pubDate] from ${node.id}]`)}>\n          Publication Date\n        </Menu.Item>\n      </Menu.SubMenu>\n      <Menu.SubMenu key={`${node.id}-feed`} title=\"Feed Info\">\n        <Menu.Item key={`${node.id}-feed-title`} onClick={() => onInsert(`[[feed_title] from ${node.id}]`)}>\n          Feed Title\n        </Menu.Item>\n        <Menu.Item key={`${node.id}-feed-description`} onClick={() => onInsert(`[[feed_description] from ${node.id}]`)}>\n          Feed Description\n        </Menu.Item>\n        <Menu.Item key={`${node.id}-feed-link`} onClick={() => onInsert(`[[feed_link] from ${node.id}]`)}>\n          Feed Link\n        </Menu.Item>\n      </Menu.SubMenu>\n      <Menu.SubMenu key={`${node.id}-items`} title=\"All Items\">\n        <Menu.Item key={`${node.id}-items-all`} onClick={() => onInsert(`[[items] from ${node.id}]`)}>\n          All Items\n        </Menu.Item>\n      </Menu.SubMenu>\n    </Menu.SubMenu>\n  );\n\n  const renderExtractInformationMenu = (node, nodeName) => (\n    <Menu.SubMenu key={node.id} title={`Input from ${nodeName}`}>\n      {node.data.extractionFields.map(field => (\n        <Menu.Item \n          key={`${node.id}-${field.name}`} \n          onClick={() => onInsert(`[[${field.name}] from ${node.id}]`)}\n        >\n          {field.name} {field.isList ? '(List)' : ''}\n        </Menu.Item>\n      ))}\n    </Menu.SubMenu>\n  );\n\n  const renderFirecrawlMenu = (node, nodeName) => (\n    <Menu.SubMenu key={node.id} title={`Input from ${nodeName}`}>\n      <Menu.Item key={`${node.id}-content`} onClick={() => onInsert(`[Input from ${node.id}]`)}>\n        Full Content\n      </Menu.Item>\n      {node.data.format === 'extract' && node.data.extractFields && (\n        <Menu.SubMenu key={`${node.id}-extract`} title=\"Extracted Data\">\n          {node.data.extractFields.map(field => (\n            <Menu.Item \n              key={`${node.id}-${field.name}`} \n              onClick={() => onInsert(`[[extract.website.${field.name}] from ${node.id}]`)}\n            >\n              {field.name} ({field.type})\n            </Menu.Item>\n          ))}\n        </Menu.SubMenu>\n      )}\n    </Menu.SubMenu>\n  );\n\n  const renderDefaultMenuItem = (node, nodeName) => (\n    <Menu.Item key={node.id} onClick={() => onInsert(`[Input from ${node.id}]`)}>\n      Input from {nodeName}\n    </Menu.Item>\n  );\n\n  const getWpCoreFields = (triggerType) => {\n    switch (triggerType) {\n      case 'publish_post':\n        return ['post_id', 'post_type', 'post_title', 'post_content', 'post_excerpt', 'post_author', 'post_date', 'post_status', 'post_categories', 'post_tags', 'post_url'];\n      case 'user_register':\n        return ['user_id', 'user_login', 'user_email', 'user_registered', 'display_name', 'first_name', 'last_name', 'user_role'];\n      case 'wp_insert_comment':\n        return ['comment_id', 'comment_post_id', 'comment_author', 'comment_author_email', 'comment_author_url', 'comment_content', 'comment_type', 'comment_parent', 'user_id', 'comment_date', 'comment_approved', 'post_type'];\n      case 'wp_login':\n        return ['user_id', 'user_login', 'user_email', 'display_name', 'user_role'];\n      case 'transition_post_status':\n        return ['post_id', 'post_type', 'post_title', 'post_content', 'post_excerpt', 'post_categories', 'post_tags', 'post_author', 'old_status', 'new_status', 'post_date', 'post_modified', 'post_url'];\n      default:\n        return [];\n    }\n  };\n\n  const menu = (\n    <Menu>\n      {/* First render custom inputs if provided */}\n      {customInputs && customInputs.map(input => (\n        <Menu.Item \n          key={`custom-${input.key}`} \n          onClick={() => onInsert(input.value)}\n        >\n          {input.label}\n        </Menu.Item>\n      ))}\n      {/* Then render the regular node inputs */}\n      {previousNodes.map(node => renderMenuItem(node))}\n    </Menu>\n  );\n\n  const dynamicVariablesMenu = (\n    <Menu>\n      <Menu.SubMenu key=\"datetime\" icon={<ClockCircleOutlined />} title=\"Date & Time\">\n        <Menu.Item key=\"current_date\" onClick={() => onInsert(\"{{current_date}}\")}>\n          Current Date (YYYY-MM-DD)\n        </Menu.Item>\n        <Menu.Item key=\"current_time\" onClick={() => onInsert(\"{{current_time}}\")}>\n          Current Time (HH:mm:ss)\n        </Menu.Item>\n        <Menu.Item key=\"current_datetime\" onClick={() => onInsert(\"{{current_datetime}}\")}>\n          Current Date & Time\n        </Menu.Item>\n        <Menu.Item key=\"current_timestamp\" onClick={() => onInsert(\"{{current_timestamp}}\")}>\n          Current Timestamp\n        </Menu.Item>\n        <Menu.Item key=\"yesterday\" onClick={() => onInsert(\"{{yesterday}}\")}>\n          Yesterday's Date\n        </Menu.Item>\n        <Menu.Item key=\"tomorrow\" onClick={() => onInsert(\"{{tomorrow}}\")}>\n          Tomorrow's Date\n        </Menu.Item>\n        <Menu.Item key=\"current_month\" onClick={() => onInsert(\"{{current_month}}\")}>\n          Current Month Name\n        </Menu.Item>\n        <Menu.Item key=\"current_year\" onClick={() => onInsert(\"{{current_year}}\")}>\n          Current Year\n        </Menu.Item>\n        <Menu.Item key=\"current_day\" onClick={() => onInsert(\"{{current_day}}\")}>\n          Current Day Name\n        </Menu.Item>\n      </Menu.SubMenu>\n\n      <Menu.SubMenu key=\"wordpress\" icon={<GlobalOutlined />} title=\"WordPress\">\n        <Menu.Item key=\"site_name\" onClick={() => onInsert(\"{{site_name}}\")}>\n          Site Name\n        </Menu.Item>\n        <Menu.Item key=\"site_url\" onClick={() => onInsert(\"{{site_url}}\")}>\n          Site URL\n        </Menu.Item>\n        <Menu.Item key=\"admin_email\" onClick={() => onInsert(\"{{admin_email}}\")}>\n          Admin Email\n        </Menu.Item>\n\n        <Menu.Divider />\n        <Menu.ItemGroup title=\"Current Post/Page\">\n          <Menu.Item key=\"post_id\" onClick={() => onInsert(\"{{post_id}}\")}>\n            Post/Page ID\n          </Menu.Item>\n          <Menu.Item key=\"post_title\" onClick={() => onInsert(\"{{post_title}}\")}>\n            Post/Page Title\n          </Menu.Item>\n          <Menu.Item key=\"post_excerpt\" onClick={() => onInsert(\"{{post_excerpt}}\")}>\n            Post Excerpt\n          </Menu.Item>\n          <Menu.Item key=\"post_content\" onClick={() => onInsert(\"{{post_content}}\")}>\n            Post/Page Content\n          </Menu.Item>\n          <Menu.Item key=\"post_author\" onClick={() => onInsert(\"{{post_author}}\")}>\n            Post Author\n          </Menu.Item>\n          <Menu.Item key=\"post_date\" onClick={() => onInsert(\"{{post_date}}\")}>\n            Publication Date\n          </Menu.Item>\n          <Menu.Item key=\"post_modified_date\" onClick={() => onInsert(\"{{post_modified_date}}\")}>\n            Last Modified Date\n          </Menu.Item>\n          <Menu.Item key=\"post_type\" onClick={() => onInsert(\"{{post_type}}\")}>\n            Post Type\n          </Menu.Item>\n          <Menu.Item key=\"post_status\" onClick={() => onInsert(\"{{post_status}}\")}>\n            Post Status\n          </Menu.Item>\n          <Menu.Item key=\"post_url\" onClick={() => onInsert(\"{{post_url}}\")}>\n            Post URL\n          </Menu.Item>\n          <Menu.Item key=\"post_categories\" onClick={() => onInsert(\"{{post_categories}}\")}>\n            Categories\n          </Menu.Item>\n          <Menu.Item key=\"post_tags\" onClick={() => onInsert(\"{{post_tags}}\")}>\n            Tags\n          </Menu.Item>\n        </Menu.ItemGroup>\n      </Menu.SubMenu>\n\n      <Menu.SubMenu key=\"user\" icon={<UserOutlined />} title=\"Current User\">\n        <Menu.Item key=\"current_user\" onClick={() => onInsert(\"{{current_user}}\")}>\n          Username\n        </Menu.Item>\n        <Menu.Item key=\"current_user_email\" onClick={() => onInsert(\"{{current_user_email}}\")}>\n          User Email\n        </Menu.Item>\n        <Menu.Item key=\"current_user_id\" onClick={() => onInsert(\"{{current_user_id}}\")}>\n          User ID\n        </Menu.Item>\n      </Menu.SubMenu>\n\n  <Menu.SubMenu key=\"woocommerce\" icon={<ShoppingOutlined />} title=\"WooCommerce\">\n          <Menu.ItemGroup title=\"Current Product\">\n            <Menu.Item key=\"product_id\" onClick={() => onInsert(\"{{product_id}}\")}>\n              Product ID\n            </Menu.Item>\n            <Menu.Item key=\"product_name\" onClick={() => onInsert(\"{{product_name}}\")}>\n              Product Name\n            </Menu.Item>\n            <Menu.Item key=\"product_price\" onClick={() => onInsert(\"{{product_price}}\")}>\n              Current Price\n            </Menu.Item>\n            <Menu.Item key=\"product_regular_price\" onClick={() => onInsert(\"{{product_regular_price}}\")}>\n              Regular Price\n            </Menu.Item>\n            <Menu.Item key=\"product_sale_price\" onClick={() => onInsert(\"{{product_sale_price}}\")}>\n              Sale Price\n            </Menu.Item>\n            <Menu.Item key=\"product_sku\" onClick={() => onInsert(\"{{product_sku}}\")}>\n              SKU\n            </Menu.Item>\n            <Menu.Item key=\"product_stock\" onClick={() => onInsert(\"{{product_stock}}\")}>\n              Stock Quantity\n            </Menu.Item>\n            <Menu.Item key=\"product_stock_status\" onClick={() => onInsert(\"{{product_stock_status}}\")}>\n              Stock Status\n            </Menu.Item>\n            <Menu.Item key=\"product_category\" onClick={() => onInsert(\"{{product_category}}\")}>\n              Product Categories\n            </Menu.Item>\n            <Menu.Item key=\"product_type\" onClick={() => onInsert(\"{{product_type}}\")}>\n              Product Type\n            </Menu.Item>\n            <Menu.Item key=\"product_url\" onClick={() => onInsert(\"{{product_url}}\")}>\n              Product URL\n            </Menu.Item>\n            <Menu.Item key=\"product_rating\" onClick={() => onInsert(\"{{product_rating}}\")}>\n              Average Rating\n            </Menu.Item>\n            <Menu.Item key=\"product_review_count\" onClick={() => onInsert(\"{{product_review_count}}\")}>\n              Review Count\n            </Menu.Item>\n          </Menu.ItemGroup>\n\n          <Menu.ItemGroup title=\"Cart\">\n            <Menu.Item key=\"cart_total\" onClick={() => onInsert(\"{{cart_total}}\")}>\n              Cart Total\n            </Menu.Item>\n            <Menu.Item key=\"cart_subtotal\" onClick={() => onInsert(\"{{cart_subtotal}}\")}>\n              Cart Subtotal\n            </Menu.Item>\n            <Menu.Item key=\"cart_item_count\" onClick={() => onInsert(\"{{cart_item_count}}\")}>\n              Items in Cart\n            </Menu.Item>\n            <Menu.Item key=\"cart_url\" onClick={() => onInsert(\"{{cart_url}}\")}>\n              Cart URL\n            </Menu.Item>\n            <Menu.Item key=\"checkout_url\" onClick={() => onInsert(\"{{checkout_url}}\")}>\n              Checkout URL\n            </Menu.Item>\n          </Menu.ItemGroup>\n        </Menu.SubMenu>\n\n      <Menu.SubMenu key=\"random\" title=\"Random Generators\">\n        <Menu.Item key=\"random_number\" onClick={() => onInsert(\"{{random_number}}\")}>\n          Random Number (0-100)\n        </Menu.Item>\n        <Menu.Item key=\"random_number_1000\" onClick={() => onInsert(\"{{random_number_1000}}\")}>\n          Random Number (0-1000)\n        </Menu.Item>\n        <Menu.Item key=\"random_string\" onClick={() => onInsert(\"{{random_string}}\")}>\n          Random String (8 chars)\n        </Menu.Item>\n        <Menu.Item key=\"unique_id\" onClick={() => onInsert(\"{{unique_id}}\")}>\n          Unique ID\n        </Menu.Item>\n      </Menu.SubMenu>\n    </Menu>\n  );\n\n  return (\n    <div style={{ display: 'flex', gap: '8px', marginTop: 8 }}>\n      {/* Existing Input Handler */}\n      {hasInputs ? (\n        <Dropdown overlay={menu} trigger={['click']}>\n          <Tag color=\"success\" style={{ cursor: 'pointer' }}>\n            {(previousNodes.length + (customInputs?.length || 0))} {' '}\n            {(previousNodes.length + (customInputs?.length || 0)) === 1 ? 'Input' : 'Inputs'} Available\n          </Tag>\n        </Dropdown>\n      ) : (\n        <Tag color=\"error\">\n          No Inputs\n        </Tag>\n      )}\n      \n      {/* New Dynamic Variables Button */}\n      <Dropdown overlay={dynamicVariablesMenu} trigger={['click']}>\n        <Tag color=\"orange\" style={{ cursor: 'pointer' }}>\n          <ClockCircleOutlined /> Dynamic Variables\n        </Tag>\n      </Dropdown>\n    </div>\n  );\n};\n\nexport default NodeInputHandler;","import React, { useState, useCallback, useEffect } from 'react';\nimport { Input } from 'antd';\nimport NodeInputHandler from './NodeInputHandler';\n\nconst { TextArea } = Input;\n\nconst GenericNodeContent = ({ id, data, onChange, placeholder }) => {\n  const [content, setContent] = useState(data.content || '');\n  const [cursorPosition, setCursorPosition] = useState(0);\n\n  useEffect(() => {\n    setContent(data.content || '');\n  }, [data.content]);\n\n  const handleContentChange = useCallback((e) => {\n    const newContent = e.target.value;\n    setContent(newContent);\n    onChange(id, { content: newContent });\n    setCursorPosition(e.target.selectionStart);\n  }, [id, onChange]);\n\n  const insertInput = useCallback((inputTag) => {\n    const newContent = \n      content.slice(0, cursorPosition) + \n      inputTag + \n      content.slice(cursorPosition);\n    \n    setContent(newContent);\n    onChange(id, { content: newContent });\n    \n    const newPosition = cursorPosition + inputTag.length;\n    setCursorPosition(newPosition);\n  }, [content, cursorPosition, id, onChange]);\n\n  const handleSelect = useCallback((e) => {\n    setCursorPosition(e.target.selectionStart);\n  }, []);\n\n  return (\n    <>\n      <TextArea\n        className=\"nodrag\"\n        rows={4}\n        placeholder={placeholder || \"Enter content\"}\n        value={content}\n        onChange={handleContentChange}\n        onSelect={handleSelect}\n      />\n      <NodeInputHandler \n        nodeId={id} \n        onInsert={insertInput}\n      />\n    </>\n  );\n};\n\nexport default GenericNodeContent;","import React, { useState, useEffect } from 'react';\nimport { Handle, Position, useNodes } from '@xyflow/react';\nimport { Popconfirm, Card, Select, Button, Input, Space, Typography, Modal, Tooltip, InputNumber, Tabs, Tag } from 'antd';\nimport { \n  DeleteOutlined, \n  PlusOutlined, \n  MinusCircleOutlined, \n  SettingOutlined, \n  InfoCircleOutlined, \n  RobotOutlined,\n  PictureOutlined\n} from '@ant-design/icons';\nimport { Icon } from '@iconify/react';\nimport {\n  Anthropic,\n  DeepSeek,\n  Gemini,\n  Grok,\n  Meta,\n  Mistral,\n  OpenAI,\n  Perplexity\n} from '@lobehub/icons';\nimport GenericNodeContent from '../common/GenericNodeContent';\nimport NodeInputHandler from '../common/NodeInputHandler';\n\nconst { Option, OptGroup } = Select;\nconst { Text } = Typography;\nconst { TabPane } = Tabs;\n\nconst AIModelNode = ({ id, data, isConnectable }) => {\n  const [nodeName, setNodeName] = useState(data.nodeName || `AI Model ${id}`);\n  const [imageUrls, setImageUrls] = useState(data.imageUrls || []);\n  const [activeTab, setActiveTab] = useState('model');\n  const [settings, setSettings] = useState(data.settings || {\n    temperature: 1.0,\n    top_p: 1.0,\n    top_k: 0,\n    frequency_penalty: 0.0,\n    presence_penalty: 0.0,\n    repetition_penalty: 1.0,\n    max_tokens: 4096,\n  });\n  const [content, setContent] = useState(data.content || '');\n  const [isProModalVisible, setIsProModalVisible] = useState(false);\n  const [selectedProModel, setSelectedProModel] = useState(null);\n\n  const nodes = useNodes();\n\n  useEffect(() => {\n    data.updateNodeData(id, { nodeName, imageUrls, settings, content });\n  }, [nodeName, imageUrls, settings, content, id, data]);\n\n  const getModelDisplayName = () => {\n    const model = data.model || 'gpt-4o-mini';\n    const modelName = openAIModels.find(m => m.value === model)?.label || model;\n    return modelName.split(' (')[0];\n  };\n\n  const handleModelChange = (value, option) => {\n    if (option.isPro) {\n      setSelectedProModel(option);\n      setIsProModalVisible(true);\n      return;\n    }\n    data.updateNodeData(id, { model: value });\n    const maxTokens = getMaxTokensForModel(value);\n    setSettings(prev => ({ ...prev, max_tokens: maxTokens }));\n  };\n\n  const handleUpgradeClick = () => {\n    window.open('https://wpaiworkflowautomation.com/pricing', '_blank');\n  };\n\n  const openAIModels = [\n    { value: \"o1\", label: \"o1 (Reasoning model for hard problems)\" },\n    { value: \"o1-mini\", label: \"o1-Mini (Fast, cheap reasoning model for coding, math, science)\" },\n    { value: \"o3-mini\", label: \"o3-Mini (Fast, cheap reasoning model for coding, math, science)\" },\n    { value: \"o3-mini-high\", label: \"o3-Mini-high (Fast reasoning model for coding, math, science)\" },\n    { value: \"gpt-4o\", label: \"GPT-4o (High-intelligence flagship model)\" },\n    { value: \"gpt-4o-mini\", label: \"GPT-4o-mini (Affordable, intelligent small model)\" },\n  ];\n\n  const proModels = {\n    Anthropic: [\n      { value: \"anthropic/claude-3.5-sonnet\", label: \"Claude 3.5 Sonnet\" },\n      { value: \"anthropic/claude-3-5-haiku\", label: \"Claude 3.5 Haiku\" },\n      { value: \"anthropic/claude-3-opus\", label: \"Claude 3 Opus\" },\n      { value: \"anthropic/claude-3-haiku\", label: \"Claude 3 Haiku\" },\n    ],\n    \"Meta Llama\": [\n      { value: \"meta-llama/llama-3.3-70b-instruct\", label: \"Llama 3.3 70B Instruct\" },\n      { value: \"meta-llama/llama-3.2-11b-vision-instruct\", label: \"Llama 3.2 11B Vision Instruct\" },\n    ],\n    Google: [\n      { value: \"google/gemini-2.0-flash-exp\", label: \"Gemini 2.0 Flash\" },\n      { value: \"google/gemini-flash-1.5\", label: \"Gemini Flash 1.5\" },\n    ],\n    Mistral: [\n      { value: \"mistralai/mistral-large-2411\", label: \"Mistral Large\" },\n      { value: \"mistralai/mistral-nemo\", label: \"Mistral Nemo\" },\n    ],\n    xAI: [\n      { value: \"x-ai/grok-2-1212\", label: \"Grok 2\" },\n      { value: \"x-ai/grok-2-vision-1212\", label: \"Grok 2 Vision\" },\n    ],\n    DeepSeek: [\n      { value: \"deepseek/deepseek-r1\", label: \"DeepSeek R1\" },\n      { value: \"deepseek/deepseek-chat\", label: \"DeepSeek V3\" },\n\n    ]\n  };\n\n  const getMaxTokensForModel = (model) => {\n    const tokenLimits = {\n      'gpt-4o': 16384,\n      'gpt-4o-mini': 16384,\n      'o1': 100000,\n      'o1-mini': 65536,\n      'o3-mini': 100000,\n      'o3-mini-high': 100000,\n    };\n    return tokenLimits[model] || 4096;\n  };\n\n  const handleNameChange = (e) => {\n    setNodeName(e.target.value);\n  };\n\n  const handleContentChange = (nodeId, newData) => {\n    setContent(newData.content);\n    data.updateNodeData(nodeId, newData);\n  };\n\n  const handleAddImage = () => {\n    setImageUrls([...imageUrls, '']);\n  };\n\n  const handleImageUrlChange = (index, value) => {\n    const newUrls = [...imageUrls];\n    newUrls[index] = value;\n    setImageUrls(newUrls);\n  };\n\n  const handleRemoveImage = (index) => {\n    const newUrls = imageUrls.filter((_, i) => i !== index);\n    setImageUrls(newUrls);\n  };\n\n  const handleInsertImageTag = (index, tag) => {\n    const newUrls = [...imageUrls];\n    newUrls[index] = newUrls[index] ? newUrls[index] + tag : tag;\n    setImageUrls(newUrls);\n  };\n\n  const handleSettingChange = (setting, value) => {\n    setSettings(prev => ({\n      ...prev,\n      [setting]: value\n    }));\n  };\n\n  const getModelIcon = (provider) => {\n    const iconSize = 20; // Standard size for all icons\n    \n    switch (provider) {\n      case 'OpenAI':\n        return <OpenAI size={iconSize} />;\n      case 'Google':\n        return <Gemini size={iconSize} />;\n      case 'Perplexity':\n        return <Perplexity size={iconSize} />;\n      case 'Mistral':\n        return <Mistral size={iconSize} />;\n      case 'Meta Llama':\n        return <Meta size={iconSize} />;\n      case 'Anthropic':\n        return <Anthropic size={iconSize} />;\n      case 'xAI':\n        return <Grok size={iconSize} />;\n      case 'DeepSeek':\n        return <DeepSeek size={iconSize} />;\n      default:\n        return <RobotOutlined style={{ fontSize: iconSize }} />;\n    }\n  };\n\n  return (\n    <Card \n      title={\n        <Space>\n          <RobotOutlined style={{ fontSize: '18px', color: '#1890ff' }}/>\n          <span>AI Model</span>\n          <Tag color=\"blue\">\n            {getModelDisplayName()}\n          </Tag>\n        </Space>\n      }\n      style={{ width: 380 }}\n      extra={\n        <Space>\n          <Button \n            icon={<SettingOutlined />}\n            type=\"text\"\n            onClick={() => setActiveTab('settings')}\n          />\n          <Popconfirm\n            title=\"Delete Node\"\n            description=\"Are you sure you want to delete this node?\"\n            onConfirm={() => data.onDelete(id)}\n            okText=\"Delete\"\n            cancelText=\"Cancel\"\n            okButtonProps={{ danger: true }}\n          >\n            <Button icon={<DeleteOutlined />} />\n          </Popconfirm>\n        </Space>\n      }\n    >\n      <Handle type=\"target\" position={Position.Left} isConnectable={isConnectable} />\n      \n      <Input\n        placeholder=\"Node Name\"\n        value={nodeName}\n        onChange={handleNameChange}\n        style={{ marginBottom: 16 }}\n        prefix={<InfoCircleOutlined style={{ color: '#bfbfbf' }} />}\n        className=\"nodrag\"\n      />\n\n      <Tabs activeKey={activeTab} onChange={setActiveTab}>\n        <TabPane tab=\"Model\" key=\"model\">\n          <Space direction=\"vertical\" style={{ width: '100%' }}>\n            <Select\n              className=\"nodrag\"\n              style={{ width: '100%', marginBottom: 8 }}\n              value={data.model || 'gpt-4o-mini'}\n              onChange={handleModelChange}\n              onClick={(e) => e.stopPropagation()}\n            >\n              <OptGroup label={\n                <Space>\n                  <OpenAI size={20} />\n                  <span>OpenAI Models</span>\n                </Space>\n              }>\n                {openAIModels.map(model => (\n                  <Option key={model.value} value={model.value}>\n                    <Space>\n                      <OpenAI size={20} />\n                      <Text>{model.label}</Text>\n                    </Space>\n                  </Option>\n                ))}\n              </OptGroup>\n\n              {Object.entries(proModels).map(([provider, models]) => (\n                <OptGroup \n                  key={provider} \n                  label={\n                    <Space>\n                      {getModelIcon(provider)}\n                      <span>{provider} Models (Pro)</span>\n                    </Space>\n                  }\n                >\n                  {models.map(model => (\n                    <Option \n                      key={model.value} \n                      value={model.value}\n                      isPro={true}\n                    >\n                      <Space>\n                        {getModelIcon(provider)}\n                        <Text>{model.label}</Text>\n                        <Text type=\"secondary\" style={{ fontSize: '12px' }}>\n                          (Pro)\n                        </Text>\n                      </Space>\n                    </Option>\n                  ))}\n                </OptGroup>\n              ))}\n            </Select>\n\n            <div style={{ marginTop: 8 }}>\n              <Space align=\"center\" style={{ marginBottom: 4 }}>\n                <Text strong>Prompt</Text>\n                <Tooltip title=\"Enter your prompt for the AI model\">\n                  <InfoCircleOutlined style={{ color: '#bfbfbf' }} />\n                </Tooltip>\n              </Space>\n              <GenericNodeContent \n                id={id} \n                data={data} \n                onChange={handleContentChange}\n                placeholder=\"Enter your prompt here...\"\n                nodes={nodes}\n                gravityFormFields={data.selectedFields}\n              />\n            </div>\n          </Space>\n        </TabPane>\n\n        <TabPane \n          tab={\n            <Space>\n              <PictureOutlined />\n              <span>Images</span>\n            </Space>\n          } \n          key=\"images\"\n        >\n          <Space direction=\"vertical\" style={{ width: '100%' }}>\n            {imageUrls.map((url, index) => (\n              <div \n                key={index} \n                style={{ \n                  padding: '8px',\n                  background: '#f5f5f5',\n                  borderRadius: '6px',\n                  marginBottom: 8\n                }}\n              >\n                <div style={{ marginBottom: 8 }}>\n                  <Input\n                    value={url}\n                    onChange={(e) => handleImageUrlChange(index, e.target.value)}\n                    placeholder=\"Enter image URL or connect from previous node\"\n                    style={{ width: '100%' }}\n                    className=\"nodrag\"\n                  />\n                </div>\n                <div style={{ \n                  display: 'flex',\n                  justifyContent: 'space-between',\n                  alignItems: 'center'\n                }}>\n                  <NodeInputHandler\n                    nodeId={id}\n                    onInsert={(tag) => handleInsertImageTag(index, tag)}\n                  />\n                  <Button \n                    type=\"text\" \n                    icon={<MinusCircleOutlined />} \n                    onClick={() => handleRemoveImage(index)}\n                    danger\n                  />\n                </div>\n              </div>\n            ))}\n            <Button \n              type=\"dashed\" \n              onClick={handleAddImage} \n              block \n              icon={<PlusOutlined />}\n            >\n              Add Image Input\n            </Button>\n          </Space>\n        </TabPane>\n\n        <TabPane tab=\"Settings\" key=\"settings\">\n          <Space direction=\"vertical\" style={{ width: '100%' }}>\n            {Object.entries(settings).map(([key, value]) => (\n              <div key={key} style={{ marginBottom: 16 }}>\n                <Space align=\"center\">\n                  <Text strong>{key.replace('_', ' ').charAt(0).toUpperCase() + key.replace('_', ' ').slice(1)}</Text>\n                  <Tooltip title={getSettingExplanation(key)}>\n                    <InfoCircleOutlined style={{ color: '#bfbfbf' }} />\n                  </Tooltip>\n                </Space>\n                <div style={{ \n                  display: 'flex', \n                  alignItems: 'center',\n                  gap: 8,\n                  marginTop: 4,\n                  padding: 8,\n                  background: '#f5f5f5',\n                  borderRadius: 6\n                }}>\n                  <InputNumber\n                    value={value}\n                    onChange={(newValue) => handleSettingChange(key, newValue)}\n                    step={key === 'max_tokens' ? 1 : 0.1}\n                    min={0}\n                    max={key === 'max_tokens' ? getMaxTokensForModel(data.model) : 2}\n                    style={{ width: 120 }}\n                  />\n                  <Text type=\"secondary\">\n                    {key === 'max_tokens' ? \n                      `(1 to ${getMaxTokensForModel(data.model)})` : \n                      '(0.0 to 2.0)'}\n                  </Text>\n                </div>\n              </div>\n            ))}\n          </Space>\n        </TabPane>\n\n        <TabPane tab=\"Output\" key=\"output\">\n          <Space direction=\"vertical\" style={{ width: '100%' }}>\n            <Text type=\"secondary\">\n              Available outputs from this node:\n            </Text>\n            <div style={{ \n              backgroundColor: '#f5f5f5', \n              padding: '12px', \n              borderRadius: '6px',\n              marginTop: '8px'\n            }}>\n              <Space direction=\"vertical\">\n                <div>\n                  <Text strong>Generated Content</Text>\n                  <div>\n                    <Text code>[Input from {id}]</Text>\n                  </div>\n                </div>\n              </Space>\n            </div>\n          </Space>\n        </TabPane>\n      </Tabs>\n\n      <Modal\n        title=\"Upgrade to Pro\"\n        visible={isProModalVisible}\n        onCancel={() => setIsProModalVisible(false)}\n        footer={[\n          <Button key=\"cancel\" onClick={() => setIsProModalVisible(false)}>\n            Cancel\n          </Button>,\n          <Button \n            key=\"upgrade\" \n            type=\"primary\" \n            onClick={handleUpgradeClick}\n          >\n            Upgrade to Pro\n          </Button>\n        ]}\n      >\n        <Space direction=\"vertical\" style={{ width: '100%' }}>\n          <div style={{ \n            padding: '20px', \n            background: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',\n            borderRadius: '8px',\n            marginBottom: '16px'\n          }}>\n            <Text strong style={{ color: 'white', fontSize: '16px' }}>\n              {selectedProModel?.label}\n            </Text>\n          </div>\n          <Text>\n            This AI model is available exclusively in the Pro version. \n            Upgrade to unlock access to:\n          </Text>\n          <ul style={{ marginLeft: '20px' }}>\n            <li>Advanced AI models from multiple providers</li>\n            <li>Higher token limits and enhanced capabilities</li>\n            <li>Vision and multimodal AI models</li>\n            <li>Priority support and updates</li>\n          </ul>\n        </Space>\n      </Modal>\n\n      <Handle type=\"source\" position={Position.Right} id=\"a\" isConnectable={isConnectable} />\n    </Card>\n  );\n};\n\nconst getSettingExplanation = (setting) => {\n  const explanations = {\n    temperature: \"Influences response variety. Lower values (0.0) give predictable responses, higher values (up to 2.0) encourage diversity.\",\n    top_p: \"Limits token choices to a percentage of likely tokens. Lower values increase predictability, default (1.0) allows full range.\",\n    top_k: \"Limits token choices at each step. Lower values increase predictability, 0 (default) considers all choices.\",\n    frequency_penalty: \"Controls token repetition based on input frequency. Positive values reduce frequent token use, negative values encourage it.\",\n    presence_penalty: \"Adjusts repetition of specific input tokens. Positive values reduce repetition, negative values encourage it.\",\n    repetition_penalty: \"Reduces input token repetition. Higher values (up to 2.0) decrease repetition, but may affect coherence.\",\n    max_tokens: \"Limits the maximum number of tokens in the model's response. Higher values allow for longer outputs but may increase processing time and costs.\",\n  };\n  return explanations[setting] || \"No explanation available.\";\n};\n\nexport default AIModelNode;","import React, { useEffect, useState } from 'react';\nimport { Handle, Position } from '@xyflow/react';\nimport { Card, Input, Select, Typography, Button, Switch, message } from 'antd';\nimport { DeleteOutlined } from '@ant-design/icons';\n\nconst { Option } = Select;\nconst { Paragraph, Text } = Typography;\n\nconst OutputNode = ({ id, data, isConnectable, workflowId }) => {\n  const [nodeName, setNodeName] = useState(data.nodeName || `Output ${id}`);\n  const [displayOutput, setDisplayOutput] = useState(data.displayOutput || \"Output will be displayed here after execution\");\n  const [outputType, setOutputType] = useState(data.outputType || 'display');\n  const [workflowIdState, setWorkflowIdState] = useState(data.workflowId || workflowId);\n\n  useEffect(() => {\n    setDisplayOutput(data.displayOutput || \"Output will be displayed here after execution\");\n  }, [data.displayOutput]);\n\n  \n  useEffect(() => {\n    if (workflowId) {\n      setWorkflowIdState(workflowId);\n    }\n  }, [workflowId]);\n\n  useEffect(() => {\n    if (data.workflowId) {\n      setWorkflowIdState(data.workflowId);\n    }\n  }, [data.workflowId]);\n\n  useEffect(() => {\n    data.updateNodeData(id, {\n      nodeName,\n      outputType,\n      displayOutput,\n      workflowId: workflowIdState,\n    });\n  }, [nodeName, outputType, displayOutput, workflowId]);\n\n\n\n  const renderProFeatureMessage = () => (\n    <div style={{ marginTop: '8px', padding: '8px', backgroundColor: '#f0f0f0', borderRadius: '4px' }}>\n      <Text strong>This is a Pro feature, but you can try it for free for 14 days!</Text>\n      <br />\n      <Button \n        type=\"primary\" \n        size=\"small\" \n        style={{ marginTop: '8px' }}\n        onClick={() => window.open('https://wpaiworkflowautomation.com/pricing?utm_source=freedownload&utm_medium=lite&utm_content=output', '_blank')}\n      >\n        Upgrade to Pro\n      </Button>\n    </div>\n  );\n\n  const renderInstructions = () => {\n    switch (outputType) {\n      case 'display':\n        return \"The output will be displayed here after execution.\";\n      case 'save':\n      case 'googlesheets':\n      case 'googledrive':\n      case 'webhook':\n        return renderProFeatureMessage();\n      case 'html':\n        if (!workflowIdState) {\n          return (\n            <Paragraph>\n              The shortcode will be generated after you save the workflow.\n            </Paragraph>\n          );\n        }\n        return (\n          <>\n            Use this shortcode to display the output on your website:\n            <Paragraph copyable={{ text: `[wp_ai_workflows_output id=\"${workflowIdState}\"]`, onCopy: () => message.success('Shortcode copied') }}>\n              <Text code>{`[wp_ai_workflows_output id=\"${workflowIdState}\"]`}</Text>\n            </Paragraph>\n          </>\n        );\n      default:\n        return \"\";\n    }\n  };\n\n  return (\n    <Card \n      title={\n        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>\n          <span>Output</span>\n        </div>\n      }\n      style={{ width: 400 }}\n      bodyStyle={{ maxHeight: 600, overflowY: 'auto' }}\n      extra={<Button icon={<DeleteOutlined />} onClick={() => data.onDelete(id)} size=\"small\" />}\n    >\n      <Input\n        placeholder=\"Node Name\"\n        value={nodeName}\n        onChange={(e) => setNodeName(e.target.value)}\n        style={{ marginBottom: 8 }}\n        className=\"nodrag\"\n      />\n      <Handle type=\"target\" position={Position.Left} isConnectable={isConnectable} />\n      <Select\n        style={{ width: '100%', marginBottom: 8 }}\n        value={outputType}\n        onChange={setOutputType}\n        className=\"nodrag\"\n      >\n        <Option value=\"display\">Display</Option>\n        <Option value=\"save\">Save to Database (Pro)</Option>\n        <Option value=\"html\">Shortcode</Option>\n        <Option value=\"webhook\">Send to Webhook (Pro)</Option>\n        <Option value=\"googlesheets\">Send to Google Sheets (Pro)</Option>\n        <Option value=\"googledrive\">Send to Google Drive (Pro)</Option>\n      </Select>\n      <div style={{ marginBottom: 8 }}>\n        {renderInstructions()}\n      </div>\n      <Input.TextArea\n        rows={4}\n        value={displayOutput}\n        readOnly\n        className=\"nodrag\"\n      />\n      <Handle type=\"source\" position={Position.Right} id=\"a\" isConnectable={isConnectable} />\n    </Card>\n  );\n};\n\nexport default OutputNode;","import * as React from 'react';\nexport default function useDebounce(value) {\n  const [cacheValue, setCacheValue] = React.useState(value);\n  React.useEffect(() => {\n    const timeout = setTimeout(() => {\n      setCacheValue(value);\n    }, value.length ? 0 : 10);\n    return () => {\n      clearTimeout(timeout);\n    };\n  }, [value]);\n  return cacheValue;\n}","const genFormValidateMotionStyle = token => {\n  const {\n    componentCls\n  } = token;\n  const helpCls = `${componentCls}-show-help`;\n  const helpItemCls = `${componentCls}-show-help-item`;\n  return {\n    [helpCls]: {\n      // Explain holder\n      transition: `opacity ${token.motionDurationFast} ${token.motionEaseInOut}`,\n      '&-appear, &-enter': {\n        opacity: 0,\n        '&-active': {\n          opacity: 1\n        }\n      },\n      '&-leave': {\n        opacity: 1,\n        '&-active': {\n          opacity: 0\n        }\n      },\n      // Explain\n      [helpItemCls]: {\n        overflow: 'hidden',\n        transition: `height ${token.motionDurationFast} ${token.motionEaseInOut},\n                     opacity ${token.motionDurationFast} ${token.motionEaseInOut},\n                     transform ${token.motionDurationFast} ${token.motionEaseInOut} !important`,\n        [`&${helpItemCls}-appear, &${helpItemCls}-enter`]: {\n          transform: `translateY(-5px)`,\n          opacity: 0,\n          '&-active': {\n            transform: 'translateY(0)',\n            opacity: 1\n          }\n        },\n        [`&${helpItemCls}-leave-active`]: {\n          transform: `translateY(-5px)`\n        }\n      }\n    }\n  };\n};\nexport default genFormValidateMotionStyle;","import { unit } from '@ant-design/cssinjs';\nimport { resetComponent } from '../../style';\nimport { genCollapseMotion, zoomIn } from '../../style/motion';\nimport { genStyleHooks, mergeToken } from '../../theme/internal';\nimport genFormValidateMotionStyle from './explain';\nconst resetForm = token => ({\n  legend: {\n    display: 'block',\n    width: '100%',\n    marginBottom: token.marginLG,\n    padding: 0,\n    color: token.colorTextDescription,\n    fontSize: token.fontSizeLG,\n    lineHeight: 'inherit',\n    border: 0,\n    borderBottom: `${unit(token.lineWidth)} ${token.lineType} ${token.colorBorder}`\n  },\n  'input[type=\"search\"]': {\n    boxSizing: 'border-box'\n  },\n  // Position radios and checkboxes better\n  'input[type=\"radio\"], input[type=\"checkbox\"]': {\n    lineHeight: 'normal'\n  },\n  'input[type=\"file\"]': {\n    display: 'block'\n  },\n  // Make range inputs behave like textual form controls\n  'input[type=\"range\"]': {\n    display: 'block',\n    width: '100%'\n  },\n  // Make multiple select elements height not fixed\n  'select[multiple], select[size]': {\n    height: 'auto'\n  },\n  // Focus for file, radio, and checkbox\n  [`input[type='file']:focus,\n  input[type='radio']:focus,\n  input[type='checkbox']:focus`]: {\n    outline: 0,\n    boxShadow: `0 0 0 ${unit(token.controlOutlineWidth)} ${token.controlOutline}`\n  },\n  // Adjust output element\n  output: {\n    display: 'block',\n    paddingTop: 15,\n    color: token.colorText,\n    fontSize: token.fontSize,\n    lineHeight: token.lineHeight\n  }\n});\nconst genFormSize = (token, height) => {\n  const {\n    formItemCls\n  } = token;\n  return {\n    [formItemCls]: {\n      [`${formItemCls}-label > label`]: {\n        height\n      },\n      [`${formItemCls}-control-input`]: {\n        minHeight: height\n      }\n    }\n  };\n};\nconst genFormStyle = token => {\n  const {\n    componentCls\n  } = token;\n  return {\n    [token.componentCls]: Object.assign(Object.assign(Object.assign({}, resetComponent(token)), resetForm(token)), {\n      [`${componentCls}-text`]: {\n        display: 'inline-block',\n        paddingInlineEnd: token.paddingSM\n      },\n      // ================================================================\n      // =                             Size                             =\n      // ================================================================\n      '&-small': Object.assign({}, genFormSize(token, token.controlHeightSM)),\n      '&-large': Object.assign({}, genFormSize(token, token.controlHeightLG))\n    })\n  };\n};\nconst genFormItemStyle = token => {\n  const {\n    formItemCls,\n    iconCls,\n    componentCls,\n    rootPrefixCls,\n    antCls,\n    labelRequiredMarkColor,\n    labelColor,\n    labelFontSize,\n    labelHeight,\n    labelColonMarginInlineStart,\n    labelColonMarginInlineEnd,\n    itemMarginBottom\n  } = token;\n  return {\n    [formItemCls]: Object.assign(Object.assign({}, resetComponent(token)), {\n      marginBottom: itemMarginBottom,\n      verticalAlign: 'top',\n      '&-with-help': {\n        transition: 'none'\n      },\n      [`&-hidden,\n        &-hidden${antCls}-row`]: {\n        // https://github.com/ant-design/ant-design/issues/26141\n        display: 'none'\n      },\n      '&-has-warning': {\n        [`${formItemCls}-split`]: {\n          color: token.colorError\n        }\n      },\n      '&-has-error': {\n        [`${formItemCls}-split`]: {\n          color: token.colorWarning\n        }\n      },\n      // ==============================================================\n      // =                            Label                           =\n      // ==============================================================\n      [`${formItemCls}-label`]: {\n        flexGrow: 0,\n        overflow: 'hidden',\n        whiteSpace: 'nowrap',\n        textAlign: 'end',\n        verticalAlign: 'middle',\n        '&-left': {\n          textAlign: 'start'\n        },\n        '&-wrap': {\n          overflow: 'unset',\n          lineHeight: token.lineHeight,\n          whiteSpace: 'unset'\n        },\n        '> label': {\n          position: 'relative',\n          display: 'inline-flex',\n          alignItems: 'center',\n          maxWidth: '100%',\n          height: labelHeight,\n          color: labelColor,\n          fontSize: labelFontSize,\n          [`> ${iconCls}`]: {\n            fontSize: token.fontSize,\n            verticalAlign: 'top'\n          },\n          // Required mark\n          [`&${formItemCls}-required:not(${formItemCls}-required-mark-optional)::before`]: {\n            display: 'inline-block',\n            marginInlineEnd: token.marginXXS,\n            color: labelRequiredMarkColor,\n            fontSize: token.fontSize,\n            fontFamily: 'SimSun, sans-serif',\n            lineHeight: 1,\n            content: '\"*\"',\n            [`${componentCls}-hide-required-mark &`]: {\n              display: 'none'\n            }\n          },\n          // Optional mark\n          [`${formItemCls}-optional`]: {\n            display: 'inline-block',\n            marginInlineStart: token.marginXXS,\n            color: token.colorTextDescription,\n            [`${componentCls}-hide-required-mark &`]: {\n              display: 'none'\n            }\n          },\n          // Optional mark\n          [`${formItemCls}-tooltip`]: {\n            color: token.colorTextDescription,\n            cursor: 'help',\n            writingMode: 'horizontal-tb',\n            marginInlineStart: token.marginXXS\n          },\n          '&::after': {\n            content: '\":\"',\n            position: 'relative',\n            marginBlock: 0,\n            marginInlineStart: labelColonMarginInlineStart,\n            marginInlineEnd: labelColonMarginInlineEnd\n          },\n          [`&${formItemCls}-no-colon::after`]: {\n            content: '\"\\\\a0\"'\n          }\n        }\n      },\n      // ==============================================================\n      // =                            Input                           =\n      // ==============================================================\n      [`${formItemCls}-control`]: {\n        ['--ant-display']: 'flex',\n        flexDirection: 'column',\n        flexGrow: 1,\n        [`&:first-child:not([class^=\"'${rootPrefixCls}-col-'\"]):not([class*=\"' ${rootPrefixCls}-col-'\"])`]: {\n          width: '100%'\n        },\n        '&-input': {\n          position: 'relative',\n          display: 'flex',\n          alignItems: 'center',\n          minHeight: token.controlHeight,\n          '&-content': {\n            flex: 'auto',\n            maxWidth: '100%'\n          }\n        }\n      },\n      // ==============================================================\n      // =                           Explain                          =\n      // ==============================================================\n      [formItemCls]: {\n        '&-additional': {\n          display: 'flex',\n          flexDirection: 'column'\n        },\n        '&-explain, &-extra': {\n          clear: 'both',\n          color: token.colorTextDescription,\n          fontSize: token.fontSize,\n          lineHeight: token.lineHeight\n        },\n        '&-explain-connected': {\n          width: '100%'\n        },\n        '&-extra': {\n          minHeight: token.controlHeightSM,\n          transition: `color ${token.motionDurationMid} ${token.motionEaseOut}` // sync input color transition\n        },\n        '&-explain': {\n          '&-error': {\n            color: token.colorError\n          },\n          '&-warning': {\n            color: token.colorWarning\n          }\n        }\n      },\n      [`&-with-help ${formItemCls}-explain`]: {\n        height: 'auto',\n        opacity: 1\n      },\n      // ==============================================================\n      // =                        Feedback Icon                       =\n      // ==============================================================\n      [`${formItemCls}-feedback-icon`]: {\n        fontSize: token.fontSize,\n        textAlign: 'center',\n        visibility: 'visible',\n        animationName: zoomIn,\n        animationDuration: token.motionDurationMid,\n        animationTimingFunction: token.motionEaseOutBack,\n        pointerEvents: 'none',\n        '&-success': {\n          color: token.colorSuccess\n        },\n        '&-error': {\n          color: token.colorError\n        },\n        '&-warning': {\n          color: token.colorWarning\n        },\n        '&-validating': {\n          color: token.colorPrimary\n        }\n      }\n    })\n  };\n};\nconst genHorizontalStyle = (token, className) => {\n  const {\n    formItemCls\n  } = token;\n  return {\n    [`${className}-horizontal`]: {\n      [`${formItemCls}-label`]: {\n        flexGrow: 0\n      },\n      [`${formItemCls}-control`]: {\n        flex: '1 1 0',\n        // https://github.com/ant-design/ant-design/issues/32777\n        // https://github.com/ant-design/ant-design/issues/33773\n        minWidth: 0\n      },\n      // Do not change this to `ant-col-24`! `-24` match all the responsive rules\n      // https://github.com/ant-design/ant-design/issues/32980\n      // https://github.com/ant-design/ant-design/issues/34903\n      // https://github.com/ant-design/ant-design/issues/44538\n      [`${formItemCls}-label[class$='-24'], ${formItemCls}-label[class*='-24 ']`]: {\n        [`& + ${formItemCls}-control`]: {\n          minWidth: 'unset'\n        }\n      }\n    }\n  };\n};\nconst genInlineStyle = token => {\n  const {\n    componentCls,\n    formItemCls,\n    inlineItemMarginBottom\n  } = token;\n  return {\n    [`${componentCls}-inline`]: {\n      display: 'flex',\n      flexWrap: 'wrap',\n      [formItemCls]: {\n        flex: 'none',\n        marginInlineEnd: token.margin,\n        marginBottom: inlineItemMarginBottom,\n        '&-row': {\n          flexWrap: 'nowrap'\n        },\n        [`> ${formItemCls}-label,\n        > ${formItemCls}-control`]: {\n          display: 'inline-block',\n          verticalAlign: 'top'\n        },\n        [`> ${formItemCls}-label`]: {\n          flex: 'none'\n        },\n        [`${componentCls}-text`]: {\n          display: 'inline-block'\n        },\n        [`${formItemCls}-has-feedback`]: {\n          display: 'inline-b