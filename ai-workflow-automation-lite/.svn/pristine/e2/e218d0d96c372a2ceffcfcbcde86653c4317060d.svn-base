ailsModal = ({ execution, visible, onClose }) => {\n  const [selectedStep, setSelectedStep] = useState(null);\n\n  if (!execution) return null;\n\n  const transformNodeData = (execution) => {\n    if (!execution) return [];\n    \n    // Define annotation node prefixes to exclude\n    const annotationPrefixes = ['stickyNote-', 'textAnnotation-', 'shape-'];\n\n    // Helper function to check if a node is an annotation\n    const isAnnotationNode = (nodeId) => \n      annotationPrefixes.some(prefix => nodeId.startsWith(prefix));\n\n    // If output_data is already an array of node summaries, use it directly\n    if (Array.isArray(execution.node_summary) && execution.node_summary.length > 0) {\n      // Filter out invalid nodes and annotation nodes\n      return execution.node_summary.filter(node => \n        node && \n        node.node_id && \n        node.node_id.trim() !== '' && \n        node.node_id !== 'undefined' &&\n        !isAnnotationNode(node.node_id)\n      );\n    } \n\n    // Convert output_data object to node_summary array\n    if (typeof execution.output_data === 'string') {\n      try {\n        execution.output_data = JSON.parse(execution.output_data);\n      } catch (e) {\n        return [];\n      }\n    }\n\n    return Object.entries(execution.output_data || {})\n      .filter(([nodeId]) => \n        nodeId && \n        nodeId.trim() !== '' && \n        nodeId !== 'undefined' &&\n        !isAnnotationNode(nodeId)\n      )\n      .map(([nodeId, nodeData]) => ({\n        key: nodeId,\n        node_id: nodeId,\n        status: nodeData.type || 'Unknown',\n        type: nodeData.type,\n        message: nodeData.content || nodeData.message || 'No message'\n      }));\n  };\n\n  const getNodeIcon = (type) => {\n    const icons = {\n      'trigger': <UserOutlined />,\n      'aiModel': <RobotOutlined />,\n      'sendEmail': <MailOutlined />,\n      'unsplash': <FileImageOutlined />,\n      'firecrawl': <GlobalOutlined />,\n      'condition': <BranchesOutlined />,\n      'humanInput': <UserOutlined />,\n      'api': <ApiOutlined />,\n      'database': <DatabaseOutlined />,\n      'output': <FileTextOutlined />,\n      'code': <CodeOutlined />,\n      'research': <SearchOutlined />,\n      'webhook': <LinkOutlined />,\n      'error': <ExclamationCircleOutlined />,\n    };\n    return icons[type] || <InfoCircleOutlined />;\n  };\n\n  const getStatusColor = (status) => {\n    const colors = {\n      'completed': 'green',\n      'processing': 'blue',\n      'scheduled': 'orange',\n      'error': 'red',\n      'trigger': 'blue',\n      'unknown': 'default'\n    };\n    return colors[status?.toLowerCase()] || 'default';\n  };\n\n  const formatData = (data) => {\n    if (!data) return 'No data';\n    if (typeof data === 'string') return data;\n    try {\n      return JSON.stringify(data, null, 2);\n    } catch (e) {\n      return 'Unable to display data';\n    }\n  };\n\n  const formatInputData = (data) => {\n    if (!data) return 'No input data';\n    try {\n      return typeof data === 'string' ? data : JSON.stringify(data, null, 2);\n    } catch (e) {\n      return 'Invalid input data format';\n    }\n  };\n\n  const renderTimeline = () => {\n    const nodes = transformNodeData(execution);\n    \n    return (\n      <Timeline style={{ padding: '20px' }}>\n        {nodes.map((node, index) => (\n          <Timeline.Item\n            key={node.key || index}\n            dot={getNodeIcon(node.type)}\n            color={getStatusColor(node.status)}\n          >\n            <Card\n              size=\"small\"\n              style={{ \n                marginBottom: 16,\n                backgroundColor: node.status === 'error' ? '#fff1f0' : '#f6ffed',\n                borderColor: node.status === 'error' ? '#ffa39e' : '#b7eb8f'\n              }}\n            >\n              <Space direction=\"vertical\" style={{ width: '100%' }}>\n                <Space>\n                  <Text strong>{node.node_id}</Text>\n                  <Tag color={getStatusColor(node.status)}>\n                    {node.status.toUpperCase()}\n                  </Tag>\n                </Space>\n                \n                <div style={{ \n                  backgroundColor: '#fff',\n                  padding: '12px',\n                  borderRadius: '6px',\n                  maxHeight: '200px',\n                  overflow: 'auto',\n                  border: '1px solid #f0f0f0'\n                }}>\n                  <pre style={{ \n                    margin: 0, \n                    fontSize: '13px',\n                    whiteSpace: 'pre-wrap',\n                    wordWrap: 'break-word'\n                  }}>\n                    {formatData(node.message)}\n                  </pre>\n                </div>\n              </Space>\n            </Card>\n          </Timeline.Item>\n        ))}\n      </Timeline>\n    );\n  };\n\n  return (\n    <Modal\n      title={\n        <Space>\n          <Text strong>Workflow Execution Details</Text>\n          <Tag color={getStatusColor(execution.status)}>\n            {execution.status?.toUpperCase()}\n          </Tag>\n        </Space>\n      }\n      visible={visible}\n      onCancel={onClose}\n      width={1000}\n      footer={null}\n      bodyStyle={{ padding: '12px' }}\n    >\n      <Tabs defaultActiveKey=\"overview\">\n        <TabPane tab=\"Overview\" key=\"overview\">\n          <Card className=\"mb-4\">\n            <Descriptions column={2} size=\"small\">\n              <Descriptions.Item label=\"Workflow Name\" span={2}>\n                <Text strong>{execution.workflow_name}</Text>\n              </Descriptions.Item>\n              <Descriptions.Item label=\"Execution ID\">{execution.id}</Descriptions.Item>\n              <Descriptions.Item label=\"Status\">\n                <Tag color={getStatusColor(execution.status)}>\n                  {execution.status?.toUpperCase()}\n                </Tag>\n              </Descriptions.Item>\n              <Descriptions.Item label=\"Created At\">{execution.created_at}</Descriptions.Item>\n              <Descriptions.Item label=\"Updated At\">{execution.updated_at}</Descriptions.Item>\n            </Descriptions>\n          </Card>\n\n          <div style={{ \n            backgroundColor: '#fff', \n            borderRadius: '8px',\n            maxHeight: '600px',\n            overflow: 'auto'\n          }}>\n            {renderTimeline()}\n          </div>\n        </TabPane>\n\n        <TabPane tab=\"Input Data\" key=\"input\">\n          <Card bodyStyle={{ maxHeight: '600px', overflow: 'auto' }}>\n            <pre style={{ \n              backgroundColor: '#f6f8fa',\n              padding: '12px',\n              borderRadius: '6px',\n              fontSize: '13px',\n              margin: 0,\n              whiteSpace: 'pre-wrap',\n              wordWrap: 'break-word'\n            }}>\n              {formatInputData(execution.input_data)}\n            </pre>\n          </Card>\n        </TabPane>\n      </Tabs>\n    </Modal>\n  );\n};\n\nexport default WorkflowDetailsModal;","import React, { useState, useEffect, useCallback } from 'react';\r\nimport { Table, Tag, Space, Button, Input, Modal, Descriptions, message, Popconfirm } from 'antd';\r\nimport { SearchOutlined, SyncOutlined, DeleteOutlined, ExclamationCircleOutlined } from '@ant-design/icons';\r\nimport { adminInstance } from './api/axiosConfig';\r\nimport config from '../config';\r\nimport WorkflowDetailsModal from './WorkflowDetailsModal'; \r\n\r\nconst { Search } = Input;\r\nconst { confirm } = Modal;\r\n\r\nconst WorkflowQueue = () => {\r\n  const [executions, setExecutions] = useState([]);\r\n  const [loading, setLoading] = useState(false);\r\n  const [pagination, setPagination] = useState({\r\n    current: 1,\r\n    pageSize: 10,\r\n    total: 0,\r\n  });\r\n  const [searchTerm, setSearchTerm] = useState('');\r\n  const [detailsModalVisible, setDetailsModalVisible] = useState(false);\r\n  const [selectedExecution, setSelectedExecution] = useState(null);\r\n  const [autoRefresh, setAutoRefresh] = useState(true);\r\n  const [timezoneOffset, setTimezoneOffset] = useState(0);\r\n\r\n  const utcToLocal = useCallback((utcDateString) => {\r\n    if (!utcDateString) return 'Not scheduled';\r\n    const date = new Date(utcDateString + 'Z');  // Append 'Z' to ensure it's treated as UTC\r\n    date.setHours(date.getHours());\r\n    return date.toLocaleString();\r\n  }, [timezoneOffset]);\r\n\r\n  const fetchExecutions = useCallback(async (page = 1, pageSize = 10, search = '') => {\r\n    setLoading(true);\r\n    try {\r\n      const response = await adminInstance.get(`${config.apiSettings.root}wp-ai-workflows/v1/executions`, {\r\n        params: { page, pageSize, search },\r\n      });\r\n      console.log('Fetched executions:', response.data);\r\n      if (response.data && Array.isArray(response.data.executions)) {\r\n        setExecutions(response.data.executions.map(execution => ({\r\n          ...execution,\r\n          key: execution.id,\r\n          next_execution: utcToLocal(execution.next_execution)\r\n        })));\r\n        setPagination(prev => ({\r\n          ...prev,\r\n          current: page,\r\n          total: response.data.total,\r\n        }));\r\n        setTimezoneOffset(response.data.timezone_offset || 0);\r\n      } else {\r\n        console.error('Invalid data structure received:', response.data);\r\n        message.error('Received invalid data format from server');\r\n      }\r\n    } catch (error) {\r\n      console.error('Error fetching executions:', error);\r\n      message.error('Failed to fetch workflow executions');\r\n    }\r\n    setLoading(false);\r\n  }, [utcToLocal]);\r\n\r\n  useEffect(() => {\r\n    fetchExecutions(pagination.current, pagination.pageSize, searchTerm);\r\n  }, [fetchExecutions, pagination.current, pagination.pageSize, searchTerm]);\r\n\r\n  useEffect(() => {\r\n    let intervalId;\r\n    if (autoRefresh) {\r\n      intervalId = setInterval(() => {\r\n        fetchExecutions(pagination.current, pagination.pageSize, searchTerm);\r\n      }, 30000); // Refresh every 30 seconds\r\n    }\r\n\r\n    return () => {\r\n      if (intervalId) clearInterval(intervalId);\r\n    };\r\n  }, [autoRefresh, fetchExecutions, pagination.current, pagination.pageSize, searchTerm]);\r\n\r\n  const handleTableChange = (newPagination) => {\r\n    setPagination(newPagination);\r\n  };\r\n\r\n  const handleSearch = (value) => {\r\n    setSearchTerm(value);\r\n    setPagination(prev => ({ ...prev, current: 1 }));\r\n  };\r\n\r\n  const handleRefresh = () => {\r\n    fetchExecutions(pagination.current, pagination.pageSize, searchTerm);\r\n  };\r\n\r\n  const toggleAutoRefresh = () => {\r\n    setAutoRefresh(prev => !prev);\r\n  };\r\n\r\n  const viewDetails = async (id) => {\r\n    try {\r\n      const response = await adminInstance.get(`${config.apiSettings.root}wp-ai-workflows/v1/executions/${id}`);\r\n      let execution = response.data;\r\n      \r\n      console.log('Raw execution data:', execution);\r\n  \r\n      // Define annotation node prefixes to exclude\r\n      const annotationPrefixes = ['stickyNote-', 'textAnnotation-', 'shape-', 'sticky-', 'annotation-', ];\r\n  \r\n      // Helper function to check if a node is an annotation\r\n      const isAnnotationNode = (nodeId) => \r\n        annotationPrefixes.some(prefix => nodeId.startsWith(prefix));\r\n  \r\n      // Handle output_data processing\r\n      if (typeof execution.output_data === 'string') {\r\n        try {\r\n          execution.output_data = JSON.parse(execution.output_data);\r\n        } catch (e) {\r\n          console.error('Failed to parse output_data:', e);\r\n          execution.output_data = {};\r\n        }\r\n      }\r\n      \r\n      // If output_data is already an array of node summaries, use it directly\r\n      if (Array.isArray(execution.node_summary) && execution.node_summary.length > 0) {\r\n        // Filter out invalid nodes and annotation nodes\r\n        execution.node_summary = execution.node_summary.filter(node => \r\n          node && \r\n          node.node_id && \r\n          node.node_id.trim() !== '' && \r\n          node.node_id !== 'undefined' &&\r\n          !isAnnotationNode(node.node_id)  // Check node_id prefix\r\n        );\r\n      } else {\r\n        // Convert output_data object to node_summary array and filter out invalid and annotation nodes\r\n        execution.node_summary = Object.entries(execution.output_data || {})\r\n          .filter(([nodeId]) => \r\n            nodeId && \r\n            nodeId.trim() !== '' && \r\n            nodeId !== 'undefined' &&\r\n            !isAnnotationNode(nodeId)  // Check node_id prefix\r\n          )\r\n          .map(([nodeId, nodeData]) => ({\r\n            key: nodeId,\r\n            node_id: nodeId,\r\n            status: nodeData.type || 'Unknown',\r\n            type: nodeData.type,\r\n            message: nodeData.content || nodeData.message || 'No message'\r\n          }));\r\n      }\r\n  \r\n      console.log('Processed execution data:', execution);\r\n  \r\n      setSelectedExecution(execution);\r\n      setDetailsModalVisible(true);\r\n    } catch (error) {\r\n      console.error('Error fetching execution details:', error);\r\n      message.error('Failed to fetch execution details');\r\n    }\r\n  };\r\n\r\n  const handleDelete = async (id, status) => {\r\n    const isProcessing = status === 'processing';\r\n    \r\n    confirm({\r\n      title: `Are you sure you want to ${isProcessing ? 'stop and ' : ''}delete this execution?`,\r\n      icon: <ExclamationCircleOutlined />,\r\n      content: isProcessing \r\n        ? 'This will terminate the ongoing process and remove the record.' \r\n        : 'This will remove the execution record.',\r\n      okText: 'Yes',\r\n      okType: 'danger',\r\n      cancelText: 'No',\r\n      onOk: async () => {\r\n        try {\r\n          await adminInstance.delete(`${config.apiSettings.root}wp-ai-workflows/v1/executions/${id}`);\r\n          message.success(`Execution ${isProcessing ? 'stopped and ' : ''}deleted successfully`);\r\n          fetchExecutions(pagination.current, pagination.pageSize, searchTerm);\r\n        } catch (error) {\r\n          console.error('Error deleting execution:', error);\r\n          message.error(`Failed to ${isProcessing ? 'stop and ' : ''}delete execution`);\r\n        }\r\n      },\r\n    });\r\n  };\r\n\r\n  const columns = [\r\n    {\r\n      title: 'ID',\r\n      dataIndex: 'id',\r\n      key: 'id',\r\n    },\r\n    {\r\n      title: 'Workflow Name',\r\n      dataIndex: 'workflow_name',\r\n      key: 'workflow_name',\r\n    },\r\n    {\r\n      title: 'Status',\r\n      dataIndex: 'status',\r\n      key: 'status',\r\n      render: (status) => (\r\n        <Tag color={\r\n          status === 'completed' ? 'green' :\r\n          status === 'processing' ? 'blue' :\r\n          status === 'scheduled' ? 'orange' :\r\n          status === 'error' ? 'red' : 'default'\r\n        }>\r\n          {status.toUpperCase()}\r\n        </Tag>\r\n      ),\r\n    },\r\n    {\r\n      title: 'Next Execution',\r\n      dataIndex: 'next_execution',\r\n      key: 'next_execution',\r\n      render: (nextExecution) => nextExecution,\r\n    },\r\n    {\r\n      title: 'Created At',\r\n      dataIndex: 'created_at',\r\n      key: 'created_at',\r\n    },\r\n    {\r\n      title: 'Updated At',\r\n      dataIndex: 'updated_at',\r\n      key: 'updated_at',\r\n    },\r\n    {\r\n      title: 'Actions',\r\n      key: 'actions',\r\n      render: (text, record) => (\r\n        <Space size=\"middle\">\r\n          <Button onClick={() => viewDetails(record.id)}>View Details</Button>\r\n          <Button \r\n            icon={<DeleteOutlined />} \r\n            danger\r\n            onClick={() => handleDelete(record.id, record.status)}\r\n          >\r\n            {record.status === 'processing' ? 'Stop & Delete' : 'Delete'}\r\n          </Button>\r\n        </Space>\r\n      ),\r\n    },\r\n  ];\r\n\r\n  return (\r\n    <div>\r\n      <h1>Workflow Execution Queue</h1>\r\n      <Space style={{ marginBottom: 16 }}>\r\n        <Search\r\n          placeholder=\"Search by workflow name\"\r\n          onSearch={handleSearch}\r\n          style={{ width: 300 }}\r\n          enterButton\r\n        />\r\n        <Button onClick={handleRefresh} icon={<SyncOutlined />}>\r\n          Refresh\r\n        </Button>\r\n        <Button\r\n          type={autoRefresh ? 'primary' : 'default'}\r\n          onClick={toggleAutoRefresh}\r\n        >\r\n          {autoRefresh ? 'Disable Auto-refresh' : 'Enable Auto-refresh'}\r\n        </Button>\r\n      </Space>\r\n      <Table\r\n        columns={columns}\r\n        dataSource={executions}\r\n        rowKey=\"id\"\r\n        pagination={pagination}\r\n        loading={loading}\r\n        onChange={handleTableChange}\r\n      />\r\n<WorkflowDetailsModal \r\n  execution={selectedExecution}\r\n  visible={detailsModalVisible}\r\n  onClose={() => setDetailsModalVisible(false)}\r\n/>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default WorkflowQueue;","\"use client\";\n\nimport { Row } from '../grid';\nexport default Row;","\"use client\";\n\nimport { Col } from '../grid';\nexport default Col;","\"use client\";\n\nimport * as React from 'react';\nconst StatisticNumber = props => {\n  const {\n    value,\n    formatter,\n    precision,\n    decimalSeparator,\n    groupSeparator = '',\n    prefixCls\n  } = props;\n  let valueNode;\n  if (typeof formatter === 'function') {\n    // Customize formatter\n    valueNode = formatter(value);\n  } else {\n    // Internal formatter\n    const val = String(value);\n    const cells = val.match(/^(-?)(\\d*)(\\.(\\d+))?$/);\n    // Process if illegal number\n    if (!cells || val === '-') {\n      valueNode = val;\n    } else {\n      const negative = cells[1];\n      let int = cells[2] || '0';\n      let decimal = cells[4] || '';\n      int = int.rep