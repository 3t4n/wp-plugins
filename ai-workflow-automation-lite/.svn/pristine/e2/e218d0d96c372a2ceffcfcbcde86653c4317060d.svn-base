[method] = function(url, config) {\n    return this.request(mergeConfig(config || {}, {\n      method,\n      url,\n      data: (config || {}).data\n    }));\n  };\n});\n\nutils.forEach(['post', 'put', 'patch'], function forEachMethodWithData(method) {\n  /*eslint func-names:0*/\n\n  function generateHTTPMethod(isForm) {\n    return function httpMethod(url, data, config) {\n      return this.request(mergeConfig(config || {}, {\n        method,\n        headers: isForm ? {\n          'Content-Type': 'multipart/form-data'\n        } : {},\n        url,\n        data\n      }));\n    };\n  }\n\n  Axios.prototype[method] = generateHTTPMethod();\n\n  Axios.prototype[method + 'Form'] = generateHTTPMethod(true);\n});\n\nexport default Axios;\n","'use strict';\n\nimport CanceledError from './CanceledError.js';\n\n/**\n * A `CancelToken` is an object that can be used to request cancellation of an operation.\n *\n * @param {Function} executor The executor function.\n *\n * @returns {CancelToken}\n */\nclass CancelToken {\n  constructor(executor) {\n    if (typeof executor !== 'function') {\n      throw new TypeError('executor must be a function.');\n    }\n\n    let resolvePromise;\n\n    this.promise = new Promise(function promiseExecutor(resolve) {\n      resolvePromise = resolve;\n    });\n\n    const token = this;\n\n    // eslint-disable-next-line func-names\n    this.promise.then(cancel => {\n      if (!token._listeners) return;\n\n      let i = token._listeners.length;\n\n      while (i-- > 0) {\n        token._listeners[i](cancel);\n      }\n      token._listeners = null;\n    });\n\n    // eslint-disable-next-line func-names\n    this.promise.then = onfulfilled => {\n      let _resolve;\n      // eslint-disable-next-line func-names\n      const promise = new Promise(resolve => {\n        token.subscribe(resolve);\n        _resolve = resolve;\n      }).then(onfulfilled);\n\n      promise.cancel = function reject() {\n        token.unsubscribe(_resolve);\n      };\n\n      return promise;\n    };\n\n    executor(function cancel(message, config, request) {\n      if (token.reason) {\n        // Cancellation has already been requested\n        return;\n      }\n\n      token.reason = new CanceledError(message, config, request);\n      resolvePromise(token.reason);\n    });\n  }\n\n  /**\n   * Throws a `CanceledError` if cancellation has been requested.\n   */\n  throwIfRequested() {\n    if (this.reason) {\n      throw this.reason;\n    }\n  }\n\n  /**\n   * Subscribe to the cancel signal\n   */\n\n  subscribe(listener) {\n    if (this.reason) {\n      listener(this.reason);\n      return;\n    }\n\n    if (this._listeners) {\n      this._listeners.push(listener);\n    } else {\n      this._listeners = [listener];\n    }\n  }\n\n  /**\n   * Unsubscribe from the cancel signal\n   */\n\n  unsubscribe(listener) {\n    if (!this._listeners) {\n      return;\n    }\n    const index = this._listeners.indexOf(listener);\n    if (index !== -1) {\n      this._listeners.splice(index, 1);\n    }\n  }\n\n  /**\n   * Returns an object that contains a new `CancelToken` and a function that, when called,\n   * cancels the `CancelToken`.\n   */\n  static source() {\n    let cancel;\n    const token = new CancelToken(function executor(c) {\n      cancel = c;\n    });\n    return {\n      token,\n      cancel\n    };\n  }\n}\n\nexport default CancelToken;\n","const HttpStatusCode = {\n  Continue: 100,\n  SwitchingProtocols: 101,\n  Processing: 102,\n  EarlyHints: 103,\n  Ok: 200,\n  Created: 201,\n  Accepted: 202,\n  NonAuthoritativeInformation: 203,\n  NoContent: 204,\n  ResetContent: 205,\n  PartialContent: 206,\n  MultiStatus: 207,\n  AlreadyReported: 208,\n  ImUsed: 226,\n  MultipleChoices: 300,\n  MovedPermanently: 301,\n  Found: 302,\n  SeeOther: 303,\n  NotModified: 304,\n  UseProxy: 305,\n  Unused: 306,\n  TemporaryRedirect: 307,\n  PermanentRedirect: 308,\n  BadRequest: 400,\n  Unauthorized: 401,\n  PaymentRequired: 402,\n  Forbidden: 403,\n  NotFound: 404,\n  MethodNotAllowed: 405,\n  NotAcceptable: 406,\n  ProxyAuthenticationRequired: 407,\n  RequestTimeout: 408,\n  Conflict: 409,\n  Gone: 410,\n  LengthRequired: 411,\n  PreconditionFailed: 412,\n  PayloadTooLarge: 413,\n  UriTooLong: 414,\n  UnsupportedMediaType: 415,\n  RangeNotSatisfiable: 416,\n  ExpectationFailed: 417,\n  ImATeapot: 418,\n  MisdirectedRequest: 421,\n  UnprocessableEntity: 422,\n  Locked: 423,\n  FailedDependency: 424,\n  TooEarly: 425,\n  UpgradeRequired: 426,\n  PreconditionRequired: 428,\n  TooManyRequests: 429,\n  RequestHeaderFieldsTooLarge: 431,\n  UnavailableForLegalReasons: 451,\n  InternalServerError: 500,\n  NotImplemented: 501,\n  BadGateway: 502,\n  ServiceUnavailable: 503,\n  GatewayTimeout: 504,\n  HttpVersionNotSupported: 505,\n  VariantAlsoNegotiates: 506,\n  InsufficientStorage: 507,\n  LoopDetected: 508,\n  NotExtended: 510,\n  NetworkAuthenticationRequired: 511,\n};\n\nObject.entries(HttpStatusCode).forEach(([key, value]) => {\n  HttpStatusCode[value] = key;\n});\n\nexport default HttpStatusCode;\n","'use strict';\n\nimport utils from './utils.js';\nimport bind from './helpers/bind.js';\nimport Axios from './core/Axios.js';\nimport mergeConfig from './core/mergeConfig.js';\nimport defaults from './defaults/index.js';\nimport formDataToJSON from './helpers/formDataToJSON.js';\nimport CanceledError from './cancel/CanceledError.js';\nimport CancelToken from './cancel/CancelToken.js';\nimport isCancel from './cancel/isCancel.js';\nimport {VERSION} from './env/data.js';\nimport toFormData from './helpers/toFormData.js';\nimport AxiosError from './core/AxiosError.js';\nimport spread from './helpers/spread.js';\nimport isAxiosError from './helpers/isAxiosError.js';\nimport AxiosHeaders from \"./core/AxiosHeaders.js\";\nimport adapters from './adapters/adapters.js';\nimport HttpStatusCode from './helpers/HttpStatusCode.js';\n\n/**\n * Create an instance of Axios\n *\n * @param {Object} defaultConfig The default config for the instance\n *\n * @returns {Axios} A new instance of Axios\n */\nfunction createInstance(defaultConfig) {\n  const context = new Axios(defaultConfig);\n  const instance = bind(Axios.prototype.request, context);\n\n  // Copy axios.prototype to instance\n  utils.extend(instance, Axios.prototype, context, {allOwnKeys: true});\n\n  // Copy context to instance\n  utils.extend(instance, context, null, {allOwnKeys: true});\n\n  // Factory for creating new instances\n  instance.create = function create(instanceConfig) {\n    return createInstance(mergeConfig(defaultConfig, instanceConfig));\n  };\n\n  return instance;\n}\n\n// Create the default instance to be exported\nconst axios = createInstance(defaults);\n\n// Expose Axios class to allow class inheritance\naxios.Axios = Axios;\n\n// Expose Cancel & CancelToken\naxios.CanceledError = CanceledError;\naxios.CancelToken = CancelToken;\naxios.isCancel = isCancel;\naxios.VERSION = VERSION;\naxios.toFormData = toFormData;\n\n// Expose AxiosError class\naxios.AxiosError = AxiosError;\n\n// alias for CanceledError for backward compatibility\naxios.Cancel = axios.CanceledError;\n\n// Expose all/spread\naxios.all = function all(promises) {\n  return Promise.all(promises);\n};\n\naxios.spread = spread;\n\n// Expose isAxiosError\naxios.isAxiosError = isAxiosError;\n\n// Expose mergeConfig\naxios.mergeConfig = mergeConfig;\n\naxios.AxiosHeaders = AxiosHeaders;\n\naxios.formToJSON = thing => formDataToJSON(utils.isHTMLForm(thing) ? new FormData(thing) : thing);\n\naxios.getAdapter = adapters.getAdapter;\n\naxios.HttpStatusCode = HttpStatusCode;\n\naxios.default = axios;\n\n// this module should only have a default export\nexport default axios\n","'use strict';\n\n/**\n * Syntactic sugar for invoking a function and expanding an array for arguments.\n *\n * Common use case would be to use `Function.prototype.apply`.\n *\n *  ```js\n *  function f(x, y, z) {}\n *  var args = [1, 2, 3];\n *  f.apply(null, args);\n *  ```\n *\n * With `spread` this example can be re-written.\n *\n *  ```js\n *  spread(function(x, y, z) {})([1, 2, 3]);\n *  ```\n *\n * @param {Function} callback\n *\n * @returns {Function}\n */\nexport default function spread(callback) {\n  return function wrap(arr) {\n    return callback.apply(null, arr);\n  };\n}\n","'use strict';\n\nimport utils from './../utils.js';\n\n/**\n * Determines whether the payload is an error thrown by Axios\n *\n * @param {*} payload The value to test\n *\n * @returns {boolean} True if the payload is an error thrown by Axios, otherwise false\n */\nexport default function isAxiosError(payload) {\n  return utils.isObject(payload) && (payload.isAxiosError === true);\n}\n","import axios from 'axios';\r\n\r\nconst adminInstance = axios.create();\r\nconst automatedInstance = axios.create();\r\n\r\n// Function to set up the admin instance with the nonce\r\nexport const setupAdminInstance = () => {\r\n  console.log(\"Setting up admin instance...\");\r\n  if (window.wpAiWorkflowsSettings && window.wpAiWorkflowsSettings.nonce) {\r\n    adminInstance.defaults.headers.common['X-WP-Nonce'] = window.wpAiWorkflowsSettings.nonce;\r\n    console.log(\"Nonce set successfully:\", window.wpAiWorkflowsSettings.nonce);\r\n    \r\n    // Set the base URL for API requests\r\n    if (window.wpAiWorkflowsSettings.root) {\r\n      adminInstance.defaults.baseURL = window.wpAiWorkflowsSettings.root + 'wp-ai-workflows/v1';\r\n      console.log(\"Base URL set to:\", adminInstance.defaults.baseURL);\r\n    } else {\r\n      console.warn(\"API root URL not found in settings.\");\r\n    }\r\n  } else {\r\n    console.warn(\"WP AI Workflows settings or nonce not found. Some features may not work correctly.\");\r\n  }\r\n\r\n  // Add request interceptor for logging\r\n  adminInstance.interceptors.request.use(config => {\r\n    console.log('API Request:', config.method.toUpperCase(), config.url);\r\n    return config;\r\n  });\r\n\r\n  // Add response interceptor for logging\r\n  adminInstance.interceptors.response.use(\r\n    response => {\r\n      console.log('API Response:', response.status, response.config.url);\r\n      return response;\r\n    },\r\n    error => {\r\n      console.error('API Error:', error.response ? error.response.status : 'Unknown', error.config ? error.config.url : 'Unknown URL');\r\n      return Promise.reject(error);\r\n    }\r\n  );\r\n};\r\n\r\n// Function to set the API key for automated instance\r\nexport const setApiKey = (apiKey) => {\r\n  console.log(\"Setting API key for automated instance...\");\r\n  automatedInstance.defaults.headers.common['X-Api-Key'] = apiKey;\r\n  \r\n  // You might want to set a base URL for the automated instance as well\r\n  // automatedInstance.defaults.baseURL = 'your_automated_api_base_url';\r\n};\r\n\r\nexport { adminInstance, automatedInstance };","const config = {\n  apiSettings: {\n    root: window.wpAiWorkflowsSettings?.root || '',\n    nonce: window.wpAiWorkflowsSettings?.nonce || ''\n  }\n};\n\nexport default config;","import React, { useState, useEffect, useCallback } from 'react';\nimport { Handle, Position } from '@xyflow/react';\nimport { Tabs, Alert, Card, Button, Input, message, Select, Modal, Typography, Table, Form } from 'antd';\nimport { DeleteOutlined, InfoCircleOutlined, CopyOutlined, PlusOutlined, UserOutlined, NodeIndexOutlined, FormOutlined, DatabaseOutlined } from '@ant-design/icons';\nimport { Icon } from '@iconify/react';\nimport FormSelector from '../common/FormSelector';\nimport { adminInstance } from '../api/axiosConfig';\nimport config from '../../config';\n\nconst { TextArea } = Input;\nconst { Option } = Select;\nconst { Title, Paragraph, Text } = Typography;\n\nconst TriggerNode = ({ id, data, isConnectable }) => {\n  const [loading, setLoading] = useState(false);\n  const [error, setError] = useState(null);\n  const [wpForms, setWpForms] = useState([]);\n  const [selectedFields, setSelectedFields] = useState(data.selectedFields || []);\n  const [webhookUrl, setWebhookUrl] = useState('');\n  const [isModalVisible, setIsModalVisible] = useState(false);\n  const [nodeName, setNodeName] = useState(data.nodeName || `Trigger ${id}`);\n  const [webhookKeys, setWebhookKeys] = useState(data.webhookKeys || []);\n  const [isSamplingWebhook, setIsSamplingWebhook] = useState(false);\n  const [manualKeyInput, setManualKeyInput] = useState('');\n  const [manualValueType, setManualValueType] = useState('string');\n\n  const fetchWpForms = useCallback(async () => {\n    setLoading(true);\n    setError(null);\n    try {\n        const response = await adminInstance.get(`${config.apiSettings.root}wp-ai-workflows/v1/wpforms`);\n        setWpForms(response.data);\n    } catch (error) {\n        console.error('Error fetching WPForms:', error);\n        setError('Failed to fetch WPForms. Please try again.');\n        message.error('Failed to fetch WPForms');\n    }\n    setLoading(false);\n  }, []);\n\n  useEffect(() => {\n    if (data.triggerType === 'wpForms') {\n      fetchWpForms();\n    } else if (data.triggerType === 'webhook') {\n      if (!data.webhookUrl) {\n        generateWebhookUrl();\n      } else {\n        setWebhookUrl(data.webhookUrl);\n      }\n    }\n  }, [data.triggerType, data.webhookUrl, fetchWpForms]);\n\n\n\n  const handleTriggerTypeChange = (value) => {\n    data.updateNodeData(id, { \n      triggerType: value, \n      selectedForm: null, \n      selectedFields: [],\n      selectedWorkflow: null,\n      selectedWpCoreTrigger: null,\n      wpCoreTriggerConditions: {},\n      selectedTable: null,\n      databaseTriggerType: null\n    });\n  };\n\n  const handleContentChange = (e) => {\n    data.updateNodeData(id, { content: e.target.value });\n  };\n\n  const handleFormChange = (formId, fields) => {\n    console.log('Selected Form fields:', fields);\n    data.updateNodeData(id, { \n        selectedForm: formId,\n        selectedFields: fields,\n    });\n    setSelectedFields(fields);\n  };\n\n  const generateWebhookUrl = async () => {\n    try {\n      const response = await adminInstance.post(`${config.apiSettings.root}wp-ai-workflows/v1/generate-webhook`, { nodeId: id });\n      const newWebhookUrl = response.data.webhookUrl;\n      setWebhookUrl(newWebhookUrl);\n      data.updateNodeData(id, { webhookUrl: newWebhookUrl });\n    } catch (error) {\n      console.error('Error generating webhook URL:', error);\n      message.error('Failed to generate webhook URL');\n    }\n  };\n\n  const copyWebhookUrl = () => {\n    navigator.clipboard.writeText(webhookUrl);\n    message.success('Webhook URL copied to clipboard');\n  };\n\n  const showModal = () => {\n    setIsModalVisible(true);\n  };\n\n  const handleOk = () => {\n    setIsModalVisible(false);\n  };\n\n  const webhookInstructions = (\n    <div style={{ padding: '10px' }}>\n      <Title level={4}>Understanding and Using Webhook Triggers</Title>\n      \n      <Paragraph>\n        <strong>What are Webhooks?</strong><br />\n        Webhooks let you receive data from external applications or forms in real-time. When something happens (like a form submission), the data is sent to your webhook URL automatically.\n      </Paragraph>\n  \n      <Title level={5}>Quick Setup Steps</Title>\n      <ol>\n        <li>Copy your webhook URL above</li>\n        <li>Use it as the submission endpoint in your forms or applications</li>\n        <li>Test it using the \"Get Samples\" button to see the data structure</li>\n      </ol>\n  \n      <Title level={5}>Implementation Options</Title>\n      \n      <Tabs defaultActiveKey=\"1\" style={{ marginBottom: '16px' }}>\n        <Tabs.TabPane tab=\"Basic Webhook\" key=\"1\">\n          <Card title=\"Simple Data Collection\" style={{ marginBottom: '16px' }}>\n            <Paragraph>\n              For just collecting data without displaying results:\n            </Paragraph>\n            <div style={{ position: 'relative' }}>\n              <pre style={{ background: '#f6f8fa', padding: '12px', borderRadius: '4px', overflow: 'auto' }}>\n                {`<form action=\"${webhookUrl}\" method=\"post\">\n    <input type=\"text\" name=\"user_name\" placeholder=\"Name\">\n    <input type=\"email\" name=\"user_email\" placeholder=\"Email\">\n    <button type=\"submit\">Submit</button>\n</form>`}\n              </pre>\n              <Button \n                icon={<CopyOutlined />} \n                style={{ position: 'absolute', top: '8px', right: '8px' }}\n                onClick={() => {\n                    navigator.clipboard.writeText(document.querySelector('pre').textContent);\n                    message.success('Code copied!');\n                }}\n              />\n            </div>\n          </Card>\n        </Tabs.TabPane>\n\n        <Tabs.TabPane tab=\"With Live Results\" key=\"2\">\n          <Card title=\"Setup Steps\" style={{ marginBottom: '16px' }}>\n            <ol>\n              <li>Add an \"Output\" node to your workflow\n                <Text type=\"secondary\" style={{ display: 'block', marginLeft: '24px' }}>\n                  This will generate a shortcode that looks like: [wp_ai_workflows_output id=\"workflow-id\"]\n                </Text>\n              </li>\n              <li>Note the workflow ID from your shortcode\n                <Text type=\"secondary\" style={{ display: 'block', marginLeft: '24px' }}>\n                  Replace 'YOUR-WORKFLOW-ID' in the code examples with this ID\n                </Text>\n              </li>\n              <li>Choose an implementation method:</li>\n            </ol>\n\n            <Tabs size=\"small\">\n              <Tabs.TabPane tab=\"HTML Form\" key=\"html\">\n                <div style={{ position: 'relative' }}>\n                  <pre style={{ background: '#f6f8fa', padding: '12px', borderRadius: '4px', overflow: 'auto' }}>\n                    {`<!-- Add wp-ai-workflows-trigger class -->\n<form action=\"${webhookUrl}\" \n      method=\"post\" \n      class=\"wp-ai-workflows-trigger\">\n    <input type=\"text\" name=\"user_name\">\n    <button type=\"submit\">Submit</button>\n</form>`}\n                  </pre>\n                  <Button \n                    icon={<CopyOutlined />} \n                    style={{ position: 'absolute', top: '8px', right: '8px' }}\n                    onClick={() => {\n                        navigator.clipboard.writeText(document.querySelector('pre').textContent);\n                        message.success('Code copied!');\n                    }}\n                  />\n                </div>\n              </Tabs.TabPane>\n\n              <Tabs.TabPane tab=\"AJAX\" key=\"ajax\">\n                <Alert\n                  message=\"Important\"\n                  description=\"Remember to replace 'YOUR-WORKFLOW-ID' with the ID from your output node's shortcode\"\n                  type=\"info\"\n                  showIcon\n                  style={{ marginBottom: '12px' }}\n                />\n                <div style={{ position: 'relative' }}>\n                  <pre style={{ background: '#f6f8fa', padding: '12px', borderRadius: '4px', overflow: 'auto' }}>\n                    {`<form id=\"ajaxForm\" onsubmit=\"submitForm(event)\">\n    <input type=\"text\" name=\"user_name\">\n    <button type=\"submit\">Submit</button>\n</form>\n\n<script>\nasync function submitForm(event) {\n    event.preventDefault();\n    \n    // Replace YOUR-WORKFLOW-ID with the ID from your shortcode\n    window.wpAiWorkflows['YOUR-WORKFLOW-ID']\n        .triggerSubmission();\n\n    // Submit data to webhook\n    const response = await fetch('${webhookUrl}', {\n        method: 'POST',\n        body: new FormData(event.target)\n    });\n\n    if (!response.ok) {\n        console.error('Submission failed');\n    }\n}\n</script>`}\n                  </pre>\n                  <Button \n                    icon={<CopyOutlined />} \n                    style={{ position: 'absolute', top: '8px', right: '8px' }}\n                    onClick={() => {\n                        navigator.clipboard.writeText(document.querySelector('pre').textContent);\n                        message.success('Code copied!');\n                    }}\n                  />\n                </div>\n              </Tabs.TabPane>\n\n              <Tabs.TabPane tab=\"JavaScript Framework\" key=\"framework\">\n  <Alert\n    message=\"Important\"\n    description=\"Remember to replace 'YOUR-WORKFLOW-ID' with the ID from your output node's shortcode\"\n    type=\"info\"\n    showIcon\n    style={{ marginBottom: '12px' }}\n  />\n  <div style={{ position: 'relative' }}>\n    <pre style={{ background: '#f6f8fa', padding: '12px', borderRadius: '4px', overflow: 'auto' }}>\n      {`const handleSubmit = async (event) => {\n    event.preventDefault();\n    \n    // Trigger the shortcode loading state\n    window.wpAiWorkflows['YOUR-WORKFLOW-ID']\n        .triggerSubmission();\n\n    try {\n        const response = await fetch('${webhookUrl}', {\n            method: 'POST',\n            headers: {\n                'Content-Type': 'application/json'\n            },\n            body: JSON.stringify({\n                // your data here\n            })\n        });\n\n        if (!response.ok) {\n            throw new Error('Submission failed');\n        }\n    } catch (error) {\n        console.error('Error:', error);\n    }\n};`}\n    </pre>\n    <Button \n      icon={<CopyOutlined />} \n      style={{ position: 'absolute', top: '8px', right: '8px' }}\n      onClick={() => {\n        navigator.clipboard.writeText(document.querySelector('pre').textContent);\n        message.success('Code copied!');\n      }}\n    />\n  </div>\n</Tabs.TabPane>\n            </Tabs>\n          </Card>\n\n          <Alert\n            message=\"How it works\"\n            description={\n              <ul style={{ marginBottom: 0 }}>\n                <li>The output node creates a shortcode for displaying workflow results</li>\n                <li>Place this shortcode where you want the results to appear on your page</li>\n                <li>When a form is submitted, the container shows a loading state</li>\n                <li>Results appear automatically once the workflow completes</li>\n              </ul>\n            }\n            type=\"info\"\n            showIcon\n            style={{ marginBottom: '16px' }}\n          />\n        </Tabs.TabPane>\n      </Tabs>\n\n      <Title level={5}>Accessing Webhook Data</Title>\n      <Paragraph>\n        In your workflow, access submitted data using these tags:\n        <ul>\n          <li><Text code>[[field_name] from trigger-node-id]</Text> - Access specific fields</li>\n          <li><Text code>[Input from trigger-node-id]</Text> - Access entire payload</li>\n        </ul>\n      </Paragraph>\n\n      <Alert\n        message=\"Security Note\"\n        description=\"Ensure your webhook URL remains private and validate incoming data in your workflow nodes.\"\n        type=\"warning\"\n        showIcon\n        style={{ marginTop: '16px' }}\n      />\n    </div>\n  );\n\n  const getSamples = async () => {\n    setIsSamplingWebhook(true);\n    try {\n      const response = await adminInstance.get(`${config.apiSettings.root}wp-ai-workflows/v1/sample-webhook/${id}`);\n      if (response.data.keys) {\n        setWebhookKeys(response.data.keys);\n        data.updateNodeData(id, { webhookKeys: response.data.keys });\n      } else {\n        message.warning('No webhook data received within the timeout period');\n      }\n    } catch (error) {\n      console.error('Error sampling webhook:', error);\n      message.error('Failed to sample webhook');\n    }\n    setIsSamplingWebhook(false);\n  };\n\n  const addManualKey = () => {\n    if (manualKeyInput) {\n      const newKey = { key: manualKeyInput, type: manualValueType };\n      const updatedKeys = [...webhookKeys, newKey];\n      setWebhookKeys(updatedKeys);\n      data.updateNodeData(id, { webhookKeys: updatedKeys });\n      setManualKeyInput('');\n      setManualValueType('string');\n    }\n  };\n\n  const removeKey = (keyToRemove) => {\n    const updatedKeys = webhookKeys.filter(k => k.key !== keyToRemove);\n    setWebhookKeys(updatedKeys);\n    data.updateNodeData(id, { webhookKeys: updatedKeys });\n  };\n\n  const columns = [\n    {\n      title: 'Key',\n      dataIndex: 'key',\n      key: 'key',\n    },\n    {\n      title: 'Type',\n      dataIndex: 'type',\n      key: 'type',\n    },\n    {\n      title: 'Action',\n      key: 'action',\n      render: (_, record) => (\n        <Button onClick={() => removeKey(record.key)} type=\"link\" danger>\n          Remove\n        </Button>\n      ),\n    },\n  ];\n\n  const handleNameChange = (e) => {\n    const newName = e.target.value;\n    setNodeName(newName);\n    data.updateNodeData(id, { nodeName: newName });\n  };\n\n  const renderProFeatureMessage = () => (\n    <div style={{ marginTop: '8px', padding: '8px', backgroundColor: '#f0f0f0', borderRadius: '4px' }}>\n      <Text strong>This is a Pro feature, try it for free for 14 days!</Text>\n      <br />\n      <Button \n        type=\"primary\" \n        size=\"small\" \n        style={{ marginTop: '8px' }}\n        onClick={() => window.open('https://wpaiworkflowautomation.com/pricing?utm_source=freedownload&utm_medium=lite&utm_content=trigger', '_blank')}\n      >\n        Upgrade to Pro\n      </Button>\n    </div>\n  );\n\n  return (\n    <Card \n      title=\"Trigger\"\n      style={{ width: 300 }}\n      extra={<Button icon={<DeleteOutlined />} onClick={() => data.onDelete(id)} />}\n    >\n      <Input\n        placeholder=\"Node Name\"\n        value={nodeName}\n        onChange={handleNameChange}\n        style={{ marginBottom: 8 }}\n        className=\"nodrag\"\n      />\n      <Select\n        style={{ width: '100%', marginBottom: '8px' }}\n        className=\"nodrag\"\n        value={data.triggerType || ''}\n        onChange={handleTriggerTypeChange}\n      >\n        <Option value=\"\">Select trigger type</Option>\n        <Option value=\"manual\">\n          <UserOutlined /> Manual Trigger\n        </Option>\n        <Option value=\"wpForms\">\n          <FormOutlined /> WP Forms Trigger\n        </Option>\n        <Option value=\"NinjaForms\">\n          <FormOutlined /> Ninja Forms Trigger (Pro)\n        </Option>\n        <Option value=\"CF7\">\n          <FormOutlined /> Contact Form 7 Trigger (Pro)\n        </Option>\n        <Option value=\"gravityForms\">\n          <FormOutlined /> Gravity Forms Trigger (Pro)\n        </Option>\n        <Option value=\"webhook\">\n          <Icon icon=\"material-symbols:webhook\" /> Webhook Trigger\n        </Option>\n        <Option value=\"workflowOutput\">\n          <NodeIndexOutlined /> Workflow Output Trigger (Pro)\n        </Option>\n        <Option value=\"wpCore\">\n          <Icon icon=\"ic:outline-wordpress\" /> WordPress Core Trigger (Pro)\n        </Option>\n      </Select>\n      \n      {data.triggerType === 'gravityForms' && renderProFeatureMessage()}\n      {data.triggerType === 'NinjaForms' && renderProFeatureMessage()}\n      {data.triggerType === 'CF7' && renderProFeatureMessage()}\n\n      {data.triggerType === 'wpForms' && (\n          <div style={{ marginBottom: 16 }}>\n              <FormSelector\n                  forms={wpForms}\n                  loading={loading}\n                  error={error}\n                  selectedForm={data.selectedForm}\n                  selectedFields={selectedFields}\n                  onChange={handleFormChange}\n                  onRetry={fetchWpForms}\n                  formType={data.triggerType}\n              />\n          </div>\n      )}\n      \n      {data.triggerType === 'manual' && (\n        <TextArea\n          rows={4}\n          placeholder=\"Enter trigger content\"\n          value={data.content}\n          onChange={handleContentChange}\n          className=\"nodrag\"\n        />\n      )}\n\n      {data.triggerType === 'webhook' && (\n        <div>\n          <Input.Group compact>\n            <Input\n              style={{ width: 'calc(100% - 64px)' }}\n              value={webhookUrl}\n              placeholder=\"Webhook URL will be generated\"\n              readOnly\n            />\n            <Button icon={<CopyOutlined />} onClick={copyWebhookUrl} />\n            <Button icon={<InfoCircleOutlined />} onClick={showModal} />\n          </Input.Group>\n          <Text type=\"secondary\" style={{ marginTop: 8, fontSize: 12, display: 'block' }}>\n            Click the info icon for usage instructions.\n          </Text>\n          <Button \n            onClick={getSamples} \n            loading={isSamplingWebhook}\n            style={{ marginTop: '8px', marginBottom: '8px' }}\n          >\n            Get Samples\n          </Button>\n          <Table \n            dataSource={webhookKeys} \n            columns={columns} \n            pagination={false}\n            size=\"small\"\n          />\n          <Input\n            className=\"nodrag\"\n            placeholder=\"Enter key\"\n            value={manualKeyInput}\n            onChange={(e) => setManualKeyInput(e.target.value)}\n            style={{ marginTop: '8px', marginBottom: '8px' }}\n          />\n          <Select\n            className=\"nodrag\"\n            style={{ width: '100%', marginBottom: '8px' }}\n            value={manualValueType}\n            onChange={setManualValueType}\n          >\n            <Option value=\"string\">String</Option>\n            <Option value=\"number\">Number</Option>\n            <Option value=\"boolean\">Boolean</Option>\n          </Select>\n          <Button onClick={addManualKey} icon={<PlusOutlined />}>Add Manual Key</Button>\n        </div>\n      )}\n\n      <Modal\n        title=\"Webhook Trigger Instructions\"\n        visible={isModalVisible}\n        onOk={handleOk}\n        onCancel={handleOk}\n        width={700}\n      >\n        {webhookInstructions}\n      </Modal>\n      \n      {data.triggerType === 'workflowOutput' && renderProFeatureMessage()}\n\n      {data.triggerType === 'wpCore' && renderProFeatureMessage()}\n\n      <Handle type=\"source\" position={Position.Right} id=\"a\" isConnectable={isConnectable} />\n    </Card>\n  );\n};\n\nexport default TriggerNode;","import { unit } from '@ant-design/cssinjs';\nimport { FastColor } from '@ant-design/fast-color';\nimport { resetComponent } from '../../style';\nimport { genStyleHooks, mergeToken } from '../../theme/internal';\n// ============================== Styles ==============================\nconst genBaseStyle = token => {\n  const {\n    paddingXXS,\n    lineWidth,\n    tagPaddingHorizontal,\n    componentCls,\n    calc\n  } = token;\n  const paddingInline = calc(tagPaddingHorizontal).sub(lineWidth).equal();\n  const iconMarginInline = calc(paddingXXS).sub(lineWidth).equal();\n  return {\n    // Result\n    [componentCls]: Object.assign(Object.assign({}, resetComponent(token)), {\n      display: 'inline-block',\n      height: 'auto',\n      // https://github.com/ant-design/ant-design/pull/47504\n      marginInlineEnd: token.marginXS,\n      paddingInline,\n      fontSize: token.tagFontSize,\n      lineHeight: token.tagLineHeight,\n      whiteSpace: 'nowrap',\n      background: token.defaultBg,\n      border: `${unit(token.lineWidth)} ${token.lineType} ${token.colorBorder}`,\n      borderRadius: token.borderRadiusSM,\n      opacity: 1,\n      transition: `all ${token.motionDurationMid}`,\n      textAlign: 'start',\n      position: 'relative',\n      // RTL\n      [`&${componentCls}-rtl`]: {\n        direction: 'rtl'\n      },\n      '&, a, a:hover': {\n        color: token.defaultColor\n      },\n      [`${componentCls}-close-icon`]: {\n        marginInlineStart: iconMarginInline,\n        fontSize: token.tagIconSize,\n        color: token.colorTextDescription,\n        cursor: 'pointer',\n        transition: `all ${token.motionDurationMid}`,\n        '&:hover': {\n        