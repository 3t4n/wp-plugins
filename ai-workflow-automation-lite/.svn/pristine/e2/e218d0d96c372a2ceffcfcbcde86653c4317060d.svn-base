);\n    event.dataTransfer.effectAllowed = 'move';\n  };\n\n\n  const buttonStyle = {\n    width: '100%',\n    marginBottom: '8px',\n    borderRadius: '6px',\n    height: '36px',\n    display: 'flex',\n    alignItems: 'center',\n    justifyContent: 'center',\n    gap: '8px',\n    border: `1px solid ${colors.buttonBorder}`,\n    transition: 'all 0.2s ease',\n    boxShadow: darkMode ? 'none' : '0 2px 0 rgba(0, 0, 0, 0.02)'\n  };\n\n  const primaryButtonStyle = {\n    ...buttonStyle,\n    backgroundColor: colors.primaryButtonBg,\n    color: '#ffffff',\n    '&:hover': {\n      backgroundColor: colors.primaryButtonHoverBg,\n      borderColor: colors.primaryButtonHoverBg\n    }\n  };\n\n  const secondaryButtonStyle = {\n    ...buttonStyle,\n    backgroundColor: colors.secondaryButtonBg,\n    color: colors.secondaryButtonText,\n    '&:hover': {\n      backgroundColor: colors.secondaryButtonHoverBg,\n      borderColor: colors.buttonBorder\n    }\n  };\n\n  // Show execute button if workflow is saved or in edit mode, and not editing a template\n  const showExecuteButton = (isSavedWorkflow || isEditMode || workflowName) && !isEditingTemplate;\n\n  const handleUpgradeClick = () => {\n    window.open('https://wpaiworkflowautomation.com/pricing?utm_source=freedownload&utm_medium=lite&utm_content=sidebar', '_blank');\n  };\n\n  const showProModal = (feature) => {\n    const featureInfo = {\n      importExport: {\n        title: 'Import/Export Workflows',\n        description: 'Save time by importing pre-built workflows or export your workflows to use them in other sites. This feature is available in the Pro version.'\n      },\n      templates: {\n        title: 'Save as Template',\n        description: 'Create reusable workflow templates to streamline your process. Save your best workflows as templates and reuse them anytime. This feature is available in the Pro version.'\n      }\n    };\n\n    setProModalFeature(featureInfo[feature]);\n    setIsProModalVisible(true);\n  };\n\n  const handleUpgradeFromModal = () => {\n    window.open('https://wpaiworkflowautomation.com/pricing?utm_source=freedownload&utm_medium=lite&utm_content=modal', '_blank');\n    setIsProModalVisible(false);\n  };\n\n\n  const ProFeature = ({ icon, text, link }) => (\n    <div\n      onClick={() => window.open(link, '_blank')}\n      style={{\n        display: 'flex',\n        alignItems: 'center',\n        backgroundColor: 'rgba(255, 255, 255, 0.1)',\n        borderRadius: '8px',\n        padding: '4px 8px',\n        marginBottom: '4px',\n        fontSize: '11px',\n        cursor: 'pointer',  // Change cursor to pointer to indicate it's clickable\n        transition: 'background-color 0.3s',\n      }}\n      onMouseOver={(e) => (e.currentTarget.style.backgroundColor = 'rgba(255, 255, 255, 0.2)')}\n      onMouseOut={(e) => (e.currentTarget.style.backgroundColor = 'rgba(255, 255, 255, 0.1)')}\n    >\n      {icon}\n      <span style={{ marginLeft: '4px' }}>{text}</span>\n    </div>\n  );\n\n  return (\n    <div className=\"workflow-sidebar\" style={{ \n      display: 'flex', \n      flexDirection: 'column', \n      height: '100%',\n      borderRight: `1px solid ${colors.border}`,\n      background: colors.background,\n      color: colors.text\n    }}>\n      <div className=\"sidebar-scroll\" style={{ flex: 1, overflowY: 'auto' }}>\n        <Menu \n          mode=\"vertical\" \n          style={{ \n            width: '100%',\n            border: 'none',\n            background: colors.menuBackground,\n            color: colors.text\n          }}\n          theme={darkMode ? 'dark' : 'light'}\n        >\n          <Menu.Item key=\"trigger\" icon={<ThunderboltOutlined />} draggable onDragStart={(event) => onDragStart(event, 'trigger')}>\n            Trigger\n          </Menu.Item>\n          <SubMenu key=\"aiActions\" icon={<RobotOutlined />} title=\"AI Actions\">\n            <Menu.Item key=\"aiModel\" icon={<RobotOutlined />} draggable onDragStart={(event) => onDragStart(event, 'aiModel')}>\n              AI Model\n            </Menu.Item>\n          </SubMenu>\n          <Menu.Item key=\"post\" icon={<FileAddOutlined />} draggable onDragStart={(event) => onDragStart(event, 'post')}>\n            Create Post\n          </Menu.Item>\n          <Menu.Item \n            key=\"unsplash\" \n            icon={<PictureOutlined />} \n            draggable \n            onDragStart={(event) => onDragStart(event, 'unsplash')}\n          >\n            Unsplash Image\n          </Menu.Item>\n          <Menu.Item key=\"chat\" icon={<MessageOutlined />} draggable onDragStart={(event) => onDragStart(event, 'chat')}>\n          Chatbot\n        </Menu.Item>\n          <Menu.Item key=\"output\" icon={<SendOutlined />} draggable onDragStart={(event) => onDragStart(event, 'output')}>\n            Output\n          </Menu.Item>\n        </Menu>\n        \n        <div style={{ padding: '12px', background: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)', color: 'white', margin: '5px 5px' }}>\n          <Title level={5} style={{ color: 'white', marginBottom: '8px', fontSize: '14px' }}>Premium Features</Title>\n          <div style={{ marginBottom: '8px' }}>\n            <ProFeature icon={<GoogleOutlined />} text=\"Output to Google Sheets\" link=\"https://wpaiworkflowautomation.com/docs/save-to-google-sheets/\"/>\n            <ProFeature icon={<BranchesOutlined />} text=\"Conditional Logic\" link=\"https://wpaiworkflowautomation.com/docs/condition-node/\"/>\n            <ProFeature icon={<SearchOutlined />} text=\"Perplexity Research\" link=\"https://wpaiworkflowautomation.com/docs/research-node/\"/>\n            <ProFeature icon={<BugOutlined/>} text=\"AI Web Scraper/Crawler\" link=\"https://wpaiworkflowautomation.com/docs/web-scraper-crawler-node/\"/>\n            <ProFeature icon={<FileSearchOutlined/>} text=\"AI Document Parser\" link=\"https://wpaiworkflowautomation.com/docs/parser-node/\"/>\n            <ProFeature icon={<MailOutlined />} text=\"Email Automation\" link=\"https://wpaiworkflowautomation.com/docs/send-email-node/\"/>\n            <ProFeature icon={<BarChartOutlined />} text=\"Sentiment Analysis\" link=\"https://wpaiworkflowautomation.com/docs/sentiment-analysis-node/\"/>\n            <ProFeature icon={<FileTextOutlined />} text=\"Summary Generator\" link=\"https://wpaiworkflowautomation.com/docs/summary-generator-node/\"/>\n            <ProFeature icon={<UserOutlined />} text=\"Human Input Tasks\" link=\"https://wpaiworkflowautomation.com/docs/human-input-node/\"/>\n            <ProFeature icon={<FileSearchOutlined />} text=\"Extract Information\" link=\"https://wpaiworkflowautomation.com/docs/extract-information-node/\"/>\n            <ProFeature icon={<FontSizeOutlined />} text=\"Write an Article\" link=\"https://wpaiworkflowautomation.com/docs/write-article-node/\"/>\n            <ProFeature icon={<LineChartOutlined />} text=\"Optimize for SEO\" link=\"https://wpaiworkflowautomation.com/docs/optimize-seo-node/\"/>\n            <ProFeature icon={<ClockCircleOutlined />} text=\"Delayed Outputs\" link=\"https://wpaiworkflowautomation.com/docs/output-node/\"/>\n          </div>\n          <Button \n            type=\"primary\" \n            ghost \n            onClick={handleUpgradeClick} \n            style={{ \n              width: '100%', \n              borderColor: 'white', \n              color: 'white', \n              fontSize: '12px',\n              transition: 'all 0.3s'\n            }}\n            className=\"sidebar-upgrade-button\"\n          >\n            Start Free Trial\n          </Button>\n        </div>\n      </div>\n\n       {/* Buttons section */}\n       <div style={{ \n        padding: '16px', \n        borderTop: `1px solid ${colors.border}`,\n        backgroundColor: colors.background\n      }}>\n        {/* Update/Save Workflow Button */}\n        {isEditMode || isSavedWorkflow ? (\n          <Button \n            icon={<EditOutlined />} \n            onClick={onUpdate}\n            style={secondaryButtonStyle}\n            className={`workflow-button ${darkMode ? 'dark' : ''}`}\n          >\n            Update Workflow\n          </Button>\n        ) : (\n          <Button \n            icon={<SaveOutlined />} \n            onClick={onSave}\n            type=\"primary\"\n            style={primaryButtonStyle}\n            className={`save-workflow-button workflow-button ${darkMode ? 'dark' : ''}`}\n          >\n            Save Workflow\n          </Button>\n        )}\n\n        {/* Execute Button */}\n        {showExecuteButton && (\n          <Button \n            icon={<PlayCircleOutlined />} \n            onClick={onExecute}\n            type=\"primary\"\n            loading={isExecuting}\n            disabled={isExecuting}\n            style={primaryButtonStyle}\n            className={`execute-workflow-button workflow-button ${darkMode ? 'dark' : ''}`}\n          >\n            {isExecuting ? 'Executing...' : 'Execute Workflow'}\n          </Button>\n        )}\n\n        {/* Template Buttons */}\n        {isEditingTemplate && (\n          <Button \n            icon={<SaveOutlined />}\n            onClick={handleSaveEditedTemplate}\n            style={secondaryButtonStyle}\n            className={`workflow-button ${darkMode ? 'dark' : ''}`}\n          >\n            Save Edited Template\n          </Button>\n        )}\n\n<Button \n          icon={<CopyOutlined />} \n          onClick={() => showProModal('templates')}\n          style={secondaryButtonStyle}\n          className={`workflow-button ${darkMode ? 'dark' : ''}`}\n        >\n          Save as Template\n        </Button>\n\n        <Button \n          icon={<ImportOutlined />} \n          onClick={() => showProModal('importExport')}\n          style={secondaryButtonStyle}\n          className={`workflow-button ${darkMode ? 'dark' : ''}`}\n        >\n          Import/Export\n        </Button>\n\n                {/* Pro Feature Modal */}\n                <Modal\n          title={<span style={{ color: darkMode ? '#fff' : '#000' }}>{proModalFeature.title}</span>}\n          visible={isProModalVisible}\n          onCancel={() => setIsProModalVisible(false)}\n          footer={[\n            <Button key=\"cancel\" onClick={() => setIsProModalVisible(false)}>\n              Close\n            </Button>,\n            <Button\n              key=\"upgrade\"\n              type=\"primary\"\n              onClick={handleUpgradeFromModal}\n              style={{\n                background: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',\n                border: 'none'\n              }}\n            >\n              Upgrade to Pro\n            </Button>\n          ]}\n          className={darkMode ? 'dark-modal' : ''}\n          maskStyle={{ backgroundColor: darkMode ? 'rgba(0, 0, 0, 0.6)' : 'rgba(0, 0, 0, 0.45)' }}\n        >\n          <div style={{ \n            padding: '20px',\n            borderRadius: '8px',\n            backgroundColor: darkMode ? '#1f1f1f' : '#f5f5f5',\n            marginBottom: '20px'\n          }}>\n            <Typography.Title level={5} style={{ \n              color: darkMode ? '#fff' : '#000',\n              marginBottom: '16px'\n            }}>\n              Pro Feature\n            </Typography.Title>\n            <Typography.Paragraph style={{ \n              color: darkMode ? '#fff' : '#000',\n              marginBottom: '16px'\n            }}>\n              {proModalFeature.description}\n            </Typography.Paragraph>\n            <Typography.Paragraph style={{ \n              color: darkMode ? '#fff' : '#000'\n            }}>\n              Upgrade to Pro to unlock:\n              <ul style={{ marginTop: '8px' }}>\n                <li>Unlimited workflows</li>\n                <li>Advanced AI features</li>\n                <li>Import/Export capabilities</li>\n                <li>Template library</li>\n                <li>Priority support</li>\n              </ul>\n            </Typ