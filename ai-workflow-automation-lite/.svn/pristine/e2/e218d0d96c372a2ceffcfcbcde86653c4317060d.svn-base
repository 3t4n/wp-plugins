h: '100%', marginBottom: 8 }}\n          >\n            {field.options?.map(opt => (\n              <Option key={opt.value} value={opt.value}>{opt.label}</Option>\n            ))}\n          </Select>\n        );\n      }\n      \n      return (\n        <Input\n          className=\"nodrag\"\n          value={value}\n          onChange={(e) => handleFieldMapping(field.name, e.target.value)}\n          style={{ marginBottom: 8 }}\n        />\n      );\n    };\n\n    return (\n      <div style={{ marginBottom: 16 }}>\n        <Space style={{ width: '100%', justifyContent: 'space-between', marginBottom: 4 }}>\n          <Text strong>{field.label}</Text>\n          {supportsRichText && (\n            <Switch\n              checkedChildren=\"WYSIWYG\"\n              unCheckedChildren=\"Plain\"\n              checked={editorType === 'wysiwyg'}\n              onChange={() => toggleEditor(field.name)}\n              size=\"small\"\n            />\n          )}\n        </Space>\n        {inputElement()}\n        <NodeInputHandler\n          nodeId={id}\n          onInsert={(tag) => handleFieldMapping(field.name, (fieldMappings[field.name] || '') + tag)}\n        />\n      </div>\n    );\n  };\n\n  // Render field groups with improved spacing and organization\n  const renderFieldGroup = (fields, groupTitle) => {\n    if (!fields.length) return null;\n\n    return (\n      <Panel \n        header={\n          <Space>\n            {groupTitle === 'Core Fields' && <FileTextOutlined />}\n            {groupTitle === 'ACF Fields' && <FormOutlined />}\n            {groupTitle === 'WooCommerce Fields' && <ShopOutlined />}\n            <Text strong>{groupTitle}</Text>\n            <Tag color=\"blue\">{fields.length}</Tag>\n          </Space>\n        }\n      >\n        <div style={{ padding: '8px 0' }}>\n          {fields.map(field => renderFieldInput(field))}\n        </div>\n      </Panel>\n    );\n  };\n\n  // Rest of your component remains the same...\n\n  return (\n    <Card \n      title={\n        <Space>\n          <span>Create Post</span>\n          <Tag color={postStatus === 'publish' ? 'green' : postStatus === 'draft' ? 'orange' : 'blue'}>\n            {postStatus}\n          </Tag>\n        </Space>\n      }\n      extra={\n        <Button icon={<DeleteOutlined />} onClick={() => data.onDelete(id)} />\n      }\n      style={{ width: 400 }}\n    >\n      <Handle type=\"target\" position={Position.Left} isConnectable={isConnectable} />\n\n      <Space direction=\"vertical\" style={{ width: '100%' }}>\n        <Input\n          placeholder=\"Node Name\"\n          value={nodeName}\n          onChange={(e) => setNodeName(e.target.value)}\n          className=\"nodrag\"\n        />\n\n        <Select \n          style={{ width: '100%' }}\n          placeholder=\"Select Post Type\"\n          onChange={handlePostTypeChange}\n          value={selectedPostType}\n          loading={loading}\n          className=\"nodrag\"\n        >\n          {postTypes.map(type => (\n            <Option key={type.name} value={type.name}>{type.label}</Option>\n          ))}\n        </Select>\n\n        {selectedPostType && (\n          <Tabs defaultActiveKey=\"fields\">\n            <TabPane tab=\"Fields\" key=\"fields\">\n              {loading ? (\n                <div style={{ textAlign: 'center', padding: '20px' }}>\n                  <Spin />\n                </div>\n              ) : (\n                <Collapse defaultActiveKey={['core']} className=\"field-collapse\">\n                  {renderFieldGroup(postFields.core, 'Core Fields')}\n                  {renderFieldGroup(postFields.acf, 'ACF Fields')}\n                  {renderFieldGroup(postFields.woocommerce, 'WooCommerce Fields')}\n                </Collapse>\n              )}\n            </TabPane>\n            \n            <TabPane tab=\"Settings\" key=\"settings\">\n              <Space direction=\"vertical\" style={{ width: '100%' }}>\n                <Form.Item label=\"Post Status\">\n                  <Select \n                    value={postStatus}\n                    onChange={setPostStatus}\n                    className=\"nodrag\"\n                  >\n                    <Option value=\"publish\">Publish</Option>\n                    <Option value=\"draft\">Draft</Option>\n                    <Option value=\"future\">Schedule</Option>\n                    <Option value=\"private\">Private</Option>\n                  </Select>\n                </Form.Item>\n\n                {postStatus === 'future' && (\n                  <Form.Item label=\"Schedule Date\">\n                    <DatePicker \n                      showTime \n                      onChange={setScheduledDate}\n                      value={scheduledDate}\n                      style={{ width: '100%' }}\n                      disabledDate={current => current && current < dayjs().startOf('day')}\n                      className=\"nodrag\"\n                    />\n                  </Form.Item>\n                )}\n              </Space>\n            </TabPane>\n          </Tabs>\n        )}\n      </Space>\n\n      <Handle type=\"source\" position={Position.Right} id=\"a\" isConnectable={isConnectable} />\n    </Card>\n  );\n};\n\nexport default PostNode;","// This icon file is generated automatically.\nvar ReloadOutlined = { \"icon\": { \"tag\": \"svg\", \"attrs\": { \"viewBox\": \"64 64 896 896\", \"focusable\": \"false\" }, \"children\": [{ \"tag\": \"path\", \"attrs\": { \"d\": \"M909.1 209.3l-56.4 44.1C775.8 155.1 656.2 92 521.9 92 290 92 102.3 279.5 102 511.5 101.7 743.7 289.8 932 521.9 932c181.3 0 335.8-115 394.6-276.1 1.5-4.2-.7-8.9-4.9-10.3l-56.7-19.5a8 8 0 00-10.1 4.8c-1.8 5-3.8 10-5.9 14.9-17.3 41-42.1 77.8-73.7 109.4A344.77 344.77 0 01655.9 829c-42.3 17.9-87.4 27-133.8 27-46.5 0-91.5-9.1-133.8-27A341.5 341.5 0 01279 755.2a342.16 342.16 0 01-73.7-109.4c-17.9-42.4-27-87.4-27-133.9s9.1-91.5 27-133.9c17.3-41 42.1-77.8 73.7-109.4 31.6-31.6 68.4-56.4 109.3-73.8 42.3-17.9 8