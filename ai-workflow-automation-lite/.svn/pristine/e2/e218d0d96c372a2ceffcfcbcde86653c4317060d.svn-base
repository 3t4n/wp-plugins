    display: 'flex',\n      flexDirection: 'column',\n      gap: '10px',\n      background: 'white',\n      padding: '8px',\n      borderRadius: '8px',\n      boxShadow: '0 2px 8px rgba(0,0,0,0.1)',\n      zIndex: 5\n    }}>\n      <Tooltip title=\"Drag to add Sticky Note\" placement=\"left\">\n        <Button \n          icon={<FormOutlined />}\n          className=\"nodrag annotation-button\"\n          draggable\n          onDragStart={(e) => {\n            e.dataTransfer.setData('application/reactflow', 'stickyNote');\n            e.dataTransfer.effectAllowed = 'move';\n          }}\n          style={{ cursor: 'grab' }}\n        />\n      </Tooltip>\n      <Tooltip title=\"Drag to add Text\" placement=\"left\">\n        <Button \n          icon={<FontSizeOutlined />}\n          className=\"nodrag annotation-button\"\n          draggable\n          onDragStart={(e) => {\n            e.dataTransfer.setData('application/reactflow', 'textAnnotation');\n            e.dataTransfer.effectAllowed = 'move';\n          }}\n          style={{ cursor: 'grab' }}\n        />\n      </Tooltip>\n      <Tooltip title=\"Drag to add Shape\" placement=\"left\">\n        <Button \n          icon={<BorderOutlined />}\n          className=\"nodrag annotation-button\"\n          draggable\n          onDragStart={(e) => {\n            e.dataTransfer.setData('application/reactflow', 'shape');\n            e.dataTransfer.effectAllowed = 'move';\n          }}\n          style={{ cursor: 'grab' }}\n        />\n      </Tooltip>\n    </div>\n  );\n};\n\nconst StickyNote = ({ data, id, selected }) => {\n  // Use data values as initial state\n  const [content, setContent] = useState(data.content || '');\n  const [color, setColor] = useState(data.color || '#fff9c4');\n  const [size, setSize] = useState(data.size || { width: 200, height: 150 });\n  \n\n  const handleResize = (e, direction, ref, d) => {\n\n    const newSize = {\n      width: size.width + d.width,\n      height: size.height + d.height\n    };\n    setSize(newSize);\n    // Make sure we're calling updateNodeData after resize\n    data.onChange?.(id, { size: newSize });\n  };\n\n  return (\n    <Resizable\n      size={size}\n      onResizeStop={handleResize}\n      minWidth={150}\n      minHeight={100}\n      handleStyles={resizeHandleStyles}\n      handleClasses={{ bottom: 'nodrag', right: 'nodrag', bottomRight: 'nodrag' }}\n      className=\"react-flow-annotation\"\n      style={{ position: 'relative', zIndex: -1, isolation: 'isolate' }}\n    >\n      <div style={{\n        backgroundColor: color,\n        padding: '15px',\n        height: '100%',\n        boxShadow: '3px 3px 8px rgba(0,0,0,0.1)',\n        borderRadius: '3px',\n        fontSize: '14px',\n        border: selected ? '2px solid #1890ff' : '1px solid #e8e8e8',\n        cursor: 'move',\n        position: 'relative'\n      }}\n      onMouseEnter={(e) => {\n        const deleteButton = e.currentTarget.querySelector('.delete-button');\n        if (deleteButton) deleteButton.style.opacity = '1';\n      }}\n      onMouseLeave={(e) => {\n        const deleteButton = e.currentTarget.querySelector('.delete-button');\n        if (deleteButton) deleteButton.style.opacity = '0';\n      }}\n      >\n        <DeleteButton onClick={() => data.onDelete?.(id)} />\n        <TextArea\n          value={content}\n          onChange={(e) => {\n            setContent(e.target.value);\n            data.onChange?.(id, { content: e.target.value });\n          }}\n          style={{\n            border: 'none',\n            background: 'transparent',\n            width: '100%',\n            minHeight: '80px',\n            resize: 'none'\n          }}\n          className=\"nodrag\"\n          autoSize={{ minRows: 3, maxRows: 10 }}\n          placeholder=\"Add your note here...\"\n        />\n        <div style={{ marginTop: '8px', display: 'flex', gap: '4px' }}>\n          {['#fff9c4', '#f8bbd0', '#b3e5fc', '#c8e6c9', '#e1bee7'].map((c) => (\n            <div\n              key={c}\n              onClick={() => {\n                setColor(c);\n                data.onChange?.(id, { color: c });\n              }}\n              style={{\n                width: '16px',\n                height: '16px',\n                backgroundColor: c,\n                borderRadius: '50%',\n                cursor: 'pointer',\n                border: color === c ? '2px solid #1890ff' : '1px solid #e8e8e8'\n              }}\n              className=\"nodrag\"\n            />\n          ))}\n        </div>\n      </div>\n    </Resizable>\n  );\n};\n\nconst TextAnnotation = ({ data, id, selected }) => {\n  const [content, setContent] = useState(data.content || '');\n  const [fontSize, setFontSize] = useState(data.fontSize || 14);\n  const [size, setSize] = useState(data.size || { width: 200, height: 'auto' });\n\n\n  const handleResize = (e, direction, ref, d) => {\n\n    const newSize = {\n      width: size.width + d.width,\n      height: 'auto'\n    };\n    setSize(newSize);\n    // Make sure we're calling updateNodeData after resize\n    data.onChange?.(id, { size: newSize });\n  };\n\n  return (\n    <Resizable\n      size={size}\n      onResizeStop={handleResize}\n      minWidth={100}\n      handleStyles={resizeHandleStyles}\n      handleClasses={{ right: 'nodrag' }}\n      enable={{ right: true, bottom: false, bottomRight: false }}\n      className=\"react-flow-annotation\"\n      style={{ position: 'relative', zIndex: -1, isolation: 'isolate' }}\n    >\n      <div style={{\n        border: selected ? '2px solid #1890ff' : '1px solid transparent',\n        padding: '8px',\n        borderRadius: '4px',\n        cursor: 'move',\n        position: 'relative',\n        background: 'transparent'\n      }}\n      onMouseEnter={(e) => {\n        const deleteButton = e.currentTarget.querySelector('.delete-button');\n        if (deleteButton) deleteButton.style.opacity = '1';\n      }}\n      onMouseLeave={(e) => {\n        const deleteButton = e.currentTarget.querySelector('.delete-button');\n        if (deleteButton) deleteButton.style.opacity = '0';\n      }}\n      >\n        <DeleteButton onClick={() => data.onDelete?.(id)} />\n        <Input\n          value={content}\n          onChange={(e) => {\n            setContent(e.target.value);\n            data.onChange?.(id, { content: e.target.value });\n          }}\n          style={{\n            border: 'none',\n            background: 'transparent',\n            fontSize: `${fontSize}px`,\n            width: '100%',\n            padding: '4px'\n          }}\n          className=\"nodrag\"\n          placeholder=\"Add text...\"\n        />\n        {selected && (\n          <Slider\n            min={12}\n            max={32}\n            value={fontSize}\n            onChange={(value) => {\n              setFontSize(value);\n              data.onChange?.(id, { fontSize: value });\n            }}\n            style={{ width: '100px', marginTop: '4px' }}\n            className=\"nodrag\"\n          />\n        )}\n      </div>\n    </Resizable>\n  );\n};\n\nconst Shape = ({ data, id, selected }) => {\n  const [shapeType, setShapeType] = useState(data.shapeType || 'rectangle');\n  const [color, setColor] = useState(data.color || '#e8e8e8');\n  const [size, setSize] = useState(data.size || { width: 100, height: 100 });\n\n  const handleResize = (e, direction, ref, d) => {\n    const newSize = {\n      width: size.width + d.width,\n      height: size.height + d.height\n    };\n    setSize(newSize);\n    // Make sure we're calling updateNodeData after resize\n    data.onChange?.(id, { size: newSize });\n  };\n\n  const shapeStyles = {\n    rectangle: {\n      width: '100%',\n      height: '100%',\n      backgroundColor: color,\n      border: selected ? '2px solid #1890ff' : '1px solid #e8e8e8'\n    },\n    circle: {\n      width: '100%',\n      height: '100%',\n      backgroundColor: color,\n      borderRadius: '50%',\n      border: selected ? '2px solid #1890ff' : '1px solid #e8e8e8'\n    },\n    triangle: {\n      width: '100%',\n      height: '100%',\n      clipPath: 'polygon(50% 0%, 0% 100%, 100% 100%)',\n      backgroundColor: color\n    }\n  };\n\n  return (\n    <Resizable\n      size={size}\n      onResizeStop={handleResize}\n      minWidth={30}\n      minHeight={30}\n      handleStyles={resizeHandleStyles}\n      handleClasses={{ bottom: 'nodrag', right: 'nodrag', bottomRight: 'nodrag' }}\n      className=\"react-flow-annotation\"\n      style={{ position: 'relative', zIndex: -1, isolation: 'isolate' }}\n    >\n      <div style={{ \n        height: '100%',\n        cursor: 'move',\n        position: 'relative'\n      }}\n      onMouseEnter={(e) => {\n        const deleteButton = e.currentTarget.querySelector('.delete-button');\n        if (deleteButton) deleteButton.style.opacity = '1';\n      }}\n      onMouseLeave={(e) => {\n        const deleteButton = e.currentTarget.querySelector('.delete-button');\n        if (deleteButton) deleteButton.style.opacity = '0';\n      }}\n      >\n        <DeleteButton onClick={() => data.onDelete?.(id)} />\n        {selected && (\n          <div style={{ \n            marginBottom: '8px',\n            position: 'absolute',\n            top: -40,\n            left: 0,\n            background: 'white',\n            padding: '4px',\n            borderRadius: '4px',\n            boxShadow: '0 2px 8px rgba(0,0,0,0.1)',\n            zIndex: 1\n          }} className=\"nodrag\">\n            <Select\n              value={shapeType}\n              onChange={(value) => {\n                setShapeType(value);\n                data.onChange?.(id, { shapeType: value });\n              }}\n              style={{ width: '120px', marginRight: '8px' }}\n              className=\"nodrag\"\n            >\n              <Option value=\"rectangle\">Rectangle</Option>\n              <Option value=\"circle\">Circle</Option>\n              <Option value=\"triangle\">Triangle</Option>\n            </Select>\n            <ColorPicker\n              value={color}\n              onChange={(value) => {\n                setColor(value.toHexString());\n                data.onChange?.(id, { color: value.toHexString() });\n              }}\n              className=\"nodrag\"\n            />\n          </div>\n        )}\n        <div style={shapeStyles[shapeType]} />\n      </div>\n    </Resizable>\n  );\n};\n\nexport { AnnotationToolbar, StickyNote, TextAnnotation, Shape };","import React, { useState, useCallback, useEffect, useRef } from 'react';\nimport {\n  ReactFlow,\n  MiniMap,\n  Controls,\n  Background,\n  useNodesState,\n  useEdgesState,\n  addEdge,\n  useReactFlow,\n  ReactFlowProvider\n} from '@xyflow/react';\nimport '@xyflow/react/dist/style.css';\nimport { Button, message, Modal, Input, Form, Switch } from 'antd';\nimport {BulbOutlined, SunOutlined, MoonOutlined } from '@ant-design/icons';\nimport Sidebar from './Sidebar';\nimport TriggerNode from './nodes/TriggerNode';\nimport AIModelNode from './nodes/AIModelNode';\nimport OutputNode from './nodes/OutputNode';\nimport PostNode from './nodes/PostNode';\nimport UnsplashNode from './nodes/UnsplashNode';\nimport ChatNode from './nodes/ChatNode';\nimport WorkflowNameHeader from './WorkflowNameHeader';\nimport CustomEdge from './CustomEdge';\nimport { AnnotationToolbar, StickyNote, TextAnnotation, Shape } from './AnnotationTools';\nimport axios from 'axios';\nimport config from '../config';\nimport { adminInstance } from './api/axiosConfig';\n\nconst nodeTypes = {\n  trigger: TriggerNode,\n  aiModel: AIModelNode,\n  output: OutputNode,\n  post: PostNode,\n  unsplash: UnsplashNode,\n  chat: ChatNode,\n  stickyNote: StickyNote,\n  textAnnotation: TextAnnotation,\n  shape: Shape\n};\n\nconst edgeTypes = {\n  default: CustomEdge,\n};\n\nconst WorkflowBuilderInner = () => {\n  const [nodes, setNodes, onNodesChange] = useNodesState([]);\n  const [edges, setEdges, onEdgesChange] = useEdgesState([]);\n  const [isModalVisible, setIsModalVisible] = useState(false);\n  const [workflowName, setWorkflowName] = useState('');\n  const [isEditMode, setIsEditMode] = useState(false);\n  const [workflowId, setWorkflowId] = useState(null);\n  const reactFlowWrapper = useRef(null);\n  const [reactFlowInstance, setReactFlowInstance] = useState(null);\n  const { setViewport } = useReactFlow();\n  const [isExecuting, setIsExecuting] = useState(false);\n  const [isSavedWorkflow, setIsSavedWorkflow] = useState(false);\n  const [workflowCount, setWorkflowCount] = useState(0);\n  const [colorMode, setColorMode] = useState('light');\n  const WORKFLOW_LIMIT = 3;\n\n  const updateNodeData = useCallback((nodeId, newData) => {\n    setNodes((nds) =>\n      nds.map((node) => {\n        if (node.id === nodeId) {\n          return {\n            ...node,\n            data: { \n              ...node.data, \n              ...newData,\n              workflowId: workflowId\n            },\n          };\n        }\n        return node;\n      })\n    );\n  }, [setNodes, workflowId, nodes]);\n\n  const toggleDarkMode = useCallback(() => {\n    setColorMode((prev) => prev === 'light' ? 'dark' : 'light');\n  }, []);\n\n  useEffect(() => {\n    const savedMode = localStorage.getItem('wp-ai-workflows-color-mode');\n    if (savedMode) {\n      setColorMode(savedMode);\n    }\n  }, []);\n\n  useEffect(() => {\n    localStorage.setItem('wp-ai-workflows-color-mode', colorMode);\n  }, [colorMode]);\n  \n  useEffect(() => {\n    fetchWorkflowCount();\n    console.log(\"Component mounted. Checking for existing workflow data...\");\n    const settings = window.wpAiWorkflowsSettings || {};\n    const { page, workflowData } = settings;\n  \n    if (page === 'edit' && workflowData) {\n      console.log(\"Loading existing workflow...\");\n      if (Array.isArray(workflowData.nodes)) {\n        setNodes(workflowData.nodes.map(node => {\n          // Restore handlers for annotation nodes\n          if (['stickyNote', 'textAnnotation', 'shape'].includes(node.type)) {\n            return {\n              ...node,\n              data: {\n                ...node.data,\n                onChange: (id, updates) => {\n                  setNodes(nds => \n                    nds.map(node => \n                      node.id === id \n                        ? { \n                            ...node, \n                            data: { \n                              ...node.data, \n                              ...updates,\n                              onChange: node.data.onChange,\n                              onDelete: node.data.onDelete \n                            } \n                          }\n                        : node\n                    )\n                  );\n                },\n                onDelete: (id) => setNodes((nds) => nds.filter((n) => n.id !== id))\n              }\n            };\n          }\n          // Handle other node types\n          return {\n            ...node,\n            data: {\n              ...node.data,\n              updateNodeData,\n              onDelete: (id) => setNodes((nds) => nds.filter((n) => n.id !== id)),\n              workflowId: workflowData.id\n            }\n          };\n        }));\n        setEdges(workflowData.edges || []);\n        setWorkflowName(workflowData.name || '');\n        setWorkflowId(workflowData.id || null);\n        setIsEditMode(true);\n        if (workflowData.viewport) {\n          setViewport(workflowData.viewport);\n        }\n      } else {\n        console.error(\"Invalid workflow data: nodes is not an array\", workflowData);\n      }\n    } else {\n      setNodes([\n        { \n          id: 'trigger-1', \n          type: 'trigger', \n          position: { x: 250, y: 25 }, \n          data: { \n            label: 'Trigger Node', \n            updateNodeData,\n            onDelete: (id) => {\n              setNodes((nds) => nds.filter((node) => node.id !== id));\n            },\n            triggerType: '',\n            content: '',\n            selectedForm: null,\n            selectedFields: []\n          }\n        }\n      ]);\n    }\n  }, []);\n\n  const fetchWorkflowCount = async () => {\n    try {\n      const response = await axios.get(`${config.apiSettings.root}wp-ai-workflows/v1/workflows`, {\n        headers: {\n          'X-WP-Nonce': config.apiSettings.nonce\n        }\n      });\n      setWorkflowCount(response.data.count);\n    } catch (error) {\n      console.error('Error fetching workflow count:', error);\n    }\n  };\n\n  const onConnect = useCallback((params) => {\n    // First check if this connection would create a cycle\n    if (wouldCreateCycle(edges, params)) {\n      message.error('Cannot create connection: This would create a loop in the workflow');\n      return;\n    }\n    \n    // If no cycle would be created, add the edge\n    setEdges((eds) => addEdge(params, eds));\n  }, [edges, setEdges]);\n\n  const handleEdgeDelete = useCallback((edgeId) => {\n    setEdges((eds) => eds.filter((e) => e.id !== edgeId));\n  }, [setEdges]);\n\n  const onDragOver = useCallback((event) => {\n    event.preventDefault();\n    event.dataTransfer.dropEffect = 'move';\n  }, []);\n\n  const hasCycle = (graph, start, visited = new Set(), recursionStack = new Set()) => {\n    visited.add(start);\n    recursionStack.add(start);\n  \n    // Get all nodes this node connects to\n    const neighbors = graph[start] || [];\n    \n    for (const neighbor of neighbors) {\n      if (!visited.has(neighbor)) {\n        if (hasCycle(graph, neighbor, visited, recursionStack)) {\n          return true;\n        }\n      } else if (recursionStack.has(neighbor)) {\n        return true;\n      }\n    }\n  \n    recursionStack.delete(start);\n    return false;\n  };\n  \n  // Create adjacency list from edges\n  const createGraph = (edges) => {\n    const graph = {};\n    edges.forEach(edge => {\n      if (!graph[edge.source]) {\n        graph[edge.source] = [];\n      }\n      graph[edge.source].push(edge.target);\n    });\n    return graph;\n  };\n  \n  // Check if adding a new edge would create a cycle\n  const wouldCreateCycle = (edges, newEdge) => {\n    // Add the new edge to existing edges\n    const allEdges = [...edges, newEdge];\n    const graph = createGraph(allEdges);\n    \n    // Check for cycles starting from the source of new edge\n    return hasCycle(graph, newEdge.source);\n  };\n\n  const onDrop = useCallback(\n    (event) => {\n      event.preventDefault();\n  \n      const reactFlowBounds = reactFlowWrapper.current.getBoundingClientRect();\n      const type = event.dataTransfer.getData('application/reactflow');\n  \n      const position = reactFlowInstance.screenToFlowPosition({\n        x: event.clientX - reactFlowBounds.left,\n        y: event.clientY - reactFlowBounds.top,\n      });\n  \n      let newNode;\n  \n      // Handle annotation nodes\n      switch (type) {\n        case 'stickyNote':\n          newNode = {\n            id: `note-${Date.now()}`,\n            type,\n            position,\n            data: { \n              content: '',\n              color: '#fff9c4',\n              size: { width: 200, height: 150 },\n              onChange: (id, updates) => {\n                setNodes(nds => \n                  nds.map(node => \n                    node.id === id \n                      ? { \n                          ...node, \n                          data: { \n                            ...node.data, \n                            ...updates,\n                            onChange: node.data.onChange,\n                            onDelete: node.data.onDelete \n                          } \n                        }\n                      : node\n                  )\n                );\n              },\n              onDelete: (id) => {\n                setNodes(nds => nds.filter(node => node.id !== id));\n              }\n            },\n            draggable: true,\n            className: 'react-flow-annotation',\n            zIndex: -1\n          };\n          break;\n  \n        case 'textAnnotation':\n          newNode = {\n            id: `text-${Date.now()}`,\n            type,\n            position,\n            data: {\n              content: '',\n              fontSize: 14,\n              size: { width: 200, height: 'auto' },\n              onChange: (id, updates) => {\n                setNodes(nds => \n                  nds.map(node => \n                    node.id === id \n                      ? { \n                          ...node, \n                          data: { \n                            ...node.data, \n                            ...updates,\n                            onChange: node.data.onChange,\n                            onDelete: node.data.onDelete \n                          } \n                        }\n                      : node\n                  )\n                );\n              },\n              onDelete: (id) => {\n                setNodes(nds => nds.filter(node => node.id !== id));\n              }\n            },\n            draggable: true,\n            className: 'react-flow-annotation',\n            zIndex: -1\n          };\n          break;\n  \n        case 'shape':\n          newNode = {\n            id: `shape-${Date.now()}`,\n            type,\n            position,\n            data: {\n              shapeType: 'rectangle',\n              color: '#e8e8e8',\n              size: { width: 100, height: 100 },\n              onChange: (id, updates) => {\n                setNodes(nds => \n                  nds.map(node => \n                    node.id === id \n                      ? { \n                          ...node, \n                          data: { \n                            ...node.data, \n                            ...updates,\n                            onChange: node.data.onChange,\n                            onDelete: node.data.onDelete \n                          } \n                        }\n                      : node\n                  )\n                );\n              },\n              onDelete: (id) => {\n                setNodes(nds => nds.filter(node => node.id !== id));\n              }\n            },\n            draggable: true,\n            className: 'react-flow-annotation',\n            zIndex: -1\n          };\n          break;\n  \n        default:\n          // Handle regular workflow nodes\n          newNode = {\n            id: `${type}-${Date.now()}`,\n            type,\n            position,\n            draggable: true,\n            data: { \n              updateNodeData,\n              onDelete: (id) => setNodes((nds) => nds.filter((n) => n.id !== id)),\n            },\n          };\n      }\n  \n      setNodes((nds) => nds.concat(newNode));\n    },\n    [reactFlowInstance, updateNodeData]\n  );\n\n  const onSave = useCallback(() => {\n    setIsModalVisible(true);\n  }, []);\n\n  const onUpdate = useCallback(async () => {\n    if (!workflowId) {\n      message.error('Cannot update: No workflow ID found');\n      return;\n    }\n    try {\n      const flow = reactFlowInstance.toObject();\n      const updatedWorkflow = {\n        id: workflowId,\n        name: workflowName,\n        nodes: flow.nodes,\n        edges: flow.edges,\n        viewport: flow.viewport\n      };\n      const response = await axios.put(`${config.apiSettings.root}wp-ai-workflows/v1/workflows/${workflowId}`, updatedWorkflow, {\n        headers: {\n          'X-WP-Nonce': config.apiSettings.nonce\n        }\n      });\n      if (response.data) {\n        message.success('Workflow updated successfully');\n      }\n    } catch (error) {\n      console.error('Error updating workflow:', error);\n      message.error('Failed to update workflow');\n    }\n  }, [workflowId, workflowName, reactFlowInstance]);\n\n  const handleSaveWorkflow = async () => {\n    if (!workflowName.trim()) {\n      message.error('Please enter a workflow name');\n      return;\n    }\n\n    if (!isEditMode && workflowCount >= WORKFLOW_LIMIT) {\n      Modal.error({\n        title: 'Workflow Limit Reached',\n        content: (\n          <div>\n            <p>You've reached the maximum number of workflows (3) in the Lite version.</p>\n            <p>Please upgrade to Pro for unlimited workflows and advanced features!</p>\n          </div>\n        ),\n        okText: 'Upgrade to Pro',\n        onOk: () => {\n          window.open('https://wpaiworkflowautomation.com/#pricing', '_blank');\n        },\n      });\n      return;\n    }\n\n    try {\n      const method = workflowId ? 'put' : 'post';\n      const url = workflowId\n        ? `${config.apiSettings.root}wp-ai-workflows/v1/workflows/${workflowId}`\n        : `${config.apiSettings.root}wp-ai-workflows/v1/workflows`;\n      \n      const flow = reactFlowInstance.toObject();\n      \n      // Preserve annotation data by explicitly including it\n      const annotationNodes = flow.nodes.map(node => {\n        if (['stickyNote', 'textAnnotation', 'shape'].includes(node.type)) {\n          return {\n            ...node,\n            data: {\n              ...node.data,\n              content: node.data.content,\n              color: node.data.color,\n              size: node.data.size,\n              fontSize: node.data.fontSize,\n              shapeType: node.data.shapeType\n            }\n          };\n        }\n        return node;\n      });\n  \n      const workflowData = {\n        id: workflowId,\n        name: workflowName,\n        nodes: annotationNodes,\n        edges: flow.edges,\n        viewport: flow.viewport\n      };\n\n      console.log('Final workflow data being saved:', workflowData);\n  \n      const response = await axios[method](url, workflowData, {\n        headers: {\n          'X-WP-Nonce': config.apiSettings.nonce\n        }\n      });\n  \n      if (response.data && response.data.id) {\n        const newWorkflowId = response.data.id;\n        setWorkflowId(newWorkflowId);\n        setIsSavedWorkflow(true);\n  \n        // Update nodes with the new workflowId and preserve annotation data\n        const updatedNodes = annotationNodes.map(node => {\n          if (node.type === 'output' || node.type === 'chat') {\n            return {\n              ...node,\n              data: {\n                ...node.data,\n                workflowId: newWorkflowId\n              }\n            };\n          }\n          return node;\n        });\n  \n        reactFlowInstance.setNodes(updatedNodes);\n      }\n  \n      message.success('Workflow saved successfully');\n      setIsModalVisible(false);\n    } catch (error) {\n      console.error('Error saving workflow:', error);\n      message.error('Failed to save workflow: ' + (error.response?.data?.message || error.message));\n    }\n  };\n\n  const executeWorkflow = async () => {\n    if (!workflowId) {\n      message.error('Please save the workflow before executing');\n      return;\n    }\n\n    setIsExecuting(true);\n\n    try {\n      const response = await axios.post(\n        `${config.apiSettings.root}wp-ai-workflows/v1/execute-workflow/${workflowId}`,\n        {\n          nodes: nodes,\n          edges: edges,\n        },\n        {\n          headers: {\n            'X-WP-Nonce': config.apiSettings.nonce,\n            'Content-Type': 'application/json'\n          }\n        }\n      );\n\n      console.log('Workflow execution response:', response.data);\n\n      if (response.data && response.data.nodes) {\n        const updatedNodes = nodes.map(node => {\n          const executionResult = response.data.nodes.find(n => n.id === node.id);\n          if (executionResult) {\n            return {\n              ...node,\n              data: {\n                ...node.data,\n                displayOutput: executionResult.data.content,\n                output: executionResult.data.content,\n                isExecuting: false\n              }\n            };\n          }\n          return node;\n        });\n\n        setNodes(updatedNodes);\n        message.success('Workflow executed successfully');\n      }\n    } catch (error) {\n      console.error('Error executing workflow:', error);\n      message.error('Failed to execute workflow: ' + (error.response?.data?.message || error.message));\n    } finally {\n      setIsExecuting(false);\n    }\n  };\n\n  return (\n    <div\n    className=\"reactflow-wrapper\" \n    style={{ \n      height: '90vh',\n      position: 'relative'\n    }}>\n      <div style={{ \n        display: 'flex',\n        height: '100%',\n      }}>\n        {/* Sidebar */}\n        <div style={{ \n          width: '250px', \n          borderRight: '1px solid #ddd', \n          height: '100%', \n          zIndex: 5,\n          flexShrink: 0\n        }}>\n          <Sidebar\n            updateNodeData={updateNodeData}\n            onSave={onSave}\n            onExecute={executeWorkflow}\n            onUpdate={onUpdate}\n            isEditMode={isEditMode}\n            isExecuting={isExecuting}\n            isSavedWorkflow={isSavedWorkflow}\n            nodes={nodes}\n            edges={edges}\n            workflowName={workflowName}\n            darkMode={colorMode === 'dark'}\n          />\n        </div>\n  \n        {/* Right side container */}\n        <div style={{ \n          flex: 1, \n          position: 'relative',\n          height: '100%',\n          overflow: 'hidden'\n        }}>\n          {/* Name header */}\n          <WorkflowNameHeader\n          initialName={workflowName}\n          isEditMode={isEditMode}\n          onNameChange={(newName) => {\n            setWorkflowName(newName);\n            if (isEditMode || isSavedWorkflow) {\n              const flow = reactFlowInstance.toObject();\n              const updatedWorkflow = {\n                id: workflowId,\n                name: newName,\n                nodes: flow.nodes,\n                edges: flow.edges,\n                viewport: flow.viewport\n              };\n              \n              adminInstance.put(`${config.apiSettings.root}wp-ai-workflows/v1/workflows/${workflowId}`, \n                updatedWorkflow,\n                {\n                  headers: {\n                    'X-WP-Nonce': config.apiSettings.nonce\n                  }\n                }\n              ).then(() => {\n                message.success('Workflow name updated successfully');\n              }).catch((error) => {\n                console.error('Error updating workflow name:', error);\n                message.error('Failed to update workflow name');\n              });\n            }\n          }}\n        />\n  \n          {/* Flow container */}\n          <div style={{ \n            height: '100%',\n            width: '100%'\n          }} ref={reactFlowWrapper}>\n          <ReactFlow\n            nodes={nodes}\n            edges={edges.map(edge => ({\n              ...edge,\n              data: { \n                onDelete: handleEdgeDelete,\n                colorMode: colorMode\n              }\n            }))}\n            onNodesChange={onNodesChange}\n            onEdgesChange={onEdgesChange}\n            onConnect={onConnect}\n            onInit={setReactFlowInstance}\n            onDrop={onDrop}\n            onDragOver={onDragOver}\n            nodeTypes={nodeTypes}\n            colorMode={colorMode}\n            edgeTypes={edgeTypes}\n            defaultEdgeOptions={{ \n              type: 'default',\n              animated: false\n            }}\n          >\n            <Controls />\n            <MiniMap pannable />\n            <Background variant=\"dots\" gap={12} size={1} />\n            \n              <AnnotationToolbar />\n            \n          </ReactFlow>\n          </div>\n        </div>\n      </div>\n\n      <Modal\n        className=\"workflow-name-input\"\n        title=\"Save Workflow\"\n        visible={isModalVisible}\n        onOk={handleSaveWorkflow}\n        onCancel={() => setIsModalVisible(false)}\n      >\n        <Input\n          placeholder=\"Enter workflow name\"\n          value={workflowName}\n          onChange={(e) => setWorkflowName(e.target.value)}\n        />\n      </Modal>\n\n      <div style={{ position: 'fixed', bottom: 20, right: 20, zIndex: 1000, display: 'flex', gap: '12px', alignItems: 'center' }}>\n      <Switch\n        checked={colorMode === 'dark'}\n        onChange={toggleDarkMode}\n        checkedChildren={<MoonOutlined />}\n        unCheckedChildren={<SunOutlined />}\n      />\n      \n      <Button\n        type=\"primary\"\n        icon={<BulbOutlined />}\n        onClick={() => window.open('https://wpaiworkflowautomation.com/docs/', '_blank')}\n      >\n        Documentation\n      </Button>\n      </div>\n    </div>\n  );\n};\n\nconst WorkflowBuilder = () => (\n  <ReactFlowProvider>\n    <WorkflowBuilderInner />\n  </ReactFlowProvider>\n);\n\nexport default WorkflowBuilder;","import { Keyframes, unit } from '@ant-design/cssinjs';\nimport { resetComponent } from '../../style';\nimport { genPresetColor, genStyleHooks, mergeToken } from '../../theme/internal';\nconst antStatusProcessing = new Keyframes('antStatusProcessing', {\n  '0%': {\n    transform: 'scale(0.8)',\n    opacity: 0.5\n  },\n  '100%': {\n    transform: 'scale(2.4)',\n    opacity: 0\n  }\n});\nconst antZoomBadgeIn = new Keyframes('antZoomBadgeIn', {\n  '0%': {\n    transform: 'scale(0) translate(50%, -50%)',\n    opacity: 0\n  },\n  '100%': {\n    transform: 'scale(1) translate(50%, -50%)'\n  }\n});\nconst antZoomBadgeOut = new Keyframes('antZoomBadgeOut', {\n  '0%': {\n    transform: 'scale(1) translate(50%, -50%)'\n  },\n  '100%': {\n    transform: 'scale(0) translate(50%, -50%)',\n    opacity: 0\n  }\n});\nconst antNoWrapperZoomBadgeIn = new Keyframes('antNoWrapperZoomBadgeIn', {\n  '0%': {\n    transform: 'scale(0)',\n    opacity: 0\n  },\n  '100%': {\n    transform: 'scale(1)'\n  }\n});\nconst antNoWrapperZoomBadgeOut = new Keyframes('antNoWrapperZoomBadgeOut', {\n  '0%': {\n    transform: 'scale(1)'\n  },\n  '100%': {\n    transform: 'scale(0)',\n    opacity: 0\n  }\n});\nconst antBadgeLoadingCircle = new Keyframes('antBadgeLoadingCircle', {\n  '0%': {\n    transformOrigin: '50%'\n  },\n  '100%': {\n    transform: 'translate(50%, -50%) rotate(360deg)',\n    transformOrigin: '50%'\n  }\n});\nconst genSharedBadgeStyle = token => {\n  const {\n    componentCls,\n    iconCls,\n    antCls,\n    badgeShadowSize,\n    textFontSize,\n    textFontSizeSM,\n    statusSize,\n    dotSize,\n    textFontWeight,\n    indicatorHeight,\n    indicatorHeightSM,\n    marginXS,\n    calc\n  } = token;\n  const numberPrefixCls = `${antCls}-scroll-number`;\n  const colorPreset = genPresetColor(token, (colorKey, _ref) => {\n    let {\n      darkColor\n    } = _ref;\n    return {\n      [`&${componentCls} ${componentCls}-color-${colorKey}`]: {\n        background: darkColor,\n        [`&:not(${componentCls}-count)`]: {\n          color: darkColor\n        },\n        'a:hover &': {\n          background: darkColor\n        }\n      }\n    };\n  });\n  return {\n    [componentCls]: Object.assign(Object.assign(Object.assign(Object.assign({}, resetComponent(token)), {\n      position: 'relative',\n      display: 'inline-block',\n      width: 'fit-content',\n      lineHeight: 1,\n      [`${componentCls}-count`]: {\n        display: 'inline-flex',\n        justifyContent: 'center',\n        zIndex: token.indicatorZIndex,\n        minWidth: indicatorHeight,\n        height: indicatorHeight,\n        color: token.badgeTextColor,\n        fontWeight: textFontWeight,\n        fontSize: textFontSize,\n        lineHeight: unit(indicatorHeight),\n        whiteSpace: 'nowrap',\n        textAlign: 'center',\n        background: token.badgeColor,\n        borderRadius: calc(indicatorHeight).div(2).equal(),\n        boxShadow: `0 0 0 ${unit(badgeShadowSize)} ${token.badgeShadowColor}`,\n        transition: `background ${token.motionDurationMid}`,\n        a: {\n          color: token.badgeTextColor\n        },\n        'a:hover': {\n          color: token.badgeTextColor\n        },\n        'a:hover &': {\n          background: token.badgeColorHover\n        }\n      },\n      [`${componentCls}-count-sm`]: {\n        minWidth: indicatorHeightSM,\n        height: indicatorHeightSM,\n        fontSize: textFontSizeSM,\n        lineHeight: unit(indicatorHeightSM),\n        borderRadius: calc(indicatorHeightSM).div(2).equal()\n      },\n      [`${componentCls}-multiple-words`]: {\n        padding: `0 ${unit(token.paddingXS)}`,\n        bdi: {\n          unicodeBidi: 'plaintext'\n        }\n      },\n      [`${componentCls}-dot`]: {\n        zIndex: token.indicatorZIndex,\n        width: dotSize,\n        minWidth: dotSize,\n        height: dotSize,\n        background: token.badgeColor,\n        borderRadius: '100%',\n        boxShadow: `0 0 0 ${unit(badgeShadowSize)} ${token.badgeShadowColor}`\n      },\n      [`${componentCls}-count, ${componentCls}-dot, ${numberPrefixCls}-custom-component`]: {\n        position: 'absolute',\n        top: 0,\n        insetInlineEnd: 0,\n        transform: 'translate(50%, -50%)',\n        transformOrigin: '100% 0%',\n        [`&${iconCls}-spin`]: {\n          animationName: antBadgeLoadingCircle,\n          animationDuration: '1s',\n          animationIterationCount: 'infinite',\n          animationTimingFunction: 'linear'\n        }\n      },\n      [`&${componentCls}-status`]: {\n        lineHeight: 'inherit',\n        verticalAlign: 'baseline',\n        [`${componentCls}-status-dot`]: {\n          position: 'relative',\n          top: -1,\n          // Magic number, but seems better experience\n          display: 'inline-block',\n          width: statusSize,\n          height: statusSize,\n          verticalAlign: 'middle',\n          borderRadius: '50%'\n        },\n        [`${componentCls}-status-success`]: {\n          backgroundColor: token.colorSuccess\n        },\n        [`${componentCls}-status-processing`]: {\n          overflow: 'visible',\n          color: token.colorInfo,\n          backgroundColor: token.colorInfo,\n          borderColor: 'currentcolor',\n          '&::after': {\n            position: 'absolute',\n            top: 0,\n            insetInlineStart: 0,\n            width: '100%',\n            height: '100%',\n            borderWidth: badgeShadowSize,\n            borderStyle: 'solid',\n            borderColor: 'inherit',\n            borderRadius: '50%',\n            animationName: antStatusProcessing,\n            animationDuration: token.badgeProcessingDuration,\n            animationIterationCount: 'infinite',\n            animationTimingFunction: 'ease-in-out',\n            content: '\"\"'\n          }\n        },\n        [`${componentCls}-status-default`]: {\n          backgroundColor: token.colorTextPlaceholder\n        },\n        [`${componentCls}-status-error`]: {\n          backgroundColor: token.colorError\n        },\n        [`${componentCls}-status-warning`]: {\n          backgroundColor: token.colorWarning\n        },\n        [`${componentCls}-status-text`]: {\n          marginInlineStart: marginXS,\n          color: token.colorText,\n          fontSize: token.fontSize\n        }\n      }\n    }), colorPreset), {\n      [`${componentCls}-zoom-appear, ${componentCls}-zoom-enter`]: {\n        animationName: antZoomBadgeIn,\n        animationDuration: token.motionDurationSlow,\n        animationTimingFunction: token.motionEaseOutBack,\n        animationFillMode: 'both'\n      },\n      [`${componentCls}-zoom-leave`]: {\n        animationName: antZoomBadgeOut,\n        animationDuration: token.motionDurationSlow,\n        animationTimingFunction: token.motionEaseOutBack,\n        animationFillMode: 'both'\n      },\n      [`&${componentCls}-not-a-wrapper`]: {\n        [`${componentCls}-zoom-appear, ${componentCls}-zoom-enter`]: {\n          animationName: antNoWrapperZoomBadgeIn,\n          animationDuration: toke