 default RefIcon;","import React, { useState, useEffect } from 'react';\nimport { Form, Input, Button, message, Spin, Switch, Alert, Typography, Space, Card, Tooltip } from 'antd';\nimport { KeyOutlined, ApiOutlined, QuestionCircleOutlined, SecurityScanOutlined } from '@ant-design/icons';\nimport axios from 'axios';\nimport config from '../config';\n\nconst { Text, Title } = Typography;\n\nconst Settings = () => {\n  const [form] = Form.useForm();\n  const [loading, setLoading] = useState(false);\n  const [fetchingSettings, setFetchingSettings] = useState(true);\n  const [analyticsOptOut, setAnalyticsOptOut] = useState(false);\n\n  useEffect(() => {\n    fetchSettings();\n  }, []);\n\n  const fetchSettings = async () => {\n    setFetchingSettings(true);\n    try {\n      const response = await axios.get(`${config.apiSettings.root}wp-ai-workflows/v1/settings`, {\n        headers: {\n          'X-WP-Nonce': config.apiSettings.nonce\n        }\n      });\n      console.log('Fetched settings successfully');\n      form.setFieldsValue({\n        openai_api_key: response.data.openai_api_key || '',\n        unsplash_api_key: response.data.unsplash_api_key || '',\n        ai_workflow_api_key: response.data.ai_workflow_api_key || ''\n      });\n      setAnalyticsOptOut(response.data.analytics_opt_out || false);\n    } catch (error) {\n      console.error('Error fetching settings:', error);\n      message.error('Failed to fetch settings');\n    } finally {\n      setFetchingSettings(false);\n    }\n  };\n\n  const onFinish = async (values) => {\n    setLoading(true);\n    try {\n      const response = await axios.post(`${config.apiSettings.root}wp-ai-workflows/v1/settings`, {\n        ...values,\n        analytics_opt_out: analyticsOptOut\n      }, {\n        headers: {\n          'X-WP-Nonce': config.apiSettings.nonce,\n          'Content-Type': 'application/json'\n        }\n      });\n      console.log('Settings saved');\n      message.success('Settings saved successfully');\n      fetchSettings();\n    } catch (error) {\n      console.error('Error saving settings:', error);\n      message.error('Failed to save settings');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const generateNewApiKey = async () => {\n    try {\n      const response = await axios.post(`${config.apiSettings.root}wp-ai-workflows/v1/generate-api-key`, {}, {\n        headers: {\n          'X-WP-Nonce': config.apiSettings.nonce,\n          'Content-Type': 'application/json'\n        }\n      });\n  \n      if (response.data && response.data.ai_workflow_api_key) {\n        form.setFieldsValue({ \n          ai_workflow_api_key: response.data.masked_key \n        });\n        message.success('New API key generated successfully');\n      } else {\n        throw new Error('Invalid response format');\n      }\n    } catch (error) {\n      console.error('Error generating API key:', error);\n      message.error(\n        error.response?.data?.message || \n        'Failed to generate new API key. Please try again.'\n      );\n    }\n  };\n\n  if (fetchingSettings) {\n    return <Spin size=\"large\" />;\n  }\n\n  return (\n    <div className=\"p-6 max-w-4xl mx-auto\">\n      <Title level={2} className=\"mb-6\">Settings</Title>\n      \n      <Form form={form} layout=\"vertical\" onFinish={onFinish}>\n        <Card className=\"mb-6\">\n          <Title level={4} className=\"flex items-center mb-6\">\n            <ApiOutlined className=\"mr-2\" />\n            API Configurations\n          </Title>\n          \n          <div className=\"space-y-6\">\n            {/* OpenAI API Settings */}\n            <div className=\"bg-gray-50 p-6 rounded-lg\">\n              <Space className=\"mb-2 items-center\">\n                <KeyOutlined />\n                <Title level={5} style={{ margin: 0 }}>OpenAI API Settings</Title>\n              </Space>\n              \n              <Form.Item\n                name=\"openai_api_key\"\n                label={\n                  <Space>\n                    <span>OpenAI API Key</span>\n                    <Tooltip title=\"Get your API key from OpenAI dashboard\">\n                      <QuestionCircleOutlined />\n                    </Tooltip>\n                  </Space>\n                }\n              >\n                <Input.Password />\n              </Form.Item>\n              <Text type=\"secondary\">\n                Don't have an API key? <a href=\"https://platform.openai.com/api-keys\" target=\"_blank\" rel=\"noopener noreferrer\">Get one here</a>\n              </Text>\n            </div>\n\n            {/* Unsplash API Settings */}\n            <div className=\"bg-gray-50 p-6 rounded-lg\">\n              <Space className=\"mb-2 items-center\">\n                <KeyOutlined />\n                <Title level={5} style={{ margin: 0 }}>Unsplash API Settings</Title>\n              </Space>\n              \n              <Form.Item\n                name=\"unsplash_api_key\"\n                label={\n                  <Space>\n                    <span>Unsplash Access Key</span>\n                    <Tooltip title=\"Get your access key from Unsplash developers dashboard\">\n                      <QuestionCircleOutlined />\n                    </Tooltip>\n                  </Space>\n                }\n              >\n                <Input.Password />\n              </Form.Item>\n              <Text type=\"secondary\">\n                Need an Unsplash API key? <a href=\"https://unsplash.com/developers\" target=\"_blank\" rel=\"noopener noreferrer\">Register here</a>\n              </Text>\n            </div>\n\n            {/* WP AI Workflows API Key */}\n            <div className=\"bg-gray-50 p-6 rounded-lg\">\n              <Space className=\"mb-2 items-center\">\n                <SecurityScanOutlined />\n                <Title level={5} style={{ margin: 0 }}>WP AI Workflows API Key</Title>\n              </Space>\n              \n              <Form.Item\n                name=\"ai_workflow_api_key\"\n                label={\n                  <Space>\n                    <span>API Key</span>\n                    <Tooltip title=\"This key is used for automated workflow executions\">\n                      <QuestionCircleOutlined />\n                    </Tooltip>\n                  </Space>\n                }\n              >\n                <Input.Password readOnly />\n              </Form.Item>\n              <Button onClick={generateNewApiKey} type=\"dashed\">\n                Generate New API Key\n              </Button>\n            </div>\n          </div>\n        </Card>\n\n        <Card className=\"mb-6\">\n          <Title level={4} className=\"mb-4\">Usage Analytics</Title>\n          \n          <Alert\n            type=\"info\"\n            showIcon\n            message=\"Analytics Collection\"\n            description={\n              <div className=\"mt-2\">\n                <p>We collect anonymous usage data to help improve the plugin. This includes:</p>\n                <ul className=\"list-disc pl-6 mt-2\">\n                  <li>Installation status (active/inactive)</li>\n                  <li>Plugin version and environment info</li>\n                  <li>Number of workflows and executions</li>\n                  <li>Success rates of workflow executions</li>\n                </ul>\n                <p className=\"mt-2\">We never collect:</p>\n                <ul className=\"list-disc pl-6 mt-2\">\n                  <li>Personal information or API keys</li>\n                  <li>Workflow content or execution data</li>\n                  <li>User data or sensitive information</li>\n                </ul>\n              </div>\n            }\n            className=\"mb-4\"\n          />\n\n          <Space direction=\"vertical\" className=\"w-full\">\n            <Switch\n              checked={!analyticsOptOut}\n              onChange={(checked) => setAnalyticsOptOut(!checked)}\n            />\n            <Text>Help improve AI Workflow Automation by sharing anonymous usage data</Text>\n          </Space>\n\n          {analyticsOptOut && (\n            <Alert\n              type=\"warning\"\n              showIcon\n              message=\"Analytics Disabled\"\n              description=\"Analytics help us understand how the plugin is used and what features need improvement. This data is completely anonymous and helps us make the plugin better for everyone.\"\n              className=\"mt-4\"\n            />\n          )}\n        </Card>\n\n        <Form.Item>\n          <Button type=\"primary\" htmlType=\"submit\" loading={loading} size=\"large\">\n            Save All Settings\n          </Button>\n        </Form.Item>\n      </Form>\n    </div>\n  );\n};\n\nexport default Settings;","// This icon file is generated automatically.\nvar ExclamationCircleOutlined = { \"icon\": { \"tag\": \"svg\", \"attrs\": { \"viewBox\": \"64 64 896 896\", \"focusable\": \"false\" }, \"children\": [{ \"tag\": \"path\", \"attrs\": { \"d\": \"M512 64C264.6 64 64 264.6 64 512s200.6 448 448 448 448-200.6 448-448S759.4 64 512 64zm0 820c-205.4 0-372-166.6-372-372s166.6-372 372-372 372 166.6 372 372-166.6 372-372 372z\" } }, { \"tag\": \"path\", \"attrs\": { \"d\": \"M464 688a48 48 0 1096 0 48 48 0 10-96 0zm24-112h48c4.4 0 8-3.6 8-8V296c0-4.4-3.6-8-8-8h-48c-4.4 0-8 3.6-8 8v272c0 4.4 3.6 8 8 8z\" } }] }, \"name\": \"exclamation-circle\", \"theme\": \"outlined\" };\nexport default ExclamationCircleOutlined;\n","import _extends from \"@babel/runtime/helpers/esm/extends\";\n// GENERATE BY ./scripts/generate.ts\n// DON NOT EDIT IT MANUALLY\n\nimport * as React from 'react';\nimport ExclamationCircleOutlinedSvg from \"@ant-design/icons-svg/es/asn/ExclamationCircleOutlined\";\nimport AntdIcon from \"../components/AntdIcon\";\nvar ExclamationCircleOutlined = function ExclamationCircleOutlined(props, ref) {\n  return /*#__PURE__*/React.createElement(AntdIcon, _extends({}, props, {\n    ref: ref,\n    icon: Exclama