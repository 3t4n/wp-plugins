[selectedWorkflow, setSelectedWorkflow] = useState(null);\n  const [activeWorkflowId, setActiveWorkflowId] = useState(null);\n  const [loading, setLoading] = useState(false);\n  const [searchText, setSearchText] = useState('');\n  const [tagFilters, setTagFilters] = useState([]);\n  const [newTagInput, setNewTagInput] = useState('');\n  const [form] = Form.useForm();\n  const [executingWorkflows, setExecutingWorkflows] = useState({});\n  const [selectedRowKeys, setSelectedRowKeys] = useState([]);\n  const [workflowCount, setWorkflowCount] = useState(0);\n  const WORKFLOW_LIMIT = 3;\n\n  useEffect(() => {\n    fetchWorkflows();\n  }, []);\n\n  const fetchWorkflows = async () => {\n    try {\n      const response = await axios.get(`${config.apiSettings.root}wp-ai-workflows/v1/workflows`, {\n        headers: {\n          'X-WP-Nonce': config.apiSettings.nonce\n        }\n      });\n      if (response.data && Array.isArray(response.data.workflows)) {\n        const sortedWorkflows = response.data.workflows.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));\n        setWorkflows(sortedWorkflows);\n        setWorkflowCount(response.data.count);\n      } else {\n        console.error('Invalid data format received:', response.data);\n        message.error('Received invalid data format from server');\n      }\n    } catch (error) {\n      console.error('Error fetching workflows:', error);\n      message.error('Failed to fetch workflows');\n    }\n  };\n\n  const getTagColor = (tag) => {\n    const colors = [\n      'magenta', 'red', 'volcano', 'orange', 'gold',\n      'lime', 'green', 'cyan', 'blue', 'geekblue', 'purple'\n    ];\n    const index = Array.from(tag).reduce(\n      (acc, char) => acc + char.charCodeAt(0), 0\n    ) % colors.length;\n    return colors[index];\n  };\n\n  const handleAddTag = async (workflowId, tag) => {\n    const workflow = workflows.find(w => w.id === workflowId);\n    if (!workflow) return;\n\n    const tags = workflow.tags || [];\n    if (tags.some(t => t.name.toLowerCase() === tag.toLowerCase())) {\n      message.warning('This tag already exists');\n      return;\n    }\n\n    const updatedWorkflow = {\n      ...workflow,\n      tags: [...tags, { \n        id: Date.now(),\n        name: tag,\n        color: getTagColor(tag)\n      }]\n    };\n\n    try {\n      await axios.put(\n        `${config.apiSettings.root}wp-ai-workflows/v1/workflows/${workflowId}`,\n        updatedWorkflow,\n        { headers: { 'X-WP-Nonce': config.apiSettings.nonce } }\n      );\n      fetchWorkflows();\n      message.success('Tag added successfully');\n    } catch (error) {\n      message.error('Failed to add tag');\n    }\n  };\n\n  const handleRemoveTag = async (workflowId, tagId) => {\n    const workflow = workflows.find(w => w.id === workflowId);\n    if (!workflow) return;\n\n    const updatedWorkflow = {\n      ...workflow,\n      tags: (workflow.tags || []).filter(tag => tag.id !== tagId)\n    };\n\n    try {\n      await axios.put(\n        `${config.apiSettings.root}wp-ai-workflows/v1/workflows/${workflowId}`,\n        updatedWorkflow,\n        { headers: { 'X-WP-Nonce': config.apiSettings.nonce } }\n      );\n      fetchWorkflows();\n      message.success('Tag removed successfully');\n    } catch (error) {\n      message.error('Failed to remove tag');\n    }\n  };\n\n  const filterByTags = (workflows) => {\n    if (tagFilters.length === 0) return workflows;\n    return workflows.filter(workflow => \n      workflow.tags?.some(tag => tagFilters.includes(tag.name))\n    );\n  };\n\n  const showAddTagModal = (workflowId) => {\n    setActiveWorkflowId(workflowId);\n    setIsTagModalVisible(true);\n  };\n\n  const getUniqueTags = (workflows) => {\n    const tagMap = new Map();\n    workflows.forEach(workflow => {\n      (workflow.tags || []).forEach(tag => {\n        tagMap.set(tag.name, tag);\n      });\n    });\n    return Array.from(tagMap.values());\n  };\n\n  const getStatusColor = (status) => {\n    const colors = {\n      active: 'success',\n      inactive: 'default',\n      scheduled: 'processing'\n    };\n    return colors[status] || 'default';\n  };\n\n  const getScheduleText = (schedule) => {\n    if (!schedule || !schedule.enabled) return null;\n    return `Every ${schedule.interval} ${schedule.unit}${schedule.interval > 1 ? 's' : ''}`;\n  };\n\n  const renderScheduleBadge = (schedule) => {\n    if (!schedule || !schedule.enabled) return null;\n    return (\n      <Tooltip title={\n        <>\n          <div>Runs: {getScheduleText(schedule)}</div>\n          {schedule.endDate && <div>Until: {dayjs(schedule.endDate).format('YYYY-MM-DD')}</div>}\n        </>\n      }>\n        <Tag icon={<ClockCircleOutlined />} color=\"blue\">\n          Scheduled\n        </Tag>\n      </Tooltip>\n    );\n  };\n\n  const rowSelection = {\n    selectedRowKeys,\n    onChange: (newSelectedRowKeys) => {\n      setSelectedRowKeys(newSelectedRowKeys);\n    },\n  };\n  \n  // Add bulk delete handler\n  const handleBulkDelete = async () => {\n    try {\n      await Promise.all(\n        selectedRowKeys.map(id =>\n          axios.delete(`${config.apiSettings.root}wp-ai-workflows/v1/workflows/${id}`, {\n            headers: { 'X-WP-Nonce': config.apiSettings.nonce }\n          })\n        )\n      );\n      message.success(`${selectedRowKeys.length} workflows deleted successfully`);\n      setSelectedRowKeys([]);\n      fetchWorkflows();\n    } catch (error) {\n      console.error('Error deleting workflows:', error);\n      message.error('Failed to delete workflows');\n    }\n  };\n\n  const handleBulkActivate = async (activate = true) => {\n    try {\n      await Promise.all(\n        selectedRowKeys.map(id =>\n          axios.put(\n            `${config.apiSettings.root}wp-ai-workflows/v1/workflows/${id}`, \n            { status: activate ? 'active' : 'inactive' },\n            { headers: { 'X-WP-Nonce': config.apiSettings.nonce } }\n          )\n        )\n      );\n      message.success(`${selectedRowKeys.length} workflows ${activate ? 'activated' : 'deactivated'} successfully`);\n      fetchWorkflows();\n    } catch (error) {\n      message.error(`Failed to ${activate ? 'activate' : 'deactivate'} workflows`);\n    }\n  };\n  \n  const handleBulkAddTag = async (tag) => {\n    try {\n      const updates = selectedRowKeys.map(async (id) => {\n        const workflow = workflows.find(w => w.id === id);\n        if (!workflow) return;\n  \n        const tags = workflow.tags || [];\n        if (tags.some(t => t.name === tag)) return;\n  \n        const updatedWorkflow = {\n          ...workflow,\n          tags: [...tags, { \n            id: Date.now(),\n            name: tag,\n            color: getTagColor(tag)\n          }]\n        };\n  \n        await axios.put(\n          `${config.apiSettings.root}wp-ai-workflows/v1/workflows/${id}`,\n          updatedWorkflow,\n          { headers: { 'X-WP-Nonce': config.apiSettings.nonce } }\n        );\n      });\n  \n      await Promise.all(updates);\n      message.success('Tags added successfully');\n      fetchWorkflows();\n    } catch (error) {\n      message.error('Failed to add tags');\n    }\n  };\n\n  const bulkActions = (\n    <div style={{ \n      display: selectedRowKeys.length > 0 ? 'flex' : 'none',\n      padding: '12px 24px',\n      backgroundColor: '#f5f5f5',\n      borderRadius: '6px',\n      marginBottom: '16px',\n      justifyContent: 'space-between',\n      alignItems: 'center'\n    }}>\n      <Space>\n        <Text>{selectedRowKeys.length} items selected</Text>\n        <Button \n          type=\"text\" \n          onClick={() => setSelectedRowKeys([])}\n          size=\"small\"\n        >\n          Clear selection\n        </Button>\n      </Space>\n      <Space>\n        <Select\n          placeholder=\"Add tag to selected\"\n          style={{ width: 200 }}\n          onChange={handleBulkAddTag}\n          value={undefined}\n        >\n          {getUniqueTags(workflows).map(tag => (\n            <Option key={tag.name} value={tag.name}>\n              <Tag color={tag.color}>{tag.name}</Tag>\n            </Option>\n          ))}\n        </Select>\n        <Button \n          onClick={() => handleBulkActivate(true)}\n          icon={<CheckCircleOutlined />}\n        >\n          Activate\n        </Button>\n        <Button \n          onClick={() => handleBulkActivate(false)}\n          icon={<StopOutlined />}\n        >\n          Deactivate\n        </Button>\n        <Popconfirm\n          title=\"Delete Selected Workflows\"\n          description={`Are you sure you want to delete ${selectedRowKeys.length} workflows?`}\n          onConfirm={handleBulkDelete}\n          okText=\"Delete\"\n          cancelText=\"Cancel\"\n          okButtonProps={{ danger: true }}\n        >\n          <Button \n            danger\n            icon={<DeleteOutlined />}\n          >\n            Delete Selected\n          </Button>\n        </Popconfirm>\n      </Space>\n    </div>\n  );\n\n  const columns = [\n    {\n      title: 'Workflow',\n      dataIndex: 'name',\n      key: 'name',\n      render: (name, record) => (\n        <Space>\n          {executingWorkflows[record.id]?.executing ? (\n            <Space>\n              <SyncOutlined spin style={{ color: '#1890ff' }} />\n              <Tag color=\"processing\">\n                {executingWorkflows[record.id].currentNode || 'Executing...'}\n              </Tag>\n            </Space>\n          ) : (\n            <Badge status={record.status === 'active' ? 'success' : 'default'} />\n          )}\n          <span>{name}</span>\n        </Space>\n      ),\n    },\n    {\n      title: 'Tags',\n      key: 'tags',\n      width: 250,\n      render: (_, record) => (\n        <Space wrap>\n          {record.tags?.map(tag => (\n            <Tag\n              key={tag.id}\n              color={tag.color}\n              closable\n              onClose={(e) => {\n                e.preventDefault();\n                handleRemoveTag(record.id, tag.id);\n              }}\n            >\n              {tag.name}\n            </Tag>\n          ))}\n          <Tag\n            style={{ borderStyle: 'dashed', cursor: 'pointer' }}\n            onClick={() => showAddTagModal(record.id)}\n          >\n            <PlusOutlined />\n          </Tag>\n        </Space>\n      ),\n    },\n    {\n      title: 'Created',\n      dataIndex: 'createdAt',\n      key: 'createdAt',\n      width: 150,\n      render: (date) => (\n        <Space direction=\"vertical\" size={0}>\n          <span>{dayjs(date).format('YYYY-MM-DD')}</span>\n          <Text type=\"secondary\" style={{ fontSize: '12px' }}>\n            {dayjs(date).format('HH:mm')}\n          </Text>\n        </Space>\n      ),\n    },\n    {\n      title: 'Created By',\n      dataIndex: 'createdBy',\n      key: 'createdBy',\n      width: 150,\n      render: (user) => (\n        <Space>\n          <UserOutlined />\n          <span>{user}</span>\n        </Space>\n      ),\n    },\n    {\n      title: 'Last Execution',\n      key: 'lastExecuted',\n      width: 200,\n      render: (_, record) => (\n        <Space direction=\"vertical\" size={0}>\n          <span>{record.lastExecuted ? dayjs(record.lastExecuted).fromNow() : 'Never'}</span>\n          {record.lastExecuted && (\n            <Text type=\"secondary\" style={{ fontSize: '12px' }}>\n              {dayjs(record.lastExecuted).format('YYYY-MM-DD HH:mm')}\n            </Text>\n          )}\n        </Space>\n      ),\n    },\n    {\n      title: 'Status',\n      key: 'status',\n      width: 100,\n      render: (_, record) => (\n        <Switch \n          checked={record.status === 'active'} \n          onChange={(checked) => handleStatusChange(record.id, checked)}\n          size=\"small\"\n        />\n      ),\n    },\n    {\n      title: 'Actions',\n      key: 'actions',\n      width: 200,\n      render: (_, record) => (\n        <Space size=\"small\">\n          <Tooltip title={record.schedule?.enabled ? 'Edit Schedule' : 'Schedule'}>\n            <Button\n              type={record.schedule?.enabled ? 'primary' : 'default'}\n              icon={<ScheduleOutlined />}\n              onClick={() => handleScheduleClick(record)}\n              size=\"middle\"\n              shape=\"circle\"\n            />\n          </Tooltip>\n    \n          <Tooltip title=\"Run Workflow\">\n            <Button\n              type=\"default\"\n              icon={<PlayCircleOutlined spin={executingWorkflows[record.id]} />}\n              onClick={() => handleRunWorkflow(record.id)}\n              loading={executingWorkflows[record.id]}\n              disabled={executingWorkflows[record.id]}\n              size=\"middle\"\n              shape=\"circle\"\n            />\n          </Tooltip>\n    \n          <Tooltip title=\"Edit\">\n            <Button\n              type=\"default\"\n              icon={<EditOutlined />}\n              onClick={() => handleEdit(record.id)}\n              size=\"middle\"\n              shape=\"circle\"\n            />\n          </Tooltip>\n          \n    \n          <Tooltip title=\"Delete\">\n          <Popconfirm\n            title=\"Delete Workflow\"\n            description=\"Are you sure you want to delete this workflow?\"\n            onConfirm={() => handleDelete(record.id)}\n            okText=\"Delete\"\n            cancelText=\"Cancel\"\n            okButtonProps={{ danger: true }}\n          >\n            <Button\n              type=\"default\"\n              danger\n              icon={<DeleteOutlined />}\n              size=\"middle\"\n              shape=\"circle\"\n            />\n            </Popconfirm>\n          </Tooltip>\n        </Space>\n      ),\n    },\n  ];\n  \n  const handleRunWorkflow = async (workflowId) => {\n    try {\n      setExecutingWorkflows(prev => ({ \n        ...prev, \n        [workflowId]: {\n          executing: true,\n          currentNode: 'Starting...',\n          executionId: null\n        }\n      }));\n      \n      const response = await adminInstance.post(\n        `${config.apiSettings.root}wp-ai-workflows/v1/execute-workflow/${workflowId}`\n      );\n  \n      const executionId = response.data.execution_id;\n      if (!executionId) {\n        throw new Error('Invalid response from server: No execution ID received');\n      }\n  \n      setExecutingWorkflows(prev => ({ \n        ...prev, \n        [workflowId]: {\n          ...prev[workflowId],\n          executionId\n        }\n      }));\n  \n      let pollInterval;\n      let timeoutCounter = 0;\n      const MAX_TIMEOUT = 600;\n  \n      pollInterval = setInterval(async () => {\n        try {\n          timeoutCounter++;\n          if (timeoutCounter >= MAX_TIMEOUT) {\n            clearInterval(pollInterval);\n            message.error('Execution timed out after 4 minutes');\n            setExecutingWorkflows(prev => {\n              const newState = { ...prev };\n              delete newState[workflowId];\n              return newState;\n            });\n            return;\n          }\n  \n          const statusResponse = await adminInstance.get(\n            `${config.apiSettings.root}wp-ai-workflows/v1/execution-status/${executionId}`\n          );\n  \n          const { status, current_node, is_complete } = statusResponse.data;\n  \n          if (current_node) {\n            setExecutingWorkflows(prev => ({ \n              ...prev, \n              [workflowId]: {\n                ...prev[workflowId],\n                currentNode: `Processing ${current_node}...`\n              }\n            }));\n          }\n  \n          if (is_complete || status === 'completed' || status === 'error') {\n            clearInterval(pollInterval);\n            setExecutingWorkflows(prev => {\n              const newState = { ...prev };\n              delete newState[workflowId];\n              return newState;\n            });\n            \n            if (status === 'error') {\n              message.error('Workflow execution failed');\n            } else {\n              message.success('Workflow executed successfully');\n            }\n            \n            fetchWorkflows();\n          }\n        } catch (error) {\n          console.error('Error polling execution status:', error);\n          clearInterval(pollInterval);\n          setExecutingWorkflows(prev => {\n            const newState = { ...prev };\n            delete newState[workflowId];\n            return newState;\n          });\n          message.error('Error during workflow execution');\n        }\n      }, 500);\n  \n    } catch (error) {\n      console.error('Error executing workflow:', error);\n      setExecutingWorkflows(prev => {\n        const newState = { ...prev };\n        delete newState[workflowId];\n        return newState;\n      });\n      message.error('Failed to execute workflow: ' + (error.response?.data?.message || error.message));\n    }\n  };\n  \n  useEffect(() => {\n    return () => {\n      Object.keys(executingWorkflows).forEach(workflowId => {\n        if (executingWorkflows[workflowId]) {\n          setExecutingWorkflows(prev => ({ ...prev, [workflowId]: false }));\n        }\n      });\n    };\n  }, []);\n\n  const handleStatusChange = async (id, checked) => {\n    try {\n      await axios.put(`${config.apiSettings.root}wp-ai-workflows/v1/workflows/${id}`, \n        { status: checked ? 'active' : 'inactive' },\n        { headers: { 'X-WP-Nonce': config.apiSettings.nonce } }\n      );\n      message.success(`Workflow ${checked ? 'activated' : 'deactivated'} successfully`);\n      fetchWorkflows();\n    } catch (error) {\n      console.error('Error updating workflow status:', error);\n      message.error('Failed to update workflow status');\n    }\n  };\n\n  const handleEdit = (id) => {\n    window.location.href = `/wp-admin/admin.php?page=wp-ai-workflows&action=edit&id=${id}`;\n  };\n\n  const handleCreate = () => {\n    window.location.href = '/wp-admin/admin.php?page=wp-ai-workflows&action=builder';\n  };\n\n  const handleDelete = async (id) => {\n    try {\n      await axios.delete(`${config.apiSettings.root}wp-ai-workflows/v1/workflows/${id}`, {\n        headers: { 'X-WP-Nonce': config.apiSettings.nonce }\n      });\n      message.success('Workflow deleted successfully');\n      fetchWorkflows();\n    } catch (error) {\n      console.error('Error deleting workflow:', error);\n      message.error('Failed to delete workflow');\n    }\n  };\n\n  const handleScheduleClick = (workflow) => {\n    setSelectedWorkflow(workflow);\n    setIsModalVisible(true);\n    const currentSchedule = workflow.schedule || {};\n    form.setFieldsValue({\n      ...currentSchedule,\n      endDate: currentSchedule.endDate ? dayjs(currentSchedule.endDate) : null\n    });\n  };\n\n  const handleScheduleSave = async (values) => {\n    try {\n      const updatedWorkflow = {\n        ...selectedWorkflow,\n        schedule: {\n          ...values,\n          endDate: values.endDate ? values.endDate.format('YYYY-MM-DD') : null,\n          enabled: true\n        }\n      };\n      await axios.put(`${config.apiSettings.root}wp-ai-workflows/v1/workflows/${selectedWorkflow.id}`, \n        updatedWorkflow,\n        { headers: { 'X-WP-Nonce': config.apiSettings.nonce } }\n      );\n      message.success('Workflow schedule updated successfully');\n      setIsModalVisible(false);\n      fetchWorkflows();\n    } catch (error) {\n      console.error('Error updating workflow schedule:', error);\n      message.error('Failed to update workflow schedule');\n    }\n  };\n\n  const handleDeleteSchedule = async () => {\n    try {\n      const updatedWorkflow = {\n        ...selectedWorkflow,\n        schedule: {\n          enabled: false\n        }\n      };\n      await axios.put(`${config.apiSettings.root}wp-ai-workflows/v1/workflows/${selectedWorkflow.id}`, \n        updatedWorkflow,\n        { headers: { 'X-WP-Nonce': config.apiSettings.nonce } }\n      );\n      message.success('Workflow schedule deleted successfully');\n      setIsModalVisible(false);\n      fetchWorkflows();\n    } catch (error) {\n      console.error('Error deleting workflow schedule:', error);\n      message.error('Failed to delete workflow schedule');\n    }\n  };\n\n  return (\n    <div style={{ padding: '24px' }}>\n            <Alert\n      message={`Workflow Count: ${workflowCount} / ${WORKFLOW_LIMIT}`}\n        description={workflowCount >= WORKFLOW_LIMIT ? \"You've reached the maximum number of workflows (3) in the Lite version. Upgrade to Pro for unlimited workflows!\" : \"\"}\n        type={workflowCount >= WORKFLOW_LIMIT ? \"warning\" : \"info\"}\n        showIcon\n        style={{ marginBottom: 16 }}\n        />\n      <Space direction=\"vertical\" style={{ width: '100%' }} size=\"large\">\n        <Space direction=\"vertical\" style={{ width: '100%' }}>\n          <Title level={4} style={{ margin: 0 }}>Workflows</Title>\n          \n          {selectedRowKeys.length > 0 ? (\n            // Bulk Actions Bar\n            <Space style={{ width: '100%', justifyContent: 'space-between' }}>\n              <Space>\n                <Text strong>{selectedRowKeys.length} items selected</Text>\n                <Button \n                  size=\"middle\"\n                  icon={<CloseOutlined />}\n                  onClick={() => setSelectedRowKeys([])}\n                >\n                  Clear Selection\n                </Button>\n              </Space>\n  \n              <Space>\n                <Select\n                  placeholder=\"Assign tag to selected items\"\n                  style={{ width: 250 }}\n                  onChange={(value) => {\n                    handleBulkAddTag(value);\n                    // Reset the select value\n                    setTimeout(() => {\n                      const select = document.querySelector('.bulk-tag-select');\n                      if (select) select.click();\n                    }, 0);\n                  }}\n                  value={undefined}\n                  className=\"bulk-tag-select\"\n                >\n                  {getUniqueTags(workflows).map(tag => (\n                    <Option key={tag.name} value={tag.name}>\n                      <Tag color={tag.color}>{tag.name}</Tag>\n                    </Option>\n                  ))}\n                </Select>\n                <Button \n                  onClick={() => handleBulkActivate(true)}\n                  icon={<CheckCircleOutlined />}\n                >\n                  Activate\n                </Button>\n                <Button \n                  onClick={() => handleBulkActivate(false)}\n                  icon={<StopOutlined />}\n                >\n                  Deactivate\n                </Button>\n                <Popconfirm\n                  title=\"Delete Selected Workflows\"\n                  description={`Are you sure you want to delete ${selectedRowKeys.length} workflows?`}\n                  onConfirm={handleBulkDelete}\n                  okText=\"Delete\"\n                  cancelText=\"Cancel\"\n                  okButtonProps={{ danger: true }}\n                >\n                  <Button \n                    danger\n                    icon={<DeleteOutlined />}\n                  >\n                    Delete Selected\n                  </Button>\n                </Popconfirm>\n              </Space>\n            </Space>\n          ) : (\n            // Normal Search/Filter Bar\n            <Space style={{ width: '100%', justifyContent: 'space-between' }}>\n              <Space>\n                <Select\n                  mode=\"multiple\"\n                  placeholder=\"Filter by tags...\"\n                  value={tagFilters}\n                  onChange={setTagFilters}\n                  style={{ width: 300 }}\n                  allowClear\n                  optionLabelProp=\"label\"\n                >\n                  {getUniqueTags(workflows).map(tag => (\n                    <Option \n                      key={tag.id} \n                      value={tag.name}\n                      label={tag.name}\n                    >\n                      <Tag color={tag.color}>{tag.name}</Tag>\n                    </Option>\n                  ))}\n                </Select>\n                <Input\n                  placeholder=\"Search workflows by name...\"\n                  allowClear\n                  onChange={(e) => setSearchText(e.target.value)}\n                  style={{ width: 300 }}\n                />\n              </Space>\n  \n              <Button \n                type=\"primary\" \n                icon={<PlusOutlined />}\n                onClick={handleCreate}\n              >\n                Create a Workflow\n              </Button>\n            </Space>\n          )}\n  \n          <Table \n            rowSelection={rowSelection}\n            columns={columns} \n            dataSource={filterByTags(workflows).filter(w => \n              w.name.toLowerCase().includes(searchText.toLowerCase())\n            )} \n            rowKey=\"id\"\n            loading={loading}\n            pagination={{ \n              pageSize: 10,\n              showTotal: (total) => `Total ${total} workflows`\n            }}\n            size=\"middle\"\n            onRow={() => ({\n              style: {\n                height: '52px',\n              },\n            })}\n          />\n        </Space>\n  \n        <Modal\n          title={\n            <Space>\n              <CalendarOutlined />\n              <span>Schedule Workflow</span>\n            </Space>\n          }\n          open={isModalVisible}\n          onCancel={() => setIsModalVisible(false)}\n          footer={[\n            <Button key=\"cancel\" onClick={() => setIsModalVisible(false)}>\n              Cancel\n            </Button>,\n            <Button \n              key=\"delete\" \n              danger \n              icon={<DeleteOutlined />}\n              onClick={handleDeleteSchedule}\n            >\n              Delete Schedule\n            </Button>,\n            <Button \n              key=\"submit\" \n              type=\"primary\" \n              icon={<ScheduleOutlined />}\n              onClick={() => form.submit()}\n            >\n              Save Schedule\n            </Button>,\n          ]}\n        >\n          <Form \n            form={form} \n            onFinish={handleScheduleSave}\n            layout=\"vertical\"\n          >\n            <Space align=\"start\" style={{ width: '100%' }}>\n              <Form.Item \n                name=\"interval\" \n                label=\"Repeat Every\" \n                rules={[{ required: true }]}\n                style={{ marginBottom: 0 }}\n              >\n                <InputNumber min={1} style={{ width: 100 }} />\n              </Form.Item>\n              <Form.Item \n                name=\"unit\" \n                label=\"Unit\" \n                rules={[{ required: true }]}\n                style={{ marginBottom: 0 }}\n              >\n                <Select style={{ width: 150 }}>\n                  <Option value=\"minute\">Minute(s)</Option>\n                  <Option value=\"hour\">Hour(s)</Option>\n                  <Option value=\"day\">Day(s)</Option>\n                  <Option value=\"week\">Week(s)</Option>\n                  <Option value=\"month\">Month(s)</Option>\n                </Select>\n              </Form.Item>\n            </Space>\n            <Form.Item \n              name=\"endDate\" \n              label=\"End Date (Optional)\"\n              style={{ marginTop: 16 }}\n            >\n              <DatePicker \n                format=\"YYYY-MM-DD\"\n                style={{ width: '100%' }}\n                showToday\n                disabledDate={(current) => {\n                  return current && current < dayjs().startOf('day');\n                }}\n              />\n            </Form.Item>\n          </Form>\n        </Modal>\n  \n        <Modal\n          title={\n            <Space>\n              <TagsOutlined />\n              <span>Add Tag</span>\n            </Space>\n          }\n          open={isTagModalVisible}\n          onCancel={() => {\n            setIsTagModalVisible(false);\n            setNewTagInput('');\n          }}\n          onOk={() => {\n            if (newTagInput.trim()) {\n              handleAddTag(activeWorkflowId, newTagInput.trim());\n              setIsTagModalVisible(false);\n              setNewTagInput('');\n            }\n          }}\n          okButtonProps={{ \n            disabled: !newTagInput.trim(),\n            icon: <PlusOutlined />\n          }}\n        >\n          <Space direction=\"vertical\" style={{ width: '100%' }} size=\"large\">\n            <div>\n              <Text strong>New Tag</Text>\n              <Input\n                placeholder=\"Enter tag name\"\n                value={newTagInput}\n                onChange={(e) => setNewTagInput(e.target.value)}\n                onPressEnter={() => {\n                  if (newTagInput.trim()) {\n                    handleAddTag(activeWorkflowId, newTagInput.trim());\n                    setIsTagModalVisible(false);\n                    setNewTagInput('');\n                  }\n                }}\n                prefix={<TagsOutlined style={{ color: '#bfbfbf' }} />}\n                maxLength={50}\n                showCount\n              />\n            </div>\n  \n            <div>\n              <Text strong>Existing Tags</Text>\n              <div style={{ \n                marginTop: 8,\n                padding: 12,\n                background: '#f5f5f5',\n                borderRadius: 6,\n                minHeight: 40\n              }}>\n                <Space wrap>\n                  {getUniqueTags(workflows).map(tag => (\n                    <Tag\n                      key={tag.id}\n                      color={tag.color}\n                      style={{ cursor: 'pointer' }}\n                      onClick={() => {\n                        handleAddTag(activeWorkflowId, tag.name);\n                        setIsTagModalVisible(false);\n                      }}\n                    >\n                      {tag.name}\n                    </Tag>\n                  ))}\n                  {getUniqueTags(workflows).length === 0 && (\n                    <Text type=\"secondary\">No existing tags</Text>\n                  )}\n                </Space>\n              </div>\n            </div>\n          </Space>\n        </Modal>\n      </Space>\n    </div>\n  );\n};\n\nexport default WorkflowManagement;","// This icon file is generated automatically.\nvar KeyOutlined = { \"icon\": { \"tag\": \"svg\", \"attrs\": { \"viewBox\": \"64 64 896 896\", \"focusable\": \"false\" }, \"children\": [{ \"tag\": \"path\", \"attrs\": { \"d\": \"M608 112c-167.9 0-304 136.1-304 304 0 70.3 23.9 135 63.9 186.5l-41.1 41.1-62.3-62.3a8.15 8.15 0 00-11.4 0l-39.8 39.8a8.15 8.15 0 000 11.4l62.3 62.3-44.9 44.9-62.3-62.3a8.15 8.15 0 00-11.4 0l-39.8 39.8a8.15 8.15 0 000 11.4l62.3 62.3-65.3 65.3a8.03 8.03 0 000 11.3l42.3 42.3c3.1 3.1 8.2 3.1 11.3 0l253.6-253.6A304.06 304.06 0 00608 720c167.9 0 304-136.1 304-304S775.9 112 608 112zm161.2 465.2C726.2 620.3 668.9 644 608 644c-60.9 0-118.2-23.7-161.2-66.8-43.1-43-66.8-100.3-66.8-161.2 0-60.9 23.7-118.2 66.8-161.2 43-43.1 100.3-66.8 161.2-66.8 60.9 0 118.2 23.7 161.2 66.8 43.1 43 66.8 100.3 66.8 161.2 0 60.9-23.7 118.2-66.8 161.2z\" } }] }, \"name\": \"key\", \"theme\": \"outlined\" };\nexport default KeyOutlined;\n","import _extends from \"@babel/runtime/helpers/esm/extends\";\n// GENERATE BY ./scripts/generate.ts\n// DON NOT EDIT IT MANUALLY\n\nimport * as React from 'react';\nimport KeyOutlinedSvg from \"@ant-design/icons-svg/es/asn/KeyOutlined\";\nimport AntdIcon from \"../components/AntdIcon\";\nvar KeyOutlined = function KeyOutlined(props, ref) {\n  return /*#__PURE__*/React.createElement(AntdIcon, _extends({}, p