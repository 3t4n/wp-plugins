Update node data when any field changes\n  const updateNodeData = (updates) => {\n    const newData = { ...data, ...updates };\n    data.updateNodeData(id, newData);\n  };\n\n  const handleSearch = async () => {\n    if (!searchTerm.trim()) {\n      message.warning('Please enter a search term');\n      return;\n    }\n\n    setLoading(true);\n    try {\n      const response = await adminInstance.post('/unsplash/search', {\n        searchTerm,\n        orientation,\n        randomResult,\n        imageSize\n      });\n\n      console.log('Unsplash search response:', response.data); // For debugging\n\n      if (response.data.url) {\n        setPreviewUrl(response.data.thumb); // Use thumbnail for preview\n        updateNodeData({ \n          previewUrl: response.data.thumb,\n          imageUrl: response.data.url, // Store the full resolution URL\n          searchTerm,\n          imageSize,\n          orientation,\n          randomResult\n        });\n        message.success('Image fetched successfully');\n      } else {\n        message.warning('No images found for this search term');\n        setPreviewUrl('');\n      }\n    } catch (error) {\n      console.error('Error fetching image:', error);\n      message.error('Failed to fetch image: ' + (error.response?.data?.message || error.message));\n      setPreviewUrl('');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleNameChange = (e) => {\n    const newName = e.target.value;\n    setNodeName(newName);\n    updateNodeData({ nodeName: newName });\n  };\n\n  const handleSearchTermChange = (e) => {\n    const newTerm = e.target.value;\n    setSearchTerm(newTerm);\n    updateNodeData({ searchTerm: newTerm });\n  };\n\n  const handleSizeChange = (value) => {\n    setImageSize(value);\n    updateNodeData({ imageSize: value });\n  };\n\n  const handleOrientationChange = (value) => {\n    setOrientation(value);\n    updateNodeData({ orientation: value });\n  };\n\n  return (\n    <Card \n      title=\