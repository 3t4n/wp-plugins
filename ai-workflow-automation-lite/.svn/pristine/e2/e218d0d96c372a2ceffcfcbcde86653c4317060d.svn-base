<CustomerServiceOutlined style={{ fontSize: '20px' }} />;\n      case 'brain':\n        return <BulbOutlined style={{ fontSize: '20px' }} />;\n      case 'chat':\n        return <MessageOutlined style={{ fontSize: '20px' }} />;\n      default:\n        return <RobotOutlined style={{ fontSize: '20px' }} />;\n    }\n  };\n\n  const getStyles = () => {\n    const baseStyles = {\n      container: {\n        width: design.dimensions.width,\n        height: design.dimensions.height,\n        fontFamily: design.font?.family || 'Inter, system-ui, sans-serif',\n        fontSize: design.font?.size || '14px',\n        backgroundColor: design.theme === 'dark' ? '#1f1f1f' : '#ffffff',\n        color: design.theme === 'dark' ? '#ffffff' : '#000000',\n        '--chat-border-radius': `${design.dimensions.borderRadius}px`\n      },\n      header: {\n        fontSize: design.font?.headerSize || '16px',\n        borderTopLeftRadius: `${design.dimensions.borderRadius}px`,\n        borderTopRightRadius: `${design.dimensions.borderRadius}px`,\n      }\n    };\n\n    if (design.theme === 'custom') {\n      return {\n        ...baseStyles,\n        container: {\n          ...baseStyles.container,\n          backgroundColor: design.colors.background,\n          color: design.colors.text,\n          '--chat-primary': design.colors.primary,\n          '--chat-bg': design.colors.background,\n          '--chat-text': design.colors.text,\n          '--chat-secondary': design.colors.secondary,\n        }\n      };\n    }\n\n    return baseStyles;\n  };\n\n  const styles = getStyles();\n\n  return (\n    <Modal\n    title=\"Chat Preview\"\n    open={visible}\n    onCancel={onClose}\n    width={Math.min(design.dimensions.width + 40, window.innerWidth - 40)} // Add max width\n    footer={null}\n    bodyStyle={{ padding: 0 }}\n    style={{ \n      maxWidth: '95vw',\n      margin: '0 auto'\n    }}\n  >\n      <div \n        className={`wp-ai-workflows-chat-widget ${design.theme}`}\n        style={styles.container}\n      >\n        <div className=\"chat-header\" style={styles.header}>\n          <div className=\"header-content\">\n            {getBotIcon()}\n            <span className=\"bot-name\">{design.botName || 'AI Assistant'}</span>\n          </div>\n          <div className=\"header-actions\">\n            <button \n              className=\"sound-toggle\"\n              onClick={() => setSoundEnabled(!soundEnabled)}\n              aria-label={soundEnabled ? 'Mute sound' : 'Unmute sound'}\n            >\n              {soundEnabled ? <SoundOutlined /> : <MutedOutlined />}\n            </button>\n            <button className=\"close-button\" onClick={onClose}>×</button>\n          </div>\n        </div>\n\n        <div className=\"chat-messages\">\n          {messages.map((message, index) => (\n            <div key={index} className={`chat-message ${message.role}`}>\n              <div className=\"message-content\">\n                {message.content}\n              </div>\n            </div>\n          ))}\n        </div>\n\n        <div className=\"chat-input\">\n          <input\n            type=\"text\"\n            value={inputValue}\n            onChange={(e) => setInputValue(e.target.value)}\n            placeholder={behavior.placeholderText}\n            onKeyPress={(e) => e.key === 'Enter' && handleSend()}\n          />\n          <button onClick={handleSend}>Send</button>\n        </div>\n\n        <div className=\"powered-by\">\n          <a \n            href=\"https://bit.ly/3CEdP35\"\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            title=\"Create your own AI chatbot\"\n          >\n            Powered by AI Workflow Automation Plugin\n          </a>\n        </div>\n      </div>\n\n      <style>{`\n        .wp-ai-workflows-chat-widget {\n          display: flex;\n          flex-direction: column;\n          overflow: hidden;\n          position: relative;\n          border-radius: var(--chat-border-radius);\n        }\n\n        .wp-ai-workflows-chat-widget.dark {\n          background-color: #1f1f1f;\n          color: #ffffff;\n        }\n\n        .chat-header {\n          display: flex;\n          justify-content: space-between;\n          align-items: center;\n          padding: 12px 16px;\n          background: var(--chat-primary, #1677ff);\n          color: white;\n        }\n\n        .header-content {\n          display: flex;\n          align-items: center;\n          gap: 8px;\n        }\n\n        .bot-name {\n          font-weight: 500;\n        }\n\n        .header-actions {\n          display: flex;\n          align-items: center;\n          gap: 8px;\n        }\n\n        .sound-toggle,\n        .close-button {\n          background: transparent;\n          border: none;\n          color: rgba(255, 255, 255, 0.8);\n          cursor: pointer;\n          padding: 4px;\n          display: flex;\n          align-items: center;\n          justify-content: center;\n          transition: color 0.2s ease;\n        }\n\n        .sound-toggle:hover,\n        .close-button:hover {\n          color: #ffffff;\n        }\n\n        .chat-messages {\n          flex: 1;\n          overflow-y: auto;\n          padding: 16px;\n          display: flex;\n          flex-direction: column;\n          gap: 12px;\n          background-color: var(--chat-bg, inherit);\n        }\n\n        .chat-message {\n          display: flex;\n          margin-bottom: 8px;\n        }\n\n        .chat-message.user {\n          justify-content: flex-end;\n        }\n\n        .message-content {\n          padding: 8px 12px;\n          border-radius: 12px;\n          max-width: 80%;\n          word-wrap: break-word;\n        }\n\n        .chat-message.user .message-content {\n          background: var(--chat-primary, #1677ff);\n          color: white;\n        }\n\n        .chat-message.assistant .message-content {\n          background: var(--chat-secondary, #f5f5f5);\n          color: var(--chat-text, inherit);\n        }\n\n        .chat-input {\n          padding: 16px;\n          display: flex;\n          gap: 8px;\n          border-top: 1px solid var(--chat-secondary, #f0f0f0);\n          background-color: var(--chat-bg, inherit);\n        }\n\n        .chat-input input {\n          flex: 1;\n          padding: 8px 12px;\n          border: 1px solid var(--chat-secondary, #f0f0f0);\n          border-radius: 6px;\n          background: var(--chat-bg, #ffffff);\n          color: var(--chat-text, inherit);\n        }\n\n        .chat-input button {\n          padding: 8px 16px;\n          background: var(--chat-primary, #1677ff);\n          color: white;\n          border: none;\n          border-radius: 6px;\n          cursor: pointer;\n          transition: opacity 0.2s ease;\n        }\n\n        .chat-input button:hover {\n          opacity: 0.9;\n        }\n\n        .powered-by {\n          text-align: center;\n          padding: 8px;\n          font-size: 12px;\n          opacity: 0.7;\n          background-color: var(--chat-bg, inherit);\n          color: var(--chat-text, inherit);\n        }\n\n        .powered-by a {\n          color: inherit;\n          text-decoration: none;\n        }\n\n        .powered-by a:hover {\n          text-decoration: underline;\n        }\n\n        .dark .powered-by {\n          opacity: 0.5;\n        }\n      `}</style>\n    </Modal>\n  );\n};\n\nexport default ChatPreview;","import React, { useRef, useState, useEffect } from 'react';\nimport { Handle, Position } from '@xyflow/react';\nimport { \n   Modal, Divider, Card, Select, Input, Button, Space, Typography, Tabs, Switch, \n  InputNumber, Collapse, ColorPicker, Alert, Tooltip, message \n} from 'antd';\nimport {\n  RobotOutlined, DeleteOutlined, SettingOutlined, EyeOutlined, CodeOutlined,\n  QuestionCircleOutlined, OpenAIOutlined, GoogleOutlined\n} from '@ant-design/icons';\nimport { Icon } from '@iconify/react';\nimport NodeInputHandler from '../common/NodeInputHandler';\nimport ChatPreview from './ChatPreview';\n\nconst { Option, OptGroup } = Select;\nconst { Title, Text } = Typography;\nconst { TextArea } = Input;\nconst { TabPane } = Tabs;\nconst { Panel } = Collapse;\n\n\nconst ChatNode = ({ id, data, isConnectable, workflowId }) => {\n  const [workflowIdState, setWorkflowIdState] = useState(data.workflowId || workflowId);\n  const [isProModalVisible, setIsProModalVisible] = useState(false);\n  const [selectedProModel, setSelectedProModel] = useState(null);\n  const [nodeData, setNodeData] = useState({\n    nodeName: data.nodeName || `Chat ${id}`,\n    systemPrompt: data.systemPrompt || '',\n    workflowId: workflowIdState,\n    model: data.model || 'gpt-4o-mini',\n    modelParams: data.modelParams || {\n      temperature: 1.0,\n      top_p: 1.0,\n      top_k: 0,\n      frequency_penalty: 0.0,\n      presence_penalty: 0.0,\n      repetition_penalty: 1.0,\n      max_tokens: 4096\n    },\n    design: data.design || {\n      theme: 'light',\n      position: 'bottom-right',\n      dimensions: {\n        width: 380,\n        height: 600,\n        borderRadius: 12\n      },\n      colors: {\n        primary: '#1677ff',\n        secondary: '#f5f5f5',\n        text: '#000000',\n        background: '#ffffff'\n      },\n      font: {\n        family: 'Inter, system-ui, sans-serif',\n        size: '14px',\n        headerSize: '16px'\n      },\n      botName: 'AI Assistant',\n      botIcon: 'robot', // Options: robot, assistant, brain, chat\n      customCSS: ''\n    },\n    behavior: data.behavior || {\n      initialMessage: 'Hello! How can I help you today?',\n      placeholderText: 'Type your message here...',\n      maxHistoryLength: 50,\n      showTypingIndicator: true,\n      soundEffects: true,\n      autoOpenDelay: 0,\n      persistHistory: true,\n      rateLimit: {\n        enabled: true,\n        maxMessages: 10,\n        timeWindow: 60\n      }\n    }\n  });\n\n  const [previewVisible, setPreviewVisible] = useState(false);\n\n  useEffect(() => {\n    data.updateNodeData(id, nodeData);\n  }, [nodeData, id, data]);\n\n  useEffect(() => {\n    if (workflowId) {\n      setWorkflowIdState(workflowId);\n    }\n  }, [workflowId]);\n\n  useEffect(() => {\n    if (data.workflowId) {\n      setWorkflowIdState(data.workflowId);\n    }\n  }, [data.workflowId]);\n\n\n  useEffect(() => {\n    return () => {\n      if (previewVisible) {\n        setPreviewVisible(false);\n      }\n    };\n  }, []);\n\n  const handleModelSelect = (value, option) => {\n    if (option.isPro) {\n      setSelectedProModel(option);\n      setIsProModalVisible(true);\n      return;\n    }\n    setNodeData(prev => ({ ...prev, model: value }));\n  };\n\n  const handleUpgradeClick = () => {\n    window.open('https://wpaiworkflowautomation.com/pricing?utm_source=freedownload&utm_medium=lite&utm_content=chatnode', '_blank');\n  };\n\n  const handleModelParamUpdate = (param, value) => {\n    const constraints = {\n      temperature: { min: 0, max: 2 },\n      top_p: { min: 0, max: 1 },\n      top_k: { min: 0, max: 100 },\n      frequency_penalty: { min: -2, max: 2 },\n      presence_penalty: { min: -2, max: 2 },\n      repetition_penalty: { min: 0, max: 2 },\n      max_tokens: { min: 1, max: getMaxTokensForModel(nodeData.model) }\n    };\n\n    if (value < constraints[param].min || value > constraints[param].max) {\n      message.error(`${param} must be between ${constraints[param].min} and ${constraints[param].max}`);\n      return;\n    }\n\n    setNodeData(prev => ({\n      ...prev,\n      modelParams: {\n        ...prev.modelParams,\n        [param]: value\n      }\n    }));\n  };\n\n  const renderShortcodeSection = () => {\n    return (\n      <div className=\"shortcode-section\" style={{ \n        borderTop: '1px solid #f0f0f0', \n        marginTop: 16, \n        paddingTop: 16 \n      }}>\n        <Title level={5}>Embed Chat Widget</Title>\n        {workflowIdState ? (\n          <Space direction=\"vertical\" style={{ width: '100%' }}>\n            <Text copyable>{`[wp_ai_workflow_chat id=\"${workflowIdState}\"]`}</Text>\n            <Text type=\"secondary\">\n              Add this shortcode to any post or page where you want the chat widget to appear. \n              The chat widget will automatically use the latest configuration.\n            </Text>\n          </Space>\n        ) : (\n          <Alert\n            type=\"info\"\n            message=\"You will see the shortcode to embed chat here after saving the workflow.\"\n            showIcon\n          />\n        )}\n      </div>\n    );\n  };\n\n  const handleDesignUpdate = (key, value) => {\n    setNodeData(prev => ({\n      ...prev,\n      design: {\n        ...prev.design,\n        [key]: value\n      }\n    }));\n  };\n\n  const handleBehaviorUpdate = (key, value) => {\n    setNodeData(prev => ({\n      ...prev,\n      behavior: {\n        ...prev.behavior,\n        [key]: value\n      }\n    }));\n  };\n\n  const getMaxTokensForModel = (model) => {\n    const tokenLimits = {\n      'meta-llama/llama-3.2-11b-vision-instruct:free': 4096,\n      'meta-llama/llama-3.2-11b-vision-instruct': 131072,\n      'mistralai/mistral-nemo': 128000,\n      'mistralai/pixtral-12b': 4096,\n      'google/gemma-2-9b-it:free': 2048,\n      'anthropic/claude-3.5-sonnet': 8192,\n      'anthropic/claude-3-5-haiku': 4096,\n      'anthropic/claude-3-haiku': 4096,\n      'anthropic/claude-3-opus': 4096,\n      'gpt-4o': 16384,\n      'gpt-4o-mini': 16384,\n      'o1-preview': 32768,\n      'o1-mini': 65536,\n      'google/gemini-flash-8b-1.5-exp': 8192,\n      'google/gemini-flash-1.5': 8192,\n    };\n    return tokenLimits[model] || 4096;\n  };\n\n  const getModelIcon = (provider) => {\n    switch (provider) {\n      case 'OpenAI':\n        return <OpenAIOutlined />;\n      case 'Google':\n        return <GoogleOutlined />;\n      case 'Perplexity':\n        return <Icon icon=\"simple-icons:perplexity\" />;\n      case 'Mistral':\n        return <Icon icon=\"logos:mistral-ai-icon\" />;\n      case 'Meta Llama':\n        return <Icon icon=\"hugeicons:meta\" />;\n      case 'Anthropic':\n        return <Icon icon=\"logos:anthropic-icon\" />;\n      default:\n        return null;\n    }\n  };\n\n\n  const modelGroups = {\n    OpenAI: [\n      { value: \"o1-preview\", label: \"o1-Preview\", isPro: false },\n      { value: \"o1-mini\", label: \"o1-Mini\", isPro: false },\n      { value: \"gpt-4o\", label: \"ChatGPT-4o\", isPro: false },\n      { value: \"gpt-4o-mini\", label: \"GPT-4o Mini\", isPro: false },\n    ],\n    Anthropic: [\n      { value: \"anthropic/claude-3.5-sonnet\", label: \"Claude 3.5 Sonnet\", isPro: true },\n      { value: \"anthropic/claude-3-5-haiku\", label: \"Claude 3.5 Haiku\", isPro: true },\n      { value: \"anthropic/claude-3-opus\", label: \"Claude 3 Opus\", isPro: true },\n      { value: \"anthropic/claude-3-haiku\", label: \"Claude 3 Haiku\", isPro: true },\n    ],\n\n    \"Meta Llama\": [\n      { value: \"meta-llama/llama-3.2-3b-instruct\", label: \"Llama 3.2 3B Instruct\", isPro: true },\n      { value: \"meta-llama/llama-3.2-1b-instruct\", label: \"Llama 3.2 1B Instruct\", isPro: true },\n      { value: \"meta-llama/llama-3.2-90b-vision-instruct\", label: \"Llama 3.2 90B Vision Instruct\", isPro: true },\n      { value: \"meta-llama/llama-3.2-11b-vision-instruct:free\", label: \"Llama 3.2 11B Vision Instruct (Free)\", isPro: true },\n    ],\n\n    Google: [\n      { value: \"google/gemini-flash-8b-1.5-exp\", label: \"Gemini Flash 8B 1.5 Exp\", isPro: true },\n      { value: \"google/gemini-flash-1.5\", label: \"Gemini Flash 1.5\", isPro: true },\n      { value: \"google/gemma-2-9b-it:free\", label: \"Gemma 2 9B IT (Free)\", isPro: true },\n    ],\n    Perplexity: [\n      { value: \"perplexity/llama-3.1-sonar-huge-128k-online\", label: \"Llama 3.1 Sonar Huge 128K Online\", isPro: true },\n      { value: \"perplexity/llama-3.1-sonar-large-128k-online\", label: \"Llama 3.1 Sonar Large 128K Online\", isPro: true },\n      { value: \"perplexity/llama-3.1-sonar-small-128k-online\", label: \"Llama 3.1 Sonar Small 128K Online\", isPro: true},\n      { value: \"perplexity/llama-3.1-sonar-large-128k-chat\", label: \"Llama 3.1 Sonar Large 128K Chat\", isPro: true },\n      { value: \"perplexity/llama-3.1-sonar-small-128k-chat\", label: \"Llama 3.1 Sonar Small 128K Chat\", isPro: true },\n    ],\n    Mistral: [\n      { value: \"mistralai/pixtral-12b\", label: \"Pixtral 12B\", isPro: true },\n      { value: \"mistralai/codestral-mamba\", label: \"Codestral Mamba\", isPro: true },\n      { value: \"mistralai/mistral-nemo\", label: \"Mistral Nemo\", isPro: true },\n    ],\n  };\n\n\n\n  return (\n    <>\n      <Card title=\"Chat\" style={{ width: 400 }} extra={\n        <Space>\n          <Button icon={<EyeOutlined />} onClick={() => setPreviewVisible(true)}>Preview</Button>\n          <Button icon={<DeleteOutlined />} onClick={() => data.onDelete(id)} />\n        </Space>\n      }>\n        <Handle type=\"target\" position={Position.Left} isConnectable={isConnectable} />\n  \n        <Input\n          placeholder=\"Node Name\"\n          value={nodeData.nodeName}\n          onChange={(e) => setNodeData(prev => ({ ...prev, nodeName: e.target.value }))}\n          style={{ marginBottom: 8 }}\n          className=\"nodrag\"\n        />\n  \n          <Tabs defaultActiveKey=\"model\">\n          <TabPane tab=\"Model\" key=\"model\" className=\"nodrag\">\n            <Space direction=\"vertical\" style={{ width: '100%' }}>\n              <Select\n                value={nodeData.model}\n                onChange={handleModelSelect}\n                style={{ width: '100%' }}\n                className=\"nodrag\"\n              >\n                {Object.entries(modelGroups).map(([provider, models]) => (\n                  <OptGroup \n                    key={provider} \n                    label={\n                      <Space>\n                        {getModelIcon(provider)}\n                        <span>{provider}</span>\n                      </Space>\n                    }\n                  >\n                    {models.map(model => (\n                      <Option \n                        key={model.value} \n                        value={model.value}\n                        isPro={model.isPro}\n                      >\n                        <Space>\n                          {model.label}\n                          {model.isPro && (\n                            <Text type=\"secondary\" style={{ fontSize: '12px' }}>\n                              (Pro)\n                            </Text>\n                          )}\n                        </Space>\n                      </Option>\n                    ))}\n                  </OptGroup>\n                ))}\n              </Select>\n  \n              <Collapse ghost>\n                <Panel header=\"Model Parameters\" key=\"params\">\n                  <Space direction=\"vertical\" style={{ width: '100%' }}>\n                    <div>\n                      <Text>Temperature</Text>\n                      <Tooltip title=\"Controls response randomness\">\n                        <QuestionCircleOutlined style={{ marginLeft: 8 }} />\n                      </Tooltip>\n                      <InputNumber\n                        min={0}\n                        max={2}\n                        step={0.1}\n                        value={nodeData.modelParams.temperature}\n                        onChange={(value) => handleModelParamUpdate('temperature', value)}\n                        style={{ width: '100%' }}\n                      />\n                    </div>\n  \n                    <div>\n                      <Text>Top P</Text>\n                      <Tooltip title=\"Controls token sampling diversity\">\n                        <QuestionCircleOutlined style={{ marginLeft: 8 }} />\n                      </Tooltip>\n                      <InputNumber\n                        min={0}\n                        max={1}\n                        step={0.1}\n                        value={nodeData.modelParams.top_p}\n                        onChange={(value) => handleModelParamUpdate('top_p', value)}\n                        style={{ width: '100%' }}\n                      />\n                    </div>\n  \n                    <div>\n                      <Text>Max Tokens</Text>\n                      <Tooltip title=\"Maximum response length\">\n                        <QuestionCircleOutlined style={{ marginLeft: 8 }} />\n                      </Tooltip>\n                      <InputNumber\n                        min={1}\n                        max={getMaxTokensForModel(nodeData.model)}\n                        value={nodeData.modelParams.max_tokens}\n                        onChange={(value) => handleModelParamUpdate('max_tokens', value)}\n                        style={{ width: '100%' }}\n                      />\n                    </div>\n                  </Space>\n                </Panel>\n              </Collapse>\n            </Space>\n          </TabPane>\n  \n          <TabPane tab=\"Knowledge\" key=\"knowledge\" className=\"nodrag\">\n            <Space direction=\"vertical\" style={{ width: '100%' }}>\n              <Text>System Prompt</Text>\n              <TextArea\n                rows={4}\n                value={nodeData.systemPrompt}\n                onChange={(e) => setNodeData(prev => ({ ...prev, systemPrompt: e.target.value }))}\n                placeholder=\"Enter base instructions for the chatbot...\"\n                className=\"nodrag\"\n              />\n              <NodeInputHandler\n                nodeId={id}\n                onInsert={(tag) => setNodeData(prev => ({ \n                  ...prev, \n                  systemPrompt: prev.systemPrompt + tag \n                }))}\n              />\n              <Alert\n                type=\"info\"\n                message=\"Connect nodes to use their output as knowledge base for the chatbot\"\n                showIcon\n              />\n            </Space>\n          </TabPane>\n  \n          <TabPane tab=\"Design\" key=\"design\" className=\"nodrag\">\n          <Space direction=\"vertical\" style={{ width: '100%' }}>\n              <Select\n                  style={{ width: '100%' }}\n                  value={nodeData.design.theme}\n                  onChange={(value) => handleDesignUpdate('theme', value)}\n              >\n                  <Option value=\"light\">Light Theme</Option>\n                  <Option value=\"dark\">Dark Theme</Option>\n                  <Option value=\"custom\">Custom Theme</Option>\n              </Select>\n\n              <Select\n                style={{ width: '100%' }}\n                value={nodeData.design.position}\n                onChange={(value) => handleDesignUpdate('position', value)}\n              >\n                <Option value=\"bottom-right\">Bottom Right</Option>\n                <Option value=\"bottom-left\">Bottom Left</Option>\n                <Option value=\"top-right\">Top Right</Option>\n                <Option value=\"top-left\">Top Left</Option>\n                <Option value=\"inline\">Inline</Option>\n              </Select>\n\n              <Collapse ghost>\n                  <Panel header=\"Bot Identity\" key=\"identity\">\n                      <Space direction=\"vertical\" style={{ width: '100%' }}>\n                          <Input\n                              prefix={<RobotOutlined />}\n                              placeholder=\"Bot Name\"\n                              value={nodeData.design.botName}\n                              onChange={(e) => handleDesignUpdate('botName', e.target.value)}\n                          />\n                          \n                          <Select\n                              style={{ width: '100%' }}\n                              value={nodeData.design.botIcon}\n                              onChange={(value) => handleDesignUpdate('botIcon', value)}\n                          >\n                              <Option value=\"robot\">Robot</Option>\n                              <Option value=\"assistant\">Assistant</Option>\n                              <Option value=\"brain\">Brain</Option>\n                              <Option value=\"chat\">Chat</Option>\n                          </Select>\n                      </Space>\n                  </Panel>\n\n                  <Panel header=\"Typography\" key=\"typography\">\n                      <Space direction=\"vertical\" style={{ width: '100%' }}>\n                          <Select\n                              style={{ width: '100%' }}\n                              value={nodeData.design.font.family}\n                              onChange={(value) => handleDesignUpdate('font', { ...nodeData.design.font, family: value })}\n                          >\n                              <Option value=\"Inter, system-ui, sans-serif\">Inter</Option>\n                              <Option value=\"Arial, sans-serif\">Arial</Option>\n                              <Option value=\"Georgia, serif\">Georgia</Option>\n                              <Option value=\"Montserrat, sans-serif\">Montserrat</Option>\n                              <Option value=\"Roboto, sans-serif\">Roboto</Option>\n                          </Select>\n\n                          <Space>\n                              <div>\n                                  <Text>Chat Font Size</Text>\n                                  <InputNumber\n                                      min={12}\n                                      max={20}\n                                      value={parseInt(nodeData.design.font.size)}\n                                      onChange={(value) => handleDesignUpdate('font', { \n                                          ...nodeData.design.font, \n                                          size: `${value}px` \n                                      })}\n                                      addonAfter=\"px\"\n                                  />\n                              </div>\n                              <div>\n                                  <Text>Header Font Size</Text>\n                                  <InputNumber\n                                      min={14}\n                                      max={24}\n                                      value={parseInt(nodeData.design.font.headerSize)}\n                                      onChange={(value) => handleDesignUpdate('font', { \n                                          ...nodeData.design.font, \n                                          headerSize: `${value}px` \n                                      })}\n                                      addonAfter=\"px\"\n                                  />\n                              </div>\n                          </Space>\n                      </Space>\n                  </Panel>\n                <Panel header=\"Dimensions\" key=\"dimensions\">\n                  <Space direction=\"vertical\" style={{ width: '100%' }}>\n                    <div>\n                      <Text>Width (px)</Text>\n                      <InputNumber\n                        min={300}\n                        max={800}\n                        value={nodeData.design.dimensions.width}\n                        onChange={(value) => handleDesignUpdate('dimensions', { \n                          ...nodeData.design.dimensions, \n                          width: value \n                        })}\n                        style={{ width: '100%' }}\n                      />\n                    </div>\n                    <div>\n                      <Text>Height (px)</Text>\n                      <InputNumber\n                        min={400}\n                        max={800}\n                        value={nodeData.design.dimensions.height}\n                        onChange={(value) => handleDesignUpdate('dimensions', { \n                          ...nodeData.design.dimensions, \n                          height: value \n                        })}\n                        style={{ width: '100%' }}\n                      />\n                    </div>\n                    <div>\n                      <Text>Border Radius (px)</Text>\n                      <InputNumber\n                        min={0}\n                        max={24}\n                        value={nodeData.design.dimensions.borderRadius}\n                        onChange={(value) => handleDesignUpdate('dimensions', { \n                          ...nodeData.design.dimensions, \n                          borderRadius: value \n                        })}\n                        style={{ width: '100%' }}\n                      />\n                    </div>\n                  </Space>\n                </Panel>\n  \n                {nodeData.design.theme === 'custom' && (\n                  <Panel header=\"Colors\" key=\"colors\">\n                    <Space direction=\"vertical\" style={{ width: '100%' }}>\n                      <div>\n                        <Text>Primary Color</Text>\n                        <ColorPicker\n                          value={nodeData.design.colors.primary}\n                          onChange={(value) => handleDesignUpdate('colors', { \n                            ...nodeData.design.colors, \n                            primary: value.toHexString() \n                          })}\n                        />\n                      </div>\n                      <div>\n                        <Text>Background Color</Text>\n                        <ColorPicker\n                          value={nodeData.design.colors.background}\n                          onChange={(value) => handleDesignUpdate('colors', { \n                            ...nodeData.design.colors, \n                            background: value.toHexString() \n                          })}\n                        />\n                      </div>\n                      <div>\n                        <Text>Text Color</Text>\n                        <ColorPicker\n                          value={nodeData.design.colors.text}\n                          onChange={(value) => handleDesignUpdate('colors', { \n                            ...nodeData.design.colors, \n                            text: value.toHexString() \n                          })}\n                        />\n                      </div>\n                    </Space>\n                  </Panel>\n                )}\n              </Collapse>\n            </Space>\n          </TabPane>\n  \n          <TabPane tab=\"Behavior\" key=\"behavior\" className=\"nodrag\">\n            <Space direction=\"vertical\" style={{ width: '100%' }}>\n                <div>\n                    <Text strong>Initial Message</Text>\n                    <Tooltip title=\"The first message users see when starting a chat. Sets the tone and helps guide the conversation.\">\n                        <QuestionCircleOutlined style={{ marginLeft: 8 }} />\n                    </Tooltip>\n                    <Input\n                        value={nodeData.behavior.initialMessage}\n                        onChange={(e) => handleBehaviorUpdate('initialMessage', e.target.value)}\n                        placeholder=\"Welcome! How can I help you today?\"\n                    />\n                </div>\n\n                <div>\n                    <Text strong>Input Placeholder</Text>\n                    <Tooltip title=\"The text shown in the empty message input field. Use it to prompt or guide user input.\">\n                        <QuestionCircleOutlined style={{ marginLeft: 8 }} />\n                    </Tooltip>\n                    <Input\n                        value={nodeData.behavior.placeholderText}\n                        onChange={(e) => handleBehaviorUpdate('placeholderText', e.target.value)}\n                        placeholder=\"Type your message here...\"\n                    />\n                </div>\n\n                <Collapse ghost>\n                    <Panel header=\"History & Rate Limiting\" key=\"limits\">\n                        <Space direction=\"vertical\" style={{ width: '100%' }}>\n                            <div>\n                                <Text>Max History Length</Text>\n                                <Tooltip title=\"Maximum number of messages to keep in the chat history. Older messages will be removed when this limit is reached.\">\n                                    <QuestionCircleOutlined style={{ marginLeft: 8 }} />\n                                </Tooltip>\n                                <InputNumber\n                                    min={10}\n                                    max={100}\n                                    value={nodeData.behavior.maxHistoryLength}\n                                    onChange={(value) => handleBehaviorUpdate('maxHistoryLength', value)}\n                                />\n                            </div>\n\n                            <div>\n                                <Space align=\"center\">\n                                    <Text>Enable Rate Limiting</Text>\n                                    <Tooltip title=\"Prevent abuse by limiting the number of messages a user can send within a time window.\">\n                                        <QuestionCircleOutlined />\n                                    </Tooltip>\n                                    <Switch\n                                        checked={nodeData.behavior.rateLimit.enabled}\n                                        onChange={(checked) => handleBehaviorUpdate('rateLimit', {\n                                            ...nodeData.behavior.rateLimit,\n                                            enabled: checked\n                                        })}\n                                    />\n                                </Space>\n                            </div>\n\n                            {nodeData.behavior.rateLimit.enabled && (\n                                <>\n                                    <div>\n                                        <Text>Max Messages</Text>\n                                        <Tooltip title=\"Maximum number of messages allowed within the time window.\">\n                                            <QuestionCircleOutlined style={{ marginLeft: 8 }} />\n                                        </Tooltip>\n                                        <InputNumber\n                                            min={1}\n                                            max={100}\n                                            value={nodeData.behavior.rateLimit.maxMessages}\n                                            onChange={(value) => handleBehaviorUpdate('rateLimit', {\n                                                ...nodeData.behavior.rateLimit,\n                                                maxMessages: value\n                                            })}\n                                        />\n                                    </div>\n\n                                    <div>\n                                        <Text>Time Window (seconds)</Text>\n                                        <Tooltip title=\"Time period (in seconds) for the rate limit. For example, 10 messages per 60 seconds.\">\n                                            <QuestionCircleOutlined style={{ marginLeft: 8 }} />\n                                        </Tooltip>\n                                        <InputNumber\n                                            min={10}\n                                            max={3600}\n                                            value={nodeData.behavior.rateLimit.timeWindow}\n                                            onChange={(value) => handleBehaviorUpdate('rateLimit', {\n                                                ...nodeData.behavior.rateLimit,\n                                                timeWindow: value\n                                            })}\n                                        />\n                                    </div>\n                                </>\n                            )}\n                        </Space>\n                    </Panel>\n\n                    <Panel header=\"Advanced Settings\" key=\"advanced\">\n                        <Space direction=\"vertical\" style={{ width: '100%' }}>\n                            <div>\n                                <Space align=\"center\">\n                                    <Text>Typing Indicator</Text>\n                                    <Tooltip title=\"Show animated dots while the AI is generating a response, providing visual feedback to users.\">\n                                        <QuestionCircleOutlined />\n                                    </Tooltip>\n                                    <Switch\n                                        checked={nodeData.behavior.showTypingIndicator}\n                                        onChange={(checked) => handleBehaviorUpdate('showTypingIndicator', checked)}\n                                    />\n                                </Space>\n                            </div>\n\n                            <div>\n                                <Space align=\"center\">\n                                    <Text>Sound Effects</Text>\n                                    <Tooltip title=\"Play subtle sounds when sending and receiving messages for better user engagement.\">\n                                        <QuestionCircleOutlined />\n                                    </Tooltip>\n                                    <Switch\n                                        checked={nodeData.behavior.soundEffects}\n                                        onChange={(checked) => handleBehaviorUpdate('soundEffects', checked)}\n                                    />\n                                </Space>\n                            </div>\n\n                            <div>\n                                <Text>Auto Open Delay (seconds)</Text>\n                                <Tooltip title=\"Automatically open the chat widget after this many seconds. Set to 0 to disable auto-open.\">\n                                    <QuestionCircleOutlined style={{ marginLeft: 8 }} />\n                                </Tooltip>\n                                <InputNumber\n                                    min={0}\n                                    max={60}\n                                    value={nodeData.behavior.autoOpenDelay}\n                                    onChange={(value) => handleBehaviorUpdate('autoOpenDelay', value)}\n                                />\n                            </div>\n\n                            <div>\n                                <Space align=\"center\">\n                                    <Text>Persist History</Text>\n                                    <Tooltip title=\"Save chat history in browser storage so conversations continue across page reloads.\">\n                                        <QuestionCircleOutlined />\n                                    </Tooltip>\n                                    <Switch\n                                        checked={nodeData.behavior.persistHistory}\n                                        onChange={(checked) => handleBehaviorUpdate('persistHistory', checked)}\n                                    />\n                                </Space>\n                            </div>\n                        </Space>\n                    </Panel>\n                </Collapse>\n            </Space>\n        </TabPane>\n\n        </Tabs>\n        {renderShortcodeSection()}\n  \n        <Handle type=\"source\" position={Position.Right} id=\"a\" isConnectable={isConnectable} />\n      </Card>\n  \n      <Modal\n        title=\"Upgrade to Pro\"\n        visible={isProModalVisible}\n        onCancel={() => setIsProModalVisible(false)}\n        footer={[\n          <Button key=\"cancel\" onClick={() => setIsProModalVisible(false)}>\n            Cancel\n          </Button>,\n          <Button \n            key=\"upgrade\" \n            type=\"primary\" \n            onClick={handleUpgradeClick}\n          >\n            Upgrade to Pro\n          </Button>\n        ]}\n      >\n        <Space direction=\"vertical\" style={{ width: '100%' }}>\n          <div style={{ \n            padding: '20px', \n            background: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',\n            borderRadius: '8px',\n            marginBottom: '16px'\n          }}>\n            <Text strong style={{ color: 'white', fontSize: '16px' }}>\n              {selectedProModel?.label}\n            </Text>\n          </div>\n          <Text>\n            This AI model is available exclusively in the Pro version. \n            Upgrade to unlock access to:\n          </Text>\n          <ul style={{ marginLeft: '20px' }}>\n            <li>Advanced AI models from multiple providers</li>\n            <li>Dynamic input for the chatbot</li>\n            <li>Advanced nodes and more AI functionalities</li>\n            <li>Priority support</li>\n          </ul>\n        </Space>\n      </Modal>\n\n      <ChatPreview\n        visible={previewVisible}\n        onClose={() => setPreviewVisible(false)}\n        design={nodeData.design}\n        behavior={nodeData.behavior}\n        model={nodeData.model}\n        modelParams={nodeData.modelParams}\n        systemPrompt={nodeData.systemPrompt}\n      />\n    </>\n  );\n};\n\nexport default ChatNode;","import React, { useState, useCallback } from 'react';\nimport { Input, Typography } from 'antd';\nimport { EditOutlined } from '@ant-design/icons';\n\nconst { Title } = Typography;\n\nconst WorkflowNameHeader = ({ \n  initialName = '', \n  isEditMode = false, \n  onNameChange \n}) => {\n  const [editing, setEditing] = useState(false);\n  const [name, setName] = useState(initialName);\n\n  React.useEffect(() => {\n    setName(initialName);\n  }, [initialName]);\n\n  const handleStartEditing = () => {\n    setEditing(true);\n  };\n\n  const handleNameChange = useCallback((e) => {\n    setName(e.target.value);\n  }, []);\n\n  const handleKeyDown = useCallback((e) => {\n    if (e.key === 'Enter') {\n      setEditing(false);\n      if (name !== initialName) {\n        onNameChange(name);\n      }\n    }\n  }, [name, initialName, onNameChange]);\n\n  const handleBlur = useCallback(() => {\n    setEditing(false);\n    if (name !== initialName) {\n      onNameChange(name);\n    }\n  }, [name, initialName, onNameChange]);\n\n  const containerStyle = {\n    position: 'absolute',\n    top: '16px',\n    left: '16px', \n    backgroundColor: 'rgba(255, 255, 255, 0.95)',\n    borderRadius: '8px',\n    padding: '8px 16px',\n    boxShadow: '0 2px 8px rgba(0, 0, 0, 0.08)',\n    backdropFilter: 'blur(8px)',\n    border: '1px solid rgba(0, 0, 0, 0.06)',\n    zIndex: 10,\n    display: 'flex',\n    alignItems: 'center',\n    transition: 'all 0.2s ease',\n    maxWidth: '400px',\n    '&:hover': {\n      boxShadow: '0 4px 12px rgba(0, 0, 0, 0.1)',\n    }\n  };\n\n  if (editing) {\n    return (\n      <div style={containerStyle}>\n        <Input\n          value={name}\n          onChange={handleNameChange}\n          onKeyDown={handleKeyDown}\n          onBlur={handleBlur}\n          placeholder=\"Enter workflow name\"\n          autoFocus\n          style={{ \n            fontSize: '14px',\n            fontWeight: 500,\n            border: 'none',\n            padding: '0px',\n            backgroundColor: 'transparent',\n            width: '300px',\n            boxShadow: 'none',\n            '&:focus': {\n              boxShadow: 'none'\n            }\n          }}\n        />\n      </div>\n    );\n  }\n\n  return (\n    <div \n      onClick={handleStartEditing}\n      style={{\n        ...containerStyle,\n        cursor: 'pointer',\n      }}\n    >\n      <Title \n        level={5} \n        style={{ \n          margin: 0, \n          marginRight: '8px',\n          fontSize: '14px',\n          fontWeight: 500,\n          color: '#1f1f1f',\n          lineHeight: '1.4'\n        }}\n      >\n        {name || 'Untitled Workflow'}\n      </Title>\n      <EditOutlined \n        style={{ \n          color: '#8c8c8c', \n          fontSize: '12px',\n          opacity: 0,\n          transition: 'opacity 0.2s ease'\n        }} \n        className=\"edit-icon\"\n      />\n      <style jsx>{`\n        div:hover .edit-icon {\n          opacity: 1;\n        }\n      `}</style>\n    </div>\n  );\n};\n\nexport default WorkflowNameHeader;","import React from 'react';\nimport { getBezierPath, useKeyPress } from '@xyflow/react';\n\nconst CustomEdge = ({\n  id,\n  sourceX,\n  sourceY,\n  targetX,\n  targetY,\n  sourcePosition,\n  targetPosition,\n  markerEnd,\n  style = {},\n  data,\n  sourceHandle,\n  selected,\n}) => {\n  const deletePressed = useKeyPress('Backspace');\n\n  React.useEffect(() => {\n    if (deletePressed && selected && data?.onDelete) {\n      data.onDelete(id);\n    }\n  }, [deletePressed, selected, id, data]);\n\n  const [edgePath, labelX, labelY] = getBezierPath({\n    sourceX,\n    sourceY,\n    sourcePosition,\n    targetX,\n    targetY,\n    targetPosition,\n    curvature: 0.25\n  });\n\n  const getEdgeColor = () => {\n    const baseColor = sourceHandle === 'false' \n      ? '#faad14'\n      : sourceHandle === 'true' \n        ? '#52c41a'\n        : data?.colorMode === 'dark' ? '#9254de' : '#858585';\n\n    if (selected) {\n      if (data?.colorMode === 'dark') {\n        return baseColor === '#9254de' ? '#7828d8' : baseColor;\n      }\n      return baseColor === '#858585' ? '#666666' : baseColor;\n    }\n    \n    return baseColor;\n  };\n\n  const handleEdgeDelete = (event, id) => {\n    event.stopPropagation();\n    if (data?.onDelete) {\n      data.onDelete(id);\n    }\n  };\n\n  const edgeStyle = {\n    ...style,\n    strokeWidth: selected ? 3 : 2,\n    stroke: getEdgeColor(),\n    transition: 'stroke-width 0.2s, stroke 0.2s',\n  };\n\n  const buttonStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    background: data?.colorMode === 'dark' ? '#141414' : '#fff',\n    borderRadius: '50%',\n    border: `1px solid ${data?.colorMode === 'dark' ? '#434343' : '#d9d9d9'}`,\n    width: '25px',\n    height: '25px',\n    display: 'flex',\n    justifyContent: 'center',\n    alignItems: 'center',\n    cursor: 'pointer',\n    fontSize: '20px',\n    lineHeight: '16px',\n    fontFamily: '-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial',\n    color: '#ff4d4f',\n    userSelect: 'none',\n    transform: 'translateY(0px)', // Fine-tune vertical centering\n    paddingBottom: '4px',\n  };\n\n  return (\n    <>\n      <path\n        id={id}\n        style={edgeStyle}\n        className=\"react-flow__edge-path\"\n        d={edgePath}\n        markerEnd={markerEnd}\n      />\n      <foreignObject\n        width={26}\n        height={26}\n        x={labelX - 12.5}\n        y={labelY - 12.5}\n        className={`edge-delete-button ${selected ? 'selected' : ''}`}\n        requiredExtensions=\"http://www.w3.org/1999/xhtml\"\n      >\n        <div\n          style={buttonStyle}\n          onClick={(event) => handleEdgeDelete(event, id)}\n          onMouseEnter={(e) => {\n            e.currentTarget.style.background = data?.colorMode === 'dark' ? '#1f1f1f' : '#fff1f0';\n            e.currentTarget.style.borderColor = '#ff4d4f';\n          }}\n          onMouseLeave={(e) => {\n            e.currentTarget.style.background = data?.colorMode === 'dark' ? '#141414' : '#fff';\n            e.currentTarget.style.borderColor = data?.colorMode === 'dark' ? '#434343' : '#d9d9d9';\n          }}\n        >\n          ×\n        </div>\n      </foreignObject