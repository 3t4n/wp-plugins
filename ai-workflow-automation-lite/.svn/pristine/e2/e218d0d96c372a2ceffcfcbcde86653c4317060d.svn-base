te, useEffect } from 'react';\nimport { \n  message, Table, Input, DatePicker, Space, Button, Modal, Typography, \n  Card, Timeline, Tag, Tooltip, Select, Statistic, Row, Col \n} from 'antd';\nimport { \n  SearchOutlined, CalendarOutlined, TeamOutlined, \n  MessageOutlined, SyncOutlined, UserOutlined, RobotOutlined \n} from '@ant-design/icons';\nimport dayjs from 'dayjs';\nimport relativeTime from 'dayjs/plugin/relativeTime';\nimport { adminInstance } from './api/axiosConfig';\n\ndayjs.extend(relativeTime);\n\nconst { RangePicker } = DatePicker;\nconst { Title, Text } = Typography;\nconst { Option } = Select;\n\nconst ChatLogs = () => {\n  const [logs, setLogs] = useState([]);\n  const [loading, setLoading] = useState(false);\n  const [detailsVisible, setDetailsVisible] = useState(false);\n  const [selectedChat, setSelectedChat] = useState(null);\n  const [dateRange, setDateRange] = useState(null);\n  const [searchText, setSearchText] = useState('');\n  const [selectedWorkflow, setSelectedWorkflow] = useState(null);\n  const [workflows, setWorkflows] = useState([]);\n  const [pagination, setPagination] = useState({\n    current: 1,\n    pageSize: 10,\n    total: 0\n  });\n  const [statistics, setStatistics] = useState({\n    totalSessions: 0,\n    activeToday: 0,\n    averageMessagesPerChat: 0,\n    totalMessages: 0\n  });\n\n  useEffect(() => {\n    fetchWorkflows();\n    fetchLogs();\n    fetchStatistics();\n  }, [pagination.current, pagination.pageSize, dateRange, searchText, selectedWorkflow]);\n\n  const fetchWorkflows = async () => {\n    try {\n      const response = await adminInstance.get('/workflows');\n      \n      // Check if response.data.workflows exists and is an array\n      if (response.data.workflows && Array.isArray(response.data.workflows)) {\n        setWorkflows(response.data.workflows);\n      } else {\n        console.error('Invalid workflows data:', response.data);\n        setWorkflows([]);\n      }\n    } catch (error) {\n      console.error('Error fetching workflows:', error);\n      setWorkflows([]);\n    }\n  };\n\n  const fetchStatistics = async () => {\n    try {\n      const response = await adminInstance.get('/chat-statistics');\n      \n      // Add default values for statistics\n      setStatistics({\n        totalSessions: response.data?.totalSessions || 0,\n        activeToday: response.data?.activeToday || 0,\n        averageMessagesPerChat: response.data?.averageMessagesPerChat || 0,\n        totalMessages: response.data?.totalMessages || 0\n      });\n    } catch (error) {\n      console.error('Error fetching chat statistics:', error);\n      // Set default values on error\n      setStatistics({\n        totalSessions: 0,\n        activeToday: 0,\n        averageMessagesPerChat: 0,\n        totalMessages: 0\n      });\n    }\n  };\n\n  const fetchLogs = async () => {\n    setLoading(true);\n    try {\n      const params = {\n        page: pagination.current,\n        per_page: pagination.pageSize,\n        search: searchText,\n        workflow_id: selectedWorkflow,\n        start_date: dateRange?.[0]?.format('YYYY-MM-DD'),\n        end_date: dateRange?.[1]?.format('YYYY-MM-DD')\n      };\n  \n      const response = await adminInstance.get('/chat-logs', { params });\n    \n      \n      // Add type checking before setting state\n      if (!response.data.logs || !Array.isArray(response.data.logs)) {\n        console.error('Invalid logs data:', response.data);\n        setLogs([]);  // Set empty array as fallback\n      } else {\n        setLogs(response.data.logs);\n      }\n  \n      setPagination(prev => ({\n        ...prev,\n        total: response.data.total || 0\n      }));\n    } catch (error) {\n      console.error('Error fetching chat logs:', error);\n      setLogs([]); // Set empty array on error\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleDateRangeChange = (range) => {\n    setDateRange(range);\n    setPagination(prev => ({ ...prev, current: 1 }));\n  };\n\n  const handleSearch = (value) => {\n    setSearchText(value);\n    setPagination(prev => ({ ...prev, current: 1 }));\n  };\n\n  const handleWorkflowChange = (value) => {\n    setSelectedWorkflow(value);\n    setPagination(prev => ({ ...prev, current: 1 }));\n  };\n\n  const handleViewDetails = async (record) => {\n    try {\n      const response = await adminInstance.get(`/chat-messages/${record.session_id}`);\n      setSelectedChat({\n        ...record,\n        messages: response.data\n      });\n      setDetailsVisible(true);\n    } catch (error) {\n      console.error('Error fetching chat details:', error);\n    }\n  };\n\n  const columns = [\n    {\n      title: 'Workflow',\n      dataIndex: 'workflow_name',\n      key: 'workflow_name',\n      render: (text) => <Text strong>{text}</Text>\n    },\n    {\n      title: 'Session ID',\n      dataIndex: 'session_id',\n      key: 'session_id',\n      render: (text) => <Text code>{text.slice(0, 8)}...</Text>\n    },\n    {\n      title: 'Messages',\n      dataIndex: 'message_count',\n      key: 'message_count',\n      sorter: true,\n      render: (count) => (\n        <Tag color=\"blue\">\n          <MessageOutlined /> {count}\n        </Tag>\n      )\n    },\n    {\n      title: 'First Interaction',\n      dataIndex: 'created_at',\n      key: 'created_at',\n      sorter: true,\n      render: (date) => dayjs(date).format('YYYY-MM-DD HH:mm:ss')\n    },\n    {\n      title: 'Last Activity',\n      dataIndex: 'updated_at',\n      key: 'updated_at',\n      sorter: true,\n      render: (date) => (\n        <Tooltip title={dayjs(date).format('YYYY-MM-DD HH:mm:ss')}>\n          {dayjs(date).fromNow()}\n        </Tooltip>\n      )\n    },\n    {\n      title: 'Actions',\n      key: 'actions',\n      render: (_, record) => (\n        <Button \n          type=\"primary\" \n          onClick={() => handleViewDetails(record)}\n          icon={<MessageOutlined />}\n        >\n          View Chat\n        </Button>\n      )\n    }\n  ];\n\n  const renderChatDetails = () => {\n    if (!selectedChat) return null;\n\n    return (\n      <Modal\n        title={\n          <Space>\n            <MessageOutlined />\n            <span>Chat Session Details</span>\n            <Tag color=\"blue\">{selectedChat.workflow_name}</Tag>\n          </Space>\n        }\n        visible={detailsVisible}\n        onCancel={() => setDetailsVisible(false)}\n        width={800}\n        footer={null}\n      >\n        <Card>\n          <Row gutter={16}>\n            <Col span={12}>\n              <Statistic \n                title=\"Total Messages\" \n                value={selectedChat.message_count} \n                prefix={<MessageOutlined />} \n              />\n            </Col>\n            <Col span={12}>\n              <Statistic\n                title=\"Session Duration\"\n                value={dayjs(selectedChat.updated_at).diff(selectedChat.created_at, 'minute')}\n                suffix=\"minutes\"\n              />\n            </Col>\n          </Row>\n        </Card>\n\n        <Timeline style={{ marginTop: 24 }}>\n          {selectedChat.messages?.map((message, index) => (\n            <Timeline.Item\n              key={index}\n              dot={message.role === 'user' ? <UserOutlined /> : <RobotOutlined />}\n              color={message.role === 'user' ? 'blue' : 'green'}\n            >\n              <Card\n                size=\"small\"\n                style={{ \n                  backgroundColor: message.role === 'user' ? '#f0f5ff' : '#f6ffed',\n                  marginBottom: 16\n                }}\n              >\n                <Space direction=\"vertical\">\n                  <Text strong>\n                    {message.role === 'user' ? 'User' : 'Assistant'}\n                  </Text>\n                  <Text>{message.content}</Text>\n                  <Text type=\"secondary\" style={{ fontSize: '12px' }}>\n                    {dayjs(message.created_at).format('YYYY-MM-DD HH:mm:ss')}\n                  </Text>\n                </Space>\n              </Card>\n            </Timeline.Item>\n          ))}\n        </Timeline>\n      </Modal>\n    );\n  };\n\n  return (\n    <div style={{ padding: '24px' }}>\n      <Title level={2}>Chat Logs</Title>\n\n      <Row gutter={[16, 16]} style={{ marginBottom: 24 }}>\n        <Col span={6}>\n          <Card>\n            <Statistic\n              title=\"Total Chat Sessions\"\n              value={statistics.totalSessions}\n              prefix={<TeamOutlined />}\n            />\n          </Card>\n        </Col>\n        <Col span={6}>\n          <Card>\n            <Statistic\n              title=\"Active Today\"\n              value={statistics.activeToday}\n              prefix={<MessageOutlined />}\n            />\n          </Card>\n        </Col>\n        <Col span={6}>\n          <Card>\n            <Statistic\n              title=\"Average Messages/Chat\"\n              value={statistics.averageMessagesPerChat}\n              precision={1}\n              prefix={<MessageOutlined />}\n            />\n          </Card>\n        </Col>\n        <Col span={6}>\n          <Card>\n            <Statistic\n              title=\"Total Messages\"\n              value={statistics.totalMessages}\n              prefix={<MessageOutlined />}\n            />\n          </Card>\n        </Col>\n      </Row>\n\n      <Space style={{ marginBottom: 16 }}>\n        <Input\n          placeholder=\"Search by session ID or content\"\n          prefix={<SearchOutlined />}\n          onChange={(e) => handleSearch(e.target.value)}\n          style={{ width: 300 }}\n        />\n        <RangePicker \n          onChange={handleDateRangeChange}\n          style={{ width: 300 }}\n        />\n        <Select\n          placeholder=\"Select Workflow\"\n          style={{ width: 200 }}\n          onChange={handleWorkflowChange}\n          allowClear\n        >\n          {workflows.map(workflow => (\n            <Option key={workflow.id} value={workflow.id}>\n              {workflow.name}\n            </Option>\n          ))}\n        </Select>\n        <Button \n          icon={<SyncOutlined />} \n          onClick={() => fetchLogs()}\n        >\n          Refresh\n        </Button>\n      </Space>\n\n      <Table\n        columns={columns}\n        dataSource={logs}\n        loading={loading}\n        pagination={pagination}\n        onChange={(newPagination) => setPagination(newPagination)}\n        rowKey=\"session_id\"\n      />\n\n      {renderChatDetails()}\n    </div>\n  );\n};\n\nexport default ChatLogs;\n","// src/App.js\nimport React, { useState } from 'react';\nimport { message, ConfigProvider, Layout, Menu, Modal, Typography, Button } from 'antd';\nimport { MessageOutlined, ApiOutlined, SettingOutlined, ToolOutlined, OrderedListOutlined } from '@ant-design/icons';\nimport WorkflowBuilder from './components/WorkflowBuilder';\nimport WorkflowManagement from './components/WorkflowManagement';\nimport Settings from './components/Settings';\nimport WorkflowQueue from './components/WorkflowQueue';\nimport ChatLogs from './components/ChatLogs';\nimport './styles/CustomNodeStyles.css';\nimport './styles/chat.css';\n\nconst { Header, Content } = Layout;\nconst { Text } = Typography;\n\nmessage.config({\n  top: 40, \n  duration: 3, \n  maxCount: 2, \n});\n\nconst App = () => {\n  const [isProModalVisible, setIsProModalVisible] = useState(false);\n\n  const getCurrentPage = () => {\n    if (window.wpAiWorkflowsSettings && window.wpAiWorkflowsSettings.page) {\n      return window.wpAiWorkflowsSettings.page;\n    }\n    const urlParams = new URLSearchParams(window.location.search);\n    return urlParams.get('action') || 'management';\n  };\n\n  const renderContent = () => {\n    const currentPage = getCurrentPage();\n    console.log('Rendering content for page:', currentPage);\n\n    switch (currentPage) {\n      case 'builder':\n      case 'edit':\n        return <WorkflowBuilder />;\n      case 'management':\n        return <WorkflowManagement />;\n      case 'settings':\n        return <Settings />;\n      case 'queue':\n        return <WorkflowQueue />;\n      case 'chat-logs':\n        return <ChatLogs />;\n      default:\n        if (currentPage === 'wp-ai-workflows') {\n          return <WorkflowBuilder />;\n        }\n        return <div>Page not found. Current page: {currentPage}</div>;\n    }\n  };\n\n  const onMenuClick = (item) => {\n    const baseUrl = window.location.href.split('?')[0];\n    window.location.href = `${baseUrl}?page=wp-ai-workflows&action=${item.key}`;\n  };\n\n  const handleProButtonClick = () => {\n    setIsProModalVisible(true);\n  };\n\n  const handleProModalOk = () => {\n    setIsProModalVisible(false);\n    window.open('https://wpaiworkflowautomation.com/pricing?utm_source=freedownload&utm_medium=lite&utm_content=app-screen', '_blank');\n  };\n\n  return (\n    <ConfigProvider>\n      <Layout className=\"layout\" style={{ minHeight: '100vh' }}>\n        <Header style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>\n          <Menu \n            theme=\"dark\" \n            mode=\"horizontal\" \n            defaultSelectedKeys={[getCurrentPage()]} \n            onClick={onMenuClick}\n            style={{ flex: 1 }}\n          >\n            <Menu.Item key=\"builder\" icon={<ApiOutlined />}>\n              Workflow Builder\n            </Menu.Item>\n            <Menu.Item key=\"management\" icon={<SettingOutlined />}>\n              Workflow Management\n            </Menu.Item>\n            <Menu.Item key=\"queue\" icon={<OrderedListOutlined />}>\n              Workflow Queue\n            </Menu.Item>\n            <Menu.Item key=\"chat-logs\" icon={<MessageOutlined />}>\n              Chat Logs\n            </Menu.Item>\n            <Menu.Item key=\"settings\" icon={<ToolOutlined />}>\n              Settings\n            </Menu.Item>\n            </Menu>\n            <Button  \n            onClick={handleProButtonClick}\n            className=\"upgrade-button\"\n            style={{\n              background: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',\n              border: 'none',\n              color: 'white',\n              marginRight: '20px',\n            }}\n          >\n            <span><strong>Unlock Premium Features</strong> – Start Your 14-Day Free Trial</span>\n          </Button>\n          <Text style={{ \n            color: 'white', \n            marginLeft: '20px',\n            fontFamily: 'IBM Plex Mono, monospace',\n            whiteSpace: 'nowrap'\n          }}>\n            <Text strong style={{ color: 'white', fontFamily: 'IBM Plex Mono, monospace' }}>WP AI Workflow Automation</Text>{' '}\n            <Text italic style={{ fontFamily: 'IBM Plex Mono, monospace', color: 'white', fontWeight: 'normal' }}>Lite</Text>\n          </Text>\n        </Header>\n        <Content\n        style={\n          getCurrentPage() === 'builder' || getCurrentPage() === 'edit'\n            ? { padding: '0' } // Full-screen style for builder\n            : { padding: '0 50px' } // Padding for other pages\n        }\n      >\n        <div\n          className=\"site-layout-content\"\n          style={\n            getCurrentPage() === 'builder' || getCurrentPage() === 'edit'\n              ? { margin: '0' } // Full-screen style for builder\n              : { margin: '16px 0' } // Margin for other pages\n          }\n        >\n          {renderContent()}\n        </div>\n      </Content>\n        <Modal\n          title=\"Upgrade\"\n          visible={isProModalVisible}\n          onOk={handleProModalOk}\n          onCancel={() => setIsProModalVisible(false)}\n          okText=\"Learn More\"\n          cancelText=\"Close\"\n        >\n          <p>Upgrade to AI Workflow Automation Pro to automate complex tasks and access advanced features. Subscribe now to unlock the full potential of AI-powered workflows.</p>\n        </Modal>\n      </Layout>\n    </ConfigProvider>\n  );\n};\n\nexport default App;","const reportWebVitals = onPerfEntry => {\n  if (onPerfEntry && onPerfEntry instanceof Function) {\n    import('web-vitals').then(({ getCLS, getFID, getFCP, getLCP, getTTFB }) => {\n      getCLS(onPerfEntry);\n      getFID(onPerfEntry);\n      getFCP(onPerfEntry);\n      getLCP(onPerfEntry);\n      getTTFB(onPerfEntry);\n    });\n  }\n};\n\nexport default reportWebVitals;\n","// chatSecurity.js\nimport DOMPurify from 'dompurify';\n\nexport const MESSAGE_LIMITS = {\n  MAX_LENGTH: 2000,\n  MIN_INTERVAL: 500, // ms between messages\n};\n\nexport const sanitizeInput = (input) => {\n  if (!input) return '';\n  // Only trim whitespace, don't remove special characters\n  return input.trim().slice(0, MESSAGE_LIMITS.MAX_LENGTH);\n};\n\nexport const sanitizeContent = (content) => {\n  return DOMPurify.sanitize(content, {\n    ALLOWED_TAGS: ['p', 'br', 'b', 'i', 'em', 'strong', 'a', 'ul', 'ol', 'li', 'pre'],\n    ALLOWED_ATTR: ['href', 'target', 'rel', 'class'],\n  });\n};\n\n// Rate limiting helper\nexport class RateLimiter {\n  constructor(maxMessages, timeWindow) {\n    this.maxMessages = maxMessages;\n    this.timeWindow = timeWindow * 1000; // convert to milliseconds\n    this.messageTimestamps = [];\n  }\n\n  canSendMessage() {\n    const now = Date.now();\n    // Remove old timestamps\n    this.messageTimestamps = this.messageTimestamps.filter(\n      timestamp => now - timestamp < this.timeWindow\n    );\n    \n    // Check if under limit\n    return this.messageTimestamps.length < this.maxMessages;\n  }\n\n  recordMessage() {\n    this.messageTimestamps.push(Date.now());\n  }\n\n  getTimeUntilNextAllowed() {\n    if (this.canSendMessage()) return 0;\n    \n    const now = Date.now();\n    const oldestTimestamp = this.messageTimestamps[0];\n    return oldestTimestamp + this.timeWindow - now;\n  }\n}","import React, { useState, useEffect, useRef } from 'react';\nimport { \n  RobotOutlined, \n  CustomerServiceOutlined, \n  BulbOutlined, \n  MessageOutlined,\n  SoundOutlined,\n  MutedOutlined\n} from '@ant-design/icons';\nimport PropTypes from 'prop-types';\nimport { sanitizeInput, sanitizeContent, RateLimiter } from './chatSecurity';\n\n\nconst ChatWidget = ({ workflowId, config, settings }) => {\n    const [messages, setMessages] = useState([]);\n    const [inputValue, setInputValue] = useState('');\n    const [isOpen, setIsOpen] = useState(config.design.position === 'inline');\n    const [sessionId, setSessionId] = useState(null);\n    const [isTyping, setIsTyping] = useState(false);\n    const [messageQueue, setMessageQueue] = useState([]);\n    const [errorMessage, setErrorMessage] = useState('');\n    const [soundEnabled, setSoundEnabled] = useState(\n        localStorage.getItem(`wp_ai_chat_sound_${workflowId}`) !== 'false'\n    );\n    const [isFirstMessage, setIsFirstMessage] = useState(true);\n    \n    // Refs\n    const messagesEndRef = useRef(null);\n    const eventSourceRef = useRef(null);\n    const audioRef = useRef({\n        send: new Audio(`${settings.assetsUrl}/sounds/send.mp3`),\n        receive: new Audio(`${settings.assetsUrl}/sounds/receive.mp3`)\n    });\n    const rateLimiter = useRef(new RateLimiter(\n        config.behavior.rateLimit.maxMessages,\n        config.behavior.rateLimit.timeWindow\n    ));\n    const [currentMessage, setCurrentMessage] = useState({\n        message: '',\n        timestamp: null\n    });\n\n    const scrollToBottom = () => {\n        if (messagesEndRef.current && config.design.position !== 'inline') {\n            messagesEndRef.current.scrollIntoView({ behavior: 'smooth' });\n        }\n    };\n\n    const fetchChatHistory = async () => {\n        try {\n            const response = await fetch(\n                `${settings.apiUrl}/chat-history?workflow_id=${workflowId}&session_id=${sessionId}`,\n                {\n                    headers: {\n                        'X-WP-Nonce': settings.nonce\n                    }\n                }\n            );\n            const data = await response.json();\n            if (data.success && data.history) {\n                setMessages(data.history);\n            }\n        } catch (error) {\n            console.error('Error fetching chat history');\n        }\n    };\n\n    // Add handler for header click\n    const handleHeaderClick = (e) => {\n        // If it's not an inline widget, allow closing via header click\n        if (config.design.position !== 'inline') {\n            e.stopPropagation();\n            setIsOpen(false);\n        }\n    };\n\n\n\n    useEffect(() => {\n        // Load chat history\n        if (sessionId) {\n            fetchChatHistory();\n        } else {\n            // Only check localStorage if persistHistory is enabled\n            if (config.behavior.persistHistory) {\n                const storedSessionId = localStorage.getItem(`wp_ai_chat_session_${workflowId}`);\n                if (storedSessionId) {\n                    setSessionId(storedSessionId);\n                }\n            }\n        }\n    \n        // Cleanup effect\n        return () => {\n            if (eventSourceRef.current) {\n                eventSourceRef.current.close();\n            }\n            // Clear session if persistence is disabled\n            if (!config.behavior.persistHistory) {\n                localStorage.removeItem(`wp_ai_chat_session_${workflowId}`);\n            }\n        };\n    }, [sessionId, workflowId, config.behavior.persistHistory]);\n\n    useEffect(() => {\n        // Only run auto-open if:\n        // 1. Not already open\n        // 2. Not an inline chat\n        // 3. Auto-open delay is set\n        // 4. Auto-open delay is greater than 0\n        if (!isOpen && \n            config.design.position !== 'inline' && \n            config.behavior.autoOpenDelay && \n            config.behavior.autoOpenDelay > 0\n        ) {\n            const timer = setTimeout(() => {\n                setIsOpen(true);\n            }, config.behavior.autoOpenDelay * 1000); // Convert seconds to milliseconds\n    \n            // Cleanup timer if component unmounts\n            return () => clearTimeout(timer);\n        }\n    }, []);\n\n    useEffect(() => {\n        // Set initial message if it exists\n        if (isFirstMessage && config.behavior.initialMessage) {\n          setMessages([{\n            role: 'assistant',\n            content: config.behavior.initialMessage\n          }]);\n          setIsFirstMessage(false);\n        }\n    }, [config.behavior.initialMessage, isFirstMessage]);\n\n    useEffect(() => {\n        if (messageQueue.length > 0 && !isTyping) {\n            const retryMessage = async () => {\n                const messageData = messageQueue[0];\n                try {\n                    const response = await fetch(`${settings.apiUrl}/chat`, {\n                        method: 'POST',\n                        headers: {\n                            'Content-Type': 'application/json',\n                            'X-WP-Nonce': settings.nonce\n                        },\n                        body: JSON.stringify({\n                            workflow_id: workflowId,\n                            message: messageData.message,\n                            session_id: sessionId\n                        }),\n                        signal: AbortSignal.timeout(30000)\n                    });\n\n                    if (!response.ok) {\n                        throw new Error(response.statusText);\n                    }\n\n                    const data = await response.json();\n                    setMessages(prev => [...prev, \n                        { role: 'user', content: messageData.message },\n                        { role: 'assistant', content: sanitizeContent(data.message) }\n                    ]);\n                    \n                    setMessageQueue(prev => prev.slice(1)); // Remove from queue\n                } catch (error) {\n                    console.error('Retry failed');\n                }\n            };\n            retryMessage();\n        }\n    }, [messageQueue, isTyping, sessionId, settings.apiUrl, settings.nonce, workflowId]);\n\n    useEffect(scrollToBottom, [messages]);\n\n\n    if (!config || !config.design || !config.behavior) {\n        console.error('Invalid chat configuration');\n        return null;\n    }\n\n    if (!isOpen && config.design.position !== 'inline') {\n        return (\n            <button \n                className={`chat-launcher ${config.design.position}`}\n                onClick={() => setIsOpen(true)}\n                aria-label=\"Open chat\"\n            >\n                <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\">\n                    <path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\" />\n                </svg>\n            </button>\n        );\n    }\n\n\n    const renderMessage = (message, index) => {\n        const sanitizedContent = sanitizeContent(message.content);\n        return (\n            <div key={index} className={`chat-message ${message.role}`}>\n                <div className=\"message-content\"\n                     dangerouslySetInnerHTML={{ __html: sanitizedContent }} />\n            </div>\n        );\n    };\n\n    const handleSendMessage = async () => {\n        try {\n            if (!inputValue.trim()) return;\n    \n            // Rate limit check\n            if (!rateLimiter.current.canSendMessage()) {\n                const waitTime = rateLimiter.current.getTimeUntilNextAllowed();\n                setErrorMessage(`Please wait ${Math.ceil(waitTime/1000)} seconds before sending another message`);\n                return;\n            }\n    \n            // Input sanitization\n            const cleanMessage = sanitizeInput(inputValue);\n            if (!cleanMessage) {\n                setErrorMessage('Invalid message content');\n                return;\n            }\n    \n            // Prepare message data\n            const newMessageData = {\n                message: cleanMessage,\n                timestamp: Date.now()\n            };\n            setCurrentMessage(newMessageData);\n    \n            // Update rate limiter\n            rateLimiter.current.recordMessage();\n    \n            // Reset input and update UI state\n            setInputValue('');\n            setErrorMessage('');\n            setMessages(prev => [...prev, { role: 'user', content: newMessageData.message }]);\n            setIsTyping(true);\n    \n            // Play send sound if enabled\n            if (soundEnabled && config.behavior.soundEffects) {\n                playSound('send');\n            }\n    \n            // Make API request\n            const response = await fetch(`${settings.apiUrl}/chat`, {\n                method: 'POST',\n                headers: {\n                    'Content-Type': 'application/json',\n                    'X-WP-Nonce': settings.nonce\n                },\n                body: JSON.stringify({\n                    workflow_id: workflowId,\n                    message: newMessageData.message,\n                    session_id: sessionId\n                }),\n                signal: AbortSignal.timeout(30000)\n            });\n    \n            if (!response.ok) {\n                throw new Error(response.statusText);\n            }\n    \n            const data = await response.json();\n            \n            // Handle session persistence\n            if (data.session_id) {\n                setSessionId(data.session_id);\n                if (config.behavior.persistHistory) {\n                    // Store in localStorage for persistence\n                    localStorage.setItem(`wp_ai_chat_session_${workflowId}`, data.session_id);\n                }\n                // Set cookie for API requests\n                document.cookie = `wp_ai_chat_session_${workflowId}=${data.session_id}; path=/; Secure; SameSite=Strict`;\n            }\n    \n            // Update messages with AI response\n            setMessages(prev => [\n                ...prev,\n                { role: 'assistant', content: sanitizeContent(data.message) }\n            ]);\n    \n            // Clear current message after successful send\n            setCurrentMessage({ message: '', timestamp: null });\n    \n            // Play receive sound if enabled\n            if (soundEnabled && config.behavior.soundEffects) {\n                playSound('receive');\n            }\n    \n        } catch (error) {\n            console.error('Chat error');\n            setErrorMessage('Failed to send message. Please try again.');\n            \n            // Add to retry queue if network error\n            if (error.name === 'AbortError' || error.name === 'TypeError') {\n                setMessageQueue(prev => [...prev, currentMessage]);\n            }\n        } finally {\n            setIsTyping(false);\n        }\n    };\n    \n    const renderError = () => {\n        if (!errorMessage) return null;\n        return (\n            <div className=\"error-message\" role=\"alert\">\n                {errorMessage}\n            </div>\n        );\n    };\n\n    const handleKeyPress = (e) => {\n        if (e.key === 'Enter' && !e.shiftKey) {\n            e.preventDefault();\n            handleSendMessage();\n        }\n    };\n\n    const getBotIcon = () => {\n        switch (config.design.botIcon) {\n          case 'robot':\n            return <RobotOutlined style={{ fontSize: '20px' }} />;\n          case 'assistant':\n            return <CustomerServiceOutlined style={{ fontSize: '20px' }} />;\n          case 'brain':\n            return <BulbOutlined style={{ fontSize: '20px' }} />;\n          case 'chat':\n            return <MessageOutlined style={{ fontSize: '20px' }} />;\n          default:\n            return <RobotOutlined style={{ fontSize: '20px' }} />;\n        }\n    };\n\n    const playSound = (type) => {\n        try {\n            if (soundEnabled && audioRef.current[type]) {\n                audioRef.current[type].play().catch(() => {\n                    // Silently fail - sound playback isn't critical\n                    console.log('Sound playback failed');\n                });\n            }\n        } catch (error) {\n            // Don't show error to user - sound isn't critical\n            console.log('Sound playback error');\n        }\n    };\n\n    const toggleSound = () => {\n        setSoundEnabled(!soundEnabled);\n        // Store sound preference\n        localStorage.setItem(`wp_ai_chat_sound_${workflowId}`, !soundEnabled);\n    };\n\n    // Get dynamic styles based on config\n    const getStyles = () => ({\n        container: {\n            width: `${config.design.dimensions.width}px`,\n            height: `${config.design.dimensions.height}px`,\n            fontFamily: config.design.font.family,\n            fontSize: config.design.font.size,\n            '--chat-border-radius': `${config.design.dimensions.borderRadius}px`,\n            ...(config.design.position === 'inline' ? {\n                position: 'relative',\n                width: '100%',\n                height: 'auto',\n                minHeight: '500px',\n                margin: '20px 0',\n                boxShadow: 'none'\n            } : {}),\n            ...getThemeStyles()\n        },\n        header: {\n            fontSize: config.design.font.headerSize,\n            borderTopLeftRadius: `${config.design.dimensions.borderRadius}px`,\n            borderTopRightRadius: `${config.design.dimensions.borderRadius}px`,\n        },\n        messages: {\n            fontSize: config.design.font.size\n        }\n    });\n\n  const getThemeStyles = () => {\n    if (config.design.theme === 'custom') {\n      return {\n        '--chat-primary': config.design.colors.primary,\n        '--chat-bg': config.design.colors.background,\n        '--chat-text': config.design.colors.text,\n        '--chat-secondary': config.design.colors.secondary,\n      };\n    }\n    return {};\n  };\n\n    return (\n        <div className={`wp-ai-workflows-chat-widget ${config.design.theme} ${config.design.position}`}\n                style={getStyles().container}>\n                <div className=\"chat-header\" style={getStyles().header} onClick={handleHeaderClick}>\n                    <div className=\"header-content\">\n                        {getBotIcon()}\n                        <span className=\"bot-name\">{config.design.botName}</span>\n                    </div>\n                    <div className=\"header-actions\">\n                        <button \n                            className=\"sound-toggle\"\n                            onClick={(e) => {\n                                e.stopPropagation(); // Prevent header click\n                                toggleSound();\n                            }}\n                            aria-label={soundEnabled ? 'Mute sound' : 'Unmute sound'}\n                        >\n                            {soundEnabled ? <SoundOutlined /> : <MutedOutlined />}\n                        </button>\n                        {config.design.position !== 'inline' && (\n                            <button \n                                className=\"close-button\"\n                                onClick={(e) => {\n                                    e.stopPropagation(); // Prevent header click\n                                    setIsOpen(false);\n                                }}\n                                aria-label=\"Close chat\"\n                            >\n                                ×\n                            </button>\n                        )}\n                    </div>\n                </div>\n\n                <div className=\"chat-messages\">\n                    {messages.map((message, index) => renderMessage(message, index))}\n                    {renderError()}\n                    {isTyping && (\n                        <div className=\"typing-indicator\">\n                            <span className=\"typing-dot\"></span>\n                            <span className=\"typing-dot\"></span>\n                            <span className=\"typing-dot\"></span>\n                        </div>\n                    )}\n                    {messages.length > 0 && <div ref={messagesEndRef} style={{ height: '1px' }} />}\n                </div>\n\n            <div className=\"chat-input\">\n                <input\n                    type=\"text\"\n                    value={inputValue}\n                    onChange={(e) => setInputValue(e.target.value)}\n                    onKeyPress={handleKeyPress}\n                    placeholder={config.behavior.placeholderText}\n                    disabled={isTyping}\n                />\n                <button \n                    onClick={handleSendMessage}\n                    disabled={isTyping || !inputValue.trim()}\n                >\n                    Send\n                </button>\n            </div>\n            <div className=\"powered-by\">\n            <a \n                href=\"https://bit.ly/3CEdP35\"\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                title=\"Create your own AI chatbot\"\n            >\n                Powered by AI Workflow Automation Plugin\n            </a>\n            </div>\n        </div>\n    );\n};\n\n\nChatWidget.propTypes = {\n    workflowId: PropTypes.string.isRequired,\n    config: PropTypes.object.isRequired,\n    settings: PropTypes.shape({\n        apiUrl: PropTypes.string.isRequired,\n        nonce: PropTypes.string.isRequired,\n        siteUrl: PropTypes.string.isRequired,\n        assetsUrl: PropTypes.string.isRequired\n    }).isRequired\n};\n\n\nexport default ChatWidget;\n","import React from 'react';\nimport { createRoot } from 'react-dom/client';\nimport './index.css';\nimport App from './App';\nimport reportWebVitals from './reportWebVitals';\nimport { setupAdminInstance } from './components/api/axiosConfig';\nimport ChatWidget from './components/chat/ChatWidget';\n\n// Get settings from window with proper type checking\nconst getSettings = () => {\n    return {\n        ...(window.wpAiWorkflowsSettings || {}),\n        apiUrl: window.wpAiWorkflowsSettings?.apiUrl || '/wp-json/wp-ai-workflows/v1',\n        nonce: window.wpAiWorkflowsSettings?.nonce || '',\n        siteUrl: window.wpAiWorkflowsSettings?.siteUrl || '',\n        assetsUrl: window.wpAiWorkflowsSettings?.assetsUrl || '',\n        isChat: window.wpAiWorkflowsSettings?.isChat || false\n    };\n};\n\nconst settings = getSettings();\n\n// Initialize based on context\nif (settings.isChat) {\n    const initializeChatWidget = async (container) => {\n        const workflowId = container.dataset.workflowId;\n        try {\n            // Fetch latest config from backend\n            const response = await fetch(\n                `${settings.apiUrl}/chat-config/${workflowId}`, {\n                    headers: {\n                        'X-WP-Nonce': settings.nonce\n                    }\n                }\n            );\n            \n            if (!response.ok) {\n                throw new Error('Failed to fetch chat config');\n            }\n            \n            const data = await response.json();\n            const root = createRoot(container);\n            root.render(\n                <ChatWidget \n                    workflowId={workflowId}\n                    config={data.config}\n                    settings={settings}\n                />\n            );\n        } catch (error) {\n            console.error('Error initializing chat widget:', error);\n        }\n    };\n \n    const initializeChatWidgets = () => {\n        // Initialize containers with class\n        document.querySelectorAll('.wp-ai-workflows-chat-container').forEach(container => {\n            initializeChatWidget(container);\n        });\n \n        // Initialize containers with data attribute\n        document.querySelectorAll('[data-wp-ai-chat]').forEach(container => {\n            initializeChatWidget(container);\n        });\n    };\n \n    // Add global initialization function\n    window.wpAiWorkflowsChat = {\n        initChat: (containerId) => {\n            const container = document.getElementById(containerId);\n            if (container) {\n                initializeChatWidget(container);\n            }\n        }\n    };\n \n    // Initialize chat widgets\n    if (document.readyState === 'loading') {\n        document.addEventListener('DOMContentLoaded', initializeChatWidgets);\n    } else {\n        initializeChatWidgets();\n    }\n } else {\n    // Admin app initialization\n    const adminRoot = document.getElementById('wp-ai-workflows-root');\n    if (adminRoot) {\n        const root = createRoot(adminRoot);\n        root.render(\n            <React.StrictMode>\n                <App />\n            </React.StrictMode>\n        );\n        setupAdminInstance();\n    }\n}\n\nreportWebVitals();"],"names":["deselectCurrent","require","clipboardToIE11Formatting","module","exports","text","options","debug","message","reselectPrevious","range","selection","mark","success","document","createRange","getSelection","createElement","textContent","ariaHidden","style","all","position","top","clip","whiteSpace","webkitUserSelect","MozUserSelect","msUserSelect","userSelect","addEventListener","e","stopPropagation","format","preventDefault","clipboardData","console","warn","window","clearData","setData","onCopy","body","appendChild","selectNodeContents","addRange","execCommand","Error","err","error","copyKey","test","navigator","userAgent","replace","prompt","removeRange","removeAllRanges","removeChild","t","n","r","i","s","u","a","o","c","f","h","d","l","$","y","M","name","weekdays","split","months","ordinal","m","String","length","Array","join","v","z","utcOffset","Math","abs","floor","date","year","month","clone","add","ceil","p","w","D","ms","Q","toLowerCase","g","S","_","O","args","arguments","b","locale","$L","utc","$u","x","$x","$offset","this","parse","prototype","$d","Date","NaN","match","substring","UTC","init","$y","getFullYear","$M","getMonth","$D","getDate","$W","getDay","$H","getHours","$m","getMinutes","$s","getSeconds","$ms","getMilliseconds","$utils","isValid","toString","isSame","startOf","endOf","isAfter","isBefore","$g","set","unix","valueOf","getTime","toDate","apply","slice","$locale","weekStart","$set","min","daysInMonth","get","Number","round","subtract","invalidDate","meridiem","monthsShort","weekdaysMin","weekdaysShort","getTimezoneOffset","diff","toJSON","toISOString","toUTCString","k","forEach","extend","$i","isDayjs","en","Ls","bind","weekYear","isoWeekYear","week","isoWeek","offsetName","LTS","LT","L","LL","LLL","LLLL","zone","offset","indexOf","concat","A","afternoon","milliseconds","SS","SSS","ss","mm","H","HH","hh","DD","Do","day","ww","MM","MMM","map","MMMM","Y","YY","YYYY","Z","ZZ","formats","toUpperCase","regex","parser","exec","call","hours","customParseFormat","parseTwoDigitYear","minutes","seconds","firstDayOfWeek","longDateFormat","localeData","future","past","dd","yy","fromToBase","relativeTime","thresholds","rounding","to","from","toNow","fromNow","yearStart","weeks","weekday","DataView","getNative","hashClear","hashDelete","hashGet","hashHas","hashSet","Hash","entries","index","clear","entry","has","listCacheClear","listCacheDelete","listCacheGet","listCacheHas","listCacheSet","ListCache","Map","mapCacheClear","mapCacheDelete","mapCacheGet","mapCacheHas","mapCacheSet","MapCache","Promise","Set","setCacheAdd","setCacheHas","SetCache","values","__data__","push","stackClear","stackDelete","stackGet","stackHas","stackSet","Stack","data","size","Symbol","Uint8Array","WeakMap","array","predicate","resIndex","result","value","baseTimes","isArguments","isArray","isBuffer","isIndex","isTypedArray","hasOwnProperty","Object","inherited","isArr","isArg","isBuff","isType","skipIndexes","key","eq","arrayPush","object","keysFunc","symbolsFunc","getRawTag","objectToString","symToStringTag","toStringTag","undefined","baseGetTag","isObjectLike","baseIsEqualDeep","baseIsEqual","other","bitmask","customizer","stack","equalArrays","equalByTag","equalObjects","getTag","argsTag","arrayTag","objectTag","equalFunc","objIsArr","othIsArr","objTag","othTag","objIsObj","othIsObj","isSameTag","objIsWrapped","othIsWrapped","objUnwrapped","othUnwrapped","isFunction","isMasked","isObject","toSource","reIsHostCtor","funcProto","Function","objectProto","funcToString","reIsNative","RegExp","isLength","typedArrayTags","isPrototype","nativeKeys","iteratee","func","cache","coreJsData","arraySome","cacheHas","isPartial","arrLength","othLength","arrStacked","othStacked","seen","arrValue","othValue","compared","othIndex","mapToArray","setToArray","symbolProto","symbolValueOf","tag","byteLength","byteOffset","buffer","convert","stacked","getAllKeys","objProps","objLength","objStacked","skipCtor","objValue","objCtor","constructor","othCtor","freeGlobal","global","baseGetAllKeys","getSymbols","keys","isKeyable","baseIsNative","getValue","nativeObjectToString","isOwn","unmasked","arrayFilter","stubArray","propertyIsEnumerable","nativeGetSymbols","getOwnPropertySymbols","symbol","mapTag","promiseTag","setTag","weakMapTag","dataViewTag","dataViewCtorString","mapCtorString","promiseCtorString","setCtorString","weakMapCtorString","ArrayBuffer","resolve","Ctor","ctorString","nativeCreate","reIsUint","type","maskSrcKey","uid","IE_PROTO","assocIndexOf","splice","pop","getMapData","overArg","freeExports","nodeType","freeModule","freeProcess","process","nodeUtil","types","binding","transform","arg","freeSelf","self","root","pairs","LARGE_ARRAY_SIZE","baseIsArguments","stubFalse","Buffer","baseIsTypedArray","baseUnary","nodeIsTypedArray","arrayLikeKeys","baseKeys","isArrayLike","factory","modules","insta