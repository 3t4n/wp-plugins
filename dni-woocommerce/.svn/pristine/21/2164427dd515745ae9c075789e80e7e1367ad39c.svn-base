#: dni-woocommerce.php:72 dni-woocommerce.php:119 dni-woocommerce.php:131
msgid "DNI"
msgstr "DNI"

#: dni-woocommerce.php:73
msgid "Enter the number of your ID"
msgstr "Introduce el número de tu DNI"

#: dni-woocommerce.php:99
msgid "DNI: "
msgstr "DNI: "

#: dni-woocommerce.php:144
msgid "Please enter a valid DNI"
msgstr "Por favor, introduzca un DNI válido"

#: dni-woocommerce.php:155
msgid ""
"This is a security measure. Please enter a valid DNI, with 8 digits and a "
"letter. (Go back to enter a valid DNI)"
msgstr ""
"Esto es una medida de seguridad. Por favor, introduce un DNI válido, con 8 "
"dígitos y una letra. (Vuelve hacia atrás para introducir un DNI válido)"

#: dni-woocommerce.php:172
msgid "This plugin requires WooCommerce active to run!"
msgstr "¡ Este plugin requiere WooCommerce Active para funcionar!"

#. Plugin Name of the plugin/theme
msgid "DNI WooCommerce"
msgstr "DNI WooCommerce"

#. Description of the plugin/theme
msgid "Add the DNI field in the WooCommerce checkout"
msgstr "Añade el campo del DNI en el checkout de WooCommerce"

#. Author of the plugin/theme
msgid "Camilo"
msgstr "Camilo"

#. Author URI of the plugin/theme
msgid "https://camilowp.com/"
msgstr "https://camilowp.com/"
