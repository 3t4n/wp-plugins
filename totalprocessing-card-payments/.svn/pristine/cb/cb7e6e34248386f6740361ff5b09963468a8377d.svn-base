<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thank You!</title>
</head>
<body style="font-family: Arial, sans-serif; margin: 0; padding: 0; background-color: #f9f9f9; text-align: center;">
    <div style="max-width: 600px; margin: 50px auto; background: #ffffff; padding: 20px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);">
        <div style="padding: 20px;">
            <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/8/8f/Checkmark.svg/120px-Checkmark.svg.png" 
                 alt="Success" 
		 style="margin-bottom: 20px; width: 100px; height: 100px;">
            <h1 style="color: #333; font-size: 24px; margin-bottom: 10px;">Thank You!</h1>
            <p style="color: #555; font-size: 16px; line-height: 1.6; margin: 10px 0 40px;">
                Registration has been successfully completed. The merchant can now set Apple Pay to live on their domain.
            </p>
            <a href="/" style="display: inline-block; padding: 10px 20px; background-color: #0073e6; color: #ffffff; text-decoration: none; border-radius: 5px; font-size: 16px; font-weight: bold;">
                Go to Homepage
            </a>
        </div>
    </div>
</body>
</html>

