x-builder-grid {\r\n\t\t\tflex-direction: column;\r\n\t\t\talign-items: flex-start;\r\n\t\t}\r\n\t\t.revx-spending-goal {\r\n\t\t\t.revx-builder-element__content .revx-justify-space-sm {\r\n\t\t\t\tflex-direction: column;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\t&-md,\r\n\t&-sm {\r\n\t\t.revx-frequently_bought_together-grid .revx-builder-grid {\r\n\t\t\tflex-direction: column;\r\n\t\t}\r\n\t\t.revx-frequently_bought_together-list .revx-price-container {\r\n\t\t\tflex-direction: column;\r\n\t\t\talign-items: flex-start !important;\r\n\t\t}\r\n\t}\r\n\t.revx-focus:hover {\r\n\t\toutline: #4caf50 dashed 1px;\r\n\t}\r\n\t.revx-campaign-content-grid {\r\n\t\tdisplay: flex;\r\n\t}\r\n\t.revx-countdown-timer,\r\n\t.revx-countdown-timer-container {\r\n\t\tdisplay: flex;\r\n\t}\r\n\t.revx-countdown-timer-container {\r\n\t\tline-height: 1.4;\r\n\t}\r\n}\r\n\r\n/*==========================\r\n    container main\r\n==========================*/\r\n.revx-builder-campaign {\r\n\tbox-sizing: border-box;\r\n\tposition: relative; // popup close icon\r\n\t&__content {\r\n\t\tborder-style: solid;\r\n\t}\r\n\t&__title {\r\n\t\tline-height: 1.325em;\r\n\t\t&:focus-visible {\r\n\t\t\toutline: none;\r\n\t\t\tborder: 1px solid map-get($primary-colors, "green-base");\r\n\t\t}\r\n\t}\r\n\t&__header-title,\r\n\t&__header-subtitle {\r\n\t\tline-height: 1.3;\r\n\t}\r\n\t&__body:hover {\r\n\t\t.revx-builderSlider-left,\r\n\t\t.revx-builderSlider-right {\r\n\t\t\tvisibility: visible !important;\r\n\t\t\topacity: 1 !important;\r\n\t\t}\r\n\t}\r\n\t&.revx-list-view {\r\n\t\t.revx-builder-element__content {\r\n\t\t\tposition: relative;\r\n\t\t\t& > div.revx-builder-toolbar {\r\n\t\t\t\tdisplay: contents;\r\n\t\t\t}\r\n\t\t}\r\n\t\t.revx-builder__atc-btn .revx-builder-controller {\r\n\t\t\twidth: 100%;\r\n\t\t}\r\n\t}\r\n\t&.revx-builder-shadow {\r\n\t\tborder: 1px solid map-get($neutral-colors, "neutral-200");\r\n\t\tbox-shadow: 0px 40px 96px -8px rgba(88, 92, 95, 0.2);\r\n\t\t&.revx-list-view {\r\n\t\t\t.revx-builder-element {\r\n\t\t\t\tborder: none;\r\n\t\t\t}\r\n\t\t\t.revx-builder__atc-btn {\r\n\t\t\t\tposition: relative;\r\n\t\t\t\t.revx-atc {\r\n\t\t\t\t\t@include flexStyle(center, center);\r\n\t\t\t\t\tgap: 12px;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\t&:not(.revx-builder-shadow) {\r\n\t\t&.revx-grid-view {\r\n\t\t\t.revx-builder-element {\r\n\t\t\t\twidth: fit-content;\r\n\t\t\t}\r\n\t\t\t.revx-builder-campaign__content {\r\n\t\t\t\tposition: relative;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n}\r\n\r\n/*==========================\r\n    container wrap\r\n==========================*/\r\n.revx-grid-wrapper {\r\n\twidth: max-content; // overflow border issue\r\n}\r\n.revx-grid-view {\r\n\t.revx-builder-grid {\r\n\t\tdisplay: flex;\r\n\t}\r\n\t.revx-builder-element__content__active-price {\r\n\t\tmargin: 0px !important;\r\n\t}\r\n}\r\n\r\n/*==========================\r\n    Price\r\n==========================*/\r\n.revx-price-container {\r\n\tmargin-left: auto;\r\n\t&__content {\r\n\t\tflex-wrap: wrap;\r\n\t}\r\n}\r\n.revx-total-price-text {\r\n\tmargin: 0px !important;\r\n}\r\n.revx-builder__total-price {\r\n\t& > div {\r\n\t\tdisplay: flex;\r\n\t\talign-items: center;\r\n\t}\r\n\t.revx-content-editable {\r\n\t\tmargin: 0px !important;\r\n\t}\r\n}\r\n\r\n/*==========================\r\n    Tag and Label\r\n==========================*/\r\nspan.revx-builder-savings-tag {\r\n\tdisplay: inline-block;\r\n\tborder-style: solid;\r\n\twhite-space: nowrap;\r\n\tline-height: normal;\r\n}\r\n.revx-builder__popular-tag {\r\n\twidth: max-content;\r\n\twhite-space: nowrap;\r\n}\r\n.revx-builder-sticky-tag {\r\n\t@include positionStyle(absolute, 0px, false, 0px);\r\n\t&__shape {\r\n\t\theight: 40px;\r\n\t\twidth: 24px;\r\n\t\tbackground: map-get($neutral-colors, "neutral-900");\r\n\t\tclippath: polygon(0 0, 100% 0%, 100% 100%, 51% 72%, 0 100%);\r\n\t}\r\n\t.revx-builder-toolbar {\r\n\t\t& > div {\r\n\t\t\tmargin-left: auto;\r\n\t\t\ttop: 43px !important;\r\n\t\t\tright: 48px !important;\r\n\t\t\twidth: auto !important;\r\n\t\t\tleft: auto !important;\r\n\t\t}\r\n\t}\r\n}\r\n\r\n/*==========================\r\n    Quantity Button Style\r\n==========================*/\r\n.revx-builder__quantity {\r\n\tborder: 1px solid map-get($neutral-colors, "neutral-300");\r\n\talign-items: stretch;\r\n\toverflow: hidden;\r\n\tinput {\r\n\t\t@include revx-appearance-textField;\r\n\t\tdisplay: block;\r\n\t\theight: auto;\r\n\t\twidth: 100%;\r\n\t\tmin-height: 100%;\r\n\t\tpadding: 0px !important;\r\n\t\tborder: 0px !important;\r\n\t\ttext-align: center;\r\n\t\tborder-radius: 0px;\r\n\t\tborder: none;\r\n\t\tbackground-color: inherit;\r\n\t\t&:focus {\r\n\t\t\toutline: none;\r\n\t\t\tbox-shadow: none;\r\n\t\t}\r\n\t}\r\n\t&.revx-btn-size {\r\n\t\t&-L {\r\n\t\t\tmax-width: 150px;\r\n\t\t\t.revx-quantity-minus,\r\n\t\t\t.revx-quantity-plus {\r\n\t\t\t\theight: 48px;\r\n\t\t\t\tmax-width: 48px;\r\n\t\t\t}\r\n\t\t}\r\n\t\t&-M {\r\n\t\t\tmax-width: 119px;\r\n\t\t\t.revx-quantity-minus,\r\n\t\t\t.revx-quantity-plus {\r\n\t\t\t\tflex-shrink: 0;\r\n\t\t\t\tmin-height: 40px;\r\n\t\t\t\tmax-width: 40px;\r\n\t\t\t}\r\n\t\t}\r\n\t\t&-S {\r\n\t\t\tmax-width: 90px;\r\n\t\t\t.revx-quantity-minus,\r\n\t\t\t.revx-quantity-plus {\r\n\t\t\t\tmin-height: 28px;\r\n\t\t\t\tmax-width: 28px;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n}\r\n\r\n.revx-quantity {\r\n\t&-minus,\r\n\t&-plus {\r\n\t\twidth: 100%;\r\n\t\tmax-width: 40px;\r\n\t\tcursor: pointer;\r\n\t\tborder-color: inherit;\r\n\t\tborder-style: solid;\r\n\t\tborder-width: inherit;\r\n\t\tborder-top: 0px;\r\n\t\tborder-bottom: 0px;\r\n\t}\r\n\t&-minus {\r\n\t\tborder-left: 0px;\r\n\t}\r\n\t&-plus {\r\n\t\tborder-right: 0px;\r\n\t}\r\n\t&-container {\r\n\t\tflex-shrink: 0;\r\n\t}\r\n}\r\n.revx-builderSlider {\r\n\t&-icon {\r\n\t\tborder-style: solid;\r\n\t\tsvg {\r\n\t\t\tpadding: 4px;\r\n\t\t}\r\n\t}\r\n\t&-left .revx-builderSlider-icon {\r\n\t\tsvg {\r\n\t\t\ttransform: rotate(180deg);\r\n\t\t}\r\n\t}\r\n\t&-right {\r\n\t\tright: 0px;\r\n\t\tleft: auto;\r\n\t\t.revx-builderSlider-icon svg {\r\n\t\t\ttransform: rotate(0deg);\r\n\t\t}\r\n\t}\r\n\t&-left,\r\n\t&-right {\r\n\t\tposition: absolute;\r\n\t\tz-index: 999;\r\n\t\tvisibility: hidden;\r\n\t\topacity: 0;\r\n\t\ttransition: 0.5s;\r\n\t}\r\n}\r\n.revx-product {\r\n\t&-item {\r\n\t\t@include flexStyle(false, center);\r\n\t\t&__details {\r\n\t\t\t@include flexStyle(space-between, center);\r\n\t\t\tflex-grow: 1;\r\n\t\t}\r\n\t}\r\n\t&-list {\r\n\t\tdisplay: flex;\r\n\t\tflex-direction: column;\r\n\t\tpadding: 16px 8px;\r\n\t}\r\n\t&-bundle {\r\n\t\tmargin-left: auto;\r\n\t\tmargin-right: auto;\r\n\t\tposition: relative;\r\n\t\tz-index: 999;\r\n\t\tsvg,\r\n\t\tpath {\r\n\t\t\tstroke: currentColor;\r\n\t\t\tfill: currentColor;\r\n\t\t\t@include flexStyle(center, center);\r\n\t\t}\r\n\t}\r\n\t&-image {\r\n\t\tposition: relative;\r\n\t\timg {\r\n\t\t\theight: 100%;\r\n\t\t\twidth: 100%;\r\n\t\t}\r\n\t\t&.revx-builder-controller {\r\n\t\t\tflex-shrink: 0;\r\n\t\t\tmax-width: 150px; //\r\n\t\t}\r\n\t}\r\n}\r\n/*==========================\r\n    add to cart button\r\n==========================*/\r\n.revx-builder__atc-btn,\r\n.revx-builder__atc-btn button {\r\n\twidth: -webkit-fill-available; /* Safari and WebKit-based browsers */\r\n\twidth: -moz-available; /* Firefox */\r\n\twidth: fill-available; /* Standard, but limited browser support */\r\n}\r\nbutton.revx-atc,\r\n.revx-builder__atc-btn button {\r\n\tdisplay: block;\r\n\twidth: 100%;\r\n\toutline: 0px;\r\n\tcursor: pointer;\r\n\tline-height: 1.5em !important;\r\n}\r\nbutton.revx-btn-size {\r\n\t&-L {\r\n\t\tpadding: 12px 16px;\r\n\t}\r\n\t&-M {\r\n\t\tpadding: 10px 16px;\r\n\t}\r\n\t&-S {\r\n\t\tpadding: 6px 12px;\r\n\t}\r\n}\r\n\r\n/*======== no thanks button ======== */\r\nbutton.revx-no-thanks {\r\n\tcolor: map-get($neutral-colors, "neutral-900");\r\n\tbackground-color: transparent !important;\r\n\tborder: 1px solid map-get($neutral-colors, "neutral-300");\r\n\twidth: 100%;\r\n}\r\n\r\n.revx-btn-Outline {\r\n\tbackground-color: transparent !important;\r\n}\r\n.revx-builder__no-thanks-btn {\r\n\tdisplay: flex;\r\n}\r\n\r\n/*==========================\r\n    Common Campaign\r\n==========================*/\r\n.revx-spending-goal {\r\n\t&__slide {\r\n\t\tposition: relative;\r\n\t\t.revx-builderSlider-left,\r\n\t\t.revx-builderSlider-right {\r\n\t\t\tposition: static !important;\r\n\t\t\tcursor: pointer;\r\n\t\t}\r\n\t}\r\n\t.revx-campaign-close {\r\n\t\tposition: absolute;\r\n\t}\r\n\t.revx-builder__atc-btn {\r\n\t\twidth: fit-content;\r\n\t\twhite-space: nowrap;\r\n\t}\r\n}\r\n\r\n.revx-mix_match-campaign,\r\n.revx-normal_discount-campaign,\r\n.revx-volume_discount-campaign,\r\n.revx-frequently_bought_together-campaign {\r\n\t.active.revx-builder__popular-tag {\r\n\t\toutline: 2px solid map-get($primary-colors, "green-base");\r\n\t}\r\n}\r\n.revx-builder-sticky-offer__content {\r\n\twhite-space: nowrap;\r\n}\r\n\r\n.revx-list-view .revx-builder-sticky-offer__content {\r\n\tposition: relative !important;\r\n}\r\n',".revx-builder {\r\n    &-device {\r\n        padding: 6px 12px;\r\n        &:first-child {\r\n            border-top-left-radius: 6px;\r\n            border-bottom-left-radius: 6px;\r\n            border-right: 1.5px solid transparent;\r\n            &.active {\r\n                border-right: 1.5px solid map-get($primary-colors, 'green-base'); // Specific border for active state\r\n            }\r\n        }\r\n    }\r\n    &-screen {\r\n        height: 100% !important;\r\n        z-index: 999;\r\n        .revx-builder {\r\n            width: calc(100% + 23vw);\r\n            height: 100% !important;\r\n            &-body  {\r\n                overflow: visible;\r\n            }\r\n        }\r\n        .revx-builder__container {\r\n            height: fit-content;\r\n        }\r\n    }\r\n    &-fullScreen {\r\n        height: 100% !important;\r\n        max-width: 100%;\r\n        margin: 0px;\r\n        @include positionStyle(fixed !important, 0px, 0px);\r\n        z-index: 99999;\r\n        .revx-builder {\r\n            height: 100%;\r\n            &-body  {\r\n                overflow: visible;\r\n                animation: fullScreenAnimation 1s;\r\n            }\r\n            .revx-builder__container  {\r\n                overflow-x: auto;\r\n                border-radius: 0px;\r\n                padding-bottom: 20px;\r\n                @extend .revx-scrollbar-lg;\r\n            }\r\n        }\r\n    }\r\n    &-screen, &-fullScreen {\r\n        .revx-builder {\r\n            position: absolute !important;\r\n            z-index: 9999;\r\n        }\r\n        .revx-expand-control .revx-builder-device {\r\n            border-radius: 6px;\r\n        }\r\n    }\r\n    &-header__controller {\r\n        & > div {\r\n            cursor: pointer;\r\n            box-sizing: border-box;\r\n            border: 1.5px solid map-get($neutral-colors, 'neutral-200' );\r\n            padding: 8px 12px;\r\n            position: relative;\r\n            svg, path {\r\n                stroke: map-get($neutral-colors, 'neutral-500');\r\n            }\r\n            &.active {\r\n                z-index: 999;\r\n                border-color: map-get($primary-colors, 'green-base');\r\n                svg, path {\r\n                    stroke: map-get($primary-colors, 'green-base');\r\n                }\r\n            }\r\n            &.active.screen-rotate {\r\n                svg {\r\n                    transition: 1s;\r\n                    transform: rotate(180deg);\r\n                }\r\n            }\r\n        }\r\n    }\r\n}\r\n\r\n.revx-expand-control {\r\n    .revx-builder-device {\r\n        &:nth-child(2) {\r\n            border-top-right-radius: 6px;\r\n            border-bottom-right-radius: 6px;\r\n            &.active {\r\n                border-left: 1.5px solid map-get($primary-colors, 'green-base'); // Specific border for active state\r\n            }\r\n        }\r\n    }\r\n}\r\n\r\n@keyframes fullScreenAnimation {\r\n    from {\r\n        opacity: 0;\r\n    }\r\n    to {\r\n        opacity: 1;\r\n    }\r\n}\r\n\r\n/*======== Responsive Preview ======== */\r\n.revx-device-container {\r\n    .revx-builder-device {\r\n        &:nth-child(2) {\r\n            left: -1px;\r\n        }\r\n        &:nth-child(3) {\r\n            left: -2px;\r\n            border-top-right-radius: 6px;\r\n            border-bottom-right-radius: 6px;\r\n        }\r\n    }\r\n}\r\n",'/*============ Toolbar Main Container   ================*/\r\n.revx-builder-toolbar {\r\n\tz-index: 999999 !important;\r\n\t&__wrapper {\r\n\t\theight: 32px;\r\n\t\tborder-radius: 2px;\r\n\t\tborder: 1px solid map-get($neutral-colors, "neutral-500");\r\n\t\tbox-sizing: border-box;\r\n\t\tbackground-color: map-get($neutral-colors, "neutral-900");\r\n\t}\r\n\t.revx-toolbar-selected {\r\n\t\tbackground-color: map-get($neutral-colors, "neutral-500");\r\n\t}\r\n}\r\n\r\n.revx-toolbar {\r\n\t&-element {\r\n\t\t/*============ Toolbar Single Element ( Bar )  ================*/\r\n\t\tgap: 4px;\r\n\t\theight: 100%;\r\n\t\tbox-sizing: border-box;\r\n\t\tbackground-color: map-get($neutral-colors, "neutral-900");\r\n\t\t&:not(:last-child) {\r\n\t\t\tborder-right: 1px solid map-get($neutral-colors, "neutral-500");\r\n\t\t}\r\n\t\t&__icon {\r\n\t\t\tcursor: pointer;\r\n\t\t\t@include flexStyle(center, center);\r\n\t\t\tbox-sizing: border-box;\r\n\t\t\tborder-radius: 2px;\r\n\t\t\ttransition: 0.3s;\r\n\t\t\tpadding: 3px 6px 3px;\r\n\t\t\tmargin: 3px;\r\n\t\t\t&:hover,\r\n\t\t\t&.active {\r\n\t\t\t\tbackground: map-get($neutral-colors, "neutral-500");\r\n\t\t\t}\r\n\t\t\tsvg {\r\n\t\t\t\theight: 19px;\r\n\t\t\t\twidth: 19px;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\t&-popup {\r\n\t\t/*============ Toolbar Popup  ================*/\r\n\t\tborder-radius: 4px;\r\n\t\tbackground-color: map-get($neutral-colors, "neutral-900");\r\n\t\tpadding: 8px;\r\n\t\t/*============ Toolbar Alignment Popup  ================*/\r\n\t\t&.revx-toolbar-alignment {\r\n\t\t\twidth: 88px;\r\n\t\t\theight: 36px;\r\n\t\t\tgap: 3px;\r\n\t\t\tjustify-content: center;\r\n\t\t\tpadding: 0px;\r\n\t\t\t.revx-toolbar-element__icon {\r\n\t\t\t\tbackground-color: transparent !important;\r\n\t\t\t\tpadding: 0px;\r\n\t\t\t\tmargin: 0px;\r\n\t\t\t\tsvg {\r\n\t\t\t\t\tborder-radius: 2px;\r\n\t\t\t\t\tpadding: 3px;\r\n\t\t\t\t}\r\n\t\t\t\t&:hover svg,\r\n\t\t\t\t&.revx-toolbar-selected svg {\r\n\t\t\t\t\tbackground-color: map-get($neutral-colors, "neutral-500");\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\t&-color,\r\n\t&-tabs {\r\n\t\t/*============ Toolbar Color Popup Content  ================*/\r\n\t\tpadding: 0px;\r\n\t\t.revx-color-container {\r\n\t\t\t&__tabs {\r\n\t\t\t\tcolor: map-get($neutral-colors, "neutral-0");\r\n\t\t\t\tfont-size: 12px;\r\n\t\t\t\tdisplay: flex;\r\n\t\t\t\tgap: 12px;\r\n\t\t\t\tborder-bottom: 1px solid map-get($neutral-colors, "neutral-500");\r\n\t\t\t\tpadding-top: 6px;\r\n\t\t\t\tpadding-right: 12px;\r\n\t\t\t\tbox-sizing: border-box;\r\n\t\t\t\toverflow-x: scroll;\r\n\t\t\t\t&::-webkit-scrollbar {\r\n\t\t\t\t\tdisplay: none;\r\n\t\t\t\t}\r\n\t\t\t\t&__item {\r\n\t\t\t\t\tcursor: pointer;\r\n\t\t\t\t\tfont-weight: 400;\r\n\t\t\t\t\tline-height: 16px;\r\n\t\t\t\t\tcursor: pointer;\r\n\t\t\t\t\t@include typographyStyle(12px, 1.33, 0.48px);\r\n\t\t\t\t\tborder-bottom: 2px solid transparent;\r\n\t\t\t\t\tpadding-bottom: 4px;\r\n\t\t\t\t\tposition: relative;\r\n\t\t\t\t\tbottom: -0.5px;\r\n\t\t\t\t\tz-index: 99999;\r\n\t\t\t\t\twhite-space: nowrap;\r\n\t\t\t\t\t&:first-child {\r\n\t\t\t\t\t\tmargin-left: 10px;\r\n\t\t\t\t\t}\r\n\t\t\t\t\t&.revx-color-tab-active {\r\n\t\t\t\t\t\tcolor: map-get($primary-colors, "green-base");\r\n\t\t\t\t\t\tborder-color: map-get($primary-colors, "green-base");\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\t&-number {\r\n\t\t/*============ Toolbar Number Popup Content  ================*/\r\n\t\tgap: 12px;\r\n\t\t@include typographyStyle(12px, 1.33, 0.48px);\r\n\t\t&:not(:first-child) {\r\n\t\t\tmargin-top: 8px;\r\n\t\t}\r\n\t\tinput[type="number"] {\r\n\t\t\tcolor: map-get($neutral-colors, "neutral-0");\r\n\t\t\tmin-height: unset;\r\n\t\t\tborder-radius: 2px;\r\n\t\t\tbackground-color: map-get($neutral-colors, "neutral-900");\r\n\t\t\tpadding: 4px 6px;\r\n\t\t\tborder: 1px solid map-get($neutral-colors, "neutral-500");\r\n\t\t\t@include revx-appearance-textField;\r\n\t\t\t@include typographyStyle(12px, 1.33, 0.48px);\r\n\t\t\t&:focus {\r\n\t\t\t\toutline: 0px !important;\r\n\t\t\t\tborder-color: map-get($primary-colors, "green-base");\r\n\t\t\t\tbox-shadow: none !important;\r\n\t\t\t}\r\n\t\t}\r\n\t\t&__label {\r\n\t\t\tcolor: map-get($neutral-colors, "neutral-0");\r\n\t\t\twhite-space: nowrap;\r\n\t\t}\r\n\t\t&__content {\r\n\t\t\tposition: relative;\r\n\t\t\t&__input {\r\n\t\t\t\twidth: 65px;\r\n\t\t\t\theight: 24px;\r\n\t\t\t\tborder-color: map-get($neutral-colors, "neutral-500");\r\n\t\t\t\tbackground-color: map-get($neutral-colors, "neutral-900");\r\n\t\t\t\tpadding-right: 30px;\r\n\t\t\t\tborder: 0px;\r\n\t\t\t}\r\n\t\t\t&__arrows {\r\n\t\t\t\tdisplay: flex;\r\n\t\t\t\tflex-direction: column;\r\n\t\t\t\tposition: absolute;\r\n\t\t\t\tright: 5px;\r\n\t\t\t}\r\n\t\t}\r\n\t\t.revx-arrow-up,\r\n\t\t.revx-arrow-down {\r\n\t\t\tborder: none;\r\n\t\t\tcursor: pointer;\r\n\t\t\tbackground-color: transparent;\r\n\t\t}\r\n\t}\r\n\t&-dimensions {\r\n\t\t/*============ Toolbar Dimensions Popup Content  ================*/\r\n\t\t// width: 180px;\r\n\t\tflex-direction: column;\r\n\t\talign-items: flex-start;\r\n\t\t.revx-dimension-control:first-child {\r\n\t\t\tmargin-bottom: 8px;\r\n\t\t}\r\n\t\t.revx-toolbar-number {\r\n\t\t\twidth: 100%;\r\n\t\t}\r\n\t\t.revx-dimension-control {\r\n\t\t\t&__label {\r\n\t\t\t\tcolor: map-get($neutral-colors, "neutral-0");\r\n\t\t\t\t@include typographyStyle(12px, 1.33, 0.48px);\r\n\t\t\t}\r\n\t\t\t&__content {\r\n\t\t\t\tdisplay: flex;\r\n\t\t\t\tjustify-content: space-between;\r\n\t\t\t\theight: 24px;\r\n\t\t\t\twidth: 100%;\r\n\t\t\t\tmax-width: 108px;\r\n\t\t\t\tbox-sizing: border-box;\r\n\t\t\t\tborder: 1px solid map-get($neutral-colors, "neutral-500");\r\n\t\t\t\tborder-radius: 4px;\r\n\t\t\t\tpadding: 0px 1px;\r\n\t\t\t\t&__btn {\r\n\t\t\t\t\tcolor: map-get($neutral-colors, "neutral-0");\r\n\t\t\t\t\tcursor: pointer;\r\n\t\t\t\t\twidth: 100%;\r\n\t\t\t\t\tborder-radius: 2px;\r\n\t\t\t\t\tbox-sizing: border-box;\r\n\t\t\t\t\tpadding: 0px 8px;\r\n\t\t\t\t\tmargin: 1px 0px 0.5px;\r\n\t\t\t\t\t@include typographyStyle(12px, 1.33, 0.48px);\r\n\t\t\t\t\t&:hover,\r\n\t\t\t\t\t&.revx-selected {\r\n\t\t\t\t\t\tbackground-color: map-get(\r\n\t\t\t\t\t\t\t$neutral-colors,\r\n\t\t\t\t\t\t\t"neutral-500"\r\n\t\t\t\t\t\t);\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\t/*============ Toolbar Direction Popup Content  ================*/\r\n\t&-direction {\r\n\t\tpadding: 0px !important;\r\n\t}\r\n\t/*============ Toolbar Tab  ================*/\r\n\t&-tabs {\r\n\t\twidth: 180px;\r\n\t\tpadding: 0px !important;\r\n\t\t.revx-toolbar-number {\r\n\t\t\tpadding: 0px 8px;\r\n\t\t\tbox-sizing: border-box;\r\n\t\t}\r\n\t\t.revx-size-control {\r\n\t\t\tmargin-top: 8px;\r\n\t\t\tpadding: 0px 8px;\r\n\t\t\tbox-sizing: border-box;\r\n\t\t\tmargin-bottom: 0px;\r\n\t\t\t// width: 180px;\r\n\t\t}\r\n\t\t& > div:last-child {\r\n\t\t\tmargin-bottom: 8px;\r\n\t\t}\r\n\t}\r\n}\r\n\r\n/*============ Toolbar Typography Popup Content  ================*/\r\n.revx-toolbar-typography {\r\n\talign-items: center;\r\n\tbox-sizing: border-box;\r\n\t/*============  Override Toolbar Number Input  ================*/\r\n\t.revx-toolbar-number {\r\n\t\tgap: 0px;\r\n\t\tmargin-top: 0px !important;\r\n\t\tinput {\r\n\t\t\tborder-color: transparent !important;\r\n\t\t\tbackground-color: map-get(\r\n\t\t\t\t$neutral-colors,\r\n\t\t\t\t"neutral-700"\r\n\t\t\t) !important;\r\n\t\t}\r\n\t\t&::after {\r\n\t\t\tcontent: "";\r\n\t\t\tdisplay: block;\r\n\t\t\theight: 21px;\r\n\t\t\twidth: 1px;\r\n\t\t\tbackground-color: map-get($neutral-colors, "neutral-500");\r\n\t\t\tpadding: 0px;\r\n\t\t\tmargin: 0px 4px 0px 8px;\r\n\t\t}\r\n\t}\r\n\r\n\t/*============ Override Toolbar Select Dropdown Input  ================*/\r\n\t.revx-select-field.revx-toolbar-dropdown {\r\n\t\twidth: fit-content;\r\n\t\tmargin-right: 4px;\r\n\t\t.revx-select-field {\r\n\t\t\t&__header {\r\n\t\t\t\theight: 24px;\r\n\t\t\t\tgap: 7px;\r\n\t\t\t\tborder: 0px;\r\n\t\t\t\tborder-radius: 2px !important;\r\n\t\t\t\tbackground-color: map-get($neutral-colors, "neutral-700");\r\n\t\t\t\tpadding: 4px 4px 4px 6px;\r\n\t\t\t\tsvg {\r\n\t\t\t\t\theight: 16px;\r\n\t\t\t\t\twidth: 16px;\r\n\t\t\t\t\tpath {\r\n\t\t\t\t\t\tstroke: map-get($neutral-colors, "neutral-0");\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\t&__options {\r\n\t\t\t\tborder-color: transparent;\r\n\t\t\t\tbackground-color: map-get($neutral-colors, "neutral-500");\r\n\t\t\t\t@extend .revx-scrollbar-md;\r\n\t\t\t\t&::-webkit-scrollbar-track {\r\n\t\t\t\t\tbackground-color: map-get(\r\n\t\t\t\t\t\t$neutral-colors,\r\n\t\t\t\t\t\t"neutral-400"\r\n\t\t\t\t\t) !important;\r\n\t\t\t\t}\r\n\t\t\t\t&::-webkit-scrollbar-thumb {\r\n\t\t\t\t\tbackground-color: map-get(\r\n\t\t\t\t\t\t$neutral-colors,\r\n\t\t\t\t\t\t"neutral-700"\r\n\t\t\t\t\t) !important;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\t&__option {\r\n\t\t\t\tcolor: map-get($neutral-colors, "neutral-0");\r\n\t\t\t\twhite-space: nowrap;\r\n\t\t\t\tpadding: 8px 12px 8px 12px;\r\n\t\t\t\t@include typographyStyle(12px, 1.33, 0.48px);\r\n\t\t\t\t&:hover {\r\n\t\t\t\t\tbackground-color: black;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\t&__arrow-icon {\r\n\t\t\t\theight: 16px;\r\n\t\t\t}\r\n\t\t\t&__selected-option {\r\n\t\t\t\tcolor: map-get($neutral-colors, "neutral-0") !important;\r\n\t\t\t\t@include typographyStyle(12px, 1.33, 0.48px);\r\n\t\t\t}\r\n\t\t\t&__option--focused {\r\n\t\t\t\tbackground-color: map-get($neutral-colors, "neutral-700");\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\t/*============ Toolbar Typography Extra Option  ================*/\r\n\t.revx-typography-option {\r\n\t\tinput[type="number"] {\r\n\t\t\tcolor: map-get($neutral-colors, "neutral-0");\r\n\t\t\tbackground-color: map-get($neutral-colors, "neutral-700");\r\n\t\t\tpadding: 4px 6px;\r\n\t\t\t@include revx-appearance-textField;\r\n\t\t}\r\n\t\t&__icon {\r\n\t\t\tcursor: pointer;\r\n\t\t\tborder-radius: 2px;\r\n\t\t\tpadding: 2px;\r\n\t\t\t&:hover,\r\n\t\t\t&.revx-toolbar-selected {\r\n\t\t\t\tbackground-color: map-get($neutral-colors, "neutral-500");\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n}\r\n\r\n.revx-size-control {\r\n\tmargin-bottom: 8px;\r\n\t&__label {\r\n\t\tcolor: map-get($neutral-colors, "neutral-0");\r\n\t\t@include typographyStyle(12px, 1.33, 0.48px);\r\n\t}\r\n\t&__content {\r\n\t\tdisplay: flex;\r\n\t\tjustify-content: space-between;\r\n\t\theight: 24px;\r\n\t\twidth: 100%;\r\n\t\tmax-width: 108px;\r\n\t\tbox-sizing: border-box;\r\n\t\tborder: 1px solid map-get($neutral-colors, "neutral-500");\r\n\t\tborder-radius: 4px;\r\n\t\tpadding: 0px 1px;\r\n\t\t&__btn {\r\n\t\t\tcolor: map-get($neutral-colors, "neutral-0");\r\n\t\t\tcursor: pointer;\r\n\t\t\twidth: 100%;\r\n\t\t\tborder-radius: 2px;\r\n\t\t\tbox-sizing: border-box;\r\n\t\t\tpadding: 0px 8px;\r\n\t\t\tmargin: 1px 0px 0.5px;\r\n\t\t\t@include typographyStyle(12px, 1.33, 0.48px);\r\n\t\t\t&:hover,\r\n\t\t\t&.revx-selected {\r\n\t\t\t\tbackground-color: map-get($neutral-colors, "neutral-500");\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n}\r\n',".revx-buy_x_get_y {\r\n    &-campaign {\r\n        .revx-grid-wrapper {\r\n            position: relative;\r\n        }\r\n        .revx-bundle-add-icon {\r\n            align-self: center;\r\n        }\r\n        .revx-regular-product .revx-builder-element {\r\n            flex: 1;\r\n        }\r\n        .revx-builder-campaign__content {\r\n            position: relative;\r\n        }\r\n        .revx-regular-product,\r\n        .revx-triggerProduct {\r\n            border-style: solid;\r\n            position: relative;\r\n            height: 100%;\r\n            align-items: flex-start;\r\n            box-sizing: border-box;\r\n        }\r\n    }\r\n    &-grid {\r\n        position: relative;\r\n        .revx-builderSlider-left {\r\n            left: 0;\r\n        }\r\n        .revx-builderSlider-right {\r\n            right: 0;\r\n        }\r\n        .revx-builderSlider-left, \r\n        .revx-builderSlider-right {\r\n            align-self: center;\r\n            transform: translateY(34px);\r\n        }\r\n        .revx-builder-grid {\r\n            display: grid;\r\n            grid-template-columns: 1fr auto 2fr;\r\n        }\r\n        .revx-builder-element {\r\n            flex: 1;\r\n            &__content {\r\n                flex: 1;\r\n            }\r\n            &__content_separator {\r\n                height: 100%;\r\n            }\r\n        }\r\n        .revx-sticky-offer {\r\n            right: auto;\r\n            left: 0px;\r\n        }\r\n        .revx-buyx-gety-grid-col-2 {\r\n            .revx-builder-grid {\r\n                grid-template-columns: 1fr auto 1fr !important;\r\n            }\r\n        }\r\n        .revx-price-container__content {\r\n            flex-wrap: wrap;\r\n        }\r\n    }\r\n    &-list {\r\n        .revx-builder-element__content {\r\n            display: flex;\r\n        }\r\n    }\r\n}\r\n\r\n.revx-sticky-offer {\r\n    @include positionStyle(absolute, 0px,  false, 0px);\r\n    &-offer {\r\n        &__content {\r\n            white-space: nowrap;\r\n            margin: 0px !important;\r\n            text-align: center;\r\n            line-height: 1.35;\r\n        }\r\n        & > .revx-builder-controller {\r\n            border: none;\r\n        }\r\n        & > .revx-builder-toolbar {\r\n            position:  static !important;\r\n            & > div {\r\n                width: auto !important;\r\n                margin-left: auto;\r\n                top: 43px !important;\r\n                right: 48px !important;\r\n                left: auto !important;\r\n            }\r\n        }\r\n    }\r\n}\r\n\r\n.revx-buyxgety-overlay {\r\n    overflow: hidden;\r\n}\r\n\r\n.revx-triggerProduct {\r\n    z-index: 0;\r\n}",".revx-mixMatch .revx-group-input {\r\n\tmargin-top: 24px;\r\n}\r\n.revx-mix_match {\r\n    &-campaign {\r\n        &__selected-product {\r\n            border-style: solid;\r\n            .revx-builder-element__content {\r\n                display: flex;\r\n            }\r\n        }\r\n        .revx-quantity-minus,\r\n        .revx-quantity-plus {\r\n            height: 32px !important;\r\n        }\r\n        .revx-builderSlider-left,\r\n        .revx-builderSlider-right {\r\n            top: 50%;\r\n        }\r\n        .revx-mixmatch-regular-quantity,\r\n        .revx-mixmatch-selected-quantity {\r\n            position: relative;\r\n        }\r\n        .revx-mixmatch-regular-offer,\r\n        .revx-mixmatch-regular-quantity  {\r\n            line-height: 1.3;\r\n        }\r\n        .revx-builder-checkbox  {\r\n            margin-left: auto;\r\n        }\r\n    }\r\n    &-grid {\r\n        container-type: inline-size;\r\n        .revx-builder-position {\r\n            width: fit-content;\r\n        }\r\n        .revx-builder-grid {\r\n            display: flex;\r\n            gap: 16px;\r\n            margin-top: 18px;\r\n        }\r\n        .revx-mix_match-campaign {\r\n            &__trigger-product {\r\n                display: flex;\r\n                max-width: 344px;\r\n                border-style: solid;\r\n                box-sizing: border-box;\r\n                &::-webkit-scrollbar {\r\n                    display: none;\r\n                }\r\n                .revx-builder-element__content {\r\n                    flex-shrink: 0;\r\n                    flex: 1;\r\n                }\r\n            }\r\n        }\r\n        .revx-mix_match-campaign__trigger-product  > div {\r\n            flex: 1;\r\n        }\r\n    }\r\n    &-list {\r\n        .revx-builder-list {