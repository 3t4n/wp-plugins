column;\r\n        }\r\n    }\r\n    .revx-mix_match-campaign {\r\n        .revx-builder-selected-product {\r\n            flex-direction: row !important;\r\n        }\r\n    }\r\n}\r\n",".revx-volume-discount {\r\n    position: relative;\r\n    &__tag {\r\n        border-style: solid;\r\n        box-sizing: border-box;\r\n    }\r\n    .revx-builder-list {\r\n        display: flex;\r\n    }\r\n    .revx-price-container__content {\r\n        justify-content: flex-end !important;\r\n    }\r\n}\r\n\r\n.revx-productAttr-wrapper {\r\n    border-style: solid;\r\n    &__field {\r\n        max-width: 100% !important;\r\n        line-height: normal !important;\r\n        margin: 0PX !important;\r\n        padding: 10px 16px !important;\r\n    }\r\n}\r\n",".revx-normal_discount {\r\n    &-list {\r\n        .revx-addToCartButton-btn {\r\n            width: fit-content;\r\n        }\r\n        .revx-builder-element__content {\r\n            display: flex;\r\n        }\r\n        .revx-price-container {\r\n            @include flexStyle(false, center);\r\n        }\r\n        .revx-builder-list > .revx-builder__atc-btn button {\r\n            width: 100%;\r\n        }\r\n        .revx-product-image.revx-builder-controller {\r\n            flex-shrink: 1;\r\n        }\r\n        .revx-builder-list >  .revx-builder-controller  {\r\n            &:last-child {\r\n                .revx-builder-element__content {\r\n                    margin-bottom: 0px !important;\r\n                }\r\n            }\r\n        }\r\n    }\r\n    &-grid {\r\n        width: fit-content;\r\n        .revx-product-container {\r\n            @extend .revx-align-stretch;\r\n            .revx-builder-element {\r\n                position: relative;\r\n            }\r\n            & > div > .revx-builder-controller {\r\n                height: 100%;\r\n            }\r\n            .revx-builder-element {\r\n                box-sizing: border-box;\r\n                height: 100%;\r\n            }\r\n        