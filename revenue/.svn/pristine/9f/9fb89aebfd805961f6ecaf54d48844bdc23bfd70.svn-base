gle {\n\t\t\t&__track {\n\t\t\t\tbackground-color: $outlined-track-bg-color;\n\t\t\t\tborder-color: $outlined-track-border-color;\n\t\t\t}\n\t\t\t&__thumb  {\n\t\t\t\tbackground-color: $outlined-thumb-bg-color;\n\t\t\t}\n\t\t}\n\t\t&.is-checked .revx-form-toggle__track {\n\t\t\tbackground-color: $outlined-track-bg-color-checked;\n\t\t\tborder-color: $outlined-track-border-color-checked;\n\t\t}\n\t\t.revx-form-toggle__input:focus + .revx-form-toggle__track {\n\t\t\tbox-shadow: 0 0 0 2px $outlined-thumb-bg-color-checked,\n\t\t\t\t0 0 0 calc(2 * 2px) $outlined-track-bg-color-checked;\n\t\t}\n\t\t&.is-checked .revx-form-toggle__thumb {\n\t\t\tbackground-color: $outlined-thumb-bg-color-checked;\n\t\t}\n\t}\n\t.revx-form-toggle {\n\t\tposition: relative;\n\t\tdisplay: inline-block;\n\t\tline-height: 0;\n\t\t// Unchecked state.\n\t\t&__track {\n\t\t\tposition: relative;\n\t\t\tcontent: \"\";\n\t\t\tdisplay: inline-block;\n\t\t\tbox-sizing: border-box;\n\t\t\tvertical-align: top;\n\t\t\tbackground-color: $track-bg-color;\n\t\t\tborder: $toggle-border-width solid $track-border-color;\n\t\t\ttransition: $transition-duration background-color ease,\n\t\t\t$transition-duration border-color ease;\n\t\t\t@include reduce-motion(\"transition\");\n\t\t\toverflow: hidden;\n\t\t\t// Windows High Contrast Mode\n\t\t\t&::after {\n\t\t\t\tcontent: \"\";\n\t\t\t\tposition: absolute;\n\t\t\t\tinset: 0;\n\t\t\t\tbox-sizing: border-box;\n\t\t\t\t// Expand the border to fake a solid in Windows High Contrast Mode.\n\t\t\t\tborder-top: solid transparent;\n\t\t\t\ttransition: $transition-duration opacity ease;\n\t\t\t\t@include reduce-motion(\"transition\");\n\t\t\t\topacity: 0;\n\t\t\t}\n\t\t}\n\t\t&__thumb {\n\t\t\tdisplay: block;\n\t\t\t@include positionStyle(absolute, $toggle-border-width * 2, $toggle-border-width * 2);\n\t\t\tbox-sizing: border-box;\n\t\t\tborder-radius: 50%;\n\t\t\ttransition: $transition-duration transform ease,\n\t\t\t$transition-duration background-color ease-out;\n\t\t\t@include reduce-motion(\"transition\");\n\t\t\tbackground-color: $thumb-bg-color;\n\t\t}\n\t\t// Checked state.\n\t\t&.is-checked .revx-form-toggle__track {\n\t\t\tbackground-color: $track-bg-color-checked;\n\t\t\tborder-color: $track-border-color-checked;\n\t\t\t// Windows High Contrast Mode\n\t\t\t&::after {\n\t\t\t\topacity: 1;\n\t\t\t}\n\t\t}\n\t\t.revx-form-toggle__input:focus + .revx-form-toggle__track {\n\t\t\tbox-shadow: 0 0 0 2px $thumb-bg-color-checked,\n\t\t\t\t0 0 0 calc(2 * 2px) $track-bg-color-checked;\n\t\t\t// Windows High Contrast mode will show this outline, but not the box-shadow.\n\t\t\toutline: 2px solid transparent;\n\t\t\toutline-offset: 2px;\n\t\t}\n\t\t&.is-checked .revx-form-toggle__thumb {\n\t\t\tbackground-color: $thumb-bg-color-checked;\n\t\t\tborder-width: 0; // Zero out the border color to make the thumb invisible in Windows High Contrast Mode.\n\t\t}\n\t\t// Disabled state:\n\t\t&.is-disabled,\n\t\t.revx-disabled & {\n\t\t\topacity: 0.3;\n\t\t}\n\t}\n\t.revx-label-container {\n\t\tcolor: map-get($neutral-colors, 'neutral-500') !important;\n\t}\n\t&.revx-component-toggle__checked {\n\t\t.revx-label-container {\n\t\t\tcolor: map-get($neutral-colors, 'neutral-900') !important;\n\t\t}\n\t}\n}\n\n// This needs specificity to override inherited checkbox styles.\n.revx-form-toggle input.revx-form-toggle__input[type=\"checkbox\"] {\n\t@include positionStyle(absolute, 0, 0);\n\twidth: 100%;\n\theight: 100%;\n\topacity: 0;\n\tmargin: 0;\n\tpadding: 0;\n\tz-index: 1;\n\t// This overrides a border style that is inherited from parent checkbox styles.\n\tborder: none;\n\t&:checked {\n\t\tbackground: none;\n\t}\n\t// Don't show custom checkbox checkmark.\n\t&::before {\n\t\tcontent: \"\";\n\t}\n}\n",".revx-tooltip {\r\n    width: max-content;\r\n    @include flexStyle(center, false, column);\r\n    position: relative;\r\n    &__content  {\r\n        color: map-get($neutral-colors, 'neutral-0');\r\n        display: flex;\r\n        box-sizing: border-box;\r\n        background-color: map-get($neutral-colors, 'neutral-900');\r\n        max-width: 260px;\r\n        padding: 4px 10px 4px 10px;\r\n        border-radius: 4px;\r\n        z-index: 999;\r\n        &::before {\r\n            content: \"\";\r\n            width: 100%;\r\n            padding: 10px;\r\n            display: block;\r\n            position: absolute;\r\n            top: -11px;\r\n            box-sizing: border-box;\r\n        }\r\n        p {\r\n            margin-top: 6px;\r\n        }\r\n        a {\r\n            color: map-get($primary-colors, 'green-base');\r\n        }\r\n    }\r\n    &__details, &-lg { \r\n        border-radius: 12px;\r\n        padding: 12px;\r\n    }\r\n    &__details {\r\n        max-width: 276px;\r\n        gap: 12px;\r\n    }\r\n    &__icon svg {\r\n        width: 32px;\r\n        height: 32px;\r\n    }\r\n    &__close {\r\n        width: 20px;\r\n        height: 20px;\r\n        cursor: pointer;\r\n    }\r\n    &__arrow {\r\n        height: 6px;\r\n        position: absolute;\r\n        svg {\r\n            height: 100% !important;\r\n            width: 100% !important;\r\n        }\r\n        svg, path {\r\n            fill: rgb(10, 13, 20);\r\n            stroke: rgb(10, 13, 20) !important;\r\n        }\r\n    }\r\n    &__text {\r\n        width: max-content;\r\n        .revx-subheading--sm {\r\n            font-weight: 400;\r\n            white-space: normal;\r\n        }\r\n    }\r\n    & > div {\r\n        line-height: 0px;\r\n    }\r\n    &:hover &__content {\r\n        visibility: visible;\r\n    }\r\n}\r\n\r\n.parent {\r\n    width: fit-content;\r\n    background-color: orange;\r\n}\r\n.child {\r\n    width: fit-content;\r\n    position: relative;\r\n    &:hover .tip {\r\n        display: block !important;\r\n    }\r\n}\r\n.tip {\r\n    background-color: red;\r\n    padding: 2px 5px;\r\n    @include positionStyle(absolute, 100%, 0);\r\n    // display: none;\r\n    white-space: nowrap;\r\n    // display: block;\r\n    margin-top: 10px;\r\n    &::before {\r\n        content: \"\";\r\n        display: block;\r\n        background-color: yellow;\r\n        padding: 10px;\r\n        @include positionStyle(absolute, -14px, 14px);\r\n        clipPath: polygon(50% 0%, 0% 100%, 100% 100%);\r\n    }\r\n}\r\n\r\n// .revx-tooltip-shape {\r\n//     &_bottom {\r\n//         top: calc(100% + 8px);\r\n//         .revx-tooltip-arrow {\r\n//             // top: -5px;\r\n//         }\r\n//     }\r\n//     &_right {\r\n//         left: calc(100% + 12px);\r\n//         .revx-tooltip-arrow {\r\n//             left: -16px;\r\n//             transform: rotate(-91deg);\r\n//         }\r\n//     }\r\n//     &_left {\r\n//         right: calc(100% + 12px);\r\n//         .revx-tooltip-arrow {\r\n//             right: -16px;\r\n//             transform: rotate(90deg);\r\n//         }\r\n//     }\r\n//     &_top {\r\n//         // bottom: calc(100% + 8px);\r\n//         .revx-tooltip-arrow {\r\n//             // bottom: -5px;\r\n//             transform: rotate(180deg);\r\n//         }\r\n//     }\r\n//     &_left:not(.revx-tooltip-details), &_right:not(.revx-tooltip-details) {\r\n//         align-items: center;\r\n//     } \r\n// }\r\n\r\n// .revx-tooltip-align {\r\n//     &_center  {\r\n//         left: 50%;\r\n//         transform: translateX(-50%);\r\n//         justify-content: center;\r\n//     }\r\n//     &_left .revx-tooltip-arrow {\r\n//         left: 16px;\r\n//     }\r\n//     &_right {\r\n//         right: 0px;\r\n//         .revx-tooltip-arrow {\r\n//             left: auto;\r\n//             right: 16px;\r\n//         }\r\n//     }\r\n//     &_left:not(.revx-tooltip-details) .revx-tooltip-arrow {\r\n//         left: 8px;\r\n//     }\r\n//     &_right:not(.revx-tooltip-details) .revx-tooltip-arrow {\r\n//         right: 8px;\r\n//     }\r\n\r\n//     &_middle.revx-tooltip-details .revx-tooltip-arrow {\r\n//         top: calc(50% - 2px);\r\n//     }\r\n//     &_top.revx-tooltip-details .revx-tooltip-arrow {\r\n//         top: 16px;\r\n//     }\r\n//     &_bottom.revx-tooltip-details .revx-tooltip-arrow {\r\n//         bottom: 16px;\r\n//     }\r\n//     &_middle.revx-tooltip-sm, &_middle.revx-tooltip-lg {\r\n//         align-items: center;\r\n//     }\r\n//     &_wide { // this part will remove after new design of tooltip implemented.\r\n//         .revx-tooltip-text {\r\n//             text-align: start;\r\n//         }\r\n//         .revx-subheading--sm {\r\n//             max-width: 900px;\r\n//         }\r\n//         .revx-tooltip-arrow {\r\n//             left: 30px;\r\n//         }\r\n//     }\r\n// }","// border-radius: 12px;\r\n// margin-bottom: 16px;\r\n// background-color: map-get($neutral-colors, 'neutral-0') !important;\r\n.revx-accordion {\r\n    border-top: 1px solid map-get($neutral-colors, 'neutral-200');\r\n    &-content {\r\n        overflow: hidden;\r\n        visibility: hidden;\r\n        opacity: 0;\r\n    }\r\n    &-btn {\r\n        color: map-get($neutral-colors, 'neutral-900');\r\n        cursor: pointer;\r\n        display: block;\r\n\t\tpadding: 20px 0px;\r\n        &__summary {\r\n            @include flexStyle(space-between, center);\r\n            flex: 1;\r\n        }\r\n        .revx-accordion-icon {\r\n            transition: .5s;\r\n\t\t\ttransform: rotate(90deg);\r\n\t\t\tpath {\r\n\t\t\t\tstroke: map-get($neutral-colors, 'neutral-900' );\r\n\t\t\t}\r\n        }\r\n    }\r\n    &.active {\r\n        margin-bottom: 20px;\r\n        .revx-accordion {\r\n            &-content {\r\n                opacity: 1;\r\n                overflow: visible;\r\n                visibility: visible;\r\n            }\r\n            &-btn__summary {\r\n                flex: unset;\r\n            }\r\n            &-btn__heading {\r\n                color: map-get($primary-colors, 'green-base' );\r\n                .revx-component-toggle .revx-label-container {\r\n                    color: map-get($primary-colors, 'green-base' ) !important;\r\n                }\r\n            }\r\n        }\r\n        .revx-accordion-btn > .revx-accordion-icon,\r\n        .revx-accordion-btn .revx-accordion-btn__summary .revx-accordion-icon {\r\n            transition: .5s;\r\n            transform: rotate(0deg);\r\n\t\t\tpath {\r\n\t\t\t\tstroke: map-get($primary-colors, 'green-base' );\r\n\t\t\t}\r\n        }\r\n    }\r\n}\r\n",".revx-nav {\r\n\theight: 64px;\r\n    background-color: map-get($neutral-colors, 'neutral-0');\r\n    &__logo-container {\r\n\t\tpadding-left: 24px;\r\n        margin-right: 24px;\r\n        padding-right: 24px;\r\n        border-right: 1px solid map-get($neutral-colors, 'neutral-200');\r\n    }\r\n    &__beta-tag-btn {\r\n        height: auto;\r\n        padding: 4px 15px !important;\r\n        border-radius: 20px !important;\r\n    }\r\n    &-brand {\r\n        @include flexStyle( false, center );\r\n    }\r\n    &-sticky {\r\n        @extend .revx-fill-width;\r\n\t\tborder-bottom: 1px solid map-get($neutral-colors, 'neutral-200'); // For Campaign Editor\r\n        background-color: map-get($neutral-colors, 'neutral-0');\r\n        z-index: 999;\r\n    }\r\n    &__container {\r\n\t\tpadding: 0px !important;\r\n        &__action {\r\n            gap: 16px;\r\n            padding-right: 24px;\r\n        }\r\n        &__content {\r\n            button {\r\n                align-self: center;\r\n            }\r\n        }\r\n    }\r\n    &-list {\r\n        .revx-nav-link {\r\n            display: block;\r\n            text-decoration: none;\r\n            color: map-get($neutral-colors, 'neutral-900');\r\n            font-weight: 500;\r\n            &.active, &:hover, &:focus-visible {\r\n                outline: none !important;\r\n                box-shadow: none !important;\r\n            }\r\n        }\r\n    }\r\n    &-responsive {\r\n        z-index: 9999;\r\n        background: map-get($neutral-colors, 'neutral-0');\r\n        padding: 40px 32px;\r\n        border-top: 1px solid map-get($neutral-colors, 'neutral-200' );\r\n        height: 100vh;\r\n        position: absolute;\r\n        @extend .revx-fill-width;\r\n    }\r\n    &-static  &-list {\r\n        @include flexStyle(false, center);\r\n        gap: 16px;\r\n        margin-left: 48px;\r\n        .revx-nav-link {\r\n\t\t\t@include typographyStyle(14px, 20px, -0.8px);\r\n            padding: 22px 12px; // For Update UI\r\n            border-bottom: 2px solid transparent;\r\n            transition: 400ms;\r\n            &.active, &:hover, &:focus-visible {\r\n                border-color: map-get($primary-colors, 'green-base');\r\n                color: map-get($primary-colors, 'green-base');\r\n                outline: none !important;\r\n                box-shadow: none !important;\r\n            }\r\n        }\r\n    }\r\n    &-responsive  &-list {\r\n        margin-bottom: 72px;\r\n        .revx-nav-link {\r\n            @include typographyStyle(24px, 1.33, normal);\r\n            &:not(:last-child) {\r\n                margin-bottom: 20px;\r\n            }\r\n            &.active, &:hover, &:focus-visible {\r\n                border-color: map-get($primary-colors, 'green-base');\r\n                color: map-get($primary-colors, 'green-base');\r\n                outline: none !important;\r\n                box-shadow: none !important;\r\n            }\r\n        }\r\n    }\r\n\t&.revx-campaign-nav  &__logo-container {\r\n\t\tborder-right: unset;\r\n\t\tpadding-right: unset;\r\n\t\tmargin-right: unset;\r\n\t\tpadding-left: unset;\r\n\t}\r\n\t&.revx-campaign-nav  &__container__content {\r\n\t\tborder-right: 1px solid #e2e4e9;  // For Campaign Editor\r\n\t\tpadding: 12px 24px;  // For Campaign Editor\r\n\t}\r\n\t&.revx-campaign-nav &__container__action {\r\n\t\twidth: 100%;\r\n    }\r\n}\r\n\r\n.revx-btn-notification {\r\n    border: none;\r\n    transition: .3s;\r\n    @include buttonColor(map-get($neutral-colors, 'neutral-100'), map-get($neutral-colors, 'neutral-900'), false, false, true);\r\n    @include buttonHoverColor(map-get($primary-colors, 'green-dark'), map-get($neutral-colors, 'neutral-100'), false, true, true);\r\n}\r\n\r\n.revx-btn-menu {\r\n    display: none !important;\r\n    @include buttonColor(map-get($neutral-colors, 'neutral-0'), map-get($neutral-colors, 'neutral-900'), false, map-get($neutral-colors, 'neutral-900'), true);\r\n    border: 1px solid;\r\n    border-color: map-get($neutral-colors, 'neutral-100');\r\n    @include buttonHoverColor(map-get($primary-colors, 'green-dark'), map-get($neutral-colors, 'neutral-0'), false, true, true);\r\n}\r\n\r\n.revx-navigation-dropdown {\r\n    position: relative;\r\n    z-index: 1;\r\n    cursor: pointer;\r\n    svg {\r\n        transform: rotate(90deg);\r\n    }\r\n    &__option {\r\n        padding: 6px 8px !important;\r\n        white-space: nowrap;\r\n        z-index: 999;\r\n        color: map-get($neutral-colors, 'neutral-400');\r\n        height: auto !important;\r\n        border-bottom: 0px !important;\r\n        &.active {\r\n            color: map-get($neutral-colors, 'neutral-900') !important;\r\n            background-color: #ececec;\r\n            border-radius: 4px;\r\n            &:hover {\r\n                background-color: #d6d5d5;\r\n            }\r\n        }\r\n    }\r\n    &__option-container {\r\n        display: none;\r\n        position: absolute;\r\n        top: calc(100% - 15px);\r\n        padding: 10px;\r\n        border-radius: 8px;\r\n        border: 1px solid map-get($neutral-colors, 'neutral-200' );\r\n        background-color: map-get($neutral-colors, 'neutral-0');\r\n        min-width: 208px;\r\n    }\r\n    &:hover {\r\n        display: flex;\r\n        svg {\r\n            transform: rotate(270deg) !important;\r\n        }\r\n    }\r\n    &:hover &__option-container {\r\n        display: block !important;\r\n    }\r\n}\r\n\r\n.toplevel_page_revenue .wp-submenu {\r\n\tli a {\r\n\t\t&.active, &:hover {\r\n\t\t\tborder-color: map-get($primary-colors, 'green-base') !important;\r\n\t\t\tcolor: map-get($primary-colors, 'green-base') !important;\r\n\t\t\toutline: none !important;\r\n\t\t\tbox-shadow: none !important;\r\n\t\t}\r\n\t}\r\n\r\n\r\n\tli a[href=\"https://www.wowrevenue.com/#pricing\"] {\r\n\t\tbackground-color: map-get($primary-colors, 'green-base') !important;\r\n\t\tcolor:  map-get($neutral-colors, 'neutral-0') !important;\r\n\t\t&.active, &:hover {\r\n\t\t\tborder-color: unset !important;\r\n\t\t\tcolor: unset !important;\r\n\t\t\toutline: none !important;\r\n\t\t\tbox-shadow: none !important;\r\n\t\t}\r\n\t}\r\n}\r\n\r\n@media only screen and (max-width: 1024px) {\r\n    .revx-btn-menu {\r\n        display: flex !important;\r\n    }\r\n    .revx-nav__container__content  {\r\n        height: 64px;\r\n        .revx-nav-link {\r\n            height: 100%;\r\n        }\r\n    }\r\n\t.revx-campaign-nav .revx-nav__container__content {\r\n\t\theight: unset;\r\n\t}\r\n}\r\n",".revx-radio, .revx-checkbox {\r\n    width: fit-content;\r\n    svg {\r\n        width: 16px;\r\n        height: 16px;\r\n        fill: map-get($neutral-colors, 'neutral-0');\r\n        stroke: map-get($neutral-colors, 'neutral-300');\r\n        border-radius: 4px;\r\n    }\r\n    input {\r\n        position: absolute;\r\n        visibility: hidden;\r\n        &:checked::before {\r\n            content: unset;\r\n        }\r\n        &:checked ~ label {\r\n            border-color: map-get($primary-colors, 'green-base') !important;\r\n            visibility: visible !important;\r\n            .revx-radio-shape {\r\n                visibility: visible !important;\r\n                border-color: map-get($primary-colors, 'green-base') !important;\r\n            }\r\n        }\r\n    }\r\n    &-label {\r\n        cursor: pointer;\r\n        height: 40px;\r\n        box-sizing: border-box;\r\n        .revx-radio-shape {\r\n            width: 16px;\r\n            height: 16px;\r\n            border-radius: 40px;\r\n            border: 4px solid map-get($neutral-colors, 'neutral-200');\r\n            box-sizing: border-box;\r\n\t\t\t&.not-checked{\r\n\t\t\t\tborder-width: 1.5px;\r\n\t\t\t}\r\n        }\r\n    }\r\n    &-border:is(.revx-input-icon) &-label {\r\n        width: 40px;\r\n        height: 40px;\r\n        border: 1px solid map-get($neutral-colors, 'neutral-200');\r\n        border-radius: 8px;\r\n        box-sizing: border-box;\r\n        @include flexStyle(center, center);\r\n        &:hover {\r\n            border: 1px solid map-get($primary-colors, 'green-base');\r\n        }\r\n    }\r\n    &:not(.revx-input-icon) &-label {\r\n        width: fit-content;\r\n        gap: 8px;\r\n        padding: 10px;\r\n        box-sizing: border-box;\r\n        border-radius: 8px;\r\n        border: 1px solid map-get($neutral-colors, 'neutral-200');\r\n        cursor: pointer;\r\n    }\r\n    &.revx-full-width, &.revx-full-width &-label {\r\n        width: 100%;\r\n    }\r\n    &:not(.revx-radio-list) input:checked ~ label > svg {\r\n        fill: map-get($primary-colors, 'green-base');\r\n    }\r\n    &:hover, &:focus-visible {\r\n        border-color: map-get($primary-colors, 'green-base') !important;\r\n        outline-color: map-get($primary-colors, 'green-base') !important;\r\n    }\r\n    &:has(input:checked) {\r\n        border-color: map-get($primary-colors, 'green-base') !important;\r\n        visibility: visible !important;\r\n\r\n        .revx-radio-shape {\r\n            visibility: visible !important;\r\n            border-color: map-get($primary-colors, 'green-base') !important;\r\n        }\r\n        input {\r\n            border: none;\r\n        }\r\n    }\r\n\t.revx-choiceInput-label {\r\n\t\tcolor: map-get($neutral-colors, 'neutral-500' );\r\n\t\tfont-size: 12px;\r\n\t}\r\n\t.revx-choiceInput-label__checked {\r\n\t\tcolor: map-get($neutral-colors, 'neutral-900' ) !important;\r\n\t}\r\n\t.revx-coming-soon-tag {\r\n\t\tfont-size: 12px;\r\n\t\tfont-weight: 500;\r\n\t\tline-height: 16px;\r\n\t\tcolor: map-get($vibrant-colors, 'blue-base');\r\n\t\tbackground-color: map-get($vibrant-colors, 'blue-lighter');\r\n\t\tpadding: 4px 8px;\r\n\t\tmargin-left: 8px;\r\n\t\tborder-radius: 12px;\r\n\t}\r\n}\r\n\r\n.revx-radio-list, .revx-checkbox-list {\r\n    width: 100% !important;\r\n    position: relative;\r\n    .revx-radio-label, .revx-checkbox-label {\r\n        width: 100% !important;\r\n        height: unset !important;\r\n        &:hover .revx-radio-shape, &:hover > svg {\r\n            visibility: visible !important;\r\n        }\r\n    }\r\n    .revx-radio-shape, .revx-checkbox-label > svg {\r\n        visibility: hidden;\r\n        @include positionStyle(absolute, 14px, 14px);\r\n    }\r\n    .revx-checklist-content {\r\n        gap: 12px;\r\n        svg {\r\n            height: 40px;\r\n            width: 40px;\r\n        }\r\n        &__subtitle {\r\n            margin-top: 4px;\r\n            color: map-get($neutral-colors, 'neutral-400');\r\n        }\r\n    }\r\n}\r\n\r\n.revx-group {\r\n    &-input {\r\n        width: 100%;\r\n    }\r\n    &-content {\r\n        gap: 8px;\r\n    }\r\n    &-label {\r\n        color: map-get($neutral-colors, 'neutral-500');\r\n    }\r\n}\r\n","\r\n.revx-toggle-search {\r\n    position: relative;\r\n    a {\r\n        text-decoration: none;\r\n    }\r\n    &:hover .revx-toggle-selected-product {\r\n        visibility: visible;\r\n        opacity: 1;\r\n        z-index: 999;\r\n    }\r\n\t&__products, &__category {\r\n\t\tmargin-left: 8px;\r\n\t}\r\n    &.disabled {\r\n        input {\r\n            cursor: not-allowed !important;\r\n            background-color: map-get($neutral-colors, 'neutral-100');\r\n        }\r\n    }\r\n    &.revx-trigger-quantity {\r\n        .revx-quantity-input {\r\n            position: absolute;\r\n            right: 0px;\r\n            z-index: 99;\r\n            max-width: 72px;\r\n            border-radius: 0px;\r\n            border-top-right-radius: 8px;\r\n            border-bottom-right-radius: 8px;\r\n            @include revx-appearance-textField;\r\n        }\r\n    }\r\n\t.revx-component-modal__content {\r\n\t\tpadding: 20px;\r\n\t\tpadding-top: 14px;\r\n\t}\r\n\t.revx-btn-cancel {\r\n\t\tbackground-color: map-get($map: $neutral-colors, $key:'neutral-0' ) !important;\r\n\t\tcolor: map-get($map: $neutral-colors, $key:'neutral-700' ) !important;\r\n\t\tborder-color: map-get($map: $neutral-colors, $key:'neutral-200' ) !important;\r\n        &:hover {\r\n            border-color: map-get($neutral-colors, 'neutral-900') !important;\r\n        }\r\n\t}\r\n\t.revx-product-query {\r\n\t\toverflow-y: auto;\r\n\t\tmax-height: 38vh;\r\n        @extend .revx-scrollbar-md;\r\n        margin-top: 20px;\r\n        margin-bottom: 20px;\r\n        &__no-product {\r\n            color: map-get($neutral-colors, 'neutral-400');\r\n            font-size: 16px;\r\n            font-weight: 500;\r\n            text-align: center;\r\n            flex-direction: column;\r\n            margin: 50px 0px 80px;\r\n            div {\r\n                color: map-get($neutral-colors, 'neutral-400');\r\n            }\r\n        }\r\n\t}\r\n    .revx-input-field {\r\n        position: relative;\r\n        input {\r\n            cursor: pointer;\r\n        }\r\n        &:focus {\r\n            outline-width: 1px !important;\r\n            outline-color: map-get($primary-colors, 'green-base');\r\n            border-color: map-get($neutral-colors, 'neutral-200');\r\n            box-shadow: 0 0 0 1px map-get($primary-colors, 'green-base');\r\n        }\r\n    }\r\n\r\n    .revx-loop-container {\r\n        cursor: pointer;\r\n        gap: 8px;\r\n        @include positionStyle(absolute, false, 4px, 12px);\r\n        width: -webkit-fill-available; /* Safari/WebKit */\r\n        width: -moz-available; /* Firefox */\r\n        width: fill-available;\r\n\t\theight: 40px;\r\n\t\tbox-sizing: border-box;\r\n        & > label {\r\n            margin-left: -0px;\r\n        }\r\n        label {\r\n            cursor: pointer;\r\n            color: map-get($neutral-colors, 'neutral-500');\r\n        }\r\n        img, svg {\r\n            height: 20px;\r\n            width: 20px;\r\n            border-radius: 50%;\r\n            background-color: map-get($neutral-colors, 'neutral-0');\r\n            padding: 1px;\r\n            flex-shrink: 0;\r\n            &:not(:first-child) {\r\n                margin-left: -22px;\r\n            }\r\n        }\r\n        &.revx-justify-space.revx-has-placeholder {\r\n            justify-content: flex-start;\r\n        }\r\n        .revx-search-select-placeholder {\r\n            color: map-get($neutral-colors, 'neutral-500');\r\n\t\t\tfont-size: 12px;\r\n\t\t\tline-height: 16px;\r\n        }\r\n        .revx-search-select-placeholder svg {\r\n            width: 16px;\r\n            height: 16px;\r\n            background-color: map-get($neutral-colors, 'neutral-400' );\r\n            font-size: 14px;\r\n            svg {\r\n                width: 16px !important;\r\n                height: 16px !important;\r\n                background-color: map-get($neutral-colors, 'neutral-400' );\r\n            }\r\n\t\t\tbox-sizing: border-box;\r\n        }\r\n    }\r\n\r\n\t.revx-select-all-proudcts {\r\n        height: 32px;\r\n\t\twidth: 32px;\r\n        @include flexStyle(center, center);\r\n\t\tfont-size: 14px;\r\n\t\tcolor: map-get($neutral-colors, 'neutral-0');\r\n\t\tborder-radius: 40px;\r\n\t\tbackground: map-get($neutral-colors, 'neutral-400');\r\n\t\tmargin-right: 8px;\r\n\t}\r\n    .revx-query-action {\r\n        justify-content: flex-end;\r\n        gap: 16px;\r\n        margin-top: 12px;\r\n    }\r\n\r\n    .revx-selected-product {\r\n        border-bottom: 1px solid map-get($neutral-colors, 'neutral-200');\r\n        margin: 15px 0px 10px;\r\n        padding-bottom: 15px;\r\n        max-height: 81px;\r\n        overflow-x: auto;\r\n        @extend .revx-scrollbar-md;\r\n        img {\r\n            height: 24px;\r\n            width: 24px;\r\n            border-radius: 50%;\r\n        }\r\n        &__item {\r\n            gap: 8px;\r\n            padding: 2px 8px; // popup selected product item only 6px padding need\r\n            border-radius: 18px;\r\n            box-sizing: border-box;\r\n            background-color: map-get($neutral-colors, 'neutral-200');\r\n            &-category {\r\n                z-index: 1;\r\n                &:not(:first-child) {\r\n                    margin-left: -55px;\r\n                };\r\n                &:last-child {\r\n                    // width: fit-content !important;\r\n                }\r\n                &:hover {\r\n                    // width: fit-content !important;\r\n                    z-index: 999;\r\n                }\r\n                &-content {\r\n                    border: 1px solid map-get($neutral-colors, 'neutral-0');\r\n                    // position: relative;\r\n                    label {\r\n                        @extend .revx-text-ellipsis;\r\n                        // max-width: 60px;\r\n                    }\r\n                }\r\n            }\r\n            span {\r\n                width: 82px;\r\n                display: block;\r\n                @extend .revx-text-ellipsis;\r\n            }\r\n            svg {\r\n                cursor: pointer;\r\n                background-color: map-get($neutral-colors, 'neutral-100');\r\n                border-radius: 18px;\r\n                padding: 2px;\r\n                box-sizing: border-box;\r\n            }\r\n        }\r\n    }\r\n    \r\n    .revx-query-result {\r\n        &__content {\r\n            justify-content: space-between;\r\n            padding: 10px 15px;\r\n\t\t\tborder-bottom: 1px solid map-get($neutral-colors, 'neutral-200');\r\n            &:hover {\r\n                background-color: map-get($neutral-colors, 'neutral-100');\r\n            }\r\n            &:not(:first-child) {\r\n                border-top: 1px solid map-get($neutral-colors, 'neutral-200');\r\n            }\r\n        }\r\n        &__wrapper {\r\n            margin-right: 32px;\r\n        }\r\n        &__title {\r\n            max-width: 724px;\r\n            color: map-get($neutral-colors, 'neutral-900');\r\n            text-overflow: ellipsis;\r\n            white-space: nowrap;\r\n            overflow: hidden;\r\n            display: block;\r\n            cursor: pointer;\r\n        }\r\n        &__media {\r\n            img,.img-skeleton {\r\n                height: 48px;\r\n                width: 48px;\r\n                border-radius: 4px;\r\n                cursor: pointer;\r\n            }\r\n        }\r\n        &__price {\r\n            color: map-get($neutral-colors, 'neutral-700');\r\n        }\r\n        &__price-variation {\r\n            color: map-get($primary-colors, 'green-base');\r\n            border-radius: 12px;\r\n            background-color: map-get($primary-colors, 'green-lighter');\r\n            padding: 2px 6px 2px 10px;\r\n            gap: 4px;\r\n            svg {\r\n                transition: .3s;\r\n                transform: rotate(180deg);\r\n                path {\r\n                    stroke: map-get($primary-colors, 'green-base');\r\n                }\r\n            }\r\n            &.active svg {\r\n                transform: rotate(0deg);\r\n            }\r\n        }\r\n        .revx-result-variation {\r\n            padding-left: 56px;\r\n            &__item {\r\n                gap: 16px;\r\n                padding: 16px 0px;\r\n                border-top: 1px solid map-get($neutral-colors, 'neutral-200');\r\n                &:hover {\r\n                    background-color: map-get($neutral-colors, 'neutral-100');\r\n                }\r\n            }\r\n        }\r\n    }\r\n}",".revx-input-container {\r\n    position: relative;\r\n\tfont-size: 12px;\r\n    &.rvs-others-field {\r\n        width: 100%;\r\n    }\r\n    &.revx-inline {\r\n        gap: 16px;\r\n        width: 100%;\r\n        .revx-label-container  {\r\n            margin: 0px !important;\r\n        }\r\n    }\r\n\t&.revx-shortcode-field {\r\n\t\tinput {\r\n\t\t\tbackground-color: map-get($neutral-colors, 'neutral-0') !important;\r\n\t\t\tcursor: copy !important;\r\n\t\t}\r\n\t}\r\n}\r\n\r\n.revx-input-field {\r\n    height: 40px;\r\n    input {\r\n        width: 100%;\r\n        height: 100%;\r\n        color: map-get($neutral-colors, 'neutral-500');\r\n        padding: 0px 16px;\r\n        border-radius: 8px;\r\n        border: 1px solid map-get($neutral-colors, 'neutral-200');\r\n        @include typographyStyle(12px, 16px, -0.08px);\r\n        background-color: map-get($neutral-colors, 'neutral-0');\r\n        &:focus, &:focus-within {\r\n            outline-width: 1px !important;\r\n            outline-color: map-get($primary-colors, 'green-base');\r\n            border-color: map-get($neutral-colors, 'neutral-200');\r\n            box-shadow: 0 0 0 1px map-get($primary-colors, 'green-base');\r\n        }\r\n    }\r\n    &.revx-input-overlay {\r\n        border-radius: 8px;\r\n        border: 1px solid map-get($neutral-colors, 'neutral-200' );;\r\n        box-sizing: border-box;\r\n        overflow: hidden;\r\n        input {\r\n            border: 0px;\r\n            outline: 0px;\r\n            margin: 0px;\r\n            &:focus, &:focus-within {\r\n                outline-width: 0px !important;\r\n                outline-color: none !important;\r\n                // border-color: unset !important;\r\n                box-shadow: unset !important;\r\n            }\r\n        }\r\n        &:focus, &:focus-within {\r\n            outline-width: 1px !important;\r\n            outline-color: map-get($primary-colors, 'green-base');\r\n            border-color: map-get($neutral-colors, 'neutral-200');\r\n            box-shadow: 0 0 0 1px map-get($primary-colors, 'green-base');\r\n        }\r\n    }\r\n    .revx-label-overlay {\r\n        border-left: 1px solid map-get($neutral-colors, 'neutral-200' );;\r\n        gap: 10px;\r\n        cursor: pointer;\r\n        white-space: nowrap;\r\n        height: 100%;\r\n        background-color: map-get($neutral-colors, 'neutral-100');\r\n        padding: 12px;\r\n    }\r\n}\r\n\r\n.revx-date {\r\n    &-field {\r\n        input {\r\n            padding-left: 60px;\r\n            &::-webkit-calendar-picker-indicator {\r\n                display: none;\r\n                -webkit-appearance: none;\r\n            }\r\n        }\r\n    }\r\n    &-icon {\r\n        height: 16px;\r\n        width: 16px;\r\n        position: absolute;\r\n        left: 20px;\r\n        cursor: pointer;\r\n        svg {\r\n            height: 100%;\r\n            width: 100%;\r\n        }\r\n    }\r\n    &-picker {\r\n        @include positionStyle(absolute, 100%, 0px);\r\n        z-index: 9999;\r\n    }    \r\n}\r\n\r\n.revx-overlay-reverse {\r\n    flex-direction: row-reverse;\r\n    input {\r\n        border-radius: 6px 0px 0px 6px;\r\n    }\r\n    .revx-emoji {\r\n        right: 105px;\r\n    }\r\n    .revx-label-overlay {\r\n\r\n        border-radius: 0px 8px 8px 0px;\r\n    }\r\n}\r\n\r\ndiv:not(.revx-overlay-reverse).revx-input-field {\r\n    &.revx-input-overlay input {\r\n        border-radius: 0px 8px 8px 0px;\r\n    }\r\n    & > .revx-label-overlay {\r\n        border-right: 1px solid map-get($neutral-colors, 'neutral-200');\r\n        border-left: 0px;\r\n        border-top-left-radius: 8px;\r\n        border-bottom-left-radius: 8px;\r\n    }\r\n}\r\n\r\n.revx-component-modal__content .rvs-search-field {\r\n\t.revx-input-field {\r\n\t\theight: 44px !important;\r\n\t}\r\n\tinput {\r\n\t\tfont-size: 14px !important;\r\n\t}\r\n\tinput:not(.revx-hide-placeholder)::placeholder {\r\n\t\tcolor: map-get($neutral-colors, 'neutral-300') !important;\r\n\t}\r\n}\r\n\r\n.revx-help-message {\r\n\tfont-size: 12px;\r\n\tfont-weight: 400;\r\n\tline-height: 16px;\r\n\tcolor: map-get($neutral-colors, \"neutral-400\");\r\n\tmargin-top: 4px;\r\n\t.revx-smart-tag {\r\n\t\tcolor: map-get($neutral-colors, \"neutral-700\");\r\n\t}\r\n}\r\n\r\n.rvs-search-field .revx-label-overlay {\r\n    background-color: map-get($neutral-colors, 'neutral-0');\r\n}\r\n",".revx-emoji-keyboard {\r\n    position: absolute;\r\n    right: 0px;\r\n    top: calc(100% + 8px);\r\n    border-radius: 4px;\r\n    z-index: 9999999999;\r\n}\r\n.revx-input-field  {\r\n    position: relative;\r\n}\r\nemoji-picker {\r\n    --category-emoji-padding: 12px !important;\r\n    --num-columns: 7;\r\n    // --border-color: map-get($primary-colors, 'green-base');\r\n    --button-active-background: map-get($primary-colors, 'green-base');\r\n    --button-hover-background: map-get($primary-colors, 'green-base');\r\n    // --category-emoji-size: 1.125rem;\r\n    --category-font-color: map-get($primary-colors, 'green-base');\r\n    --indicator-color: map-get($primary-colors, 'green-base');\r\n    --input-border-color: map-get($primary-colors, 'green-base');\r\n    --input-padding: 14px;\r\n    --outline-color: map-get($primary-colors, 'green-base');\r\n    // --skintone-border-radius: 5px;\r\n}",".revx-toaster {\r\n    color: map-get($neutral-colors, 'neutral-0');\r\n    width: 100%;\r\n    @include flexStyle(false, center);\r\n    border-radius: 8px;\r\n    box-sizing: border-box;\r\n    &.revx-toaster-inline {\r\n        margin-top: 16px;\r\n    }\r\n    &-container {\r\n        width: 400px;\r\n        display: flex;\r\n        gap: 10px;\r\n        flex-direction: column-reverse;\r\n        @include positionStyle(fixed, 100px, false, 24px);\r\n        z-index: 9999999999999;\r\n        transition: .3s;\r\n    }\r\n    &-lg {\r\n        height: 40px;\r\n        padding: 0px 12px;\r\n    }\r\n    &-sm {\r\n        height: 32px;\r\n        padding: 0px 8px;\r\n    }\r\n    &__icon, &__icon path {\r\n        stroke: map-get($neutral-colors, 'neutral-0');\r\n    }\r\n    &__close-icon {\r\n        cursor: pointer;\r\n    }\r\n    &__upload-icon {\r\n        margin: 0px 10px 0px 5px;\r\n    }\r\n    &-position {\r\n        &__top-left {\r\n            animation: toasterHeightAnimation .3s ease,\r\n            toasterSlideEntire .5s ease-in .3s,\r\n            toasterHideAnimation 1s ease 4s;\r\n        }\r\n    }\r\n    &__danger {\r\n        background-color: map-get($vibrant-colors, 'red-base');\r\n        &-light {\r\n            color: map-get($vibrant-colors, 'red-darker');\r\n            background-color: map-get($vibrant-colors, 'red-light');\r\n        }\r\n    }\r\n    &__danger-light &__icon,\r\n    &__danger-light &__icon path {\r\n        stroke: map-get($vibrant-colors, 'red-darker');\r\n    }\r\n    &__warning {\r\n        background-color: map-get($vibrant-colors, 'orange-base');\r\n        &-light {\r\n            color: map-get($vibrant-colors, 'orange-darker');\r\n            background-color: map-get($vibrant-colors, 'orange-light');\r\n        }\r\n    }\r\n    &__warning-light &__icon,\r\n    &__warning-light &__icon path {\r\n        stroke: map-get($vibrant-colors, 'orange-darker');\r\n    }\r\n    &__success {\r\n        background-color: map-get($primary-colors, 'green-base');\r\n        &-light {\r\n            color: map-get($primary-colors, 'green-darker');\r\n            background-color: map-get($primary-colors, 'green-light');\r\n        }\r\n    }\r\n    &__success-light &__icon,\r\n    &__success-light &__icon path {\r\n        stroke: map-get($primary-colors, 'green-darker');\r\n    }\r\n    &__info {\r\n        background-color: map-get($vibrant-colors, 'blue-base');\r\n        &-light {\r\n            color: map-get($vibrant-colors, 'blue-darker');\r\n            background-color: map-get($vibrant-colors, 'blue-light');\r\n        }\r\n    }\r\n    &__info-light &__icon,\r\n    &__info-light &__icon path {\r\n        stroke: map-get($vibrant-colors, 'blue-darker');\r\n    }\r\n    &__dark {\r\n        background-color: map-get($neutral-colors, 'neutral-700');\r\n        &-light {\r\n            color: map-get($neutral-colors, 'neutral-700');\r\n            background-color: map-get($neutral-colors, 'neutral-200' );\r\n        }\r\n    }\r\n    &__dark-light &__icon,\r\n    &__dark-light &__icon path {\r\n        stroke: map-get($neutral-colors, 'neutral-700');\r\n    }\r\n}\r\n\r\n@keyframes toasterSlideEntire {\r\n    from {\r\n        transform: translateX(100%);\r\n    }\r\n    to {\r\n        transform: translateX(calc(0% + 24px));\r\n    }\r\n}\r\n\r\n@keyframes toasterHeightAnimation {\r\n    from {\r\n        transform: translateX(120%);\r\n        height: 0px;\r\n        overflow: hidden;\r\n    }\r\n    to {\r\n        transform: translateX(120%);\r\n        height: 40px;\r\n        overflow: visible;\r\n    }\r\n}\r\n\r\n@keyframes toasterHideAnimation {\r\n    from {\r\n        opacity: 1;\r\n    }\r\n    to {\r\n        opacity: 0;\r\n    }\r\n}\r\n","\r\n.revx-date-container {\r\n    // width: 100%;\r\n\t.revx-date-picker-input::placeholder,\r\n\t.revx-date-picker-input::-webkit-input-placeholder,\r\n\t.revx-date-picker-input::-moz-placeholder{\r\n\t\tcolor: map-get($neutral-colors, 'neutral-500') !important;\r\n\t}\r\n\t.revx-date-picker-input:disabled::placeholder {\r\n\t\tcolor: map-get($neutral-colors, 'neutral-300') !important; /* Disabled placeholder color */\r\n\t}\r\n    .react-datepicker-wrapper {\r\n        width: 100%;\r\n    }\r\n    .react-datepicker__input-container {\r\n        display: flex !important;\r\n        align-items: center;\r\n    }\r\n    .react-datepicker {\r\n        display: flex !important;\r\n        gap: 48px;\r\n        border: 0px;\r\n        background-color: map-get($neutral-colors, 'neutral-0') !important;\r\n        padding: 0px 32px 8px;\r\n        box-shadow: 0px 24px 56px -4px rgba(88, 92, 95, 0.16);\r\n        border-radius: 16px;\r\n        &__triangle {\r\n            display: none;\r\n        }\r\n        &__navigation {\r\n            top: 23px;\r\n            &-icon::before {\r\n                width: 6px !important;\r\n                height:  6px !important;\r\n                border-width: 2px 2px 0 0;\r\n                border-color: map-get($neutral-colors, 'neutral-900');\r\n            }\r\n        }\r\n        &__navigation--previous {\r\n            left: 23px;\r\n        }\r\n        &__navigation--next {\r\n            right: 23px;\r\n        }\r\n        &__header  {\r\n            border-bottom: 0px !important;\r\n            background-color: map-get($neutral-colors, 'neutral-0') !important;\r\n        }\r\n        &__week {\r\n            @include flexStyle(false, center);\r\n            text-align: center;\r\n            gap: 11px;\r\n            &:not(:last-child) {\r\n                margin-bottom: 8px;\r\n            }\r\n        }\r\n        &__month {\r\n            margin: 0px !important;\r\n        }\r\n        &__week > * {\r\n            cursor: pointer !important;\r\n            height: 42px;\r\n            width: 42px;\r\n            text-align: center;\r\n            border-radius: 8px;\r\n            @include flexStyle(center, center);\r\n            @include typographyStyle(18px, 1.33, -0.27px);\r\n            margin: 0px !important;\r\n            &:not(.react-datepicker__year-text--in-range){\r\n                position: relative;\r\n                &:hover {\r\n                    background-color: map-get($primary-colors, 'green-lighter');\r\n                }\r\n                &::after {\r\n                    content: \"\";\r\n                    width: 11px;\r\n                    height: 10px;\r\n                    // background-color: map-get($primary-colors, 'green-lighter');\r\n                    position: absolute;\r\n                    right: -11px;\r\n                    height: 100%;\r\n                }\r\n            }\r\n        }\r\n        &__day-names {\r\n            height: 36px;\r\n            display: flex;\r\n            align-items: center;\r\n            border-top: 1px solid map-get($neutral-colors, 'neutral-200' );\r\n            justify-content: space-between;\r\n            &  > * {\r\n                width: 37px;\r\n                height: 42px;\r\n                font-weight: 500;\r\n                text-align: center;\r\n                text-transform: uppercase;\r\n                @include typographyStyle(12px, 1.33, normal);\r\n                @include flexStyle(center, center);\r\n            }\r\n        }\r\n        &__week > * ,\r\n        &__day-names > * {\r\n            color: map-get($neutral-colors, 'neutral-900');\r\n        }\r\n        &__day--selected {\r\n            color: map-get($neutral-colors, 'neutral-0');\r\n            font-weight: 400;\r\n            border-radius: 8px;\r\n            background-color: map-get($primary-colors, 'green-base') !important;\r\n            &:hover {\r\n                border-radius: 8px;\r\n                background-color: map-get($primary-colors, 'green-base');\r\n            }\r\n        }\r\n        &__day--today,\r\n        &__day--keyboard-selected {\r\n            font-weight: 400;\r\n            background-color: map-get($primary-colors, 'green-lighter');\r\n        }\r\n        &__day--in-selecting-range {\r\n            &:not(\r\n                :empty,\r\n                .react-datepicker__day--in-range,\r\n                .react-datepicker__month-text--in-range,\r\n                .react-datepicker__quarter-text--in-range,\r\n                .react-datepicker__year-text--in-range,\r\n                .react-datepicker__day--selecting-range-start,\r\n                .react-datepicker__day--selecting-range-end) {\r\n                background-color: map-get($primary-colors, 'green-lighter') !important;\r\n                color: map-get($neutral-colors, 'neutral-900') !important;\r\n                border-radius: 0px;\r\n                &::after {\r\n                    background-color: map-get($primary-colors, 'green-lighter') !important;\r\n                }\r\n            }\r\n            &:empty {\r\n                background-color: transparent !important;\r\n            }\r\n        }\r\n\r\n        &__day--outside-month {\r\n            color: map-get($neutral-colors, 'neutral-300') !important;\r\n        }\r\n        &__day--selecting-range-start:not(.react-datepicker__day--selecting-range-end) {\r\n            border-top-right-radius: 0px !important;\r\n            border-bottom-right-radius: 0px !important;\r\n\r\n            &::after {\r\n                background-color: map-get($primary-colors, 'green-lighter') !important;\r\n            }\r\n        }\r\n        &__day--selecting-range-end {\r\n            color: map-get($neutral-colors, 'neutral-0') !important;\r\n            border-top-left-radius: 0px !important;\r\n            border-bottom-left-radius: 0px !important;\r\n            background-color: map-get($primary-colors, 'green-base') !important;\r\n        }\r\n        &__month-year-read-view--down-arrow {\r\n            right: -27px;\r\n            top: 4px;\r\n            border-color: map-get($neutral-colors, 'neutral-900');\r\n            border-width: 2px 2px 0 0;\r\n        }\r\n        &__day--today:is(.react-datepicker__day--selecting-range-start.react-datepicker__day--selecting-range-end) {\r\n            border-radius: 8px !important;\r\n        }\r\n        .react-datepicker__current-month,\r\n        .react-datepicker__header__dropdown {\r\n            color: map-get($neutral-colors, 'neutral-400');\r\n            font-weight: 500;\r\n            @include typographyStyle(20px, 1.4, normal);\r\n        }\r\n        .react-datepicker__current-month {\r\n            padding: 16px 0px;\r\n        }\r\n    }\r\n    &.revx-dropDown-style {\r\n        .react-datepicker__header__dropdown {\r\n            display: none !important;\r\n        }\r\n        .react-datepicker__current-month {\r\n            display: block !important;\r\n        }\r\n    }\r\n    &.revx-date-dropdown {\r\n        .react-datepicker {\r\n            border-radius: 16px;\r\n            box-shadow: 0px 40px 96px -8px rgba(88, 92, 95, 0.2) !important;\r\n            animation: LabelAnimationIn 1s;\r\n            &__input-container  {\r\n                svg {\r\n                    left: 16px;\r\n                }\r\n                svg, path {\r\n                    padding: 0px;\r\n                    stroke: map-get($neutral-colors, 'neutral-400');\r\n                }\r\n                input {\r\n                    color: map-get($neutral-colors, 'neutral-500');\r\n                    height: 40px;\r\n                    border-radius: 8px;\r\n                    border-color: map-get($neutral-colors, 'neutral-200' );\r\n                    padding: 6px 10px 5px 40px;\r\n                    outline-width: 0px;\r\n                    border-width: 1px;\r\n                    width: 100%;\r\n                    @include typographyStyle(14px, 1.43, -0.08px);\r\n                    background: none;\r\n                    &:disabled {\r\n                        // opacity: 0.8;\r\n                        cursor: not-allowed;\r\n\t\t\t\t\t\tbackground-color: map-get($neutral-colors, 'neutral-100' );\r\n\t\t\t\t\t\tcolor: map-get($neutral-colors, 'neutral-300' );\r\n\t\t\t\t\t\tbox-shadow: unset;\r\n                    }\r\n\t\t\t\t\t&::placeholder {\r\n\t\t\t\t\t\tcolor: map-get($neutral-colors, 'neutral-300' );\r\n\t\t\t\t\t  }\r\n\r\n\t\t\t\t\t&::-ms-input-placeholder { /* Edge 12 -18 */\r\n\t\t\t\t\t\tcolor: map-get($neutral-colors, 'neutral-300' );\r\n\t\t\t\t\t}\r\n                    &:focus {\r\n                        box-shadow: none;\r\n                        outline-width: 1px;\r\n                        border-width: 1px;\r\n                        outline-color: map-get($primary-colors, 'green-base');\r\n                        border-color: map-get($primary-colors, 'green-base');\r\n                        background: none;\r\n                    }\r\n                };\r\n            }\r\n            &__current-month {\r\n                display: none;\r\n            }\r\n            &__month-year-dropdown {\r\n                text-align: left;\r\n                color: map-get($neutral-colors, 'neutral-900');\r\n                min-width: 250px;\r\n                max-height: 200px;\r\n                overflow: auto;\r\n                background-color: map-get($neutral-colors, 'neutral-0');\r\n                padding: 10px 0x 0px;\r\n                .react-datepicker__month-year-option,\r\n                .react-datepicker__month-year-option--selected_month-year {\r\n                    width: auto;\r\n                    padding: 4px 8px 4px 34px;\r\n                    margin-right: auto !important;\r\n                    margin-left: 0px !important;\r\n                    @include typographyStyle(12px, 1.33, normal);\r\n                    &:hover {\r\n                        background-color: map-get($primary-colors, 'green-lighter');\r\n                    }\r\n                }\r\n            }\r\n        }\r\n        .react-datepicker__header__dropdown {\r\n            padding: 16px 0px;\r\n        }\r\n    }\r\n    &.revx-date-range .react-datepicker__calendar-icon  {\r\n        display: none;\r\n    }\r\n}\r\n.revx-dashboard-filter__date-picker {\r\n    .react-datepicker-popper {\r\n        left: 0px !important;\r\n    }\r\n    .revx-date-active {\r\n        .react-datepicker-popper {\r\n            left: 50px !important;\r\n        }\r\n    }\r\n}\r\n\r\n.react-datepicker__day--in-range:not(:empty) {\r\n    color: map-get($neutral-colors, 'neutral-0') !important;\r\n    background-color: map-get($primary-colors, 'green-base') !important;\r\n}\r\n.react-datepicker__day--in-range:empty {\r\n    background-color: transparent !important;\r\n}\r\n","// Content Style\r\n.revx-campaign-scroll {\r\n    overflow-x: auto;\r\n}\r\n\r\n.revx-campaign-table, table.revx-campaign-table {\r\n    width: 100%;\r\n    text-align: left;\r\n    border-spacing: 50px 0;\r\n    border-collapse: collapse;\r\n    // display: block; // Comment by asif, why use table display block??\r\n    thead {\r\n        tr {\r\n            border-top: 0px !important;\r\n        }\r\n    }\r\n    tr {\r\n        padding: 0px !important;\r\n        margin: 0px !important;\r\n        &:last-child {\r\n            border-bottom: 1px  solid map-get($neutral-colors, 'neutral-200') !important;\r\n        }\r\n        &.revx-campaign-table__row:not(:first-child) {\r\n            border-top: 1px  solid map-get($neutral-colors, 'neutral-200');\r\n        }\r\n        th {\r\n            color: map-get($neutral-colors, 'neutral-400');\r\n            @include typographyStyle(14px, 24px, 0.96px);\r\n        }\r\n        td {\r\n            @include typographyStyle(14px, 24px, 0.96px);\r\n            width: 100%;\r\n        }\r\n        td.revx-campaign-list__revenue {\r\n            color: map-get($vibrant-colors, 'purple-base');\r\n        }\r\n        th,td {\r\n            max-width: 10rem !important;\r\n            width: unset !important;\r\n            box-sizing: border-box;\r\n            vertical-align: middle;\r\n            white-space: nowrap;\r\n            padding: 16px 15px !important;\r\n\t\t\tbox-sizing: content-box; // Added By Asif - For Fix campaign trend icon broken\r\n        }\r\n        .check_column {\r\n            padding-left: 0px !important;\r\n        }\r\n        &.revx-empty-row {\r\n            height: 70vh;\r\n            text-align: center !important;\r\n            border-bottom: 0px !important;\r\n            &:hover {\r\n                background-color: unset;\r\n            }\r\n        }\r\n    }\r\n    thead tr {\r\n        td {\r\n            &:first-child {\r\n                padding-left: 0px !important;\r\n            }\r\n            &:last-child {\r\n                padding-right: 0px !important;\r\n            }\r\n        }\r\n    }\r\n    &__empty-table {\r\n        background-color:map-get($neutral-colors, 'neutral-100');\r\n        border-radius: 50%;\r\n        max-width: 240px;\r\n        height: 240px;\r\n        margin: 0 auto 16px;\r\n    }\r\n    &__empty-label {\r\n        color: map-get($neutral-colors, 'neutral-400');\r\n        @include typographyStyle(24px, 1.33, normal);\r\n    }\r\n    &__row {\r\n        max-width: 1488px;\r\n        box-sizing: border-box;\r\n        padding: 20px 8px;\r\n        margin: 0 auto;\r\n        &:first-child {\r\n            padding: 16px 8px;\r\n            .revx-tooltip-shape_top {\r\n                top: calc(100% + 8px);\r\n                bottom: auto;\r\n                .revx-tooltip-arrow {\r\n                    top: -5px;\r\n                    transform: unset;\r\n                    bottom: auto;\r\n                }\r\n            }\r\n        }\r\n        &:last-child,\r\n        &:nth-last-child(3),\r\n        &:nth-last-child(2) {\r\n            .revx-toggle-selected-product {\r\n                top: auto !important;\r\n                bottom: 80% !important;\r\n            }\r\n        }\r\n        &:nth-child(2),\r\n        &:first-child {\r\n            .revx-toggle-selected-product  {\r\n                top: 85% !important;\r\n        }\r\n        }\r\n        &:nth-last-child(2),\r\n        &:last-child {\r\n            .revx-toggle-selected-product {\r\n                top: calc(-100% - 100px);\r\n            }\r\n        }\r\n        &:nth-last-child(2) {\r\n            .revx-toggle-selected-product {\r\n                top: calc(-100% - 100px);\r\n            }\r\n        }\r\n        &:not(:first-child) {\r\n            color: map-get($neutral-colors, 'neutral-700');\r\n        }\r\n        & > h4 {\r\n            color: map-get($neutral-colors, 'neutral-400');\r\n        }\r\n\t\t.campaign_name {\r\n            .revx-text-ellipsis, a {\r\n                max-width: 10rem;\r\n            }\r\n\t\t\ta {\r\n\t\t\t\ttext-decoration: none;\r\n\t\t\t\tcolor: inherit;\r\n                @extend .revx-text-ellipsis;\r\n                display: block;\r\n\t\t\t\t&:hover, &:focus{\r\n\t\t\t\t\tcolor: map-get($map: $primary-colors, $key: 'green-base');\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n        .revx-toggle-selected-product {\r\n            top: 100%;\r\n        }\r\n    }\r\n    .revx-sorting-indicators {\r\n        display: flex;\r\n        flex-direction: column;\r\n        gap: 2px;\r\n    }\r\n    .revx-sorting-indicator {\r\n        line-height: 1;\r\n        font-size: 6px;\r\n        cursor: pointer;\r\n\r\n        &.active svg path {\r\n            fill: map-get($neutral-colors, 'neutral-900' );\r\n        }\r\n    }\r\n    .revx-loop-container {\r\n\t\tposition: relative !important;\r\n\t}\r\n}\r\n",".revx-campaign-blank {\r\n    &__container {\r\n        max-width: 1536px;\r\n        box-sizing: border-box;\r\n        border-radius: 12px;\r\n        border-top-right-radius: 0px;\r\n        border-top-left-radius: 0px;\r\n        background-color: map-get($neutral-colors, 'neutral-0');\r\n        padding: 50px 20px 100px;\r\n        margin: 0px auto 0px;\r\n        & > svg {\r\n            max-width: 380px;\r\n            max-height: 290px;\r\n        }\r\n    }\r\n    &_heading {\r\n        margin-top: 40px;\r\n        margin-bottom: 16px;\r\n        text-align: center;\r\n    }\r\n    &_subheading {\r\n        color: map-get($neutral-colors, 'neutral-400');\r\n        text-align: center;\r\n        max-width: 655px;\r\n    }\r\n    .revx-btn {\r\n        margin: 40px auto 0px;\r\n    }\r\n}",".revx-breadcrumb {\r\n    background-color: map-get($neutral-colors, 'neutral-100');\r\n    padding: 4px 12px;\r\n    border-radius: 12px;\r\n    &-item {\r\n        color: map-get($neutral-colors, 'neutral-500');\r\n        @include typographyStyle(12px, 16px, 0.48px);\r\n        &:not(:last-child):after {\r\n            content: \"\";\r\n            display: block;\r\n            width: 6px;\r\n            height: 6px;\r\n            border-radius: 20px;\r\n            background-color: map-get($neutral-colors, 'neutral-500');\r\n        }\r\n    }   \r\n}",".revx-sidebar-popup {\r\n    @include positionStyle(fixed, 0px, false, 0px);\r\n    height: 100%;\r\n    width: 100%;\r\n    background: rgba(0, 0, 0, 0.75);\r\n    z-index: 99999;\r\n    &__content {\r\n        width: 100%;\r\n        height: 100%;\r\n        max-width: 37vw;\r\n        margin-left: auto;\r\n        background-color: map-get($neutral-colors, 'neutral-0' );\r\n    }\r\n    &__header {\r\n        color: map-get($neutral-colors, 'neutral-900');\r\n        padding: 28px 32px;\r\n        border-bottom: 1px solid map-get($neutral-colors, 'neutral-200' );\r\n        box-sizing: border-box;\r\n    }\r\n    &__body-content {\r\n        padding: 24px 32px;\r\n    }\r\n    &__title {\r\n        color: map-get($neutral-colors, 'neutral-900');\r\n        margin-bottom: 16px;\r\n    }\r\n    &__desc {\r\n        color: map-get($neutral-colors, 'neutral-900');\r\n    }\r\n    &__close {\r\n        cursor: pointer;\r\n        width: fit-content;\r\n        height: fit-content;\r\n        line-height: 0px;\r\n        padding: 4px;\r\n        border-radius: 4px;\r\n        border: 1px solid map-get($neutral-colors, 'neutral-200' );\r\n    }\r\n}\r\n",".revx-campaign {\r\n    margin-top: 66px;\r\n\tpadding-bottom: 20px;\r\n    &-container {\r\n\t\tdisplay: grid;\r\n\t\tjustify-content: center;\r\n\t\tgrid-template-columns: minmax(0, 520px) minmax(0, 904px);\r\n\t\tpadding: 0px !important;\r\n\t}\r\n\t&__builder {\r\n\t\twidth: 100%;\r\n\t\tmax-width: 904px;\r\n\t\theight: max-content !important;\r\n\t\t@include flexStyle(flex-end);\r\n\t\ttransition: 1s;\r\n\t\tpadding: 8px;\r\n\t\tpadding-top: 0px; // Added to adjust builder padding.\r\n\t\tposition: sticky !important;\r\n\t\ttop: 0;\r\n\t}\r\n\t&-back-icon {\r\n\t\theight: 40px;\r\n\t\twidth: 40px;\r\n\t\tbox-sizing: border-box;\r\n\t\tbackground-color: map-get($neutral-colors, \"neutral-100\") !important;\r\n\t\t&:hover {\r\n\t\t\tbackground-color: map-get($neutral-colors, \"neutral-200\") !important;\r\n\t\t}\r\n\t}\r\n\t&__settings {\r\n\t\tdisplay: flex;\r\n\t\tflex-direction: column;\r\n\t\tmax-width: 520px;\r\n\t\tbackground-color: map-get($neutral-colors, \"neutral-0\");\r\n\t\tpadding: 24px;\r\n\t}\r\n\t&-builder-text-settings {\r\n\t\tmargin-bottom: 20px;\r\n\t\tborder-bottom: 1px solid map-get($neutral-colors, \"neutral-200\");\r\n\t\t&.active {\r\n\t\t\tpadding-bottom: 20px;\r\n\t\t}\r\n\t}\r\n    &-progress {\r\n        width: 100%;\r\n        max-width: 144px;\r\n        &__graph {\r\n            max-width: 104px;\r\n            max-height: 32px;\r\n        }\r\n    }\r\n    &-performance {\r\n        background-color: map-get($neutral-colors, 'neutral-0');\r\n        padding-bottom: 22px;\r\n        margin-top: 24px;\r\n        &__graph {\r\n            padding: 0px 28px;\r\n        }\r\n        &__header {\r\n            margin: 0px 20px 36px;\r\n        }\r\n        &__title {\r\n            color: map-get($neutral-colors, 'neutral-900');\r\n        }\r\n        &__graph-control {\r\n            margin-top: 12px;\r\n            padding-bottom: 18px;\r\n        }\r\n        &__graph-btn {\r\n            color: map-get($primary-colors, 'green-dark');\r\n            font-weight: 500;\r\n            border-radius: 8px;\r\n            @include typographyStyle(14px, 1.43, 0.84px);\r\n            padding: 10px 20px;\r\n            cursor: pointer;\r\n            &.active, &:hover {\r\n                background-color: map-get($primary-colors, 'green-lighter');\r\n            }\r\n        }\r\n    }\r\n    &-close__content {\r\n        @include positionStyle(absolute, 0px, false, 0px);\r\n        z-index: 999;\r\n        & > .revx-builder-toolbar > div {\r\n            left: auto !important;\r\n            right: calc(100% + 10px);\r\n            top: 0px !important;\r\n        }\r\n    }\r\n    &-list {\r\n        border-bottom-left-radius: 12px;\r\n        border-bottom-right-radius: 12px;\r\n        background-color: map-get($neutral-colors, 'neutral-0');\r\n        padding-bottom: 24px;\r\n        &__content {\r\n            margin: 0 auto;\r\n        }\r\n        &__actions {\r\n            .revx-btn-copy {\r\n                border: none;\r\n                @include buttonColor(map-get($vibrant-colors, 'teal-lighter'), false, false, map-get($vibrant-colors, 'teal-base'), true);\r\n                @include buttonHoverColor(map-get($vibrant-colors, 'teal-base'), map-get($neutral-colors, 'neutral-0'), false,true, true);\r\n            }\r\n            .revx-edit-btn {\r\n                background-color: map-get($vibrant-colors, 'purple-lighter');\r\n                svg {\r\n                    stroke: map-get($vibrant-colors, 'purple-base');\r\n                }\r\n            }\r\n            .revx-btn-lineChart {\r\n                border: none;\r\n                @include buttonColor(map-get($vibrant-colors, 'yellow-lighter'), false, false, map-get($vibrant-colors, 'yellow-base'), true);\r\n                @include buttonHoverColor( map-get($vibrant-colors, 'yellow-base'), map-get($neutral-colors, 'neutral-0'), false, true, true);\r\n                &.active {\r\n                    color: map-get($neutral-colors, 'neutral-0');\r\n                    border-color: map-get($vibrant-colors, 'yellow-base');\r\n                    background: map-get($vibrant-colors, 'yellow-base');\r\n                    svg path {\r\n                        stroke: map-get($neutral-colors, 'neutral-0');\r\n                    }\r\n                }\r\n            }\r\n        }\r\n        tr:not(.revx-campaign-table__row) {\r\n            td {\r\n                padding-top: 0px !important;\r\n            }\r\n        }\r\n        .revx-campaign-table thead {\r\n            background-color: map-get($neutral-colors, 'neutral-0');\r\n            position: sticky;\r\n            top: 0;\r\n            z-index: 99;\r\n        }\r\n        .revx-pagination-container {\r\n            width: 95%;\r\n        }\r\n    }\r\n    &-page {\r\n        .revx-input-field.revx-input-overlay {\r\n            width: 100%;\r\n        }\r\n        .revx-campaign-scroll {\r\n            padding-left: 24px;\r\n            padding-right: 24px;\r\n        }\r\n        .revx-campaign-table__row a,\r\n        .revx-campaign-table__row td,\r\n        .revx-toggle-search .revx-loop-container label {\r\n            color: map-get($neutral-colors, \"neutral-700\");\r\n        }\r\n    }\r\n    .revx-filter-content {\r\n\t\t.revx-navigation-dropdown__option.active {\r\n\t\t\tz-index: 0;\r\n\t\t}\r\n\t}\r\n}\r\n\r\n.revx-toggle-selected-product {\r\n    width: 490px;\r\n    height: fit-content;\r\n    border: 1px solid map-get($neutral-colors, 'neutral-200');\r\n    background: map-get($neutral-colors, 'neutral-0');\r\n    box-shadow: 0 16 40;\r\n    border-radius: 8px;\r\n    @include positionStyle(absolute, 100%, 0px);\r\n    z-index: -1;\r\n    box-shadow: 5px 12px 56px -4px rgb(88 92 95 / 50%);\r\n    visibility: hidden;\r\n    overflow: hidden;\r\n    opacity: 0;\r\n    &__heading {\r\n        padding: 12px 20px;\r\n        border-bottom: 1px solid map-get($neutral-colors, 'neutral-200');\r\n    }\r\n    &__content {\r\n        padding: 12px;\r\n        display: grid;\r\n        grid-template-columns: 1fr 1fr;\r\n        gap: 8px;\r\n        max-height: 141px;\r\n        overflow-x: auto;\r\n        @extend .revx-scrollbar-md;\r\n    }\r\n    &__item {\r\n        padding: 6px;\r\n        border-radius: 23px;\r\n        border: 1px solid map-get($neutral-colors, 'neutral-200');\r\n        &:hover {\r\n            background-color: map-get($neutral-colors, 'neutral-200');\r\n            a svg {\r\n                background-color: map-get($vibrant-colors, 'orange-base');\r\n                path {\r\n                    stroke: map-get($neutral-colors, 'neutral-0');\r\n                }\r\n            }\r\n        }\r\n    }\r\n    &__view {\r\n        padding: 6px;\r\n        border-radius: 17px;\r\n        cursor: pointer;\r\n        background-color: map-get($neutral-colors, 'neutral-100');\r\n        path {\r\n            stroke: map-get($neutral-colors, 'neutral-500');\r\n        }\r\n    }\r\n    img, &__img {\r\n        width: 32px;\r\n        height: 32px;\r\n        border-radius: 40px;\r\n    }\r\n    .revx-text-ellipsis {\r\n        max-width: 120px;\r\n        display: block;\r\n    }\r\n}\r\n#revx-campaign-graph {\r\n    width: 100% !important;\r\n    height: 250px !important;\r\n}\r\n\r\n.revx-trigger-popup-content {\r\n    position: relative;\r\n    visibility: visible;\r\n    opacity: 1;\r\n}\r\n",".revx-list-filter {\r\n\tborder-top-left-radius: 12px;\r\n\tborder-top-right-radius: 12px;\r\n\tbackground-color: rgba(map-get($neutral-colors,'neutral-200'), $alpha: 0.5);\r\n\tmargin-top: 32px;\r\n\tpadding: 16px;\r\n    &__heading {\r\n\t\tdisplay: flex;\r\n\t\tgap: 8px;\r\n    }\r\n\t&__heading-bulk-action {\r\n        color: map-get($map: $primary-colors, $key:'green-base' );\r\n\t\tborder-radius: 8px;\r\n\t\tborder-color: map-get($map: $primary-colors, $key:'green-base' );\r\n\t\tbackground-color: map-get($map: $primary-colors, $key: 'green-lighter');\r\n\t\tpadding: 10px 20px;\r\n\t}\r\n    .revx-input-field {\r\n        min-width: max-content;\r\n        input {\r\n            color: map-get($neutral-colors, 'neutral-400');\r\n        }\r\n        svg {\r\n            stroke: map-get($neutral-colors, 'neutral-500');\r\n        }\r\n    }\r\n    .revx-select-field__header,\r\n    .revx-select-field__selected-option  {\r\n        color: map-get($neutral-colors, 'neutral-400');\r\n    }\r\n    .revx-list-short {\r\n        width: 176px;\r\n\t\t.revx-select-field__selected-option {\r\n\t\t\tmax-width: 80%;\r\n\t\t\tdisplay: block !important;\r\n\t\t}\r\n    }\r\n    .revx-list-time {\r\n        width: 136px;\r\n    }\r\n    .revx-select-field__arrow-icon {\r\n        position: absolute;\r\n        right: 12px;\r\n    }\r\n    .revx-input-overlay {\r\n        width: 280px;\r\n        min-width: 100%;\r\n        .revx-label-overlay  {\r\n            padding: 0px 8px;\r\n        }\r\n    }\r\n}\r\n\r\n.revx-list-column,\r\n.revx-list-export {\r\n    max-width: 120px;\r\n    position: relative;\r\n    @include typographyStyle(14px, 20px, -0.8px);\r\n    color: map-get($neutral-colors, 'neutral-400');\r\n    background-color: map-get($neutral-colors, 'neutral-0');\r\n    svg, path {\r\n        stroke: map-get($neutral-colors, 'neutral-500');\r\n    }\r\n}\r\n\r\n.revx-list-export {\r\n    border: 1px solid map-get($neutral-colors, 'neutral-300') !important;\r\n}\r\n",".revx-skeleton-container {\r\n    height: 100%;\r\n}\r\n.revx-loading-skeleton {\r\n\t--base-color: #ebebeb;\r\n\t--highlight-color: #f5f5f5;\r\n\t--animation-duration: 1.5s;\r\n\t--animation-direction: normal;\r\n\t--pseudo-element-display: block; /* Enable animation */\r\n\t--gap: 5px;\r\n\tbackground-color: var(--base-color);\r\n\tmargin-bottom: var(--gap);\r\n\twidth: 100%;\r\n\tborder-radius: 0.25rem;\r\n\tdisplay: inline-flex;\r\n\tline-height: inherit;\r\n\tposition: relative;\r\n\tuser-select: none;\r\n\toverflow: hidden;\r\n}\r\n\r\n.revx-loading-skeleton::after {\r\n\tcontent: ' ';\r\n\tdisplay: var(--pseudo-element-display);\r\n\t@include positionStyle(absolute, 0, 0, 0);\r\n\theight: 100%;\r\n\tbackground-repeat: no-repeat;\r\n\tbackground-image: linear-gradient(\r\n\t\t90deg,\r\n\t\tvar(--base-color),\r\n\t\tvar(--highlight-color),\r\n\t\tvar(--base-color)\r\n\t);\r\n\ttransform: translateX(-100%);\r\n\tanimation-name: revx-loading-skeleton;\r\n\tanimation-direction: var(--animation-direction);\r\n\tanimation-duration: var(--animation-duration);\r\n\tanimation-timing-function: ease-in-out;\r\n\tanimation-iteration-count: infinite;\r\n}\r\n\r\n.revx-graph-skeleton {\r\n\tanimation: revx-pulse 2s cubic-bezier(.4,0,.6,1) infinite;\r\n}\r\n\r\n@media (prefers-reduced-motion) {\r\n\t.revx-loading-skeleton {\r\n\t\t--pseudo-element-display: none; /* Disable animation */\r\n\t}\r\n}\r\n\r\n.revx-top-campaign, .revx-conversion-info {\r\n    .revx-loading-skeleton {\r\n        margin-bottom: 0px;\r\n    }\r\n    .revx-skeleton-container {\r\n        width: unset !important;\r\n    }\r\n}\r\n\r\n@keyframes revx-loading-skeleton {\r\n\t100% {\r\n\t\ttransform: translateX(100%);\r\n\t}\r\n}\r\n\r\n@keyframes revx-pulse {\r\n\t50% {\r\n        opacity: .5;\r\n    }\r\n}",".revx-color-picker {\r\n\tborder-radius: 4px;\r\n\tbackground-color: map-get($neutral-colors, 'neutral-900');\r\n    padding: 12px;\r\n\t.react-colorful {\r\n\t\tgap: 12px;\r\n\t\theight: 184px;\r\n\t\tbox-sizing: border-box;\r\n\t\t&__last-control {\r\n\t\t\tborder-radius: 0px;\r\n\t\t}\r\n\t\t&__saturation {\r\n\t\t\tborder-radius: 0px;\r\n\t\t\tborder: 0px !important;\r\n\t\t}\r\n\t\t&__hue,&__alpha {\r\n\t\t\theight: 12px;\r\n\t\t\tborder-radius: 5px;\r\n\t\t}\r\n\t\t&__pointer {\r\n\t\t\theight: 8px;\r\n\t\t\twidth: 8px;\r\n\t\t\tborder-radius: 50%;\r\n\t\t\tborder: 2px solid map-get($neutral-colors, 'neutral-0');\r\n\t\t\tbox-sizing: content-box;\r\n\t\t\tbox-shadow: 0px 4px 6px 0px #1F29371A;\r\n\t\t\tbackground-color: transparent;\r\n\t\t}\r\n\t}\r\n\t&__option {\r\n\t\tmargin-top: 12px;\r\n\t\tposition: relative;\r\n\t\t& > svg {\r\n\t\t\twidth: 28px;\r\n\t\t\theight: 28px;\r\n\t\t\tcursor: pointer;\r\n\t\t\tbox-sizing: border-box;\r\n\t\t\tborder-radius: 4px;\r\n\t\t\tflex-shrink: 0;\r\n\t\t\tbackground-color: map-get($neutral-colors, 'neutral-700');\r\n\t\t\tpadding: 6px;\r\n\t\t\t\r\n\t\t}\r\n\t\t&.copied {\r\n\t\t\tinput {\r\n\t\t\t\tcolor: transparent !important;\r\n\t\t\t}\r\n\t\t}\r\n\t\t&__reset {\r\n\t\t\tpath {\r\n\t\t\t\tfill: map-get($primary-colors, 'green-base') !important;\r\n\t\t\t}\r\n\t\t}\r\n\t\t&__color-visibility {\r\n\t\t\t& > span {\r\n\t\t\t\tcolor: map-get($neutral-colors, 'neutral-0');\r\n\t\t\t\tposition: absolute;\r\n\t\t\t\tleft: 7px;\r\n\t\t\t}\r\n\t\t\t& > input {\r\n\t\t\t\twidth: 100%;\r\n\t\t\t\tcolor: map-get($neutral-colors, 'neutral-0');\r\n\t\t\t\tdisplay: block;\r\n\t\t\t\tborder: 1px solid transparent;\r\n\t\t\t\tborder-radius: 4px;\r\n\t\t\t\tbox-sizing: border-box;\r\n\t\t\t\tbackground-color: map-get($neutral-colors, 'neutral-700');\r\n\t\t\t\tpadding: 5px 5px 5px 36px;\r\n\t\t\t\t&:focus {\r\n\t\t\t\t\toutline: 0px;\r\n\t\t\t\t\tborder-color: map-get($primary-colors, 'green-base');\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n}\r\n\r\n.revx-color-container .revx-color-picker {\r\n\tmax-width: min-content;\r\n}",".revx-filter-dateRanges {\r\n    &__label {\r\n        cursor: pointer;\r\n        color: map-get($neutral-colors, 'neutral-400');\r\n        height: 100%;\r\n        width: 20px;\r\n        border-radius: 0px 8px 8px 0;\r\n        border-left: 1px solid map-get($neutral-colors, 'neutral-300');\r\n        background: map-get($neutral-colors, 'neutral-0');\r\n        padding: 0px 10px;\r\n        margin-left: 16px;\r\n        position: absolute;\r\n        right: 0;\r\n        z-index: 1;\r\n        path {\r\n            stroke: map-get($neutral-colors, 'neutral-300');\r\n        }\r\n    }\r\n    &__input-container {\r\n        & > span {\r\n            svg, svg path {\r\n                stroke: map-get($neutral-colors, 'neutral-300');\r\n            }\r\n        }\r\n    }\r\n    &__input-container {\r\n        display: none !important;\r\n        gap: 6px;\r\n    }\r\n    &__custom-label {\r\n        animation: LabelAnimationIn 1s;\r\n        color: map-get($neutral-colors, 'neutral-400');\r\n    }\r\n    &__content {\r\n        height: 40px;\r\n        width: 132px;\r\n        align-items: stretch;\r\n        border-radius: 8px;\r\n        box-sizing: border-box;\r\n        border: 1px solid map-get($neutral-colors, 'neutral-300');\r\n        background-color: map-get($neutral-colors, 'neutral-0');\r\n        margin: 0 auto;\r\n        padding-left: 16px;\r\n        transition: 1s;\r\n        transition: width 1s ease-in-out;\r\n        position: relative;\r\n        &:focus-within {\r\n            border-color: map-get($primary-colors, 'green-base');\r\n        }\r\n        input {\r\n            color: map-get($neutral-colors, 'neutral-400');\r\n            width: auto;\r\n            height: 100%;\r\n            min-width: 0px !important;\r\n            max-width: 83px;\r\n            border: 0px;\r\n            outline: 0px;\r\n            border-radius: 0px;\r\n            border-top-left-radius: 12px;\r\n            border-bottom-left-radius: 12px;\r\n            padding: 0px !important;\r\n            margin: 0px !important;\r\n            animation: LabelAnimationOut 5s;\r\n            &:focus {\r\n                outline: 0px;\r\n                border-width: 0px;\r\n                box-shadow: none;\r\n            }\r\n        }\r\n        & > svg {\r\n            cursor: pointer;\r\n            height: 20px;\r\n            width: 20px;\r\n        }\r\n    }\r\n    &__width-full {\r\n        width: 286px;\r\n        transition: all 1s ease-in-out;\r\n        span {\r\n            display: flex;\r\n        }\r\n        input {\r\n            display: block;\r\n            animation: LabelAnimationIn 1s;\r\n        }\r\n        .revx-filter-dateRanges__input-container {\r\n            display: flex !important;\r\n            gap: 16px;\r\n        }\r\n        .revx-filter-dateRanges__custom-label {\r\n            display: none !important;\r\n        }\r\n    }\r\n}\r\n\r\n@keyframes LabelAnimationIn {\r\n    0% { \r\n        opacity: 0;\r\n    }\r\n    100% { \r\n        opacity: 1;\r\n    }\r\n}\r\n\r\n@keyframes LabelAnimationOut {\r\n    0% { \r\n        opacity: 1;\r\n    }\r\n    100% { \r\n        opacity: 0;\r\n        display: none;\r\n    }\r\n}","\r\n.revx-pagination-container {\r\n    width: 100%;\r\n    max-width: 1488px;\r\n    margin: 0 auto;\r\n    padding: 32px 0px 24px;\r\n    .revx-list-pagination {\r\n        svg {\r\n            cursor: pointer;\r\n        }\r\n        button {\r\n            cursor: pointer;\r\n            color: map-get($neutral-colors, 'neutral-500');\r\n            @include typographyStyle(14px, 20px, -0.8px, 500);\r\n            width: 32px;\r\n            height: 32px;\r\n            border-radius: 8px;\r\n            border: 1px solid map-get($neutral-colors, 'neutral-300');\r\n            background-color: map-get($neutral-colors, 'neutral-0');\r\n            &:hover, &.active {\r\n                color: map-get($primary-colors, 'green-base');\r\n                border-color: map-get($primary-colors, 'green-base');\r\n                background-color: map-get($primary-colors, 'green-lighter');\r\n            }\r\n            &.revx-btn-more {\r\n                @include flexStyle(center, flex-end);\r\n            }\r\n        }\r\n    }\r\n}\r\n\r\n// Show Result Dropdown\r\n.revx-show-result {\r\n    &__heading {\r\n        color: map-get($neutral-colors, 'neutral-500');\r\n    }\r\n    .revx-select-field {\r\n        width: 100%;\r\n        max-width: 62px;\r\n\t\t@include typographyStyle(14px, 20px, -0.8px, 500);\r\n        &__header {\r\n            height: 32px;\r\n            width: fit-content;\r\n        }\r\n    }\r\n}","\r\n// Single Item Details Style\r\n.revx-details {\r\n    width: 100%;\r\n    max-width: 1488px;\r\n    box-sizing: border-box;\r\n    border-top-left-radius: 8px;\r\n    border-top-right-radius: 8px;\r\n    background-color: map-get($neutral-colors, 'neutral-100');\r\n    margin: 0 auto;\r\n    padding: 16px;\r\n    &__trend-down path {\r\n        fill: map-get($vibrant-colors, 'red-base');\r\n        stroke: map-get($vibrant-colors, 'red-base');\r\n    }\r\n    &__trend-up path {\r\n        fill: map-get($primary-colors, 'green-base');\r\n        stroke: map-get($primary-colors, 'green-base');\r\n    }\r\n    &__header {\r\n        border-radius: 4px;\r\n        background-color: map-get($neutral-colors, 'neutral-0');\r\n        padding: 16px 20px;\r\n        h4 {\r\n            color: map-get($neutral-colors, 'neutral-900');\r\n        }\r\n    }\r\n    &__breadcrumb {\r\n        margin-top: 8px;\r\n        & > div {\r\n            color: map-get($neutral-colors, 'neutral-500');\r\n\t\t\ttext-transform: capitalize;\r\n            @include flexStyle(flex-start, center);\r\n            @include typographyStyle(14px, 20px, -0.8px);\r\n            &:not(:last-child):after {\r\n                content: \"\";\r\n                height: 6px;\r\n                width: 6px;\r\n                display: block;\r\n                background-color: map-get($neutral-colors, 'neutral-300');\r\n                border-radius: 10px;\r\n                margin: 0px 12px;\r\n            }\r\n        }\r\n    }\r\n    &__layout {\r\n        display: grid;\r\n        row-gap: 24px;\r\n        column-gap: 16px;\r\n        grid-template-columns:  repeat(4, 1fr);\r\n        margin-top: 24px;\r\n    }\r\n    &__card {\r\n        @include flexStyle(space-between, false);\r\n        gap: 10px;\r\n        width: 100%;\r\n        max-width: 351px;\r\n        border-radius: 4px;\r\n        box-sizing: border-box;\r\n        background-color: map-get($neutral-colors, 'neutral-0');\r\n        padding: 16px 20px;\r\n    }\r\n\t&-actions {\r\n\t\tdisplay: grid;\r\n\t\tgrid-template-columns: repeat(4, 1fr);\r\n\t\trow-gap: 24px;\r\n\t\tcolumn-gap: 16px;\r\n\t\tmargin-top: 24px;\r\n\t}\r\n    &__action {\r\n        height: auto !important;\r\n    }\r\n    &-heading, &__action label {\r\n        color: map-get($neutral-colors, 'neutral-700');\r\n    }\r\n    &-subheading, &__action.toggled label {\r\n        color: map-get($neutral-colors, 'neutral-400');\r\n    }\r\n    \r\n    &-performance-graph {\r\n        height: 392px;\r\n        width: 100%;\r\n        background-color: map-get($neutral-colors, \"neutral-0\");\r\n    }\r\n}",'\r\n.revx-trigger-product {\r\n\th4 {\r\n\t\tcolor: map-get($neutral-colors, \'neutral-900\');\r\n\t\tmargin-bottom: 24px;\r\n\t}\r\n\t&-grid {\r\n\t\tdisplay: grid;\r\n\t\tgrid-template-columns: 1fr 1fr;\r\n\t\tgap: 12px;\r\n\t\tmargin-top: 20px;\r\n\t}\r\n\t&__title {\r\n\t\tcolor: map-get($neutral-colors, "neutral-900");\r\n\t\tmargin-bottom: 12px;\r\n\t}\r\n\t&__group {\r\n\t\t& > div {\r\n\t\t\twidth: 100%;\r\n\t\t\tgap: 8px;\r\n\t\t}\r\n\t\t.revx-btn-delete {\r\n\t\t\tflex-shrink: 0;\r\n\t\t}\r\n\t}\r\n\t&__select {\r\n\t\tmax-width: 220px;\r\n\t\tflex-shrink: 2;\r\n\t}\r\n\t&__select-restricted {\r\n\t\tmax-width: 220px;\r\n\t}\r\n\t&__inline-switch {\r\n\t\tgap: 8px;\r\n\t\tbox-sizing: border-box;\r\n\t\tborder-radius: 8px;\r\n\t\tmargin-top: 16px;\r\n\t\tborder: 1px solid map-get($neutral-colors, "neutral-200");\r\n\t\tpadding: 4px 4px 4px 12px;\r\n\t}\r\n\t&__required-btn {\r\n\t\tmargin-top: 20px;\r\n\t}\r\n\t&__exclude-items,\r\n\t&__bxgy-quantity {\r\n\t\tmargin-top: 24px;\r\n\t}\r\n\t&__bxgy-quantity {\r\n\t\t.revx-bxgy-quantity-item {\r\n\t\t\tborder-radius: 8px;\r\n\t\t\talign-items: stretch !important;\r\n\t\t\tborder: 1px solid map-get($neutral-colors, "neutral-200");\r\n\t\t\tbackground-color: map-get($neutral-colors, "neutral-100");\r\n\t\t\timg {\r\n\t\t\t\theight: 32px;\r\n\t\t\t\twidth: 32px;\r\n\t\t\t\tborder-radius: 40px;\r\n\t\t\t\tmargin-left: 4px;\r\n\t\t\t}\r\n\t\t\t&__title {\r\n\t\t\t\tcolor: map-get($neutral-colors, "neutral-700");\r\n\t\t\t\tmax-width: 101px;\r\n\t\t\t\tdisplay: block;\r\n\t\t\t}\r\n\t\t}\r\n\t\t.revx-bxgy-quantity-select {\r\n\t\t\tmax-width: 84px;\r\n\t\t}\r\n\t}\r\n\t.revx-cmp-id-input {\r\n\t\tmax-width: 244px;\r\n\t}\r\n\t.revx-mix-match-initial-product-selection {\r\n\t\tmargin-top: 20px;\r\n\t}\r\n\t.revx-add-trigger {\r\n\t\tsvg {\r\n\t\t\theight: 16px;\r\n\t\t\twidth: 16px;\r\n\t\t}\r\n\t}\r\n\t.revx-trigger-product__mix_match-grid {\r\n\t\t.revx-bxgy-quantity-item {\r\n\t\t\tjustify-content: flex-start;\r\n\t\t}\r\n\t}\r\n\t.revx-bxgy-quantity-item {\r\n\t\t&__product-content {\r\n\t\t\tpadding: 4px;\r\n\t\t}\r\n\t}\r\n\t.revx-bxgy-quantity-item__checkbox {\r\n\t\tpadding: 0px 14px;\r\n\t\tdisplay: flex;\r\n\t\tborder-right: 1px solid map-get($neutral-colors, "neutral-200");\r\n\t}\r\n}',".revx-dashboard-filter {\r\n    gap: 24px;\r\n    margin: 30px auto 30px;\r\n    &__header {\r\n        h2 {\r\n            color: map-get($neutral-colors, 'neutral-900');\r\n        }\r\n    }\r\n    &__title {\r\n        color: map-get($neutral-colors, 'neutral-900');\r\n    }\r\n    &__subtitle {\r\n        color: map-get($neutral-colors, 'neutral-400');\r\n        margin-top: 4px;\r\n    }\r\n    &__actions {\r\n        .revx-dashboard-buttonGroup {\r\n            button {\r\n                border: none;\r\n                text-wrap: nowrap;\r\n                color: map-get($neutral-colors, 'neutral-400');\r\n                font-weight: 500;\r\n                background-color: transparent;\r\n                &:hover, &.active {\r\n                    color: map-get($primary-colors, 'green-dark');\r\n                    background-color: map-get($primary-colors, 'green-lighter');\r\n                }\r\n            }\r\n        }\r\n    }\r\n    &__export {\r\n        position: relative;\r\n        &-content {\r\n            width: 164px;\r\n            border-radius: 8px;\r\n            border: 1px solid map-get($neutral-colors, 'neutral-200' );\r\n            box-shadow: 0px 16px 32px -12px #585C5F1A;\r\n            background-color: map-get($neutral-colors, 'neutral-0');\r\n            padding: 3px;\r\n            @include positionStyle(absolute, calc(100% + 2px), false, 0px);\r\n            display: block;\r\n        }\r\n        &-item {\r\n            cursor: pointer;\r\n            color: map-get($neutral-colors, 'neutral-400');\r\n            white-space: nowrap;\r\n            border-radius: 4px;\r\n            padding: 8px 12px;\r\n            &:hover {\r\n                color: map-get($neutral-colors, 'neutral-900');\r\n                background-color: map-get($neutral-colors, 'neutral-100');\r\n            }\r\n            svg {\r\n                stroke: map-get($neutral-colors, 'neutral-500');\r\n            }\r\n        }\r\n        .revx-list-export {\r\n            flex-shrink: 0;\r\n        }\r\n    }\r\n    .revx-filter-date {\r\n        max-width: 163px;\r\n        .revx-input-field {\r\n            input {\r\n                border-color: map-get($neutral-colors, 'neutral-300');\r\n            }\r\n        }\r\n    }\r\n    .revx-filter-select {\r\n        max-width: 212px;\r\n        .revx-select-field__header {\r\n            border-color: map-get($neutral-colors, 'neutral-300');\r\n        }\r\n    }\r\n}",".revx-dashboard-info {\r\n    margin-bottom: 40px;\r\n    &__container {\r\n        display: grid;\r\n        gap: 24px;\r\n        grid-template-columns: 1.05fr 2fr;\r\n    }\r\n    &__status-up {\r\n        color: map-get($primary-colors, 'green-base');\r\n        svg, path {\r\n            stroke: map-get($primary-colors, 'green-base');\r\n        }\r\n    }\r\n    &__title {\r\n        text-align: center;\r\n        margin-top: 52px !important;\r\n    }\r\n    &__title,\r\n    &__subtitle {\r\n        color: map-get($neutral-colors, 'neutral-700');\r\n    }\r\n    &__status-down {\r\n        color: map-get($vibrant-colors, 'red-base');\r\n        svg, svg path {\r\n            stroke: map-get($vibrant-colors, 'red-base') !important;\r\n        }\r\n    }\r\n    &__element {\r\n        width: 100%;\r\n        box-sizing: border-box;\r\n        border-radius: 12px;\r\n        background-color: map-get($neutral-colors, 'neutral-0');\r\n        overflow: hidden;\r\n        &-content {\r\n            padding: 20px 24px 0px 24px;\r\n        }\r\n        &-text-content {\r\n            margin-top: 12px;\r\n        }\r\n        .revx-dashboard-info__subtitle {\r\n            color: map-get($neutral-colors, 'neutral-900');\r\n        }\r\n    }\r\n    &__left-content {\r\n        display: grid;\r\n        grid-template-columns: 1fr 1fr;\r\n        gap: 24px;\r\n        .revx-dashboard-info__title {\r\n            margin: 0px !important;\r\n        }\r\n    }\r\n    &__status-down,\r\n    &__status-up {\r\n        justify-content: center;\r\n        .revx-skeleton-container {\r\n            width: fit-content !important;\r\n        }\r\n    }\r\n    &__sales {\r\n        width: 100%;\r\n        max-width: 520px;\r\n        padding: 0px !important;\r\n        display: flex;\r\n        justify-content: space-between;\r\n        flex-direction: column;\r\n        &-content {\r\n            padding: 20px 24px 24px;\r\n        }\r\n        .revx-dashboard-info__status-down,\r\n        .revx-dashboard-info__status-up {\r\n            margin-top: 16px;\r\n        }\r\n    }\r\n    &__order .revx-dashboard-info__title {\r\n        color: map-get($vibrant-colors, 'purple-base');\r\n    }\r\n    &__impression .revx-dashboard-info__title {\r\n        color: map-get($vibrant-colors, 'blue-base');\r\n    }\r\n    &__order-value .revx-dashboard-info__title {\r\n        color: map-get($primary-colors, 'green-base');\r\n    }\r\n    &__total-order .revx-dashboard-info__title {\r\n        color: map-get($vibrant-colors, 'blue-base');\r\n    }\r\n    &__conversion-rate .revx-dashboard-info__title {\r\n        color: map-get($primary-colors, 'green-base');\r\n    }\r\n}",'body.revx-is-fullscreen-mode {\r\n\t#wpcontent {\r\n\t\tpadding-left: 0;\r\n\t}\r\n\t#wpbody-content {\r\n\t\tpadding-bottom: 0;\r\n\t}\r\n}\r\n\r\nbody.revx-is-fullscreen-mode,\r\nbody.revx-is-fullscreen-mode #wpfooter,\r\nbody.revx-is-fullscreen-mode\r\n\t#wpbody-content\r\n\t> div:not(#revenue-root):not(#screen-meta) {\r\n\tdisplay: none;\r\n}\r\n\r\n.revx-trigger-search {\r\n\tflex-grow: 1;\r\n}\r\n\r\n.revx-nav-campaign-type {\r\n\tcolor: map-get($neutral-colors, "neutral-700");\r\n\ttext-transform: capitalize;\r\n}\r\n\r\n.revx-bundle-offer-label {\r\n\tline-height: 1.4;\r\n\twhite-space: nowrap;\r\n}\r\n\r\n.revx-goal,\r\n.revx-rewardType,\r\n.revx-schedule,\r\n.revx-content-formatting {\r\n\tcolor: map-get($neutral-colors, "neutral-500");\r\n\t&__title {\r\n\t\tcolor: map-get($neutral-colors, "neutral-900");\r\n\t\tmargin-bottom: 12px;\r\n\t}\r\n}\r\n\r\n.revx-campaign-info .revx-input-container {\r\n\tflex-direction: column;\r\n\talign-items: flex-start;\r\n\tgap: 12px;\r\n}\r\n\r\n.revx-breadcrumb-item {\r\n\ttext-transform: capitalize;\r\n}\r\n\r\n.revx-campaignTitle-content {\r\n\tdisplay: flex;\r\n\tflex-direction: column;\r\n\tgap: 16px;\r\n}\r\n\r\n/*====================================\r\n    Additional Settings\r\n====================================*/\r\n.revx-additional-setting {\r\n\t&:first-child {\r\n\t\tmargin-top: 4px;\r\n\t}\r\n\t&:not(:last-child) {\r\n\t\tmargin-bottom: 20px;\r\n\t}\r\n}\r\n\r\n/*====================================\r\n    Content Formatting\r\n====================================*/\r\n.revx-content-formatting {\r\n\tmargin-bottom: 16px;\r\n\t&__message-status {\r\n\t\tdisplay: grid;\r\n\t\tgrid-template-columns: 192px auto;\r\n\t\tcolumn-gap: 16px;\r\n\t\t& > div {\r\n\t\t\tmargin-bottom: 16px;\r\n\t\t}\r\n\t}\r\n\t&__field-group {\r\n\t\t.revx-component-toggle {\r\n\t\t\tmargin-top: 4px;\r\n\t\t\tmargin-bottom: 20px;\r\n\t\t}\r\n\t\t&:not(:last-child) {\r\n\t\t\tborder-bottom: 1px solid map-get($neutral-colors, "neutral-200");\r\n\t\t\tpadding-bottom: 24px;\r\n\t\t\tmargin-bottom: 30px;\r\n\t\t}\r\n\t}\r\n\t&__label {\r\n\t\tmargin-bottom: 8px !important;\r\n\t}\r\n\t&__toggle-label {\r\n\t\tcolor: map-get($neutral-colors, "neutral-700");\r\n\t}\r\n\t&__product {\r\n\t\tdisplay: grid;\r\n\t\tgrid-template-columns: 296px 1fr 1fr 238px;\r\n\t\tgap: 16px;\r\n\t}\r\n}\r\n\r\n/*====================================\r\n    Offered Product Drag and Drop\r\n====================================*/\r\n.drag-sort-active {\r\n\tbackground: transparent;\r\n\tcolor: transparent;\r\n\tborder: 1px solid #4ca1af;\r\n}\r\n.drag-sort-active {\r\n\tbackground: transparent;\r\n\tcolor: transparent;\r\n}\r\n.placeholder {\r\n\theight: 50px; /* Adjust according to your row height */\r\n\tborder: 2px dashed #ccc;\r\n\tmargin: 10px 0; /* Adjust based on your spacing */\r\n}\r\n.dragging {\r\n\tborder: 2px solid #007bff; /* Highlight with a blue border */\r\n\tbackground-color: #e9f7ff; /* Light blue background */\r\n\topacity: 1; /* Ensure it\'s fully visible */\r\n}\r\n\r\n/*====================================\r\n    Time Schedule Settings\r\n====================================*/\r\n.revx-countdown-timer .revx-group-input {\r\n\tmargin-bottom: 20px;\r\n}\r\n\r\n.revx-schedule-end-date-time {\r\n\tdisplay: flex;\r\n\tflex-direction: column;\r\n\tgap: 12px;\r\n}\r\n\r\n.revx-time-schedule {\r\n\t&.revx-accordion {\r\n\t\t.revx-campaign-card__pro-tag {\r\n\t\t\tposition: relative !important;\r\n\t\t\ttop: auto;\r\n\t\t}\r\n\t\t.revx-accordion-content {\r\n\t\t\tdisplay: flex;\r\n\t\t\tgap: 20px;\r\n\t\t\tflex-direction: column;\r\n\t\t}\r\n\t}\r\n\t.revx-date-container.revx-date-dropdown.react-datepicker__input-container\r\n\t\tinput {\r\n\t\t@include typographyStyle(12px !important, 16px, -0.08px);\r\n\t}\r\n\t.revx-select-field__header {\r\n\t\tpadding: 0px 12px;\r\n\t}\r\n\t.revx-select-field:focus .revx-field-disabled {\r\n\t\toutline: none;\r\n\t}\r\n\t.revx-select-field__arrow-icon svg {\r\n\t\theight: 20px !important;\r\n\t\twidth: 20px !important;\r\n\t}\r\n\t.revx-date-container.revx-date-dropdown\r\n\t\t.react-datepicker__input-container\r\n\t\tsvg\r\n\t\tpath {\r\n\t\tstroke: map-get($neutral-colors, "neutral-400");\r\n\t}\r\n\t.revx-field-disabled .react-datepicker__input-container svg path {\r\n\t\tstroke: map-get($neutral-colors, "neutral-300") !important;\r\n\t}\r\n}\r\n\r\n/*=========  Delete Button Style  =========*/\r\n.revx-campaign-header {\r\n\t&__file-dropdown {\r\n\t\tposition: relative;\r\n\t\tdisplay: none;\r\n\t}\r\n\t&__file-dropdown-content {\r\n\t\twidth: 282px;\r\n\t\twhite-space: nowrap;\r\n\t\tbox-sizing: border-box;\r\n\t\tborder-radius: 8px;\r\n\t\tborder: 1px solid map-get($neutral-colors, "neutral-200");\r\n\t\tbackground-color: map-get($neutral-colors, "neutral-0");\r\n\t\tpadding: 16px;\r\n\t\t@include positionStyle(absolute, calc(100% + 8px), 0px);\r\n\t\t.revx-campaign-info {\r\n\t\t\tflex-direction: column;\r\n\t\t}\r\n\t}\r\n\t&__file-dropdown-btn {\r\n\t\tborder: none;\r\n\t\tcolor: map-get($neutral-colors, "neutral-700");\r\n\t\tbackground-color: map-get($neutral-colors, "neutral-100");\r\n\t}\r\n}\r\n\r\n/*==================  Delete Button Style  ==================*/\r\n.revx-btn-delete {\r\n\tborder: none;\r\n\t@include buttonColor(\r\n\t\tmap-get($vibrant-colors, "red-lighter"),\r\n\t\tmap-get($vibrant-colors, "red-base"),\r\n\t\tfalse,\r\n\t\tmap-get($vibrant-colors, "red-base"),\r\n\t\ttrue\r\n\t);\r\n\t@include buttonHoverColor(\r\n\t\tmap-get($vibrant-colors, "red-base"),\r\n\t\tmap-get($neutral-colors, "neutral-0"),\r\n\t\tfalse,\r\n\t\ttrue,\r\n\t\ttrue\r\n\t);\r\n}\r\n/*==================  Edit Button Style  ==================*/\r\n.revx-btn-edit {\r\n\tborder: 0px;\r\n\t@include buttonColor(\r\n\t\tmap-get($vibrant-colors, "purple-lighter"),\r\n\t\tmap-get($vibrant-colors, "purple-base"),\r\n\t\tfalse,\r\n\t\tmap-get($vibrant-colors, "purple-base"),\r\n\t\ttrue\r\n\t);\r\n\t@include buttonHoverColor(\r\n\t\tmap-get($vibrant-colors, "purple-base"),\r\n\t\tmap-get($neutral-colors, "neutral-0"),\r\n\t\tfalse,\r\n\t\ttrue,\r\n\t\ttrue\r\n\t);\r\n}\r\n\r\n/*==================  Label Common Style  ==================*/\r\n.revx-label-container {\r\n\tcolor: map-get($neutral-colors, "neutral-900");\r\n\tmargin-bottom: 12px; // Suggested from JOS\r\n\tlabel {\r\n\t\tgap: 4px;\r\n\t\tspan {\r\n\t\t\tcolor: map-get($vibrant-colors, "red-base");\r\n\t\t}\r\n\t}\r\n}\r\n\r\n\r\n// Free Shipping Bar\r\n\r\n.revx-free-shipping-bar-goal {\r\n\tposition: relative;\r\n\r\n\t.revx-close-icon{\r\n\t\tposition: absolute;\r\n\t\tright: 0;\r\n\t\ttop: 0;\r\n\t}\r\n\r\n\t.revx-spg-up-slider {\r\n\t\tpadding-bottom: 0px;\r\n\t}\r\n\r\n\t.revx-spg-up-slider__button:hover{\r\n\t\tcolor: var(--revx-hover-color);\r\n\t}\r\n\r\n\t&.top,&.bottom {\r\n\t\t.revx-spg-up-slider {\r\n\t\t\tpadding-top: 12px;\r\n\t\t}\r\n\t}\r\n\r\n\t.revx-spg-drawer-details {\r\n\t\tmargin-left: 16px;\r\n\t}\r\n\r\n\t.revx-spg-drawer-open {\r\n\t\tgap: 0px;\r\n\t}\r\n}\r\n\r\n\r\n\r\n',".toplevel_page_revenue {\r\n\t#revenue-root {\r\n\t\tmargin-bottom: 75px;\r\n\t\tbackground-color: map-get($neutral-colors, 'neutral-100');\r\n\t}\r\n}\r\n\r\n/*============== Filter ======================*/\r\n.revx-filter {\r\n    &-title {\r\n        margin-right: 29px;\r\n        text-transform: capitalize;\r\n    }\r\n    &-content svg {\r\n        height: 24px;\r\n        width: 24px;\r\n        path {\r\n            stroke: map-get($neutral-colors, 'neutral-700');\r\n        }\r\n    }\r\n    &-input {\r\n        .rvs-others-field:last-child {\r\n            width: 100%;\r\n            max-width: 341px;\r\n        }\r\n    }\r\n}\r\n\r\n.revx-campaign-filter {\r\n    margin-top: 30px;\r\n    margin-bottom: 30px;\r\n    &__label label {\r\n        color: map-get($neutral-colors, 'neutral-900');\r\n        @include typographyStyle(16px, 1.5, 0.96px);\r\n    }\r\n    &__save-data {\r\n        border: 1px solid map-get($neutral-colors, 'neutral-400');\r\n        padding: 8px 8px 8px 10px;\r\n        border-radius: 8px;\r\n    }\r\n    .revx-navigation-dropdown__option.active {\r\n        background-color: map-get($neutral-colors, 'neutral-200') !important;\r\n    }\r\n}\r\n\r\n/*============== campaign performing ======================*/\r\n.revx-performing-campaign {\r\n    margin: 40px 0px !important;\r\n    border-radius: 12px;\r\n    .revx-campaign-table  {\r\n        margin-top: 15px;\r\n    }\r\n}\r\n\r\n/*============== Recent Order ======================*/\r\n.revx-recent-order {\r\n    margin-top: 40px;\r\n    border-radius: 12px;\r\n    .revx-heading--h5 {\r\n        color: map-get($neutral-colors, 'neutral-900');\r\n        margin-bottom: 12px;\r\n    }\r\n    .revx-status {\r\n        &-completed,\r\n        &-cancel,\r\n        &-pending {\r\n            padding: 4px 8px;\r\n            border-radius: 4px;\r\n            box-sizing: border-box;\r\n            display: block;\r\n            text-align: center;\r\n            text-transform: capitalize;\r\n            width: fit-content;\r\n        }\r\n        &-completed {\r\n            color: map-get($primary-colors, 'green-base');\r\n            background-color: map-get($primary-colors, 'green-lighter');\r\n        }\r\n        &-cancel {\r\n            color: map-get($vibrant-colors, 'red-base');\r\n            background-color: map-get($vibrant-colors, 'red-lighter');\r\n        }\r\n        &-pending,  &-on-hold {\r\n            color: map-get($vibrant-colors, 'yellow-base');\r\n            background-color: map-get($vibrant-colors, 'yellow-lighter');\r\n            text-transform: capitalize;\r\n            width: fit-content;\r\n            padding: 4px 8px;\r\n            box-sizing: border-box;\r\n            border-radius: 4px;\r\n        }\r\n    }\r\n}\r\n\r\n.revx-performing-campaign,\r\n.revx-recent-order {\r\n    padding: 20px 24px 0px;\r\n}\r\n\r\n/*================ Dashboard Row ====================*/\r\n.revx-dashboard-row {\r\n    display: grid;\r\n    grid-template-columns: 2.1fr 1fr;\r\n    gap: 24px;\r\n    .revx-dashboard-sidebar {\r\n        max-width: 484px;\r\n        width: 100%;\r\n    }\r\n    .revx-dashboard-content {\r\n        width: 100%;\r\n        max-width: 1028px;\r\n        overflow: overlay;\r\n        .revx-section-container {\r\n            padding: 0px !important;\r\n        }\r\n    }\r\n}\r\n\r\n/*================ Conversion Info ====================*/\r\n.revx-conversion-info {\r\n    margin-bottom: 40px;\r\n    &__title {\r\n        color: map-get($neutral-colors, 'neutral-700');\r\n    }\r\n    .revx-empty-chartData {\r\n        position: absolute;\r\n        color: map-get($neutral-colors, 'neutral-700');\r\n        @include typographyStyle(16px, 1.5, 0.96px);\r\n        font-weight: 500;\r\n    }\r\n}\r\n\r\n/*================ Top Campaign ====================*/\r\n.revx-top-campaign {\r\n    border-radius: 12px;\r\n    &__title {\r\n        color: map-get($neutral-colors, 'neutral-700');\r\n    }\r\n    table {\r\n        width: 100%;\r\n        text-align: left;\r\n        th {\r\n            padding-bottom: 16px;\r\n        }\r\n        tr {\r\n            border-top: 1px solid map-get($neutral-colors, 'neutral-200');\r\n            &:last-child {\r\n                border-bottom: 1px solid map-get($neutral-colors, 'neutral-200');\r\n            }\r\n        }\r\n\t\ttbody tr{\r\n\t\t\t\t&:hover,&.active {\r\n\t\t\t\t\tbackground-color: map-get($neutral-colors, 'neutral-100');\r\n\t\t\t\t\tborder-color: map-get($neutral-colors, 'neutral-200') !important;\r\n\t\t\t\t\tcursor: pointer;\r\n\t\t\t\t}\r\n\r\n\t\t}\r\n        th {\r\n            color: map-get($neutral-colors, 'neutral-400');\r\n            font-weight: 500;\r\n            @include typographyStyle(14px, 24px, 0.96px);\r\n        }\r\n        td {\r\n            color: map-get($neutral-colors, 'neutral-700');\r\n            padding: 20px 20px 20px 8px;\r\n            &:last-child {\r\n                padding-right: 0px !important;\r\n            }\r\n            @include typographyStyle(14px, 24px, 0.96px);\r\n        }\r\n    }\r\n    .revx-top-campaign__title {\r\n        margin-bottom: 8px;\r\n    }\r\n    .revx-campaign-list__content {\r\n        padding: 0px !important;\r\n    }\r\n    .revx-top-value {\r\n        &__title {\r\n            color: map-get($neutral-colors, 'neutral-400');\r\n\t\t\tmargin: 0px;\r\n        }\r\n        &__data {\r\n            color: map-get($neutral-colors, 'neutral-700');\r\n        }\r\n    }\r\n    .revx-top-campaign__list {\r\n        .revx-campaign-table__empty-table {\r\n            max-width: 140px;\r\n            height: 140px;\r\n            svg {\r\n                height: 100px;\r\n                width: 100px;\r\n            }\r\n        }\r\n        .revx-empty-row {\r\n            height: auto;\r\n        }\r\n        .revx-campaign-table__empty-label {\r\n            @include typographyStyle(16px, 1.5, 0.96px);\r\n        }\r\n    }\r\n}\r\n\r\n.revx-top-campaign,\r\n.revx-conversion-info {\r\n    padding: 20px 24px 24px !important;\r\n    h2 {\r\n        margin-bottom: 32px;\r\n    }\r\n    .revx-bought-together,\r\n    .revx-volume-discount {\r\n        margin: 48px 0px 24px;\r\n        &__title {\r\n            color: map-get($neutral-colors, 'neutral-700');\r\n            &:before {\r\n                content: \"\";\r\n                display: block;\r\n                height: 12px;\r\n                width: 12px;\r\n                border-radius: 15px;\r\n                background-color: map-get($vibrant-colors, 'purple-base');\r\n            }\r\n        }\r\n        a {\r\n            text-decoration: none;\r\n            padding: 4px 6px;\r\n            color: map-get($vibrant-colors, 'purple-base');\r\n            background-color: map-get($vibrant-colors, 'purple-lighter');\r\n            border-radius: 4px;\r\n        }\r\n    }\r\n    .revx-bought-together {\r\n        &__title::before {\r\n            background-color: map-get($primary-colors, 'green-base');\r\n        }\r\n        a {\r\n            background-color: map-get($primary-colors, 'green-lighter');\r\n            color: map-get($primary-colors, 'green-base');\r\n            padding: 4px 8px;\r\n        }\r\n    }\r\n}\r\n\r\n.revx-topCmp-data,\r\n.revx-conversion-info__data-container {\r\n    display: flex;\r\n    gap: 16px;\r\n    .revx-top-value,\r\n    .revx-conversion-info__data-item {\r\n        flex-basis: calc(50% - 8px);\r\n        height: 84px;\r\n        display: flex;\r\n        flex-direction: column;\r\n        justify-content: space-between;\r\n        border: 1px solid map-get($neutral-colors, 'neutral-200');\r\n        border-radius: 8px;\r\n        padding: 12px 16px;\r\n        box-sizing: border-box;\r\n        .revx-conversion-info__data-title,\r\n        h4 {\r\n            color: map-get($neutral-colors, 'neutral-400');\r\n        }\r\n        .revx-conversion-info__value {\r\n            color: map-get($neutral-colors, 'neutral-700');\r\n        }\r\n    }\r\n}\r\n\r\n/*====================================\r\n    Graph\r\n====================================*/\r\n.revx-dashboard-stats {\r\n    background-color: map-get($neutral-colors, 'neutral-0');\r\n    border-radius: 12px;\r\n    padding: 0px !important;\r\n    &__header {\r\n        padding: 20px 24px 30px 24px;\r\n    }\r\n    &__title {\r\n        color: map-get($neutral-colors, 'neutral-700');\r\n    }\r\n    &__empty-graph {\r\n        position: relative;\r\n    }\r\n    &__graph-no-data {\r\n        color: map-get($neutral-colors, 'neutral-700');\r\n    }\r\n    &__graph {\r\n        // padding: 0px 25px 20px 5px;\r\n        padding-bottom: 20px;\r\n    }\r\n    &__filter-btn {\r\n        white-space: nowrap;\r\n        border: none;\r\n        color: map-get($neutral-colors, 'neutral-400');\r\n        background-color: transparent;\r\n        font-weight: 500;\r\n        &.active, &:hover {\r\n            color: map-get($primary-colors, 'green-dark');\r\n            background-color: map-get($primary-colors, 'green-lighter');\r\n        }\r\n    }\r\n    &__filter-shorting {\r\n        .revx-select-field__header  {\r\n            width: 100%;\r\n        }\r\n    }\r\n}\r\n\r\n\r\n/*====================================\r\n    Graph Content\r\n====================================*/\r\n.revx-graph-content {\r\n\tposition: relative;\r\n\tbackground-color: map-get($neutral-colors, 'neutral-0');\r\n}\r\n.revx-graph-tooltip {\r\n    padding: 0px;\r\n    border-radius: 6px !important;\r\n    box-shadow: 0px 16px 40px -8px rgba(88, 92, 95, 0.16);\r\n    border: 1px solid map-get($neutral-colors, 'neutral-200' );\r\n    min-width: 144px;\r\n    overflow: hidden;\r\n    &__heading {\r\n        background-color: map-get($neutral-colors, 'neutral-100');\r\n        border-bottom: 1px solid map-get($neutral-colors, 'neutral-200' );\r\n        th {\r\n            color: map-get($neutral-colors, 'neutral-700');\r\n            text-align: left;\r\n            padding: 8px !important;\r\n            @include typographyStyle(12px, 1.33, 0.48px);\r\n        }\r\n    }\r\n    tbody {\r\n        display: block;\r\n        padding: 12px;\r\n        tr {\r\n            display: block;\r\n            &:not(:last-child) {\r\n                margin-bottom: 12px !important;\r\n            }\r\n        }\r\n        td {\r\n            display: flex;\r\n            align-items: center;\r\n            color: map-get($neutral-colors, 'neutral-500');\r\n            @include typographyStyle(12px, 1.33, 0.48px);\r\n            div {\r\n                margin-left: 12px;\r\n                color: map-get($neutral-colors, 'neutral-700');\r\n                font-weight: 500;\r\n            }\r\n            span {\r\n                display: block;\r\n                height: 12px;\r\n                width: 12px;\r\n                border-radius: 16px;\r\n                border: none;\r\n                margin-right: 8px;\r\n            }\r\n        }\r\n    }\r\n}\r\n\r\n#revx-sales-graph {\r\n    height: 153px !important;\r\n    width: 100% !important;\r\n}\r\n#revx-dashboard-graph {\r\n    width: 100% !important;\r\n}\r\n#revx-order-graph,\r\n#revx-conversion-graph,\r\n#revx-total-order-graph,\r\n#revx-impression-graph {\r\n    max-height: 84px;\r\n    width: 100% !important;\r\n\tpadding-bottom: 4px;\r\n}\r\n\r\n#legend-container {\r\n    margin-top: 10px;\r\n    display: flex;\r\n    justify-content: space-between;\r\n    flex-direction: row-reverse;\r\n    padding: 0px 78px;\r\n}\r\n\r\n/*====================================\r\n    Global or Common Style\r\n====================================*/\r\n.revx-btn-live {\r\n    display: none !important;\r\n}\r\n.revx-btn-docs {\r\n    border: none;\r\n    @include buttonColor(map-get($primary-colors, 'green-lighter'), map-get($primary-colors, 'green-dark'), false, true, true);\r\n    @include buttonHoverColor(map-get($primary-colors, 'green-base'), map-get($neutral-colors, 'neutral-100'), false, true, true);\r\n}\r\n\r\n.revx-progress-btn {\r\n    border: none;\r\n    @include buttonColor(map-get($primary-colors, 'green-lighter'), false, false, #00A464, true);\r\n\t&.revx-progress-down {\r\n\t\tbackground-color: map-get($vibrant-colors, 'red-lighter' );\r\n\t\tsvg path {\r\n\t\t\tstroke: map-get($vibrant-colors, 'red-base');\r\n\t\t}\r\n\t}\r\n}\r\n/*====================================\r\n    Unidentified\r\n====================================*/\r\n.revx-trigger-group-container {\r\n    position: relative;\r\n    .revx-trigger-group-label {\r\n        position: absolute;\r\n        top: -24px;\r\n    }\r\n}","/*====================\r\n    Global Settings\r\n======================*/\r\n.revx-global-settings {\r\n    &__header {\r\n        border-bottom: 1px solid map-get($neutral-colors, 'neutral-200' ) ;\r\n        margin-top: 30px;\r\n        margin-bottom: 30px;\r\n        padding-bottom: 30px;\r\n        .revx-toaster {\r\n            margin-top: 24px;\r\n        }\r\n    }\r\n    &__container {\r\n        border-bottom: 1px solid map-get($neutral-colors, 'neutral-200' ) ;\r\n        margin-bottom: 40px;\r\n    }\r\n    &__settings {\r\n        display: grid;\r\n        grid-template-columns: 1fr 1fr;\r\n        align-items: center;\r\n        column-gap: 24px;\r\n        row-gap: 40px;\r\n        box-sizing: border-box;\r\n        border-radius: 4px;\r\n        background-color: map-get($neutral-colors, 'neutral-0');\r\n        padding: 32px 24px;\r\n        .revx-select-field__content {\r\n            max-width: 200px;\r\n        }\r\n    }\r\n    &__title-container {\r\n        width: 100%;\r\n        max-width: 463px;\r\n        .revx-global-settings__title {\r\n            margin-bottom: 8px;\r\n        }\r\n        .revx-global-settings__subtitle {\r\n            color: map-get($neutral-colors, 'neutral-400');\r\n        }\r\n    }\r\n    &__behavior-settings {\r\n        .revx-global-settings__settings  {\r\n            display: block;\r\n        }\r\n        .revx-select-field__header {\r\n            width: 100%;\r\n        }\r\n    }\r\n    &__popup-settings,\r\n    &__floating-settings  {\r\n        .revx-global-settings__settings  {\r\n            column-gap: 70px;\r\n            .revx-select-field__header  {\r\n                // width: -webkit-fill-available;\r\n                @extend .revx-fill-width;\r\n            }\r\n        }\r\n    }\r\n    &__page-settings {\r\n        .revx-global-settings__settings {\r\n            display: block;\r\n            .revx-select-field__content  {\r\n                max-width: 464px;\r\n            }\r\n            .revx-select-field.revx-select-inline {\r\n                justify-content: space-between;\r\n            }\r\n            .revx-page-settings__row:not(:last-child) {\r\n                margin-bottom: 24px;\r\n            }\r\n        }\r\n    }\r\n    &__col-desc {\r\n        width: 616px;\r\n        vertical-align: top;\r\n        box-sizing: border-box;\r\n        padding: 40px 16px 40px 0px;\r\n    }\r\n    &__col-settings {\r\n        width: 920px;\r\n        padding: 40px 0px;\r\n    }\r\n    &.revx-section-container {\r\n        width: 100%;\r\n    }\r\n    tr:first-child td {\r\n        padding-top: 0px;\r\n    }\r\n    .revx-label-container   label {\r\n        // color: map-get($neutral-colors, 'neutral-400');\r\n        @include typographyStyle(14px, 1.43, -0.08px);\r\n    }\r\n}\r\n\r\n.revx-behavior-settings {\r\n    &__row {\r\n        display: flex;\r\n        &:not(:last-child) {\r\n            border-bottom: 1px solid map-get($neutral-colors, 'neutral-200' );\r\n            margin-bottom: 24px;\r\n            padding-bottom: 24px;\r\n        }\r\n    }\r\n    &--toggle-container {\r\n        display: grid;\r\n        grid-template-columns: 1fr 1fr;\r\n    }\r\n    &--select-container {\r\n        gap: 28px;\r\n    }\r\n}\r\n",".revx-campaign-item {\r\n\t&__image {\r\n\t\theight: 160px;\r\n\t\twidth: 160px;\r\n\t\timg {\r\n\t\t\theight: 100%;\r\n\t\t\twidth: 100%;\r\n\t\t\tborder-radius: inherit;\r\n\t\t\tborder-width: inherit;\r\n\t\t}\r\n\t}\r\n\t&__content {\r\n\t\tdisplay: flex;\r\n\t\tgap: 30px;\r\n\t\tborder: 1px solid rgba(226, 228, 233, 1);\r\n\t\tpadding: 15px;\r\n\t}\r\n\t&__save {\r\n\t\tborder: 1px solid rgba(10, 13, 20, 1);\r\n\t\tborder-radius: 12px;\r\n\t\theight: 20px;\r\n\t\twidth: 70px;\r\n\t\tpadding: 4px 8px 4px 8px;\r\n\t\tfont-size: 11px;\r\n\t\tfont-weight: 400;\r\n\t\tline-height: 12px;\r\n\t\tletter-spacing: 0.02em;\r\n\t\ttext-align: left;\r\n\t}\r\n\t&__sale-price {\r\n\t\tcolor: rgba(0, 164, 100, 1);\r\n\t}\r\n\t&__title {\r\n\t\tcolor: rgba(10, 13, 20, 1);\r\n\t}\r\n\t&__meta {\r\n\t\tdisplay: flex;\r\n\t\tflex-direction: column;\r\n\t\tjustify-content: space-around;\r\n\t\tgap: 10px;\r\n\t}\r\n}\r\n\r\n\r\n.revx-campaign-view {\r\n\tdisplay: flex;\r\n\tflex-direction: column;\r\n\tgap: 20px;\r\n\tmargin-bottom: 20px;\r\n\t&__title {\r\n\t\tfont-size: 16px;\r\n\t\tfont-weight: 400;\r\n\t\tline-height: 24px;\r\n\t\tletter-spacing: -0.011em;\r\n\t\ttext-align: left;\r\n\t\tcolor: rgba(10, 13, 20, 1);\r\n\t}\r\n\t&__items {\r\n\t\tbackground-color: rgba(255, 255, 255, 1);\r\n\t\tdisplay: flex;\r\n\t\tgap: 15px;\r\n\t\tflex-direction: column;\r\n\t}\r\n\t&__items:only-child {\r\n\t\tflex-direction: column;\r\n\t}\r\n\t&__items:only-child .revx-campaign-item__prices {\r\n\t\tdisplay: flex;\r\n\t\tgap: 10px;\r\n\t}\r\n\t&__items:only-child .revx-campaign-item__content {\r\n\t\tpadding: 15px;\r\n\t\tflex-direction: column;\r\n\t\tbackground-color: red;\r\n\t}\r\n}\r\n\r\n\r\n.revx-campaign-add-to-cart-btn {\r\n\theight: 40px;\r\n\tfont-size: 16px;\r\n\tfont-weight: 400;\r\n\tline-height: 24px;\r\n\tletter-spacing: -0.011em;\r\n\ttext-align: left;\r\n\tbackground-color: rgba(22, 25, 34, 1);\r\n\tborder-radius: 2px;\r\n\tcolor: map-get($neutral-colors, 'neutral-0');\r\n\ttext-align: center;\r\n\tpadding: 8px;\r\n\tmargin-top: 15px;\r\n\tcursor: pointer;\r\n}\r\n\r\n.revx-campaign-add-to-cart-btn:hover {\r\n\tbackground-color: rgba(22, 25, 34, 0.95);\r\n}\r\n\r\n.revx-builder-setting__control {\r\n\tcursor: pointer;\r\n\t.revx-builder-element > * {\r\n\t\tpadding: 0px;\r\n\t}\r\n}\r\n// .revx-builder-settings {\r\n//     &__wrapper{\r\n//         justify-content: center;\r\n//         background-color: map-get($neutral-colors, 'neutral-900');\r\n//         border: 1px solid map-get($neutral-colors, 'neutral-500');\r\n//         border-radius: 2px;\r\n//         width: fit-content;\r\n//         // margin: 20px auto;\r\n//         box-sizing: border-box;\r\n//         height: 32px;\r\n//         padding: 0px 0px;\r\n//         display: flex;\r\n//         align-items: stretch;\r\n//         &-btn {\r\n//             display: flex;\r\n//             align-items: center;\r\n//             cursor: pointer;\r\n//             padding: 0px 5px;\r\n//             box-sizing: border-box;\r\n//             &:not(:last-child) {\r\n//                 border-right: 1px solid map-get($neutral-colors, 'neutral-500');\r\n//             }\r\n//             & > svg {\r\n//                 border-radius: 2px;\r\n//                 padding: 3px 3px 3px 3px;\r\n//                 height: 19px;\r\n//                 width: 19px;\r\n//             }\r\n//             &:hover,  &.active {\r\n//                 border-radius: 2px;\r\n//                 & > svg {\r\n//                     background-color: map-get($neutral-colors, 'neutral-700');\r\n//                 }\r\n//             }\r\n//         }\r\n//         svg, path {\r\n//             stroke: map-get($neutral-colors, 'neutral-0');\r\n//         }\r\n//     }\r\n//     &__btn-group {\r\n//         .revx-select-field__header {\r\n//             height: 24px;\r\n//             background-color: map-get($neutral-colors, 'neutral-700');\r\n//             border: 0px;\r\n//             padding: 4px 6px;\r\n//             gap: 7px;\r\n//             border-radius: 2px !important;\r\n//             svg {\r\n//                 height: 16px;\r\n//                 width: 16px;\r\n//             }\r\n//         }\r\n//         .revx-select-field__selected-option {\r\n//             font-size: 12px !important;\r\n//             color: map-get($neutral-colors, 'neutral-0') !important;\r\n\r\n//         }\r\n//         .revx-select-field__arrow-icon {\r\n//             height: 16px;\r\n//         }\r\n//     }\r\n// }",".revx-license-faq {\r\n    &__item {\r\n        margin-bottom: 32px;\r\n    }\r\n    &__question {\r\n        text-align: left;\r\n        color: map-get($neutral-colors, 'neutral-900');\r\n    }\r\n    &__answer {\r\n        text-align: left;\r\n        color: map-get($neutral-colors, 'neutral-700');\r\n    }\r\n}\r\n\r\n.revx-license-message {\r\n    display: flex;\r\n    align-items: flex-start;\r\n    background-color: map-get($primary-colors, 'green-lighter');\r\n    border: 1px solid map-get($primary-colors, 'green-base');\r\n    border-radius: 8px;\r\n    padding: 24px;\r\n    &__icon {\r\n        color: #00a86b;\r\n        font-size: 24px;\r\n        margin-right: 16px;\r\n    }\r\n    &__content {\r\n        flex: 1;\r\n    }\r\n    &__title {\r\n        text-align: left;\r\n        color: map-get($primary-colors, 'green-dark');\r\n        margin-top: 8px;\r\n        margin-bottom: 8px;\r\n    }\r\n    &__text {\r\n        text-align: left;\r\n        color: map-get($primary-colors, 'green-darker');\r\n    }\r\n}\r\n\r\n.revx-license {\r\n    max-width: 1600px;\r\n    padding: 32px;\r\n    display: flex;\r\n    margin: 0 auto;\r\n    gap: 32px;\r\n    &__title {\r\n        margin-bottom: 32px;\r\n        color: map-get($neutral-colors, 'neutral-900');\r\n    }\r\n    &__activation {\r\n        background-color: map-get($neutral-colors, 'neutral-0');\r\n        padding: 32px;\r\n        box-shadow: 0px 2px 4px 0px #1B1C1D0A;\r\n        max-width: 890px;\r\n        width: 60%;\r\n    }\r\n    &__form{\r\n        margin-bottom: 30px;\r\n    }\r\n    &__helper-text {\r\n        color: map-get($neutral-colors, 'neutral-400');\r\n        margin-top: 8px;\r\n    }\r\n    &__link {\r\n        color: map-get($primary-colors, 'green-base');\r\n    }\r\n    &__button{\r\n        margin-top: 40px;\r\n        padding: 12px 72px;\r\n        margin-left: auto;\r\n        border-radius: 8px !important;\r\n    }\r\n    &__input input {\r\n        height: 48px;\r\n    }\r\n    &__input{\r\n        .revx-field-icon {\r\n            position: absolute;\r\n            right: 12px;\r\n        }\r\n        &.revx-field-disabled input {\r\n            background-color: white !important;\r\n            border: 1.5px solid map-get($primary-colors, 'green-dark');\r\n        }\r\n    }\r\n    &__faq {\r\n        max-width: 567px;\r\n        width: 40%;\r\n        padding-left: 32px;\r\n        border-left: 1px solid map-get($neutral-colors, 'neutral-200');\r\n    }\r\n    &__status-messages {\r\n        display: flex;\r\n        flex-direction: column;\r\n        gap: 40px;\r\n        margin-top: 48px;\r\n        margin-bottom: 48px;\r\n    }\r\n    &__status-message {\r\n        display: flex;\r\n        &-label {\r\n            text-align: left;\r\n            color: map-get($neutral-colors, 'neutral-900');\r\n            width: 133px;\r\n        }\r\n        &-value {\r\n            color: map-get($neutral-colors, 'neutral-900');\r\n            text-align: left;\r\n            &::before {\r\n                content: \":\";\r\n                margin-right: 33px;\r\n                color: map-get($neutral-colors, 'neutral-900');\r\n            }\r\n        }\r\n    }\r\n}",".revx-support {\r\n    &-sub-heading {\r\n        font-size: 16px;\r\n        color: #9F9F9F;\r\n        margin-bottom: 30px;\r\n    }\r\n    &-lists .revx-pro-feature-lists > div {\r\n        display: flex;\r\n        gap: 8px;\r\n        align-items: baseline;\r\n        & > svg {\r\n            height: 8px;\r\n            width: 8px;\r\n            fill: map-get($primary-colors, 'green-base');\r\n        }\r\n    }\r\n    &-form {\r\n        input {\r\n            width: 100%;\r\n            height: 44px;\r\n            min-width: 180px;\r\n        }\r\n        textarea {\r\n            height: 150px;\r\n            width: 100%;\r\n        }\r\n        input, .revx-support-form textarea {\r\n            border: 1px solid #eaedf2;\r\n            border-radius: 2px;\r\n            background-color: map-get($neutral-colors, 'neutral-0');\r\n            padding: 12px;\r\n            color: #000000;\r\n            font-size: 16px;\r\n            &:focus {\r\n                border-color: map-get($primary-colors, 'green-base') !important;\r\n                outline-color: map-get($primary-colors, 'green-base');\r\n            }\r\n        }\r\n        #revx-contact {\r\n            display: flex;\r\n            flex-direction: column;\r\n            gap: 18px;\r\n            // margin-bottom: 40px;\r\n        }\r\n        .revx-support-form-double {\r\n            display: flex;\r\n            flex-wrap: wrap;\r\n            gap: 20px;\r\n        }\r\n        .revx-support-form-double input {\r\n            width: calc(50% - 12px);\r\n        }\r\n    }\r\n    &-dashboard {\r\n        display: grid;\r\n        grid-template-columns: auto 370px;\r\n        gap: 50px;\r\n        margin-top: 30px;\r\n        &__setting, &__side-content .revx-dash-item-con {\r\n            height: fit-content;\r\n            width: -webkit-fill-available;\r\n            background: map-get($neutral-colors, 'neutral-0');\r\n            border-radius: 4px;\r\n            box-shadow: $shadow-sm;\r\n            padding: 25px;\r\n        }\r\n        &__side-content {\r\n            max-width: 400px;\r\n            .revx-pro-feature-lists > div > svg {\r\n                height: 8px;\r\n                width: 8px;\r\n                fill: #FF176B;\r\n            }\r\n            &-description {\r\n                margin-top: 8px;\r\n                display: block;\r\n                color: map-get($neutral-colors, 'neutral-500');\r\n                @include typographyStyle(14px, 1.8, 0.84px);\r\n            }\r\n        }\r\n        &__setting {\r\n            &-heading {\r\n                margin-bottom: 8px;\r\n            }\r\n            &-subheading {\r\n                color: map-get($neutral-colors, 'neutral-500');\r\n            }\r\n            &-support-type {\r\n                font-size: 16px;\r\n                color: #513D02;\r\n                line-height: 1.2;\r\n                padding: 12px 20px;\r\n                margin-bottom: 20px;\r\n                background: map-get($neutral-colors, 'neutral-0')3CD;\r\n                border: 1px solid #FFE69C;\r\n                border-radius: 4px;\r\n                margin-top: 32px;\r\n                margin-bottom: 24px;\r\n            }\r\n            &-options {\r\n                display: flex;\r\n                flex-direction: column;\r\n                gap: 25px;\r\n                margin: 30px 0px;\r\n                .revx-support-option {\r\n                    display: flex;\r\n                    align-items: center;\r\n                    gap: 8px;    \r\n                }\r\n                .revx-support-option label {\r\n                    cursor: pointer;\r\n                }\r\n                    label:hover input[type=radio]::before {\r\n                    background-color: map-get($primary-colors, 'green-base') !important;\r\n                }   \r\n                .revx-support-option label a {\r\n                    color: map-get($primary-colors, 'green-dark');\r\n                    text-decoration: none;\r\n                    margin-left: 5px;\r\n                }\r\n                input[type=radio]::before {\r\n                    background-color: map-get($primary-colors, 'green-base');\r\n                    height: 12px;\r\n                    width: 12px;\r\n                }\r\n                input[type=radio], .revx-support-options input[type=radio]::before {\r\n                    margin: 0;\r\n                    display: flex;\r\n                    align-items: center;\r\n                    justify-content: center;\r\n                    border-radius: 50%;\r\n                }\r\n                input[type=radio] {\r\n                    height: 20px;\r\n                    width: 20px;\r\n                    border: 1px solid #000000;\r\n                }\r\n            }\r\n            form {\r\n                margin-top: 40px;\r\n            }\r\n            .skeletonOverflow {\r\n                margin-top: 40px;\r\n                // @include flex(30);\r\n            }\r\n        }\r\n    }\r\n}\r\n\r\n.revx-dashboard-promotions-features {\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 40px;\r\n    & > div {\r\n        display: flex;\r\n        flex-direction: column;\r\n        gap: 20px;\r\n    }\r\n}\r\n\r\n.revx-dashboard-support .revx-pro-feature-lists .revx-item-label {\r\n    text-decoration: none;\r\n    color: #333;\r\n}\r\n\r\n.revx-pro-feature-lists {\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 18px;\r\n    margin-bottom: 10px;\r\n    span {\r\n        display: inline-flex;\r\n        gap: 8px;\r\n        align-items: center;\r\n        font-size: 15px;\r\n        color: map-get($primary-colors, 'green-base');\r\n    }\r\n}",".revx-extra-features  {\r\n\tborder: 1px solid map-get($neutral-colors, 'neutral-200');\r\n\tborder-radius: 4px;\r\n\tmargin-bottom: 20px;\r\n\tpadding: 20px;\r\n\tpadding-bottom: 0px;\r\n    &__action {\r\n        padding-bottom: 20px;\r\n    }\r\n    & > div:nth-child(2) {\r\n        border-top: 1px solid map-get($neutral-colors, 'neutral-200');\r\n    }\r\n    .revx-accordion  {\r\n        box-shadow: none;\r\n        border-radius: 0px;\r\n        &:last-child {\r\n            margin-bottom: 0px !important;\r\n            &.active .revx-accordion-content {\r\n                padding-bottom: 20px;\r\n            }\r\n        }\r\n        &-btn  {\r\n            padding-left: 0px !important;\r\n            padding-right: 0px !important;\r\n        }\r\n        &-content {\r\n            padding-left: 0px !important;\r\n            padding-right: 0px !important;\r\n        }\r\n        .revx-accordion-btn {\r\n            color: map-get($neutral-colors, 'neutral-500' ) !important;\r\n        }\r\n        .revx-group-input:last-child {\r\n            margin-bottom: 0px !important;\r\n        }\r\n    }\r\n    .revx-animated-atc .revx-group-input:first-child {\r\n        margin-bottom: 24px;\r\n    }\r\n    .revx-date-container.revx-date-dropdown .react-datepicker__input-container input {\r\n        @include typographyStyle(12px, 16px);\r\n    }\r\n}\r\n\r\n.revx-stock {\r\n    display: grid;\r\n    align-items: center;\r\n    grid-template-columns: max-content 152px auto 106px;\r\n    column-gap: 16px;\r\n    &-label {\r\n        margin-bottom: 8px !important;\r\n    }\r\n    > div:not(:nth-last-child(-n+4)) {\r\n        margin-bottom: 16px;\r\n    }\r\n}","\n.revx-campaign-modal {\n    max-width: 1312px !important;\n    width: 100%;\n    &__back {\n        border: none;\n        background-color: transparent;\n    }\n    .revx-free-limit,\n    .revx-campaign-card__upgrade-pro {\n        padding: 4px 12px;\n        border-radius: 12px;\n        border: 1px solid map-get($primary-colors, 'green-base');\n        opacity: 0px;\n        background-color: map-get($primary-colors, 'green-lighter');\n        color: map-get($primary-colors, 'green-base');\n        font-size: 12px;\n        line-height: 16px;\n        font-weight: 500;\n        white-space: nowrap;\n    }\n}\n\n.revx-select-campaign {\n    display: grid;\n    justify-content: center;\n    grid-template-columns: 1fr 1fr 1fr 1fr;\n    gap: 16px;\n    margin: 0 auto;\n}\n\n.revx-campaign-card {\n    border-radius: 4px;\n    border: 1px solid map-get($neutral-colors, 'neutral-200');\n    padding: 8px;\n\tmax-height: 304px;\n\tmax-width: 320px;\n    position: relative;\n    border-radius: 8px;\n    text-align: center;\n    &__pro-tag {\n        background-color: map-get($vibrant-colors, 'orange-base');\n        border-radius: 12px;\n        padding: 2px 10px;\n        font-weight: 500;\n        @include positionStyle(absolute, -12px, 24px);\n        color: map-get($neutral-colors, 'neutral-0');\n        box-sizing: border-box;\n        text-transform: uppercase;\n    }\n    &__coming-soon-btn {\n        background-color: #CAC2FF;\n        border-width: 0px;\n        color: map-get($neutral-colors, 'neutral-0');\n        border-radius: 4px !important;\n    }\n    &__placeholder {\n        border-radius: 4px;\n        background-color: map-get($neutral-colors, 'neutral-100');\n        margin-bottom: 12px;\n\t\tpadding: 16px 20px;\n        flex-direction: column;\n        gap: 19px;\n\t\tsvg{\n\t\t\twidth: 100% !important;\n\t\t\theight: 100% !important;\n\t\t}\n    }\n    &__title {\n        gap: 4px;\n        color: map-get($neutral-colors, 'neutral-900');\n        margin-bottom: 12px;\n        svg {\n            height: 16px;\n            width: 16px;\n            path {\n                stroke: map-get($neutral-colors, 'neutral-400');\n            }\n        }\n    }\n    &__subtitle {\n        color: map-get($neutral-colors, 'neutral-500');\n        margin-bottom: 24px;\n    }\n    &__tag {\n        display: flex;\n        gap: 8px;\n    }\n    &__free-limit {\n        color: map-get($neutral-colors, 'neutral-500');\n        white-space: nowrap;\n        border-radius: 12px;\n        border: 1px solid transparent;\n        opacity: 0px;\n        padding: 4px 12px;\n        background-color: map-get($neutral-colors, 'neutral-200');\n    }\n\n\t.revx-spinner{\n\t\twidth: 16px;\n\t}\n}\n",".revx-offer-product {\r\n\t&__action {\r\n\t\tmargin-top: 20px;\r\n\t}\r\n\t&__title {\r\n\t\tmargin-bottom: 20px;\r\n\t\tcolor: map-get($neutral-colors, 'neutral-900');\r\n\t}\r\n\t&__recommendation {\r\n        margin-bottom: 24px;\r\n\t\t.revx-campaign-card__pro-tag {\r\n            left: auto;\r\n            right: 10px;\r\n            top: 10px;\r\n        }\r\n\t}\r\n\t&__btn {\r\n\t\twidth: 100%;\r\n\t\tmargin-left: auto;\r\n\t\tborder: 1px solid;\r\n\t\t@include buttonColor(map-get($primary-colors, 'green-lighter'), map-get($vibrant-colors, 'green-base'), map-get($primary-colors, 'green-light'), map-get($vibrant-colors, 'green-dark'), true);\r\n\t\t@include buttonHoverColor(transparent, map-get($vibrant-colors, 'green-dark'), map-get($vibrant-colors, 'green-dark'), map-get($vibrant-colors, 'green-dark'), true);\r\n\t}\r\n\t&__heading {\r\n\t\tcolor: map-get($neutral-colors, 'neutral-500');\r\n\t\tmargin-bottom: 8px;\r\n\t\twhite-space: nowrap;\r\n\t\tmargin-left: 2px;\r\n\t\t.required {\r\n\t\t\tcolor: map-get($vibrant-colors, 'red-base');\r\n\t\t}\r\n\t}\r\n\t&__content {\r\n\t\t&.revx-cmp-mix_match,\r\n\t\t&.revx-cmp-volume_discount {\r\n\t\t\t.revx-offered-data {\r\n\t\t\t\tgrid-template-columns: 24px 1fr 90px !important;\r\n\t\t\t\t.revx-offered-data__group .revx-select-field__selected-option {\r\n\t\t\t\t\twidth: auto;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\t&.revx-cmp-tag-hide {\r\n\t\t\t.revx-offered-data {\r\n\t\t\t\tgrid-template-columns: 24px 196px 1fr auto;\r\n\t\t\t\t.revx-tag-group {\r\n\t\t\t\t\tjustify-content: flex-end;\r\n\t\t\t\t\tmargin-left: 14px;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\t.revx-label-container {\r\n\t\tcolor: map-get($neutral-colors, 'neutral-500' ) !important;\r\n\t\tmargin-bottom: 8px;\r\n\t}\r\n\r\n\t.revx-offer-type-gift {\r\n\t\t.revx-gift-count-select-wrapper {\r\n\t\t\tflex: 1;\r\n\t\t}\r\n\t\t.revx-toggle-search,.revx-gift-count-select {\r\n\t\t\tflex: 1;\r\n\t\t\t&.focus {\r\n\t\t\t\toutline: 1px solid map-get($primary-colors, 'green-base');\r\n\t\t\t\tborder-radius: 8px;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\t.revx-gift-count-select {\r\n\t\tdisplay: flex;\r\n\t\talign-self: end;\r\n\r\n\t\t.revx-select-field__header  {\r\n\t\t\tborder-top-left-radius: 8px;\r\n\t\t\tborder-bottom-left-radius: 8px;\r\n\r\n\t\t\tborder-top-right-radius: 0px;\r\n\t\t\tborder-bottom-right-radius: 0px;\r\n\t\t\t//border: 1px solid map-get($neutral-colors, 'neutral-200' );\r\n\t\t}\r\n\r\n\t\t.revx-input-field input {\r\n\t\t\tborder-left: none;\r\n\t\t\tborder-top-left-radius: 0px;\r\n\t\t\tborder-bottom-left-radius: 0px;\r\n\t\t\tmargin-left: 0px;\r\n\t\t}\r\n\t}\r\n}\r\n\r\n.revx-offered-data {\r\n\tdisplay: grid;\r\n\tgrid-template-columns: 24px 200px 2.2fr 119px;\r\n\tcolumn-gap: 16px;\r\n\tdisplay: flex !important;\r\n\tflex-direction: column;\r\n\tjustify-content: center;\r\n\talign-items: flex-start !important;\r\n\tborder-radius: 8px;\r\n\tborder: 1px solid map-get($neutral-colors, 'neutral-200');\r\n\tpadding: 16px 20px;\r\n\tposition: relative;\r\n\t&__group {\r\n\t\tdisplay: grid;\r\n\t\tgap: 8px;\r\n\t\tgrid-template-columns: 95px 110px 1fr auto !important;\r\n\t\tmargin-top: 16px;\r\n\t}\r\n\t&:not(:last-child .revx-offered-heading) {\r\n\t\tmargin-bottom: 16px;\r\n\t}\r\n\t&__delete-btn {\r\n\t\t@include positionStyle(absolute, -1px, false, -1px);\r\n\t\tborder-radius: 0px 8px 0px 4px !important;\r\n\t\tsvg {\r\n\t\t\tstroke: #DF1C41;\r\n\t\t}\r\n\t}\r\n\t&__draggable-icon {\r\n\t\tdisplay: flex;\r\n\t\tflex-direction: column;\r\n\t\tborder: 1px solid map-get($neutral-colors, 'neutral-200');\r\n\t\tbackground-color: map-get($neutral-colors, 'neutral-0');\r\n\t\tborder-radius: 2px;\r\n\t\tposition: absolute;\r\n\t\tleft: -11px;\r\n\t\tz-index: 9;\r\n\t\tpadding: 6px 0px;\r\n\t\tpath {\r\n\t\t\tstroke: #525866 !important;\r\n\t\t}\r\n\t}\r\n\t&__tag-group {\r\n\t\t@include positionStyle(absolute, -1px, false, -1px);\r\n\t}\r\n\r\n\t// Override For Spending goal\r\n\r\n\r\n}\r\n.revx-spending-goal-upsell-products {\r\n\t.revx-offered-data__delete-btn {\r\n\t\theight: 20px;\r\n\t\twidth: 20px;\r\n\t\tsvg {\r\n\t\t\theight: 14px;\r\n\t\t}\r\n\t}\r\n}\r\n",".revx-behavior {\r\n    &-group {\r\n        gap: 12px;\r\n\t\tmargin-bottom: 20px;\r\n        &__gap {\r\n            gap: 45px;\r\n        }\r\n        &:not(.revx-behavior-inpage) {\r\n            display: grid !important;\r\n            grid-template-columns: 1fr 1fr;\r\n        }\r\n        &:not(:last-child) {\r\n            margin-bottom: 24px; // Suggested From JOS\r\n        }\r\n    }\r\n    &__edit-btn {\r\n        gap: 12px !important;\r\n        border: 1px solid;\r\n        @include buttonColor(map-get($primary-colors, 'green-lighter'), map-get($vibrant-colors, 'green-base'), map-get($primary-colors, 'green-light'), map-get($vibrant-colors, 'green-base'), true);\r\n        @include buttonHoverColor(transparent, map-get($vibrant-colors, 'green-dark'), map-get($vibrant-colors, 'green-dark'), map-get($vibrant-colors, 'green-dark'), true);\r\n    }\r\n    &-toggle {\r\n        height: 40px;\r\n        align-self: flex-end;\r\n    }\r\n    &__save-btn {\r\n        margin-top: 56px;\r\n        position: sticky;\r\n        bottom: 0;\r\n    }\r\n    .revx-accordion-btn {\r\n\t\tgap: 32px;\r\n        padding: 8px 8px 8px 20px;\r\n    }\r\n    .revx-group-input:not(:last-child) {\r\n        margin-bottom: 24px;\r\n    }\r\n\r\n    .revx-checklist-content div {\r\n        color: map-get($neutral-colors, 'neutral-900');\r\n    }\r\n\t&.revx-accordion.active {\r\n\t\t.revx-accordion-btn__summary {\r\n\t\t\tborder: 1px solid transparent;\r\n\t\t}\r\n\t}\r\n\t.revx-accordion-btn__summary {\r\n\t\tborder-radius: 6px;\r\n\t\tpadding: 8px;\r\n        width: -webkit-fill-available;\r\n        width: -moz-available;\r\n        width: fill-available;\r\n\t\t.revx-breadcrumb {\r\n            flex-wrap: wrap;\r\n\t\t\tbackground-color: map-get($neutral-colors, 'neutral-0');\r\n\t\t\t.revx-breadcrumb-item{\r\n\t\t\t\tcolor: map-get($neutral-colors, 'neutral-400' );\r\n\t\t\t\t&:not(:last-child)::after {\r\n\t\t\t\t\tbackground-color: map-get($vibrant-colors, 'green-base' );\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n    .revx-accordian-btn-active .revx-accordian-btn__summary  {\r\n        width: auto;\r\n    }\r\n}",".revx-campaign-placement {\r\n    @include flexStyle(space-between, stretch);\r\n    border-radius: 8px;\r\n    background-color: map-get($neutral-colors, 'neutral-0');\r\n    padding: 4px;\r\n    margin-bottom: 10px;\r\n    position: relative;\r\n    &__empty-state {\r\n        position: relative;\r\n    }\r\n    &__page-list {\r\n        gap: 3px;\r\n        box-sizing: border-box;\r\n        padding: 0px 0px 13px;\r\n        overflow-x: auto;\r\n        overflow-y: hidden;\r\n        scrollbar-width: none;\r\n        &::-webkit-scrollbar {\r\n            display: none;\r\n        }\r\n    }\r\n    &__overlay {\r\n        width: 100%;\r\n        min-height: 48px;\r\n        height: calc(100% - 13px);\r\n        border-radius: 4px;\r\n        background: map-get($neutral-colors, 'neutral-200');\r\n        @include positionStyle(absolute, 0px, 0px);\r\n        z-index: 0;\r\n    }\r\n    &__tab-item {\r\n        min-width: 132px;\r\n        flex-shrink: 0;\r\n        position: relative;\r\n        &.active   {\r\n            .revx-campaign-placement__page-item  {\r\n                border: 1px solid map-get($primary-colors, 'green-base');\r\n\t\t\t\tposition: relative;\r\n            }\r\n            .revx-campaign-placement__tab-direction-shape {\r\n                display: block;\r\n            }\r\n        }\r\n    }\r\n    &__tab-direction-shape {\r\n        display: none;\r\n        height: 19px;\r\n        width: 20px;\r\n        clip-path: polygon(0 0, 50% 50%, 100% 0);\r\n        background-color: map-get($neutral-colors, 'neutral-200');\r\n        position: absolute;\r\n        top: calc(100% + 3px);\r\n        z-index: 9;\r\n    }\r\n    &__page-item {\r\n        cursor: pointer;\r\n        color: map-get($neutral-colors, 'neutral-900');\r\n        border-radius: 4px;\r\n        box-sizing: border-box;\r\n        border: 1px solid transparent;\r\n        background-color: map-get($neutral-colors, 'neutral-0');\r\n        padding: 12px;\r\n    }\r\n\t&__status {\r\n\t\theight: 8px;\r\n        width: 8px;\r\n        border-radius: 15px;\r\n        background-color: map-get($neutral-colors, 'neutral-300');\r\n\t\t&-active{\r\n\t\t\theight: 8px;\r\n\t\t\twidth: 8px;\r\n\t\t\tborder-radius: 15px;\r\n\t\t\tbackground-color: map-get($primary-colors, 'green-base') !important;\r\n\t\t}\r\n\t}\r\n    &__add-page {\r\n        cursor: pointer;\r\n        max-height: 40px;\r\n        max-width: 40px;\r\n        border-radius: 4px;\r\n        background-color: map-get($neutral-colors, 'neutral-900');\r\n        margin-left: auto;\r\n        position: relative;\r\n        z-index: 99;\r\n        & > svg {\r\n            stroke: map-get($neutral-colors, 'neutral-0');\r\n        }\r\n\t\t&:hover{\r\n\t\t\tbackground-color: map-get($neutral-colors, 'neutral-700');\r\n\t\t}\r\n    }\r\n    &__page-list-popup {\r\n        min-width: 200px;\r\n        border-radius: 8px;\r\n        box-sizing: border-box;\r\n        border: 1px solid map-get($neutral-colors, 'neutral-200');\r\n        background-color: map-get($neutral-colors, 'neutral-0');\r\n        padding: 4px;\r\n        box-shadow: $shadow-md;\r\n        @include positionStyle(absolute, 100%, false, 0);\r\n        z-index: 999;\r\n    }\r\n    &__page-list-option {\r\n\t\twidth: 100%;\r\n\t\tborder-radius: 4px;\r\n\t\ttransition: .3s;\r\n\t\t.revx-checkbox-label {\r\n\t\t\tpadding: 8px 12px;\r\n\t\t}\r\n\t\t.revx-choiceInput-label {\r\n\t\t\tmargin-left: 8px;\r\n\t\t}\r\n        &.active, &:hover {\r\n            background-color: map-get($neutral-colors, 'neutral-100');\r\n        }\r\n    }\r\n    &__left-arrow, &__right-arrow {\r\n        cursor: pointer;\r\n        align-self: center;\r\n        stroke: map-get($neutral-colors, 'neutral-500');\r\n        position: relative;\r\n        top: -5px;\r\n        z-index: 99;\r\n    }\r\n    &__blank-title {\r\n        color: map-get($neutral-colors, 'neutral-400');\r\n        padding-left: 20px;\r\n        margin-right: 16px;\r\n    }\r\n    &.empty-placement {\r\n        min-height: 40px;\r\n        justify-content: flex-start;\r\n        margin-bottom: 20px;\r\n    }\r\n}\r\n\r\n.revx-page-status {\r\n\tmargin-bottom: 24px;\r\n    .revx-component-toggle__field {\r\n        flex-direction: row-reverse;\r\n        justify-content: space-between;\r\n    }\r\n}",'.revx-double-order-trigger {\r\n\tpadding-top: 20px;\r\n\tborder-top: 1px solid map-get($neutral-colors, "neutral-200");\r\n\tpadding-bottom: 20px;\r\n\t.revx-trigger-product__group {\r\n\t\tpadding-top: 20px;\r\n\t}\r\n}\r\n\r\n.revx-double-order-message-container {\r\n\tflex: 1;\r\n    .revx-countdown-timer {\r\n        margin-left: 4px;\r\n    }\r\n}\r\n// Double Order\r\n.revx-double-order__container {\r\n\tborder-style: dashed !important;\r\n\tmargin-bottom: 12px;\r\n}\r\n.revx-campaign-double_order.revx-extra-features {\r\n\tpadding-top: 0px;\r\n\tmargin-top: 20px;\r\n\t.revx-accordion.revx-countdown-timer {\r\n\t\tborder-top: none;\r\n\t}\r\n}\r\n\r\n.revx-campaign-double-order {\r\n\t.revx-campaign-placement__tab-direction-shape {\r\n\t\tdisplay: none;\r\n\t}\r\n}\r\n\r\n.revx-double-order-offer-text {\r\n\tgrid-column: 1 / -1;\r\n\tmargin-top: 8px;\r\n}\r\n\r\n.revx-campaign-double-order .revx-double-order-discount-offers {\r\n\tgrid-template-columns: 88px 130px 1fr auto !important;\r\n}\r\n\r\n.revx-countdown-timer-prefix {\r\n\tmargin-right: inherit;\r\n}\r\n\r\n.revx-double-order-success-message {\r\n\tborder-bottom: 1px solid #e2e4e9;\r\n}\r\n\r\n.revx-campaign-double_order {\r\n\t.revx-accordion.revx-double-order-success-message {\r\n\t\tborder-top: none !important;\r\n\t}\r\n\t.revx-accordion.revx-double-order-success-message.active {\r\n\t\tmargin-bottom: 0px !important;\r\n\t}\r\n\t.revx-double-order-success-message .revx-help-message {\r\n\t\tmargin-top: 8px;\r\n\t\tpadding-bottom: 16px;\r\n\t}\r\n}\r\n\r\n/*============== Shake Animation ==============*/\r\n.revx-double-order-animation {\r\n\t&-shake {\r\n\t\tanimation: revx-double-order-animation-shake\r\n\t\t\tvar(--revx-double-order-animation-duration, 1s) ease-in-out infinite;\r\n\t}\r\n\t&-tada {\r\n\t\tanimation: revx-double-order-animation-tada\r\n\t\t\tvar(--revx-double-order-animation-duration, 1.5s) ease-in-out infinite;\r\n\t}\r\n\t&-pulse {\r\n\t\tanimation: revx-double-order-animation-pulse\r\n\t\t\tvar(--revx-double-order-animation-duration, 1s) ease-in-out infinite;\r\n\t}\r\n\t&-swing {\r\n\t\tanimation: revx-double-order-animation-swing\r\n\t\t\tvar(--revx-double-order-animation-duration, 1.5s) ease-in-out infinite;\r\n\t\ttransform-origin: top center;\r\n\t}\r\n\t&-bounce {\r\n\t\tanimation: revx-double-order-animation-bounce\r\n\t\t\tvar(--revx-double-order-animation-duration, 1s) ease-in-out infinite;\r\n\t}\r\n}\r\n\r\n\r\n@keyframes revx-double-order-animation-shake {\r\n\t0%,\r\n\t100% {\r\n\t\ttransform: translateX(0);\r\n\t}\r\n\t25% {\r\n\t\ttransform: translateX(-10px);\r\n\t}\r\n\t75% {\r\n\t\ttransform: translateX(10px);\r\n\t}\r\n}\r\n\r\n/*============== Tada Animation ==============*/\r\n@keyframes revx-double-order-animation-tada {\r\n\t0% {\r\n\t\ttransform: scale3d(1, 1, 1);\r\n\t}\r\n\t15%,\r\n\t25% {\r\n\t\ttransform: scale3d(.95, .95, .95) rotate3d(0, 0, 1, -2deg);\r\n\t}\r\n\t35%,\r\n\t55%,\r\n\t75%,\r\n\t95% {\r\n\t\ttransform: scale3d(1.05, 1.05, 1.05) rotate3d(0, 0, 1, 2deg);\r\n\t}\r\n\t45%,\r\n\t65%,\r\n\t85% {\r\n\t\ttransform: scale3d(1.05, 1.05, 1.05) rotate3d(0, 0, 1, -2deg);\r\n\t}\r\n\t100% {\r\n\t\ttransform: scale3d(1, 1, 1);\r\n\t}\r\n}\r\n\r\n/*============== Pulse Animation ==============*/\r\n@keyframes revx-double-order-animation-pulse {\r\n\t0% {\r\n\t\ttransform: scale(1);\r\n\t}\r\n\r\n\t50% {\r\n\t\ttransform: scale(1.03);\r\n\t}\r\n\r\n\t100% {\r\n\t\ttransform: scale(1);\r\n\t}\r\n}\r\n\r\n/*============== Swing Animation ==============*/\r\n@keyframes revx-double-order-animation-swing {\r\n\t0% {\r\n\t\ttransform: rotate(0);\r\n\t}\r\n\t25% {\r\n\t\ttransform: rotate(5deg);\r\n\t}\r\n\t75% {\r\n\t\ttransform: rotate(-5deg);\r\n\t}\r\n\t100% {\r\n\t\ttransform: rotate(0);\r\n\t}\r\n}\r\n\r\n/*============== Bounce Animation ==============*/\r\n@keyframes revx-double-order-animation-bounce {\r\n\t0%,\r\n\t100% {\r\n\t\ttransform: translateY(0);\r\n\t}\r\n\t50% {\r\n\t\ttransform: translateY(-20px);\r\n\t}\r\n}\r\n',"\r\n// Spending Goal Settings\r\n.revx-spending-goal-settings-data {\r\n\tpadding: 20px !important;\r\n}\r\n\r\n.revx-spending-goal-complete-message {\r\n\tlabel {\r\n\t\tcolor: map-get($neutral-colors, \"neutral-500\");\r\n\t}\r\n}\r\n\r\n.revx-spending-goal-progress-bar {\r\n\tmargin-bottom: 20px;\r\n\tdisplay: flex;\r\n\tflex-direction: column;\r\n\tgap: 16px;\r\n\r\n\t.revx-spending-goal-progress-bar-icon {\r\n\t\tcolor: map-get($neutral-colors, \"neutral-900\");\r\n\t}\r\n\t.revx-component-toggle__field {\r\n\t\tflex-direction: row-reverse;\r\n\t\tjustify-content: space-between;\r\n\t}\r\n}\r\n\r\n.revx-progress-bar {\r\n\tposition: relative;\r\n\twidth: 100%;\r\n\t// padding-top: 2rem;\r\n}\r\n\r\n.revx-progress-line {\r\n\theight: 8px;\r\n\tbackground-color: #f6f8fa;\r\n\twidth: 100%;\r\n\tborder-radius: 16px;\r\n}\r\n\r\n\r\n.revx-progress-steps-container {\r\n\t// display: flex;\r\n\t// justify-content: space-between;\r\n\tposition: absolute;\r\n\ttranslate: 0 calc(-50% + 8px);\r\n}\r\n\r\n.revx-progress-step {\r\n\tdisplay: flex;\r\n\tflex-direction: column;\r\n\t// align-items: center;\r\n\tgap: 0.5rem;\r\n\twidth: max-content;\r\n\tz-index: 99;\r\n}\r\n\r\n.revx-progress-step-icon-container {\r\n\twidth: 44px;\r\n\theight: 44px;\r\n\tborder-radius: 50%;\r\n\tdisplay: flex;\r\n\talign-items: center;\r\n\tjustify-content: center;\r\n\tbackground-color: #f6f8fa;\r\n\tcolor: #0a0d14;\r\n\ttransition: all 0.3s ease;\r\n}\r\n.revx-progress-step-icon-container.small {\r\n    height: 32px;\r\n    width:32px;\r\n}\r\n\r\n.revx-progress-step-icon-container.completed {\r\n\tbackground-color: #6e3ff3;\r\n\tcolor: white;\r\n}\r\n.revx-progress-step-icon-container.start {\r\n\talign-self: flex-start;\r\n}\r\n.revx-progress-step-icon-container.last {\r\n\talign-self: flex-end;\r\n}\r\n\r\n.revx-progress-step-label {\r\n\tfont-size: 0.875rem;\r\n\tfont-weight: 500;\r\n\tcolor: #374151;\r\n}\r\n\r\n.revx-progress-step.middle {\r\n\talign-items: center;\r\n}\r\n\r\n.revx-spending-goal-reward-message-wrapper {\r\n\tdisplay: flex;\r\n\talign-items: center;\r\n\tgap: 8px;\r\n}\r\n\r\n.revx-spending-goal-messages-container {\r\n\tgap: 12px;\r\n\tdisplay: flex;\r\n\tflex-direction: column;\r\n\tmargin-left: -5px;\r\n}\r\n\r\n.revx-spending-goal-gift-wrapper {\r\n\t// opacity: 0;\r\n}\r\n\r\n// Spending goal gift\r\n.revx-spending-goal-gift {\r\n\tbackground: #ffffff;\r\n\t// border-radius: 2px;\r\n\t// padding: 8px;\r\n\tbox-shadow: 0px 16px 32px -12px #585C5F1A;\r\n\twidth: 250px;\r\n\r\n    display: flex;\r\n    flex-direction: column;\r\n\tpadding: 8px;\r\n\r\n\ttranslate: -45%;\r\n\t&__item {\r\n\t\tdisplay: flex;\r\n\t\talign-items: center;\r\n\t\t// padding: 16px;\r\n\r\n\t\t&:not(:last-child) {\r\n\t\t\tmargin-bottom: 12px;\r\n\t\t}\r\n\r\n\t\t&:last-child {\r\n\t\t\tborder-bottom: none;\r\n\t\t}\r\n\r\n\t}\r\n\r\n\t&__image-container {\r\n\t\tmax-width: 56px;\r\n\t\tmax-height: 56px;\r\n\t\tflex-shrink: 0;\r\n\t\tmargin-right: 8px;\r\n\t}\r\n\r\n\t&__image {\r\n\t\twidth: 100%;\r\n\t\theight: 100%;\r\n\t\tobject-fit: contain;\r\n\t}\r\n\r\n\t&__content {\r\n\t\tflex: 1;\r\n\t\tdisplay: flex;\r\n\t\tflex-direction: column;\r\n\t\tjustify-content: space-between;\r\n\t\tgap:4px\r\n\t}\r\n\r\n\t&__title {\r\n\t\tfont-size: 12px;\r\n\t\tfont-weight: 500;\r\n\t\tcolor: map-get($neutral-colors, 'neutral-900');\r\n\t\ttext-align: left;\r\n\t}\r\n\r\n\t&__price {\r\n\t\tfont-size: 12px;\r\n\t\tcolor: rgb(0, 164, 100);\r\n\t}\r\n\r\n\t&__heading{\r\n\t\tfont-size: 14px;\r\n\t\tfont-weight: 500;\r\n\t\tline-height: 20px;\r\n\t\tcolor: map-get($neutral-colors, 'neutral-900');\r\n\t\tmargin-bottom: 16px;\r\n\t}\r\n\r\n\t&__action{\r\n\t\theight: 28px;\r\n\t\twidth: 28px;\r\n\t\tbackground-color: map-get($neutral-colors, 'neutral-100') ;\r\n\t\tcolor: map-get($neutral-colors, 'neutral-500') ;\r\n\t\tborder-radius: 50%;\r\n\t\tdisplay: flex;\r\n\t\talign-items: center;\r\n\t\tjustify-content: center;\r\n\r\n\t\t&:hover{\r\n\t\t\tbackground-color: map-get($neutral-colors, 'neutral-900') ;\r\n\t\t\tcolor: map-get($neutral-colors, 'neutral-0') ;\r\n\t\t\tcursor: pointer;\r\n\t\t}\r\n\t}\r\n\r\n}\r\n.revx-spending-goal {\r\n\t// .revx-progress-bar-container {\r\n\t// \theight: unset !important;\r\n\t// }\r\n\r\n\t&.top, &.bottom {\r\n\t\t.revx-progress-bar {\r\n\t\t\tmargin-bottom: 16px;\r\n\t\t}\r\n\t}\r\n\t&.inpage {\r\n\t\t.revx-progress-bar {\r\n\t\t\tmargin-bottom: 16px;\r\n\t\t}\r\n\t\t.revx-spg-up-slider {\r\n\t\t\tpadding-bottom: 0px;\r\n\t\t}\r\n\t}\r\n}\r\n\r\n\r\n.revx-spg-up-slider {\r\n\tposition: relative;\r\n\twidth: 100%;\r\n\tmax-width: 560px;\r\n\tmargin: 0 auto;\r\n\toverflow: hidden;\r\n\tdisplay: flex;\r\n\talign-items: center;\r\n\tpadding-bottom: 16px;\r\n\r\n\t.revx-price-container {\r\n\t\tmargin-left: 0;\r\n\t}\r\n}\r\n\r\n.revx-spg-up-slider__button {\r\n\tbackground: white;\r\n\tdisplay: flex;\r\n\talign-items: center;\r\n\tjustify-content: center;\r\n\tcursor: pointer;\r\n\tfont-size: 24px;\r\n\tz-index: 2;\r\n\ttransition: all 0.3s ease;\r\n}\r\n\r\n.revx-spg-up-slider__content {\r\n\tflex: 1;\r\n\toverflow: hidden;\r\n}\r\n\r\n.revx-spg-up-slider__track {\r\n\tdisplay: flex;\r\n\ttransition: transform 0.3s ease-out;\r\n}\r\n\r\n.revx-spg-up-slider__track--animating {\r\n\ttransition: transform 0.3s ease-out;\r\n}\r\n\r\n\r\n\r\n.revx-spg-up-slider__card {\r\n\tflex: 0 0 100%;\r\n\tbox-sizing: border-box;\r\n\tdisplay: flex;\r\n\talign-items: center;\r\n\tjustify-content: center;\r\n}\r\n\r\n.revx-spg-up-slider__image {\r\n\tdisplay: flex;\r\n\tjustify-content: center;\r\n\theight: 48px;\r\n\twidth: 48px;\r\n\tmargin-right: 16px;\r\n}\r\n\r\n.revx-spg-up-slider__info {\r\n\ttext-align: center;\r\n\tdisplay: flex;\r\n\talign-items: center;\r\n\tjustify-content: space-between;\r\n\twidth: 100%;\r\n}\r\n.revx-spg-up-slider-meta {\r\n\tdisplay: flex;\r\n\tflex-direction: column;\r\n\ttext-align: left;\r\n\tgap: 4px;\r\n}\r\n\r\n.revx-spg-up-slider__title {\r\n\tfont-size: 14px;\r\n\tcolor: #0a0d14;\r\n}\r\n\r\n.revx-spg-up-slider__price-container {\r\n\t// margin-bottom: 15px;\r\n}\r\n\r\n.revx-spg-up-slider__original-price {\r\n\ttext-decoration: line-through;\r\n\tcolor: #999;\r\n\tmargin-right: 10px;\r\n}\r\n\r\n.revx-spg-up-slider__current-price {\r\n\tcolor: #2ecc71;\r\n\tfont-weight: bold;\r\n}\r\n\r\n.revx-spg-up-slider__add-to-cart {\r\n\tbackground: white;\r\n\tborder: 1px solid #e0e0e0;\r\n\tpadding: 8px 20px;\r\n\tborder-radius: 4px;\r\n\tcursor: pointer;\r\n\ttransition: all 0.3s ease;\r\n}\r\n\r\n.revx-spg-up-slider__add-to-cart:hover {\r\n\tbackground: #f5f5f5;\r\n}\r\n\r\n.revx-spg-drawer-open {\r\n\tdisplay: flex;\r\n\talign-items: center;\r\n\t// background-color: #F6F8FA;\r\n\tgap: 16px;\r\n\tposition: relative;\r\n\t.revx-progress-bar-container {\r\n\t\tflex: 1;\r\n\t}\r\n\t.revx-progress-line {\r\n\t\tbackground-color: white;\r\n\t}\r\n\t.revx-progress-step-icon-container {\r\n\t\tbackground-color: white;\r\n\t}\r\n\t.revx-progress-step-icon-container.completed {\r\n\t\tbackground-color: #6e3ff3;\r\n\t\tcolor: white;\r\n\t}\r\n\r\n\t.revx-spg-drawer-open-container {\r\n\t\tdisplay: flex;\r\n\t\tflex-direction: column;\r\n\t\tflex: 1;\r\n\t\tgap: 12px;\r\n\t}\r\n\t.revx-spg-close-drawer-icon {\r\n\t\tposition: absolute;\r\n\t\tright: 0;\r\n\t\ttop: -15px;\r\n\t}\r\n}\r\n\r\n.revx-spg-drawer-container.close{\r\n    overflow: hidden;\r\n}\r\n\r\n.revx-spg-drawer-container {\r\n    position: relative;\r\n    width: 100%;\r\n    // overflow: hidden;\r\n    margin-top: 15px;\r\n\r\n\t&.has_upsell{\r\n\t\t// height: 160px;\r\n\r\n\t\t.revx-spg-circular-progress-container  {\r\n\t\t\twidth: 116px !important;\r\n\t\t\theight: 172px !important;\r\n\t\t}\r\n\r\n\t\t.revx-spg-drawer-closed {\r\n\t\t\ttransform: translateX(calc(100% - 116px));\r\n\t\t}\r\n\t\t.revx-spg-drawer-details {\r\n\t\t\tgap: 0px !important;\r\n\t\t}\r\n\r\n\t\t.revx-spg-up-slider {\r\n\t\t\tpadding-bottom: 0px;\r\n\t\t}\r\n\r\n\t\t// .revx-spg-circular-progress {\r\n\t\t// \theight: 92px;\r\n\t\t// \twidth: 92px;\r\n\t\t// }\r\n\t}\r\n  }\r\n\r\n  .revx-spg-drawer-content {\r\n    display: flex;\r\n    position: relative;\r\n    width: 100%;\r\n    transition: all 0.3s ease-in-out;\r\n\r\n\r\n  }\r\n\r\n\r\n  .revx-spg-drawer-progress-section {\r\n    flex-shrink: 0;\r\n    transition: transform 0.3s ease-in-out;\r\n  }\r\n\r\n  .revx-spg-drawer-details {\r\n    flex-grow: 1;\r\n    opacity: 0;\r\n    transition: opacity 0.3s ease-in-out;\r\n    // overflow: hidden;\r\n    max-height: 0;\r\n  }\r\n\r\n  .revx-spg-drawer-close-icon {\r\n    position: absolute;\r\n    top: -16px;\r\n    right: 0;\r\n    cursor: pointer;\r\n    opacity: 0;\r\n    transition: opacity 0.3s ease-in-out;\r\n  }\r\n\r\n  .revx-spg-drawer-progress-bar {\r\n    width: 100%;\r\n  }\r\n\r\n  /* Open state */\r\n  .revx-spg-drawer-content.revx-spg-drawer-open {\r\n    transform: translateX(0);\r\n\r\n    .revx-spg-drawer-progress-section {\r\n      transform: translateX(0);\r\n    }\r\n