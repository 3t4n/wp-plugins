DACC,gBAAA,CAED,mCACC,qBAAA,CACA,oBAAA,CACA,6DACC,kBAAA,CACA,kBAAA,CASF,mCACC,yBAAA,CAGA,6BACC,qBAAA,CAED,8BACC,eAAA,CAGF,2BACO,iBAAA,CACA,oDACI,iBAAA,CACA,SAAA,CAAA,CAKZ,0CACC,sBACC,yBAAA,CAED,wDACC,UAAA,CAED,0CACC,eAAA,CAED,mCACC,sBAAA,CAED,4CACC,yBAAA,CAED,uCACC,yBAAA,CAED,sDACC,iBAAA,CAED,gDACC,qBAAA,CAED,6BACC,yBAAA,CAED,sBACC,qBAAA,CACA,mBAAA,CAGA,yCACC,cAAA,CACA,eAAA,CAED,uCACC,cAAA,CACA,eAAA,CAGF,yBACC,qBAAA,CAAA",sourcesContent:["/**\r\n * Revenue Global variables\r\n */\r\n @import url('https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap');\r\n $default-font:  \"Inter\", sans-serif;\r\n",'/*=================================\r\n    Alignment / Position\r\n===============================*/\r\n.revx-flex {\r\n\tdisplay: flex;\r\n}\r\n\r\n.revx-flex-wrap {\r\n\tflex-wrap: wrap;\r\n}\r\n\r\n.revx-flex-column {\r\n\tflex-direction: column;\r\n}\r\n\r\n.revx-disabled {\r\n\tbackground-color: map-get($neutral-colors, "neutral-300") !important;\r\n\tpointer-events: none;\r\n}\r\n\r\n.revx-gap-8 {\r\n\tgap: 8px;\r\n}\r\n.revx-gap-16 {\r\n\tgap: 16px;\r\n}\r\n.revx-mb-8 {\r\n\tmargin-bottom: 8px;\r\n}\r\n.revx-mb-16 {\r\n\tmargin-bottom: 16px;\r\n}\r\n.revx-mb-20 {\r\n\tmargin-bottom: 20px;\r\n}\r\n.revx-color-green-base {\r\n\tcolor: map-get($primary-colors, "green-base");\r\n\ta {\r\n\t\tcolor: inherit;\r\n\t\ttext-decoration: none;\r\n\t}\r\n}\r\n.revx-color-purple-base {\r\n\tcolor: map-get($vibrant-colors, "purple-base");\r\n}\r\n\r\n.revx-section-container {\r\n\tmax-width: 1600px;\r\n\tpadding: 0px 32px;\r\n\tbox-sizing: border-box;\r\n\tmargin-left: auto;\r\n\tmargin-right: auto;\r\n}\r\n\r\n.revx-align-stretch {\r\n\tdisplay: flex;\r\n\talign-items: stretch;\r\n}\r\n\r\n.revx-align-center {\r\n\t@include flexStyle(false, center);\r\n\t&-xl,\r\n\t&-lg,\r\n\t&-md,\r\n\t&-sm,\r\n\t&-xs {\r\n\t\t@include flexStyle(false, center);\r\n\t}\r\n\t&-xl {\r\n\t\tgap: 32px;\r\n\t}\r\n\t&-lg {\r\n\t\tgap: 24px;\r\n\t}\r\n\t&-md {\r\n\t\tgap: 16px;\r\n\t}\r\n\t&-sm {\r\n\t\tgap: 12px;\r\n\t}\r\n\t&-xs {\r\n\t\tgap: 8px;\r\n\t}\r\n}\r\n\r\n.revx-justify-center {\r\n\t@include flexStyle(center, center);\r\n\t&-lg,\r\n\t&-md,\r\n\t&-sm,\r\n\t&-xs {\r\n\t\t@include flexStyle(center, center);\r\n\t}\r\n\t&-lg {\r\n\t\tgap: 32px;\r\n\t}\r\n\t&-md {\r\n\t\tgap: 16px;\r\n\t}\r\n\t&-sm {\r\n\t\tgap: 12px;\r\n\t}\r\n\t&-xs {\r\n\t\tgap: 8px;\r\n\t}\r\n}\r\n\r\n.revx-justify-space {\r\n\t@include flexStyle(space-between, center);\r\n\t&-lg,\r\n\t&-md,\r\n\t&-sm,\r\n\t&-xs {\r\n\t\t@include flexStyle(space-between, center);\r\n\t}\r\n\t&-lg {\r\n\t\tgap: 32px;\r\n\t}\r\n\t&-md {\r\n\t\tgap: 16px;\r\n\t}\r\n\t&-sm {\r\n\t\tgap: 12px;\r\n\t}\r\n\t&-xs {\r\n\t\tgap: 8px;\r\n\t}\r\n}\r\n\r\n.revx-gap {\r\n\t&-md {\r\n\t\tgap: 16px;\r\n\t}\r\n\t&-sm {\r\n\t\tgap: 12px;\r\n\t}\r\n\t&-xs {\r\n\t\tgap: 8px;\r\n\t}\r\n}\r\n\r\n.revx-space-nowrap {\r\n\twhite-space: nowrap;\r\n}\r\n\r\n.revx-builder-position {\r\n\t@include positionStyle(absolute, 0px, 0px);\r\n}\r\n\r\n/*=================================\r\n    Component Size / Structure\r\n===============================*/\r\n.revx-width-full {\r\n\twidth: 100%;\r\n}\r\n\r\n.revx-fill-width {\r\n\twidth: -moz-available; /* WebKit-based browsers will ignore this. */\r\n\twidth: -webkit-fill-available; /* Mozilla-based browsers will ignore this. */\r\n\twidth: fill-available;\r\n}\r\n.revx-width-80 {\r\n\twidth: 80%;\r\n}\r\n.revx-section-container {\r\n\tmax-width: 1600px;\r\n\tpadding: 0px 32px;\r\n\tbox-sizing: border-box;\r\n\tmargin-left: auto;\r\n\tmargin-right: auto;\r\n}\r\n\r\n/*============= common individual Section ====================*/\r\n.revx-section {\r\n\t&-lg,\r\n\t&-md,\r\n\t&-sm {\r\n\t\tborder-radius: 12px;\r\n\t\tbackground-color: map-get($neutral-colors, "neutral-0");\r\n\t\tbox-sizing: border-box;\r\n\t}\r\n\t&-lg {\r\n\t\tpadding: 20px 20px 24px;\r\n\t}\r\n\t&-md {\r\n\t\tpadding: 20px;\r\n\t}\r\n\t&-sm {\r\n\t\tpadding: 16px 20px 20px;\r\n\t}\r\n}\r\n\r\n/*============= Scrollbar Common Styles ====================*/\r\n.revx-scrollbar-lg {\r\n\t&::-webkit-scrollbar {\r\n\t\theight: 14px; /* for horizontal scrollbars */\r\n\t}\r\n}\r\n\r\n.revx-scrollbar-md {\r\n\t&::-webkit-scrollbar {\r\n\t\theight: 16px; /* for horizontal scrollbars */\r\n\t\twidth: 10px;\r\n\t}\r\n}\r\n\r\n.revx-scrollbar-md,\r\n.revx-scrollbar-lg {\r\n\t&::-webkit-scrollbar-track {\r\n\t\tbackground: map-get($neutral-colors, "neutral-200");\r\n\t\tborder-radius: 6px;\r\n\t}\r\n\t/* Handle (thumb) */\r\n\t&::-webkit-scrollbar-thumb {\r\n\t\tbackground: map-get($neutral-colors, "neutral-400");\r\n\t\tborder-radius: 6px;\r\n\t\tborder: 3px solid transparent;\r\n\t\tbackground-clip: content-box;\r\n\t\theight: 6px;\r\n\t\tcursor: grab;\r\n\t}\r\n\t/* Handle on hover */\r\n\t&::-webkit-scrollbar-thumb:hover {\r\n\t\tborder-radius: 6px;\r\n\t\tborder: 3px solid transparent;\r\n\t\tbackground-clip: content-box;\r\n\t\theight: 6px;\r\n\t\tbackground-color: map-get($primary-colors, "green-base") !important;\r\n\t}\r\n}\r\n\r\n/*=================================\r\n    Appearance\r\n===============================*/\r\n.revx-color-green-base {\r\n\tcolor: map-get($primary-colors, "green-base");\r\n\ta {\r\n\t\tcolor: inherit;\r\n\t\ttext-decoration: none;\r\n\t}\r\n}\r\n\r\n.revx-color-purple-base {\r\n\tcolor: map-get($vibrant-colors, "purple-base");\r\n}\r\n\r\n.revx-required {\r\n\tcolor: map-get($vibrant-colors, "red-base");\r\n}\r\n\r\ninput.revx-hide-placeholder::placeholder {\r\n\tcolor: transparent !important;\r\n}\r\n\r\n.revx-disabled {\r\n\tbackground-color: map-get($neutral-colors, "neutral-300") !important;\r\n\tpointer-events: none;\r\n}\r\n\r\n/*============= Disable Style ====================*/\r\n.revx-field-disabled {\r\n\tinput {\r\n\t\tcursor: not-allowed !important;\r\n\t\tbackground-color: map-get($neutral-colors, "neutral-100") !important;\r\n\t}\r\n\t.revx-loop-container,\r\n\t.revx-loop-container label {\r\n\t\tcursor: not-allowed !important;\r\n\t}\r\n}\r\n\r\n/*============= Box Shadow Style ====================*/\r\n.revx-shadow {\r\n\t&-xlg {\r\n\t\tbox-shadow: $shadow-xlg;\r\n\t}\r\n\t&-lg {\r\n\t\tbox-shadow: $shadow-lg;\r\n\t}\r\n\t&-md {\r\n\t\tbox-shadow: $shadow-md;\r\n\t}\r\n\t&-sm {\r\n\t\tbox-shadow: $shadow-sm;\r\n\t}\r\n\t&-xs {\r\n\t\tbox-shadow: $shadow-xs;\r\n\t}\r\n\t&-vxs {\r\n\t\tbox-shadow: $shadow-vxs;\r\n\t}\r\n}\r\n\r\n/*=================================\r\n    Utilities/Extra\r\n===============================*/\r\n.revx-spinner {\r\n\t--mask: conic-gradient(#0000 10%, #000),\r\n\t\tlinear-gradient(#000 0 0) content-box;\r\n\twidth: 10px;\r\n\tpadding: 3px;\r\n\taspect-ratio: 1;\r\n\tborder-radius: 50%;\r\n\tbackground: map-get($primary-colors, "green-light");\r\n\t-webkit-mask: var(--mask);\r\n\tmask: var(--mask);\r\n\t-webkit-mask-composite: source-out;\r\n\tmask-composite: subtract;\r\n\tanimation: revxSpinnerAnimation 1s infinite linear;\r\n}\r\n\r\n@keyframes revxSpinnerAnimation {\r\n\tto {\r\n\t\ttransform: rotate(1turn);\r\n\t}\r\n}\r\n\r\n/*=========== Loading Spinner ====================*/\r\n.revx-cursor-pointer {\r\n\tcursor: pointer;\r\n}\r\n\r\n/* Include the CSS code here */\r\ninput[type="number"]::-webkit-outer-spin-button,\r\ninput[type="number"]::-webkit-inner-spin-button {\r\n\t-webkit-appearance: none;\r\n\tmargin: 0;\r\n}\r\n\r\ninput[type="number"],\r\ninput[type="number"] {\r\n\t-moz-appearance: textfield;\r\n\t-ms-appearance: textfield;\r\n}\r\n\r\n/*=========== Full width Compatibility ====================*/\r\n// #toplevel_page_revenue  .wp-menu-image > img  {\r\n//     padding: 5px 0px 0px 0px !important;paddingpaddingpadding\r\n// }\r\n\r\n/*=========== Text Ellipsis style  ====================*/\r\n.revx-campaign-product-title {\r\n\tline-height: 1.4;\r\n}\r\n\r\n.revx-text-ellipsis,\r\n.revx-product-title {\r\n\tdisplay: block;\r\n\t-webkit-box-orient: vertical;\r\n\t-webkit-line-clamp: 1;\r\n\toverflow: hidden;\r\n\ttext-overflow: ellipsis;\r\n\tline-height: 1.2em;\r\n\twhite-space: nowrap;\r\n\tspan {\r\n\t\tdisplay: -webkit-box !important;\r\n\t\tdisplay: -moz-box !important;\r\n\t\t-webkit-box-orient: vertical;\r\n\t\t-webkit-line-clamp: 1;\r\n\t\toverflow: hidden;\r\n\t\ttext-overflow: ellipsis;\r\n\t\tline-height: 1.2em;\r\n\t\twhite-space: nowrap;\r\n\t}\r\n}\r\n.revx-text-ellipsis {\r\n\t&-line-2 {\r\n\t\t@extend .revx-text-ellipsis;\r\n\t\t-webkit-line-clamp: 2;\r\n\t\twhite-space: normal;\r\n\t}\r\n}\r\n','/*============= Flex Style ====================*/\r\n@mixin flexStyle($justify: false, $align: false, $direction: false) {\r\n    display: flex !important;\r\n\t@if $justify {\r\n\t\tjustify-content: $justify;\r\n\t}\r\n    @if $align {\r\n\t\talign-items: $align;\r\n\t}\r\n\t@if $direction {\r\n\t\tflex-direction: $direction;\r\n\t}\r\n}\r\n\r\n/*============= Typography Style ====================*/\r\n@mixin typographyStyle($size: 12px, $lineHeight, $spacing: false, $weight: false, $transformation: false) {\r\n    font-size: $size !important;\r\n    font-style: normal;\r\n    @if $lineHeight {\r\n        line-height: $lineHeight !important;\r\n    }\r\n    @if $spacing {\r\n        // letter-spacing: $spacing;\r\n    }\r\n    @if $weight {\r\n        font-weight: $weight;\r\n    }\r\n    @if $transformation {\r\n        text-transform: $transformation !important;\r\n    }\r\n}\r\n\r\n// @include positionStyle(center, center);\r\n/*============= Position Style ====================*/\r\n@mixin positionStyle($style, $top: false, $left: false, $right: false, $bottom: false) {\r\n    position: $style;\r\n    @if $top {\r\n        top: $top;\r\n    }\r\n    @if $left {\r\n        left: $left;\r\n    }\r\n    @if $right {\r\n        right: $right;\r\n    }\r\n    @if $bottom {\r\n        bottom: $bottom;\r\n    }\r\n}\r\n\r\n/*============= Button Style ====================*/\r\n@mixin buttonColor(  $bg-color, $text-color: false, $border-color: false, $svg-color: false, $solidBtn: true ) {\r\n\t@if $border-color {\r\n\t\tborder-color: $border-color;\r\n\t} @else {\r\n\t\tborder-color: $bg-color;\r\n\t}\r\n\t@if $solidBtn {\r\n\t\tbackground: $bg-color;\r\n\t\t@if $text-color {\r\n\t\t\tcolor: $text-color;\r\n\t\t}\r\n\t\t@if $svg-color {\r\n\t\t\tsvg, path {\r\n\t\t\t\tstroke: $svg-color;\r\n\t\t\t}\r\n\t\t}\r\n    } @else {\r\n        color: $bg-color;\r\n\t\tbackground-color: transparent !important;\r\n\t\t@if $svg-color {\r\n\t\t\tsvg, path {\r\n\t\t\t\tstroke: $svg-color;\r\n\t\t\t}\r\n\t\t}\r\n    }\r\n}\r\n\r\n/*============= Button Hover Style ====================*/\r\n@mixin buttonHoverColor( $bg-color, $text-color, $border-color: false, $solidBtn: true, $svgColor: false ) {\r\n\t&:hover {\r\n\t\t@if $border-color {\r\n\t\t\tborder-color: $border-color;\r\n\t\t} @else {\r\n\t\t\tborder-color: $bg-color;\r\n\t\t}\r\n        @if $solidBtn {\r\n\t\t\tcolor: $text-color;\r\n\t\t\tbackground: $bg-color;\r\n\t\t\t@if $svgColor {\r\n\t\t\t\tsvg, path {\r\n\t\t\t\t\tstroke: $text-color;\r\n\t\t\t\t}\r\n\t\t\t}\r\n        } @else {\r\n            color: $bg-color;\r\n\t\t\t@if $svgColor {\r\n\t\t\t\tsvg, path {\r\n\t\t\t\t\tstroke: $bg-color;\r\n\t\t\t\t}\r\n\t\t\t}\r\n        }\r\n\t}\r\n}\r\n\r\n/*============= Button Focus Style ====================*/\r\n@mixin buttonFocusColor(  $button-color, $button-focus-border-color, $button-text-color, $solidBtn: true, $svgColor: true ) {\r\n\t&:focus {\r\n\t\tborder-color: $button-focus-border-color;\r\n        @if $solidBtn == false {\r\n\t\t\tcolor: $button-text-color;\r\n            background-color: $button-color !important;\r\n\t\t\t@if $svgColor {\r\n\t\t\t\tsvg, path {\r\n\t\t\t\t\tstroke: $button-text-color;\r\n\t\t\t\t}\r\n\t\t\t}\r\n        }\r\n\t}\r\n}\r\n\r\n/*============= Button Active Style ====================*/\r\n@mixin buttonActiveColor( $button-active-color, $solidBtn: true, $svgColor: true ) {\r\n\t&:active {\r\n        border-color: $button-active-color;\r\n        @if $solidBtn == false {\r\n            color: $button-active-color;\r\n            background: none !important;\r\n\t\t\t@if $svgColor {\r\n\t\t\t\tsvg, path {\r\n\t\t\t\t\tstroke: $button-active-color;\r\n\t\t\t\t}\r\n\t\t\t}\r\n        }\r\n\t}\r\n}\r\n\r\n\r\n@mixin revx-appearance-textField {\r\n\t&::-webkit-outer-spin-button,\r\n\t&::-webkit-inner-spin-button {\r\n\t\t-webkit-appearance: none;\r\n\t}\r\n}\r\n\r\n/*============= Button  Style ====================*/\r\n@mixin buttonStyle( $button-color, $button-focus-border-color, $button-text-color,$button-hover-color,$button-active-color, $button-disabled-color, $solidBtn: true ) {\r\n    border-color: $button-color;\r\n\r\n    @if $solidBtn {\r\n        background: $button-color;\r\n        color: $button-text-color;\r\n    } @else {\r\n        color: $button-color;\r\n    }\r\n\t&:focus {\r\n        @if $solidBtn {\r\n            color: $button-text-color;\r\n\t\t    border-color: $button-focus-border-color;\r\n        } @else {\r\n            background: $button-disabled-color;\r\n            color: $button-color;\r\n\t\t    border-color: $button-color;\r\n        }\r\n\t}\r\n\t&:active {\r\n        border-color: $button-active-color;\r\n        @if $solidBtn {\r\n            color: $button-text-color;\r\n            background: $button-active-color;\r\n        } @else {\r\n            color: $button-active-color;\r\n            background: none;\r\n        }\r\n\t}\r\n\t&:disabled {\r\n        border-color: $button-disabled-color;\r\n        @if $solidBtn {\r\n\t\t    color: $button-text-color;\r\n            background: $button-disabled-color;\r\n        } @else {\r\n\t\t    color: $button-disabled-color;\r\n        }\r\n\t}\r\n}\r\n\r\n/**\r\n * Allows users to opt-out of animations via OS-level preferences.\r\n */\r\n\r\n@mixin reduce-motion($property: "") {\r\n\t@if $property == "transition" {\r\n\t\t@media (prefers-reduced-motion: reduce) {\r\n\t\t\ttransition-duration: 0s;\r\n\t\t\ttransition-delay: 0s;\r\n\t\t}\r\n\t} @else if $property == "animation" {\r\n\t\t@media (prefers-reduced-motion: reduce) {\r\n\t\t\tanimation-duration: 1ms;\r\n\t\t\tanimation-delay: 0s;\r\n\t\t}\r\n\t} @else {\r\n\t\t@media (prefers-reduced-motion: reduce) {\r\n\t\t\ttransition-duration: 0s;\r\n\t\t\ttransition-delay: 0s;\r\n\t\t\tanimation-duration: 1ms;\r\n\t\t\tanimation-delay: 0s;\r\n\t\t}\r\n\t}\r\n}\r\n\r\n@mixin modal-fade-in-animation($speed: 0.2s, $delay: 0s) {\r\n\tanimation: modal-fade-in-animation $speed ease-out $delay;\r\n\tanimation-fill-mode: forwards;\r\n\t@include reduce-motion("animation");\r\n}\r\n/**\r\n * Reset default styles for JavaScript UI based pages.\r\n * This is a WP-admin agnostic reset\r\n */\r\n\r\n@mixin reset {\r\n\tbox-sizing: border-box;\r\n\t*,\r\n\t*::before,\r\n\t*::after {\r\n\t\tbox-sizing: inherit;\r\n\t}\r\n}\r\n\r\n// @mixin custom-scrollbars-on-hover($handle-color, $handle-color-hover) {\r\n// \t// WebKit\r\n// \t&::-webkit-scrollbar {\r\n// \t\twidth: 12px;\r\n// \t\theight: 12px;\r\n// \t}\r\n// \t&::-webkit-scrollbar-track {\r\n// \t\tbackground-color: transparent;\r\n// \t}\r\n// \t&::-webkit-scrollbar-thumb {\r\n// \t\tbackground-color: $handle-color;\r\n// \t\tborder-radius: 8px;\r\n// \t\tborder: 3px solid transparent;\r\n// \t\tbackground-clip: padding-box;\r\n// \t}\r\n// \t&:hover::-webkit-scrollbar-thumb, // This needs specificity.\r\n// \t&:focus::-webkit-scrollbar-thumb,\r\n// \t&:focus-within::-webkit-scrollbar-thumb {\r\n// \t\tbackground-color: $handle-color-hover;\r\n// \t\tdisplay: flex !important;\r\n// \t\tjustify-content: $justify;\r\n// \t\talign-items: $align;\r\n//     }\r\n// }\r\n\r\n\r\n// @mixin buttonActiveColor(   $button-disabled-color, $button-text-color, $solidBtn: true ) {\r\n// \t&:disabled {\r\n//         border-color: $button-disabled-color;\r\n//         @if $solidBtn {\r\n// \t\t\tcolor: $button-text-color;\r\n//             background: $button-disabled-color;\r\n//         } @else {\r\n// \t\t\tcolor: $button-disabled-color;\r\n//         }\r\n// \t}\r\n// }',"$neutral-colors: (\r\n  neutral-900: #0a0d14,\r\n  neutral-800: #161922,\r\n  neutral-700: #20232d,\r\n  neutral-600: #31353f,\r\n  neutral-500: #525866,\r\n  neutral-400: #868c98,\r\n  neutral-300: #cdd0d5,\r\n  neutral-200: #e2e4e9,\r\n  neutral-100: #f6f8fa,\r\n  neutral-0: #ffffff\r\n);\r\n// map-get($neutral-colors, 'neutral-400');\r\n\r\n$primary-colors: (\r\n  green-darker: #003021,\r\n  green-dark: #005539,\r\n  green-base: #00a464,\r\n  green-light: #a0facb,\r\n  green-lighter: #eafff4\r\n);\r\n// map-get($primary-colors, 'green-base')\r\n\r\n$vibrant-colors: (\r\n  orange-darker: #6e330c,\r\n  orange-dark: #c2540a,\r\n  orange-base: #f17b2c,\r\n  orange-light: #ffdac2,\r\n  orange-lighter: #fef3eb,\r\n\r\n  yellow-darker: #693d11,\r\n  yellow-dark: #b47818,\r\n  yellow-base: #f2ae40,\r\n  yellow-light: #fbdfb1,\r\n  yellow-lighter: #fef7ec,\r\n\r\n  red-darker: #710e21,\r\n  red-dark: #af1d38,\r\n  red-base: #df1c41,\r\n  red-light: #f8c9d2,\r\n  red-lighter: #fdeef0,\r\n\r\n  blue-darker: #1b248d,\r\n  blue-dark: #1827dd,\r\n  blue-base: #375dfb,\r\n  blue-light: #dae3ff,\r\n  blue-lighter: #eff3ff,\r\n\r\n  purple-darker: #2b1664,\r\n  purple-dark: #5a36bf,\r\n  purple-base: #6e3ff3,\r\n  purple-light: #cac2ff,\r\n  purple-lighter: #eeebff,\r\n\r\n  pink-darker: #620f6c,\r\n  pink-dark: #9c23a9,\r\n  pink-base: #e255f2,\r\n  pink-light: #f9c2ff,\r\n  pink-lighter: #fdebeb,\r\n\r\n  teal-darker: #164564,\r\n  teal-dark: #1f87ad,\r\n  teal-base: #35b9e9,\r\n  teal-light: #c2efff,\r\n  teal-lighter: #ebfaff,\r\n  \r\n  green-darker: #003021,\r\n  green-dark: #005539,\r\n  green-base: #00a464,\r\n  green-light: #a0facb,\r\n  green-lighter: #eafff4\r\n);\r\n// map-get($vibrant-colors, 'blue-darker')\r\n\r\n// Light color\r\n$shadow-vxs: 0px 1px 2px 0px rgba(228, 229, 231, 0.24);\r\n$shadow-xs: 0px 2px 4px 0px rgba(27, 28, 29, 0.04);\r\n$shadow-sm :  0px 16px 32px -12px rgba(88, 92, 95, 0.1);\r\n$shadow-md :  0px 16px 40px -8px rgba(88, 92, 95, 0.16);\r\n$shadow-lg :  0px 24px 56px -4px rgba(88, 92, 95, 0.16);\r\n$shadow-xlg :  0px 40px 96px -8px rgba(88, 92, 95, 0.2);\r\n","/*\r\nReset Browser Default Style\r\n*/\r\n\r\nhtml,\r\nbody,\r\ndiv,\r\nspan,\r\napplet,\r\nobject,\r\niframe,\r\n// h1,\r\n// h2,\r\n// h3,\r\n// h4,\r\n// h5,\r\n// h6,\r\np,\r\nblockquote,\r\npre,\r\na,\r\nabbr,\r\nacronym,\r\naddress,\r\nbig,\r\ncite,\r\ncode,\r\ndel,\r\ndfn,\r\nem,\r\nimg,\r\nins,\r\nkbd,\r\nq,\r\ns,\r\nsamp,\r\nsmall,\r\n// strike,\r\n// strong,\r\nsub,\r\nsup,\r\ntt,\r\nvar,\r\nb,\r\nu,\r\n// i,\r\ncenter,\r\ndl,\r\ndt,\r\ndd,\r\nol,\r\nul,\r\nli,\r\nfieldset,\r\nform,\r\nlabel,\r\nlegend,\r\ntable,\r\ncaption,\r\ntbody,\r\ntfoot,\r\nthead,\r\ntr,\r\nth,\r\ntd,\r\narticle,\r\naside,\r\ncanvas,\r\ndetails,\r\nembed,\r\nfigure,\r\nfigcaption,\r\nfooter,\r\nheader,\r\nhgroup,\r\nmenu,\r\nnav,\r\noutput,\r\nruby,\r\nsection,\r\nsummary,\r\ntime,\r\nmark,\r\naudio,\r\nvideo {\r\n\tmargin: 0;\r\n\tpadding: 0;\r\n\tborder: 0;\r\n\tfont-size: 100%;\r\n\t// font: inherit;\r\n\tvertical-align: baseline;\r\n}\r\n\r\n/* HTML5 display-role reset for older browsers */\r\narticle,\r\naside,\r\ndetails,\r\nfigcaption,\r\nfigure,\r\nfooter,\r\nheader,\r\nhgroup,\r\nmenu,\r\nnav,\r\nsection {\r\n\tdisplay: block;\r\n}\r\n\r\nbody {\r\n\tline-height: 1;\r\n}\r\n\r\nol,\r\nul {\r\n\tlist-style: none;\r\n}\r\n\r\nblockquote,\r\nq {\r\n\tquotes: none;\r\n}\r\n\r\nblockquote:before,\r\nblockquote:after,\r\nq:before,\r\nq:after {\r\n\tcontent: '';\r\n\tcontent: none;\r\n}\r\n\r\ntable {\r\n\tborder-collapse: collapse;\r\n\tborder-spacing: 0;\r\n}\r\n\r\nbody.toplevel_page_revenue  {\r\n\tbackground-color: map-get($neutral-colors, 'neutral-100');\r\n\t#wpcontent {\r\n\t\tpadding-left: 0px !important;\r\n\t}\r\n}\r\n.toplevel_page_revenue #wpcontent, .toplevel_page_revenue #wpbody-content {\r\n    padding: 0;\r\n    // overflow-x: hidden !important;\r\n    // min-height: calc(100vh - 32px);\r\n}\r\n",'.toplevel_page_revenue  {\r\n    font-family: $default-font;\r\n    $font-weights: (\r\n        "bold": 700,\r\n        "semibold": 600,\r\n        "medium": 500,\r\n        "normal": 400,\r\n        "light": 300\r\n    );\r\n\r\n    // Loop through font weight map\r\n    @each $name, $weight in $font-weights {\r\n        .revx-weight-#{$name}, .revx-weight-#{$weight} {\r\n        font-weight: $weight;\r\n        }\r\n    }\r\n    // Heading\r\n    .revx-heading {\r\n        // Font Size, Line Height, Letter Spacing\r\n        &--h1 {\r\n            @include typographyStyle(56px, 1.14, -0.48px);\r\n        }\r\n        &--h2 {\r\n            @include typographyStyle(48px, 1.17, -0.42px);\r\n        }\r\n        &--h3 {\r\n            @include typographyStyle(40px, 1.2, -0.4px);\r\n        }\r\n        &--h4 {\r\n            @include typographyStyle(32px, 1.25, normal);\r\n        }\r\n        &--h5 {\r\n            @include typographyStyle(24px, 1.33, normal);\r\n        }\r\n        &--h6 {\r\n            @include typographyStyle(20px, 1.4, normal);\r\n        }\r\n    }\r\n    // Subheading\r\n    .revx-subheading {\r\n        &--md {\r\n            @include typographyStyle(16px, 1.5, 0.96px);\r\n        }\r\n        &--sm {\r\n            @include typographyStyle(14px, 1.43, 0.84px);\r\n        }\r\n        &--xs {\r\n            @include typographyStyle(12px, 1.33, 0.48px);\r\n        }\r\n        &--xxs {\r\n            @include typographyStyle(11px, 1.09, 0.22px);\r\n        }\r\n    }\r\n\r\n    .revx-label {\r\n        &--xl {\r\n            @include typographyStyle(24px, 1.33, -0.36px);\r\n        }\r\n\r\n        &--lg {\r\n            @include typographyStyle(18px, 1.33, -0.27px);\r\n        }\r\n\r\n        &--md {\r\n            @include typographyStyle (16px, 1.5, -0.18px);\r\n        }\r\n        &--sm {\r\n            @include typographyStyle(14px, 1.43, -0.08px);\r\n        }\r\n\r\n        &--xs {\r\n            @include typographyStyle(12px, 1.33, normal);\r\n        }\r\n\r\n    }\r\n\r\n    .revx-paragraph {\r\n        &--xl{\r\n            @include typographyStyle(24px, 1.33, -0.36px);\r\n        }\r\n        &--lg{\r\n            @include typographyStyle(18px, 1.33, -0.27px);\r\n        }\r\n        &--md{\r\n            @include typographyStyle(16px, 1.5, -0.18px);\r\n        }\r\n        // &--regular{\r\n        //     @include typographyStyle(11px, 1.09, 0.22px);\r\n        // }\r\n        &--sm{\r\n            @include typographyStyle (14px, 1.43, -0.08px);\r\n        }\r\n        &--xs {\r\n            @include typographyStyle(12px, 1.33, normal);\r\n        }\r\n    }\r\n}\r\n',"$overlay-bg-color: map-get($neutral-colors, 'neutral-100');\r\n$modal-min-width: 860px;\r\n$modal-max-height: 1040px;\r\n$modal-border-radius: 12px;\r\n$modal-header-height: 72px;\r\n$modal-header-padding: 16px;\r\n$modal-content-padding: 25px;\r\n$heading-border-color: map-get($neutral-colors, 'neutral-200');\r\n$modal-min-height: 500px;\r\n$modal-overlay-bg-color : map-get($neutral-colors, 'neutral-700');\r\n\r\n// The modal window element.\r\n.revx-component-modal {\r\n\t@include reset;\r\n\tmargin: auto;\r\n    max-width: 1000px;\r\n    max-height: 82vh;\r\n    width: 100%;\r\n\tbackground: map-get($neutral-colors, 'neutral-0');\r\n\tborder-radius: $modal-border-radius;\r\n\tanimation: components-modal__appear-animation 0.1s ease-out;\r\n\tanimation-fill-mode: forwards;\r\n\tdisplay: flex;\r\n    flex-direction: column;\r\n\t@include reduce-motion(\"animation\");\r\n    &__overlay {\r\n        @include positionStyle(fixed, 0, 0, 0, 0);\r\n        background-color: rgba(7, 8, 12, 0.75);\r\n        z-index: 100000;\r\n        display: flex;\r\n        @include modal-fade-in-animation();\r\n    }\r\n    &__header {\r\n        box-sizing: border-box;\r\n        border-bottom: 1px solid $heading-border-color;\r\n    }\r\n    &__header-content {\r\n        border-bottom: 1px solid transparent;\r\n        padding: 16px 20px;\r\n        @include flexStyle(space-between, center, row);\r\n        height: $modal-header-height;\r\n        width: 100%;\r\n    }\r\n    &__header-heading-container {\r\n        flex-grow: 1;\r\n        display: flex;\r\n        align-items: center;\r\n        flex-direction: row;\r\n        justify-content: left;\r\n    }\r\n    &__header-heading {\r\n        text-transform: capitalize;\r\n    }\r\n    &__header-back-btn {\r\n        margin-right: 16px;\r\n        background-color: transparent;\r\n        border: none;\r\n    }\r\n    &__header-subheading {\r\n        font-size: 12px;\r\n        color: map-get($neutral-colors, 'neutral-400');\r\n        margin-left: 8px;\r\n    }\r\n    &__content {\r\n        flex: 1;\r\n        padding: $modal-content-padding;\r\n        overflow: auto;\r\n        @extend .revx-scrollbar-lg;\r\n    }\r\n    &__close {\r\n        border: 1px solid;\r\n        background-color: transparent;\r\n        @include buttonColor(map-get($neutral-colors, 'neutral-200'), map-get($neutral-colors, 'neutral-500'),false, map-get($neutral-colors, 'neutral-500'), false);\r\n        @include buttonHoverColor(map-get($primary-colors, 'green-base'), map-get($primary-colors, 'green-base'), false, false, true);\r\n        border-radius: 4px !important; // All modal close button 4px from JOS\r\n    }\r\n    &__header-heading-container {\r\n        gap: 20px;\r\n    }\r\n    &.revx-search-select {\r\n        border-radius: 16px;\r\n    }\r\n}\r\n\r\n@keyframes components-modal__appear-animation {\r\n\tfrom {\r\n\t\ttransform: translateY($modal-header-height);\r\n\t}\r\n\tto {\r\n\t\ttransform: translateY(0);\r\n\t}\r\n}\r\n\r\n// Modal contents.\r\n@keyframes modal-fade-in-animation {\r\n\tfrom {\r\n\t\topacity: 0;\r\n\t}\r\n\tto {\r\n\t\topacity: 1;\r\n\t}\r\n}\r\n\r\n/*====================================\r\n    Campaign Delete Confirm Modal Popup\r\n====================================*/\r\n.revx-delete-modal,\r\n.revx-modal-confirmation {\r\n    max-width: 364px;\r\n    box-shadow: 0px 16px 40px -8px rgba(88, 92, 95, 0.16);\r\n    padding: 16px;\r\n    &__message {\r\n        color: map-get($neutral-colors, 'neutral-400');\r\n        margin-bottom: 24px;\r\n    }\r\n    &__delete-btn {\r\n        color: map-get($neutral-colors, 'neutral-0');\r\n        border-width: 0px;\r\n        background-color: map-get($vibrant-colors, 'red-base');\r\n    }\r\n    &__cancel-btn {\r\n        color: map-get($neutral-colors, 'neutral-700');\r\n        border: 1px solid map-get($neutral-colors, 'neutral-300');\r\n        background-color: map-get($neutral-colors, 'neutral-0');\r\n    }\r\n    &__action {\r\n        justify-content: flex-end;\r\n    }\r\n    .revx-component-modal {\r\n        &__header  {\r\n            h3 {\r\n                @include typographyStyle(14px, 1.43, -0.08px);\r\n                margin: 0px;\r\n            }\r\n            &-content {\r\n                height: auto;\r\n                padding: 0px 0px 12px;\r\n            }\r\n        }\r\n        &__header-heading  {\r\n            @include typographyStyle (16px, 1.5, -0.18px);\r\n        }\r\n        &__content {\r\n            padding: 0px;\r\n            margin-top: 12px;\r\n        }\r\n        &__close {\r\n            height: auto;\r\n            border: 0px;\r\n            svg {\r\n                height: 16px;\r\n                width: 16px;\r\n                path {\r\n                    stroke: map-get($neutral-colors, 'neutral-900');\r\n                }\r\n            }\r\n        }\r\n    }\r\n}\r\n\r\n/*====================================\r\n    Upgrade to pro Modal\r\n====================================*/\r\n.revx-upgrade-pro {\r\n    width: 250px;\r\n    height: 296px;\r\n    background: map-get($primary-colors, 'green-lighter');\r\n    padding: 8px;\r\n    padding-top: 6px;\r\n    &__overlay {\r\n        z-index: 100001 !important;\r\n    }\r\n    &__btn {\r\n\t\tmargin-top: 16px;\r\n        width: 100%;\r\n    }\r\n    &__message {\r\n        @include typographyStyle (18px, 24px, -0.015em, 500);\r\n        text-align: center;\r\n        color: map-get($neutral-colors, 'neutral-900');\r\n        max-width: 305px;\r\n    }\r\n    .revx-component-modal__content {\r\n        padding : 0px;\r\n        &.revx-upgrade-pro__content {\r\n            @include flexStyle(space-between, center, column);\r\n        }\r\n    }\r\n    span.revx-hightlight {\r\n        text-align: center;\r\n        @include typographyStyle (18px, 24px, -0.015em, 600);\r\n        color: map-get($primary-colors, 'green-base');\r\n    }\r\n    .revx-component-modal__close {\r\n        position: absolute;\r\n        right: 12px;\r\n    }\r\n}\r\n","@mixin revx-switch-before-style($width, $border-color, $background-color) {\r\n    content: '';\r\n    position: absolute;\r\n    left: 0px;\r\n    width: $width; // Width is parameterized\r\n    height: 100%;\r\n    border-radius: 8px;\r\n    background: $background-color; // Parameterized background\r\n    transition: all 0.3s;\r\n    border: 1px solid $border-color; // Parameterized border\r\n}\r\n\r\n.revx-switch {\r\n    &-container {\r\n        color: map-get($neutral-colors, 'neutral-400');\r\n        cursor: pointer;\r\n        height: 40px;\r\n        width: fit-content;\r\n        font-weight: bold;\r\n        display: grid;\r\n        align-items: center;\r\n        grid-template-columns: repeat(2, 1fr);\r\n        border-radius: 8px;\r\n        background: map-get($neutral-colors, 'neutral-100');\r\n        border: 1px solid map-get($neutral-colors, 'neutral-300');\r\n        position: relative;\r\n        &:before {\r\n            @include revx-switch-before-style(50%, map-get($primary-colors, 'green-base'), map-get($neutral-colors, 'neutral-0'));\r\n        }\r\n        &.secondary-label-empty {\r\n            grid-template-columns:1fr;\r\n            &:before {\r\n                @include revx-switch-before-style(100%, map-get($primary-colors, 'green-base'), map-get($neutral-colors, 'neutral-0'));\r\n            }\r\n        }\r\n        & > div {\r\n            text-align: center;\r\n            @include flexStyle(center, center);\r\n            padding: 0px 15px;\r\n            z-index: 1;\r\n        }\r\n        &__option {\r\n            height: 100%;\r\n        }\r\n        .revx-tooltip .revx-switch__option {\r\n            width: 50px;\r\n        }\r\n    }\r\n    &-inline {\r\n        .revx-switch-container {\r\n            height: 32px;\r\n            box-sizing: border-box;\r\n            border-radius: 4px;\r\n            background: map-get($neutral-colors, 'neutral-0');\r\n            &::before {\r\n                border-radius: 4px;\r\n                background-color: map-get($primary-colors, 'green-lighter');\r\n            }\r\n            & > div {\r\n                width: 150px;\r\n                box-sizing: border-box;\r\n            }\r\n        }\r\n        .revx-switch-input {\r\n            &:checked + .revx-switch-container > div:first-child {\r\n                color: map-get($neutral-colors, 'neutral-500');\r\n                transition: color 0.3s;\r\n            }\r\n            &:checked + .revx-switch-container > div:last-child {\r\n                color: map-get($primary-colors, 'green-base');\r\n                transition: color 0.3s;\r\n            }\r\n            & + .revx-switch-container > div:first-child {\r\n                color: map-get($primary-colors, 'green-base');\r\n                transition: color 0.3s;\r\n            }\r\n            & + .revx-switch-container > div:last-child {\r\n                color: map-get($neutral-colors, 'neutral-500');\r\n                transition: color 0.3s;\r\n            }    \r\n        }\r\n    }\r\n}\r\n\r\n.revx-switch-input {\r\n    display: none !important;\r\n    &:checked + .revx-switch-container::before {\r\n        left: 50%;\r\n    }\r\n    &:checked + .revx-switch-container > div:first-child {\r\n        color: map-get($neutral-colors, 'neutral-400');\r\n        transition: color 0.3s;\r\n    }\r\n    &:checked + .revx-switch-container > div:last-child {\r\n        color: map-get($neutral-colors, 'neutral-900');\r\n        transition: color 0.3s;\r\n    }\r\n    & + .revx-switch-container > div:first-child {\r\n        color: map-get($neutral-colors, 'neutral-900');\r\n        transition: color 0.3s;\r\n    }\r\n    & + .revx-switch-container > div:last-child {\r\n        color: map-get($neutral-colors, 'neutral-400');\r\n        transition: color 0.3s;\r\n    }\r\n}\r\n","\r\n\r\n.revx-btn {\r\n\tcursor: pointer;\r\n\twidth: fit-content;\r\n\ttext-decoration: none;\r\n    text-wrap: nowrap;\r\n\t@include flexStyle(center, center);\r\n\tgap: 8px;\r\n\tbox-sizing: border-box !important;\r\n\tpadding: 0px 16px;\r\n\t&-default {\r\n\t\tborder: 2px solid;\r\n\t\tborder-color: map-get($primary-colors, 'green-base');\r\n\t\t&:not(.wsx-btn-outline) {\r\n\t\t\t@include buttonColor(map-get($primary-colors, 'green-base'), map-get($neutral-colors, 'neutral-0'), false, map-get($neutral-colors, 'neutral-0'), true);\r\n\t\t\t@include buttonHoverColor(map-get($primary-colors, 'green-dark'), map-get($neutral-colors, 'neutral-0'), false, true, true);\r\n\t\t\t@include buttonFocusColor(map-get($primary-colors, 'green-base'), map-get($primary-colors, 'green-light'), map-get($neutral-colors, 'neutral-0'), true, true);\r\n\t\t\t@include buttonActiveColor(map-get($primary-colors, 'green-dark'), true, true);\r\n\t\t\tsvg, path {\r\n\t\t\t\tstroke: map-get($neutral-colors, 'neutral-0');\r\n\t\t\t}\r\n\t\t}\r\n\t\t&.wsx-btn-outline {\r\n\t\t\t@include buttonColor(map-get($primary-colors, 'green-base'), false, false, false, false);\r\n\t\t\t@include buttonHoverColor(map-get($primary-colors, 'green-dark'), false, false,false, true);\r\n\t\t\t@include buttonFocusColor(map-get($primary-colors, 'green-light'), map-get($primary-colors, 'green-base'), map-get($primary-colors, 'green-base'), false, true);\r\n\t\t\t@include buttonActiveColor(map-get($primary-colors, 'green-dark'), false, true);\r\n\t\t\tsvg, path {\r\n\t\t\t\tstroke: map-get($primary-colors, 'green-base');\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\t&.revx-btn-full {\r\n\t\twidth: 100%;\r\n\t}\r\n\t&.wsx-btn-reverse {\r\n\t\tflex-direction: row-reverse;\r\n\t}\r\n\t&-xl {\r\n\t\theight: 52px;\r\n\t\t@include typographyStyle(16px, 24px, 0.96px);\r\n\t\t&.revx-btn-round {\r\n\t\t\tborder-radius: 12px;\r\n\t\t}\r\n\t\t&.revx-btn-emptytext {\r\n\t\t\tpadding: 0px;\r\n\t\t\twidth: 52px;\r\n\t\t}\r\n\t}\r\n\t&-lg {\r\n\t\theight: 48px;\r\n\t\t@include typographyStyle(16px, 24px, 0.96px);\r\n\t\t&.revx-btn-emptytext {\r\n\t\t\tpadding: 0px;\r\n\t\t\twidth: 48px;\r\n\t\t}\r\n\t\t&.revx-btn-round {\r\n\t\t\tborder-radius: 12px;\r\n\t\t}\r\n\t}\r\n\t&-md {\r\n\t\theight: 40px;\r\n\t\t@include typographyStyle(14px, 20px, -0.084px);\r\n\t\t&.revx-btn-emptytext {\r\n\t\t\tpadding: 0px;\r\n\t\t\twidth: 40px;\r\n\t\t}\r\n\t\t&.revx-btn-round {\r\n\t\t\tborder-radius: 8px;\r\n\t\t}\r\n\t}\r\n\t&-sm {\r\n\t\theight: 32px;\r\n\t\t@include typographyStyle(14px, 20px, -0.084px);\r\n\t\t&.revx-btn-round {\r\n\t\t\tborder-radius: 8px;\r\n\t\t}\r\n\t\t&.revx-btn-emptytext {\r\n\t\t\tpadding: 0px;\r\n\t\t\twidth: 32px;\r\n\t\t}\r\n\t}\r\n}\r\n\r\n/*====================================\r\n\tAnimation style\r\n====================================*/\r\n.revx-btn-animation {\r\n    animation-duration: 800ms;\r\n    animation-iteration-count: infinite;\r\n    animation-fill-mode: both;\r\n    animation-timing-function: ease-in-out;\r\n    cursor: pointer;\r\n}\r\n\r\n.revx-btn-zoomIn {\r\n    animation-name: btnZoomIn;\r\n}\r\n\r\n.revx-btn-shake {\r\n    animation-name: btnShake;\r\n}\r\n\r\n.revx-btn-bounce {\r\n    animation-name: btnBounce;\r\n}\r\n.revx-btn-wobble {\r\n    animation-name: btnWobble;\r\n}\r\n.revx-btn-pulse {\r\n    animation-name: btnPulse;\r\n}\r\n\r\n/* animation-play-state: paused; */\r\n@keyframes btnZoomIn {\r\n    0% {\r\n        transform: scale(1);\r\n    }\r\n    50% {\r\n        transform: scale(1.05);\r\n    }\r\n    100% {\r\n        transform: scale(1);\r\n    }\r\n}\r\n\r\n@keyframes btnShake {\r\n    0%, 100% {\r\n        transform: translateX(0);\r\n    }\r\n    25%, 75% {\r\n        transform: translateX(-5px);\r\n    }\r\n    50% {\r\n        transform: translateX(5px);\r\n    }\r\n}\r\n\r\n@keyframes btnBounce {\r\n    0%, 20%, 50%, 80%, 100% {\r\n        transform: translateY(0);\r\n    }\r\n    40% {\r\n        transform: translateY(-10px);\r\n    }\r\n    60% {\r\n        transform: translateY(-10px);\r\n    }\r\n}\r\n\r\n@keyframes btnWobble {\r\n    0%, 100% {\r\n        transform: rotate(0);\r\n    }\r\n    15% {\r\n        transform: rotate(-10deg);\r\n    }\r\n    30% {\r\n        transform: rotate(7deg);\r\n    }\r\n    45% {\r\n        transform: rotate(-7deg);\r\n    }\r\n    60% {\r\n        transform: rotate(5deg);\r\n    }\r\n    75% {\r\n        transform: rotate(-1deg);\r\n    }\r\n}\r\n\r\n@keyframes btnPulse {\r\n    0%, 100% {\r\n        transform: scale(1);\r\n    }\r\n    30%, 70% {\r\n        transform: scale(1.2);\r\n    }\r\n}\r\n","$width: 200px;\r\n$header-radius: 8px;\r\n$header-height: 40px;\r\n$options-border-color: map-get($neutral-colors, 'neutral-100');\r\n$focus-outline-color: map-get($primary-colors, 'green-base');\r\n$header-border: 1px solid map-get($neutral-colors, 'neutral-200');\r\n$header-padding: 10px 16px 10px 16px;\r\n\r\n.revx-select-field {\r\n\twidth: 100%;\r\n\toutline: none;\r\n\t&:focus {\r\n\t\t.revx-field-disabled {\r\n\t\t\toutline: none;\r\n\t\t}\r\n\t\t.revx-select-field__header {\r\n\t\t\tborder-radius: $header-radius;\r\n\t\t\toutline: 1px solid $focus-outline-color; // Change the color and style as needed\r\n\t\t}\r\n\t}\r\n\t&__content {\r\n\t\twidth: 100%;\r\n\t\tposition: relative;\r\n\t}\r\n\t&__selected-option {\r\n\t\twidth: max-content;\r\n\t\tcolor: map-get($neutral-colors, 'neutral-500');\r\n\t\t@extend .revx-text-ellipsis;\r\n\t\t@include flexStyle(false, center);\r\n\t\tgap: 8px;\r\n\t\tsvg {\r\n\t\t\tstroke: map-get($neutral-colors, 'neutral-400');\r\n\t\t\tpath {\r\n\t\t\t\tstroke: map-get($neutral-colors, 'neutral-400');\r\n\t\t\t}\r\n\t\t\tg {\r\n\t\t\t\tstroke: map-get($neutral-colors, 'neutral-400');\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\t&__header {\r\n\t\theight: $header-height;\r\n\t\t@include flexStyle(space-between, center);\r\n\t  \tbox-sizing: border-box;\r\n\t\tbackground-color: map-get($neutral-colors, 'neutral-0');\r\n\t\tpadding: $header-padding;\r\n\t\tborder: $header-border;\r\n\t\tborder-radius: $header-radius;\r\n\t\tcursor: pointer;\r\n\t\t&__arrow-icon {\r\n\t\t\tline-height: 0px;\r\n\t\t\tmargin-left: 10px;\r\n\t\t}\r\n\t\t&:focus {\r\n\t\t\toutline: none;\r\n\t\t}\r\n\t}\r\n\t&__options {\r\n\t\tdisplay: none;\r\n\t\tmax-height: 180px;\r\n\t\tlist-style-type: none;\r\n\t\tpadding: 0;\r\n\t\tmargin: 0;\r\n\t\tbackground-color: map-get($neutral-colors, 'neutral-0');\r\n\t\tborder-radius: 8px;\r\n\t\tborder: 1px solid $options-border-color;\r\n\t\tbox-shadow: $shadow-md;\r\n\t\toverflow-y: auto;\r\n\t\tposition: absolute;\r\n\t\tz-index: 100000;\r\n\t\t@extend .revx-scrollbar-md;\r\n\t\t&--bottom {\r\n\t\t\ttop: calc(100% + 8px);\r\n\t\t\tleft: 0;\r\n\t\t}\r\n\t\t&--top {\r\n\t\t\tbottom: 100%;\r\n\t\t\tleft: 0;\r\n\t\t\t}\r\n\t\t.revx-select-field__option {\r\n\t\t\theight: 36px;\r\n\t\t\tcursor: pointer;\r\n\t\t\tbox-sizing: border-box;\r\n\t\t\tcolor: map-get($neutral-colors, 'neutral-500');\r\n\t\t\tpadding: 8px 16px 8px 16px;\r\n            @extend .revx-text-ellipsis;\r\n\t\t\t&:hover,\r\n\t\t\t&--focused {\r\n\t\t\t\tbackground-color: map-get($neutral-colors, 'neutral-100');\r\n\t\t\t}\r\n\t\t\t&:focus {\r\n\t\t\t\toutline: none;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\t\r\n\t&__options.revx-d-visible {\r\n\t\tdisplay: block;\r\n\t}\r\n\r\n\t&__arrow-icon {\r\n\t\tline-height: 0px;\r\n\t}\r\n\r\n\t.revx-label-container   {\r\n\t\tmargin-bottom: 12px; // suggested 