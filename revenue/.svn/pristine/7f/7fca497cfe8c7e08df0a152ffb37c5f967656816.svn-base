#: assets/js/backend/revenue-admin.js:2
#: assets/js/backend/revenue-admin.js:89750
msgid "Do I need the free version of the plugin on my site?"
msgstr ""

#: assets/js/backend/revenue-admin.js:2
#: assets/js/backend/revenue-admin.js:89754
msgid "Yes. You can use the free version of the plugin, which includes the free features of WowRevenue. However, please note that to use the pro features, you need the free version of the plugin installed on your WordPress site."
msgstr ""

#: assets/js/backend/revenue-admin.js:2
#: assets/js/backend/revenue-admin.js:89760
msgid "How do I get the pro version?"
msgstr ""

#: assets/js/backend/revenue-admin.js:2
#: assets/js/backend/revenue-admin.js:89761
msgid "Please note that you need both WooCommerce and the free version of WowRevenue installed on your WordPress site to use the pro features. You need to download the pro version of the plugin from your buyer’s dashboard, install it on your WordPress site, and activate the product license."
msgstr ""

#: assets/js/backend/revenue-admin.js:2
#: assets/js/backend/revenue-admin.js:89767
msgid "Where do I get my product license?"
msgstr ""

#: assets/js/backend/revenue-admin.js:2
#: assets/js/backend/revenue-admin.js:89768
msgid "You can copy the product license from the client dashboard. Once you copy it, paste the license key into the WowRevenue License validation page."
msgstr ""

#: assets/js/backend/revenue-admin.js:2
#: assets/js/backend/revenue-admin.js:89774
msgid "How do I get help to use WowRevenue Pro?"
msgstr ""

#: assets/js/backend/revenue-admin.js:2
#: assets/js/backend/revenue-admin.js:89776
msgid "Please go to the support link: <a href='https://www.wowrevenue.com/contact/.' target='_blank'> https://wowrevenue.com/contact/</a>"
msgstr ""

