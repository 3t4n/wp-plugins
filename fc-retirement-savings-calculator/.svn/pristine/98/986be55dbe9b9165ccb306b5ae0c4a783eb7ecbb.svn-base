#. Populate with the ISO language code aligning with the language for the msgstr.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:27
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:825
msgid "en"
msgstr "fi"

#. An instructional message about numeric input which may be shown to the calculator's user.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:28
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:826
msgid "Please use the backspace key to delete."
msgstr "Käytä backspace-näppäintä poistaaksesi."

#. An instructional message about numeric input which may be shown to the calculator's user.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:29
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:827
msgid "Left, up & down arrow keys are disabled. So are the home, end, pgup and pgdn keys."
msgstr "Vasen, ylös- ja alanuolinäppäimet ovat pois käytöstä. Sama koskee home, end, pgup ja pgdn -näppäimiä."

#. An instructional message about numeric input which may be shown to the calculator's user.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:30
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:828
msgid "Use backspace to delete."
msgstr "Käytä backspace-näppäintä poistaaksesi."

#. An instructional message which may appear to the user suggesting efficient way to edit data.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:31
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:829
msgid "If value is selected, just start typing new value to clear prior value."
msgstr "Jos arvo on valittu, aloita uuden arvon kirjoittaminen tyhjentääksesi edellisen arvon."

#. Instructional message that may be shown to user when entering numbers.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:32
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:830
msgid "When a number is selected (value shown in inverse), use right arrow key to clear selection without clearing value. Then backspace to edit."
msgstr "Kun numero on valittu (arvo näkyy käänteisenä), voit poistaa valinnan oikealla nuolinäppäimellä tyhjentämättä arvoa. Muokkaa sitten askelpalauttimella."

#. Instructional message that may be shown to user when entering numbers.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:33
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:831
msgid "TIP: Generally it is best to use the TAB or SHIFT-TAB keys to move from one input to the next or previous input."
msgstr "VINKKI: Yleensä on parasta käyttää TAB- tai SHIFT-TAB-näppäimiä siirtyäksesi yhdestä syötteestä seuraavaan tai edelliseen syötteeseen."

#. Instructional message that may be shown to user when entering numbers.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:34
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:832
msgid "TIP 2: Generally, editing a value is inefficient. Since values are auto selected, just type the number you want."
msgstr "VINKKI 2: Yleensä arvon muokkaaminen on tehotonta. Koska arvot valitaan automaattisesti, kirjoita vain haluamasi luku."

#. Instructional message that may be shown to user when entering numbers.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:35
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:833
msgid "Do not type the thousand separator character."
msgstr "Älä kirjoita tuhaterotusmerkkiä."

#. Instructional message that may be shown to user when entering numbers.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:36
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:834
msgid "(If using U.S. convention, that would be the comma.)"
msgstr "(Jos käytössä on Yhdysvaltojen konventio, se olisi pilkku.)"

#. A whimsical instructional message that may be shown to user when entering numbers.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:37
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:835
msgid "I'm smart enough to enter them for you!"
msgstr "Olen tarpeeksi fiksu syöttämään ne puolestasi!"

#. An exception error message which user could potentially see.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:38
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:836
msgid "An unknown date calculation error occurred."
msgstr "Tapahtui tuntematon päivämäärän laskentavirhe."

#. Message asking user to provide details about an error condition.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:39
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:837
msgid "Please provide us with your inputs and settings so that we can fix this. Thank you."
msgstr "Ilmoita meille syötteesi ja asetuksesi, jotta voimme korjata tämän. Kiitos."

#. An exception error message which user could potentially see.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:40
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:838
msgid "Date is not valid - bad year."
msgstr "Päivämäärä ei ole kelvollinen - virheellinen vuosi."

#. Recognized abbreviation for January - abbreviation used due to limited space.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:41
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:839
msgid "Jan"
msgstr "tammi"

#. Recognized abbreviation for February - abbreviation used due to limited space.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:42
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:840
msgid "Feb"
msgstr "helmi"

#. Recognized abbreviation for March - abbreviation used due to limited space.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:43
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:841
msgid "Mar"
msgstr "maalis"

#. Recognized abbreviation for April - abbreviation used due to limited space.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:44
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:842
msgid "Apr"
msgstr "huhti"

#. The month of May.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:45
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:843
msgid "May"
msgstr "toukokuu"

#. Recognized abbreviation for June - abbreviation used due to limited space.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:46
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:844
msgid "Jun"
msgstr "kesä"

#. Recognized abbreviation for July - abbreviation used due to limited space.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:47
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:845
msgid "Jul"
msgstr "heinä"

#. Recognized abbreviation for August - abbreviation used due to limited space.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:48
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:846
msgid "Aug"
msgstr "elo"

#. Recognized abbreviation for September - abbreviation used due to limited space.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:49
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:847
msgid "Sept"
msgstr "syys"

#. Recognized abbreviation for October - abbreviation used due to limited space.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:50
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:848
msgid "Oct"
msgstr "loka"

#. Recognized abbreviation for November- abbreviation used due to limited space.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:51
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:849
msgid "Nov"
msgstr "marras"

#. Recognized abbreviation for December- abbreviation used due to limited space.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:52
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:850
msgid "Dec"
msgstr "joulu"

#. An exception error message which user could potentially see.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:53
msgid "Error: dates out of sequence."
msgstr "Virhe: päivämäärät eivät ole järjestyksessä."

#. Title for exception error message which user could potentially see. Title in modal header.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:54
msgid "Exception"
msgstr "Poikkeus"

#. A portion of an exception error message which user could potentially see.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:55
msgid "occurred when accessing"
msgstr "tapahtui, kun käytettiin"

#. A portion of an exception error message which user could potentially see.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:56
msgid "Invalid index"
msgstr "Virheellinen indeksi"

#. "YTD" stands for "Year-to-Date" totals. It is used as a row label in reports and must be translated as a commonly recognized abbreviation or kept within approximately 15 characters to fit formatting constraints.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:59
msgid "YTD"
msgstr "KHT"

#. "Running Totals" are accumulated totals calculated incrementally from the start of a sequence or period. This row label appears in reports with multiple cumulative totals in a single row. The term is plural because it refers to multiple totals.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:60
msgid "Running Totals"
msgstr "Juoksevat summat"

#. A centered title over a section of a financial report.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:62
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:125
msgid "Your Personalized Retirement Schedule"
msgstr "Henkilökohtainen eläkeaikataulu"

#. A centered title over a section of a financial report.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:66
msgid "Retirement Plan Summary"
msgstr "Eläkesuunnitelman yhteenveto"

#. A report label. The user will understand the concept from its context. The translation must be concise.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:67
msgid "Total Investment"
msgstr "Kokonaissijoitus"

#. A report label. The user will understand the concept from its context. The translation must be concise.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:68
msgid "Number of Investments"
msgstr "Sijoitusten lukumäärä"

#. The return on investment amount. A report label. The user will understand the concept from its context. The translation must be concise. User understands from context in GUI.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:69
msgid "Return on Investment (ROI)"
msgstr "Sijoitetun pääoman tuotto (ROI)"

#. Total investment gain. A report label. The user will understand the concept from its context. The translation must be concise.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:70
msgid "Total Gain"
msgstr "Kokonaisvoitto"

#. Total investment gain. A report label. The user will understand the concept from its context. The translation must be concise.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:71
msgid "Gain on Investment"
msgstr "Sijoitusvoitto"

#. A report label. The user will understand the concept from its context. The translation must be concise.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:72
msgid "Last Cash Flow Date"
msgstr "Viimeinen kassavirran päivämäärä"

#. 'Years' is the number of years, usually the term expressed in years. A report label. The word 'years' must be translated in this context.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:73
msgid "Years"
msgstr "Vuodet"

#. A centered title over a section of a financial report.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:80
msgid "Investment Schedule"
msgstr "Sijoitusaikataulu"

#. A report's label for a specific calendar year. Example: "Year: 2024". The user will understand the concept from its context. The translation must be specifically for "year".
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:81
msgid "Year"
msgstr "Vuosi"

#. A specific date. Example: "Date: 11/30/2024". Frequently, a column label in a report or a prompt for user input. The translation must be specifically for 'date' in this context. It is NOT a romantic 'date.'
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:82
msgid "Date"
msgstr "Päivämäärä"

#. Investment amount. A report's label. User understands from the context.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:83
msgid "Investment"
msgstr "Sijoitus"

#. A report's label.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:84
msgid "Investment Gain"
msgstr "Sijoitusvoitto"

#. The change in the investment amount. A report's column label.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:85
msgid "Net Change"
msgstr "Nettomuutos"

#. The loan or investment balance as of a particular date. Used to label a column in a report. Must be concise.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:86
msgid "Balance"
msgstr "Saldo"

#. A report's label
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:88
msgid "Annual Investment"
msgstr "Vuotuinen sijoitus"

#. Annual interest amount. A report's label
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:89
msgid "Annual Interest"
msgstr "Vuotuinen korko"

#. A report's label
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:90
msgid "Annual Investment Gain"
msgstr "Vuotuinen sijoitustuotto"

#. A report's label
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:91
msgid "Change in Balance"
msgstr "Saldon muutos"

#. The centered title over a graph or chart.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:92
msgid "Annual Investment and Interest Totals"
msgstr "Vuotuiset sijoitukset ja korot yhteensä"

#. The centered title over a graph or chart.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:93
msgid "Accumulated Investment and Interest"
msgstr "Kertyneet sijoitukset ja korot"

#. The centered title over a graph or chart.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:94
msgid "Amount Invested & Interest as Percentage of Total Value"
msgstr "Sijoitettu määrä ja korko prosenttina kokonaisarvosta"

#. Informational text for the calculator's user. The footnote in a financial report.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:96
msgid "\"Net Change\" is change from prior period i.e. prior balance plus investment, plus gain on investment (interest)."
msgstr "\"Nettomuutos\" on muutos edelliseen kauteen verrattuna eli aiempi saldo lisättynä sijoituksilla ja sijoitusvoitoilla (koroilla)."

#. Total investment from the beginning or accumulated total at a point in time. A report's row label.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:97
msgid "Running Investment"
msgstr "Kumulatiivinen sijoitus"

#. Total interest from the beginning or accumulated total at a point in time. A report's row label.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:98
msgid "Running Interest"
msgstr "Kumulatiivinen korko"

#. Total amount gained from the beginning or accumulated amount at a point in time. A report's row label.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:99
msgid "Running Investment Gain"
msgstr "Kumulatiivinen sijoitustuotto"

#. A report's label.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:100
msgid "Total Deposits"
msgstr "Kumulatiiviset talletukset"

#. A report's label.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:101
msgid "Total Interest Earned"
msgstr "Ansaittu korko yhteensä"

#. A report's label.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:102
msgid "Total Value"
msgstr "Kokonaisarvo"

#. Percentage of Total. A label for a financial report, chart or graph. Be concise. Okay to use recognized abbreviations.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:103
msgid "Pct. of Total"
msgstr "Kok. prosenttiosuus"

#. A title centered over a section of a financial report.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:104
msgid "Your Personalized Cash Flow Schedule"
msgstr "Henkilökohtainen kassavirta-aikataulusi"

#. A data entry error message shown to the user.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:107
msgid "Current age must be greater than 0."
msgstr "Nykyisen iän on oltava suurempi kuin 0."

#. A data entry error message shown to the user.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:116
msgid "\"Retirement Age\" must be greater than \"Current Age\""
msgstr "\"Eläkeiän\" on oltava suurempi kuin \"Nykyinen ikä\""

#. Help text in modal.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:117
msgid "Retirement Savings Calculator — calculate savings required to reach retirement goal"
msgstr "Eläkesäästölaskuri - laske säästöt, joita tarvitaan eläkepäämäärän saavuttamiseksi"

#. Informational text for the calculator's user. Keep HTML markup intact (as always)!
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:118
msgid "<p>This calculator easily answers the question \"Given the value of my current investments how much do I need to save each month to reach my retirement goal?\"</p>"
msgstr "<p>Tämä laskuri vastaa helposti kysymykseen: \"Kun otetaan huomioon nykyisten sijoitusteni arvo, kuinka paljon minun täytyy säästää joka kuukausi saavuttaakseni eläketavoitteeni?\"</p>"

#. Informational text for the calculator's user. Keep HTML markup intact (as always)!
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:119
msgid "<p>The user enters their \"Current Age\", their expected \"Retirement Age\", the \"Annual Interest Rate (ROR)\" (annualized Rate-of-Return one expects to earn) and \"Amount At Retirement\" (the goal amount).</p>"
msgstr "<p>Käyttäjä syöttää \"Nykyisen iän\", odotetun \"Eläkeiän\", \"Vuosikoron (ROR)\" (vuosittainen tuotto-odotus) ja \"Eläkesumma\" (tavoitesumma).</p>"

#. Informational text for the calculator's user. Keep HTML markup intact (as always)!
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:120
msgid "<p class=\"tail\">The calculator quickly calculates the required monthly investment amount and creates an investment schedule plus a set of charts that will help the user see the relationship between the amount invested and the return on the investment.</p>"
msgstr "<p class=\"tail\">Laskuri laskee nopeasti tarvittavan kuukausittaisen sijoitussumman ja luo sijoitusaikataulun sekä joukon kaavioita, joiden avulla käyttäjä voi nähdä sijoitetun summan ja sijoituksen tuoton välisen suhteen.</p>"

#. Informational text for the calculator's user. Keep HTML markup intact (as always)!
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:121
msgid "<p class=\"small\" style=\"font-size: 85%; line-height: 1.5; color:red; user-select: text\">If you need a more advanced \"Retirement Calculator\" - one that calculates many more unknowns and one that calculates assuming retirement <b>income</b> and not a final lump sum then try the calculator located here: <b>https://AccurateCalculators.com/retirement-calculator</b></p>"
msgstr "<p class=\"small\" style=\"font-size: 85%; line-height: 1.5; color:red; user-select: text\">Jos tarvitset edistyneemmän \"Eläkelaskurin\" - sellaisen, joka laskee useampia tuntemattomia ja olettaa eläkkeenä <b>tuloja</b> eikä lopullista kertasummaa, kokeile laskuria täältä: <b>https://AccurateCalculators.com/retirement-calculator</b></p>"

#. Informational text for the calculator's user. Keep HTML markup intact (as always)!
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:123
msgid "<p class=\"small\" style=\"font-size: 85%; line-height: 1.5; color:red; user-select: text\">Need more options including the ability to solve for other unknowns? Ability to create, in one schedule, the pre-retirement and post-retirement cashflow? Print the chart? Export to MS Word&trade; (.docx) or MS Excel&trade; (.xlsx) files? Please visit, <b>https://AccurateCalculators.com/retirement-calculator</b></p>"
msgstr "<p class=\"small\" style=\"font-size: 85%; line-height: 1.5; color:red; user-select: text\">Tarvitsetko lisää vaihtoehtoja, kuten mahdollisuuden ratkaista muita tuntemattomia? Mahdollisuuden luoda yhdessä aikataulussa sekä ennen eläköitymistä että sen jälkeinen kassavirta? Tulosta kaavio? Vie tiedot MS Word&trade; (.docx) tai MS Excel&trade; (.xlsx) tiedostoihin? Tutustu osoitteeseen: <b>https://AccurateCalculators.com/retirement-calculator</b></p>"

#. The person's name for whom a report is prepared. A report's label.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:127
msgid "Prepared for"
msgstr "Kenelle valmistettu"

#. A report's label for a street address.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:129
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:137
msgid "Address"
msgstr "Osoite"

#. A report's label for postal address details.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:131
msgid "City, State  ZIP"
msgstr "Kaupunki, Maakunta  Postinumero"

#. The date a financial report was prepared. A report's label.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:133
msgid "Prepared On"
msgstr "Laadittu"

#. The person's name who prepared a report. A report's label.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:135
msgid "Prepared by"
msgstr "Valmistajan nimi"

#. A label for a phone number.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:139
msgid "Phone"
msgstr "Puhelin"

#. A report's label for an email address.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:141
msgid "Email"
msgstr "Sähköposti"

#. A report's label for a website address or URL.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:143
msgid "Website"
msgstr "Verkkosivusto"

#. An unknown value. Tells the calculator what to solve for.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:852
msgid "Unknown"
msgstr "Tuntematon"

#. The first letter of the word (lowercase) which means "Unknown" in the non-English language of the 'msgstr'
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:854
msgid "u"
msgstr "t"

#. The first letter of the word (capitalized) which means "Unknown" in the non-English language of the 'msgstr'
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:856
msgid "U"
msgstr "T"

#. An exception error message which user could potentially see.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:857
msgid "Dates must be the first of the month."
msgstr "Päivämäärien on oltava kuukauden ensimmäisiä päiviä."

#. An exception error message which user could potentially see.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:858
msgid "An invalid JavaScript date object."
msgstr "Virheellinen JavaScript-päivämääräobjekti."

#. The cash flow or compounding frequency.
#: dist/js/interface.RETIRE-SAVINGS.gpl.js:859
msgid "Monthly"
msgstr "Kuukausittainen"

#. Name of an online calculator. Used in an H1 element or report title. Translate the name as a native speaker would enter it into an online search engine.
#: en/calculator.gui.php:24
#: en/calculator.gui.php:26
msgid "Retirement Savings Calculator"
msgstr "Eläkesäästölaskuri"

#: en/calculator.gui.php:42
#: en/calculator.gui.php:168
#: en/calculator.gui.php:289
#: en/calculator.gui.php:412
msgid "Retirement Savings Calculator Plugin for WordPress"
msgstr "Eläkesäästölaskuri -lisäosa WordPressille"

#: en/calculator.gui.php:43
#: en/calculator.gui.php:169
#: en/calculator.gui.php:290
#: en/calculator.gui.php:413
msgid "This retirement savings calculator calculates the periodic savings amount required to reach your retirement goal."
msgstr "Tämä eläkesäästölaskuri laskee tarvittavan säästösumman eläkkeelle pääsemiseksi."

#. Text for a hyperlink.
#: en/calculator.gui.php:70
#: en/calculator.gui.php:196
#: en/calculator.gui.php:317
#: en/calculator.gui.php:440
msgid "click for more features"
