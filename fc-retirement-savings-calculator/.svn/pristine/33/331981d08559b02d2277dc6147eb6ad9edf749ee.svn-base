msgid "Number"
msgstr "Numeris"

#. A report's label.
#: en/calculator.gui.php:344
#: en/calculator.gui.php:466
msgid "Total Amount Invested"
msgstr "Bendra investuota suma"

#. A report's label.
#: en/calculator.gui.php:446
msgid "Anticipated Retirement Age?"
msgstr "Numatomas išėjimo į pensiją amžius?"

#. The current balance in a retirement account. (Don't translate 'savings' as a savings due to a discount.) A user prompt for input.
#: en/calculator.gui.php:449
msgid "Current Retirement Savings?"
msgstr "Dabartinės pensijų santaupos?"

#. A calculator's user prompt for input or a report's label. The user will understand the concept from its context. The translation must be concise.
#: en/calculator.gui.php:452
msgid "Annual Interest Rate (ROR)?"
msgstr "Metinė palūkanų norma (ROR)?"

#. Retirement goal amount. A user prompt for input.
#: en/calculator.gui.php:455
msgid "Amount At Retirement?"
msgstr "Suma išėjus į pensiją?"

#. A report's label.
#: en/calculator.gui.php:460
msgid "Monthly Investment Required"
msgstr "Reikalingos mėnesinės investicijos"

#. Number of cash flows expressed in layman's terms. A report's label.
#: en/calculator.gui.php:463
msgid "Number of Contributions"
msgstr "Įnašų skaičius"

#. A centered title over a section of a financial report. 'Savings' is the amount deposited to a savings account.  'Schedule' is a timing of the cash flows with dates.
#: en/calculator.gui.php:490
msgid "Savings Schedule"
msgstr "Taupymo grafikas"

#. The title in a modal's header. The modal offers the user the ability to select a currency symbol and date formatting options.
#: en/calculator.gui.php:566
msgid "Currency and Date Conventions"
msgstr "Valiutos ir datos konvencijos"

#. An information message shown to the user in a modal window.
#: en/calculator.gui.php:718
msgid "The calculator will remember your choice. You may also change it at any time."
msgstr "Skaičiuoklė įsimins jūsų pasirinkimą. Jį taip pat galite pakeisti bet kuriuo metu."

#. An information message shown to the user in a modal window.
#: en/calculator.gui.php:721
msgid "Clicking \"Save changes\" will cause the calculator to reload. Your edits will be lost."
msgstr "Paspaudus „Išsaugoti pakeitimus“, skaičiuoklė bus perkrauta. Jūsų redagavimai bus prarasti."

#. A label on a button. Clicking the button cancels an action, cancels an option or closes a window.
#: en/calculator.gui.php:728
msgid "Cancel"
msgstr "Atšaukti"

#. A label on a button. Clicking the button causes the user selections to .be saved
#: en/calculator.gui.php:729
msgid "Save changes"
msgstr "Išsaugoti pakeitimus"

#: en/calculator.gui.php:753
msgid "Cash flow forecast..."
msgstr "Pinigų srautų prognozė..."

#. A label on a button. When the button is clicked by the user, the window will close.
#: en/calculator.gui.php:764
#: en/calculator.gui.php:811
#: en/calculator.gui.php:845
#: en/calculator.gui.php:879
msgid "Close"
msgstr "Uždaryti"

#. A title which appears in a modal's header section. This indicates it's a "message" for the user.
#: en/calculator.gui.php:868
msgid "Message"
msgstr "Pranešimas"

#. An informative message shown to a user after making a data entry error.
#: fc-retirement-savings-calculator.php:455
msgid "Please enter a valid number for"
msgstr "Prašome įvesti galiojantį skaičių"

#. An informative message shown to a user after making a data entry error.
#: fc-retirement-savings-calculator.php:1094
msgid "Please enter a valid number for \"Default current age.\""
msgstr "Įveskite galiojantį skaičių laukui \"Numatytasis dabartinis amžius.\""

#. An informative message shown to a user after making a data entry error.
#: fc-retirement-savings-calculator.php:1099
msgid "Please enter a valid number for \"Default retirement age.\""
msgstr "Įveskite galiojantį skaičių laukui \"Numatytasis pensinio amžius.\""

#. An informative message shown to a user after making a data entry error.
#: fc-retirement-savings-calculator.php:1104
msgid "Please enter a valid number for \"Default current savings.\""
msgstr "Įveskite galiojantį skaičių laukui \"Numatytosios dabartinės santaupos.\""

#. An informative message shown to a user after making a data entry error.
#: fc-retirement-savings-calculator.php:1109
msgid "Please enter a valid number for \"Default amount at retirement.\""
msgstr "Įveskite tinkamą skaičių „Numatyta suma pensijai.“"

#. An informative message shown to a user after making a data entry error.
#: fc-retirement-savings-calculator.php:1114
msgid "Please enter a valid number for \"Default interest rate.\""
msgstr "Prašome įvesti galiojantį skaičių laukelyje „Numatytoji palūkanų norma“."

#. An informative message shown to a user after making a data entry error.
#: fc-retirement-savings-calculator.php:1120
msgid "Please enter a valid value for \"Default Currency.\""
msgstr "Įveskite galiojančią reikšmę laukelyje \"Numatytoji valiuta\"."

#. The date format maps to a number. An informative message shown to a user after making a data entry error.
#: fc-retirement-savings-calculator.php:1124
msgid "Please enter a valid number for \"Default Date Format.\""
msgstr "Įveskite galiojantį skaičių laukelyje \"Numatytojo datos formato\"."

#. An instructional message to the user appearing on a set up screen.
#: fc-retirement-savings-calculator.php:1218
msgid "Do not forget to save your changes. Scroll all the way down in this panel for the <span class=\"red\">[Save]</span> button."
msgstr "Nepamirškite išsaugoti pakeitimų. Slinkite šio skydelio apačion iki <span class=\"red\">[Išsaugoti]</span> mygtuko."

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-retirement-savings-calculator.php:1223
msgid "Widget's size (size limits adjustable below)?"
msgstr "Valdiklio dydis (dydžio ribos reguliuojamos žemiau)?"

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-retirement-savings-calculator.php:1225
msgid "Tiny (max width = 180px)"
msgstr "Labai mažas (maksimalus plotis = 180px)"

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-retirement-savings-calculator.php:1226
msgid "Small (max width = 300px)"
msgstr "Mažas (maksimalus plotis = 300px)"

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-retirement-savings-calculator.php:1227
msgid "Medium (max width = 340px)"
msgstr "Vidutinis (maksimalus plotis = 340px)"

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-retirement-savings-calculator.php:1228
msgid "Large (max width = 440px)"
msgstr "Didelis (maksimalus plotis = 440px)"

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-retirement-savings-calculator.php:1235
msgid "Load custom style sheet?"
msgstr "Įkelti pasirinktinį stiliaus lapą?"

#. The negative answer to a binary question.
#: fc-retirement-savings-calculator.php:1237
#: fc-retirement-savings-calculator.php:1404
#: fc-retirement-savings-calculator.php:1413
#: fc-retirement-savings-calculator.php:1424
msgid "No"
msgstr "Ne"

#. The positive answer to a binary question.
#: fc-retirement-savings-calculator.php:1238
#: fc-retirement-savings-calculator.php:1405
#: fc-retirement-savings-calculator.php:1414
#: fc-retirement-savings-calculator.php:1425
msgid "Yes"
msgstr "Taip"

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-retirement-savings-calculator.php:1242
msgid "If \"Yes\" loads &lt;site&gt;\\wp-content\\plugins\\ac-retirement-savings-calculator-plus\\css\\accurate-calculators-custom.css. Entries in <b>accurate-calculators-custom.css</b> override the plugin's look. Editing the provided custom stylesheet is another way to modify the look of the calculator. For best performance include only the rules in the custom stylesheet you are overriding. BACKUP YOUR CUSTOMIZATIONS! You will need to manually replace them when (if) you upgrade the plugin."
msgstr "Jei „Taip“, įkeliama &lt;site&gt;\\wp-content\\plugins\\ac-retirement-savings-calculator-plus\\css\\accurate-calculators-custom.css. Įrašai <b>accurate-calculators-custom.css</b> failuose pakeičia įskiepio išvaizdą. Pateikto stiliaus lapo redagavimas yra dar vienas būdas pakeisti skaičiuotuvo išvaizdą. Siekiant geriausio našumo, įtraukite tik tas taisykles, kurias reikia pakeisti. ATLIKITE ATSARGINES KOPIJAS! Juos reikės rankiniu būdu pakeisti atnaujinant įskiepį."

#. A configuration option set by the website's developer for setting the websites default currency symbol - not user facing.
#: fc-retirement-savings-calculator.php:1248
msgid "Set a default currency?"
msgstr "Nustatyti numatytąją valiutą?"

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-retirement-savings-calculator.php:1250
msgid "Use visitor's browser's settings to set currency - do not override."
msgstr "Naudokite lankytojo naršyklės nustatymus valiutai nustatyti - nepakeiskite jų."

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-retirement-savings-calculator.php:1374
msgid "Set a date format convention?"
msgstr "Nustatyti datos formato konvenciją?"

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-retirement-savings-calculator.php:1376
msgid "Use visitor's browser's settings to set date format - do not override."
msgstr "Naudokite lankytojo naršyklės nustatymus datos formatui nustatyti - nepakeiskite."

#. An instruction or clarification for the website's administrator - not end-user facing.
#: fc-retirement-savings-calculator.php:1388
msgid "When a user first visits your site, the plugin will use the browser's international conventions to set the currency and date format. If you wish, you may override the plugin and set a default currency and date format. The user will still have the ability to override either setting if you do not hide the &quot;international conventions&quot; below."
msgstr "Kai vartotojas pirmą kartą apsilanko jūsų svetainėje, įskiepis naudos naršyklės tarptautines nuostatas valiutai ir datos formatui nustatyti. Jei pageidaujate, galite pakeisti įskiepio nustatymus ir nustatyti numatytąją valiutą ir datos formatą. Vartotojas vis tiek galės pakeisti šiuos nustatymus, jei nepaslėpsite &quot;tarptautinių nuostatų&quot; žemiau."

#. An instruction or clarification for the website's administrator - not end-user facing.
#: fc-retirement-savings-calculator.php:1393
msgid "<strong>Note:</strong> Your visitors may select a date format and currency by clicking on <span class=\"red\">$ : MM/DD/YYYY</span> in the calculator's lower right corner if you do not set \"Hide international conventions\" to \"yes\"."
msgstr "<strong>Pastaba:</strong> Jūsų lankytojai gali pasirinkti datos formatą ir valiutą paspaudę <span class=\"red\">$ : MM/DD/YYYY</span> skaičiuoklės apatiniame dešiniajame kampe, jei nenustatėte „Paslėpti tarptautines nuostatas“ kaip „taip“."

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-retirement-savings-calculator.php:1402
msgid "Hide the resize buttons?"
msgstr "Paslėpti dydžio keitimo mygtukus?"

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-retirement-savings-calculator.php:1411
msgid "Hide international conventions?"
msgstr "Paslėpti tarptautines konvencijas?"

#. Inital part of a string asking site's administrator if they want to "link to" another site.  Administrator will answer 'Yes' or 'No'.
#: fc-retirement-savings-calculator.php:1422
msgid "Link to"
msgstr "Nuoroda į"

#. An instruction or clarification for the website's administrator - not end-user facing.
#: fc-retirement-savings-calculator.php:1434
msgid "If \"Link to AccurateCalculators.com\" is set to \"Yes\", one very discreet follow link will be inserted in the calculator. If you allow the link, you may rebrand the calculator with your name. Resetting this option to \"No\" at any time will remove the links. See FAQ's in readme file for details."
msgstr "Jei „Nuoroda į AccurateCalculators.com“ nustatyta kaip „Taip“, skaičiuoklėje bus įdėta viena labai subtili sekimo nuoroda. Jei leisite nuorodą, galėsite pervadinti skaičiuoklę savo vardu. Bet kuriuo metu pakeitus šią parinktį į „Ne“, nuorodos bus pašalintos. Daugiau informacijos rasite DUK faile."

#. A prompt asking site's administrator for their brand name.
#: fc-retirement-savings-calculator.php:1439
msgid "Add Your Brand Name"
msgstr "Pridėkite savo prekės ženklą"

#. An instruction or clarification for the website's administrator - not end-user facing.
#: fc-retirement-savings-calculator.php:1443
msgid "You may brand this widget with your brand. <b>Example: \"Abe's Best\"</b> will be preappended to \"Loan Calculator\". For this to work, the above \"Link to\" option must be set to \"Yes\"."
msgstr "Galite priskirti šiam valdikliui savo prekės ženklą. <b>Pavyzdys: „Abe's Best“</b> bus pridėtas prie „paskolos skaičiuoklė“. Kad tai veiktų, aukščiau esanti parinktis „Nuoroda į“ turi būti nustatyta kaip „Taip“."

#. A prompt for the site's developer instructing them to set a site-wide default value for a user entered value. Not user facing.
#: fc-retirement-savings-calculator.php:1454
msgid "Default current age"
msgstr "Numatytasis dabartinis amžius"

#. A prompt for the site's developer instructing them to set a site-wide default value for a user entered value. Not user facing.
#: fc-retirement-savings-calculator.php:1460
msgid "Default retirement age"
msgstr "Numatytasis išėjimo į pensiją amžius"

#. A prompt for the site's developer instructing them to set a site-wide default value for a user entered value. Not user facing.
#: fc-retirement-savings-calculator.php:1467
msgid "Default current retirement savings"
msgstr "Numatytosios dabartinės pensijų santaupos"

#. A prompt for the site's developer instructing them to set a site-wide default value for a user entered value. Not user facing.
#: fc-retirement-savings-calculator.php:1473
msgid "Default annual interest rate"
msgstr "Numatytoji metinė palūkanų norma"

#. A prompt for the site's developer instructing them to set a site-wide default value for a user entered value. Not user facing.
#: fc-retirement-savings-calculator.php:1480
msgid "Default amount at retirement"
msgstr "Numatyta suma pensijai"

#. An instructional or clarification message concerning data entry requirements.
#: fc-retirement-savings-calculator.php:1486
msgid "Enter only digits.<br>No currency or formatting."
msgstr "Įveskite tik skaitmenis.<br>Be valiutos ar formatavimo."

#. A sectional label on a settings page for administrator settings that impact style.
#: fc-retirement-savings-calculator.php:1496
msgid "Style options."
msgstr "Stiliaus parinktys."

#. An instructional message to the site's administrator explaining setting website color option.
#: fc-retirement-savings-calculator.php:1498
msgid "(Defaults in parentheses. \"hex\", \"rgb\", or \"rgba\" values accepted for colors.)"
msgstr "(Numatytieji nustatymai skliausteliuose. Priimamos „hex“, „rgb“ arba „rgba“ spalvų reikšmės.)"

