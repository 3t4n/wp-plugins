.edd-enhanced-sales-reports-tabs {
	padding: 10px;
	background: #fff;
	border: 1px solid #ddd;
}

.edd-enhanced-sales-reports-tabs-headings {
	border-bottom: 1px solid #ddd;
	display: flex;
}

.edd-enhanced-sales-reports-tabs-headings a {
	text-decoration: none;
	display: inline-block;
	position: relative;
	background: #ddd;
	padding: 5px 10px;
	border-top-right-radius: 4px;
	border-top-left-radius: 4px;
	color: #333;
	font-weight: 600;
	margin-right: 7px;
}

.edd-enhanced-sales-reports-tabs-headings a.active {
	background: #2271b1;
	color: #fff;
}

.edd-enhanced-sales-reports-tabs-headings a:hover {
	background: #eee;
}

.edd-enhanced-sales-reports-tabs-contents {
	margin-top: 14px;
}

.edd-enhanced-sales-reports-form-field {
	width: 100%;
	display: flex;
	flex-wrap: wrap;
}

.edd-enhanced-sales-reports-form-field label {
	max-width: 100%;
	width: 200px;
	font-weight: 600;
	padding-top: 5px;
}

.edd-enhanced-sales-reports-form-field-control {
	width: calc(100% - 200px);
	max-width: 100%;
}

.edd-enhanced-sales-reports-form-field-control .select2-container {
	min-width: 100%;
}

.edd-enhanced-sales-reports-form-row {
	margin-bottom: 10px;
	padding-bottom: 10px;
	border-bottom: 1px solid #f0f0f0;
}

.edd-enhanced-sales-reports-form-row input,
.edd-enhanced-sales-reports-form-row select {
	width: 100%;
	max-width: 100%;
}

.edd-enhanced-sales-reports-form-row .select2-selection--single {
	border-color: #8c8f94;
}

.edd-enhanced-sales-reports-tabs-contents form {
	border-bottom: 1px solid #ddd;
	margin-bottom: 30px;
	padding-bottom: 24px;
}

.edd-enhanced-sales-reports-tabs-contents .dataTables_wrapper .dataTables_length select {
	padding-right: 18px;
}

.edd-enhanced-sales-reports-tabs-contents .select2-container--default .select2-selection--multiple .select2-selection__rendered li {
	padding-right: 10px;
	padding-left: 26px;
}

.edd-enhanced-sales-reports-tabs-contents tr.odd {
	background: #f9f9f9;
}

.edd-enhanced-sales-reports-tabs-contents tr:hover {
	background: #f6f6f6;
}

.edd-enhanced-sales-reports-form-actions .button {
	padding: 4px 30px;
	margin-right: 10px;
}

.edd-advanced-sales-reports-filters-toggle .button {
	padding: 0 38px;
}

.edd-enhanced-sales-reports-kpis {
	margin-left: -0.5%;
	margin-right: -0.5%;
	display: flex;
	flex-wrap: wrap;
}

.edd-enhanced-sales-reports-kpi {
	width: 17.45%;
	width: calc((100% / 5) - 1%);
	min-width: 100px;
	border: 1px solid #ddd;
	background: #f6f6f6;
	margin: 0 0.5% 16px;
	text-align: center;
	padding: 24px 12px;
	box-sizing: border-box;
}

.edd-enhanced-sales-reports-kpi strong {
	display: block;
	font-size: 34px;
	line-height: 1.2;
}

.edd-enhanced-sales-reports-top-chart table {
	width: 100%;
	border-collapse: collapse;
}

.edd-enhanced-sales-reports-top-chart th, .edd-enhanced-sales-reports-top-chart td {
	border: 1px solid #f3f3f3;
	padding: 5px 10px;
	text-align: left;
}

.edd-enhanced-sales-reports-top-chart th {
	background: #f3f3f3;
}

.edd-enhanced-sales-reports-earnings-range {
	display: flex;
	width: 100%;
}

.edd-enhanced-sales-reports-earnings-range input {
	width: calc(100% - 10px);
	margin: 0 10px 5px 0;
}

.edd-enhanced-sales-reports-earnings-range input:last-child {
	margin-right: 0;
}

.edd-enhanced-sales-reports-form-row {
	display: flex;
	flex-wrap: wrap;
	justify-content: space-between;
}

.edd-enhanced-sales-reports-form-field.edd-enhanced-sales-reports-half-field {
	width: 49%;
}

.edd-enhanced-sales-reports-secondary-chart canvas,
.edd-enhanced-sales-reports-chart canvas {
	width: 100%;
	height: 350px;
	max-height: 350px;
	display: block;
	margin-bottom: 30px;
}

.edd-enhanced-sales-reports-tabs-contents .edd-advanced-sales-reports-filters-show {
	display: none;
}

.edd-advanced-sales-reports-filters-toggle.edd-advanced-sales-reports-filters-hidden .edd-advanced-sales-reports-filters-show {
	display: inline-block;
}

.edd-advanced-sales-reports-filters-toggle.edd-advanced-sales-reports-filters-hidden .edd-advanced-sales-reports-filters-hide {
	display: none;
}

.edd-advanced-sales-reports-filters-hidden ~ .edd-enhanced-sales-reports-form-filters-wrap {
	display: none;
}

.edd-advanced-sales-reports-filters-toggle {
	margin-bottom: 16px;
}

.edd-enhanced-sales-reports-top-chart {
	margin-bottom: 40px;
}

.edd-enhanced-sales-reports-reporting-modal-overlay {
	position: fixed;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	background: rgba(0, 0, 0, 0.25);
	z-index: 99;
	opacity: 0;
	visibility: hidden;
	transition: opacity 0.25s, visibility 0.25s;
}

.edd-enhanced-sales-reports-reporting-modal-overlay.edd-enhanced-sales-reports-reporting-modal-active {
	opacity: 1;
	visibility: visible;
}

.edd-enhanced-sales-reports-reporting-modal {
	position: fixed;
	top: 50%;
	left: 50%;
	background: #fff;
	z-index: 99;
	box-shadow: 0 0 4px rgba(0, 0, 0, 0.15);
	padding: 20px 10px;
	max-height: calc(100vh - 30px);
	overflow-y: auto;
	transform: translate(-50%, -20%);
	opacity: 0;
	visibility: hidden;
	transition: opacity 0.25s, visibility 0.25s, transform 0.25s;
}

.edd-enhanced-sales-reports-reporting-modal-active + .edd-enhanced-sales-reports-reporting-modal {
	padding-right: 40px;
	opacity: 1;
	visibility: visible;
	transform: translate(-50%, -50%)
}

.edd-enhanced-sales-reports-reporting-modal h3 {
	margin: 0 0 20px;
	border-bottom: 1px solid #ddd;
	padding-bottom: 10px;
}

.edd-enhanced-sales-reports-reporting-modal table {
	width: 100%;
	border-collapse: collapse;
	text-align: left;
}

.edd-enhanced-sales-reports-reporting-modal table th, .edd-enhanced-sales-reports-reporting-modal table td {
	padding: 7px;
	border-bottom: 1px solid #ddd;
}

.edd-enhanced-sales-reports-reporting-modal-close {
	position: absolute;
	right: 10px;
	top: 10px;
	cursor: pointer;
}

.edd-enhanced-sales-reports-reporting-modal .edd-esr-align-right,
.edd-enhanced-sales-reports-reporting-page .edd-esr-align-right {
	text-align: right;
}

.edd-enhanced-sales-reports-top-chart-header {
	margin-bottom: 20px;
	display: flex;
	justify-content: space-between;
	align-items: center;
}

.edd-enhanced-sales-reports-top-charts {
	display: flex;
	flex-wrap: wrap;
	justify-content: space-between;
}

.edd-enhanced-sales-reports-top-chart {
	width: 49%;
	border: 1px solid #ddd;
	padding: 20px 10px;
	box-sizing: border-box;
	margin: 0 0.5% 30px;
}

.edd-enhanced-sales-reports-top-chart-full {
	width: 100%;
}

.edd-enhanced-sales-reports-top-chart-full ~ .edd-enhanced-sales-reports-top-chart {
	width: 32%;
}

.edd-enhanced-sales-reports-top-chart h3 {
	margin: 0;
}

.edd-enhanced-sales-reports-reporting-modal .dataTables_wrapper .dt-buttons,
.edd-enhanced-sales-reports-reporting-page .dataTables_wrapper .dt-buttons {
	margin-left: 10px;
}

.edd-enhanced-sales-reports-reporting-modal .dataTables_wrapper .dataTables_length select,
.edd-enhanced-sales-reports-reporting-page .dataTables_wrapper .dataTables_length select {
	min-width: 60px;
}

.edd-enhanced-sales-reports-result[data-type="by-subscriptions"] .dataTable td:nth-child(1),
.edd-enhanced-sales-reports-result[data-type="by-subscriptions"] .dataTable td:nth-child(5),
.edd-enhanced-sales-reports-result[data-type="by-subscriptions"] .dataTable td:nth-child(8),
.edd-enhanced-sales-reports-result[data-type="by-subscriptions"] .dataTable td:nth-child(10),
.edd-enhanced-sales-reports-result[data-type="by-subscriptions"] .dataTable td:nth-child(11),
.edd-enhanced-sales-reports-result[data-type="by-subscriptions"] .dataTable td:nth-child(13),
.edd-enhanced-sales-reports-result[data-type="by-vendor"] .dataTable td:nth-child(n+3),
.edd-enhanced-sales-reports-result[data-type="by-state"] .dataTable td:nth-child(n+3),
.edd-enhanced-sales-reports-result[data-type="by-country"] .dataTable td:nth-child(n+2),
.edd-enhanced-sales-reports-result[data-type="by-orders"] .dataTable td:nth-child(n+6),
.edd-enhanced-sales-reports-result[data-type="by-ordered-products"] .dataTable td:nth-child(n+8),
.edd-enhanced-sales-reports-result[data-type="by-products"] .dataTable td:nth-child(n+4),
.edd-enhanced-sales-reports-result[data-type="by-customer"] .dataTable td:nth-child(n+3) {
	text-align: right;
}

.edd-enhanced-sales-reports-tabs th,
.edd-enhanced-sales-reports-tabs td {
	vertical-align: top;
}

.edd-enhanced-sales-reports-tabs-contents .edd-enhanced-sales-reports-reset {
	background: #eb1111;
	border-color: #eb1111;
}

.edd-enhanced-sales-reports-tabs-contents .edd-enhanced-sales-reports-reset:hover {
	background: #b10d0d;
	border-color: #b10d0d;
}

.edd-esr-chart-tabs-hds {
	display: flex;
	border-bottom: 1px solid #ddd;
}

.edd-esr-chart-tabs-hds a {
	display: inline-block;
	background: #ddd;
	color: #333;
	border-top-right-radius: 4px;
	border-top-left-radius: 4px;
	text-decoration: none;
	padding: 5px 10px;
	margin-right: 10px;
}

.edd-esr-chart-tabs {
	position: relative;
}

.edd-esr-chart-tabs-hds .edd-esr-chart-tab-active {
	background: #2571af;
	color: #fff;
}

.edd-esr-tertiary-chart,
.edd-esr-secondary-chart {
	position: absolute;
	bottom: 0;
	left: 0;
	width: 100%;
	height: 350px;
	background: #fff;
	z-index: 1;
	opacity: 0;
	visibility: hidden;
}

.edd-esr-tertiary-chart.edd-esr-active,
.edd-esr-secondary-chart.edd-esr-active {
	opacity: 1;
	visibility: visible;
}

.edd-esr-bold-last > tr:last-child {
	font-weight: 600;
}

.edd-enhanced-sales-reports-subscription-callout {
	background: #fff;
	border: 1px solid #ddd;
	padding: 10px;
}

.edd-enhanced-sales-reports-subscription-callout h3 {
	margin: 0;
}

.edd-enhanced-sales-reports-subscription-callout-main .edd-enhanced-sales-reports-subscription-form {
	display: flex;
	align-items: center;
}

.edd-enhanced-sales-reports-subscription-callout-main .edd-enhanced-sales-reports-subscription-form input {
	width: 100%;
	max-width: 350px;
	margin-bottom: 0;
	height: 30px;
}

.edd-enhanced-sales-reports-subscription-callout.edd-enhanced-sales-reports-ajaxing {
	position: relative;
}

.edd-enhanced-sales-reports-subscription-callout.edd-enhanced-sales-reports-ajaxing:before {
	content: '';
	display: block;
	width: 100%;
	height: 100%;
	background: #fff;
	opacity: 0.8;
	position: absolute;
	top: 0;
	left: 0;
}

.edd-enhanced-sales-reports-subscription-callout.edd-enhanced-sales-reports-ajaxing:after {
	content: '';
	display: block;
	width: 16px;
	height: 16px;
	position: absolute;
	right: 15px;
	top: 15px;
	border: 2px solid #000;
	border-radius: 50%;
	border-right-color: transparent;
	animation: edd_enhanced_sales_reports_ajaxing 1s infinite linear;
}

@keyframes edd_enhanced_sales_reports_ajaxing {
	to {
		transform: rotate(360deg);
	}
}

.edd-enhanced-sales-reports-tabs-headings .edd-enhanced-sales-reports-tab-pro-heading {
	background-color: #10c026;
	color: #fff;
}

.edd-enhanced-sales-reports-tabs-headings .edd-enhanced-sales-reports-tab-pro-heading:hover {
	background-color: #0b8f1b;
	color: #fff;
}

@media all and (max-width: 1350px) {
	.edd-enhanced-sales-reports-top-chart {
		width: 49%;
	}
}

@media all and (max-width: 900px) {
	.edd-enhanced-sales-reports-kpi {
		min-width: 200px;
	}

	.edd-enhanced-sales-reports-top-chart {
		width: 100%;
		margin-left: 0;
		margin-right: 0;
	}
}