#edd_enhanced_sales_reports_settings_tabs_header {
	display: flex;
	flex-wrap: wrap;
	list-style: none;
	margin: 0;
	position: relative;
	top: 1px;
}

#edd_enhanced_sales_reports_settings_tabs_header a {
	display: inline-block;
	text-decoration: none;
	background: #f1f1f1;
	padding: 6px 16px;
	margin-right: 4px;
	border: 1px solid #dfdfdf;
	border-top-right-radius: 4px;
	border-top-left-radius: 4px;
	color: #333;
}

#edd_enhanced_sales_reports_settings_tabs_header li {
	margin: 0;
}

.edd-enhanced-sales-reports-tab-content {
	padding: 18px;
	border: 1px solid #ddd;
	background: #fff;
}

.edd-enhanced-sales-reports-tab-content:not(.edd-enhanced-sales-reports-tab-active) {
	display: none;
}

#edd_enhanced_sales_reports_settings_tabs_header a.edd-enhanced-sales-reports-tab-active {
	background: #fff;
	border-bottom-color: #fff;
}

#edd_enhanced_sales_reports_settings_tabs_header a:hover {
	background: #fff;
}

.edd-enhanced-sales-reports-other-plugins {
	margin-top: 50px;
	max-width: 1500px;
	display: flex;
	flex-wrap: wrap;
}

.edd-enhanced-sales-reports-other-plugins img {
	max-width: 100%;
	height: auto;
}

.edd-enhanced-sales-reports-other-plugin {
	width: 31.5%;
	background: #fff;
	box-shadow: 0 0 4px rgba(0,0,0,0.15);
	margin-bottom: 24px;
	margin-right: 1.83%;
}

.edd-enhanced-sales-reports-other-plugin-title a {
	padding: 12px 10px 0;
	color: #000;
	font-weight: 500;
	text-decoration: none;
	background: #fefefe;
	font-size: 19px;
	line-height: 1.5;
	min-height: 56px;
	display: flex;
	align-items: center;
	flex-wrap: wrap;
}

.edd-enhanced-sales-reports-other-plugin-links {
	display: flex;
	align-items: center;
	padding: 0 10px 10px;
}

.edd-enhanced-sales-reports-other-plugin-links a {
	text-decoration: none;
}

.edd-enhanced-sales-reports-other-plugin-links div:not(:last-child):after {
	content: ' | ';
	padding: 0 5px;
}

.edd-enhanced-sales-reports-other-plugin-desc {
	padding: 14px;
	line-height: 1.6;
}

.edd-enhanced-sales-reports-other-plugin-image {
	max-height: 320px;
	overflow: hidden;
	height: 320px;
}

.edd-enhanced-sales-reports-subscription-callout {
	background: #fff;
	border: 1px solid #ddd;
	padding: 10px;
}

.edd-enhanced-sales-reports-subscription-callout h3 {
	margin: 0;
}

.edd-enhanced-sales-reports-subscription-callout-main .edd-enhanced-sales-reports-subscription-form {
	display: flex;
	align-items: center;
}

.edd-enhanced-sales-reports-subscription-callout-main .edd-enhanced-sales-reports-subscription-form input {
	width: 100%;
	max-width: 350px;
}

.edd-enhanced-sales-reports-subscription-callout.ajaxing {
	position: relative;
}

.edd-enhanced-sales-reports-subscription-callout.ajaxing:before {
	content: '';
	display: block;
	width: 100%;
	height: 100%;
	background: #fff;
	opacity: 0.8;
	position: absolute;
	top: 0;
	left: 0;
}

.edd-enhanced-sales-reports-subscription-callout.ajaxing:after {
	content: '';
	display: block;
	width: 16px;
	height: 16px;
	position: absolute;
	right: 15px;
	top: 15px;
	border: 2px solid #000;
	border-radius: 50%;
	border-right-color: transparent;
	animation: ajaxing 1s infinite linear;
}

@keyframes ajaxing {
	to {
		transform: rotate(360deg);
	}
}

.button.edd-enhanced-sales-reports-ajaxing {
    position: relative;
    color: transparent !important;
}

.button.edd-enhanced-sales-reports-ajaxing:before {
    content: '';
    display: block;
    width: 12px;
    height: 12px;
    border: 2px solid #2271b1;
    border-radius: 50%;
    border-right-color: transparent;
    position: absolute;
    top: 50%;
    left: 50%;
    margin-top: -8px;
    margin-left: -8px;
    animation: edd_enhanced_sales_reports_rotate 1s infinite linear;
}

@keyframes edd_enhanced_sales_reports_rotate {
    to {
        transform: rotate(360deg);
    }
}