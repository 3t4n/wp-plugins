.cp24-membership-login-template-v1{direction:ltr}body.rtl .cp24-membership-login-template-v1{direction:rtl}.cp24-membership-login-template-v1 .cp24-form-wrap{background:#fff;border:1px solid #cecece;border-radius:10px;box-shadow:0 10px 5px 0 rgba(0,0,0,.25);min-height:30px;padding:54px}.cp24-membership-login-template-v1 .cp24-membership-login-username-and-or-email-wrap label,.cp24-membership-login-template-v1 .cp24-membership-login-password-wrap label{padding:0;margin:0 0 6px 0;font-family:Arial,sans-serif;font-size:16px;font-weight:600;color:#333;letter-spacing:.5px;text-transform:capitalize;line-height:1.5;display:block}.cp24-membership-login-template-v1 .cp24-membership-login-username-and-or-email-wrap input[type=text],.cp24-membership-login-template-v1 .cp24-membership-login-username-and-or-email-wrap input[type=password],.cp24-membership-login-template-v1 .cp24-membership-login-password-wrap input[type=text],.cp24-membership-login-template-v1 .cp24-membership-login-password-wrap input[type=password]{width:100%;padding:12px 15px;margin-bottom:15px;border:1px solid #ccc;border-radius:5px;box-sizing:border-box;font-size:14px;color:#333;background-color:#f9f9f9;transition:border-color .3s,box-shadow .3s}.cp24-membership-login-template-v1 .cp24-membership-login-username-and-or-email-wrap input[type=text]:focus,.cp24-membership-login-template-v1 .cp24-membership-login-username-and-or-email-wrap input[type=password]:focus,.cp24-membership-login-template-v1 .cp24-membership-login-password-wrap input[type=text]:focus,.cp24-membership-login-template-v1 .cp24-membership-login-password-wrap input[type=password]:focus{border-color:#4caf50;box-shadow:0 0 5px rgba(76,175,80,.4);outline:none}.cp24-membership-login-template-v1 .cp24-membership-login-remember-me-wrap{display:flex;align-items:center;margin-bottom:20px;font-family:Arial,sans-serif;gap:10px}.cp24-membership-login-template-v1 .cp24-membership-login-remember-me-wrap input[type=checkbox]{width:20px;height:20px;margin-right:10px;cursor:pointer;accent-color:#4caf50;transition:background-color .3s,border .3s}.cp24-membership-login-template-v1 .cp24-membership-login-remember-me-wrap input[type=checkbox]:focus{box-shadow:none !important;border:none !important;outline:none !important}.cp24-membership-login-template-v1 .cp24-membership-login-remember-me-wrap input[type=checkbox]:checked{background-color:#4caf50;border:1px solid #4caf50;transition:background-color .3s,border .3s}.cp24-membership-login-template-v1 .cp24-membership-login-remember-me-wrap input[type=checkbox]:checked::before{content:"✔";display:block;text-align:center;color:#fff;font-weight:bold;font-size:14px}.cp24-membership-login-template-v1 .cp24-membership-login-remember-me-wrap label{font-size:14px;color:#333;cursor:pointer;letter-spacing:.5px;text-transform:capitalize}.cp24-membership-login-template-v1 .cp24-membership-login-submit-wrap #cp24-membership-login-submit{border:none;border-radius:7px;color:#fff;padding:15px 32px;text-align:center;text-decoration:none;display:inline-block;font-size:16px;cursor:pointer;transition:all .4s ease-in-out;background-color:#2e2e2e;border:1px solid #fff}.cp24-membership-login-template-v1 .cp24-membership-login-submit-wrap #cp24-membership-login-submit:focus{box-shadow:none;outline:none}.cp24-membership-login-template-v1 .cp24-membership-login-submit-wrap #cp24-membership-login-submit:hover{background:rgba(0,0,0,0);border-color:#000;color:#000}.cp24-membership-login-template-v1 .cp24-membership-login-result-error{padding:15px 0;margin-top:10px;display:none;font-size:14px;font-weight:700;color:red}.cp24-membership-login-template-v1 .cp24-membership-login-result-success{padding:15px 0;margin-top:10px;display:none;font-size:14px;font-weight:700;color:#4caf50}
