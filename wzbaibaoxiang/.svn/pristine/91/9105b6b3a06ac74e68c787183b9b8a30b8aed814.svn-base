ZNt=Sl(()=>T("span",null,"积分剩余",-1)),JNt={class:"jf_tips"},eUt=["src"],tUt={class:"baiduseo_wztkj_ycjc_dialog"},rUt=Sl(()=>T("span",{class:"baiduseo_wztkj_ycjc_dialog_header"},"温馨提示！",-1)),aUt=Sl(()=>T("span",{class:"baiduseo_wztkj_ycjc_dialog_info"},[Re("该功能付费用户购买插件以后是不在收费的，因为插件用户很多每人的文章数量不同，有人提交10万篇有人提交几百篇，远程服务器就会被10万篇的用户全部占用导致其他用户无法处理文章。所以，目前针对用户做了限制如下："),T("br"),Re(" 1、未授权用户，每天可以提交10篇且只能手动在所有文章提交，不能自动执行。"),T("br"),Re(" 2、积分余额不足120的，每天可以自动提交100篇，一直到你所有文章都被检测过为止。"),T("br"),Re(" 3、积分余额高于120的，会自动根据您积分÷0.28＝每天可以检测的文章数量，一直到你所有文章都被检测过为止。"),T("br"),Re(" 4、积分只能用于“智能改写”“快速排名”，原创检测是不会扣积分。 注意：授权用户会赠送一定的积分体验智能改写及快速排名功能。另外，如果您服务器开了防火墙请放行seohnzz.com、rbzzz.com、网站因为他是远端服务器来处理这些数据的。")],-1)),nUt={class:"dialog-footer"},iUt={class:"baiduseo_wztkj_aigx_dialog"},oUt=Sl(()=>T("span",{class:"baiduseo_wztkj_aigx_dialog_header"},"温馨提示！",-1)),lUt=Sl(()=>T("div",{class:"baiduseo_wztkj_aigx_dialog_conter"},[T("span",{class:"baiduseo_wztkj_aigx_dialog_conter_info"},[Re(" 说明：在使用本功能以前请先设置低于百分比多少的文章才能进行改写，建议设置60%以下的文章进行智能改写效果会非常显著，智能改写是先进行原创率检测，在进行智能改写，改写以后的文章在进行原创率检测并跟第一次的原创率检测进行对比。当然智能改写是要扣积分的。智能改写的记录请在“原创检测”栏目下消耗记录内查看。"),T("br"),T("br"),Re(" 智能改写是对接的seo.5118的文章智能改写，有人问为什么我们自己不做词组库？答：因为词组库体量属于大数据级别，而且经过很多算法纠正语句通顺，我们无法做出很完善的词组库。但在SEO领域，一篇原创率很高的文章会非常招蜘蛛喜欢并且会快速收录，所以我们就应粉丝要求增加了这项另外付费的功能，希望在SEO领域再助大家一臂之力。"),T("br"),T("br"),Re(" 注意：授权用户会赠送一定的积分体验智能改写及快速排名功能。另外，如果您服务器开了防火墙请放行seohnzz.com、rbzzz.com、网站因为他是远端服务器来处理这些数据的。"),T("br"),T("br"),Re(" 部分主题的“经典编辑器”智能改写以后会导致只能排版乱掉，所以尽量不要使用经典编辑器因为wordpress已经停止了对他的更新和BUG修复，当然，这种情况只是个别的，所以您还是手动提交1-2篇测试没问题后在批量自动。"),T("br"),T("br"),Re(" 智能改写会改变原有的内容，请您谨慎开启，如果您的文章内容较为重要请勿开启该功能,否则后果自负。"),T("br"),T("br"),Re(" 注意：目前官网已经新增AI文章生成和自动改写功能，利用的是chatGPT,效果会更好，目前由于部分粉丝用户还是比较喜欢5118的数据所以该板块的原始改写功能保留，新功能改写可以在官网其他工具内查看。 ")])],-1)),sUt={class:"dialog-footer"},uUt=mr({__name:"OriginalYcdjcPage",setup(e){const t=`${baiduseo_wztkj_url}${$y}`,r=`${baiduseo_wztkj_url}${HN}`;let a=GN(),{ycjcValue:n,zngxValue:i,orininalData:o,percentage:l,ycjcDialogVisibles:s,isShowTable:u}=Ca(a);const{proxy