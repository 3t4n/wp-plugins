.leaflet-container{height:100%;position:relative}.map-block-leaflet-header{margin:0 0 .5rem;max-width:32rem;opacity:0;pointer-events:none;position:absolute;transition:opacity .25;width:100%;z-index:9999}.is-map-block-leaflet-selected{opacity:1;pointer-events:all;position:relative}.geounit_map_block a,.leaflet-control-zoom.leaflet-bar.leaflet-control>a{text-decoration:none}.wp-block-geounit-maps-block-geounit-maps-block .components-resizable-box__container.has-show-handle{z-index:0}.components-resizable-box__container.has-show-handle .components-resizable-box__handle{z-index:600}.info-control{background:#fff;-webkit-hyphens:auto;hyphens:auto;padding:.5rem;-ms-word-break:break-all;word-break:break-all;word-break:break-word}.leaflet-pane{z-index:0!important}
