.info-control {
  max-width: 100%;
  padding: .5rem;
  
  background: white;
  border-radius:10px;

  -ms-word-break: break-all;
  word-break: break-all;
  word-break: break-word;

  -webkit-hyphens: auto;
     -moz-hyphens: auto;
      -ms-hyphens: auto;
          hyphens: auto;
}

.info-control p {
  margin-bottom: 0;
}