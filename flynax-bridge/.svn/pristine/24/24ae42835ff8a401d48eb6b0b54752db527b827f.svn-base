<?php if ($errors): ?>
    <div class="notice notice-error">
        <p><?= __('<b>Flynax bridge</b>: Some of your widgets were configured incorrectly. They will not show in the User Interface');?></p>
    </div>

    <div class="flb-notice notice-error">
        <?php foreach ($errors as $error): ?>
            <p><?= __($error, 'flynax-bridge'); ?></p>
        <?php endforeach; ?>
    </div>
<?php endif; ?>
