  $selected = (isset($_SESSION['florist-one-flower-delivery-customer-country'])) ? sanitize_text_field($_SESSION['florist-one-flower-delivery-customer-country']) : sanitize_text_field("US");
  echo '<optgroup>';
  echo '<option value="' . esc_attr("US") . '" ' . (esc_attr($selected) == "US" ? esc_attr('selected="selected"') : "") . '>' . esc_html__( 'United States', 'flower-delivery-by-florist-one' ) .'</option>';
  echo '<option value="' . esc_attr("CA") . '" ' . (esc_attr($selected) == "CA" ? esc_attr('selected="selected"') : "")  . ' >' . esc_html__( 'Canada', 'flower-delivery-by-florist-one' ) .'</option>';
  echo '</optgroup>';
  echo '<optgroup label="' . esc_attr("&#8212;&#8212;&#8212;&#8212;&#8212;&#8212;") . '">';
  foreach ($countries_list as $key => $value) { 
      if (esc_html($selected) == esc_html($key)) {
        if(esc_html($key)  == "CA" || esc_html($key) == "US"){
          echo '<option value="' .  esc_attr($key) . '">' . esc_html($value) . '</option>';
        } else {
          echo '<option value="' . esc_attr($key) . '" selected="selected">'  . esc_html($value) .  '</option>';
        }  
      } else {
        echo '<option value="' . esc_attr($key) . '">' . esc_html($value) . '</option>';
      }
  }
  echo '</optgroup>';
    
