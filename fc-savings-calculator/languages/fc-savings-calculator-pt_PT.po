#: dist/js/interface.SAVINGS.gpl.js:69
msgid "Total Savings"
msgstr "Poupança total"

#. A report label. The user will understand the concept from its context. The translation must be concise.
#: dist/js/interface.SAVINGS.gpl.js:70
msgid "Number of Investments"
msgstr "Número de Investimentos"

