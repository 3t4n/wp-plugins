msgstr "Anulează"

#. A label on a button. Clicking the button causes the user selections to .be saved
#: en/calculator.gui.php:682
msgid "Save changes"
msgstr "Salvează modificările"

#: en/calculator.gui.php:706
msgid "Cash flow forecast..."
msgstr "Previziune flux de numerar..."

