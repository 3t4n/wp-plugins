#. Populate with the ISO language code aligning with the language for the msgstr.
#: dist/js/interface.SAVINGS.gpl.js:27
#: dist/js/interface.SAVINGS.gpl.js:838
msgid "en"
msgstr "es"

#. An instructional message about numeric input which may be shown to the calculator's user.
#: dist/js/interface.SAVINGS.gpl.js:28
#: dist/js/interface.SAVINGS.gpl.js:839
msgid "Please use the backspace key to delete."
msgstr "Por favor, utilice la tecla de retroceso para borrar."

#. An instructional message about numeric input which may be shown to the calculator's user.
#: dist/js/interface.SAVINGS.gpl.js:29
#: dist/js/interface.SAVINGS.gpl.js:840
msgid "Left, up & down arrow keys are disabled. So are the home, end, pgup and pgdn keys."
msgstr "Las teclas de flecha izquierda, arriba y abajo están desactivadas. También lo están las teclas de inicio, fin, pgup y pgdn."

#. An instructional message about numeric input which may be shown to the calculator's user.
#: dist/js/interface.SAVINGS.gpl.js:30
#: dist/js/interface.SAVINGS.gpl.js:841
msgid "Use backspace to delete."
msgstr "Utilice la tecla de retroceso para borrar."

#. An instructional message which may appear to the user suggesting efficient way to edit data.
#: dist/js/interface.SAVINGS.gpl.js:31
#: dist/js/interface.SAVINGS.gpl.js:842
msgid "If value is selected, just start typing new value to clear prior value."
msgstr "Si el valor está seleccionado, sólo tiene que empezar a escribir el nuevo valor para borrar el valor anterior."

#. Instructional message that may be shown to user when entering numbers.
#: dist/js/interface.SAVINGS.gpl.js:32
#: dist/js/interface.SAVINGS.gpl.js:843
msgid "When a number is selected (value shown in inverse), use right arrow key to clear selection without clearing value. Then backspace to edit."
msgstr "Cuando se selecciona un número (el valor se muestra en sentido inverso), utilice la tecla de flecha derecha para borrar la selección sin borrar el valor. A continuación, retroceda para editar."

#. Instructional message that may be shown to user when entering numbers.
#: dist/js/interface.SAVINGS.gpl.js:33
#: dist/js/interface.SAVINGS.gpl.js:844
msgid "TIP: Generally it is best to use the TAB or SHIFT-TAB keys to move from one input to the next or previous input."
msgstr "CONSEJO: En general, es mejor utilizar las teclas TAB o SHIFT-TAB para pasar de una entrada a la siguiente o a la anterior."

#. Instructional message that may be shown to user when entering numbers.
#: dist/js/interface.SAVINGS.gpl.js:34
#: dist/js/interface.SAVINGS.gpl.js:845
msgid "TIP 2: Generally, editing a value is inefficient. Since values are auto selected, just type the number you want."
msgstr "SUGERENCIA 2: En general, la edición de un valor es ineficiente. Dado que los valores se seleccionan automáticamente, basta con escribir el número que desee."

#. Instructional message that may be shown to user when entering numbers.
#: dist/js/interface.SAVINGS.gpl.js:35
#: dist/js/interface.SAVINGS.gpl.js:846
msgid "Do not type the thousand separator character."
msgstr "No escriba el carácter separador de miles."

#. Instructional message that may be shown to user when entering numbers.
#: dist/js/interface.SAVINGS.gpl.js:36
#: dist/js/interface.SAVINGS.gpl.js:847
msgid "(If using U.S. convention, that would be the comma.)"
msgstr "(Si se usa la convención de EE.UU., sería la coma.)"

#. A whimsical instructional message that may be shown to user when entering numbers.
#: dist/js/interface.SAVINGS.gpl.js:37
#: dist/js/interface.SAVINGS.gpl.js:848
msgid "I'm smart enough to enter them for you!"
msgstr "¡Soy lo suficientemente inteligente como para introducirlos por ti!"

#. An exception error message which user could potentially see.
#: dist/js/interface.SAVINGS.gpl.js:38
#: dist/js/interface.SAVINGS.gpl.js:849
msgid "An unknown date calculation error occurred."
msgstr "Se ha producido un error de cálculo de fecha desconocido."

#. Message asking user to provide details about an error condition.
#: dist/js/interface.SAVINGS.gpl.js:39
#: dist/js/interface.SAVINGS.gpl.js:850
msgid "Please provide us with your inputs and settings so that we can fix this. Thank you."
msgstr "Por favor, facilítenos sus datos y configuraciones para que podamos solucionarlo. Gracias."

#. An exception error message which user could potentially see.
#: dist/js/interface.SAVINGS.gpl.js:40
#: dist/js/interface.SAVINGS.gpl.js:851
msgid "Date is not valid - bad year."
msgstr "La fecha no es válida - año incorrecto."

#. Recognized abbreviation for January - abbreviation used due to limited space.
#: dist/js/interface.SAVINGS.gpl.js:41
#: dist/js/interface.SAVINGS.gpl.js:852
msgid "Jan"
msgstr "ene"

#. Recognized abbreviation for February - abbreviation used due to limited space.
#: dist/js/interface.SAVINGS.gpl.js:42
#: dist/js/interface.SAVINGS.gpl.js:853
msgid "Feb"
msgstr "feb"

#. Recognized abbreviation for March - abbreviation used due to limited space.
#: dist/js/interface.SAVINGS.gpl.js:43
#: dist/js/interface.SAVINGS.gpl.js:854
msgid "Mar"
msgstr "Mar"

#. Recognized abbreviation for April - abbreviation used due to limited space.
#: dist/js/interface.SAVINGS.gpl.js:44
#: dist/js/interface.SAVINGS.gpl.js:855
msgid "Apr"
msgstr "Abr"

#. The month of May.
#: dist/js/interface.SAVINGS.gpl.js:45
#: dist/js/interface.SAVINGS.gpl.js:856
msgid "May"
msgstr "Mayo"

#. Recognized abbreviation for June - abbreviation used due to limited space.
#: dist/js/interface.SAVINGS.gpl.js:46
#: dist/js/interface.SAVINGS.gpl.js:857
msgid "Jun"
msgstr "Jun"

#. Recognized abbreviation for July - abbreviation used due to limited space.
#: dist/js/interface.SAVINGS.gpl.js:47
#: dist/js/interface.SAVINGS.gpl.js:858
msgid "Jul"
msgstr "Jul"

#. Recognized abbreviation for August - abbreviation used due to limited space.
#: dist/js/interface.SAVINGS.gpl.js:48
#: dist/js/interface.SAVINGS.gpl.js:859
msgid "Aug"
msgstr "Ago"

#. Recognized abbreviation for September - abbreviation used due to limited space.
#: dist/js/interface.SAVINGS.gpl.js:49
#: dist/js/interface.SAVINGS.gpl.js:860
msgid "Sept"
msgstr "Sept."

#. Recognized abbreviation for October - abbreviation used due to limited space.
#: dist/js/interface.SAVINGS.gpl.js:50
#: dist/js/interface.SAVINGS.gpl.js:861
msgid "Oct"
msgstr "Oct"

#. Recognized abbreviation for November- abbreviation used due to limited space.
#: dist/js/interface.SAVINGS.gpl.js:51
#: dist/js/interface.SAVINGS.gpl.js:862
msgid "Nov"
msgstr "Nov"

#. Recognized abbreviation for December- abbreviation used due to limited space.
#: dist/js/interface.SAVINGS.gpl.js:52
#: dist/js/interface.SAVINGS.gpl.js:863
msgid "Dec"
msgstr "Dic."

#. An exception error message which user could potentially see.
#: dist/js/interface.SAVINGS.gpl.js:53
msgid "Error: dates out of sequence."
msgstr "Error: fechas fuera de secuencia."

#. Title for exception error message which user could potentially see. Title in modal header.
#: dist/js/interface.SAVINGS.gpl.js:54
msgid "Exception"
msgstr "Excepción"

#. A portion of an exception error message which user could potentially see.
#: dist/js/interface.SAVINGS.gpl.js:55
msgid "occurred when accessing"
msgstr "se produjo al acceder a"

#. A portion of an exception error message which user could potentially see.
#: dist/js/interface.SAVINGS.gpl.js:56
msgid "Invalid index"
msgstr "Índice no válido"

#. "YTD" stands for "Year-to-Date" totals. It is used as a row label in reports and must be translated as a commonly recognized abbreviation or kept within approximately 15 characters to fit formatting constraints.
#: dist/js/interface.SAVINGS.gpl.js:59
msgid "YTD"
msgstr "Año a la fecha"

#. "Running Totals" are accumulated totals calculated incrementally from the start of a sequence or period. This row label appears in reports with multiple cumulative totals in a single row. The term is plural because it refers to multiple totals.
#: dist/js/interface.SAVINGS.gpl.js:60
msgid "Running Totals"
msgstr "Totales acumulados"

#. A title centered over the cash flow section of a financial report.
#: dist/js/interface.SAVINGS.gpl.js:62
#: dist/js/interface.SAVINGS.gpl.js:138
msgid "Your Personalized Savings Schedule"
msgstr "Su programa de ahorros personalizado"

#. A title centered over a section of a financial report.
#: dist/js/interface.SAVINGS.gpl.js:67
msgid "Cash Flow Summary"
msgstr "Resumen de flujo de caja"

#. 'Savings' in a savings or investment account. (Not 'savings' on a price from a discount.) A report's label.
#: dist/js/interface.SAVINGS.gpl.js:69
msgid "Total Savings"
msgstr "Ahorros totales"

#. A report label. The user will understand the concept from its context. The translation must be concise.
#: dist/js/interface.SAVINGS.gpl.js:70
msgid "Number of Investments"
msgstr "Número de inversiones"

#. The return on investment amount. A report label. The user will understand the concept from its context. The translation must be concise. User understands from context in GUI.
#: dist/js/interface.SAVINGS.gpl.js:71
msgid "Return on Investment (ROI)"
msgstr "Retorno sobre la inversión (ROI)"

#. Total investment gain. A report label. The user will understand the concept from its context. The translation must be concise.
#: dist/js/interface.SAVINGS.gpl.js:72
msgid "Total Gain"
msgstr "Ganancia total"

#. A report label. The user will understand the concept from its context. The translation must be concise.
#: dist/js/interface.SAVINGS.gpl.js:73
msgid "Last Cash Flow Date"
msgstr "Fecha del último flujo de caja"

#. 'Years' is the number of years, usually the term expressed in years. A report label. The word 'years' must be translated in this context.
#: dist/js/interface.SAVINGS.gpl.js:74
msgid "Years"
msgstr "Años"

#. A centered title over a section of a financial report.
#: dist/js/interface.SAVINGS.gpl.js:82
#: dist/js/interface.SAVINGS.gpl.js:110
#: en/calculator.gui.php:443
msgid "Savings Schedule"
msgstr "Programa de ahorros"

#. A report's label for a specific calendar year. Example: "Year: 2024". The user will understand the concept from its context. The translation must be specifically for "year".
#: dist/js/interface.SAVINGS.gpl.js:83
msgid "Year"
msgstr "Año"

#. A specific date. Example: "Date: 11/30/2024". Frequently, a column label in a report or a prompt for user input. The translation must be specifically for 'date' in this context. It is NOT a romantic 'date.'
#: dist/js/interface.SAVINGS.gpl.js:84
msgid "Date"
msgstr "Fecha"

#. 'Deposit' as the deposit into a bank or investment account. (Not 'deposit' as in minieral deposit, or 'deposit' to hold for future purchase.) A report's label.
#: dist/js/interface.SAVINGS.gpl.js:85
#: dist/js/interface.SAVINGS.gpl.js:111
msgid "Deposit"
msgstr "Depósito"

#. Loan or investment interest amount. A report label. The user will understand the concept from its context. Must specifically translate "interest" in the financial sense.
#: dist/js/interface.SAVINGS.gpl.js:86
msgid "Interest"
msgstr "Interés"

#. The change in the investment amount. A report's column label.
#: dist/js/interface.SAVINGS.gpl.js:87
msgid "Net Change"
msgstr "Cambio neto"

#. The loan or investment balance as of a particular date. Used to label a column in a report. Must be concise.
#: dist/js/interface.SAVINGS.gpl.js:88
msgid "Balance"
msgstr "Saldo"

#. 'Savings' in a savings or investment account. (Not 'savings' on a price from a discount.) A report's label.
#: dist/js/interface.SAVINGS.gpl.js:91
msgid "Annual Savings"
msgstr "Ahorros anuales"

#. Annual interest amount. A report's label
#: dist/js/interface.SAVINGS.gpl.js:92
msgid "Annual Interest"
msgstr "Interés anual"

#. A report's label
#: dist/js/interface.SAVINGS.gpl.js:93
msgid "Change in Balance"
msgstr "Cambio en el saldo"

#. 'Savings' in a savings or investment account. (Not 'savings' on a price from a discount.) 'Interest' earned from the saving. A chart's label.
#: dist/js/interface.SAVINGS.gpl.js:94
msgid "Annual Savings and Interest Totals"
msgstr "Totales anuales de ahorros e intereses"

#. 'Savings' in a savings or investment account. (Not 'savings' on a price from a discount.) 'Interest' earned from the saving. A chart's label.
#: dist/js/interface.SAVINGS.gpl.js:95
msgid "Accumulated Savings and Interest"
msgstr "Ahorros e intereses acumulados"

#. 'Savings' in a savings or investment account. (Not 'savings' on a price from a discount.) 'Interest' earned from the saving. A chart's label.
#: dist/js/interface.SAVINGS.gpl.js:96
msgid "Amount Saved & Interest as Percentage of Total Value"
msgstr "Importe ahorrado e intereses como porcentaje del valor total"

#. Total investment from the beginning or accumulated total at a point in time. A report's row label.
#: dist/js/interface.SAVINGS.gpl.js:99
msgid "Running Investment"
msgstr "Inversión acumulada"

#. Accumulated savings at a point in time. A report's label.
#: dist/js/interface.SAVINGS.gpl.js:100
msgid "Running Savings"
msgstr "Ahorros acumulados"

#. Total interest from the beginning or accumulated total at a point in time. A report's row label.
#: dist/js/interface.SAVINGS.gpl.js:101
msgid "Running Interest"
msgstr "Interés acumulado"

#. A report's label.
#: dist/js/interface.SAVINGS.gpl.js:102
msgid "Total Deposits"
msgstr "Total de depósitos"

#. A report's label.
#: dist/js/interface.SAVINGS.gpl.js:103
msgid "Total Interest Earned"
msgstr "Total de intereses devengados"

#. A report's label.
#: dist/js/interface.SAVINGS.gpl.js:104
msgid "Total Value"
msgstr "Valor total"

#. Percentage of Total. A label for a financial report, chart or graph. Be concise. Okay to use recognized abbreviations.
#: dist/js/interface.SAVINGS.gpl.js:105
msgid "Pct. of Total"
msgstr "% del total"

#. The number of deposits made into an investment account. A report's label.
#: dist/js/interface.SAVINGS.gpl.js:107
msgid "Number of Deposits"
msgstr "Número de depósitos"

#. 'interest rate' is the nominal annual interest rate. A concise user prompt for an input or report's label.
#: dist/js/interface.SAVINGS.gpl.js:108
msgid "Interest Rate"
msgstr "Tasa de interés"

#. The total loan or investment interest. A report's label.
#: dist/js/interface.SAVINGS.gpl.js:109
msgid "Total Interest"
msgstr "Total de intereses"

#. Informational text for the calculator's user. The footnote in a financial report.
#: dist/js/interface.SAVINGS.gpl.js:112
msgid "\"Net Change\" is change from prior period i.e. prior balance plus deposit, plus interest less withdrawal."
msgstr "\"Variación neta\" es la variación respecto al periodo anterior, es decir, el saldo anterior más el depósito, más los intereses menos la retirada."

#. The centered title over a graph or chart.
#: dist/js/interface.SAVINGS.gpl.js:113
msgid "Annual Deposit and Interest Totals"
msgstr "Totales anuales de depósitos e intereses"

#. A title for a calculator plugin. May appear on a webpage.
#: dist/js/interface.SAVINGS.gpl.js:114
msgid "Accumulated Deposit and Interest"
msgstr "Depósito e intereses acumulados"

#. A report's label.
#: dist/js/interface.SAVINGS.gpl.js:115
msgid "Annual Deposit"
msgstr "Depósito anual"

#. An accumulated total at a point in time. A report's label.
#: dist/js/interface.SAVINGS.gpl.js:116
msgid "Running Deposit"
msgstr "Depósito acumulado"

#. Text in help modal.
#: dist/js/interface.SAVINGS.gpl.js:127
msgid "Savings Calculator — calculate future value"
msgstr "Calculadora de ahorros: calcula el valor futuro"

#. Informational text for the calculator's user. Keep HTML markup intact (as always)!
#: dist/js/interface.SAVINGS.gpl.js:128
msgid "<p>This calculator easily answers the question \"If I save \"X\" amount for \"Y\" months what will the value be at the end?\"</p>"
msgstr "<p>Esta calculadora responde fácilmente a la pregunta \"Si ahorro \"X\" cantidad durante \"Y\" meses, ¿cuál será el valor al final?\"</p>"

#. Informational text for the calculator's user. Keep HTML markup intact (as always)!
#: dist/js/interface.SAVINGS.gpl.js:129
msgid "<p>The user enters the \"Periodic Savings Amount\" (amount saved or invested every month); the \"Number of Months\" and the \"Annual Interest Rate\" or the annual rate of return one expects to earn on their investments.</p>"
msgstr "<p>El usuario ingresa el \"Monto de ahorros periódico\" (monto ahorrado o invertido cada mes); el \"Número de meses\" y la \"Tasa de interés anual\" o la tasa de rendimiento anual que se espera ganar en las inversiones.</p>"

#. Informational text for the calculator's user. Keep HTML markup intact (as always)!
#: dist/js/interface.SAVINGS.gpl.js:130
msgid "<p>The calculator quickly creates a savings schedule and a set of charts that will help the user see the relationship between the amount invested and the return on the investment.</p>"
msgstr "<p>La calculadora crea rápidamente un programa de ahorros y una serie de gráficos que ayudarán al usuario a ver la relación entre el monto invertido y el rendimiento de la inversión.</p>"

#. Informational text for the calculator's user. Keep HTML markup intact (as always)!
#: dist/js/interface.SAVINGS.gpl.js:131
msgid "<p>The investment term is always expressed in months.</p>"
msgstr "<p>El plazo de inversión siempre se expresa en meses.</p>"

#. Informative message providing conversions for user found in the calculator's help text. Retain HTML markup!
#: dist/js/interface.SAVINGS.gpl.js:132
msgid "<ul class=\"mono tail\"><li>&nbsp;60 months = &nbsp;5 years</li><li>120 months = 10 years</li><li>180 months = 15 years</li><li>240 months = 20 years</li><li class=\"tail\">360 months = 30 years</li></ul>"
msgstr "<ul class=\"mono tail\"><li>&nbsp;60 meses = &nbsp;5 años</li><li>120 meses = 10 años</li><li>180 meses = 15 años</li><li>240 meses = 20 años</li><li class=\"tail\">360 meses = 30 años</li></ul>"

#. Informational text for the calculator's user. Keep HTML markup intact (as always)!
#: dist/js/interface.SAVINGS.gpl.js:134
msgid "<p class=\"small\" style=\"font-size: 85%; line-height: 1.5; color:red; user-select: text\">If you need a more advanced \"Savings Calculator\" - one that lets the user solve for the starting amount, the amount to invest, the interest rate, the term required to reach a goal or the future value; or if you would like to easily print the schedule; or if you need to pick a different investment frequency, then you may want to try the calculator located here: <b>https://AccurateCalculators.com/savings-calculator</b></p>"
msgstr "<p class=\"small\" style=\"font-size: 85%; line-height: 1.5; color:red; user-select: text\">Si necesita una \"Calculadora de Ahorros\" más avanzada, una que permita al usuario resolver el monto inicial, el monto a invertir, la tasa de interés, el plazo necesario para alcanzar un objetivo o el valor futuro; o si desea imprimir fácilmente el programa; o si necesita elegir una frecuencia de inversión diferente, entonces puede probar la calculadora ubicada aquí: <b>https://AccurateCalculators.com/savings-calculator</b></p>"

#. Informational text for the calculator's user. Keep HTML markup intact (as always)!
#: dist/js/interface.SAVINGS.gpl.js:136
msgid "<p class=\"small\" style=\"font-size: 85%; line-height: 1.5; color:red; user-select: text\">If you need a more advanced \"Savings Calculator\" - one that lets the user solve for the starting amount, the amount to invest, the interest rate, the term required to reach a goal or the future value; or if you need to pick a different investment frequency, then you may want to try the calculator located here: <b>https://AccurateCalculators.com/savings-calculator</b></p>"
msgstr "<p class=\"small\" style=\"font-size: 85%; line-height: 1.5; color:red; user-select: text\">Si necesita una \"Calculadora de Ahorros\" más avanzada, una que permita al usuario resolver el monto inicial, el monto a invertir, la tasa de interés, el plazo necesario para alcanzar un objetivo o el valor futuro; o si necesita elegir una frecuencia de inversión diferente, entonces puede probar la calculadora ubicada aquí: <b>https://AccurateCalculators.com/savings-calculator</b></p>"

#. The person's name for whom a report is prepared. A report's label.
#: dist/js/interface.SAVINGS.gpl.js:140
msgid "Prepared for"
msgstr "Preparado para"

#. A report's label for a street address.
#: dist/js/interface.SAVINGS.gpl.js:142
#: dist/js/interface.SAVINGS.gpl.js:150
msgid "Address"
msgstr "Dirección"

#. A report's label for postal address details.
#: dist/js/interface.SAVINGS.gpl.js:144
msgid "City, State  ZIP"
msgstr "Ciudad, Estado  Código Postal"

#. The date a financial report was prepared. A report's label.
#: dist/js/interface.SAVINGS.gpl.js:146
msgid "Prepared On"
msgstr "Preparado el"

#. The person's name who prepared a report. A report's label.
#: dist/js/interface.SAVINGS.gpl.js:148
msgid "Prepared by"
msgstr "Preparado por"

#. A label for a phone number.
#: dist/js/interface.SAVINGS.gpl.js:152
msgid "Phone"
msgstr "Teléfono"

#. A report's label for an email address.
#: dist/js/interface.SAVINGS.gpl.js:154
msgid "Email"
msgstr "Correo electrónico"

#. A report's label for a website address or URL.
#: dist/js/interface.SAVINGS.gpl.js:156
msgid "Website"
msgstr "Sitio web"

#. An unknown value. Tells the calculator what to solve for.
#: dist/js/interface.SAVINGS.gpl.js:865
msgid "Unknown"
msgstr "Incógnita"

#. The first letter of the word (lowercase) which means "Unknown" in the non-English language of the 'msgstr'
#: dist/js/interface.SAVINGS.gpl.js:867
msgid "u"
msgstr "i"

#. The first letter of the word (capitalized) which means "Unknown" in the non-English language of the 'msgstr'
#: dist/js/interface.SAVINGS.gpl.js:869
msgid "U"
msgstr "I"

#. An exception error message which user could potentially see.
#: dist/js/interface.SAVINGS.gpl.js:870
msgid "Dates must be the first of the month."
msgstr "Las fechas deben ser el primer día del mes."

#. An exception error message which user could potentially see.
#: dist/js/interface.SAVINGS.gpl.js:871
msgid "An invalid JavaScript date object."
msgstr "Un objeto de fecha de JavaScript no válido."

#. The cash flow or compounding frequency.
#: dist/js/interface.SAVINGS.gpl.js:872
msgid "Monthly"
msgstr "Mensual"

#. Name of an online calculator. Used in an H1 element or report title. Translate the name as a native speaker would enter it into an online search engine.
#: en/calculator.gui.php:24
#: en/calculator.gui.php:26
msgid "Savings Calculator"
msgstr "Calculadora de ahorros"

#: en/calculator.gui.php:42
#: en/calculator.gui.php:154
#: en/calculator.gui.php:266
#: en/calculator.gui.php:378
msgid "Savings Calculator Plugin for WordPress"
msgstr "Calculadora de Ahorros Plugin para WordPress"

#: en/calculator.gui.php:43
#: en/calculator.gui.php:155
#: en/calculator.gui.php:267
#: en/calculator.gui.php:379
msgid "This savings calculator calculates the future value of regular savings."
msgstr "Esta calculadora de ahorros calcula el valor futuro de los ahorros regulares."

#. Text for a hyperlink.
#: en/calculator.gui.php:69
#: en/calculator.gui.php:182
#: en/calculator.gui.php:294
#: en/calculator.gui.php:406
msgid "click for more features"
msgstr "haga clic para más funciones"

#. A prompt asking for amount 'saved' in a bank or investment account. (Not 'saved' as the result of a discount on a price.)
#: en/calculator.gui.php:75
msgid "Saved Monthly?"
msgstr "¿Ahorro mensual?"

#. Number of months for the cash flow. This is a user prompt.
#: en/calculator.gui.php:78
#: en/calculator.gui.php:189
msgid "Months? (#)"
msgstr "¿Meses? (#)"

