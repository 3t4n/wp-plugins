#: admin/menu_form.php:11
msgid "Add to Menu"
msgstr "Aan menu toevoegen"

#: admin/options_form.php:9
msgid "Integration code"
msgstr "Integratiecode"

#: admin/options_form.php:18
msgid "Show order module icon"
msgstr "Icoon op website tonen"

#: admin/options_form.php:24
msgid "Yes"
msgstr "Ja"

#: admin/options_form.php:30
msgid "No"
msgstr "Nee"

#: admin/options_form.php:33
msgid ""
"The order module can be opened on every page of your website by click on the "
"icon."
msgstr ""
"De bestelmodule is op alle pagina’s van je website te openen via het "
"icoontje."

#: admin/options_form.php:42
msgid "Save settings"
msgstr "Instellingen opslaan"

#: admin/settings.php:53
msgid "The settings are saved"
msgstr "De instellingen zijn opgeslagen"

#: admin/settings.php:57
msgid "The integration code is invalid"
msgstr "De opgegeven integratiecode is ongeldig"

#: admin/settings.php:71
msgid "Gifty order module"
msgstr "Gifty bestelmodule"

#: admin/settings.php:96
msgid "Gift card"
msgstr "Cadeaubon"

#: gifty.php:50
msgid "Gifty integration settings"
msgstr "Gifty bestelmodule instellingen"

#. Plugin Name of the plugin/theme
msgid "Gifty"
msgstr "Gifty"

#. Plugin URI of the plugin/theme
#. Author URI of the plugin/theme
msgid "https://gifty.nl"
msgstr "https://gifty.nl"

#. Description of the plugin/theme
msgid ""
"Are you affiliated with Gifty? Then make yourself comfortable and use the "
"Gifty plugin. Place the order module at the touch of a button and sell "
"giftcards on your website without difficulty."
msgstr ""
"Ben jij aangesloten bij Gifty? Maak het jezelf dan gemakkelijk en gebruik de "
"Gifty-plugin. Plaats de bestelmodule met 1 druk op de knop en verkoop "
"cadeaubonnen op je website zonder moeite."

#. Author of the plugin/theme
msgid "Gifty B.V."
msgstr "Gifty B.V."
