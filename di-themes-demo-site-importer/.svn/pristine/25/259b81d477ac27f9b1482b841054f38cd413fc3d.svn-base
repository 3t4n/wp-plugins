		<content:encoded><![CDATA[<h2>Get Connect With Us</h2>		
				<a href="#">
				</a>
				<h4>
					<a href="#">Call Us</a>
				</h4>
				<p><b>Toll Free:-</b> 222-000-1111
<br/>
<b>Fax:- &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </b>222-000-1111</p>
				<a href="#">
				</a>
				<h4>
					<a href="#">Mail Us</a>
				</h4>
				<p><b>contact@zyx.com</b><br/>contact@zyx.com</p>
				<h4>
					Address
				</h4>
				<p>No: 58 A, East Madison Street,
Baltimore, MD, USA 4508</p>
										<img width="310" height="310" src="http://demo.dithemes.com/di-business/wp-content/uploads/2019/11/Untitled-4-310x310.jpg" alt="" srcset="http://demo.dithemes.com/di-business/wp-content/uploads/2019/11/Untitled-4-310x310.jpg 310w, http://demo.dithemes.com/di-business/wp-content/uploads/2019/11/Untitled-4-310x310-150x150.jpg 150w, http://demo.dithemes.com/di-business/wp-content/uploads/2019/11/Untitled-4-310x310-300x300.jpg 300w, http://demo.dithemes.com/di-business/wp-content/uploads/2019/11/Untitled-4-310x310-90x90.jpg 90w, http://demo.dithemes.com/di-business/wp-content/uploads/2019/11/Untitled-4-310x310-100x100.jpg 100w" sizes="(max-width: 310px) 100vw, 310px" />											
			<h2>Enter your query</h2>		
		[contact-form-7 id="5" title="Contact form 1"]		
			<iframe frameborder="0" scrolling="no" marginheight="0" marginwidth="0" src="https://maps.google.com/maps?q=London%20Eye%2C%20London%2C%20United%20Kingdom&amp;t=m&amp;z=10&amp;output=embed&amp;iwloc=near" aria-label="London Eye, London, United Kingdom"></iframe>]]></content:encoded>
