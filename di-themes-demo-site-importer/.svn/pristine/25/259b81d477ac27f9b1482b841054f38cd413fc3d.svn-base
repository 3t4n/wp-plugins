		<guid isPermaLink="false">http://demo.dithemes.com/di-business/?page_id=719</guid>
		<description></description>
		<content:encoded><![CDATA[			<h2>Under construction</h2>		
		<p>We have a few quirks to fix, but we will have everything up and running in no time. Please come back in a few hours.</p>		
				<h3>
					Contact Us
				</h3>
				<p>For any question please send us a message to hello@email.com</p>
				<h3>
					Support Forum
				</h3>
				<p>You are invited to visit our support forum and knowledge base</p>
				<h3>
					Customer Service
				</h3>
				<p>To talk to a representative, please call 1900-123-123</p>
		]]></content:encoded>
