}
.genieimageicon-plus:before {
  content: "\e92a";
}
.genieimageicon-search:before {
  content: "\e92b";
  color: #1f420f;
}
.genieimageicon-blocked:before {
  content: "\ea0e";
}
.genieimage-icon-help:before {
  font-size: 20px !important;
}
.genieimage-icon-meter::before {
  color: #fff;
}
.genieimage-icon-alert-circle::before {
  cursor: pointer;
}
.genieimage-icon-insert::before {
  color: #fff;
}
.genieimage .genieimagecompetitor-link .genieimageicon-earth::before {
  margin-right: 5px;
}
