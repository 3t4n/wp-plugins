/* assets/src/admin/styles/icon-pack.scss */
[class^=genieimageicon-],
[class*=" genieimageicon-"] {
  font-family: "genieimage" !important;
  speak: never;
  font-style: normal;
  font-weight: normal;
  font-variant: normal;
  text-transform: none;
  line-height: 1;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
.genieimageicon-dislike:before {
  content: "\e900";
  color: #57595f;
}
.genieimageicon-edit1:before {
  content: "\e901";
  color: #57595f;
}
.genieimageicon-like:before {
  content: "\e902";
  color: #57595f;
}
.genieimageicon-reload:before {
  content: "\e903";
}
.genieimageicon-refresh:before {
  content: "\e904";
  color: #57595f;
}
.genieimageicon-send:before {
  content: "\e905";
}
.genieimageicon-earth:before {
  content: "\e906";
}
.genieimageicon-insert:before {
  content: "\e907";
  color: #57595f;
}
.genieimageicon-link:before {
  content: "\e908";
  color: #57595f;
}
.genieimageicon-copy:before {
  content: "\e909";
  color: #57595f;
}
.genieimageicon-close .path1:before {
  content: "\e918";
  color: rgb(255, 26, 26);
  opacity: 0.06;
}
.genieimageicon-close .path2:before {
  content: "\e919";
  margin-left: -1em;
  color: rgb(255, 26, 26);
}
.genieimageicon-close .path3:before {
  content: "\e91a";
  margin-left: -1em;
  color: rgb(255, 26, 26);
}
.genieimageicon-edit-2:before {
  content: "\e91b";
}
.genieimageicon-edit-3:before {
  content: "\e91c";
}
.genieimageicon-more-vertical:before {
  content: "\e91e";
}
.genieimageicon-trash:before {
  content: "\e91f";
}
.genieimageicon-alert:before {
  content: "\e920";
}
.genieimageicon-alert-circle:before {
  content: "\e921";
}
.genieimageicon-arrow-left:before {
  content: "\e923";
}
.genieimageicon-arrow-right:before {
  content: "\e924";
}
.genieimageicon-arrow-up-left:before {
  content: "\e925";
}
.genieimageicon-arrow-up-right:before {
  content: "\e926";
}
.genieimageicon-arrow:before {
  content: "\e90a";
}
.genieimageicon-arrow_down:before {
  content: "\e90b";
}
.genieimageicon-arrow_right:before {
  content: "\e90c";
}
.genieimageicon-arrow_up1:before {
  content: "\e90d";
}
.genieimageicon-check:before {
  content: "\e90e";
}
.genieimageicon-close1:before {
  content: "\e90f";
}
.genieimageicon-competition_icon:before {
  content: "\e910";
  color: #422c63;
}
.genieimageicon-cpc_icon:before {
  content: "\e911";
  color: #7d7656;
}
.genieimageicon-edit:before {
  content: "\e913";
}
.genieimageicon-help:before {
  content: "\e914";
  color: #595a62;
}
.genieimageicon-chat:before {
  content: "\e91d";
  color: #b4b5bd;
}
.genieimageicon-copy_02:before {
  content: "\e922";
  color: #b4b5bd;
}
.genieimageicon-meter:before {
  content: "\e928";
  color: #2f2f96;
}
.genieimageicon-minus:before {
