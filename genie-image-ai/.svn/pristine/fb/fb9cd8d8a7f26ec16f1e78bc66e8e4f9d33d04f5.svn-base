/* assets/src/admin/styles/global.scss */
#adminmenu .toplevel_page_genieimage.wp-has-submenu a.menu-top .wp-menu-image {
  display: flex;
  justify-content: center;
  align-items: center;
}
#adminmenu .toplevel_page_genieimage.wp-has-submenu.menu-top .wp-menu-image img {
  padding: 0 !important;
  width: 16px;
}
.woocommerce-embed-page .woocommerce-layout__header .woocommerce-layout__header-heading {
  min-width: 115px;
}
.genieimagenotice-wrapper.notice {
  margin-bottom: 15px;
}
.genieimagenotice .notice-icon {
  width: 20px;
  margin-right: 8px;
}
.genieimagenotice .notice {
  margin-bottom: 15px;
}
.genieimagenotice .notice-link {
  display: flex;
  padding: 8px 0;
}
.genieimagenotice .notice-message {
  font-size: 15px;
  font-weight: 400;
  display: flex;
  align-items: center;
}
.genieimagenotice .notice-link a {
  border-radius: 2px;
  border-color: #4570f4;
  font-size: 14px;
  background: #4868ca;
  color: #fff;
  margin-right: 15px;
  padding: 5px 10px;
  text-decoration: none;
}
body.toplevel_page_genieimage {
  background-color: #f0f2f5;
}
body.make-cursor-wait {
  cursor: wait;
}
body.make-cursor-wait .components-toolbar.genieimage button {
  pointer-events: none;
}
body.genie-sidebar-open {
  overflow: hidden;
}
body.genie-sidebar-open .supports-drag-drop .media-modal {
  z-index: 999;
}
body.genie-sidebar-open .supports-drag-drop .media-modal-backdrop {
  z-index: 998 !important;
}
body.genie-sidebar-open #adminmenuwrap {
  z-index: 997;
}
.genieimage .genieimagesidebar-content .add-outline-btn {
  height: 36px;
  border-radius: 4px;
  font-size: 13px;
  font-weight: 500;
  border-color: #4570f4;
  text-transform: uppercase;
  box-shadow: 0px 1px 2px rgba(3, 18, 51, 0.1);
  height: auto;
  width: auto;
  padding: 2px 8px;
  font-size: 12px;
  text-transform: capitalize;
  margin-left: auto;
  display: block;
  background-color: transparent;
  color: #4570f4;
}
.genieimage .genieimagesidebar-content .add-outline-btn:hover,
.genieimage .genieimagesidebar-content .add-outline-btn:focus {
  color: #fff;
  border-color: #4570f4;
  background-color: #4570f4;
}
.genieimage .genieimagesidebar-content .add-outline-btn[disabled] {
  color: #c4c4c4;
  border-color: #c4c4c4;
}
.genieimage .genieimagesidebar-content .ant-form-item-control-input-content button[disabled] {
  pointer-events: none;
}
.genieimage .genieimagesidebar-footer .nextBtn {
  background: #4868ca;
  color: #fff;
}
.genieimage .genieimagesidebar-footer .nextBtn:hover {
  color: #fff;
}
.genieimage .genieimagesidebar-footer .nextBtn[disabled] {
  background-color: #979797;
}
.genieimage .genieimagesidebar-footer button {
  height: 36px;
  border-radius: 4px;
  font-size: 13px;
  font-weight: 500;
  border-color: #4570f4;
  text-transform: uppercase;
  box-shadow: 0px 1px 2px rgba(3, 18, 51, 0.1);
  font-size: 14px;
  letter-spacing: 1.25px;
}
.genieimage .genieimagesidebar-footer button:hover,
.genieimage .genieimagesidebar-footer button:focus {
  color: #fff;
  border-color: #4570f4;
  background-color: #4570f4;
}
.genieimage .genieimagesidebar-footer button[disabled] {
  color: #c4c4c4;
  border-color: #c4c4c4;
}
.genieimage .genieimagesidebar-footer .btnGrp {
  display: flex;
  justify-content: end;
  gap: 10px;
}
.genieimage .genieimagesidebar-footer .insertBtn {
  background-color: #fff;
  border-color: hsla(0deg, 0%, 0%, 0.12);
  color: #4570f4;
  border: none;
  height: auto;
  border-radius: 0;
  padding: 0;
}
.genieimage .genieimagesidebar-footer .insertBtn:not(.ant-tooltip-disabled-compatible-wrapper) {
  border-bottom: 1px solid;
}
.genieimage .genieimagesidebar-footer .insertBtn button[disabled] {
  border-color: transparent;
  background: transparent;
  border-bottom: 1px solid;
  padding: 0;
  height: auto;
}
.genieimage .genieimagesidebar-footer .insertBtn:hover {
  color: #4570f4;
  background-color: #fff;
}
.genieimage .genieimagesidebar-footer .prevBtn {
  background-color: #fff;
  border-color: hsla(0deg, 0%, 0%, 0.12);
  color: #4570f4;
  width: 42px;
  padding: 0;
}
.genieimage .genieimagesidebar-footer .outline-btnGrp {
  display: flex;
  align-items: center;
}
.genieimage .genieimage-outline-btn {
  height: 36px;
  border-radius: 4px;
  font-size: 13px;
  font-weight: 500;
  text-transform: uppercase;
  background-color: #4570f4;
  color: #ffffff;
  margin: 30px 0;
  margin-bottom: 5px;
  border: 1px solid #4570f4;
}
.genieimage .genieimage-outline-btn:hover {
  background-color: transparent;
  color: #4570f4;
  border: 1px solid #4570f4;
}
#genieimageeditor-custom-toolbar button {
  position: relative;
  display: inline-block;
  white-space: nowrap;
  text-align: center;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.645, 0.045, 0.355, 1);
  touch-action: manipulation;
  padding: 4px 15px;
  font-size: 14px;
  border: none;
  height: 36px;
  border-radius: 4px;
  font-size: 13px;
  font-weight: 500;
  border-color: #4570f4;
  text-transform: uppercase;
  box-shadow: 0px 1px 2px rgba(3, 18, 51, 0.1);
  height: 33px;
  margin-left: 1rem;
  margin-top: 2px;
  background: #2271b1;
  color: #fff;
  text-decoration: none;
  text-shadow: none;
}
#genieimageeditor-custom-toolbar button:nth-child(1) {
  margin-left: 20px;
}
#genieimageeditor-custom-toolbar button:last-child {
  margin-right: 35px;
}
#genieimageeditor-custom-toolbar button:hover,
#genieimageeditor-custom-toolbar button:focus {
  color: #fff;
  border-color: #4570f4;
  background-color: #4570f4;
}
#genieimageeditor-custom-toolbar button[disabled] {
  color: #c4c4c4;
  border-color: #c4c4c4;
}
#genieimageeditor-custom-toolbar button:hover {
  color: #fff;
  background: #135e96;
  border-color: #135e96;
}
#genieimageeditor-custom-toolbar.classic .genieimagetoolbar-write-btn:first-child {
  margin-left: 0;
}
.genieimagetoolbar-write-btn span:first-child {
  margin-right: 12px;
}
#genieimageeditor-custom-toolbar {
  flex: 100%;
  display: flex;
}
.genieimagetoolbar-shortcut {
  margin-left: 40px;
}
.genieimage-image-preview {
  z-index: 999999;
}
.genieimage-image-preview-mask,
.genieimage-image-preview .ant-image-preview-mask,
.genieimage-image-preview .ant-image-preview-wrap {
  z-index: 999999;
}
