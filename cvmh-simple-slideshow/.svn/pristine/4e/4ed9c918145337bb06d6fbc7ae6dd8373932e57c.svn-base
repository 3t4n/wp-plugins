.cvmh-slideshow-dot,.cvmh-slideshow-nav button{display:inline-block;padding:0;text-indent:-9999px}.cvmh-slideshow{width:100%;max-width:1920px;z-index:1;position:relative}.cvmh-slideshow-mask{position:absolute;z-index:3}.cvmh-slideshow ul{margin:0;list-style-image:none;list-style-type:none;z-index:1}.cvmh-slideshow li.slide{opacity:0;position:absolute;top:0;left:0;width:100%;z-index:1;height:100%;background-position:top center;background-repeat:no-repeat}.cvmh-slideshow li.active{opacity:1;z-index:2}.cvmh-slideshow-dot:hover,.cvmh-slideshow-nav button:hover{opacity:.7}.cvmh-animated-slide{-webkit-transition:opacity 2.5s ease;-moz-transition:opacity 2.5s ease;transition:opacity 2.5s ease}.slide-img{max-width:100%;height:auto}.slide-content{position:absolute;bottom:0;width:100%;background:rgba(0,0,0,.7);padding:20px 0 60px;color:#fff;text-align:center}.slide-link{display:block;width:100%;height:100%}.cvmh-slideshow-nav{position:absolute;z-index:4;width:100%;top:50%}.cvmh-slideshow-nav button{vertical-align:top;z-index:4;width:32px;height:32px;margin:0 12px;background:url(../img/sprite.png)no-repeat}.cvmh-slideshow-nav button.cvmh-slideshow-prev{float:left;background-position:-22px 0}.cvmh-slideshow-nav button.cvmh-slideshow-next{float:right;background-position:-54px 0}.cvmh-slideshow-dots{position:absolute;bottom:30px;z-index:4;font-size:0;width:100%;text-align:center}.cvmh-slideshow-dot{width:8px;height:8px;margin:0 3px;background:#fff;-webkit-border-radius:8px;border-radius:8px}.cvmh-slideshow-dot.active{background:#228bff}