.wp-block-eliza-chatbot-eliza-chatbot{background-color:#1c1c1c;border:4px solid #61afef;border-radius:10px;box-shadow:0 0 10px rgba(0,0,0,.5);color:#fff;font-family:Courier New,Courier,monospace;font-size:14px;line-height:normal;overflow:hidden;padding:20px;position:relative}.chat-window{border:1px solid #61afef;border-radius:5px;font-size:16px;height:200px;margin-bottom:20px;margin-top:20px;overflow-y:scroll;padding:20px;scrollbar-color:#61afef #1c1c1c;scrollbar-width:thin}.chat-window div{margin-bottom:10px}.chat-window p{font-family:monospace;font-size:10px;white-space:pre}.chat-window::-webkit-scrollbar{width:12px}.chat-window::-webkit-scrollbar-track{background:#1c1c1c}.chat-window::-webkit-scrollbar-thumb{background-color:#61afef;border:3px solid #1c1c1c;border-radius:10px}.user-input-group{align-items:center;display:flex;margin-bottom:10px}.user-input{caret-color:#61afef;cursor:auto;flex:1;margin-right:10px;text-transform:uppercase}.send-btn,.user-input{background-color:#1c1c1c;border:1px solid #61afef;border-radius:3px;color:#fff;font-family:Courier New,Courier,monospace;padding:10px}.send-btn{cursor:pointer;transition:background-color .3s,color .3s}.send-btn:hover{background-color:#61afef;color:#1c1c1c}.button-group{display:flex;justify-content:space-between;margin-bottom:10px}.button-group button{background-color:#1c1c1c;border:1px solid #61afef;border-radius:3px;color:#fff;cursor:pointer;flex:1;font-family:Courier New,Courier,monospace;margin:5px;padding:10px;transition:background-color .3s,color .3s}.button-group button:hover{background-color:#61afef;color:#1c1c1c}.wp-block-eliza-chatbot-eliza-chatbot fieldset{border:2px solid #abb2bf;border-radius:5px;margin-bottom:20px;padding:0 10px 10px}.wp-block-eliza-chatbot-eliza-chatbot legend{color:#abb2bf;font-size:14px;margin-bottom:10px}.wp-block-eliza-chatbot-eliza-chatbot hr{border:1px solid #abb2bf;margin:10px 0}.wp-block-eliza-chatbot-eliza-chatbot input[type=radio]{display:none}.wp-block-eliza-chatbot-eliza-chatbot label.radio-button{background-color:#1c1c1c;border:1px solid #61afef;border-radius:3px;color:#fff;cursor:pointer;display:inline-block;margin:5px 10px 5px 0;padding:10px;transition:background-color .3s,color .3s}.wp-block-eliza-chatbot-eliza-chatbot input[type=radio]:checked+label.radio-button{background-color:#61afef;color:#1c1c1c}.wp-block-eliza-chatbot-eliza-chatbot .info-box{background-color:#1c1c1c;border:2px solid #abb2bf;border-radius:5px;margin-bottom:20px;padding:10px}.wp-block-eliza-chatbot-eliza-chatbot .info-box a{border:none;color:#61afef}.wp-block-eliza-chatbot-eliza-chatbot .info-box a:hover{background-color:none;border:none;text-decoration:underline}
