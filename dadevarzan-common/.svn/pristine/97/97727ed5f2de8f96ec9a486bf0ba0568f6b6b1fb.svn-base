@font-face {
    font-family: IRANSansOnlyNumeral;
	font-display: swap;
    font-style: normal;
    font-weight: bold;
    src: url('../OnlyNumeral/woff/IRANSansOnlyNumeral_Bold.woff') format('woff'),  /* FF3.6+, IE9, Chrome6+, Saf5.1+*/
         url('../OnlyNumeral/ttf/IRANSansOnlyNumeral_Bold.ttf') format('truetype');
}
