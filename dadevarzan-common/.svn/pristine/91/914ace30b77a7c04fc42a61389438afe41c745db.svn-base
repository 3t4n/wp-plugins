@font-face {
	font-family: AnjomanMax;
	font-display: swap;
	font-style: normal;
	font-weight: 100;
	src: url('../fonts/woff/AnjomanMax-Thin.woff') format('woff'),   
	url('../fonts/woff2/AnjomanMax-Thin.woff2') format('woff2');		
}

