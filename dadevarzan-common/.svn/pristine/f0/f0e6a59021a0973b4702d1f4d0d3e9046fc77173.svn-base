@font-face {
	font-family: Morabba;
	font-display: swap;
	font-style: normal;
	font-weight: 200;
	src: url('../fonts/woff/Morabba-UltraLight.woff') format('woff'),   
	url('../fonts/woff2/Morabba-UltraLight.woff2') format('woff2'),
	url('../fonts/ttf/Morabba-UltraLight.ttf') format('truetype');	
}

