@font-face {
	font-family: Aviny;
	font-display: swap;
	font-style: normal;
	font-weight: normal;
	src: url('../fonts/aviny.woff2') format('woff2'),  /* FF39+,Chrome36+, Opera24+*/
		 url('../fonts/aviny.woff') format('woff'),  /* FF3.6+, IE9, Chrome6+, Saf5.1+*/
		 url('../fonts/aviny.ttf') format('truetype');
}

