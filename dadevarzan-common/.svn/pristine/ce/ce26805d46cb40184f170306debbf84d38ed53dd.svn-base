@font-face {
	font-family: Pelak;
	font-display: swap;
	font-style: normal;
	font-weight: 200;
	src: url('../fonts/eot/Pelak-Thin.eot?#iefix') format('embedded-opentype'),
	url('../fonts/woff/Pelak-Thin.woff') format('woff'),   
	url('../fonts/woff2/Pelak-Thin.woff2') format('woff2');
}

