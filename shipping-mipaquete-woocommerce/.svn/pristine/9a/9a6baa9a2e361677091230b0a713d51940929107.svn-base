.mpq {
    text-align: left;
    font-size: 20px;
    margin-bottom: 10px;
    width: 75%;
}
#contenedor {
    display: block;
    width: 100vh;
    text-align: left;
    padding: 0 10% 2%;
}
#contenidos {
    display: table-row-group;
}

#columna1, #columna2, #columna3 {
    display: table-cell;
    vertical-align: middle;
    padding: 10px;
}

.test_message {
    max-width: 640px;
    width: 90%;
    font-size: 14px;
    font-weight: 400; 
    color: #222329;
}

.test_message  a {
    color: default;
    text-align: center;
}

.wrapper_radio_buttons {
    display: flex;
}

.wrapper_radio_buttons label {
    margin-left: 10px;
    margin-right: 10px;
    margin-bottom: 4px;
}

input[type="radio"] {
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    margin: 0;
    border-radius: 50%;
    border: 1px solid black;
    background-color: #fff;
}

input[type="radio"]::before {
    transform: scale(1.5);
    outline: 1px solid #FD7E14;
    box-shadow: inset 1em 1em #FD7E14;
}

input[type="radio"]:focus {
    outline: 1px solid #FD7E14;
    outline-offset: 0px;
    border-color: #FD7E14;
    box-shadow: 0 0 0 1px #FD7E14; 
}

input[type=radio]:checked {
    background-color: #FD7E14;
    border-color: #FD7E14;
}

input[type=radio]:checked::before {
    content: "✓";
    background-color: transparent;
    color: white;
    font-size: 8px;
}


input, select {
    height: 40px;
    width: 240px;
  }
small {
    margin: 0 -230px;
    position: absolute;
}
.wp-core-ui .button-primary {
    height: 35px;
    min-height: 35px;
    border-radius: 20px;
    padding: 0 16px;
    color:  #FF9C19;
    border: 1px solid #FF9C19;
    background: #FFFFFF;
}

.wp-core-ui .button-primary:active {
    color: #F08700;
    transform: scale(0.9);
}

.wp-core-ui .button-primary:hover {
   background-color: #F0870040;
    border: 1px solid #FF9C19;
}

.wp-core-ui .button-secondary {
    background: #FFFFFF 0 0 no-repeat padding-box;
    border: 1px solid #009AF0;
    border-radius: 20px;
    padding: 0 16px;
    opacity: 1;
    color: #009AF0;
    height: 35px;
}

.mp_text_env_dev {
    font-size: 14px;
    font-weight: 400;
}

.wp-core-ui .button-secondary:active {
    color: #F08700;
    transform: scale(0.9);
}

.wp-core-ui .button-secondary:hover {
   background-color: #009AF030;
}

@media (max-width: 1366px) {
    .position {
        margin: auto 210px;
        position:absolute;
    }
  }
  @media (min-width: 1367px ) and (max-width: 1920px ) {
    .position {
        margin: auto 410px;
        position:absolute;
    }
  }