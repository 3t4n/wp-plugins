.settings-form-wrapper h3{color:#f15552;font-weight:700;margin:0;padding:20px 0;text-transform:uppercase}.settings-form-wrapper{background:#fff;border-bottom:1px dashed #efefef;padding-bottom:40px;padding-top:30px}.cp-title{font-weight:700;margin-top:7px;padding:12px 0}.cp-fieldset .input{background:#f9f9f9;border:0;height:41px;margin-top:7px;padding:12px 15px;width:50%}.cp-tabs{position:relative}.cp-tabs:after{background:linear-gradient(270deg,#f8f7ee,#f8f7ee00);clear:both;content:"";display:table;height:60px;opacity:1;pointer-events:none;position:absolute;right:0;top:0;transition:opacity .3s 0s,visibility 0s 0s;visibility:visible;width:50px;z-index:1}.no-cpsgradients .cp-tabs:after{display:none}.cp-tabs li,.cp-tabs ul{margin:0}.cp-tabs.is-ended:after{opacity:0;transition:opacity .3s 0s,visibility 0s .3s;visibility:hidden}.cp-tabs nav{overflow:auto;-webkit-overflow-scrolling:touch;background:#f8f7ee;box-shadow:inset 0 -2px 3px #cbc4820f}@media only screen and (min-width:768px){.cp-tabs:after{display:none}.cp-tabs nav{box-shadow:inset -2px 0 3px #cbc4820f;height:100%;left:0;position:absolute;top:0;z-index:1}}@media only screen and (min-width:960px){.cp-tabs nav{background:#0000;box-shadow:none;float:none;position:relative}}.cp-tabs-navigation{width:360px}.cp-tabs-navigation:after{clear:both;content:"";display:table}.cp-tabs-navigation li{float:left}.cp-tabs-navigation a{display:block;font-size:12px;font-size:.75rem;height:60px;position:relative;text-align:center;width:100px;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;color:#c3c2b9;font-weight:700;padding-top:34px;text-decoration:none}.no-touch .cp-tabs-navigation a:hover{background-color:#e9e6ca4d;color:#29324e}.cp-tabs-navigation a.selected{background-color:#fff!important;box-shadow:inset 0 2px 0 #f05451;color:#29324e}@media only screen and (min-width:768px){.cp-tabs-navigation{float:left;width:80px}.cp-tabs-navigation a{height:80px;padding-top:46px;text-decoration:none;width:80px}.cp-tabs-navigation a.selected{box-shadow:inset 2px 0 0 #f05451}}@media only screen and (min-width:960px){.cp-tabs-navigation{background-color:#f8f7ee;box-shadow:inset 0 -2px 3px #cbc4820f;width:auto}.cp-tabs-navigation a{font-size:14px;font-size:.875rem;height:60px;line-height:60px;padding:0 4.6em;text-align:center;text-decoration:none;width:auto}.cp-tabs-navigation a.selected{box-shadow:inset 0 2px 0 #f05451}}.cp-tabs-content{background:#fff}.cp-tabs-content li{display:none;padding:0 1.4em}.cp-tabs-content li.selected{animation:cp-fade-in .5s;display:block}.cp-tabs-content li p{color:#8493bf;font-size:14px;font-size:.875rem;line-height:1.6;margin-bottom:2em}@media only screen and (min-width:768px){.cp-tabs-content{min-height:300px}.cp-tabs-content li{padding:0 2em 0 7em}}@media only screen and (min-width:960px){.cp-tabs-content{min-height:0}.cp-tabs-content li{padding:0 3em}.cp-tabs-content li p{font-size:16px;font-size:1rem}}@keyframes cp-fade-in{0%{opacity:0}to{opacity:1}}.go-pro-widget{display:inline-block;padding:20px;vertical-align:text-top}.guarantee-block a.go-pro-widget-title{background:#1ea9ea;border:1px solid #1ea9ea;border-radius:4px;color:#fff;display:inline-block;font-size:17px;font-weight:700;margin:0;padding:10px 30px;text-decoration:none;vertical-align:middle}.guarantee-block{padding-bottom:30px;text-align:center;width:100%}.guarantee-block .guarantee{display:inline-block;margin:auto;vertical-align:middle;width:300px}.go-pro-widget form{padding:10px 20px}.go-pro-widget .pro-feature-box,.go-pro-widget form{background:#f4f7f8;border-radius:8px;margin:10px auto;max-width:300px}.go-pro-widget input[type=email],.go-pro-widget input[type=text]{background:#ffffff1a;background-color:#e8eeef;border:none;box-shadow:inset 0 1px 0 #00000008;color:#8a97a0;font-size:16px;height:auto;margin:0 0 30px;outline:0;padding:15px;width:100%}.go-pro-widget button{background-color:#4bc970;border:solid #3ac162;border-radius:5px;border-width:1px 1px 3px;box-shadow:inset 0 -1px 0 #ffffff1a;color:#fff;font-size:18px;font-style:normal;margin-bottom:10px;padding:19px 39px 18px;text-align:center;width:100%}.pro-feature-box{text-align:left}.guarantee-block .pro-feature-box .pro-feature-list{display:block;font-weight:700;padding:1em 1.4em}.guarantee-block .pro-feature-box .pro-feature-list:nth-of-type(odd){background-color:#173d500f}.go-pro-widget fieldset{border:none}.go-pro-widget legend{color:#3ac162;font-size:1.4em;font-weight:700;padding:20px;text-align:center}.go-pro-widget label{display:block;margin-bottom:8px}.go-pro-widget label.light{display:inline;font-weight:300}.go-pro-headline{display:block;text-align:center}.go-pro-widget .dashicons-arrow-right{vertical-align:middle}.number{background-color:#5fcf80;border-radius:100%;color:#fff;display:inline-block;font-size:.8em;height:20px;line-height:20px;margin-right:10px;text-align:center;text-shadow:0 1px 0 #fff3;width:20px}@media screen and (min-width:480px){.go-pro-widget .pro-feature-box,.go-pro-widget form{max-width:300px}}
