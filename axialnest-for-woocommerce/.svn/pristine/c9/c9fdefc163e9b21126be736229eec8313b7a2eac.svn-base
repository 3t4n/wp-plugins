/**
 * External dependencies
 */
import { addFilter } from '@wordpress/hooks';
import { __ } from '@wordpress/i18n';
import * as Woo from '@woocommerce/components';
import { Fragment } from '@wordpress/element';

/**
 * Internal dependencies
 */
import './index.scss';

const AxialWelcomePage = () => (
	<Fragment>
		<Woo.Section component="article">
			<Woo.SectionHeader
				title={ __( 'Welcome to AxialNest', 'axialnest-for-woocommerce' ) }
			/>
			<p>{__("Congrats! You've succesfully installed the AxialNest extension for Woocommerce.", 'axialnest-for-woocommerce' ) }</p>

			<Woo.SectionHeader
				title={ __( 'Setting everything up', 'axialnest-for-woocommerce' ) }
			/>
			<p>{__('To get started, you can visit the ', 'axialnest-for-woocommerce' ) }
			<a href="./admin.php?page=wc-settings&tab=integration&section=axialnest_for_woocommerce_settings">{__('🔧AxialNest settings page', 'axialnest-for-woocommerce')}</a>
			{__(' and configure some of your preferences for the extension.', 'axialnest-for-woocommerce' ) }</p>

			<p>{__('Remember to also visit the ', 'axialnest-for-woocommerce' ) }
			<a href="https:/panel.axialnest.com">{__('📜AxialNest admin panel', 'axialnest-for-woocommerce')}</a>
			{__(' to start creating your 3D products.', 'axialnest-for-woocommerce' ) }</p>

			<Woo.SectionHeader
				title={ __( 'Linking a 3D product to a woocommerce product', 'axialnest-for-woocommerce' ) }
			/>
			<img src="data:image/jpeg;base64,"></img>
			<p>{__('When editing a product, under the "Product Data" section, please fill the "AxialNest ID" field with the product ID you can retrieve from the ', 'axialnest-for-woocommerce' ) }
			<b>{__('admin panel.', 'axialnest-for-woocommerce')}</b><br></br>
			{__('After saving, the product page will automatically show the option to open the 3D customzier with your loaded product.', 'axialnest-for-woocommerce' ) }</p>

		</Woo.Section>
	</Fragment>
);

addFilter(
	'woocommerce_admin_pages_list',
	'axialnest-for-woocommerce',
	( pages ) => {
		pages.push( {
			container: AxialWelcomePage,
			path: '/axialnest-for-woocommerce',
			breadcrumbs: [
				__( 'Axialnest Woocommerce', 'axialnest-for-woocommerce' ),
			],
			navArgs: {
				id: 'axialnest-for-woocommerce',
			},
		} );

		return pages;
	}
);
