.addEditForm{
	width:66%;
}
.previewInformer{
	position:fixed;
	right:5px;
	top:5%;
	overflow: scroll;
}
.informerPreviewBorder{
	border:1px solid red;
	background-color:#fff;
	display:inline-block;
}
.informerPreviewBox{
	width:400px;
	margin:5px;
}
.addEditWrapper{
	position:relative;
	width:98%;
}
.colorbox{
	float:left;
	margin:5px;
	width:150px;
	min-height:70px;
}
.colorbox input{
	cursor:pointer;
	width:100%;
}
.clearboth{
	clear:both;
	
}
.checkBoxBox{
	float:left;
	margin:5px;
}
.previewInformer .postbox h3{
	font-size:14px;
	line-height:1.4;
	margin:0;
	padding:8px 12px;
}
.previewControl{
	position:relative;
}