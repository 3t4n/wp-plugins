msgstr "Отображение валюты кодом"

#: ../includes/Main.php:245
msgid "Please select language"
msgstr "Пожалуйста, выберите язык"

#: ../includes/Main.php:246
msgid "Please enter title"
msgstr "Пожалуйста, введите заголовок"

#: ../includes/Main.php:247
msgid "Select destination currency"
msgstr "Выберите валюту назначения"

#: ../includes/Main.php:248
msgid "Disable real time update"
msgstr "Отключить обновление в режиме реального времени"

#: ../includes/Main.php:255
msgid "Widget preview"
msgstr "Предпросмотр"

#: ../includes/Main.php:269
