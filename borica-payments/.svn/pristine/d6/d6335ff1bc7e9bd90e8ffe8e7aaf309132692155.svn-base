.borica_container {
	display: flex !important;
	flex-direction: column !important;
	-webkit-box-sizing: border-box !important;
	-moz-box-sizing: border-box !important;
	box-sizing: border-box !important;
	padding: 0px !important;
	margin: 20px 20px 0px 0px !important;
	gap: 10px !important;
	background-color: transparent !important;
}
.borica_container,
.borica_container * {
	font-size: 15px !important;
	font-weight: 400 !important;
}
.borica_page_header {
	position: -webkit-sticky !important; /* Safari */
	position: sticky !important;
	top: 30px !important;
	z-index: 1000 !important;
	background-color: #f0f0f1 !important;
	display: flex !important;
	align-items: center !important;
	justify-content: space-between !important;
	-webkit-box-sizing: border-box !important;
	-moz-box-sizing: border-box !important;
	box-sizing: border-box !important;
	height: 52px !important;
	border: 1px solid #d4d4d4 !important;
	-webkit-box-shadow: 0px 2px 34px 0px rgba(39, 52, 125, 0.1) !important;
	box-shadow: 0px 2px 34px 0px rgba(39, 52, 125, 0.1) !important;
	padding: 12px 15px !important;
	font-size: 22px !important;
	font-weight: 600 !important;
	user-select: none !important;
	-moz-user-select: none !important;
	-khtml-user-select: none !important;
	-webkit-user-select: none !important;
	-o-user-select: none !important;
}
.borica_row {
	display: flex !important;
	-webkit-box-sizing: border-box !important;
	-moz-box-sizing: border-box !important;
	box-sizing: border-box !important;
	gap: 15px !important;
	background-color: transparent !important;
}
.borica_panel {
	display: flex !important;
	flex-direction: column !important;
	-webkit-box-sizing: border-box !important;
	-moz-box-sizing: border-box !important;
	box-sizing: border-box !important;
	flex: 1 !important;
	padding: 0px !important;
	gap: 0px !important;
	background-color: transparent !important;
}
.borica_panel .inline {
	padding: 15px !important;
}
.borica_panel .inlinelast {
	padding: 0px 15px 15px 15px !important;
}
.borica_panel_heading {
	display: flex !important;
	-webkit-box-sizing: border-box !important;
	-moz-box-sizing: border-box !important;
	box-sizing: border-box !important;
	color: #4c4d5a !important;
	border: 1px solid #dcdcdc !important;
	background: #f5f5f5 !important;
	padding: 12px 15px !important;
	border-top-right-radius: 2px !important;
	border-top-left-radius: 2px !important;
	font-size: 18px !important;
	user-select: none !important;
	-moz-user-select: none !important;
	-khtml-user-select: none !important;
	-webkit-user-select: none !important;
	-o-user-select: none !important;
	cursor: pointer !important;
}
.borica_panel_body {
	display: flex;
	-webkit-box-sizing: border-box !important;
	-moz-box-sizing: border-box !important;
	box-sizing: border-box !important;
	flex-direction: column !important;
	background: #fff !important;
	border: 1px solid #dcdcdc !important;
	border-top: 1px solid transparent !important;
}
.borica_form_group {
	display: flex !important;
	-webkit-box-sizing: border-box !important;
	-moz-box-sizing: border-box !important;
	box-sizing: border-box !important;
	align-items: center !important;
	padding: 15px !important;
	gap: 30px !important;
	border: 1px solid #e5e5e5 !important;
	border-top: 1px solid transparent !important;
	border-right: 1px solid transparent !important;
	border-left: 1px solid transparent !important;
}
.borica_form_group:last-child {
	border: 1px solid transparent !important;
}
.borica_control_label {
	display: flex !important;
	-webkit-box-sizing: border-box !important;
	-moz-box-sizing: border-box !important;
	box-sizing: border-box !important;
	align-items: center !important;
	justify-content: end !important;
	flex: 1 !important;
}
.borica_control {
	display: flex !important;
	flex-direction: column !important;
	-webkit-box-sizing: border-box !important;
	-moz-box-sizing: border-box !important;
	box-sizing: border-box !important;
	align-items: start !important;
	flex: 2 !important;
}
.borica_form_control {
	min-width: 100% !important;
	border: 1px solid #d1d5db;
	-webkit-box-shadow: 0px 2px 34px 0px rgba(39, 52, 125, 0.1) !important;
	box-shadow: 0px 2px 34px 0px rgba(39, 52, 125, 0.1) !important;
}
.borica_form_control.error {
	border: 1px solid #dc2626;
}
.borica_form_controll_text {
	font-size: 12px !important;
}
.borica_h4 {
	font-size: 22px !important;
}
.borica_text_info {
	color: #3170ac !important;
}
.borica_help {
	padding: 0px 15px 15px 15px !important;
}
.borica_error {
	color: #dc2626;
	font-size: 0.9em;
	margin-top: 2px;
}
