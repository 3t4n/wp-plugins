#. Author of the plugin
msgid "ARGH! Team"
msgstr "ARGH! Team"

#. id
#: includes/class-esim-ninja-settings.php:76
msgid "Common Settings"
msgstr "Общие настройки"

#: includes/class-esim-ninja-shortcode.php:25
msgid "Compare all eSIM travel mobile data plans on eSIM.Ninja."
msgstr ""
"Сравните все тарифы на мобильный интернет для путешествий на eSIM.Ninja."

#: includes/class-esim-ninja-settings.php:24
msgid "eSIM.Ninja"
msgstr "eSIM.Ninja"

#. Name of the plugin
msgid "eSIM.Ninja Affiliates Widget"
msgstr "eSIM.Ninja Affiliates Widget"

#: includes/class-esim-ninja-settings.php:46
msgid "eSIM.Ninja is a leading travel mobile data plans comparison platform."
msgstr ""
"eSIM.Ninja — популярная платформа для поиска и сравнения тарифов на "
"мобильный интернет для путешествий."

#. Description of the plugin
msgid ""
"eSIM.Ninja places an eSIM travel mobile data plans price comparison widget "
"on your pages and posts to monetize your GEO related travel content."
msgstr ""
"eSIM.Ninja places an eSIM travel mobile data plans price comparison widget "
"on your pages and posts to monetize your GEO related travel content."

#: includes/class-esim-ninja-settings.php:23
#: includes/class-esim-ninja-settings.php:44
msgid "eSIM.Ninja Settings"
msgstr "Настройки eSIM.Ninja"

#. Author URI of the plugin
msgid "https://argh.team/"
msgstr "https://argh.team/"

#. URI of the plugin
msgid "https://wordpress.org/plugins/esim-ninja-affiliates-widget/"
msgstr "https://wordpress.org/plugins/esim-ninja-affiliates-widget/"

#: includes/class-esim-ninja-settings.php:58
msgid "Instructions"
msgstr "Инструкции"

#: includes/class-esim-ninja-settings.php:51
msgid "Once you’re approved, add your Partner ID below."
msgstr "После поучения ID партнёра, укажите его в настройках ниже."

#. id
#: includes/class-esim-ninja-settings.php:82
msgid "Partner ID"
msgstr "ID партнёра"

#: includes/class-esim-ninja-settings.php:120
#, php-format
msgid ""
"Paste this shortcode %s into a post or page and the mobile data plan "
"comparison widget will be displayed right where you’ve added it."
msgstr ""
"Вставьте шорткод %s в запись или на страницу в то место, где вы хотите "
"отобразить виджет сравнения тарифов на мобильный интернет."

#: includes/class-esim-ninja-settings.php:50
msgid "sign up for an eSIM.Ninja affiliate account"
msgstr "зарегистрироваться в партнёрской программе eSIM.Ninja Affiliate"

#: includes/class-esim-ninja-settings.php:47
msgid ""
"This plugin allows you to quickly configure and add a widget to your posts "
"and pages."
msgstr ""
"Этот плагин поможет вам быстро разместить виджет сравнения цен на страницах "
"своего блога."

#: includes/class-esim-ninja-settings.php:48
#| msgid "To use this plugin you’ll need to"
msgid "To use this plugin you'll need to"
msgstr ""
"Чтобы переходы по ссылкам виджета начали приносить вам деньги, вам нужно"
