.form-block__element input:not([type=reset]):not([type=submit]),.form-block__element textarea{border:1px solid #949494;font-family:inherit;font-size:1em}.form-block__element input:not([type=checkbox]):not([type=radio]):not([type=reset]):not([type=submit]),.form-block__element textarea{box-sizing:border-box;display:block;padding:calc(.667em + 2px);width:100%}.form-block__element input[type=reset],.form-block__element input[type=submit]{align-self:flex-start}.form-block__element select{-moz-appearance:none;-webkit-appearance:none;appearance:none;background:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='10' fill='currentColor'><polygon points='0,0 10,0 5,5'/></svg>") no-repeat right calc(.667em + 2px) top 56%;border:1px solid #949494;border-radius:0;font-size:1em;line-height:1.6;padding:calc(.667em + 2px) calc(1.333em + 12px) calc(.667em + 2px) calc(.667em + 2px)}.form-block__element.is-type-checkbox input,.form-block__element.is-type-radio input{margin-top:.35em}.form-block__element.is-type-checkbox .form-block__label,.form-block__element.is-type-radio .form-block__label{margin-left:.3em}.wp-block-form-block-fieldset{border:1px solid #949494}
