.form-block__date-custom .form-block__date-custom--separator{-webkit-margin-after:8px;font-size:13px;margin-block-end:8px;padding-block:6px}.form-block__date-custom .form-block__date-custom--separator.is-before:first-child{display:none}.form-block__date-custom .is-type-year{flex-grow:2}
:root{--wp-admin-theme-color:#007cba;--wp-admin-theme-color--rgb:0,124,186;--wp-admin-theme-color-darker-10:#006ba1;--wp-admin-theme-color-darker-10--rgb:0,107,161;--wp-admin-theme-color-darker-20:#005a87;--wp-admin-theme-color-darker-20--rgb:0,90,135;--wp-admin-border-width-focus:2px;--wp-block-synced-color:#7a00df;--wp-block-synced-color--rgb:122,0,223}@media(-webkit-min-device-pixel-ratio:2),(min-resolution:192dpi){:root{--wp-admin-border-width-focus:1.5px}}[data-type="form-block/input"].is-type-checkbox .components-base-control__field,[data-type="form-block/input"].is-type-radio .components-base-control__field{margin-bottom:0}.editor-styles-wrapper [data-type="form-block/input"]{margin-bottom:16px!important;margin-top:16px!important}.form-block__block-control .components-base-control__label,.form-block__block-control .components-input-control__label.components-input-control__label.components-input-control__label,.form-block__block-control .components-toggle-control__label{align-items:center;display:flex;justify-content:space-between}.form-block__block-control .components-toggle-control__label{flex:1 0}.form-block__block-control.components-select-control>.components-flex-item{max-width:100%}.form-block__block-control .components-button.is-tertiary{height:24px;min-width:24px;padding:0}.form-block__block-control .components-button.is-tertiary svg{margin-right:0}.form-block__block-control .components-button.is-tertiary:hover:not(:disabled){box-shadow:none}.form-block__help-modal{max-width:500px}.form-block__inline-code{background-color:#2271b1;border-radius:2px;color:#fff;font-size:12px;padding:1px 4px}.wp-block-form-block-input.wp-block-button .components-base-control__field{margin-bottom:0}.wp-block-form-block-input.wp-block-button .components-text-control__input{background-color:transparent;border:0;color:inherit;font-size:16px;margin:0;padding:0}
