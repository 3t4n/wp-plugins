/**
* Utilities like Bootstrap 4
*/

.pb-1 {
	padding-bottom: 1rem;
}

.pt-1 {
	padding-top: 1rem;
}

.mr-1 {
	margin-right: 1rem;
}
.ml-1 {
	margin-left: 1rem !important;
}
