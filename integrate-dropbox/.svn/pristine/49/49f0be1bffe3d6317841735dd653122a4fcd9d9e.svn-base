x(x1,{})}];fu.propTypes={setMenu:F.func,menu:F.string};function Dl({feature:e,className:t=""}){return s.jsxs("div",{className:`indbox-feature-card box-border-bg d-flex align-center space-between flex-wrap ${t}`,children:[s.jsxs("div",{className:"feature-meta",children:[s.jsx("h2",{className:"feature-title",children:e.title}),s.jsx("p",{className:"feature-description",children:e.description})]}),s.jsx("div",{className:"feature-media indbox-video-frame",children:e.isImage?s.jsx("img",{src:e.link?e.link:"/wp-content/plugins/integrate-dropbox-pro/src/assets/images/indb-placeholder-image.webp",alt:e.title}):s.jsx("iframe",{width:"560",height:"315",src:e.link,title:"YouTube video player",frameBorder:"0",allow:"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share",referrerPolicy:"strict-origin-when-cross-origin",allowfullscreen:!0})})]})}Dl.propTypes={feature:F.object.isRequired,className:F.string};function Ve({sectionDetails:e,sectionButton:t}){return s.jsxs("div",{className:"indbox-getting-section-title text-center",children:[(e==null?void 0:e.tagLine)&&s.jsx("h6",{className:"title-top-tagline",children:e==null?void 0:e.tagLine}),s.jsx("h1",{className:"header-title",dangerouslySetInnerHTML:{__html:e==null?void 0:e.title}}),(e==null?void 0:e.description)&&s.jsx("p",{className:"title-description",children:e==null?void 0:e.description}),t&&s.jsx("div",{className:"section-button flex-center",children:t})]})}Ve.propTypes={sectionDetails:F.object.isRequired,sectionButton:F.node};const m1=()=>({title:"Quick Overview",description:"The Integrate Dropbox Plugin connects WordPress to Dropbox, streamlining file management and saving hosting space by storing and serving media from Dropbox. Features include automatic folder syncing, a shortcode builder with 8 modules, WooCommerce integration for product images and downloads, and support for embedding videos in LMS platforms like Tutor LMS and MasterStudy LMS.",isImage:!1,link:"https://www.youtube.com/embed/i9U1E12ntSc?si=saCvG3_HWWqKaTr8"}),b1=()=>{const e={tagLine:"Powerful Dropbox",title:"Powerful Dropbox Integration <span>Features<span>",description:""},t=[{title:"Dropbox Sync with Media Library",description:"Easily sync your Dropbox files with the Media Library for streamlined media management. Access, upload, and organize your Dropbox content directly from your Media Library, saving time and storage space. Perfect for seamless file sharing and collaboration.",isImage:!0,link:`${indbox.assetPath}/images/feature-images/media-library.svg`},{title:"File Uploader",description:"Simplify uploading files to Dropbox folders with our File Uploader tool. Whether it's documents, photos, or videos, easily transfer your files to designated locations, ensuring smooth data management without any technical hassle.",isImage:!0,link:`${indbox.assetPath}/images/feature-images/file-uploader-image.svg`},{title:"Slider Carousel",description:"Easily engage with your media content using our Slider Carousel feature. Showcase your images and videos in a visually appealing slideshow format, allowing for simple navigation and exploration of your Dropbox media library.",isImage:!0,link:`${indbox.assetPath}/images/feature-images/slider-carousel.svg`},{title:"Shortcode Builder",description:"Easily sync your Dropbox files with the Media Library for streamlined media management. Access, upload, and organize your Dropbox content directly from your Media Library, saving time and storage space. Perfect for seamless file sharing and collaboration. ",isImage:!0,link:`${indbox.assetPath}/images/feature-images/shortcode-builder.svg`},{title:"File Browser",description:"Explore Dropbox’s wide range of files and folders effortlessly using our user-friendly File Browser feature. With just a few clicks, locate and access specific documents, images, and media files, saving valuable time and enhancing your productivity.",isImage:!0,link:`${indbox.assetPath}/images/feature-images/file-browser.svg`},{title:"Gallery",description:"View your Dropbox content easily with our Gallery view. See images and videos in a grid layout with previews, making it simple to browse and select files, enhancing your content discovery and enjoyment.",isImage:!0,link:`${indbox.assetPath}/images/feature-images/gallery.svg`},{title:"Media Player",description:"Experience top-notch multimedia with our advanced Media Player. Dive into high-quality audio and video playback straight from your Dropbox account. Enjoy seamless browsing and immersive viewing and listening.",isImage:!0,link:`${indbox.assetPath}/images/feature-images/media-player.svg`}];return{allFeatureSectionTitle:e,featureList:t}},v1=()=>[{isSpacial:!1,title:"Compatible with Popular <span>Page Builders</span>",description:"Integrate Dropbox works with popular page builders like Elementor, Gutenberg, and WPBakery. Easily manage your Dropbox files right inside your WordPress builder, making file uploads and media handling simple. Whether using drag-and-drop or creating custom layouts, Integrate Dropbox saves you time and keeps everything running smoothly.",image:`${indbox.assetPath}/images/feature-images/CompatibleBuilder.svg`},{isSpacial:!0,title:"Compatible with <span>WooCommerce</span>",description:"Integrate Dropbox works seamlessly with WooCommerce, letting you easily sync and manage product images, digital downloads, and media files. Stay organized and save time while keeping everything accessible for your store and customers.",image:`${indbox.assetPath}/images/feature-images/CompatibleWoo.svg`}],w1=()=>{const e={title:"Other Features",description:"Explore the other features of the plugin"},t=[{icon:`${indbox.assetPath}/images/icons/Modules.svg`,title:"Embed Documents",description:"Easily embed Dropbox documents and display PDFs, Word files, and spreadsheets directly on your webpage for a smooth, interactive experience.",color:"#0061FE"},{icon:`${indbox.assetPath}/images/icons/search-files-folders.svg`,title:"Search files & folders",description:"Quickly find any file or folder in Dropbox right from your WordPress dashboard. Stay organized and access your content effortlessly.",color:"#FF9E00"},{icon:`${indbox.assetPath}/images/icons/easy-setup.svg`,title:"Easy Setup",description:"Install and connect Dropbox to WordPress in just a few steps. No technical expertise required—start syncing files in minutes!",color:"#8400FF"},{icon:`${indbox.assetPath}/images/icons/ViewLinks.svg`,title:"View Links",description:"Easily access and manage shared Dropbox links directly from your WordPress dashboard. Keep everything organized and within reach!",color:"#00AEFF"},{icon:`${indbox.assetPath}/images/icons/DownloadLinks.svg`,title:"Download Links",description:"Quickly generate and access download links for your Dropbox files right from your WordPress site. Share files with ease!",color:"#FF02E1"},{icon:`${indbox.assetPath}/images/icons/AutoSave.svg`,title:"Auto Save",description:"Automatically save changes made to your Dropbox files directly from WordPress. Keep your work updated without extra steps!",color:"#FF0249"},{icon:`${indbox.assetPath}/images/icons/DataExportImport.svg `,title:"Data Export Import",description:"Effortlessly export and import data between WordPress and Dropbox using the Integrate Dropbox plugin. Manage file transfers, and syncs with just a few clicks.",color:"#FF7700"},{icon:`${indbox.assetPath}/images/icons/Preloader.svg`,title:"Preloader",description:"Display a preloader in the WordPress dashboard while Dropbox files and folders load, ensuring a smooth user experience with real-time progress feedback.",color:"#003BFF"},{icon:`${indbox.assetPath}/images/icons/CustomColor.svg`,title:"Custom Color",description:"Modify the Integrate Dropbox dashboard color scheme with the custom color feature in the plugin, giving you full control over its appearance.",color:"#6004FF"}];return{modulesSectionTitle:e,singleModuleArray:t}},y1=()=>({basicUsageSectionTitle:{title:"Basic <span>Usage</span>",description:"Learn how to use the plugin - Shortcode Builder, File Browser, Gallery, Slider Carousel, and File Uploader."},articleContent:[{meta:`<iframe width="560" height="315" src="https://www.youtube.com/embed/TO2kK7G2ixA?si=uIZc5bANpG1feo4L" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe> <h2>Connect Dropbox to WordPress</h2> <p><strong>Authorize your Dropbox account safely - No 3rd party apps required or data stored on your server</strong></p> 

            <p><strong>Install the Plugin:</strong> Via WordPress Admin: Navigate to <em>Plugins > Add New</em>, search for "Integrate Dropbox," and install. Manual Upload: Upload the <code>integrate-dropbox</code> folder to the <code>/wp-content/plugins/</code> directory.</p>
            <p><strong>Activate the Plugin:</strong> Go to <em>Plugins > Installed Plugins</em> and activate <em>Integrate Dropbox</em>.</p>
            <p><strong>Set Up Dropbox App:</strong> Visit the <a href="https://www.dropbox.com/developers/apps" target="_blank">Dropbox Developers Console</a>. Click <strong>Create app</strong>. Choose <strong>Dropbox API</strong> (Step 1). Select <strong>Full Dropbox</strong> (Step 2). Enter a unique app name (e.g., <code>[site-prefix]-codeconfig</code>) (Step 3).</p>
            <p><strong>Configure the Plugin:</strong> Copy the <strong>App Key</strong> and <strong>App Secret</strong> from the Dropbox Developers Console. Paste them into the login screen of the plugin and submit. Copy the auto-generated redirect URL from the login screen. Add the redirect URL to <em>App > Settings > OAuth 2 > Redirect URLs</em> and click <strong>Add</strong>. Enable required permissions from the <strong>Permissions</strong> tab.</p>
            <p><strong>Authorize the Plugin:</strong> Click the <strong>Sign In</strong> button in the plugin to connect your Dropbox account.</p>
            <p><strong>You're All Set:</strong> The Integrate Dropbox Plugin is now installed and configured.</p>

            <p class="indbox-btn-container"><a class="indbox-btn" target="_blank" href="https://codeconfig.dev/docs/how-to-connect-my-dropbox-app-with-wordpress/">Documentation</a> <a class="indbox-btn" target="_blank" href="https://youtu.be/i9U1E12ntSc?si=eUyZaQq4y8F2aJgN">Video Tutorial</a>
            `,ArticleBorder:"#D9F3FF",ArticleBg:"#D9F3FF1A"},{meta:`<iframe width="560" height="315" src="https://www.youtube.com/embed/raeVyM4qkhs?si=Ckkw1nUFab2QeJXI" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe> <h2>Use Dropbox In WooCommerce</h2> <p><strong>Integrate your Dropbox account with WooCommerce to easily upload and manage your products and orders.</strong></p>

          <p>Integrating Dropbox with WooCommerce simplifies how you manage product assets and order files. With this integration, you can directly use Dropbox to store and retrieve product images, galleries, and downloadable products. This not only helps save valuable hosting space but also ensures faster file access and efficient file organization.</p>

          <p>By connecting your Dropbox account to WooCommerce, you can:</p>
          <ul>
            <li>Upload product images and galleries directly from Dropbox.</li>
            <li>Serve large downloadable files (e.g., software, eBooks, videos) via Dropbox, improving speed and reliability.</li>
            <li>Keep your media files organized and accessible from a centralized cloud location.</li>
            <li>Reduce server load by offloading large media files to Dropbox.</li>
          </ul>

          <a class="indbox-btn" target="_blank" href="https://codeconfig.dev/docs/use-dropbox-in-wordpress-woocommerce/">Documentation</a>
            `,ArticleBorder:"#D9FFDF",ArticleBg:"#D9FFDF1A"},{meta:`<h2>Generate shortcode</h2> <p><strong>Integrate Dropbox has an awesome and user-friendly dashboard to generate shortcodes. This shortcode will be everywhere in the WordPress class Editor, Block Editor, any theme builder. e.g Elementor, Fusion Builder, Beaver Builder, Visual Composer, etc.</strong></p> 
            <p>The shortcode will be something like this:</p>
            <p><code>[integrate_dropbox id="1"]</code></p>

            <a class="indbox-btn" target="_blank" href="https://codeconfig.dev/docs/create-shortcode-in-integrate-dropbox-plugin/">Shortcode Documentation</a>
            `,ArticleBorder:"#FFFBD9",ArticleBg:"#FFFBD91A"}]}),C1=()=>({dataPrivacySectionTitle:{title:"Data <span>Privacy</span>",description:"Information about the Data and Privacy"},articleContent:[{meta:`<h4>Overview</h4>
            <p>This document outlines the OAuth-based authorization flow for plugins, providing a secure and efficient method for users to grant access to their Dropbox resources without sharing their credentials.</p>

            <h4>Steps in the Authorization Flow</h4>
            <p>For technical reasons, the short-lived authorization code generated by the OAuth flow is sent by your internet browser to our server as part of the authentication (OAuth) flow to provide the Application access to the Dropbox API.</p>

            <p>The Application obtains the following information when you use the built-in app for authentication and link the Application with your Dropbox account:</p>

            <ul>
                <li>Your WordPress Website Address</li>
                <li>A Short-Lived Authorization Code Generated by the OAuth Flow</li>
            </ul>

            <p>This information is obtained and used after you decide to grant the Application the requested access via the Dropbox OAuth consent screen. After giving consent, you will be redirected to the server of <a href="https://codeconfig.dev/integrate-dropbox-oauth.php">CodeConfig</a>, which will redirect you back to your own site where the authorization process is finalized. This redirect via the server of codeconfig.dev is required for an easy plugin setup where you don’t need to create your own Dropbox App, which also allows you to set your own Authorized Redirect URI.</p>

            <h4>On Your Own Server</h4>
            <p>On your own server, the short-lived authorization code will be exchanged for the actual access token and refresh token, which are stored, encrypted, on your server. The authorization code can only be used once and will immediately become inactive after it has been exchanged for the access token or within minutes if it is not used.</p>

            <h4>Security Considerations</h4>
            <ul>
                <li><strong>Confidential Client Information:</strong> Keep the client secret secure and do not expose it in the frontend or to unauthorized individuals.</li>
                <li><strong>Token Storage:</strong> Store tokens securely, using encryption and secure storage mechanisms to prevent unauthorized access.</li>
                <li><strong>Token Expiry:</strong> Handle token expiry appropriately by using refresh tokens to obtain new access tokens without user intervention.</li>
                <li><strong>Scopes:</strong> Request only the scopes necessary for the plugin to function, adhering to the principle of least privilege.</li>
            </ul>

            <h4>Important Notes</h4>
            <p>When you use the Application, all other communications are strictly between your server and the cloud storage service servers. The communication is encrypted, and it will not go through our servers. We do not collect and do not have access to your files.</p>

            <h4>Data Privacy</h4>
            <p>We prioritize your data privacy above all else, ensuring your information remains secure and inaccessible to unauthorized parties at all times.</p>

            <h4>Conclusion</h4>
            <p>Following this OAuth authorization flow ensures a secure and efficient way for users to authorize plugins to access their Dropbox resources without compromising their credentials. Proper implementation and adherence to security best practices are essential to maintain the integrity and confidentiality of user data.</p>

            <p>For more details, please refer to the <a href="https://codeconfig.dev/privacy-policy">CodeConfig Privacy Policy</a>.</p>
              `}]}),k1=()=>({changelogSectionTitle:{title:"Exploring the <span>Latest Updates</span>",description:"New features, smoother navigation, enhanced security, faster loading times, refined visuals, optimized resource usage, improved accessibility, bug fixes"},changelogDetails:[{title:"25/02/2025",version:"v-1.2.9",details:[{title:"Fixes",class:"bug-fixed",logs:["Added compatibility with the Envira Gallery plugin."]},{title:"What's New",class:"new-feature",logs:["Introduced ZIP folder download functionality.","Added support for custom CSS."]}]},{title:"29/01/2025",version:"v-1.2.8",details:[{title:"Fixes",class:"bug-fixed",logs:["Resolved issue with displaying all files.","Resolved initial file loading issues.","Resolved scrollbar display issue in frontend."]}]},{title:"23/01/2025",version:"v-1.2.7",details:[{title:"What's New",class:"new-feature",logs:["Resolved module builder filter tab issues for Gutenberg and Elementor.","Fixed auto-sync issue in the Module Builder.","Enabled auto-sync for selection in the Shortcode Builder.","Resolved broken image issue."]},{title:"Fixes",class:"bug-fixed",logs:["Resolved gallery module filter page issues for both Gutenberg and Elementor."]},{title:"Updated Features",class:"enhancements",logs:["Enhanced UI elements for a more consistent and refined experience. "]}]},{title:"14/01/2025",version:"v-1.2.6",details:[{title:"What's New",class:"new-feature",logs:["Added the capability to customize the 'Download' button."]},{title:"Deprecation",class:"deprecated",logs:["Disabled the old format for the authorization URL."]},{title:"Updated Features",class:"enhancements",logs:["Improved and updated various plugin UI elements for better user experience."]}]},{title:"20/12/2024",version:"v-1.2.5",details:[{title:"What's New",class:"new-feature",logs:["Added support for WordPress Multi-site installations.","Enabled copying of Share Links and Direct Dropbox Links directly from the plugin interface.","Added user-specific permission functionality for the Shortcode module."]},{title:"Fixes",class:"bug-fixed",logs:["Resolved an issue where the `Add Dropbox Button` was not initially visible in WooCommerce product settings.","Addressed a bug causing incorrect display of selected files and folders from the backend on the frontend."]},{title:"Updated Features",class:"enhancements",logs:["Introduced an option to set default file and folder selections, streamlining workflow efficiency.","Improved overall plugin performance."]}]},{title:"14/12/2024",version:"v-1.2.4",details:[{title:"Updated Features",class:"enhancements",logs:["Improved the file uploader module for a better user experience.","update security issue.","Enhanced Slider Carousel, Media Player, Download Links, and View Links modules to support folder selection."]}]},{title:"02/12/2024",version:"v-1.2.3",details:[{title:"Updated Features",class:"enhancements",logs:["Reduced the default auto-fetch interval for new files in the shortcode gallery."]}]},{title:"30/11/2024",version:"v-1.2.2",details:[{title:"What's New",class:"new-feature",logs:["Auto Sync/Update: Automatically sync and update new gallery images to web pages.","Added support for video thumbnails in the Media Player module.","File Browser Enhancements: Remembers the last opened folder, Added download link options for files.","Advanced Settings Tabs: Introduced advanced settings for better customization.","Dropbox App Credentials: Added support for updating Dropbox app credentials directly from the plugin settings."]},{title:"Fixes",class:"bug-fixed",logs:["Media Library: Resolved loading issues affecting the Media Library.","Auto-Sync: Fixed issues with the auto-sync functionality."]},{title:"Updated Features",class:"enhancements",logs:["Media Library Enhancements: Added options to delete/trash or remove Dropbox attachments.","Video Format Support: Added support for MKV, MOV, and WebM video formats.","Cleanup: Enhanced cleanup functions when the plugin is uninstalled.","Performance: Improved overall plugin performance for better stability and speed."]}]},{title:"23/11/2024",version:"v-1.2.1",details:[{title:"Fixes",class:"bug-fixed",logs:["Resolved WooCommerce downloadable product issue.","Resolved User Access issue."]}]},{title:"21/11/2024",version:"v-1.2.0",details:[{title:"What's New",class:"new-feature",logs:["Private User Access for specific Dropbox folders.","Simplified and secured authorization process.","Import and upload files between WordPress Media Library and Dropbox."]},{title:"Fixes",class:"bug-fixed",logs:["Resolved zip file download issue.","Resolved video expiration issues."]},{title:"Updated Features",class:"enhancements",logs:["Refined download module and plugin UI for a cleaner look.","Enhanced overall plugin styling for a cleaner and more consistent look."]}]},{title:"17/10/2024",version:"v-1.1.10",details:[{title:"What's New",class:"new-feature",logs:["Added option to select a folder for the gallery with autoSync functionality."]},{title:"Fixes",class:"bug-fixed",logs:["Resolved autoSync issues with files and folders."]},{title:"Updated Features",class:"enhancements",logs:["Improved UI and enhanced performance optimization."]}]},{title:"16/10/2024",version:"v-1.1.9",details:[{title:"What's New",class:"new-feature",logs:["Added the ability to update the redirect URL for login authentication."]},{title:"Fixes",class:"bug-fixed",logs:["Addressed various styling issues for a more polished and consistent look.","Fixed Tutor LMS video selection issue, ensuring seamless video integration."]},{title:"Updated Features",class:"enhancements",logs:["Updated redirect URL for login authentication to enhance security and user experience.","Minor optimizations to improve overall plugin stability."]}]},{title:"16/10/2024",version:"v-1.1.8",details:[{title:"What's New",class:"new-feature",logs:["Added support for Tutor LMS integration.","Added the ability to upload files and folders using the Tutor LMS and MasterStudy LMS Files Selector module.","Dark Mode feature implemented"]},{title:"Fixes",class:"bug-fixed",logs:["Eliminated unnecessary API calls"]},{title:"Updated Features",class:"enhancements",logs:["Enhanced the source page file selector.","Revamped the Module Preview UI with updated download and view links"]}]},{title:"30/09/2024",version:"v-1.1.7",details:[{title:"What's New",class:"new-feature",logs:["Added compatibility for WooCommerce downloadable products","Integrated support for MasterStudy LMS","Added enable/disable option for auto-save on the settings page","Implemented file browser sorting feature for better organization"]},{title:"Fixed Issues",class:"bug-fixed",logs:["Resolved file preview issues on Apache servers"]},{title:"Updated Features",class:"enhancements",logs:["Enhanced code efficiency and optimized overall performance"]}]},{title:"21/09/2024",version:"v-1.1.6",details:[{title:"What's New",class:"new-feature",logs:["Auto Sync functionality added, with both custom and built-in time options.","Recent items feature added, allowing users to quickly access recently used folders and files.","Center mode feature added to the slider carousel module.","Grid and list view options added to the file browser module.","Implement Nested Folder"]},{title:"Fixed Issues",class:"bug-fixed",logs:["Resolved styling issues in the media player module."]},{title:"Updated Features",class:"enhancements",logs:["Optimized styling code and icons.","Improved overall code efficiency."]}]},{title:"09/09/2024",version:"v-1.1.5",details:[{title:"What's New",class:"new-feature",logs:["Added search Module on selected folders"]},{title:"Fixed Issues",class:"bug-fixed",logs:["Fix Files rerendering while synchronizing"]},{title:"Updated Features",class:"enhancements",logs:["Compatible with PHP 7.4.0 or higher","Update icons and styling"]}]},{title:"06/09/2024",version:"v-1.1.4",details:[{title:"What's New",class:"new-feature",logs:["Big Update * Added Upload Files & Folder Integration","Big Update * Create Folder & Upload files and Select folder","Big Update * Added Search functionality for files and folders","Rename feature in file browser","Added Download files feature in file browser"]},{title:"Fixes",class:"bug-fixed",logs:["Fix Elementor rendering issue"]},{title:"Updated Features",class:"enhancements",logs:["Optimize style & plugin Performance"]}]},{title:"26/08/2024",version:"v-1.1.3",details:[{title:"What's New",class:"new-feature",logs:["Big Update * Added Media Library Integration","Select Specific Folder from media integration"]},{title:"Fixes",class:"bug-fixed",logs:["Fix File loading issue"]},{title:"Updated Features",class:"enhancements",logs:["Optimize style issue on Elementor Editor"]}]},{title:"09/08/2024",version:"v-1.1.2",details:[{title:"What's New",class:"new-feature",logs:["Added Media Player Module"]},{title:"Fixes",class:"bug-fixed",logs:["Fix Elementor Editor Issue"]},{title:"Updated Features",class:"enhancements",logs:["Optimize style issue on Elementor Editor"]}]},{title:"06/08/2024",version:"v-1.1.1",details:[{title:"Fixes",class:"bug-fixed",logs:["Module builder preview rendering issue","Fix default view permission issue","Gutenberg shortcode modules preview issues"]},{title:"Updated Features",class:"enhancements",logs:["Optimize style issue on Elementor Editor"]}]},{title:"05/08/2024",version:"v-1.1.0",details:[{title:"What's New",class:"new-feature",logs:["Added Elementor widgets integration","Added Shortcode module in page builder"]},{title:"Updated Features",class:"enhancements",logs:["Give option to add User's Dropbox App","Optimize file loading time with lazy load","Update Modules Settings"]},{title:"Fixes",class:"bug-fixed",logs:["Fix Styling issues with Astra, Hello Elementor etc theme"]}]},{title:"06/07/2024",version:"v-1.0.5",details:[{title:"What's New",class:"new-feature",logs:["Added Slider Carousel in shortcode module"]},{title:"Updated Features",class:"enhancements",logs:["Optimized and cleaned code"]},{title:"Fixed Issues",cl