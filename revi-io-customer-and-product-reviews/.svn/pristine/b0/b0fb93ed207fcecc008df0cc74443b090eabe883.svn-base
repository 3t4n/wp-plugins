.revi__backofficePanel-container {
    padding: 15px;
    padding-right: 20px;
    font-weight: 500;

    .revi_backofficePanel-logo {
        width: 150px;
    }

    .alert {
        display: flex;
        gap: 8px;
        align-items: center;
        border-radius: 20px;
        border-width: 2px;
        font-weight: 500;
    }

    .revi__backofficePanel-card {
        height: 100%;
        padding: 15px;
        border-radius: 20px;
        background-color: #F3F0F3;
    }

    .btn {
        padding: 10px;
        border-radius: 10px;
        font-weight: 500;
        cursor: pointer;
    }

    .btn-secondary {
        background-color: #EE748F;
        border-color: #EE748F;
        color: #F3F0F3 !important;
    }

    .btn-secondary:hover {
        background-color: #c35f74;
        border-color: #c35f74;
    }

    .btn-primary {
        background-color: #1F2122;
        border-color: #1F2122;
        color: #F3F0F3 !important;
    }

    .btn-primary:hover {
        background-color: #0E0F0F;
        border-color: #0E0F0F;
    }

    .form-control {
        border-radius: 10px;
        border-width: 1px;
        max-width: 25rem;
    }

    .card {
        background: none;
        border: none;
        margin-top: 0;
    }

    .label-title {
        border-bottom: 1px solid #EE748F;
        margin-top: 15px;
    }

    label {
        font-weight: 600;
    }

    input[type=checkbox]:focus,
    input[type=color]:focus,
    input[type=date]:focus,
    input[type=datetime-local]:focus,
    input[type=datetime]:focus,
    input[type=email]:focus,
    input[type=month]:focus,
    input[type=number]:focus,
    input[type=password]:focus,
    input[type=radio]:focus,
    input[type=search]:focus,
    input[type=tel]:focus,
    input[type=text]:focus,
    input[type=time]:focus,
    input[type=url]:focus,
    input[type=week]:focus,
    select:focus,
    textarea:focus {
        border-color: #EE748F;
        box-shadow: 0 0 0 1px #EE748F;
    }

    select[multiple] {
        height: 180px;
    }

    button[type=submit] {
        font-weight: 500;
        width: 25rem !important;
    }

    .wp-core-ui select:hover {
        color: #EE748F !important;
    }

    .badge-free {
        background-color: #74788D;
    }

    .badge-lite {
        background-color: #50A5F1;
    }

    .badge-pro {
        background-color: #F1B44C;
    }

    .badge-premium {
        background-color: #009fbf;
    }

    .badge-unlimited {
        background-color: #F46A6A;
    }

    p {
        font-size: 15px;
    }

    @media screen and (max-width: 782px) {

        .btn,
        button[type=submit] {
            max-width: 100% !important;
        }
    }

    form {
        max-width: 100%;
    }

    code {
        padding: 0;
        background-color: #ee748f0d;
    }

    .widget-installation-code-container {
        margin: 0 0 15px;
        padding: 16px;
        font-size: 14px;
        position: relative;
        word-break: break-word;
        border: 1px solid rgba(238, 116, 143, .5);
        border-radius: 1.2rem;
        background-color: #ee748f0d;
    }

    .widget-installation-code-container code p {
        display: flex;
        justify-content: space-between;
    }

    .widget-installation-code-container code>div {
        margin-bottom: 15px;
        background-color: black;
        color: greenyellow;
        padding: 5px;
    }

    .widget-installation-code-container code button {
        cursor: pointer;
    }
}