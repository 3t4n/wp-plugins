430"],"Total Interest Due":["\u041e\u0431\u0449\u0430\u044f \u0441\u0443\u043c\u043c\u0430 \u043f\u0440\u043e\u0446\u0435\u043d\u0442\u043e\u0432"],"Total All Payments":["\u041e\u0431\u0449\u0430\u044f \u0441\u0443\u043c\u043c\u0430 \u0432\u0441\u0435\u0445 \u043f\u043b\u0430\u0442\u0435\u0436\u0435\u0439"],"Payment Schedule":["\u0413\u0440\u0430\u0444\u0438\u043a \u043f\u043b\u0430\u0442\u0435\u0436\u0435\u0439"],"Year":["\u0413\u043e\u0434"],"Date":["\u0414\u0430\u0442\u0430"],"Payment":["\u041f\u043b\u0430\u0442\u0435\u0436"],"Interest":["\u041f\u0440\u043e\u0446\u0435\u043d\u0442\u044b"],"Principal":["\u041e\u0441\u043d\u043e\u0432\u043d\u043e\u0439 \u0434\u043e\u043b\u0433"],"Balance":["\u041e\u0441\u0442\u0430\u0442\u043e\u043a"],"Calculation method: Normal":["\u041c\u0435\u0442\u043e\u0434 \u0440\u0430\u0441\u0447\u0435\u0442\u0430: \u041d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0439"],"Total Principal":["\u041e\u0431\u0449\u0430\u044f \u0441\u0443\u043c\u043c\u0430 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0433\u043e \u0434\u043e\u043b\u0433\u0430"],"Total Interest":["\u041e\u0431\u0449\u0430\u044f \u0441\u0443\u043c\u043c\u0430 \u043f\u0440\u043e\u0446\u0435\u043d\u0442\u043e\u0432"],"Pct. of Total Payments":["\u041f\u0440\u043e\u0446. \u043e\u0442 \u043e\u0431\u0449\u0435\u0439 \u0441\u0443\u043c\u043c\u044b \u043f\u043b\u0430\u0442\u0435\u0436\u0435\u0439"],"Annual Principal and Interest Totals":["\u0413\u043e\u0434\u043e\u0432\u0430\u044f \u0441\u0443\u043c\u043c\u0430 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0433\u043e \u0434\u043e\u043b\u0433\u0430 \u0438 \u043f\u0440\u043e\u0446\u0435\u043d\u0442\u043e\u0432"],"Accumulated Principal and Interest with Remaining Balance":["\u041d\u0430\u043a\u043e\u043f\u043b\u0435\u043d\u043d\u044b\u0439 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0439 \u0434\u043e\u043b\u0433 \u0438 \u043f\u0440\u043e\u0446\u0435\u043d\u0442\u044b \u0441 \u043e\u0441\u0442\u0430\u0442\u043a\u043e\u043c"],"Total Principal and Interest":["\u0418\u0442\u043e\u0433\u043e \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0439 \u0434\u043e\u043b\u0433 \u0438 \u043f\u0440\u043e\u0446\u0435\u043d\u0442\u044b"],"Loan":["\u041a\u0440\u0435\u0434\u0438\u0442"],"There are too many unknown values.":["\u0421\u043b\u0438\u0448\u043a\u043e\u043c \u043c\u043d\u043e\u0433\u043e \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0445 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0439."],"Enter \"Loan Amount\", \"Number of Payments\" and \"Annual Interest Rate\".":["\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \"\u0421\u0443\u043c\u043c\u0430 \u043a\u0440\u0435\u0434\u0438\u0442\u0430\", \"\u041a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043f\u043b\u0430\u0442\u0435\u0436\u0435\u0439\" \u0438 \"\u0413\u043e\u0434\u043e\u0432\u0430\u044f \u043f\u0440\u043e\u0446\u0435\u043d\u0442\u043d\u0430\u044f \u0441\u0442\u0430\u0432\u043a\u0430\"."],"<strong>Loan Calculator Help...<\/strong>":["<strong>\u041f\u043e\u043c\u043e\u0449\u044c \u043f\u043e \u041a\u0440\u0435\u0434\u0438\u0442\u043d\u043e\u043c\u0443 \u041a\u0430\u043b\u044c\u043a\u0443\u043b\u044f\u0442\u043e\u0440\u0443...<\/strong>"],"<p>Using the calculator is straightforward. User enters a &quot;loan amount&quot;, &quot;number of months&quot;, &quot;annual interest rate&quot;. The calculator calculates the monthly payment amount.<\/p>":["<p>\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u043a\u0430\u043b\u044c\u043a\u0443\u043b\u044f\u0442\u043e\u0440 \u043f\u0440\u043e\u0441\u0442\u043e. \u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c \u0432\u0432\u043e\u0434\u0438\u0442 \u00ab\u0441\u0443\u043c\u043c\u0443 \u043a\u0440\u0435\u0434\u0438\u0442\u0430\u00bb, \u00ab\u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043c\u0435\u0441\u044f\u0446\u0435\u0432\u00bb, \u00ab\u0433\u043e\u0434\u043e\u0432\u0443\u044e \u043f\u0440\u043e\u0446\u0435\u043d\u0442\u043d\u0443\u044e \u0441\u0442\u0430\u0432\u043a\u0443\u00bb. \u041a\u0430\u043b\u044c\u043a\u0443\u043b\u044f\u0442\u043e\u0440 \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u044b\u0432\u0430\u0435\u0442 \u0441\u0443\u043c\u043c\u0443 \u0435\u0436\u0435\u043c\u0435\u0441\u044f\u0447\u043d\u043e\u0433\u043e \u043f\u043b\u0430\u0442\u0435\u0436\u0430.<\/p>"],"<p>The &quot;Payment Method&quot; determines when the first payment is due. With the default selection, &quot;End-of-Period&quot;, the first payment will be due one month after the loan is made. If &quot;Start-of-Period&quot; is selected, then the first payment will be due on the loan date.<\/p>":["<p>\u00ab\u043c\u043e\u043c\u0435\u043d\u0442 \u043f\u043b\u0430\u0442\u0435\u0436\u0430\u00bb \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442, \u043a\u043e\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u0442 \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d \u043f\u0435\u0440\u0432\u044b\u0439 \u043f\u043b\u0430\u0442\u0435\u0436. \u041f\u0440\u0438 \u0432\u044b\u0431\u043e\u0440\u0435 \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e \u00ab\u041a\u043e\u043d\u0435\u0446 \u043f\u0435\u0440\u0438\u043e\u0434\u0430\u00bb \u043f\u0435\u0440\u0432\u044b\u0439 \u043f\u043b\u0430\u0442\u0435\u0436 \u0431\u0443\u0434\u0435\u0442 \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d \u0447\u0435\u0440\u0435\u0437 \u043c\u0435\u0441\u044f\u0446 \u043f\u043e\u0441\u043b\u0435 \u0432\u044b\u0434\u0430\u0447\u0438 \u043a\u0440\u0435\u0434\u0438\u0442\u0430. \u0415\u0441\u043b\u0438 \u0432\u044b\u0431\u0440\u0430\u043d \u00ab\u041d\u0430\u0447\u0430\u043b\u043e \u043f\u0435\u0440\u0438\u043e\u0434\u0430\u00bb, \u0442\u043e \u043f\u0435\u0440\u0432\u044b\u0439 \u043f\u043b\u0430\u0442\u0435\u0436 \u0431\u0443\u0434\u0435\u0442 \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d \u0432 \u0434\u0430\u0442\u0443 \u0432\u044b\u0434\u0430\u0447\u0438 \u043a\u0440\u0435\u0434\u0438\u0442\u0430.<\/p>"],"<p class=\"tail\">The term (duration) of the loan is expressed as a number of months.<\/p>":["<p class=\"tail\">\u0421\u0440\u043e\u043a \u043a\u0440\u0435\u0434\u0438\u0442\u0430 \u0432\u044b\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044f \u0432 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0435 \u043c\u0435\u0441\u044f\u0446\u0435\u0432.<\/p>"],"<ul class=\"mono tail\"><li>&nbsp;60 months = &nbsp;5 years<\/li><li>120 months = 10 years<\/li><li>180 months = 15 years<\/li><li>240 months = 20 years<\/li><li class=\"tail\">360 months = 30 years<\/li><\/ul>":["<ul class=\"mono tail\"><li>&nbsp;60 \u043c\u0435\u0441\u044f\u0446\u0435\u0432 = &nbsp;5 \u043b\u0435\u0442<\/li><li>120 \u043c\u0435\u0441\u044f\u0446\u0435\u0432 = 10 \u043b\u0435\u0442<\/li><li>180 \u043c\u0435\u0441\u044f\u0446\u0435\u0432 = 15 \u043b\u0435\u0442<\/li><li>240 \u043c\u0435\u0441\u044f\u0446\u0435\u0432 = 20 \u043b\u0435\u0442<\/li><li class=\"tail\">360 \u043c\u0435\u0441\u044f\u0446\u0435\u0432 = 30 \u043b\u0435\u0442<\/li><\/ul>"],"<p class=\"small\" style=\"font-size: 85%; line-height: 1.5; color:red; user-select: text\">Need more options including the ability to solve for other unknowns? Set the dates? Set or change the payment and compounding frequencies? Print the schedule? Export to MS Word&trade; (.docx) or MS Excel&trade; (.xlsx) files? Please visit, <b>https:\/\/accuratecalculators.com\/loan-calculator<\/b><\/p>":["<p class=\"small\" style=\"font-size: 85%; line-height: 1.5; color:red; user-select: text\">\u041d\u0443\u0436\u043d\u043e \u0431\u043e\u043b\u044c\u0448\u0435 \u043e\u043f\u0446\u0438\u0439, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0440\u0435\u0448\u0430\u0442\u044c \u0434\u0440\u0443\u0433\u0438\u0435 \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0435? \u0423\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u0434\u0430\u0442\u044b? \u0423\u0441\u0442\u0430\u043d\u043e\