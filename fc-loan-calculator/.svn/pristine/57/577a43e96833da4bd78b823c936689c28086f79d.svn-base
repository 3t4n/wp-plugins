#. Populate with the ISO language code aligning with the language for the msgstr.
#: dist/js/interface.LOAN.gpl.js:27
#: dist/js/interface.LOAN.gpl.js:858
msgid "en"
msgstr "it"

#. An instructional message about numeric input which may be shown to the calculator's user.
#: dist/js/interface.LOAN.gpl.js:28
#: dist/js/interface.LOAN.gpl.js:859
msgid "Please use the backspace key to delete."
msgstr "Si prega di usare il tasto backspace per cancellare."

#. An instructional message about numeric input which may be shown to the calculator's user.
#: dist/js/interface.LOAN.gpl.js:29
#: dist/js/interface.LOAN.gpl.js:860
msgid "Left, up & down arrow keys are disabled. So are the home, end, pgup and pgdn keys."
msgstr "I tasti freccia sinistra, su e giù sono disabilitati. Così come i tasti home, end, pgup e pgdn."

#. An instructional message about numeric input which may be shown to the calculator's user.
#: dist/js/interface.LOAN.gpl.js:30
#: dist/js/interface.LOAN.gpl.js:861
msgid "Use backspace to delete."
msgstr "Usa backspace per cancellare."

#. An instructional message which may appear to the user suggesting efficient way to edit data.
#: dist/js/interface.LOAN.gpl.js:31
#: dist/js/interface.LOAN.gpl.js:862
msgid "If value is selected, just start typing new value to clear prior value."
msgstr "Se il valore è selezionato, basta iniziare a digitare il nuovo valore per cancellare il valore precedente."

#. Instructional message that may be shown to user when entering numbers.
#: dist/js/interface.LOAN.gpl.js:32
#: dist/js/interface.LOAN.gpl.js:863
msgid "When a number is selected (value shown in inverse), use right arrow key to clear selection without clearing value. Then backspace to edit."
msgstr "Quando un numero è selezionato (valore mostrato al contrario), usa il tasto freccia destra per cancellare la selezione senza cancellare il valore. Poi, per modificare, usare il tasto backspace."

#. Instructional message that may be shown to user when entering numbers.
#: dist/js/interface.LOAN.gpl.js:33
#: dist/js/interface.LOAN.gpl.js:864
msgid "TIP: Generally it is best to use the TAB or SHIFT-TAB keys to move from one input to the next or previous input."
msgstr "CONSIGLIO: Generalmente è meglio usare i tasti TAB o SHIFT-TAB per spostarsi da un input a quello successivo o precedente."

#. Instructional message that may be shown to user when entering numbers.
#: dist/js/interface.LOAN.gpl.js:34
#: dist/js/interface.LOAN.gpl.js:865
msgid "TIP 2: Generally, editing a value is inefficient. Since values are auto selected, just type the number you want."
msgstr "CONSIGLIO 2: Generalmente, modificare un valore è inefficiente. Dato che i valori sono selezionati automaticamente, basta digitare il numero che si desidera."

#. Instructional message that may be shown to user when entering numbers.
#: dist/js/interface.LOAN.gpl.js:35
#: dist/js/interface.LOAN.gpl.js:866
msgid "Do not type the thousand separator character."
msgstr "Non digitate il carattere separatore delle migliaia."

#. Instructional message that may be shown to user when entering numbers.
#: dist/js/interface.LOAN.gpl.js:36
#: dist/js/interface.LOAN.gpl.js:867
msgid "(If using U.S. convention, that would be the comma.)"
msgstr "(Se si utilizza la convenzione statunitense, si tratterebbe della virgola.)"

#. A whimsical instructional message that may be shown to user when entering numbers.
#: dist/js/interface.LOAN.gpl.js:37
#: dist/js/interface.LOAN.gpl.js:868
msgid "I'm smart enough to enter them for you!"
msgstr "Sono abbastanza intelligente da inserirli per Lei!"

#. An exception error message which user could potentially see.
#: dist/js/interface.LOAN.gpl.js:38
#: dist/js/interface.LOAN.gpl.js:869
msgid "An unknown date calculation error occurred."
msgstr "Si è verificato un errore di calcolo della data sconosciuto."

#. Message asking user to provide details about an error condition.
#: dist/js/interface.LOAN.gpl.js:39
#: dist/js/interface.LOAN.gpl.js:870
msgid "Please provide us with your inputs and settings so that we can fix this. Thank you."
msgstr "La preghiamo di fornirci i Suoi input e le Sue impostazioni in modo che possiamo risolvere il problema. Grazie."

#. An exception error message which user could potentially see.
#: dist/js/interface.LOAN.gpl.js:40
#: dist/js/interface.LOAN.gpl.js:871
msgid "Date is not valid - bad year."
msgstr "La data non è valida - anno sbagliato."

#. Recognized abbreviation for January - abbreviation used due to limited space.
#: dist/js/interface.LOAN.gpl.js:41
#: dist/js/interface.LOAN.gpl.js:872
msgid "Jan"
msgstr "Gen"

#. Recognized abbreviation for February - abbreviation used due to limited space.
#: dist/js/interface.LOAN.gpl.js:42
#: dist/js/interface.LOAN.gpl.js:873
msgid "Feb"
msgstr "Feb"

#. Recognized abbreviation for March - abbreviation used due to limited space.
#: dist/js/interface.LOAN.gpl.js:43
#: dist/js/interface.LOAN.gpl.js:874
msgid "Mar"
msgstr "Mar"

#. Recognized abbreviation for April - abbreviation used due to limited space.
#: dist/js/interface.LOAN.gpl.js:44
#: dist/js/interface.LOAN.gpl.js:875
msgid "Apr"
msgstr "Apr"

#. The month of May.
#: dist/js/interface.LOAN.gpl.js:45
#: dist/js/interface.LOAN.gpl.js:876
msgid "May"
msgstr "Maggio"

#. Recognized abbreviation for June - abbreviation used due to limited space.
#: dist/js/interface.LOAN.gpl.js:46
#: dist/js/interface.LOAN.gpl.js:877
msgid "Jun"
msgstr "Giu"

#. Recognized abbreviation for July - abbreviation used due to limited space.
#: dist/js/interface.LOAN.gpl.js:47
#: dist/js/interface.LOAN.gpl.js:878
msgid "Jul"
msgstr "Lug"

#. Recognized abbreviation for August - abbreviation used due to limited space.
#: dist/js/interface.LOAN.gpl.js:48
#: dist/js/interface.LOAN.gpl.js:879
msgid "Aug"
msgstr "Ago"

#. Recognized abbreviation for September - abbreviation used due to limited space.
#: dist/js/interface.LOAN.gpl.js:49
#: dist/js/interface.LOAN.gpl.js:880
msgid "Sept"
msgstr "Set"

#. Recognized abbreviation for October - abbreviation used due to limited space.
#: dist/js/interface.LOAN.gpl.js:50
#: dist/js/interface.LOAN.gpl.js:881
msgid "Oct"
msgstr "Ott"

#. Recognized abbreviation for November- abbreviation used due to limited space.
#: dist/js/interface.LOAN.gpl.js:51
#: dist/js/interface.LOAN.gpl.js:882
msgid "Nov"
msgstr "Nov"

#. Recognized abbreviation for December- abbreviation used due to limited space.
#: dist/js/interface.LOAN.gpl.js:52
#: dist/js/interface.LOAN.gpl.js:883
msgid "Dec"
msgstr "Dic"

#. An exception error message which user could potentially see.
#: dist/js/interface.LOAN.gpl.js:53
msgid "Error: dates out of sequence."
msgstr "Errore: date fuori sequenza."

#. Title for exception error message which user could potentially see. Title in modal header.
#: dist/js/interface.LOAN.gpl.js:54
msgid "Exception"
msgstr "Eccezione"

#. A portion of an exception error message which user could potentially see.
#: dist/js/interface.LOAN.gpl.js:55
msgid "occurred when accessing"
msgstr "si è verificato durante l'accesso a"

#. A portion of an exception error message which user could potentially see.
#: dist/js/interface.LOAN.gpl.js:56
msgid "Invalid index"
msgstr "Indice non valido"

#. An unknown value. Tells the calculator what to solve for.
#: dist/js/interface.LOAN.gpl.js:58
#: dist/js/interface.LOAN.gpl.js:885
msgid "Unknown"
msgstr "Incognita"

#. The first letter of the word (lowercase) which means "Unknown" in the non-English language of the 'msgstr'
#: dist/js/interface.LOAN.gpl.js:60
#: dist/js/interface.LOAN.gpl.js:887
msgid "u"
msgstr "i"

#. The first letter of the word (capitalized) which means "Unknown" in the non-English language of the 'msgstr'
#: dist/js/interface.LOAN.gpl.js:62
#: dist/js/interface.LOAN.gpl.js:889
msgid "U"
msgstr "I"

#. An exception error message. The English word 'trillions' corresponds to 10 to the 12th power.
#: dist/js/interface.LOAN.gpl.js:64
msgid "Internal limit reached. Balance exceeds +/- 99 trillion."
msgstr "Limite interno raggiunto. Il saldo supera +/- 99 trilioni."

#. "YTD" stands for "Year-to-Date" totals. It is used as a row label in reports and must be translated as a commonly recognized abbreviation or kept within approximately 15 characters to fit formatting constraints.
#: dist/js/interface.LOAN.gpl.js:65
msgid "YTD"
msgstr "DAI"

#. "Running Totals" are accumulated totals calculated incrementally from the start of a sequence or period. This row label appears in reports with multiple cumulative totals in a single row. The term is plural because it refers to multiple totals.
#: dist/js/interface.LOAN.gpl.js:66
msgid "Running Totals"
msgstr "Totali progressivi"

#. A user's choice refering to a normal amortization method.
#: dist/js/interface.LOAN.gpl.js:67
msgid "Normal"
msgstr "Normale"

#. 'Schedule' as in a projected payment schedule with due dates. The title of a report appearing on the title page.
#: dist/js/interface.LOAN.gpl.js:69
#: dist/js/interface.LOAN.gpl.js:123
msgid "Your Personalized Loan Schedule"
msgstr "Il Suo piano di prestito personalizzato"

#. A portion of a rounding adjustment message which appears in the footer of financial reports.
#: dist/js/interface.LOAN.gpl.js:70
msgid "Last payment amount decreased by"
msgstr "L'importo dell'ultimo pagamento è diminuito di"

#. A portion of a rounding adjustment message which appears in the footer of financial reports.
#: dist/js/interface.LOAN.gpl.js:71
msgid "due to rounding"
msgstr "dovuto all'arrotondamento"

#. A portion of a rounding adjustment message which appears in the footer of financial reports.
#: dist/js/interface.LOAN.gpl.js:72
msgid "Last payment amount increased by"
msgstr "L'importo dell'ultimo pagamento è aumentato di"

#. A title centered over a section of a financial report.
#: dist/js/interface.LOAN.gpl.js:73
msgid "Loan Summary"
msgstr "Riassunto del prestito"

#. A calculator's user prompt for input or a report's label. The user will understand the concept from its context. The translation must be concise.
#: dist/js/interface.LOAN.gpl.js:76
msgid "Loan Amount"
msgstr "Importo del prestito"

#. A calculator's user prompt for input or a report's label. The user will understand the concept from its context. The translation must be concise.
#: dist/js/interface.LOAN.gpl.js:77
msgid "Number of Payments"
msgstr "Numero di pagamenti"

#. 'annual interest rate' is the nominal annual rate. The user will understand the concept from its context. The translation must be concise. A report's label.
#: dist/js/interface.LOAN.gpl.js:78
msgid "Annual Interest Rate"
msgstr "Tasso di interesse annuale"

#. A calculator's user prompt for input or a report's label. The user will understand the concept from its context. The translation must be concise.
#: dist/js/interface.LOAN.gpl.js:79
msgid "Periodic Payment"
msgstr "Pagamento periodico"

#. Date when the money is available. In U.S. it's the closing date of the loan. A calculator's user prompt for input or a report's label. The user will understand the concept from its context. The translation must be concise.
#: dist/js/interface.LOAN.gpl.js:80
msgid "Loan Date"
msgstr "Data del prestito"

#. Date the first payment is due. A calculator's user prompt for input or a report's label. The user will understand the concept from its context. The translation must be concise.
#: dist/js/interface.LOAN.gpl.js:81
msgid "1st Payment Due"
msgstr "1° Pagamento dovuto"

#. The frequency of the schedule payments or cash flow. Examples: monthly, quarterly. A calculator's user prompt for input or a report's label. The user will understand the concept from its context. The translation must be concise.
#: dist/js/interface.LOAN.gpl.js:82
msgid "Payment Frequency"
msgstr "Frequenza di pagamento"

#. The scheduled date for the last loan payment. A report label. The user will understand the concept from its context. The translation must be concise.
#: dist/js/interface.LOAN.gpl.js:83
msgid "Last Payment Due"
msgstr "Ultimo pagamento dovuto"

#. Estimated total interest amount. A report label. The user will understand the concept from its context. The translation must be concise.
#: dist/js/interface.LOAN.gpl.js:84
msgid "Total Interest Due"
msgstr "Totale interessi dovuti"

#. The sum of all loan payments. A report label. The user will understand the concept from its context. The translation must be concise.
#: dist/js/interface.LOAN.gpl.js:85
msgid "Total All Payments"
msgstr "Totale di tutti i pagamenti"

#. A title centered over a detail report section showing projected payments with their due dates. Translate 'schedule' in this financial context. English synonym 'amortization schedule'
#: dist/js/interface.LOAN.gpl.js:86
#: en/calculator.gui.php:435
msgid "Payment Schedule"
msgstr "Piano di Pagamento"

#. A report's label for a specific calendar year. Example: "Year: 2024". The user will understand the concept from its context. The translation must be specifically for "year".
#: dist/js/interface.LOAN.gpl.js:87
msgid "Year"
msgstr "Anno"

#. A specific date. Example: "Date: 11/30/2024". Frequently, a column label in a report or a prompt for user input. The translation must be specifically for 'date' in this context. It is NOT a romantic 'date.'
#: dist/js/interface.LOAN.gpl.js:88
msgid "Date"
msgstr "Data"

#. Periodic payment amount. A calculator's user prompt for input or a report's label. The user will understand the concept from its context. The translation must be concise.
#: dist/js/interface.LOAN.gpl.js:89
#: en/calculator.gui.php:88
#: en/calculator.gui.php:197
msgid "Payment"
msgstr "Rata"

#. Loan or investment interest amount. A report label. The user will understand the concept from its context. Must specifically translate "interest" in the financial sense.
#: dist/js/interface.LOAN.gpl.js:90
msgid "Interest"
msgstr "Interesse"

#. Loan or investment principal amount as of a particular date. Used to label a column in a report. Must specifically translate "principal" in the financial sense.
#: dist/js/interface.LOAN.gpl.js:91
msgid "Principal"
msgstr "Capitale"

#. The loan or investment balance as of a particular date. Used to label a column in a report. Must be concise.
#: dist/js/interface.LOAN.gpl.js:92
msgid "Balance"
msgstr "Saldo"

#. A report label. The user will understand the concept from its context. The translation must be concise.informing reader what calculation method was used.
#: dist/js/interface.LOAN.gpl.js:93
msgid "Calculation method: Normal"
msgstr "Metodo di calcolo: Normale"

#. The total loan principal. A report's label.
#: dist/js/interface.LOAN.gpl.js:94
msgid "Total Principal"
msgstr "Capitale totale"

#. The total loan or investment interest. A report's label.
#: dist/js/interface.LOAN.gpl.js:95
#: en/calculator.gui.php:91
#: en/calculator.gui.php:200
#: en/calculator.gui.php:309
#: en/calculator.gui.php:419
msgid "Total Interest"
msgstr "Interesse totale"

#. The percentage of total payment. A chart's label. Use recognized abbreviations for conciseness.
#: dist/js/interface.LOAN.gpl.js:96
msgid "Pct. of Total Payments"
msgstr "% dei pagamenti totali"

#. The centered title over a graph or chart.
#: dist/js/interface.LOAN.gpl.js:97
msgid "Annual Principal and Interest Totals"
msgstr "Totali annuali di capitale e interessi"

#. The centered title over a graph or chart.
#: dist/js/interface.LOAN.gpl.js:98
msgid "Accumulated Principal and Interest with Remaining Balance"
msgstr "Capitale e interessi accumulati con saldo residuo"

#. The centered title over a graph or chart.
#: dist/js/interface.LOAN.gpl.js:99
msgid "Total Principal and Interest"
msgstr "Totale capitale e interessi"

#. A label for a financial report, chart or graph.
#: dist/js/interface.LOAN.gpl.js:100
msgid "Loan"
msgstr "Prestito"

#. A data entry error message shown to the user. User needs to provide more inputs.
#: dist/js/interface.LOAN.gpl.js:107
msgid "There are too many unknown values."
msgstr "Ci sono troppi valori sconosciuti."

#. An instructional message show to the user.
#: dist/js/interface.LOAN.gpl.js:109
msgid "Enter \"Loan Amount\", \"Number of Payments\" and \"Annual Interest Rate\"."
msgstr "Inserire \"Importo del prestito\", \"Numero di pagamenti\" e \"Tasso di interesse annuale\"."

#. A title string appearing in the header of the help modal. Retain the HTML markup.
#: dist/js/interface.LOAN.gpl.js:110
msgid "<strong>Loan Calculator Help...</strong>"
msgstr "<strong>Guida al calcolatore prestito...</strong>"

#. Informational text for the calculator's user. Keep HTML markup intact (as always)!
#: dist/js/interface.LOAN.gpl.js:111
msgid "<p>Using the calculator is straightforward. User enters a &quot;loan amount&quot;, &quot;number of months&quot;, &quot;annual interest rate&quot;. The calculator calculates the monthly payment amount.</p>"
msgstr "<p>Usare il calcolatore è semplice. L'utente inserisce un &quot;importo del prestito&quot;, &quot;numero di mesi&quot;, &quot;tasso di interesse annuale&quot;. Il calcolatore calcola l'importo della rata mensile.</p>"

#. Informational text for the calculator's user. Keep HTML markup intact (as always)!
#: dist/js/interface.LOAN.gpl.js:112
msgid "<p>The &quot;Payment Method&quot; determines when the first payment is due. With the default selection, &quot;End-of-Period&quot;, the first payment will be due one month after the loan is made. If &quot;Start-of-Period&quot; is selected, then the first payment will be due on the loan date.</p>"
msgstr "<p>Il \"tempistica di pagamento\" determina quando è dovuto il primo pagamento. Con la selezione predefinita, &quot;Fine del Periodo&quot;, il primo pagamento sarà dovuto un mese dopo la concessione del prestito. Se viene selezionato &quot;Inizio del Periodo&quot;, il primo pagamento sarà dovuto alla data del prestito.</p>"

#. Informational text for the calculator's user. Keep HTML markup intact (as always)!
#: dist/js/interface.LOAN.gpl.js:113
msgid "<p class=\"tail\">The term (duration) of the loan is expressed as a number of months.</p>"
msgstr "<p class=\"tail\">La durata del prestito è espressa in numero di mesi.</p>"

#. Informative message providing conversions for user found in the calculator's help text. Retain HTML markup!
#: dist/js/interface.LOAN.gpl.js:114
msgid "<ul class=\"mono tail\"><li>&nbsp;60 months = &nbsp;5 years</li><li>120 months = 10 years</li><li>180 months = 15 years</li><li>240 months = 20 years</li><li class=\"tail\">360 months = 30 years</li></ul>"
msgstr "<ul class=\"mono tail\"><li>&nbsp;60 mesi = &nbsp;5 anni</li><li>120 mesi = 10 anni</li><li>180 mesi = 15 anni</li><li>240 mesi = 20 anni</li><li class=\"tail\">360 mesi = 30 anni</li></ul>"

#. Informational text for the calculator's user. Keep HTML markup intact (as always)!
#: dist/js/interface.LOAN.gpl.js:116
msgid "<p class=\"small\" style=\"font-size: 85%; line-height: 1.5; color:red; user-select: text\">Need more options including the ability to solve for other unknowns? Set the dates? Set or change the payment and compounding frequencies? Print the schedule? Export to MS Word&trade; (.docx) or MS Excel&trade; (.xlsx) files? Please visit, <b>https://accuratecalculators.com/loan-calculator</b></p>"
msgstr "<p class=\"small\" style=\"font-size: 85%; line-height: 1.5; color:red; user-select: text\">Hai bisogno di più opzioni, inclusa la possibilità di risolvere altre incognite? Impostare le date? Impostare o modificare le frequenze di pagamento e capitalizzazione? Stampare il piano? Esportare in file MS Word&trade; (.docx) o MS Excel&trade; (.xlsx)? Visita il sito, <b>https://accuratecalculators.com/loan-calculator</b></p>"

#. An exception error message which user could potentially see.
#: dist/js/interface.LOAN.gpl.js:117
#: dist/js/interface.LOAN.gpl.js:890
msgid "Dates must be the first of the month."
msgstr "Le date devono essere il primo del mese."

#. An exception error message which user could potentially see.
#: dist/js/interface.LOAN.gpl.js:118
#: dist/js/interface.LOAN.gpl.js:891
msgid "An invalid JavaScript date object."
msgstr "Un oggetto data JavaScript non valido."

#. The cash flow or compounding frequency.
#: dist/js/interface.LOAN.gpl.js:119
#: dist/js/interface.LOAN.gpl.js:892
msgid "Monthly"
msgstr "Mensile"

#. Informational text for the calculator's user. Keep HTML markup intact (as always)!
#: dist/js/interface.LOAN.gpl.js:121
msgid "<p class=\"small\" style=\"font-size: 85%; line-height: 1.5; color:red; user-select: text\">Need more options including the ability to solve for other unknowns? Set the dates? Set or change the payment and compounding frequencies? Print the charts? Export to MS Word&trade; (.docx) or MS Excel&trade; (.xlsx) files? Please visit, <b>https://accuratecalculators.com/loan-calculator</b></p>"
msgstr "<p class=\"small\" style=\"font-size: 85%; line-height: 1.5; color:red; user-select: text\">Hai bisogno di più opzioni, inclusa la possibilità di risolvere altre incognite? Impostare le date? Impostare o modificare le frequenze di pagamento e capitalizzazione? Stampare i grafici? Esportare in file MS Word&trade; (.docx) o MS Excel&trade; (.xlsx)? Visita il sito, <b>https://accuratecalculators.com/loan-calculator</b></p>"

#. The person's name for whom a report is prepared. A report's label.
#: dist/js/interface.LOAN.gpl.js:125
msgid "Prepared for"
msgstr "Preparato per"

#. A report's label for a street address.
#: dist/js/interface.LOAN.gpl.js:127
#: dist/js/interface.LOAN.gpl.js:135
msgid "Address"
msgstr "Indirizzo"

#. A report's label for postal address details.
#: dist/js/interface.LOAN.gpl.js:129
msgid "City, State  ZIP"
msgstr "Città, Stato  CAP"

#. The date a financial report was prepared. A report's label.
#: dist/js/interface.LOAN.gpl.js:131
msgid "Prepared On"
msgstr "Preparato il"

#. The person's name who prepared a report. A report's label.
#: dist/js/interface.LOAN.gpl.js:133
msgid "Prepared by"
msgstr "Preparato da"

#. A label for a phone number.
#: dist/js/interface.LOAN.gpl.js:137
msgid "Phone"
msgstr "Telefono"

#. A report's label for an email address.
#: dist/js/interface.LOAN.gpl.js:139
msgid "Email"
msgstr "Email"

#. A report's label for a website address or URL.
#: dist/js/interface.LOAN.gpl.js:141
msgid "Website"
msgstr "Sito web"

#. Name of an online calculator. Used in an H1 element or report title. Translate the name as a native speaker would enter it into an online search engine.
#: en/calculator.gui.php:26
#: en/calculator.gui.php:28
msgid "Loan Calculator"
msgstr "Calcolatore prestito"

#: en/calculator.gui.php:43
#: en/calculator.gui.php:152
#: en/calculator.gui.php:261
#: en/calculator.gui.php:371
msgid "Loan Calculator Plugin for WordPress"
msgstr "Calcolatore Prestito Plugin per WordPress"

#: en/calculator.gui.php:44
#: en/calculator.gui.php:153
#: en/calculator.gui.php:262
#: en/calculator.gui.php:372
msgid "This loan calculator plugin creates loan payment schedules with dates."
msgstr "Questo plugin per il calcolatore di prestiti crea piani di pagamento con date."

#. Text for a hyperlink.
#: en/calculator.gui.php:68
#: en/calculator.gui.php:177
#: en/calculator.gui.php:286
#: en/calculator.gui.php:396
msgid "click for more features"
msgstr "clicca per altre funzionalità"

#. The principal loan amount. A user prompt for input.
#: en/calculator.gui.php:71
#: en/calculator.gui.php:180
#: en/calculator.gui.php:289
#: en/calculator.gui.php:399
msgid "Loan Amount?"
msgstr "Importo del prestito?"

#. Number of months for the cash flow. This is a user prompt.
#: en/calculator.gui.php:74
#: en/calculator.gui.php:183
msgid "Months? (#)"
msgstr "Mesi? (n.)"

#. A concise user prompt as in interest rate. Exactly which rate will be understood by the user from the surrounding context.
#: en/calculator.gui.php:77
msgid "Rate?"
msgstr "Tasso?"

