#. The title in a modal's header. The modal offers the user the ability to select a currency symbol and date formatting options.
#: en/calculator.gui.php:512
msgid "Currency and Date Conventions"
msgstr "Valuutta- ja päivämääräkäytännöt"

#. An information message shown to the user in a modal window.
#: en/calculator.gui.php:664
msgid "The calculator will remember your choice. You may also change it at any time."
msgstr "Laskuri muistaa valintasi. Voit myös muuttaa sitä milloin tahansa."

#. An information message shown to the user in a modal window.
#: en/calculator.gui.php:667
msgid "Clicking \"Save changes\" will cause the calculator to reload. Your edits will be lost."
msgstr "Napsauttamalla \"Tallenna muutokset\" laskuri ladataan uudelleen, ja muokkauksesi menetetään."

#. A label on a button. Clicking the button cancels an action, cancels an option or closes a window.
#: en/calculator.gui.php:674
msgid "Cancel"
msgstr "Peruuta"

#. A label on a button. Clicking the button causes the user selections to be saved.
#: en/calculator.gui.php:675
msgid "Save changes"
msgstr "Tallenna muutokset"

#: en/calculator.gui.php:699
msgid "Cash flow forecast..."
msgstr "Kassavirtaennuste..."

#. A label on a button. When the button is clicked by the user, the window will close.
#: en/calculator.gui.php:710
#: en/calculator.gui.php:757
#: en/calculator.gui.php:791
#: en/calculator.gui.php:825
msgid "Close"
msgstr "Sulje"

#. A title which appears in a modal's header section. This indicates it's a "message" for the user.
#: en/calculator.gui.php:814
msgid "Message"
msgstr "Viesti"

#. An informative message shown to a user after making a data entry error.
#: fc-loan-calculator.php:434
msgid "Please enter a valid number greater than 0 for"
msgstr "Anna kelvollinen luku, joka on suurempi kuin 0"

#. An informative message shown to a user after making a data entry error.
#: fc-loan-calculator.php:1060
msgid "Please enter a valid number for \"Default loan amount.\""
msgstr "Anna kelvollinen luku \"Oletuslainasummalle\"."

#. An informative message shown to a user after making a data entry error.
#: fc-loan-calculator.php:1064
msgid "Please enter a valid number for \"Default number of months.\""
msgstr "Anna kelvollinen luku \"Oletuskuukausien määrälle\"."

#. An informative message shown to a user after making a data entry error.
#: fc-loan-calculator.php:1068
msgid "Please enter a valid number for \"Default interest rate.\""
msgstr "Anna kelvollinen luku \"Oletuskorkoprosentille\"."

#. An informative message shown to a user after making a data entry error.
#: fc-loan-calculator.php:1073
msgid "Please enter a valid value for \"Default Currency.\""
msgstr "Anna kelvollinen arvo \"Oletusvaluutalle\"."

#. The date format maps to a number. An informative message shown to a user after making a data entry error.
#: fc-loan-calculator.php:1077
msgid "Please enter a valid number for \"Default Date Format.\""
msgstr "Anna kelvollinen luku \"Oletuspäivämäärämuodolle\"."

#. An instructional message to the user appearing on a set up screen.
#: fc-loan-calculator.php:1171
msgid "Do not forget to save your changes. Scroll all the way down in this panel for the <span class=\"red\">[Save]</span> button."
msgstr "Älä unohda tallentaa muutoksiasi. Vieritä tämän paneelin loppuun asti löytääksesi <span class=\"red\">[Tallenna]</span>-painikkeen."

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-loan-calculator.php:1176
msgid "Widget's size (size limits adjustable below)?"
msgstr "Widgetin koko (koon rajat säädettävissä alapuolella)?"

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-loan-calculator.php:1178
msgid "Tiny (max width = 180px)"
msgstr "Pikkuruinen (maksimileveys = 180px)"

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-loan-calculator.php:1179
msgid "Small (max width = 300px)"
msgstr "Pieni (maksimileveys = 300px)"

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-loan-calculator.php:1180
msgid "Medium (max width = 340px)"
msgstr "Keskikokoinen (maksimileveys = 340px)"

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-loan-calculator.php:1181
msgid "Large (max width = 440px)"
msgstr "Suuri (maksimileveys = 440px)"

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-loan-calculator.php:1188
msgid "Load custom style sheet?"
msgstr "Lataa mukautettu tyylitiedosto?"

#. The negative answer to a binary question.
#: fc-loan-calculator.php:1190
#: fc-loan-calculator.php:1357
#: fc-loan-calculator.php:1366
#: fc-loan-calculator.php:1377
#: fc-loan-calculator.php:1386
msgid "No"
msgstr "Ei"

#. The positive answer to a binary question.
#: fc-loan-calculator.php:1191
#: fc-loan-calculator.php:1358
#: fc-loan-calculator.php:1367
#: fc-loan-calculator.php:1378
#: fc-loan-calculator.php:1387
msgid "Yes"
msgstr "Kyllä"

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-loan-calculator.php:1195
msgid "If \"Yes\" loads &lt;site&gt;\\wp-content\\plugins\\ac-loan-calculator\\css\\accurate-calculators-custom.css. Entries in <b>accurate-calculators-custom.css</b> override the plugin's look. Editing the provided custom stylesheet is another way to modify the look of the calculator. For best performance include only the rules in the custom stylesheet you are overriding. BACKUP YOUR CUSTOMIZATIONS! You will need to manually replace them when (if) you upgrade the plugin."
msgstr "Jos \"Kyllä\" lataa &lt;sivusto&gt;\\wp-content\\plugins\\ac-loan-calculator\\css\\accurate-calculators-custom.css. Merkinnät tiedostossa <b>accurate-calculators-custom.css</b> ohittavat pluginin ulkoasun. Tarjotun mukautetun tyylitiedoston muokkaaminen on toinen tapa muuttaa laskimen ulkoasua. Parhaan suorituskyvyn saavuttamiseksi sisällytä mukautettuun tyylitiedostoon vain ne säännöt, jotka haluat ohittaa. VARMUUSKOPIOI MUKAUTUKSESI! Sinun tulee manuaalisesti korvata ne, kun (jos) päivität pluginin."

#. A configuration option set by the website's developer for setting the websites default currency symbol - not user facing.
#: fc-loan-calculator.php:1201
msgid "Set a default currency?"
msgstr "Aseta oletusvaluutta?"

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-loan-calculator.php:1203
msgid "Use visitor's browser's settings to set currency - do not override."
msgstr "Käytä kävijän selaimen asetuksia valuutan asettamiseen - älä ohita niitä."

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-loan-calculator.php:1327
msgid "Set a date format convention?"
msgstr "Aseta päivämäärämuoto?"

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-loan-calculator.php:1329
msgid "Use visitor's browser's settings to set date format - do not override."
msgstr "Käytä kävijän selaimen asetuksia päivämäärämuodon asettamiseen - älä ohita niitä."

#. An instruction or clarification for the website's administrator - not end-user facing.
#: fc-loan-calculator.php:1341
msgid "When a user first visits your site, the plugin will use the browser's international conventions to set the currency and date format. If you wish, you may override the plugin and set a default currency and date format. The user will still have the ability to override either setting if you do not hide the &quot;international conventions&quot; below."
msgstr "Kun käyttäjä vierailee sivustollasi ensimmäistä kertaa, plugin käyttää selaimen kansainvälisiä asetuksia valuutan ja päivämäärämuodon asettamiseen. Halutessasi voit ohittaa pluginin asetukset ja määrittää oletusvaluutan ja päivämäärämuodon. Käyttäjä voi silti ohittaa nämä asetukset, jos et piilota &quot;kansainvälisiä asetuksia&quot; alla."

#. An instruction or clarification for the website's administrator - not end-user facing.
#: fc-loan-calculator.php:1346
msgid "<strong>Note:</strong> Your visitors may select a date format and currency by clicking on <span class=\"red\">$ : MM/DD/YYYY</span> in the calculator's lower right corner if you do not set \"Hide international conventions\" to \"yes\"."
msgstr "<strong>Huom:</strong> Vierailijasi voivat valita päivämäärämuodon ja valuutan napsauttamalla <span class=\"red\">$ : MM/DD/YYYY</span> laskimen oikeassa alakulmassa, jos et aseta \"Piilota kansainväliset asetukset\" arvoon \"kyllä\"."

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-loan-calculator.php:1355
msgid "Hide the resize buttons?"
msgstr "Piilota koonmuutospainikkeet?"

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-loan-calculator.php:1364
msgid "Hide international conventions?"
msgstr "Piilota kansainväliset asetukset?"

#. A configuration option set by the website's developer - not an end-user facing string.
#: fc-loan-calculator.php:1375
msgid "Hide the Payment Method?"
msgstr "Piilota maksun ajoitus?"

#. Inital part of a string asking site's administrator if they want to "link to" another site. Administrator will answer 'Yes' or 'No'.
#: fc-loan-calculator.php:1384
msgid "Link to"
msgstr "Linkki kohteeseen"

#. An instruction or clarification for the website's administrator - not end-user facing.
#: fc-loan-calculator.php:1396
msgid "If \"Link to AccurateCalculators.com\" is set to \"Yes\", one very discreet follow link will be inserted in the calculator. If you allow the link, you may rebrand the calculator with your name. Resetting this option to \"No\" at any time will remove the links. See FAQ's in readme file for details."
msgstr "Jos \"Linkki kohteeseen AccurateCalculators.com\" on asetettu \"Kyllä\", laskimeen lisätään hyvin huomaamaton seurantalinkki. Jos sallit linkin, voit brändätä laskimen omalla nimelläsi. Asetuksen muuttaminen \"Ei\"-tilaan milloin tahansa poistaa linkit. Katso lisätietoja readme-tiedoston UKK:sta."

#. A prompt asking site's administrator for their brand name.
#: fc-loan-calculator.php:1401
msgid "Add Your Brand Name"
msgstr "Lisää tuotemerkkisi nimi"

#. An instruction or clarification for the website's administrator - not end-user facing.
#: fc-loan-calculator.php:1405
msgid "You may brand this widget with your brand. <b>Example: \"Abe's Best\"</b> will be preappended to \"Loan Calculator\". For this to work, the above \"Link to\" option must be set to \"Yes\"."
msgstr "Voit brändätä tämän widgetin omalla brändilläsi. <b>Esimerkki: \"Aben Parhaat\"</b> lisätään \"Lainalaskuri\" eteen. Jotta tämä toimisi, yllä oleva \"Linkki kohteeseen\"-asetus on oltava \"Kyllä\"."

#. A prompt for the site's developer instructing them to set a site-wide default value for a user entered value. Not user facing.
#: fc-loan-calculator.php:1416
msgid "Default loan amount"
msgstr "Oletuslainasumma"

#. A prompt for the site's developer instructing them to set a site-wide default value for a user entered value. Not user facing.
#: fc-loan-calculator.php:1422
msgid "Default number of months"
msgstr "Kuukausien oletusmäärä"

#. A prompt for the site's developer instructing them to set a site-wide default value for a user entered value. Not user facing.
#: fc-loan-calculator.php:1429
msgid "Default interest rate"
msgstr "Oletuskorko"

#. An instructional or clarification message concerning data entry requirements.
#: fc-loan-calculator.php:1435
msgid "Enter only digits.<br>No currency or formatting."
msgstr "Syötä vain numeroita.<br>Ei valuutta- tai muotoilumerkkejä."

#. A sectional label on a settings page for administrator settings that impact style.
#: fc-loan-calculator.php:1445
msgid "Style options."
msgstr "Tyylivaihtoehdot."

#. An instructional message to the site's administrator explaining setting website color option.
#: fc-loan-calculator.php:1447
msgid "(Defaults in parentheses. \"hex\", \"rgb\", or \"rgba\" values accepted for colors.)"
msgstr "(Oletusarvot suluissa. \"hex\", \"rgb\" tai \"rgba\" -arvot hyväksytään väreille.)"

#. An instructional message for administrator settings.
#: fc-loan-calculator.php:1571
msgid "You may tweak the minimum and maximum widths."
msgstr "Voit säätää minimileveyttä ja maksimileveyttä."

#. An instructional message for administrator settings.
#: fc-loan-calculator.php:1573
msgid "(\"px\", \"rem\", and \"em\" units accepted.)"
msgstr "(\"px\", \"rem\" ja \"em\" yksiköt hyväksytään.)"

#: fc-loan-calculator.php:1656
msgid "AC Loan Calculator by AccurateCalculators.com"
msgstr "AC Lainalaskuri, AccurateCalculators.com"

#: fc-loan-calculator.php:1658
msgid "AC Loan Calculator Plugin"
msgstr "AC Lainalaskuri-lisäosa"

#. Plugin Name of the plugin/theme
msgid "AC Loan Calculator"
msgstr "AC Lainalaskuri"

#. Plugin URI of the plugin/theme. Do not translate the URL.
msgid "https://accuratecalculators.com/calculator-plugins/loan-plus-plugin"
msgstr "https://accuratecalculators.com/calculator-plugins/loan-plus-plugin"

#. Description of the plugin/theme
msgid "A versatile loan calculator with an amortization schedule, payment dates, and interactive charts. Rebrand with your name. Supports 90 currencies, 6 date formats, and 15 languages. Highly customizable via extensive configuration options. Version 2.0 is a major update—test before upgrading."
msgstr "Monipuolinen lainalaskuri, jossa on takaisinmaksuaikataulu, maksupäivät ja interaktiiviset kaaviot. Brändää omalla nimelläsi. Tukee 90 valuuttaa, 6 päivämäärämuotoa ja 15 kieltä. Erittäin muokattavissa laajojen asetusten kautta. Versio 2.0 on merkittävä päivitys—testaa ennen päivittämistä."

#. Author of the plugin/theme Do not translate the domain.
msgid "AccurateCalculators.com"
msgstr "AccurateCalculators.com"

#. Author URI of the plugin/theme. Do not translate the URL.
msgid "https://AccurateCalculators.com"
msgstr "https://AccurateCalculators.com"

