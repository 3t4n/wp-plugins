			// TRANSLATORS: calculator's help text - not for GPL version
			s417b: wp.i18n.__('<p class="small" style="font-size: 85%; line-height: 1.5; color:red; user-select: text">Need more options including the ability to solve for other unknowns? Set the dates? Set or change the payment and compounding frequencies? Print the charts? Export to MS Word&trade; (.docx) or MS Excel&trade; (.xlsx) files? Please visit, <b>https://accuratecalculators.com/loan-calculator</b></p>',	'__TEXT_DOMAIN__'),
