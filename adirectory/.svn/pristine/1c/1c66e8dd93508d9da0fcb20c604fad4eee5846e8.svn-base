	display: -ms-flexbox;
	display: flex;
	-webkit-box-align: center;
	    -ms-flex-align: center;
	        align-items: center;
	-webkit-box-pack: justify;
	    -ms-flex-pack: justify;
	        justify-content: space-between;
	cursor: pointer;

}
.qsd-prodcut-grid-with-side-bar-main:not(.adqs_layoutTypetop) .qsd-prodcut-grid-with-side-bar-titel + div{
	display: none;

}
.qsd-prodcut-grid-with-side-bar-main:not(.adqs_layoutTypetop) .qsd-prodcut-grid-with-side-bar-titel:after{
	content: "\f347";
	font-family:'dashicons';
}
.adqs-taxonomyDropdown-items input[type="checkbox"],
.adqs-taxonomyDropdown-items input[type="checkbox"]:not(:checked) + .dashicons{
	display:none !important;
}
