	line-height: 10px;
}
.adqs-tax-multichebox .dashicons-yes{
	color: #008000;
	vertical-align: middle;
}
.adqs-dropdown-reset {
	position: absolute;
	right: 6px;
	top: 5px;
	color: var(--color-primary);
	cursor: pointer;
	border-radius: 50%;
	font-size: 11px;
	font-weight: 600;
	z-index: 9;
	display: inline-block;
	padding: 5px;
	line-height: 18px;
}
.qsd-widget-tax-wrap .qsd-tax-see-more{
