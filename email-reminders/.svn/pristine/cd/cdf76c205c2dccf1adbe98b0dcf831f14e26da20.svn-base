.oper_resources_table .table,.oper_resources_table .table.widefat{border:0 solid #bbb;box-shadow:0 0 2px #aaa}.oper_resources_table table>thead>tr>th{background-color:#fff;border-bottom:2px solid #e5e5e5}.wpdevelop.oper_resources_table table>tfoot>tr>th{background-color:#fff;border-top:2px solid #e5e5e5}.oper_resources_table tfoot th,.oper_resources_table thead th{font-weight:600;text-align:left}.oper_resources_table th a,.oper_resources_table th a:focus,.oper_resources_table th a:hover{text-decoration:none}.wpdevelop.oper_resources_table table>tbody>tr.row_selected_color>td,.wpdevelop.oper_resources_table table>tbody>tr.row_selected_color>th{background:#b5d4ef;border-color:#ccc!important}.oper_resources_table th a span.glyphicon{font-size:.8em;font-weight:400;padding-left:2px}.wpdevelop.oper_resources_table .table>tbody>tr>td,.wpdevelop.oper_resources_table .table>tbody>tr>th,.wpdevelop.oper_resources_table .table>tfoot>tr>td,.wpdevelop.oper_resources_table .table>tfoot>tr>th,.wpdevelop.oper_resources_table .table>thead>tr>td,.wpdevelop.oper_resources_table .table>thead>tr>th{vertical-align:middle}.oper_resources_table .label{border:1px solid #eee;box-shadow:0 0 1px #ddd;line-height:2.4em;padding:2px 5px;white-space:nowrap}.oper_resources_table .label a,.oper_resources_table .label a:hover,.oper_resources_table .label span{color:#fff;text-decoration:none}.oper_resources_table .label-pending{background:#ffbb45}.oper_resources_table .label-approved{background:#9be}.oper_resources_table .label-trash{background:#d94a48;color:#fff;text-shadow:0 0 1px #e00}.oper_resources_table .label-unknown{background-color:#999!important}.oper_resources_table .label-error{background-color:#fa773d!important}.oper_resources_table .payment-label-success{background-color:#468847!important}.oper_resources_table .payment-label-pending{background-color:#992!important}.oper_resources_table .payment-label-unknown{background-color:#999!important}.oper_resources_table .payment-label-error{background-color:#fa773d!important}.oper_resources_table .field-currency{color:#444;display:inline;font-size:15px;font-weight:600;height:26px;line-height:1.7em;padding:0;vertical-align:top}.oper_resources_table select,.wpdevelop.oper_resources_table .table>tbody>tr>td select.form-control{border-radius:0;height:2em;padding:2px;width:auto}@media (max-width:782px){.oper_resources_table td.oper_hide_mobile,.oper_resources_table th.oper_hide_mobile{display:none}.oper_resources_table td.oper_col_id,.oper_resources_table th.oper_col_id{width:4em}.oper_resources_table td.oper_col_title,.oper_resources_table th.oper_col_title{width:9em}.oper_resources_table .field-currency{line-height:2.1em}#wpbody .oper_resources_table select{height:32px}}@media (max-width:600px){.oper_resources_table td.oper_hide_mobile_xs,.oper_resources_table th.oper_hide_mobile_xs{display:none}}
