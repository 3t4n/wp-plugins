.oper_page .oper_admin_page .oper_header_margin{height:10px}.oper_page .meta-box .postbox .handlediv{background:url(../../assets/img/arrows.png) no-repeat scroll 5px -27px transparent}.oper_page .meta-box .postbox.closed .handlediv{background-position:5px 10px}.oper_page .meta-box .postbox .handlediv:hover{cursor:pointer!important}.oper_page .meta-box .postbox .hndle:hover{cursor:default!important}.oper_settings_row.oper_settings_row_left{float:left;margin-right:1%;width:64%}.oper_settings_row.oper_settings_row_right{float:left;width:35%}.oper_settings_row.oper_settings_row_left_small{width:35%}.oper_settings_row.oper_settings_row_right_big{width:64%}.oper_page input::-moz-placeholder,.oper_page textarea::-moz-placeholder{color:#ccc;opacity:1}.oper_page input:-ms-input-placeholder,.oper_page textarea:-ms-input-placeholder{color:#ccc}.oper_page input::-webkit-input-placeholder,.oper_page textarea::-webkit-input-placeholder{color:#ccc}@media (max-width:782px){.oper_page .oper_admin_page .metabox-holder .oper_settings_row{float:none;width:100%}.oper_text_hide_mobile{display:none}}
