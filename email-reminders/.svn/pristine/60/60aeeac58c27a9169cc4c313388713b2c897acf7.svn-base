.oper_rules_listing_container .oper_rules_conditions {
	display: flex;
	flex-flow: row wrap;
	justify-content: flex-start;

	align-items: baseline;
	width:100%;
}

.oper_rules_listing_container .oper_rules_conditions .oper_rules_condition_if{
	flex: 0 1 auto;
	min-width: 15em;
	text-align: right;
}
.oper_rules_listing_container .oper_rules_conditions .oper_rules_condition_sign{
	flex: 0 1 auto;
	min-width: 5em;
	text-align: center;
}
.oper_rules_listing_container .oper_rules_conditions .oper_rules_condition_value {
	flex: 1 1 auto;
}

.oper_next_rule_time{
	font-size: 0.85em;
	display: flex;
	flex-flow: row wrap;
	justify-content: flex-end;
	align-items: center;
}
.oper_next_rule_time span {
	flex: 0 1 auto;
}