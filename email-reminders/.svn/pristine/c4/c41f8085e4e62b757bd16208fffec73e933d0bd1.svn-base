.oper_page .oper_system_notice{margin:5px 0 15px!important;padding:1em}.oper_page .oper_internal_notice,.oper_page .oper_system_notice{box-sizing:border-box;display:block;height:auto;min-height:1em;position:relative;width:100%}.oper_page .oper_internal_notice{background:#fff;border-left-style:solid;border-left-width:4px;box-shadow:0 0 2px 0 rgba(0,0,0,.2);margin:5px 15px 2px}.oper_page .oper_internal_notice a,.oper_page .oper_internal_notice a:focus,.oper_page .oper_internal_notice a:hover,.oper_page .oper_system_notice a,.oper_page .oper_system_notice a:focus,.oper_page .oper_system_notice a:hover{text-decoration:none}.oper_page .oper_dismiss,.oper_page a.oper_dismiss:focus,.oper_page a.oper_dismiss:hover{float:right;font-size:18px;margin:-7px;outline:none;padding:5px 10px 10px;text-decoration:none}
