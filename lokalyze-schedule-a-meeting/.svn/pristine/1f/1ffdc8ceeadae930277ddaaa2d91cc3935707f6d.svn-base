/*---------media-----------*/
@media (min-width: 992px) and (max-width: 1199px) {
    .main-menu ul li a{padding: 0px 11px;}
    .banner-area .banner-shape{
        right: 11px;
        bottom: -33px;
        height: 400px;
        width: 430px;    border: 40px solid #ebf4ff;
    }
    .banner-area .banner-content ul li a p{font-size: 16px;}
}
@media only screen and (max-width: 990px) {
    .banner-content{    margin-top: 70px;}
    .icn-round{height: 50px;width: 50px;line-height: 40px;}
    .icn-round i{height: 40px;width: 40px;font-size: 17px;line-height: 45px;}
    .main-menu ul li a{font-size: 15px;padding: 0px 15px;}
    .banner-area .banner-shape{
    right: 91px;
    bottom: 0;
    height: 300px;
    width: 300px;
     background: none; 
     border-radius:0; 
     border:0; 
    }
    .banner-area .banner-content>span{    font-size: 16px;}
    .banner-area .banner-content h1{
        font-size: 40px;
        line-height: 30px;
    }
    .banner-area{height:400px;}
    .about-area .about-item h3 {
        font-size: 30px;
        line-height: 35px;
        padding-bottom: 15px;
        padding-top: 10px;

    }
    .about-area .about-item p{font-size: 15px;text-align: justify;margin-bottom: 20px;}
    .more-btn{padding: 0 40px;line-height: 45px;}
    .services { margin-top: 30px;padding: 0px 0 20px 0;}
    .services::before{border-left: 642px solid transparent;border-bottom: 33px solid #eef8f5;}
    .hme-servblock h2{font-size: 30px;}
    .hme-servblock p{margin-bottom: 10px;font-size:15px;}
    .serv-cards{margin:0;}
    .serv-img img{    height: 80px;}
    .create-steps{padding: 50px 0 80px 0;}
    .create-steps p{    margin-bottom: 30px;}
    .create-steps h2{font-size: 30px;margin: 0px 0 10px 0;}
    .steps-cards::after{display:none;}
    .create-steps .icn-round{line-height: 51px;height: 65px;width: 65px;}
    .steps-cards img{height: 34px;}
    .steps-cards{    padding: 30px 20px 10px 20px;}
    .steps-cards h4{margin: 15px 0 10px 0;}
    .steps-cards p{margin-bottom:0!important;}
    .needquote-area::before{border-left: 795px solid transparent;
                            border-bottom: 50px solid #fff;}
    .needquote-area img{display:none;}
    .needquote-area{padding: 0px 0 30px 0;}
    /*    .list-item{
            padding: 10px;
        }*/
    /*    .abt-list li .service_img{
            margin-left: 0;    width: 80px;
            height: 80px; line-height: 80px;
        }
        .abt-list li .service_img i{
            font-size: 35px;
        }*/
    /*    .h-tf{
            height: 245px;
        }*/
    .other-page-banner h1{font-size:45px;}
    .other-page-banner h2{font-size: 40px;}
    .other-page-banner{
        height:180px;
    }
    .line-a{
        display:none !important ;
    }
    .about-us h3{
        font-size:30px;
    }
    .cont-list{
        margin-top: 20px;
    }
    .c-formside{margin-top:0;}
    .othr-page-head h3{font-size: 35px;}
    .career-form-row{padding: 0 0 10px 0;}
    .about-us{margin-bottom: 20px;}
    .othr-page-head{margin: 20px 0 10px 0;}
}
@media only screen and (max-width: 767px) {
    .banner-area .banner-shape{display:none;}
    .banner-area::before{background-image: url(../images/banner-mobile.jpg);}
    .service-listrow{    padding: 20px 0 0 0;}
    .service-listrow h2{    font-size: 20px;}
    .service-listrow h6{    font-size: 14px;}
    .service-listrow .service-cont p{line-height: 25px;}
    .service-listrow .service-cont .btn-2{line-height: 25px;float:right;}
    .service-listrow .service-img{height:150px;width:100%;display:inline-block;text-align:center;margin-bottom:10px;}
    .service-listrow .service-img img{float:none;}
    .service-listrow .service-img1,.service-listrow .service-img3{margin-top:0;}
    .othr-page-head h3{font-size: 30px;}
    .main-menu{margin: 10px 15px 0 0;}
    .navbar-collapse{width: 200px;background: #41474c;box-shadow: 3px 3px 5px #00000061;position: absolute;
                     right: 0px;
                     top: 34px;}
    .main-menu ul li a{color: #ffffff;}
    #mbl-menu.fa-times:before{content: "\f00d"!important;}
    .banner-content{margin-top: 36px;}
    .services::before{
        border-left: 520px solid transparent;
        border-right: 105px solid transparent;
        border-bottom: 25px solid #eef8f5;
    }
    .hme-servblock h2{font-size:20px;margin: 10px 0;}
    .banner-area .banner-content h1 {
        font-size: 21px;
    line-height: 28px;
    width: 50%;padding: 0;
    }
    .about-area .about-item h3 {
        font-size: 30px;
        line-height: 30px;
        padding-bottom: 0px;
        padding-top: 5px;
    }
    .banner-area{
        height:250px;
    }
    .banner-content ul{
        display: none;
    }
    p{
        font-size: 14px;
        line-height: 25px;
    }
    .more-btn{
        padding: 0 20px;
        font-size: 14px;
        line-height: 40px;
    }
    .about-area .about-item p {
        margin-bottom: 10px;
    }
    .serv-img{float: left;border-radius: 0!important;text-align: center!important;background-image: none!important;padding: 10px 0px;}
    .serv-img img{height: auto;max-width: 100%;}
    .serv-cards2 .serv-cont{float: right;text-align: left;}
    .serv-cards2 .serv-cont h4{margin: 10px 0 20px 0;}
    .serv-cards2 .serv-cont h4::after{right: 0;left: 0;}
    .serv-cards h4::after{    width: 150px;}
    .create-steps{padding: 30px 0 80px 0;}
    .create-steps h2{    font-size: 15px;}
    .steps-cards{padding: 15px 20px 10px 20px;}
    .steps-cards p{height: auto;}
    .needquote-area::before{bottom: 99%;}
    .needquote-area p{display:none;}
    .needquote-area h5{line-height: 30px;}
    /*    .serv-abt span{
            font-size: 15px;
        }
        .serv-abt h3{
            font-size: 23px;
        }
        .serv-abt h4{
            font-size: 18px;
        }
        .serv-abt li {
            font-size: 15px;
        }
        .serv-abt li i{
            width: 35px;
            height: 35px;
            line-height: 35px;    font-size: 20px;
        }
        .serv-abt li:hover i {
            background: transparent;
            color: #3c9e42;
        }*/
    /*    .b-list h3{
            font-size:18px;
        }*/
    /*    .list-item .shape{
            font-size:60px;
        }*/
    /*    .service_text h3 {
            font-size: 20px;
        }*/
    /*    .abt-list li .service_img {
            margin-left: 0;
            width: 60px;
            height: 60px;
            line-height: 60px;padding: 18px 16px;
        }
        .abt-list li .service_img i {
            font-size: 30px;
        }*/
    footer h4{
        font-size:18px;margin-bottom: 15px;
    }
    .h-tf {
        height: auto;
        margin-bottom: 15px;
    }
    .other-page-banner h1{font-size:35px;}
    .other-page-banner h2{font-size: 30px;}
    .othr-page-head span{margin:0;}
    .about-us h3 {font-size: 25px;}
    /*    .abt-list {
            padding: 10px 0;
        }*/
    .c-form h3 {
        font-size: 20px;
    }
    .contact_text h3{
        font-size:18px;
    }
    .service_ic i{
        line-height: 40px;
        width: 40px;
        height: 40px;font-size: 20px;    margin-right: 15px;
    }
    .contact_text span{
        font-size:14px;
    }
    .blogdet-blk .blogd-img{height: 200px;}
    .blogdet-blk p{line-height: 23px;
    text-align: justify;}
    .privacyrow .bulletlist, .privacyrow ul{margin: 0;}
}
@media only screen and (max-width: 480px) {
    .serv-cards2 .serv-cont h4::after{left:0;}
    .serv-cards1 .serv-cont h4::after{left:0;}
    .f-small{
        width:100%;
    }
    .other-page-banner {
        height: 150px;
    }
    .logo img{
        height:40px;
    }
    .other-page-banner h2 {
        font-size: 30px;
    }
    .service_ic, .service_img{
        display: none; 
    }
    /*    .service_text {
            padding-left: 0;
        }*/
    /*    .list-item{
            margin-bottom: 15px;
        }*/
    .about-area .about-item h3 {
        font-size: 20px;
    }
    .banner-area .banner-content h1 {
        font-size: 21px;
    line-height: 28px;
    width: 50%;
    }
    .banner-area .banner-content>span {
        font-size: 18px;
    }

}