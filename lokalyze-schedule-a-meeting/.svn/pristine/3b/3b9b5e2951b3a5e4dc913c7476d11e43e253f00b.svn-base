.service-listrow{padding:50px 0 0 0;}
.serv-row-even{background:#eef8f5;}
.service-listrow .service-img{
    /*margin:80px 0;height:160px;position:relative;text-align: center;*/
    
}
/*.service-listrow .service-img2{margin-right:100px;}*/
