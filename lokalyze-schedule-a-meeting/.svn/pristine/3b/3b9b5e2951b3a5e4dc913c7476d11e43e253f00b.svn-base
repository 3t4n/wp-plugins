@import url('https://fonts.googleapis.com/css2?family=Quicksand&display=swap');
*{
    font-family: 'Quicksand', sans-serif;
}
.banner-area{
    height: 600px;
    background: #a9c7ec;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
}
table.form-table.lsamnew {
    background: hsl(0, 0%, 99%) none repeat scroll 0 0;
    border: 1px solid hsl(0, 0%, 80%);
    width: 100%;
}
table.form-table.lsamnew tr:first-child th {
    background: #d8d8d8;
}
table.form-table.lsamnew th {
    font-weight: 600 !important;
    padding: 15px !important;
    text-align: left !important;
    vertical-align: middle !important;
    width: 25% !important;
}
table.form-table.lsamnew th {
    font-weight: 600 !important;
    padding: 15px !important;
    text-align: left !important;
    vertical-align: middle !important;
    width: 25% !important;
}
table.form-table.lsamnew td {
    font-weight: 600 !important;
    padding: 15px !important;
    text-align: left !important;
    vertical-align: middle !important;
    width: 75% !important;
}
.banner-area::before {
    position: absolute;
    content: '';
    height: 100%;
    width: 100%;
    background-image: url(../images/banner-gradient-bg.png);
    top: 0;
    left: 0;
    background-size: cover;
    background-position: center center;
}
header{position:relative;}
.header{
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    background-color: transparent;
    z-index: 99; padding: 10px 0;
}
.header-fix{
    position: fixed;    box-shadow: 0 5px 5px 0 rgba(0,0,0,.04);
    background: #fff;    z-index: 10;
    left: 0;
    right: 0;    height: 80px
}
.header .logo{position: relative;height: 65px;}
.header .logo a{display: block;}
.header .logo a img{
        position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    max-width: 100%;
    max-height: 100%;
    margin: auto;
}
.main-menu{
    margin: 0; float: right;
}
.main-menu ul li a{
    font-size: 16px;
    padding: 0 30px;
    color: #4f79a9;
    font-weight: bold;
    text-transform: uppercase;
    position: relative;
    -webkit-transition: all .3s ease-out 0s;
    -moz-transition: all .3s ease-out 0s;
    -ms-transition: all .3s ease-out 0s;
    -o-transition: all .3s ease-out 0s;
    transition: all .3s ease-out 0s;
    margin: 0;
    line-height: 50px;
}
.banner-area .banner-content>span {
    font-size: 20px;
    color: #69a1bb;
}
.banner-area .banner-content h1 {
    font-size: 80px;
    line-height: 85px;
    padding-top: 18px;
    padding-bottom: 34px; font-family: bold;
    color:#0774db;
}
.banner-area .banner-content ul li {
    display: inline-block;
    margin-right: 75px;
}
.icn-round {
    height: 80px;
    width: 80px;
    border-radius: 50%;
    background: #fff;
    text-align: center;
    line-height: 73px;
    margin-right: 30px;
    box-shadow: 0 8px 16px 0 rgba(0,109,232,.1);
    position: relative;
    border: 4px solid transparent;
    border-top-color: #ff4f74;
    border-bottom-color: #ff4f74; display: inline-block;
}
.icn-round::before {
    position: absolute;
    content: '';
    height: 5px;
    width: 5px;
    border-radius: 50%;
    left: -5px;
    top: 50%;
    transform: translateY(-50%);
    background: #ff4f74;
}
.icn-round::after {
    position: absolute;
    content: '';
    height: 5px;
    width: 5px;
    border-radius: 50%;
    right: -5px;
    top: 50%;
    transform: translateY(-50%);
    background: #ff4f74;
}
.banner-area .banner-content ul li a p {
    display: inline-block;
    font-size: 24px;
    color: #232323;
    font-weight: 700;
}
.icn-round i {
    height: 60px;
    width: 60px;
    border-radius: 50%;
    background: #f5faff;
    line-height: 60px;
    color: #ff4f74;font-size: 20px;
}
.banner-area .banner-content ul li a.btn-22 .icn-round {
    border-top-color: #0774db;
    border-bottom-color: #0774db;
}
.banner-area .banner-content ul li a.btn-22 .icn-round::before, .banner-area .banner-content ul li a.btn-22 .icn-round::after {
    background: #0774db;
}
.banner-area .banner-content ul li a.btn-22 .icn-round i {
    color: #0774db;
}
.banner-area .banner-shape {
    position: absolute;
    right: -70px;
    bottom: -222px;
    height: 630px;
    width: 630px;
    background: #f3faff;
    border-radius: 50%;
    border: 60px solid #ebf4ff;
    z-index: 1;
}
.banner-area .banner-shape img {
    position: absolute;
    left: 0;
}
.about-area .about-thumb {
    position: relative;
    z-index: 5;
}
.about-area .about-thumb img{
    max-width: 100%; height:500px;
}
.about-area .about-thumb::before {
    position: absolute;
    content: '';
    height: 500px;
    width: 500px;
    border: 80px solid #0774db;
    transform: rotate(45deg);
    background: #fff;
    z-index: -1;
    left: -70px;
    top: -10px;    box-shadow: -30px -30px 0 #fff;
}
.about-area .about-item>span {
    color: #0774db;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase; padding-left: 5px;
}
.about-area .about-item h3 {
    font-size: 60px;
    line-height: 70px; margin-top: 0;
    padding-top: 18px;
    padding-bottom: 36px; color: #0774db; font-family: bold;
}
.about-area .about-item p {
    margin-bottom: 50px;
}
.more-btn{
    display: inline-block;
    text-align: center;
    vertical-align: middle;
    border: 2px solid #0774db;
    padding: 0 55px;
    font-size: 16px;
    line-height: 60px;
    color: #fff !important;
    cursor: pointer;
    z-index: 5;
    -webkit-transition: all .4s ease-out 0s;
    -moz-transition: all .4s ease-out 0s;
    -ms-transition: all .4s ease-out 0s;
    -o-transition: all .4s ease-out 0s;
    transition: all .4s ease-out 0s;
    background-color: #0774db;
}

/*-----------Homepage -servics-----------*/
.services{
    margin-top: 150px; width: 100%; float: left;
    background:#eef8f5;
    padding: 50px 0;  position:relative; 
}
.services::before{
    content:'';
    position:absolute;
    right: 0;
    bottom: 100%;
    width: 0;
    height: 0;
    border-left: 995px solid transparent;
    border-right: 192px solid transparent;
    border-bottom: 100px solid #eef8f5;
}
.hme-servblock h2{
    color: #0774db;
    font-weight: 700;
    letter-spacing: 2px;
    font-size: 44px;
    margin: 20px 0;text-transform: uppercase;
}
.hme-servblock p{margin-bottom: 30px;}
.serv-cards{
    margin:20px 0;
}
.serv-cards h4{margin:25px 0 20px 0;position:relative;}
.serv-cards a{
    color: #2f2f2f;
    font-weight: 700;
    font-size: 18px;
}
.serv-cards h4::after{
    content:'';
    position:absolute;bottom: -10px;
    width:234px;
    height: 3px;
    background: #fff;
}
.serv-cards p{
    margin-bottom: 30px;
    color: #000;
    font-size: 16px;margin-bottom:5px;
    line-height: 24px;
}
.serv-img{
    background: #fff;
    padding: 20px 50px;
}
.serv-img img{height:150px;}
.serv-cards1 .serv-cont{text-align:left;}
.serv-cards2 .serv-cont{text-align: right;}
.serv-cards1 .serv-cont h4::after{left:-25px;}
.serv-cards2 .serv-cont h4::after{right:-25px;}
.serv-cards1 .serv-img{border-radius: 0 50px 50px 0;text-align: right;background-image: linear-gradient(to right, #eef8f5 , #fff);}
.serv-cards2 .serv-img{border-radius:50px 0 0 50px;text-align: left;background-image: linear-gradient(to left, #eef8f5 , #fff);}
