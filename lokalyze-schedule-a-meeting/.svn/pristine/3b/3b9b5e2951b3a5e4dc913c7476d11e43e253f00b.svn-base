max-height:60%;margin:auto;max-width:6100%;width:auto!important;}
/*-------------------service detail ---------*/
.service-detrow{padding:20px 0;}
/*-------------------Create steps-------------*/
.create-steps{
    background: url('../images/bg-needquote.jpg');
    padding: 100px 0 200px 0;
    width: 100%; float: left;position: relative;
}
.create-overlay {
    background-color: #0a76dbb0;
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 100%;
}
.create-cont{z-index:1;position: relative;}
.create-steps h2{color: #fff;
                 font-weight: 700;
                 letter-spacing: 2px;
                 font-size: 40px;
                 margin:0 0 20px 0;
                 text-transform: uppercase;}
.create-steps p{margin-bottom:50px;color: #ffffffbd;}
.steps-cards{position: relative;padding: 50px 20px 30px 20px;}
.steps-cards img{height:45px;filter: grayscale(1);}
.create-steps .icn-round{line-height: 80px;height:90px;width:90px;margin:auto;background:#fff;border: 5px solid transparent;border-bottom-color:#ff8ca4;border-top-color:#ff8ca4;}
.create-steps .icn-round::before,.create-steps .icn-round::after{background:#ff8ca4;}
.steps-cards h4{color: #fff;
                font-family: 'bold';
                margin: 30px 0 20px 0;}
.steps-cards p{color: #e2e2e2;
               margin-bottom:0px;
               font-size: 14px;
               line-height: 24px;    height: 70px;
               overflow: hidden;}
.steps-cards::after{
    content: '';position:absolute;
    top:85px;
    right: -50px;
    width: 100px;
    height: 31px;
    border-top: 3px dotted #ffffffad;
    border-radius: 63%;    z-index: 1;
}
.step1{background: #0a59a0;}
.step2{background: #0262b7;}
.step3{background: #066dc7;}
.step4{background: #0a76db;}
/*.step1::before{content: '1';}
.step2::before{content: '2';}
.step3::before{content: '3';}
.step4::before{content: '4';}*/
.step4::after{display: none;}
/*-------------------Need Quote------------*/
.needquote-area{
    background:#fff;
    padding: 50px 0;
    width: 100%; float: left;position: relative;
}
.needquote-area::before{
    content:'';
    position:absolute;
    right: 0;
    bottom: 100%;
    width: 0;
    height: 0;
    border-left: 995px solid transparent;
    border-right: 192px solid transparent;
    border-bottom: 100px solid #fff;
}
.needquote-area h3{
    display:inline-block;
    padding: 0 0 8px;
    transition: all .2s ease-in-out;
    font-family: bold;
    color: #0774db;
}
.needquote-area p{
    color: #666;
    font-size: 14px;
    border-bottom: 1px solid #ccc;
    display: inline-block;
    margin: 0px 0 26px 0;
}
.needquote-area h5{
    color: #000;font-size: 18px;
}
.needquote-area img{
    position: absolute;
    top: -100px;
    right: 90px;
    opacity: 0.6;-webkit-transform: scaleX(-1);
    transform: scaleX(-1);
}
.needquote-area h5 span{color: #222;font-weight: bold;}
