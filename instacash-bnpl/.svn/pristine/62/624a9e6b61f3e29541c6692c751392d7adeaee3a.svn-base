includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
parameters:
    level: max
    inferPrivatePropertyTypeFromConstructor: true
    paths:
        - %currentWorkingDirectory%/
    excludePaths:
        - %currentWorkingDirectory%/vendor/
        - %currentWorkingDirectory%/vendor-instacash/
        # - %currentWorkingDirectory%/extends/
    bootstrapFiles:
        - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
    ignoreErrors:
        # Woocommerce functions.
        # - '#^Function (WC|wc_get_logger|wc_get_order) not found\.$#'
        # Template included to WC_Payment_Gateway.
        # - '#^Variable \$(this|request|status) might not be defined\.$#'
        # - '#^Cannot access property (\$offerId|\$offerName) on mixed\.$#'
        - '#^Access to an undefined property WC_Cart::\$total\.$#'
        - '#^Variable \$[a-zA-Z0-9\\_]+ might not be defined\.$#'
