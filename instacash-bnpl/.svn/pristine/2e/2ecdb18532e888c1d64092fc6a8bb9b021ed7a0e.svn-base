msgid "Content"
msgstr "Obsah"

#: extends/InstaCashElementorProductPrescore.php:50
msgid "Product prescore"
msgstr "Predskóre produktu"

#: src/Conditions.php:57
msgid "Cart total"
msgstr "Košík celkom"

#: src/Conditions.php:67 src/Config.php:394
msgid "Allowed Countries"
msgstr "Povolené krajiny"

#: src/Conditions.php:71 src/Config.php:403
msgid "Disallowed categories"
msgstr "Nepovolené kategórie"

#: src/Conditions.php:74 src/Config.php:424
msgid "Disallow discounts"
msgstr "Zakázať zľavy"

#: src/Conditions.php:77 src/Config.php:435
msgid "Disallow backorder"
msgstr "Zakázať spätné objednanie"

#: src/Conditions.php:80 src/Config.php:446
msgid "Disallow companies"
msgstr "Zakázanie spoločností"

#: src/Conditions.php:83 src/Config.php:457
msgid "Disallow accountless"
msgstr "Zakázať bezúčtovosť"

#: src/Config.php:84
msgid "Webhook URL for BNPL System"
msgstr "Adresa URL webhooku pre systém BNPL"

#: src/Config.php:88
msgid ""
"For status change notifications, you must enter this URL under the webhook "
"heading on the merchant portal."
msgstr ""
"V prípade oznámení o zmene stavu musíte túto adresu URL zadať v položke "
"webhook na portáli obchodníka."

#: src/Config.php:96
msgid "Title"
msgstr "Názov"

#: src/Config.php:98
msgid "This controls the title which the user sees during checkout."
msgstr "Týmto sa riadi názov, ktorý používateľ vidí pri pokladni."

#: src/Config.php:99
msgid "InstaCash"
msgstr "InstaCash"

#: src/Config.php:103
msgid "Description"
msgstr "Popis"

#: src/Config.php:106
msgid "This controls the description which the user sees during checkout."
msgstr "Týmto sa riadi opis, ktorý používateľ vidí počas pokladnice."

#: src/Config.php:107
msgid "Apply for a loan and pay in installments"
msgstr "Požiadajte o pôžičku a splácajte ju v splátkach"

#: src/Config.php:111
msgid "Test mode"
msgstr "Testovací režim"

#: src/Config.php:114 src/Config.php:178 src/Config.php:427 src/Config.php:438
#: src/Config.php:449 src/Config.php:460
msgid "Enabled"
msgstr "Povolené"

#: src/Config.php:115 src/Config.php:179 src/Config.php:204 src/Config.php:428
#: src/Config.php:439 src/Config.php:450 src/Config.php:461
msgid "Disabled"
msgstr "Bezbariérový"

#: src/Config.php:118
msgid "Redirects requests to test urls like barion sandbox."
msgstr "Presmeruje požiadavky na testovacie URL ako barion sandbox."

#: src/Config.php:122
msgid "API Key"
msgstr "Kľúč API"

#: src/Config.php:124
msgid "A unique alphanumeric string that identifies the service"
msgstr "Jedinečný alfanumerický reťazec, ktorý identifikuje službu"

#: src/Config.php:129
msgid "Merchant Identifier"
msgstr "Identifikátor obchodníka"

#: src/Config.php:131
msgid "The merchant´s unique identifier in the InstaCash system"
msgstr "Jedinečný identifikátor obchodníka v systéme InstaCash"

#: src/Config.php:136
msgid "BNPL Identifier"
msgstr "Identifikátor BNPL"

#: src/Config.php:138
msgid ""
"An alphanumeric string that identifies the service route. Copy of merchant "
"portal setting."
msgstr ""
"Alfanumerický reťazec, ktorý identifikuje trasu služby. Kópia nastavenia "
"obchodného portálu."

#: src/Config.php:143
msgid "Pending status"
msgstr "Stav v štádiu čakania"

#: src/Config.php:146
msgid "Select the \"wait for payment\" status"
msgstr "Vyberte stav \"čakať na platbu\""

#: src/Config.php:151
msgid "Started status"
msgstr "Začatý stav"

#: src/Config.php:154
msgid "Select the \"first installment payed\" status"
msgstr "Vyberte stav \"prvá splátka uhradená\""

#: src/Config.php:159
msgid "Completed Status"
msgstr "Ukončený stav"

#: src/Config.php:162
msgid "Select the \"all installment payed\" status"
msgstr "Vyberte stav \"všetky splátky zaplatené\""

#: src/Config.php:167
msgid "Interrupted Status"
msgstr "Prerušený stav"

#: src/Config.php:170
msgid "Select the \"interrupted from the API\" status"
msgstr "Vyberte stav \"prerušené z API\""

#: src/Config.php:175
msgid "Enable remaining amount notification"
msgstr "Povolenie oznámenia o zostávajúcej sume"

#: src/Config.php:182
msgid ""
"Notification of how much amount is missing so that installment payments are "
"available."
msgstr "Oznámenie o výške chýbajúcej sumy, aby boli k dispozícii splátky."

#: src/Config.php:186
msgid "Details URL"
msgstr "Podrobnosti URL"

#: src/Config.php:188
msgid "Link to the BNPL description, if one has been prepared."
msgstr "Odkaz na opis BNPL, ak bol vypracovaný."

#: src/Config.php:193
msgid "Info description"
msgstr "Informačný popis"

#: src/Config.php:196
msgid ""
"A description can be added to the remaining amount notification information "
"logo."
msgstr "K informačnému logu o zostávajúcej sume je možné pridať popis."

#: src/Config.php:201
msgid "Debug mode"
msgstr "Režim ladenia"

#: src/Config.php:205
msgid "Base (log any action)"
msgstr "Základňa (zaznamenajte akúkoľvek akciu)"

#: src/Config.php:206
msgid "Full (log event contents too)"
msgstr "Úplný (aj obsah udalostí denníka)"

#: src/Config.php:208
msgid "Select the debug level"
msgstr "Výber úrovne ladenia"

#: src/Config.php:213
msgid "BNPL Styles"
msgstr "Štýly BNPL"

#: src/Config.php:215
msgid "Add Custom styles to displaying BNPL solution elements"
msgstr "Pridanie vlastných štýlov na zobrazenie prvkov riešenia BNPL"

#: src/Config.php:218
msgid "Primary color"
msgstr "Základná farba"

#: src/Config.php:220
msgid "Background color of prescore button etc."
msgstr "Farba pozadia tlačidla predvoľby atď."

#: src/Config.php:225
msgid "Secondary color"
msgstr "Sekundárna farba"

#: src/Config.php:227
msgid "Background color of highlighted text and progress circle"
msgstr "Farba pozadia zvýrazneného textu a kruhu postupu"

#: src/Config.php:232
msgid "Button label color"
msgstr "Farba štítku tlačidla"

#: src/Config.php:234
msgid "Label color of prescore button"
msgstr "Farba štítku tlačidla prescore"

#: src/Config.php:239
msgid "Text color"
msgstr "Farba textu"

#: src/Config.php:241
msgid "Text color of prescore title and others"
msgstr "Farba textu názvu predskupiny a ďalších"

#: src/Config.php:246
msgid "Border rounding"
msgstr "Zaoblenie hraníc"

#: src/Config.php:248
msgid "Number of pixels to rounding the block edges"
msgstr "Počet pixelov na zaoblenie okrajov bloku"

#: src/Config.php:253
msgid "USP icons title"
msgstr "Ikony USP názov"

#: src/Config.php:255
msgid "Title above USP icons."
msgstr "Názov nad ikonami USP."

#: src/Config.php:260
msgid "Receipt icon title"
msgstr "Názov ikony príjmu"

#: src/Config.php:262 src/Config.php:276 src/Config.php:290
msgid "Title of an USP icon."
msgstr "Názov ikony USP."

#: src/Config.php:267
msgid "Receipt icon description"
msgstr "Popis ikony príjmu"

#: src/Config.php:269 src/Config.php:283 src/Config.php:297
msgid "Description of an USP icon."
msgstr "Popis ikony USP."

#: src/Config.php:274
msgid "Clock icon title"
msgstr "Názov ikony hodín"

#: src/Config.php:281
msgid "Clock icon description"
msgstr "Popis ikony hodín"

#: src/Config.php:288
msgid "Automatic icon title"
msgstr "Automatický názov ikony"

#: src/Config.php:295
msgid "Automatic icon description"
msgstr "Automatický popis ikony"

#: src/Config.php:302
msgid "Product page options"
msgstr "Možnosti stránky produktu"

#: src/Config.php:304
msgid ""
"When using Elementor, blocks must be placed on product pages using the "
"builder."
msgstr ""
"Pri použití nástroja Elementor je potrebné umiestniť bloky na stránky "
"produktov pomocou nástroja Builder."

#: src/Config.php:307
msgid "Calculation place"
msgstr "Miesto výpočtu"

#: src/Config.php:310 src/Config.php:325
msgid "Don`t show up"
msgstr "Don`t show up"

#: src/Config.php:311 src/Config.php:326
msgid "Product summary"
msgstr "Zhrnutie produktu"

#: src/Config.php:312 src/Config.php:327
msgid "Before add to cart form"
msgstr "Pred pridaním do košíka"

#: src/Config.php:313 src/Config.php:328
msgid "Before add to cart button"
msgstr "Pred tlačidlom pridať do košíka"

#: src/Config.php:314 src/Config.php:329
msgid "After add to cart form"
msgstr "Po pridaní do košíka"

#: src/Config.php:315 src/Config.php:330
msgid "Before meta"
msgstr "Pred meta"

#: src/Config.php:317
msgid "Select where to appear a calculation for product price"
msgstr "Vyberte, kde sa má zobraziť výpočet ceny produktu"

#: src/Config.php:322
msgid "Prescore place"
msgstr "Predsunuté miesto"

#: src/Config.php:332
msgid "Select where to appear a prescore box"
msgstr "Vyberte miesto, kde sa má zobraziť pole predvýberu"

#: src/Config.php:337
msgid "Prescore title"
msgstr "Názov Prescore"

#: src/Config.php:339
msgid "Title of the displayed prescore block"
msgstr "Názov zobrazeného bloku prescore"

#: src/Config.php:344
msgid "Prescore description"
msgstr "Popis Prescore"

#: src/Config.php:346
msgid "Description to the displayed prescore block"
msgstr "Popis k zobrazenému bloku prescore"

#: src/Config.php:351
msgid "Short usp items"
msgstr "Krátke položky usp"

#: src/Config.php:353
msgid "Mini USP blocks on Product calculation"
msgstr "Mini bloky USP na výpočet produktu"

#: src/Config.php:379
msgid "BNPL Offers"
msgstr "Ponuky BNPL"

#: src/Config.php:397
msgid "All available countries"
msgstr "Všetky dostupné krajiny"

#: src/Config.php:398
msgid "Countries for which installment payments are permitted."
msgstr "Krajiny, pre ktoré sú povolené splátky."

#: src/Config.php:407
msgid ""
"Categories in which you cannot pay in installments with the products in the "
"cart"
msgstr ""
"Kategórie, v ktorých nie je možné platiť na splátky s produktmi v košíku"

#: src/Config.php:412
msgid "Minimum cart total"
msgstr "Minimálny celkový objem vozíka"

#: src/Config.php:414
msgid "Minimum amount that can be paid in installments."
msgstr "Minimálna suma, ktorú možno zaplatiť v splátkach."

#: src/Config.php:418
msgid "Maximum cart total"
msgstr "Maximálny celkový počet vozíkov"

#: src/Config.php:420
msgid "Maximum amount that can still be paid in installments."
msgstr "Maximálna suma, ktorú možno ešte zaplatiť v splátkach."

#: src/Config.php:431
msgid "Disabling installment payments for discount products"
msgstr "Zakázanie splátok pre zľavnené produkty"

#: src/Config.php:442
msgid "Disabling installment payments for products in backorder"
msgstr "Zakázanie splátkových platieb za produkty v backorderi"

#: src/Config.php:453
msgid "Disabling installment payments for company purchases"
msgstr "Zakázanie splátok pre firemné nákupy"

#: src/Config.php:464
msgid "Disabling installment payments for customers who have not logged in"
msgstr "Zakázanie splátok pre zákazníkov, ktorí sa neprihlásili"

#: src/Config.php:480 src/Config.php:534
msgid "Purchase created"
msgstr "Vytvorený nákup"

#: src/Config.php:481
msgid "A purchase has been made in the BNPL system"
msgstr "V systéme BNPL bol uskutočnený nákup"

#: src/Config.php:486 src/Config.php:570
msgid "Purchase cancelled"
msgstr "Nákup zrušený"

#: src/Config.php:487 src/Config.php:571
msgid "Payment process terminated"
msgstr "Ukončenie platobného procesu"

#: src/Config.php:492
msgid "Initial installment paid"
msgstr "Zaplatená počiatočná splátka"

#: src/Config.php:493
msgid "The customer has paid the initial installment"
msgstr "Zákazník zaplatil počiatočnú splátku"

#: src/Config.php:498
msgid "Next installment paid"
msgstr "Ďalšia zaplatená splátka"

#: src/Config.php:499
msgid "The customer has paid the next installment"
msgstr "Zákazník zaplatil ďalšiu splátku"

#: src/Config.php:504
msgid "Transaction delayed"
msgstr "Oneskorenie transakcie"

#: src/Config.php:505
msgid "The customer is late in paying the next installment."
msgstr "Zákazník sa omeškal s úhradou ďalšej splátky."

#: src/Config.php:510
msgid "Purchase completed"
msgstr "Nákup dokončený"

#: src/Config.php:511
msgid "Customer has paid the remaining installments."
msgstr "Zákazník zaplatil zostávajúce splátky."

#: src/Config.php:516
msgid "Purchase interrupted"
msgstr "Nákup prerušený"

#: src/Config.php:517
msgid "The customer interrupted the installment payment."
msgstr "Zákazník prerušil splácanie splátky."

#: src/Config.php:535
msgid "A purchase has been made in the Instacash system"
msgstr "V systéme Instacash bol uskutočnený nákup"

#: src/Config.php:540
msgid "Purchase linked to customer"
msgstr "Nákup spojený so zákazníkom"

#: src/Config.php:541
msgid "Customer has logged into their account"
msgstr "Zákazník sa prihlásil do svojho účtu"

#: src/Config.php:546
msgid "Loan application started"
msgstr "Začala sa žiadosť o pôžičku"

#: src/Config.php:547
msgid "The customer has started the loan application"
msgstr "Zákazník začal žiadosť o úver"

#: src/Config.php:552
msgid "Loan application under review"
msgstr "Žiadosť o pôžičku v procese posudzovania"

#: src/Config.php:553
msgid ""
"The bank is now checking whether the requested loan amount can be granted "
"based on the customer´s data"
msgstr ""
"Banka teraz preveruje, či je možné požadovanú sumu úveru poskytnúť na "
"základe údajov klienta"

#: src/Config.php:558
msgid "Loan application approved"
msgstr "Schválenie žiadosti o pôžičku"

#: src/Config.php:559
msgid "The loan is being disbursed"
msgstr "Úver sa vypláca"

#: src/Config.php:564
msgid "Purchase revoked"
msgstr "Zrušenie nákupu"

#: src/Config.php:565
msgid "Loan application has been revoked"
msgstr "Žiadosť o pôžičku bola zrušená"

#: src/Config.php:576
msgid "Loan application rejected"
msgstr "Zamietnutie žiadosti o pôžičku"

#: src/Config.php:577
msgid "Unsuccessful Loan Application"
msgstr "Neúspešná žiadosť o pôžičku"

#: src/Config.php:582
msgid "Amount transferred"
msgstr "Prevedená suma"

#: src/Config.php:583
msgid "The bank disbursed the amount"
msgstr "Banka vyplatila sumu"

#: src/Config.php:588
msgid "Payment Completed"
msgstr "Ukončená platba"

#: src/Config.php:589
msgid "Payment was confirmed by the merchant"
msgstr "Platba bola potvrdená obchodníkom"

#: src/Config.php:603
msgid "No disallowed category"
msgstr "Žiadna zakázaná kategória"

#: src/Events.php:99 template/productCalculation.php:24
msgid "Installment payment"
msgstr "Splátky"

#: src/Events.php:147
msgid "You already have a pending order."
msgstr "Už máte nevybavenú objednávku."

#: src/Events.php:149
msgid "Orders"
msgstr "Objednávky"

#: src/Events.php:228
msgid "Paid"
msgstr "Platené"

#: src/Helper.php:39
msgid "Currency"
msgstr "Mena"

#: src/Helper.php:51 template/calculator.php:56
msgid "Down payment"
msgstr "Zálohová platba"

#: src/Helper.php:55
msgid "Rate"
msgstr "Hodnotenie"

#: src/Helper.php:59 template/calculator.php:64
msgid "Installments"
msgstr "Splátky"

#: src/Helper.php:63
msgid "Lateness fee"
msgstr "Poplatok za oneskorenie"

#. Translators: 1$ down payment amount 2$ is count of payments %3$s is installment amount.
#: src/Helper.php:197
msgid ""
"The down payment %1$s, then pay <strong>%2$d</strong> times <strong>%3$s</"
"strong>."
msgstr ""
"Zálohová platba %1$s potom zaplatíte <strong>%2$d</strong> krát "
"<strong>%3$s</strong>."

#: template/admin/boxContent.php:19
msgid "Status"
msgstr "Stav"

#: template/admin/boxContent.php:23 template/admin/filterSelect.php:20
msgid "Paid transactions"
msgstr "Zaplatené transakcie"

#: template/admin/boxContent.php:24
msgid "Unpaid transactions"
msgstr "Nezaplatené transakcie"

#: template/admin/boxContent.php:26
msgid "Merchant Portal"
msgstr "Merchant Portal"

#: template/admin/boxNotice.php:18
msgid "Order status changed by payment status."
msgstr "Stav objednávky zmenený podľa stavu platby."

#: template/admin/onboardNotice.php:24
msgid "Thank you for choosing the InstaCash`s payment solution!"
msgstr "Ďakujeme, že ste si vybrali platobné riešenie InstaCash!"

#: template/admin/onboardNotice.php:27
msgid "Easy installment payments! Boost sales in your webshop."
msgstr ""
"Zjednodušené platenie na splátky! Roztočte predaj vo svojom internetovom "
"obchode."

#: template/admin/onboardNotice.php:28
msgid ""
"You can acquire new customers and encourage your existing customers to buy "
"again with installment payments that can be customized to your own brand of "
"instacash."
msgstr ""
"S vlastnou značkovou splátkovou službou instacash môžete prilákať nových "
"zákazníkov a povzbudiť existujúcich zákazníkov k ďalšiemu nákupu."

#: template/admin/onboardNotice.php:29
msgid "Feel free to contact us regarding the data required to use the module!"
msgstr ""
"Neváhajte nás kontaktovať ohľadom údajov potrebných na používanie modulu!"

#: template/admin/onboardNotice.php:34
msgid "More info"
msgstr "Viac info"

#: template/admin/optionsPage.php:19
msgid "Return to payments"
msgstr "Návrat k platbám"

#: template/admin/optionsPage.php:28
msgid "Sync data with servers to getting offers."
msgstr "Synchronizácia údajov so servermi na získanie ponúk."

#: template/admin/optionsPage.php:30
msgid "Sync available BNPL offers"
msgstr "Synchronizácia dostupných ponúk BNPL"

#: template/admin/overlapNotice.php:19
msgid "The conditions of the offer overlap! Matches:"
msgstr "Podmienky ponuky sa prekrývajú! Zápasy:"

