msgid "Pay in"
msgstr "Zaplatiť v"

#: template/calculator.php:32
msgid "pieces"
msgstr "splátkach"

#: template/calculator.php:45 template/productCalculation.php:97
msgid "APR"
msgstr "RPMN"

#: template/calculator.php:72
msgid "Monthly repayment"
msgstr "Mesačná splátka"

#: template/calculator.php:80 template/productCalculation.php:117
msgid "Total Repayment"
msgstr "Celková splátka"

#: template/calculator.php:103 template/productCalculation.php:68
#: template/productCalculation.php:77
msgid "At the moment of purchase"
msgstr "V čase nákupu"

#: template/calculator.php:149
msgid "Besides"
msgstr "Okrem toho"

#: template/productCalculation.php:41
msgid "Installment payment information"
msgstr "Informácie o platbe na splátky"

#: template/productCalculation.php:53
msgid "Installment summary"
msgstr "Súhrn splátok"

#: template/productCalculation.php:59
msgid "Offer details"
msgstr "Podrobnosti ponuky"

#: template/productCalculation.php:60
msgid " until"
msgstr " do"

#: template/productCalculation.php:107
msgid "Service fee"
msgstr "Poplatok za službu"

#: template/productPrescore.php:24
msgid "Start prescore"
msgstr "Skúsme to!"

#. Translators: %s as the remaining amount for bnpl.
#: template/remaining.php:20
msgid "For installment payments %s needed."
msgstr "Na splátky je potrebných %s."

#: template/remaining.php:32
msgid "Details"
msgstr "Podrobnosti"

#~ msgid ""
#~ "Thank you for installing the payment solution of instacash, so the "
#~ "digital installment payment solution will help you to reduce cart "
#~ "abandonment and increase the average cart length."
#~ msgstr ""
#~ "Ďakujeme, že ste si nainštalovali platobné riešenie instacash, takže vám "
#~ "digitálne splátkové platobné riešenie pomôže znížiť počet opustených "
#~ "košíkov a zvýšiť priemernú dĺžku košíka."

#~ msgid "If you haven´t signed up for our service yet, click"
#~ msgstr "Ak ste sa ešte nezaregistrovali do našej služby, kliknite na"

#~ msgid "here"
#~ msgstr "tu"

#~ msgid ""
#~ ", to go through the validation completely online, without a personal "
