#. Plugin Name of the plugin
msgid "InstaCash BNPL"
msgstr "InstaCash BNPL"

#. Plugin URI of the plugin
msgid "https://instacash.hu/"
msgstr "https://instacash.hu/"

#. Description of the plugin
msgid "Buy Now Pay Later solution for woocommerce checkout."
msgstr "Kúpiť teraz Zaplať neskôr riešenie pre woocommerce pokladňu."

#. Author of the plugin
msgid "Fintrous Group Kft."
msgstr "Fintrous Group Kft."

#. Author URI of the plugin
msgid "https://fintrous.com"
msgstr "https://fintrous.com"

#: extends/InstaCashBNPLApplication.php:102
msgid "InstaCashBNPL"
msgstr "InstaCashBNPL"

#: extends/InstaCashBNPLApplication.php:103
msgid "Apply for a loan through InstaCash"
msgstr "Požiadajte o pôžičku cez InstaCash"

#: extends/InstaCashBNPLApplication.php:371
msgid "The app is not responding, please try again later"
msgstr "Aplikácia nereaguje, skúste to prosím neskôr"

#: extends/InstaCashBNPLApplication.php:397
msgid "No available offers"
msgstr "Žiadne dostupné ponuky"

#: extends/InstaCashBNPLApplication.php:450 src/Events.php:171
msgid "Payment Status"
msgstr "Stav platby"

#: extends/InstaCashBNPLApplication.php:464
#: extends/InstaCashBNPLApplication.php:471
msgid "No Status"
msgstr "Žiadny stav"

#: extends/InstaCashBNPLApplication.php:521
msgid "Options synchronized!"
msgstr "Možnosti synchronizované!"

#: extends/InstaCashBNPLApplication.php:542
msgid "BNPL Check: No offers!"
msgstr "BNPL Check: Žiadne ponuky!"

#: extends/InstaCashBNPLApplication.php:550
msgid "BNPL Check: Sync required!"
msgstr "Kontrola BNPL: Vyžaduje sa synchronizácia!"

#: extends/InstaCashBNPLApplication.php:877
msgid "There are no offers to show for the specified quantity"
msgstr "Pre zadané množstvo nie sú k dispozícii žiadne ponuky"

#: extends/InstaCashElementorProductCalculation.php:50
msgid "Product calculation"
msgstr "Výpočet produktu"

