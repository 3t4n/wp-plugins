{"version":3,"file":"./style-index.css","mappings":";;;AAAA;;;;;EAAA;AAoCA;EAEI,uDAJkB;AA1BtB;AAgCI;EACI,uCAjCS;EAkCT,yCAjCU;EAkCV,qCA9BQ;EA+BR,8BA7BK;EA8BL,uCA5BS;EA6BT,6CA3BY;EA4BZ,yCA1BU;EA2BV,2CAzBW;EA0BX,yCAvBU;EAwBV,+CAtBa;EAuBb,2CArBW;EAsBX,6CApBY;AAVpB;AAiCI;EACI,8CA9CgB;EA+ChB,gDA9CiB;EA+CjB,4CA5Ce;EA6Cf,qCA3CY;EA4CZ,8CA1CgB;EA2ChB,oDAzCmB;EA0CnB,gDAxCiB;EAyCjB,kDAvCkB;EAwClB,+DAvCwB;EAwCxB,gDAtCiB;EAuCjB,sDArCoB;EAsCpB,kDApCkB;EAqClB,oDAnCmB;AAI3B;AAmCQ;EACI;AAjCZ;AAsCQ;EADJ;IAEQ;EAnCV;AACF;AAuCQ;EADJ;IAEQ,uDAnDU;EAepB;AACF,C","sources":["webpack://description-list-block/./src/style.scss"],"sourcesContent":["/**\n * The following styles get applied both on the front of your site\n * and in the editor.\n *\n * Replace them with your own styles or remove the file completely.\n */\n\n\n$termsFontStyle: var(--termsFontStyle, none);\n$termsFontWeight: var(--termsFontWeight, none);\n$descriptionsFontStyle: var(--descriptionsFontStyle, none);\n$descriptionsFontWeight: var(--descriptionsFontWeight, none);\n\n$termsFontSize: var(--termsFontSize, none);\n$descriptionsFontSize: var(--descriptionsFontSize, none);\n$termsColor: var(--termsColor, none);\n$descriptionsColor: var(--descriptionsColor, none);\n$termsMarginTop: var(--termsMarginTop, none);\n$descriptionsMarginTop: var(--descriptionsMarginTop, none);\n$termsMarginBottom: var(--termsMarginBottom, none);\n$descriptionsMarginBottom: var(--descriptionsMarginBottom, none);\n$termsMarginLeft: var(--termsMarginLeft, none);\n$descriptionsMarginLeft: var(--descriptionsMarginLeft, none);\n$termsMarginRight: var(--termsMarginRight, none);\n$descriptionsMarginRight: var(--descriptionsMarginRight, none);\n$descriptionsMarginInlineStart: var(--descriptionsMarginInlineStart, none);\n$termsPaddingTop: var(--termsPaddingTop, none);\n$descriptionsPaddingTop: var(--descriptionsPaddingTop, none);\n$termsPaddingBottom: var(--termsPaddingBottom, none);\n$descriptionsPaddingBottom: var(--descriptionsPaddingBottom, none);\n$termsPaddingLeft: var(--termsPaddingLeft, none);\n$descriptionsPaddingLeft: var(--descriptionsPaddingLeft, none);\n$termsPaddingRight: var(--termsPaddingRight, none);\n$descriptionsPaddingRight: var(--descriptionsPaddingRight, none);\n$gridTemplateColumns: var(--gridTemplateColumns, none);\n\ndl.wp-block-description-list-block-description-list {\n\n    grid-template-columns: $gridTemplateColumns;\n\n    dt {\n        font-style: $termsFontStyle;\n        font-weight: $termsFontWeight;\n        font-size: $termsFontSize;\n        color: $termsColor;\n        margin-top: $termsMarginTop;\n        margin-bottom: $termsMarginBottom;\n        margin-left: $termsMarginLeft;\n        margin-right: $termsMarginRight;\n        padding-top: $termsPaddingTop;\n        padding-bottom: $termsPaddingBottom;\n        padding-left: $termsPaddingLeft;\n        padding-right: $termsPaddingRight;\n    }\n\n    dd {\n        font-style: $descriptionsFontStyle;\n        font-weight: $descriptionsFontWeight;\n        font-size: $descriptionsFontSize;\n        color: $descriptionsColor;\n        margin-top: $descriptionsMarginTop;\n        margin-bottom: $descriptionsMarginBottom;\n        margin-left: $descriptionsMarginLeft;\n        margin-right: $descriptionsMarginRight;\n        margin-inline-start: $descriptionsMarginInlineStart;\n        padding-top: $descriptionsPaddingTop;\n        padding-bottom: $descriptionsPaddingBottom;\n        padding-left: $descriptionsPaddingLeft;\n        padding-right: $descriptionsPaddingRight;\n    }\n\n    &.is-style-regular {\n        dt {\n            float: unset;\n        }\n    }\n\n    &.is-style-grid {\n        @media only screen and (min-width: 480px) {\n            display: grid;\n        }\n    }\n\n    &.is-style-grid {\n        @media only screen and (min-width: 320px) {\n            grid-template-columns: $gridTemplateColumns;\n        }\n    }\n}\n"],"names":[],"sourceRoot":""}