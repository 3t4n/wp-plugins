<?php

/**
 * Debug class.
 *
 * @since 1.1.1
 */
final class Embed_Extended_Debug {
	/**
	 * Singleton pattern instance.
	 *
	 * @var Embed_Extended_Debug
	 */
	private static $instance = null;

	/**
	 * Singleton pattern method.
	 *
	 * @return Embed_Extended_Debug
	 */
	public static function instance() {
		if (null === self::$instance) {
			self::$instance = new self();
		}
		return self::$instance;
	}

	/**
	 * Default constructor.
	 */
	public function __construct() {
		// Adds debug tab on settings page.
		if (defined('EMBED_EXTENDED_DEBUG') && EMBED_EXTENDED_DEBUG) {
			add_filter('embed_extended_admin_settings_tabs', [$this, 'settings_tabs'], 100);
		}

		// Disables default providers.
		if (
			defined('EMBED_EXTENDED_OEMBED_DEFAULT_PROVIDERS') &&
			!EMBED_EXTENDED_OEMBED_DEFAULT_PROVIDERS
		) {
			add_filter('oembed_providers', '__return_empty_array', 100);
			add_filter('load_default_embeds', '__return_false', 100);
		}

		// Disables oEmbed discovery.
		if (defined('EMBED_EXTENDED_OEMBED_DISCOVER') && !EMBED_EXTENDED_OEMBED_DISCOVER) {
			add_filter('embed_oembed_discover', '__return_false', 100);
		}

		// Changes oEmbed transient expiration time (in seconds).
		if (defined('EMBED_EXTENDED_OEMBED_TTL') && (int) EMBED_EXTENDED_OEMBED_TTL) {
			add_filter('oembed_ttl', [$this, 'oembed_ttl'], 100);
			add_filter('rest_oembed_ttl', [$this, 'oembed_ttl'], 100);
		}
	}

	/**
	 * Add debug tab on settings page.
	 *
	 * @param array $tabs
	 * @return array
	 */
	public function settings_tabs($tabs = []) {
		$tabs['debug'] = __('Debug', 'embed-extended');

		return $tabs;
	}

	/**
	 * Return int 1.
	 *
	 * @param number $ttl
	 * @return number
	 */
	public function oembed_ttl($ttl) {
		if (defined('EMBED_EXTENDED_OEMBED_TTL') && (int) EMBED_EXTENDED_OEMBED_TTL) {
			$ttl = (int) EMBED_EXTENDED_OEMBED_TTL;
		}

		return $ttl;
	}

	/**
	 * Clear embed cache and transients.
	 *
	 * @param string|array $storage
	 */
	public function clear_cache($storage = ['meta', 'transient']) {
		global $wpdb;

		if (!is_array($storage)) {
			$storage = [$storage];
		}

		Embed_Extended_Fetcher::instance();

		/**
		 * Filters cache patterns generated by this plugin.
		 *
		 * @since 1.3.0
		 *
		 * @param array $patterns
		 */
		$patterns = apply_filters('embed_extended_cache_patterns', [
			'ee-iframe',
			'ee-card',
			'{{unknown}}',
		]);

		// Build regex pattern.
		function embed_extended_cache_pattern_callback($pattern) {
			return preg_quote($pattern, '/');
		}
		$patterns = array_map('embed_extended_cache_pattern_callback', $patterns);
		$patterns = '/(' . implode('|', $patterns) . ')/';

		// Clear embed cache in the post meta.
		if (in_array('meta', $storage)) {
			$cache_sql = "SELECT post_id, meta_key FROM $wpdb->postmeta WHERE meta_key LIKE '%_oembed_%'";
			$cache = $wpdb->get_results($cache_sql);

			if (!empty($cache)) {
				foreach ($cache as $cache_item) {
					$post_id = $cache_item->post_id;
					$meta_key = $cache_item->meta_key;

					// Skip embed cache TTL entry.
					if (0 === strpos($meta_key, '_oembed_time_')) {
						continue;
					}

					// Only clear embed cache generated by this plugin.
					$html = get_post_meta($post_id, $meta_key, true);
					if (is_string($html) && preg_match($patterns, $html)) {
						// Delete both embed cache and its TTL entry.
						delete_post_meta($post_id, $meta_key);
						delete_post_meta(
							$post_id,
							str_replace('_oembed_', '_oembed_time_', $meta_key)
						);
					}
				}
			}
		}

		// Clear embed transients.
		if (in_array('transient', $storage)) {
			$transients_sql = "SELECT option_name FROM $wpdb->options WHERE option_name LIKE '%_transient_oembed_%' OR option_name LIKE '%_transient_embed_extended_%'";
			$transients = $wpdb->get_col($transients_sql);

			if (!empty($transients)) {
				foreach ($transients as $transient) {
					$transient = str_replace('_transient_', '', $transient);

					// Clear embed result transient.
					if (0 === strpos($transient, 'embed_extended_')) {
						delete_transient($transient);
						continue;
					}

					// Only clear embed transient generated by this plugin.
					$data = get_transient($transient);
					$html = is_object($data) && isset($data->html) ? $data->html : null;
					if (is_string($html) && preg_match($patterns, $html)) {
						delete_transient($transient);
					}
				}
			}
		}
	}
}

function Embed_Extended_Debug() {
	return Embed_Extended_Debug::instance();
}
