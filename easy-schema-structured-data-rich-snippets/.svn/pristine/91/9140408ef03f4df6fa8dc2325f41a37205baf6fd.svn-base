            <td>
               <label class="switch" for="checkbox_sl_activate">
               <input type="checkbox" name="sl_search_active" id="checkbox_sl_activate" value="1" <?php checked( '1', esc_attr( get_option( 'sl_search_active' ) ) ); ?> />
               <div class="slider round"></div>
               <label>
            </td>
         </tr>
      </table>
      </div>
