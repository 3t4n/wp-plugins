      <div class="sitelinks_top_split_left">
                <div class="es_sitelinks_form_wrapper">
      <h3 class="sitelinks-title">Sitelinks search box schema settings</h3>
      <div class="es_sitelinks_form">
      <table class="form-table">
         <tr>
            <th scope="row" class="th-subhead"><?php esc_html_e('Website URL:', 'schema-set') ?></th>
            <td><input type="text" name="sl_search_web_url" style="width:100%;" value="<?php echo esc_attr( $sl_search_web_url ); ?>" placeholder="<?php esc_attr_e('Enter your website url', 'schema-set')?>"></td>
         </tr>
         <tr>
            <th scope="row" class="th-subhead"><?php esc_html_e('Search Box URL:', 'schema-set') ?>
            <div class="help-tip searchBox">
            <div class="help-tooltip-special-div search_box">
                <div class="container-price-range">
                     <span class="price-range-explain"><strong class="pricerange-strong">Search box URL explained:</strong> This is the URL that your website uses when visitors search for a query using your search box facility. Commonly WordPress websites will use the URL 'www.yourwebsite.co.uk/?s=' for search queries.</span>
                     <span class="price-range-explain">How to check your search box URL:</span>
                     <ul class="list-do-pr">
                        <li><span>1)</span> Go to a page that has your search box</li>
                        <li><span>2)</span> Use the search box without putting any information in the bar and press search</li>
                        <li><span>3)</span> Copy the URL which your website displays</li>
                     </ul>
               </div>
                </div>
            </div>
            </th>
            <td><input type="text" name="sl_search_url" style="width:100%;" value="<?php echo esc_attr( $sl_search_url ); ?>" placeholder="<?php esc_attr_e('Enter your website search box query string', 'schema-set')?>"></td>
         </tr>
      </table>
      <div class="sitelinks_display_options">
      <h3 class="opening-hours-title">Display Options</h3>
      <table class="form-table">
