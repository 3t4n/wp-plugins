.essdrs_metabox_content {
    background: #F5F7FF;
    min-height: 900px;
    padding: 25px;
    border-radius: 12px;
}
.essdrs_post_metabox_split_columns {
    width: 100%;
    height: 100%;
}
.essdrs_post_split_column_left {
    float: left;
    background: #112e76;
    min-height: 660px;
    width: 260px;
    display: block;
    margin-right: 20px;
    border-radius: 12px;
    padding-top: 25px;
    padding-bottom: 25px;
    max-width: 260px;
}
.essdrs_post_split_column_right {
    width: 55%;
    float: left;
}
.essdrs_metabox_tab_heading {
    width: auto;
    display: block;
}
.essdrs_tab_heading {
    padding: 14px 16px;
    cursor: pointer;
    border-radius: 5px;
    text-align: left;
    margin: 5px 25px;
    color: #fff;
    font-size: 14px;
}
.essdrs_metabox_main_tab {
    background: #f5f7ff;
    padding: 0;
    min-height: 400px;
    max-height: 870px;
}
.essdrs_tab_heading_span {
    position: relative;
    display: inline-flex;
}
.essdrs_metabox_main_tab_singular {
    padding: 15px;
    width: 100%;
    background: #fff;
    border-radius: 12px;
    text-align: left;
    box-shadow: 0 0 20px 5px rgb(0 0 0 / 5%);
    overflow-y: scroll;
    overflow-x: hidden;
    max-height: 840px;
}
.essdrs_tab_heading.active {
    background: #00adff;
    font-weight: 700;
    box-shadow: rgb(0 0 0 / 5%) 0px 20px 27px 0px;
}
.es_tab_arrow_right {
    float: right;
    margin-right: -5px;
}
.essdrs_custom_schema_form_heading {
    font-size: 18px;
    font-weight: 700;
    color: #000;
    margin-bottom: 25px;
    margin-top: 10px;
}
.essdrs_custom_schema_form {
    width: 100%;
}
.essdrs-options.essdrs_schema_option {
    font-size: 16px;
    margin-bottom: 30px;
    color: #76838f;
}
.essdrs_schema_option_input {
    float: right;
    width: 350px;
    height: 35px;
    font-size: 14px;
    color: #202124 !important;
    cursor: pointer;
    border-radius: 6px !important;
    border: 1px solid #eee !important;
    box-shadow: 0px 2px 5px 0px rgb(155 155 155 / 30%) !important;
}
.essdrs_schema_option_checkbox {
    float: right;
}
.essdrs_custom_schema_form_wrapper {
    margin-left: 20px;
    margin-right: 20px;
}
.es_schema_pro_icon {
    margin-left: 10px;
}
.es_schema_pro_symbol {
    background: #ff7601;
    padding: 2px 7.5px 2px 7.5px;
    font-weight: 700;
    font-size: 12px;
    border-radius: 12px;
}
.essdrs_tab_heading:hover {
    background: #00adff;
}
.essdrs_schema_option_input.essdrs_schema_option_extended {
    height: 90px;
}
.essdrs-options.essdrs_schema_option.essdrs_schema_option_extended {
    height: 100px;
}
.switch {
  display: inline-block;
  height: 34px;
  position: relative;
  width: 60px;
}
.switch input {
  display:none;
}
.slider {
  background-color: #ccc;
  bottom: 0;
  cursor: pointer;
  left: 0;
  position: absolute;
  right: 0;
  top: 0;
  transition: .4s;
}
.slider:before {
  background-color: #fff;
  bottom: 4px;
  content: "";
  height: 26px;
  left: 4px;
  position: absolute;
  transition: .4s;
  width: 26px;
}
input:checked + .slider {
  background-color: #00adff;
}
input:checked + .slider:before {
  transform: translateX(26px);
}
.slider.round {
  border-radius: 34px;
}
.slider.round:before {
  border-radius: 50%;
}
.essdrs_options_slider_split {
    width: 100%;
    display: inline-flex;
}
.essdrs_options_slider_split_left {
    width: 50%;
}
.essdrs_options_slider_split_right {
    margin-top: 10px;
    margin-left: 5%;
}
.essdrs_options_switch_label {
    font-size: 16px;
    color: #76838f;
}
#essdrs_video_duration_seconds,
#essdrs_video_duration_minutes, 
#essdrs_recipe_servingsize,
#essdrs_recipe_calories {
    width: 175px;
}
.essdrs_recipe_schema_multi_option_left_label,
.essdrs_events_schema_multi_option_left_label {
    float: left;
    width: 50%;
}
.essdrs_recipe_schema_multi_option_right_options,
.essdrs_events_schema_multi_option_right_options {
    float: right;
    width: 50%;
}
.essdrs_schema_option_input.multistep_stacked {
    margin-bottom: 20px;
}
.essdrs-options.essdrs_schema_option.essdrs_recipe_step_multiform {
    height: 200px;
}
.essdrs-options.essdrs_schema_option.essdrs_events_step_multiform {
    height: 275px;
}
.getting_started_intro_banner {
    background: #0d2e80;
    padding: 20px 15px 5px 15px;
    border-radius: 12px;
    box-shadow: 0 0 20px 5px rgb(75 73 172 / 15%);
}
.started-span {
    font-size: 24px;
    font-weight: 600;
    color: #FFF;
}
.getting_started_tagline {
    font-size: 16px;
    color: #ffffff;
    font-weight: 400;
    padding: 15px 0 15px 0;
    margin: 0;
}
.getting_started_flex_Boxes {
    display: inline-flex;
}
.getting_started_featured_left {
    width: 50%;
    background: #fff;
    padding: 0 15px 16px 15px;
    border-radius: 12px;
    margin-top: 20px;
    margin-right: 10px;
    box-shadow: 0 0 20px 5px rgb(0 0 0 / 5%);
}
.getting_started_featured_right {
    width: 50%;
    background: #fff;
    padding: 0 15px 16px 15px;
    border-radius: 12px;
    margin-top: 20px;
    margin-left: 10px;
    box-shadow: 0 0 20px 5px rgb(0 0 0 / 5%);
    height: 25%;
}
.schema_types_title {
    font-weight: 600;
    color: #444;
    font-size: 18px;
}
.schema_type_list_1 {
    background: #f5f7ff;
    padding: 18px 15px 18px 20px;
}
.schema_type_list_2 {
    background: #fff;
    padding: 18px 15px 18px 20px;
}
.schema_name {
    color: #212529;
    font-size: 14px;
    font-weight: 400;
}
.schema_status {
    float: right;
    margin-right: 15px;
    margin-top: -5px;
}
.schema_status.schema_not_active {
    color: #fff;
    border-radius: 20px;
    font-size: 14px;
    background: #112e76;
    padding: 5px 10px;
}
.schema_status.schema_active {
    color: #fff;
    border-radius: 20px;
    font-size: 14px;
    background: #ff7601;
    padding: 5px 10px;
}
.getting_started_setup_title {
    font-weight: 600;
    color: #444;
    font-size: 18px;
    margin: 18px 0 0 0;
}
.getting-started-intro {
    font-size: 14px;
    color: #444;
    font-weight: 400;
    padding: 12px 0 12px 0;
    margin: 0;
}
.essdrs_metabox_main_tab_singular.post_getting_started {
    width: 145%;
    background: #fff;
    overflow-y: auto;
}
.essdrs_settings_message {
    border: 1px solid #eee;
    padding: 5px 15px 5px 15px;
    background: #fff;
    color: #000;
    width: 50%;
}
.essdrs_settings_message_text {
    font-size: 14px;
    font-weight: 400;
}