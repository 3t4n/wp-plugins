#: customize-external-links-form.php:17
msgid ""
"<em>Domain name <strong>must be</strong> comma(,) separated. <code>http://</"
"code> or <code>https://</code><br /><code>rel=\"nofollow\"</code> will not "
"added to \"Exclude Domains\"</em>"
msgstr ""
"<em>Domains <strong>müssen</strong> Komma(,) getrennt eingegeben werden. "
"<code>http://</code> oder <code>https://</code><br /><code>rel=\"nofollow"
"\"</code> wird nicht zu \"exkludierten Domains\" hinzugefügt</em>"

#: customize-external-links-form.php:24
msgid "dsgdggdgdg"
msgstr ""

#: customize-external-links-form.php:67
msgid "(recommened)"
msgstr "(empfohlen)"

#: customize-external-links.php:343
msgid "Main Settings"
msgstr "Einstellungen"

#: customize-external-links.php:344
msgid "Add External Links Settings to Menu"
msgstr "Berücksichtige Einstellungen für Links in der Menü-Leiste"

#: customize-external-links.php:345
msgid "Exclude Domains"
msgstr "Exkludiere Domains"

#: customize-external-links.php:346
msgid "Add Nofollow to External Links"
msgstr "Füge Nofollow  zu externen Links hinzu"

#: customize-external-links.php:347
msgid "Add Noreferrer to External Links"
msgstr "Füge Noreferrer  zu externen Links hinzu"

#: customize-external-links.php:348
msgid "Icon Settings"
msgstr "Icon Einstellungen"

#: customize-external-links.php:349
msgid "Select Icon to indicate External Links"
msgstr "Icon auswählen, um externen Link zu markieren"

#: customize-external-links.php:350
msgid "Superscript Icon"
msgstr "Icon hochstellen"

#: customize-external-links.php:351
msgid "Add additional CSS Class (span) for Icon"
msgstr "Zusätzlliche CSS Klasse um das Icon herum"

#: customize-external-links.php:357
msgid "Set link relation for nofollow and noreferrer."
msgstr "Link-Beziehungen zu Nofollow und Noreferrer."

#: customize-external-links.php:363
msgid "Set icon indication for external links."
msgstr "Icon hinzufügen um externe Links erkennbar zu machen."

#: customize-external-links.php:372
msgid "External Link Settings"
msgstr "Externe Links Einstellungen"

#: customize-external-links.php:373
msgid "Customize Link attributes and Link indication based on your needs."
msgstr "Passe Linkattribute und externe Link-Erkennung an."

#: customizer-external-links-initiate.php:32
msgid "Settings"
msgstr "Einstellungen"

