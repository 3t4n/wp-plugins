msgid "https://mlm-soft.com"
msgstr "https://mlm-soft.com"

msgid "MLM Soft Integration"
msgstr "Интеграция MLM Soft"

msgid "MLM Soft Ltd."
msgstr "MLM Soft Ltd."

msgid "Sponsor ID"
msgstr "ID Спонсора"

msgid "Invite code"
msgstr "Реферальный код"

msgid "WP integration with mlm-soft.com cloud platform"
msgstr "Интеграция WP с облачной платформой mlm-soft.com"

msgid "MLM Soft E-Wallet"
msgstr "MLM Soft E-Wallet"

msgid "Payment from MLM Soft e-wallet balance"
msgstr "Оплата с баланса электронного кошелька MLM Soft"

msgid "Pay with bonuses. Coupon {{couponCode}}"
msgstr "Оплата бонусами. Купон {{couponCode}}"

msgid "Cancel payment. Coupon {{couponCode}}"
msgstr "Отмена покупки. Купон {{couponCode}}"

msgid "Title"
msgstr "Название"

msgid "Name of payment method"
msgstr "Название платежного метода"

msgid "Description"
msgstr "Описание"

msgid "Description of payment method"
msgstr "Описание метода оплаты"

msgid "This payment system is not meant for direct payments."
msgstr "Выбранная платежная система не предназначена для прямых платежей"

msgid "Payment from an e-wallet"
msgstr "Оплата с бонусного счета"

msgid "Coupon cannot be returned (Old version)"
msgstr "Купон не может быть возвращен (Старая версия)"

msgid "Cannot return a used coupon"
msgstr "Нельзя вернуть использованный купон"

msgid "Coupon is not connected to the e-wallet"
msgstr "Купон не присоединен к электронному кошельку"

msgid "EWallet info"
msgstr "Электронный кошелек"

msgid "Wallet operation type ID is not defined"
msgstr "Тип операции не определен"

msgid "Account ID not found"
msgstr "ID Аккаунта не найден"

msgid "Request validation error (required fields)"
msgstr "Ошибка валидации запроса (обязательные поля)"

msgid "Request validation error (internal digest)"
msgstr "Ошибка валидации запроса (Внутренняя подпись)"

msgid "Request validation error (digest)"
msgstr "Ошибка валидации запроса (подпись)"

msgid "Request validation error (time)"
msgstr "Ошибка валидации запроса (время)"

msgid "Session not found"
msgstr "Сессия не найдена"

msgid "The coupon was not created correctly"
msgstr "Купон не был создан корректно"

msgid "Method not exists"
msgstr "Метод не существует"

msgid "Handler not found"
msgstr "Обработчик не найден"

msgid "response body is not defined"
msgstr "Тело ответа не определено"

msgid "Document {{documentId}} not processed"
msgstr "Документ {{documentId}} не обработан"

msgid "Response is empty"
msgstr "Пустой ответ"

msgid "Response not recognized: {{response}}"
msgstr "Ответ не распознан: {{response}}"

msgid "Payment with bonuses from an e-wallet"
msgstr "Оплата бонусами с электронного кошелька"

msgid "Opportunity presented by: {{fullName}}"
msgstr "Возможность представлена: {{fullName}}"

msgid ""
"Cannot find any sponsor with this sponsor referral code in the database."
msgstr ""
"В базе данных не удалось найти ни одного спонсора с таким реферальным кодом."

msgid "Sponsor with this id doesn't exists."
msgstr "Спонсор с таким ID не найден"

msgid "Internal error. Can not create user"
msgstr "Внутренняя ошибка. Невозможно создать пользователя"

msgid "Online office"
msgstr "Онлайн офис"

msgid "Logout"
msgstr "Выход"

msgid "Register"
msgstr "Регистрация"

msgid "Sign In"
msgstr "Логин"

msgid "Coupon not found"
msgstr "Купон не найден"

msgid "Amount must be less than {{maxAmount}}"
msgstr "Сумма должна быть меньше {{maxAmount}}"

msgid "Account ID not found in the coupon (old version)"
msgstr "ID аккаунта не найден в купоне (старая версия)"

msgid "Warehouse"
msgstr "Склад"

msgid "Pay from e-wallet - {{couponCode}}"
msgstr "Оплата с электронного кошелька - {{couponCode}}"

msgid "Payment from {{couponCode}} created successfully"
msgstr "Оплата с помощью {{couponCode}} создана успешно"

msgid "Pos order created. Document id: {{documentId}}"
msgstr "Заказ в POS создан успешно. ID документа: {{documentId}}"

msgid "You should %1sEnable coupons%2s to start using"
msgstr "Для использования нужно %1sВключить купоны%2s"

msgid "Payment from bonus wallet"
msgstr "Оплата с бонусного кошелька"

msgid "Please select the wallet"
msgstr "Пожалуйста, выберите кошелёк"

msgid "Balance"
msgstr "Баланс"
