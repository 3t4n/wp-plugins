#alt-magic-settings-table {
    color: #111827;
}

#alt-magic-settings-table th {
    width: 330px !important;
    padding-block: 30px;
    padding-inline: 10px;
    color: #4f545c;
}

#alt-magic-settings-table select {
    width: 400px !important;
    border: none !important;
    padding-inline: 8px;
    padding-block: 4px;
}

.alt-magic-setting-label {
    padding-block: 6px !important;
    color: #111827;
}

#alt-magic-settings-table input[type="text"] {
    margin-right: 12px;
    margin-bottom: 12px;
    width: 300px !important;
    border: none !important;
    padding-inline: 8px;
    padding-block: 4px;
}

#alt-magic-settings-table input[type="checkbox"] {
    margin-right: 12px;

}

.alt-magic-setting-sub-label {
    margin-left: 32px;
    font-size: 13px;
    color: #8b8b8b;
    margin-top: 4px;
    width: 400px;
}

.alt-magic-setting-sub-notice {

    font-size: 14px !important;
    color: #8b8b8b !important;
    margin-top: 20px !important;
    width: 400px;
}

.loading-text {
    margin-left: 300px;
    margin-top: 40px;
}

.ai-settings-container {
    margin-top: 24px;
    padding: 12px;
    border-radius: 4px;
    border: 1px solid #ccc;
    background-color: #f6f6f6;

}

.account-settings-container {
    margin-top: 24px;
    padding: 12px;
    border-radius: 4px;
    border: 1px solid #ccc;
    background-color: #f6f6f6;
}

.account-settings-container h2 {
    margin: 0 !important;
}

.remove-api-key-button {
    border: none;
    background: none;
    cursor: pointer;
    text-decoration: underline;
    color: #f44336;
    padding: 0px;
}

.credits-available-text {
    margin: 0;
    color: green;
    background-color: #e6f2ea;
    padding: 4px;
    border-radius: 4px;
    width: fit-content;
}

.profile-picture {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    margin-right: 14px;
}