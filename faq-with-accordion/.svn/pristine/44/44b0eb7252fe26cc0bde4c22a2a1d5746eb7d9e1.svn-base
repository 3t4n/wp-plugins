/* Admin CSS Starts */

 .faq_page_faq_support_page .faq-ed-accordion {
        background-color: #0f75dc;
        color: #fff;
        cursor: pointer;
        padding: 18px;
        width: 100%;
        border: none;
        text-align: left;
        outline: none;
        font-size: 15px;
        transition: 0.4s;
        margin-bottom: 20px;
        position: relative;
}
 .faq_page_faq_support_page .active, .faq-ed-accordion:hover {
         background-color: #06316d;
    }
 .faq_page_faq_support_page .faq-ed-accordion:after {
        content: '\002B';
        color: #fff;
        font-weight: bold;
        float: right;
        margin-left: 5px;
        font-size: 28px;
        line-height: normal;
        height: 20px;
        margin-top: 0;
        position: absolute;
        right: 10px;
        top: 5px;
    }
 .faq_page_faq_support_page .active:after {
        content: "\2212";
    }
 .faq_page_faq_support_page .panel {
        padding: 0 18px;
        display: none;
        background-color: light-grey;
        overflow: hidden;
    }
 .faq_page_faq_support_page .main-panel {
        width: 650px !important;
    }
 .faq_page_faq_support_page .support-panel {
        padding: 5px;
    }
 .faq_page_faq_support_page .dashicons-external {
        content: "\f504";
    }
 .faq_page_faq_support_page .dashicons-editor-help {
        content: "\f223";
    }
 .faq_page_faq_support_page  div.panel.show {
        display: block !important;
        background: #dcdfe2;
        margin-top: -15px;
        margin-bottom: 20px;
    }
/* Admin CSS Ends
* ------------------------------------------------------
*/