/*--------------- Pagination ---------------*/
.listing-pagination .pagenationBlock {
    border-radius: 10px;
    margin-top: 8px;
    padding: 16px 20px;
}
.listing-pagination .pagenationBlock .tableValuesNo {
    color: #757983;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
}
.listing-pagination .pagenationBlock .pagenationCount ul {
    gap: 8px;
}
.listing-pagination .historyPaginate {
    display: flex;
    justify-content: center;
    margin: 0;
    padding: 0;
}
.listing-pagination .historyPaginate li {
    list-style: none;
}
.listing-pagination .pagenationBlock .pagenationCount ul li:is(.previous,.next).disabled a {
    background: #ebebed;
    border: 1px solid #e6ebff;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    text-transform: uppercase;
	color:#757983;
}
.listing-pagination .pagenationBlock .pagenationCount ul li:is(:hover,.selected) a {
    background-color:#0039ff;
    border-color: #0039ff;
    color: #fff;
}
.listing-pagination .pagenationBlock .pagenationCount ul li a {
    align-items: center;
    border: 1px solid #ebebed;
    border-radius: 4px;
    color: #757983;
    font-weight: 400;
    height: 32px;
    justify-content: center;
    overflow: hidden;
    width: 32px;
}
.listing-pagination .historyPaginate li.selected a {
     border: 1px solid #00f; 
     color: #fff !important; 
}
.listing-pagination .historyPaginate li a {
    border: 1px solid #c2c2d3;
    margin-left: -1px;
    padding: .375rem .75rem;
    text-decoration: none;
}
.filterRedu .unwrap-tooltip, .filterRedu .wrap-tooltip {
    visibility: hidden;
    background-color: #333;
    color: #fff;
    text-align: center;
    border-radius: 4px;
    padding:4px 8px;
    z-index: 1;
    margin-left: -4px;
    opacity: 0;
    transition: opacity 0.3s;
    position: absolute;
    margin-top: 80px;
    font-size: 12px;
}
.filterRedu .unwrap-tooltip::after, .filterRedu .wrap-tooltip::after {
    content: "";
    position: absolute;
    top: -35%;
    left: 50%;
    margin-left: -5px;
    border-width: 5px;
    border-style: solid;
    border-color: transparent transparent #333 transparent;
}

.unwrap-text:hover .unwrap-tooltip, .wrap-text:hover .wrap-tooltip {
  visibility: visible;
  opacity: 1;
}
