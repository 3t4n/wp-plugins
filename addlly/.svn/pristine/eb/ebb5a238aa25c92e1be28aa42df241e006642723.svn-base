/* Statrt Toopltip Style */
[data-tooltip-id="addlly-tooltip"] {
    position: relative;
    display: inline-block;
    cursor: pointer;
    margin: 20px;
}
.addlly-tooltip-content {
    visibility: hidden;
    width: max-content;
    max-width: 360px;
    background-color: #000;
    color: #fff;
    text-align: center;
    padding: 8px;
    border-radius: 6px;
    position: absolute;
    z-index: 99999;
    opacity: 0;
    transition: opacity 0.3s;
}
[data-tooltip-id="addlly-tooltip"]:hover .addlly-tooltip-content {
    visibility: visible;
    opacity: 0.8;
}
.addlly-tooltip-content::before {
    content: '';
    position: absolute;
    border-style: solid;
}
.addlly-tooltip-top {
    bottom: 125%;
    left: 50%;
    transform: translateX(-50%);
}

.addlly-tooltip-top::before {
    top: 100%;
    left: 50%;
    border-width: 5px 5px 0 5px;
    border-color: #000 transparent transparent transparent;
    transform: translateX(-50%);
}
.addlly-tooltip-right {
    top: 50%;
    left: 125%;
    transform: translateY(-50%);
}
.addlly-tooltip-right::before {
    top: 50%;
    left: -5px;
    border-width: 5px 5px 5px 0;
    border-color: transparent #000 transparent transparent;
    transform: translateY(-50%);
}
.addlly-tooltip-bottom {
    top: 125%;
    left: 50%;
    transform: translateX(-50%);
}

.addlly-tooltip-bottom::before {
    bottom: 100%;
    left: 50%;
    border-width: 0 5px 5px 5px;
    border-color: transparent transparent #000 transparent;
    transform: translateX(-50%);
}
.addlly-tooltip-bottom-end {
    right: -40%;
    transform: translateY(15%);
}

.addlly-tooltip-bottom-end::before {
    bottom: 100%;
    right: 2%;
    border-width: 0 5px 5px 5px;
    border-color: transparent transparent #000 transparent;
    transform: translateX(-50%);
}
.addlly-tooltip-left {
    top: 50%;
    right: 125%;
    transform: translateY(-50%);
}
.addlly-tooltip-left::before {
    top: 50%;
    right: -5px;
    border-width: 5px 0 5px 5px;
    border-color: transparent transparent transparent #000;
    transform: translateY(-50%);
}
/* End Toopltip Style */

