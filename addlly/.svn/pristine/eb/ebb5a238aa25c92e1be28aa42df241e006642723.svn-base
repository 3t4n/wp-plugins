}
.text-center{
    text-align: center !important;
}
.text-start {
    text-align: left !important;
}


/* Fact checker Css */
.fact-checker-preview .url-wrapper {
    border-bottom: 1px solid #ebebed;
    margin-bottom:6px;
}

.fact-checker-preview .url-wrapper .link-content {
    color: #4d5156;
    cursor: default;
    display: block;
    text-decoration: none;
    width: fit-content;
}

.fact-checker-preview .url-wrapper .link-content .link-image {
    align-items: center;
    background: #c2c2d3;
    border-radius: 50px;
    display: flex;
    height: 32px;
    justify-content: center;
    margin-right: 12px;
    width: 32px;
}

.fact-checker-preview .url-wrapper .link-content .link-image svg {
    font-size: 20px;
}

.fact-checker-preview .url-wrapper .link-content .link-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 50px;
    overflow: hidden;
}

.fact-checker-preview .url-wrapper .link-content>div {
    cursor: pointer;
    width: fit-content;
}

.fact-checker-preview .url-wrapper .link-content>div:hover~h3 {
    text-decoration: underline;
}
.addlly-articles-holder .blog-writer-content-block .auto-fact-heading {
    font-size: 16px;
    margin-left: 28px;
    margin-bottom:0;
    font-weight: 600;
