}
.profile-page .accountCardContainer .accountCard .cardBody .historyTableBlock .tableBlock {
    background: #ebebed;
    border: 1px solid #ebebed;
    border-radius: 10px;
}
.tableRow {
    display: flex;
    align-items: center;
    align-self: stretch;
    border: 0;
    border-radius: 0;
    background-color: #fff;
}
.tableRow:hover {
    background-color: #fafafa;
}
.tableHead .tableRow{
    border-radius: 10px 10px 0px 0px;
}
.tableBody .tableRow:last-child{
    border-radius: 0px 0px 10px 10px;
}
.tableBody .tableRow{
    border-top: 1px solid #ebebed;
}
.tableColumn {
    flex: 1;
    padding: 10px 4px 10px 4px;
    align-items: center;
}
.tableHead .tableColumn {
    padding: 16px 4px 16px 4px;
}
.tableColumn p, .tableColumn>div{
    margin-bottom: 0px;
    padding-left: 16px;
    color: #757983;
    font-size: 14px;
    font-style: normal;
    font-weight: 500;
}
.tableBody .tableColumn p, .tableBody .tableColumn>div{
    color: #00061a;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
}
.tableColumn .debit-status {
    color: red;
    font-size: 14px;
    font-weight: 700;
    line-height: 100%;
}
.tableColumn .refund-button {
    align-items: center;
    background: #e6ebff;
    border: 0;
    border-radius: 5px;
    color: #0039ff;
    display: flex;
    font-size: 14px;
    gap: 8px;
    height: 37px;
    justify-content: center;
    padding: 0 15px;
}
.tableColumn .dotStatus{
    margin-right: 8px;
}

.refund-modal .maingenrateBlock {
    border-color: #ebebed;
    margin: 52px 0 48px;
    padding: 24px;
}
.maingenrateBlock .genrateFields .fields .addlly-textarea {
    border: 1px solid #ebebed;
    border-radius: 10px;
    font-size: 14px;
    font-style: normal;
    font-weight: 500;
    outline: 0;
    padding: 15px;
}
.addlly-primary:disabled {
    background: #bfc1c6;
    border: 1px solid #bfc1c6;
}
button:disabled {
    cursor: not-allowed;
}
.modal-backdrop.in{
    opacity: 0.5;
}
.maingenrateBlock .genrateFields .fields label .astrick {
    color: red;
    font-size: 16px;
}
.full-screen-btn {
    display: none !important;
}
@media (min-width: 576px) {
    .mb-sm-4 {
        margin-bottom: 1.5rem !important;
    }
    .mb-sm-3 {
        margin-bottom: 1rem !important;
    }
}
.tableColumn .title{
    width: 380px;
}
.tableColumn .title .desc{
    color: #757983;
    font-size: 14px;
    font-weight: 400;
    max-width: 300px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.tableColumn .title.showFullDes .desc{
    overflow: initial;
    text-overflow: clip;
    white-space: pre-line;
}
.tableColumn .popup button{
    background: #fff;
    border-radius: 50%;
    color: #000;
    height: 40px;
    max-width: 40px;
    min-width: 40px;
    width: 40px;
    border: 0px;
}
.tableColumn .popup button:hover{
    background-color: #ebebed !important;
}
.tableColumn .popup{
    position: relative;
}
.tableColumn .action-list{
    list-style: none;
    margin: 0px;
    padding: 0px;
    outline: 0px;
    min-width: 126px;
    color: rgb(55, 65, 81);
    box-shadow: rgb(255, 255, 255) 0px 0px 0px 0px, rgba(0, 0, 0, 0.05) 0px 0px 0px 1px, rgba(0, 0, 0, 0.1) 0px 10px 15px -3px, rgba(0, 0, 0, 0.05) 0px 4px 6px -2px;
    position: absolute;
    left: -100px;
    top:14px;
    border-radius: 6px;
    z-index: 999;
}
.tableColumn .action-list li{
    color: #00061a;
    display: flex;
    font-size: 12px;
    font-style: normal;
    font-weight: 500;
    gap: 8px;
    min-width: 126px;
    background-color: #fff;
    border-bottom: 1px solid #ebebed;
    margin: 0px;
}
.tableColumn .action-list li:first-child{
    border-radius: 6px 6px 0px 0px;
}
.tableColumn .action-list li:last-child{
    border-radius: 0px 0px 6px 6px;
}
.tableColumn .action-list li:hover{
    background-color: #ebebed !important;
}
.tableColumn .action-list li a{
    padding: 12px 15px;
    color: #00061a;
    text-decoration: none;
    width: 100%;
}
.tableColumn .action-list li a:focus{
    box-shadow: 0 0 0 0px #2271b1;
    outline: 0px;
}


