.offcanvas {
    background-clip: padding-box;
    background-color: #fff;
    bottom: 0;
    color: #212529;
    display: flex;
    flex-direction: column;
    max-width: 100%;
    outline: 0;
    position: fixed;
    transition: transform 0.3s ease-in-out;
    visibility: hidden;
    z-index: 1045;
}
.offcanvas {
    max-width: 400px;
    padding: 50px;
    width: 100% !important;
}
#previewArticleCanvas.offcanvas {
    max-width: 499px;
}
.offcanvas.offcanvas-end {
    right: 0;
    top: 0;
    transform: translateX(100%);
}
.offcanvas.show, .offcanvas.showing {
    visibility: visible;
}
.offcanvas.offcanvas-end {
    border: 0;
    transition: all .3s ease-out;
}
.offcanvas.show:not(.hiding), .offcanvas.showing {
    transform: none;
}

.offcanvas-header {
    align-items: center;
    display: flex;
}
.offcanvas .offcanvas-header {
    border-bottom: 1px solid #ebebed;
    padding: 0 0 32px;
}
.offcanvas-end .offcanvas-header {
    margin-bottom: 20px !important;
    padding-bottom: 20px !important;
}
.offcanvas-title {
    line-height: 1.5;
    margin-bottom: 0;
}
.offcanvas .offcanvas-header h5 {
    font-size: 18px;
}
.offcanvas-header .btn-close {
    margin: calc(1rem* -.5) calc(1rem* -.5) calc(1rem* -.5) auto;
    padding: calc(1rem* .5) calc(1rem* .5);
}
.blog-writer-content-block .offcanvas .offcanvas-body {
    flex-grow: 1;
    overflow-y: auto;
    padding: 0 15px 0 0;
}
.offcanvas .offcanvas-body .blogMetaInner:not(:last-child) {
    margin-bottom: 24px;
}
.offcanvas .offcanvas-body .blogMetaInner p {
    color: #575b68;
    font-size: 14px;
