    padding: 16px;
    border-radius: 5px;
}
.factChecker p {
    margin-bottom: 0;
}
/* End Fact checker css */

/* Google AD Copy css */
.editableTextArea {
      gap: 24px;
      max-width: 100%;
      transition: all .2s linear;
    }

    .editableTextArea:is(.googleAdCopy) .copy-textarea-btn {
      transform: translate(31px, -98px);
    }

    .editableTextArea .textEditerArea {
      background-color: #fafafa;
      padding: 24px;
      border-radius: 5px;
      flex: 0 0 49%;
      max-width: 49%;
      transition: all .2s linear;
    }

    .editableTextArea .textEditerArea .copy-textarea-btn {
      align-items: center;
      background: #fff;
      background-color: #e6ebff;
      border: 1px solid #96aeff;
      border-radius: 8px;
      box-shadow: none;
      color: #575b68;
      display: flex;
      gap: 8px;
      height: 32px;
      justify-content: center;
      position: absolute;
      top: 78px;
      right: 12px;
      width: 32px;
      z-index: 3;
    }

    .textEditerArea .custom-textarea-editor .innerTextcards:not(:last-child) {
      border-bottom: 1px solid #ebebed;
      margin-bottom: 25px;
    }

    .textEditerArea .custom-textarea-editor .innerTextcards p {
      font-size: 14px;
      font-style: normal;
      font-weight: 400;
      color: #575b68;
      margin-bottom: 0;
    }

    .textEditerArea .custom-textarea-editor .innerTextcards span {
      font-weight: 600;
      font-size: 14px;
      color: #00061a;
    }

    .textEditerArea.notContent {
      background-color: #fafafa;
      border-radius: 5px;
      padding: 15px;
    }

    .editableTextArea.f-50 .toggleData {
      background: linear-gradient(103deg, #0000ff0d, #ff00000d 121.74%);
      border-radius: 5px;
      padding: 25px;
      flex: 0 0 49%;
      overflow: initial;
      max-width: 49%;
    }

    .editableTextArea:is(.googleAdCopy) .google-add-review {
      color: #000929;
      font-size: 16px;
      font-weight: 600;
    }

    .preview-container {
      border-radius: 8px;
      height: 100%;
      padding: 16px;
    }

    .preview-container .desc-content {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      max-width: calc(100vw - 428px);
    }

    .editableTextArea:is(.googleAdCopy) .toggleData {
      background: linear-gradient(103deg, rgba(0, 0, 255, 0.05) 0%, rgba(255, 0, 0, 0.05) 121.74%);
      border-radius: 5px;
      padding: 25px;
    }

    .editableTextArea:is(.googleAdCopy) .toggleData .table-main .table-header {
      background: linear-gradient(103deg, rgba(0, 0, 255, 0.15) 0%, rgba(255, 0, 0, 0.15) 121.74%);
      padding: 6px 12px;
      border-radius: 8px;
    }

    .editableTextArea:is(.googleAdCopy) .toggleData .table-main .table-header p {
      font-size: 14px;
      font-weight: 400 !important;
      color: #00061a;
    }

    .editableTextArea:is(.googleAdCopy) .toggleData .table-main .table-body .tableCard {
      background: #ffffff70;
      padding: 6px 12px;
      border-radius: 5px;
    }

    .editableTextArea:is(.googleAdCopy) .toggleData .table-main .table-body .tableCard span {
      font-size: 14px;
      color: #00061a;
    }

    .editableTextArea:is(.googleAdCopy) .toggleData .table-main .values {
      width: 30%;
      overflow: hidden;
      border-left: 1px solid gray;
      padding-left: 10px;
      white-space: pre;
    }

    .editableTextArea:is(.googleAdCopy) .toggleData .sponsoredBlock {
      padding: 24px 12px;
    }

    .editableTextArea:is(.googleAdCopy) .toggleData .sponsoredBlock .sponsoredCards {
      margin-bottom: 32px;
    }

    .editableTextArea:is(.googleAdCopy) .toggleData .sponsoredBlock .sponsoredCards strong {
      color: #4a4e5c;
      margin-bottom: 4px;
      font-size: 13px;
      font-weight: 700;
    }

    .editableTextArea:is(.googleAdCopy) .toggleData .sponsoredBlock .sponsoredCards h6 {
    
      margin:0px;
    }
    
    .editableTextArea:is(.googleAdCopy) .toggleData .sponsoredBlock .sponsoredCards h4 {
      font-size: 16px;
      color: #575b68;
      margin:0px 0px 3px 0px;
    }

    .editableTextArea:is(.googleAdCopy) .toggleData .sponsoredBlock .sponsoredCards p {
      font-size: 12px;
      margin-bottom:0px;
    }

    .editableTextArea:is(.googleAdCopy) .toggleData .sponsoredBlock .sponsoredCards .grayDot {
      width: 40px;
      height: 40px;
      background: #ebebed;
    }

    .editableTextArea:is(.googleAdCopy) .toggleData .sponsoredBlock .sponsoredCards .earth-icon {
      left: 6px;
      
    }

    .editableTextArea:is(.googleAdCopy) .toggleData .sponsoredBlock .sponsoredCards .linkUrl {
      font-size: 12px;
      color: #575b68;
      font-weight: 400;
    }

    .editableTextArea:is(.googleAdCopy) .toggleData .sponsoredBlock .sponsoredCards .callToAction {
      color: #0039ff;
      font-size: 12px;
      font-style: normal;
      font-weight: 400;
      line-height: 160%;
    }

    .editableTextArea:is(.googleAdCopy) .toggleData.notContent {
      background: #ebebed;
      border-radius: 5px;
      padding: 15px;
      height: calc(100vh - 250px);
    }

    .editableTextArea:is(.googleAdCopy) .google-add-review {
      color: #000929;
      font-size: 16px;
      font-weight: 600;
    }
    .mb-4 {
        margin-bottom: 1.5rem !important;
    }
    .mb-3 {
        margin-bottom: 1rem !important;
    }
    .mb-2 {
        margin-bottom: .5rem !important;
    }
    .gap-3 {
        gap: 1rem !important;
    }
    
    .p-0 {
        padding: 0 !important;
    }
    .mt-4 {
        margin-top: 1.5rem !important;
    }
    .position-absolute {
        position: absolute !important;
    }
    .rounded-5 {
        border-radius: 2rem !important;
    }
    .fs-3 {
        font-size: 2.75rem !important;
    }
    .sponsoredCards svg{
        vertical-align: middle;
    }
    .bg-white {
        background-color: rgba(255, 255, 255, 1) !important;
    }
    .text-primary {
        color: rgba(13, 110, 253, 1) !important;
    }
/* End Google AD Copy css */

