}
.factChecker .editableTextArea .fact-checker-preview.px-4{
    padding: 0 16px 16px;
}
/*.content-area-block .editableTextArea {
    display: inline-block !important;
    width: 100%;
}*/
.fact-checker-preview .url-wrapper .link-content h3 {
    color: rgba(13, 110, 253, 1);
    cursor: pointer;
    display: -webkit-box;
    font-size: 15px;
    line-height: 28px;
    overflow: hidden;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    margin-bottom: 4px;
}
.fact-checker-preview p.desc-content.mw-100 {
    color: #757983;
    font-size: 14px;
    font-weight: 400;
    margin-bottom: 0;    
}
.fact-checker-preview .url-wrapper .link-content h3:hover {
    text-decoration: underline;
}

.fact-checker-preview .url-wrapper a.linkUrl {
    font-size: 11px;
    color: #757983;
