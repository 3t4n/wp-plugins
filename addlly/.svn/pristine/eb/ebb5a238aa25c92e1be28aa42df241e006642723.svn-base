    transform: translate(-50%, -50%);
}

@keyframes pixel_notification_out_in {
    0% {
        width: 20px;
        height: 20px;
        opacity: 0;
    }

    50% {
        opacity: 1;
    }

    100% {
        width: 0;
        height: 0;
        margin-left: 0;
        margin-top: 0;
        opacity: 1;
    }
}

@keyframes pixel_notification_in_out {
    0% {
        width: 0;
        height: 0;
        margin-left: 0;
        margin-top: 0;
        opacity: 1;
    }

    50% {
        opacity: 1;
    }

    100% {
        width: 20px;
        height: 20px;
        margin-left: 0px;
        margin-top: 0px;
        opacity: 0;
    }
}

.instagramMediaView .mediaLayout .instaPage .postsBlock .postedText .blankImages img {
    width: 100%;
}

.instagramMediaView .mediaLayout .instaPage .postsBlock .postedText .blankImages img.likedImage {
    width: 70%;
}

.instagramMediaView .mediaLayout .instaPage .postsBlock .postedText .blankImages img.commentsImage {
    width: 80%;
}

.instagramMediaView .mediaLayout .instaPage .postsBlock.notContent .post-desc {
    width: 93%;
    margin: 10px auto;
    min-height: 24px;
    background-color: #ebebed;
}

.instagramMediaView .mediaLayout .instaPage .postsBlock.notContent .post-desc pre,
.instagramMediaView .mediaLayout .instaPage .postsBlock.notContent .post-desc span.more-btn {
    display: none;
}

.instagramMediaView .mediaLayout .instaPage .postsBlock.notContent .uploadAiGEn .genrateAiBlock {
    background: #ebebed;
}

.instagramMediaView .mediaLayout .instaPage .postsBlock.notContent .uploadAiGEn .genrateAiBlock * {
    display: none;
}

.instagramMediaView .instaPage {
    overflow: auto;
    height: 589px;
}

.instagramMediaView .instaPage::-webkit-scrollbar {
    width: 0px;
}

.instagramMediaView .instaPage::-webkit-scrollbar-track {
    box-shadow: inset 0 0 5px grey;
    border-radius: 10px;
}

.instagramMediaView .instaPage::-webkit-scrollbar-thumb {
    background: grey;
    border-radius: 10px;
}

.instagramMediaView .instaPage .instaStory .youStory {
    overflow: hidden;
    padding: 10px;
}

.instagramMediaView .instaPage .instaStory .youStory .cardIn {
    min-width: 55px;
}

.instagramMediaView .instaPage .postsBlock {
    height: auto;
    overflow: hidden;
}

.instagramMediaView .instaPage .postsBlock .instaPostText {
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
    position: relative;
    padding: 5px 5px;
}

.instagramMediaView .instaPage .postsBlock .userInfo .userName {
    display: flex;
}

.instagramMediaView .instaPage .postsBlock .userInfo .story .instaframe {
    width: 28px;
    height: 28px;
}

.instagramMediaView .instaPage .postsBlock .userInfo .story .instaframe .instaProfile {
    width: 21px;
    height: 21px;
}

.instagramMediaView .instaPage .postsBlock .userInfo .story .instaframe .instaProfile img {
    width: 21px;
    height: 21px;
    transform: translateY(-3px);
}

.instagramMediaView .instaPage .postsBlock .addCommentsB .story.cardIn .instaframe {
    width: 21px;
    height: 21px;
}

.instagramMediaView .instaPage .postsBlock .addCommentsB .story.cardIn .instaframe .instaProfile {
    width: 21px;
    height: 21px;
}

.instagramMediaView .instaPage .postsBlock .addCommentsB p {
    font-size: 10px;
    margin-bottom: 10px;
}

.instagramMediaView .instaPage .postsBlock .addCommentsB p .dayAgo {
    flex: 0 0 100%;
}

.instagramMediaView .instaPage .postsBlock .commentsBlock p {
    font-size: 10px;
    margin-bottom: 10px;
}

.instagramMediaView .instaPage .postsBlock .instaMenus {
    position: fixed;
    bottom: 0;
    z-index: 99;
    background: #fff;
}

.instagramMediaView .instaPage .postsBlock .instaMenus .story {
    position: absolute;
    right: 17px;
    bottom: 15px;
    width: 20px;
    height: 20px;
    display: flex;
    justify-content: center;
    align-items: center;
}

.instagramMediaView .instaPage .postsBlock .instaMenus .story .instaProfile {
    width: 20px;
    height: 20px;
}

.instagramMediaView .instaPage .postsBlock .postedText .genrateAiBlock {
    border: 1px dashed #711f56;
}

.instagramMediaView .instaPage .postsBlock .postedText.notContent .genrateAiBlock {
    background: #ebebed;
    border: 0;
}

.instagramMediaView .instaPage .postsBlock .postedText.notContent .genrateAiBlock * {
    display: none;
}

.instagramMediaView .instaPage .postsBlock .postedText.notContent .postIcons {
    opacity: 0.2;
}

.instagramMediaView .instaPage .postsBlock .postedText.notContent .instaPostText {
    min-height: 17px;
    background: #ebebed;
    width: 95%;
    margin: 0 auto 8px;
}

.instagramMediaView .instaPage .postsBlock .postedText.notContent .instaPostText * {
    display: none;
}

.instagramMediaView .instaPage .postsBlock .postedText.notContent .addCommentsB .dayAgo {
    max-width: 100%;
}

.instagramMediaView .instaPage .postsBlock .postedText.notContent .addCommentsB .dayAgo span {
    background: #ebebed;
    color: #ebebed;
    width: 43px;
    display: block;
    margin-top: 8px;
}

.instagramMediaView .story .instaframe .instaProfile {
    border-radius: 50px;
    height: 48px;
    left: 50%;
    overflow: hidden;
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 48px;
}

.instagramMediaView .story .instaframe .instaProfile img {
    height: 50px;
    object-fit: cover;
    transform: translateY(-2px);
    width: 50px;
}

.instagramMediaView .story p {
    font-family: Inter;
    font-size: 8.702px;
    font-style: normal;
    font-weight: 400;
    line-height: 16px;
