.upload-image-tooltip {
  display: none;
  background: #fff;
  color: #1c2133;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
  text-align: center;
  border-radius: 6px;
  padding: 6px 12px;
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  z-index: 999;
  transition: opacity 0.3s;
}

.upload-image-tooltip.top-arrow .arrow-content {
  top: -24px;
  border-color: transparent transparent #f3f3f3 transparent;
}

.upload-image-tooltip .arrow-content {
  content: "";
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%);
  border-width: 12px;
  border-style: solid;
  border-color: #f3f3f3 transparent transparent transparent;
}

.upload-image-tooltip .comment-form-wrapper {
  width: 350px;
}

.upload-image-tooltip .comment-form-wrapper .user-info .userIcon {
  max-width: 42px;
  min-height: 42px;
  border: 1px solid #ebebed;
}

.upload-image-tooltip .comment-form-wrapper .user-info .avatar {
  background: #0000ff;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 42px;
  width: 42px;
  border-radius: 50px;
  text-align: center;
  line-height: 42px;
  font-size: 20px;
  border: 2px solid #fff;
  font-weight: 500;
}

.upload-image-tooltip .comment-form-wrapper .form-group textarea {
  resize: none;
}

.upload-image-tooltip .comment-form-wrapper .addlly-outline {
  padding: 12px 16px;
}

.upload-image-tooltip .comment-form-wrapper .addlly-primary {
  background: #000;
  border: 1px solid #000;
  color: #fff;
  padding: 12px 16px;
  max-width: none;
}
