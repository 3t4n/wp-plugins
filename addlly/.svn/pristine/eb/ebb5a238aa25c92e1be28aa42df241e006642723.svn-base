*{
    font-family: inter;
}
.toplevel_page_addlly .wp-submenu-wrap .wp-first-item{
    display: none;
}
body.wp-admin{
    background: #f0f0f1;
}
.addlly-container{
    margin: 0 0 50px auto;
    padding:10px 10px 10px;
    transition: all .3s linear;
}
.one-click .addlly-container,
.co-pilot .addlly-container{
    text-align: left;
}
.addlly-container .addlly-header h3 {
    font-size: 22px;
    font-weight: 700;
    line-height: 36px;
    color: #000;
    margin-bottom: 0;
    gap:12px;
}
.addlly-container .addlly-header p {
    font-size: 16px;
    line-height: 20px;
    color: #595a62;
    margin: 10px 0 16px;
}
.addlly-form-holder {
    background: #fff;
    padding: 40px;
    border: 1px solid #fff;
    border-radius: 10px;
    margin: 40px 0;
}
.addlly-container .addlly-video-sec .video-iframe{
    border: 20px;
    width: 100%;
    min-height: 540px;
    margin: 0 auto 10px;
    border-color: #fff;
    border-radius: 5px;
}

.addlly-form .field-label{
    margin-bottom: 8px;
}
.addlly-form .field-label label,
.addlly-form .group-checkbox label{
    color: #757983;
    font-size: 15px;
    font-weight:500;
}
.addlly-form .group-checkbox label{
    margin-left: 10px;
    padding-top: 11px;
}
.glitterStar.cursor-pointer {
    animation: pulse 1s infinite;
    height: 30px;
    position: absolute;
    right: 15px;
    top: 13px;
    width: 20px;
}
@keyframes pulse {
0%, 100% {
  background-image: url(../images/star-icon.svg);
}
50% {
  background-image: url(data:image/png;base64,);
}
}
.addlly-form .field-input input,
.addlly-form .field-dropdown select{
    border: 1px solid #ebebed;
    border-radius: 5px;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    height: 48px;
    padding: 0 16px;
    width: 100%;
}
.addlly-form .field-input input:focus{
    box-shadow: none;
}
.addlly-form .field-input input.is-invalid{
    border-color: red !important;
}
.addlly-form .field-group{
    margin-bottom: 20px;
}
.addlly-form .field-group button {
    align-items: center;
    background-color: #0039ff;
    border: 0;
    border-radius: 5px;
    color: #fff;
    display: flex;
    font-family: Inter;
    font-size: 14px;
    gap: 10px;
    height: 48px;
    padding: 14px 15px;
    cursor: pointer;
}
.addlly-form .field-inline{
    display: flex;
    align-items: center;
    gap: 20px;
}
.addlly-form .field-inline{
    width: 100%;
}
.addlly-form .field-inline .field-group{
    width: 33%;
}
.addlly-form .chart-desc{
    padding-left: 25px;
}
.hide{
    display: none;
}
.addlly-form-holder .co-pilot .types{
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 20px;
}
.addlly-form-holder .co-pilot .types .type{
    border: 1px solid #ebebed;
    border-radius: 5px;
    color: #1c2133;
    padding: 24px 16px;
    cursor: pointer;
}
.addlly-form .topic-field{
    position: relative;
}
.addlly-form .glitterStar{
    animation: pulse 1s infinite;
    height: 20px;
    position: absolute;
    right: 15px;
    top: 13px;
    width: 20px;
}
@keyframes pulse {
    0%, 100% {
        background-image: url(../images/star-icon.svg);
    }
    50% {
        background-image: url(data:image/png;base64,);
    }
}
.cursor-pointer {
    cursor: pointer;
}
.addlly-form .topic-field .tooltip-inner {
    min-width: 105px;
    max-width: 100%; 
}
.addlly-form .invalid{
    font-family: Inter;
    color: red !important;
    font-size: 12px;
    font-style: italic;
    font-weight: 400;
    line-height: 14.4px;
    margin-top: 8px;
}
.d-flex{
   display: flex !important; 
}
.align-items-center{
    align-items: center !important;
}
.infoIconSvg svg{
    fill: #1c2133;
    height: 12px;
    margin-left: 8px;
    min-width: 12px;
}
svg.infoIconSvg{
    fill: #1c2133;
    height: 12px;
    margin-left: 8px;
    min-width: 12px;
}
.addlly-form label .astrick {
    color: red;
    font-size: 16px;
}
.addlly-form button:disabled {
    cursor: not-allowed;
    background: #bfc1c6;
}
.addlly-form .selectedOptions span {
    background: linear-gradient(103deg, #00f3, #f003 121.74%);
    border-radius: 30px;
    color: #000;
    display: block;
    font-size: 12px;
    font-style: normal;
    font-weight: 400;
    margin-top: 8px;
    max-width: -webkit-max-content;
    max-width: max-content;
    padding: 3px 15px;
}
.addlly-form .genrateBtn{
    margin-top: 40px;
}
.addlly-form.one-click .field-dropdown select{
    min-width: 379px;
}
.addlly-articles-holder{
    background: #fff;
    padding: 40px;
    border: 1px solid #fff;
    border-radius: 10px;
    margin: 20px 0;
}   
.edit-one-click .addlly-articles-holder{
    padding: 20px;
}
.addlly-row{
    display: flex;
    align-items: stretch;
    width: 100%;
    min-height: 52px;
    padding: 12px 20px;
    border: 0;
    border-radius: 0;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom: 1px solid #ebebed;
}
.addlly-row>div{
    flex: 1 0 0px;
    max-width: 100%;
    font-size: 14px;
}
.addlly-row .title{
    flex: 0 0 30%;
}
.addlly-video-sec {
    position: relative;
    padding-bottom:40.25%;
    padding-top: 25px;
    height: 0;
    width: 100%;
    margin-bottom: 40px;
}
.addlly-video-sec iframe.video-iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 20px;
}

.blog-writer-holder .sidebar{
    flex: 0 0 20%;
    max-width: 20%;
}       
.blog-writer-holder .blog-writer-content-block{
    width: 100%;
    padding: 0px 0px 24px 24px;
}
.blog-writer-holder .sidebar ul{
    border-radius: 5px;
    padding: 16px;
    background: linear-gradient(103deg, rgba(0, 0, 255, 0.05) 0%, rgba(255, 0, 0, 0.05) 121.74%), #fff;
    margin-top: 0px;
} 
.blog-writer-holder .sidebar ul li{
    border-radius: 5px;
}
.blog-writer-holder .sidebar ul li a{
    cursor: pointer;
    margin-bottom: 8px;
    padding: 10px;
    gap: 1rem !important;
    text-decoration: none;
}
.blog-writer-holder .sidebar ul li a:focus{
    box-shadow:none !important;
    outline: 0px !important;
}
.blog-writer-holder .sidebar ul li.active,
.blog-writer-holder .sidebar ul li:hover{
    background: linear-gradient(103deg, #00f 0%, #f00 121.74%);
}
.blog-writer-holder .sidebar ul li span,
.blog-writer-holder .sidebar ul li a span{
    color: #575b68;
    font-size: 14px;
    font-style: normal;
    font-weight: 500;
    text-decoration: none;
}
.blog-writer-holder .sidebar ul li a{
    color: #575b68;
}
.blog-writer-holder .sidebar ul li.active span,
.blog-writer-holder .sidebar ul li:hover span,
.blog-writer-holder .sidebar ul li:hover svg,
.blog-writer-holder .sidebar ul li.active svg{
    color: #ffffff;
    fill: #ffffff;
}
.blog-writer-holder .blog-writer-content-block .top-nav-items{
    flex-wrap: wrap !important;
    gap: 1.5rem !important;
    margin-bottom: 24px;
    overflow: visible !important;
}
.blog-writer-holder .blog-writer-content-block .top-nav-items .left-buttons{
    gap: 1rem !important;
}
.blog-writer-holder .blog-writer-content-block .top-nav-items .blog-btn{
    align-items: center;
    background: #e6ebff;
    border-radius: 5px;
    color: #0039ff;
    display: flex;
    font-size: 14px;
    gap: 8px;
    height: 37px;
    justify-content: center;
    padding: 0 15px;
    border: 0px;
}
.blog-writer-holder .blog-writer-content-block .top-nav-items .blog-btn.blue-bg{
    background: #0039ff;
    color: #fff;
}
.blog-writer-holder .blog-writer-content-block .top-nav-items .right-buttons{
    gap: 1rem !important;
}
.blog-writer-holder .blog-writer-content-block .top-nav-items .right-buttons .blog-btn{
    align-items: center;
    background: #0039ff;
    border-radius: 5px;
    color: #fff;
    display: flex;
    font-size: 14px;
    gap: 8px;
    height: 37px;
    justify-content: center;
    padding: 0 15px;
}
.blog-writer-holder .blog-writer-content-block .top-nav-items .right-buttons .save-btn,
.blog-writer-holder .blog-writer-content-block .top-nav-items .right-buttons .save-review-article-btn{
    background: #00061a;
}
.blog-writer-holder .blog-writer-content-block .top-nav-items .right-buttons .save-btn:disabled{
    background-color: #757983 !important;
}
.blog-writer-holder .blog-writer-content-block .top-nav-items .right-buttons .full-screen-btn{
    background: #fff;
    border: 1px solid #ebebed;
    padding: 0;
    width: 38px;
}
.blog-writer-holder .blog-writer-content-block .top-nav-items .right-buttons .full-screen-btn svg{
    fill: #00061a;
}
.blog-writer-holder .sidebar ul .divider{
    background: linear-gradient(103deg, rgba(0, 0, 255, 0.05) 0%, rgba(255, 0, 0, 0.05) 121.74%);
    height: 8px;
    margin: 8px 0;
}
.addlly-container .edit-blog{
    justify-content: space-between !important;
    flex-wrap: wrap;
    gap: 1rem !important;
    display: flex !important;
}
.addlly-container .edit-blog .back-btn{
    color: #757983;
    font-size: 14px;
    font-style: normal;
    font-weight: 500;
    text-decoration: none;
    margin-top: 8px;
    margin-right: 5px;
}
.addlly-container .edit-blog .back-btn svg{
    margin-right: 10px;
}
.edit-one-click .content-area-block{
    gap: 24px;
}
.edit-one-click .content-area-block .content-area{
    margin-top:10px;
    width: 100%;
}
.edit-one-click .content-area-block .toggle-sidebar{
    flex: 0 0 100%;
    height: 100%;
    max-width: 320px;
    padding-top: 0;
}
.edit-one-click .toggle-sidebar h3{
    color: #1c2133;
    font-size: 16px;
    font-style: normal;
    font-weight: 600;
    margin-bottom: 24px;
}
.edit-one-click .toggle-sidebar h3 svg{
    fill: #1c2133;
    height: 12px;
    margin-left: 8px;
    min-width: 12px;
}
.edit-one-click .toggle-sidebar .word-count{
    background: linear-gradient(103deg, rgba(0, 0, 255, 0.05) 0%, rgba(255, 0, 0, 0.05) 121.74%), #fff;
    border-radius: 15px;
    padding: 15px;
}
.edit-one-click .toggle-sidebar .word-count h4,
.edit-one-click .toggle-sidebar .related-keywords h4{
    color: #1c2133;
    font-size: 14px;
    font-style: normal;
    font-weight: 600;
}
.edit-one-click .toggle-sidebar .heading-summary{
    gap: 8px;
    align-items: center !important;
    margin-top: .5rem !important;
    justify-content: center !important;
}
.edit-one-click .toggle-sidebar .heading-summary .heading-counts{
    background: #fafafa;
    border-radius: 5px;
    flex: 0 0 23%;
    overflow: hidden;
    text-align: center;
    min-height: 94px;
}
.edit-one-click .toggle-sidebar .heading-summary .heading-counts p{
    background: linear-gradient(102.77deg, rgba(0, 0, 255, 0.1490196078) 0%, rgba(255, 0, 0, 0.3215686275) 121.74%),
    linear-gradient(102.77deg, rgba(0, 0, 255, 0.1) 0%, rgba(255, 0, 0, 0.1) 121.74%);
    color: #00061a;
    align-items: center;
    display: flex;
    height: 40px;
    justify-content: center;
}
.edit-one-click .toggle-sidebar .heading-summary .heading-counts h6{
    color: #00061a;
    font-size: 14px;
    line-height: 22px;
    font-weight: bold;
}
.edit-one-click .toggle-sidebar .heading-summary .heading-counts .words-count{
    font-size: 12px;
    font-style: normal;
    font-weight: 400;
    line-height: 120%;
    padding: 0 8px;
    text-align: center;
}
.edit-one-click .toggle-sidebar .related-keywords{
    margin-top: 2rem !important;
}
.edit-one-click .toggle-sidebar .tags{
    align-items: baseline;
    display: flex;
    flex-wrap: wrap;
    max-height: 570px;
    padding-bottom: 0 !important;
    margin-top: .5rem !important;
}
.edit-one-click .toggle-sidebar .tags .tag{
    padding: 5px 10px;
    font-size: 12px;
    border: 0 !important;
    margin: .25rem !important;
    border-radius: 0.375rem;
}
.edit-one-click .toggle-sidebar .tags .status-success{
    background-color: #dafbec;
    color: #059669;
}
.edit-one-click .toggle-sidebar .tags .status-danger{
    background-color: #ff00000d;
    color: red;
}
.co-pilot .addlly-form-holder {
    padding: 0px;
    border:0px;
}
.co-pilot .addlly-form{
    padding: 10px 30px 30px 30px;
}
.co-pilot .AIWriterBlogHead{
    background: linear-gradient(180deg, #0000ff08 15.66%, #f000 86.63%), #fff;
    border-radius: 12px 12px 0 0;
    padding: 24px 0;
}
.co-pilot .AIWriterBlogHeadTop{
    align-items: center;
    display: flex;
    justify-content: center !important;
    margin-bottom: 8px;
}
.co-pilot .AIWriterStepper{
    justify-content: center !important;
    align-items: center;
    display: flex;
    gap: 40px;
}
.co-pilot .AIWriterStepper ul{
    display: flex;
    gap: 32px;
    margin: 0;
    padding: 0;
}
.co-pilot .AIWriterStepper ul li{
    align-items: center;
    display: flex;
    flex-direction: column;
    font-size: 14px;
    font-weight: 500;
    gap: 8px;
    line-height: 22px;
    list-style: none;
    position: relative;
    white-space: nowrap;
    width: 98px;
}
.co-pilot .AIWriterStepper ul li span{
    align-items: center;
    border-radius: 5px;
    display: flex;
    height: 32px;
    justify-content: center;
    min-width: 24px;
    position: relative;
    text-align: center;
    width: 32px;
    background: linear-gradient(103deg, #0000ff26, #ff000026 121.74%);
    border: 1px solid #0000ff1f;
    color: #4a4e5c;
}
.co-pilot .AIWriterStepper ul li.active span{
    border: 1px solid #0039ff;
    color: #0039ff;
}
.co-pilot .AIWriterStepper ul li p{
    color: #1c2133;
    font-size: 12px;
    font-weight: 400;
    margin-bottom: 0;
    position: relative;
    font-weight: 500;
}

.co-pilot .AIWriterStepper ul li:not(:last-child):after {
    background: linear-gradient(103deg, #0000ff12, #ff000012 121.74%);
    content: "";
    height: 1px;
    left: 64px;
    position: absolute;
    top: 17px;
    width: 100px;
}
.co-pilot .selectType{
    background: #fafafa;
    border-radius: 8px;
    color: #1c2133;
    margin: 0 auto 24px;
    padding: 12px 12px;
}
.co-pilot .type-icon{
    align-items: center;
    border-radius: 8px;
    display: flex;
    height: 56px;
    justify-content: center;
    margin: auto;
    width: 56px;
}
.co-pilot .your-topic-field{
    margin-bottom: 30px;
}
.googleSearchResult .addUrl{
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
}
.googleSearchResult .addUrl h6{
    color: #757983;
    font-size: 14px;
    font-style: normal;
    font-weight: 500;
}
.googleSearchResult .addUrl button{
    background: #0000;
    border: 0;
    color: #0039ff;
    font-size: 14px;
    font-style: normal;
    font-weight: 500;
    max-width: max-content;
    width: 100%;
}
.googleSearchResult .seoUrlList{
    list-style: none;
    margin-bottom: 0;
}
.googleSearchResult .seoUrlList li{
    overflow: hidden !important;
}
.googleSearchResult .seoUrlList li .checkListItem{
    background: #f4f4f9;
    border: 1px solid #0000;
    border-radius: 8px;
    display: flex;
    justify-content: space-between;
    margin-bottom: 12px;
    max-width: 100%;
    overflow: hidden;
    padding: 16px;
    padding-bottom: .5rem !important;
    padding-top: .5rem !important;
    flex-direction: column !important;
}
.googleSearchResult .seoUrlList li .checkListItem .linkImageBlock {
    border-bottom: 1px solid #ebebed;
    margin-bottom: 8px;
    padding-bottom: 8px;
    align-items: center !important;
    width: 100% !important;
}
.googleSearchResult .seoUrlList li .checkListItem input[type=checkbox]{
    appearance: none;
    height: 16px;
    margin: 0;
    position: relative;
    width: 16px;
    border:0px;
}
.googleSearchResult .seoUrlList li .checkListItem input[type=checkbox]:after {
    border: 1px solid #bfc1c6;
    border-radius: 3px;
    content: "";
    height: 16px;
    position: absolute;
    width: 16px;
    left: 0px;
    top: 0px;
}
.googleSearchResult .seoUrlList li .checkListItem input[type=checkbox]:checked:before {
    border: 2px solid #fff;
    border-left: 0;
    border-top: 0;
    content: "";
    height: 10px;
    left: 6px;
    position: absolute;
    top: 9px;
    transform: rotate(43deg) translate(-50%, -50%);
    width: 6px;
    z-index: 1;
}
.googleSearchResult .seoUrlList li .checkListItem input[type=checkbox]:checked:after {
    align-items: center;
    background-color: #0039ff;
    border-color: #0039ff;
    color: #fff;
    content: "";
    cursor: pointer;
    display: flex;
    font-family: math;
    font-size: 14px;
    justify-content: center;
}
.googleSearchResult .seoUrlList li .checkListItem .link-holder{
    margin-left: 1rem !important;
    width: 100% !important;
}
.googleSearchResult .seoUrlList li .checkListItem .link-content {
    color: #4d5156;
    cursor: default;
    display: block;
    text-decoration: none;
    width: -webkit-fit-content;
    width: -moz-fit-content;
    width: fit-content;
}

.googleSearchResult .seoUrlList li .checkListItem .link-image {
    align-items: center;
    background: #c2c2d3;
    border-radius: 50px;
    display: flex;
    height: 36px;
    justify-content: center;
    margin-right: 12px;
    width: 36px;
}

.googleSearchResult .seoUrlList li .checkListItem .link-image img {
    border-radius: 50px;
    height: 100%;
    object-fit: contain;
    overflow: hidden;
    width: 100%;
    vertical-align: middle;
}
.googleSearchResult .seoUrlList li .checkListItem .link-holder p{
    font-size: 14px;
    font-weight: 400;
    margin-bottom: 0;
    color: #1c2133;
}

.googleSearchResult .seoUrlList li .checkListItem .links svg {
    fill: #0039ff;
    height: 18px;
    margin-left: .5rem !important;
}

.googleSearchResult .seoUrlList li .checkListItem h4{
    color: #0039ff;
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    margin: 0px;
}
.googleSearchResult .seoUrlList li .checkListItem .google-content{
    line-height: 24px;
    margin-bottom: 0;
    margin-top: .25rem !important;
    color: #2e3343;
    font-size: 12px;
    font-style: normal;
    font-weight: 400;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    display: -webkit-box;
    overflow: hidden;
}
.step-4 .googleSearchResult .addUrl{
    justify-content: left;
    gap:0px;
}
.seoUrlList li.suggestionBox {
    background: #fafafa;
    border: 1px solid #fafafa;
    border-radius: 5px;
    list-style: none;
    margin-bottom: 8px;
    padding: 12px 16px;
}
.seoUrlList li.suggestionBox .suggestionInput{
    gap: .5rem !important;
}
.justify-content-between {
    justify-content: space-between !important;
}
.seoUrlList li.suggestionBox .suggestionInput {
    flex: 0 0 40%;
    width: 100%;
}
.seoUrlList li.suggestionBox .radioType input[type=radio] {
    -webkit-appearance: none !important;
    appearance: none !important;
    border: 0;
    cursor: pointer;
    position: relative;
    text-indent: 504px;
    z-index: 0;
    height: 16px;
    width: 16px;
}
.seoUrlList li.suggestionBox .radioType input[type=radio]:after {
    border: 1px solid #a1a1a1;
    border-radius: 50%;
    content: "";
    height: 20px;
    left: 50%;
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 20px;
    border: 1px solid #bfc1c6;
    height: 16px;
    width: 16px;
}
.seoUrlList li.suggestionBox .radioType input[type=radio]:checked:before {
    background: #0039ff;
    border-radius: 50%;
    content: "";
    height: 10px;
    left: 50%;
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 10px;
    z-index: 1;
}
.seoUrlList li.suggestionBox .radioType input[type=radio]:checked:after {
    border: 1px solid #1a4dff;
    border: 1px solid #1a4dff;
    height: 16px;
    width: 16px;
}
.w-100 {
    width: 100% !important;
}
.seoUrlList li.suggestionBox .suggestionInput .keywordInput input {
    border: 1px solid #e4e4e7;
    border-radius: 5px;
    height: 62px;
    padding: 15px;
    width: 100%;
}
