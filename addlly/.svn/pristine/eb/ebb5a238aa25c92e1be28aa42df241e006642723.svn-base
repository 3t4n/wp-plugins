.custom-tooltip{
    background: #fff;
    border-radius: 6px;
    box-shadow: 0 2px 5px #0003;
    color: #1c2133;
    display: none;
    left: 50%;
    padding: 6px 12px;
    position: absolute;
    text-align: center;
    transform: translateX(-50%);
    transition: opacity .3s;
    z-index: 999;
}
.custom-tooltip .arrow-content {
    border: 12px solid #0000;
    border-top-color: #f3f3f3;
    content: "";
    left: 50%;
    position: absolute;
    top: 100%;
    transform: translateX(-50%);
}
