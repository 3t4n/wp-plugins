    margin-bottom: 4px;
}

.optomizeCardBlock .opCard {
    background: #fafafa;
    border: 1px solid #fafafa;
    border-radius: 5px;
    padding: 16px;
    gap: 1rem !important;
    margin-bottom: .5rem !important;
}
.optomizeCardBlock .opCard .radioTextBlock {
    overflow: hidden;
    width: 140px;
    gap: 1rem !important;
}
.optomizeCardBlock .radioType input[type=radio] {
    -webkit-appearance: none !important;
    appearance: none !important;
    border: 0;
    cursor: pointer;
    position: relative;
    text-indent: 504px;
    z-index: 0;
    height: 20px;
    width: 20px;
}
.optomizeCardBlock .radioType input[type=radio]:after {
    border: 1px solid #a1a1a1;
    border-radius: 50%;
    content: "";
    height: 20px;
    left: 50%;
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 20px;
}
.optomizeCardBlock .radioType input[type=radio]:checked:before {
    background: #0039ff;
    border-radius: 50%;
    content: "";
    height: 10px;
    left: 50%;
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 10px;
    z-index: 1;
}
.optomizeCardBlock .radioType input[type=radio]:checked:after {
    background: #fff;
    border-color: #0039ff;
}
.optomizeCardBlock .opCard .radioTextBlock p {
    color: #1c2133;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
}
.optomizeCardBlock .opCard .grayBox {
    background: #f5f5f5;
    border-radius: 5px;
    height: 45px;
    width: 32px;
}
.optomizeCardBlock .opCard .inputBoxField {
    margin: 0 0 0 auto;
    width: calc(100% - 175px);
}
.optomizeCardBlock .opCard .inputBoxField textarea {
    align-items: center;
    background: #fff;
    border: 1px solid #e4e4e7;
    border-radius: 5px;
    color: #1c2133;
    display: flex;
    font-size: 14px;
    font-weight: 400;
    min-height: 48px;
    outline: medium none invert;
    outline: initial;
    overflow: auto;
    padding: 10px;
    resize: none;
}
