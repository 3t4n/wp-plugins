    margin-bottom: 8px;
}
.offcanvas .offcanvas-body .blogMetaInner span {
    color: #00061a;
    display: block;
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
}
.offcanvas .offcanvas-body .blogMetaInner .copyIcon {
    align-items: center;
    border-radius: 50px;
    display: flex;
    height: 40px;
    justify-content: center;
    min-width: 40px;
}
.text-info {
    color: rgba(13, 202, 240, 1) !important;
    color: rgba(13, 202, 240, 1) !important;
}
.offcanvas-end .offcanvas-header {
    border-bottom: 1px solid #ebebed;
    margin-bottom: 20px !important;
    padding-bottom: 20px !important;
}

