    position: absolute;
    top: 60px;
    transform: translate(-50%);
    width: 100vw;
    z-index: 1100;
}
.filter-popup-dropdwon.filterPopUpH:after {
    border-color: #0000 #0000 #ececf4;
    border-style: solid;
    border-width: 0 12px 12px;
    content: "";
    height: 0;
    left: 35%;
    position: absolute;
    top: -7px;
