#accordion-section-fl_icons_section, #sub-accordion-section-fl_icons_section,
#accordion-section-fl_design_section, #sub-accordion-section-fl_design_section,
#sub-accordion-section-fl_position_section,
#accordion-section-fl_position_section,
#accordion-section-fl_pagination_section,
#sub-accordion-section-fl_pagination_section {
  background-color: #fff !important;
  .accordion-section-content{
    background-color: #fff;
  }
  .customize-control-title
  {
    font-size: 20px;
    margin-bottom: 6px;
  }
  .customize-section-description
  {
    font-size: 18px;
    border-bottom: 2px solid #ddd;
    padding-bottom: 20px;
  }
  .customize-control
  {
    border-bottom: 2px solid #ddd;
    padding-bottom: 20px;
  }

  .customize-control:last-child
  {
    border: none;
  }
  .customize-control-radio .label
  {
    float: left !important;
    width: auto;
    margin: 0px;
    padding: 0px;
  }
  #customize-control-fl_left_icon
  {
    margin-bottom: 0px;
  }
  .floating_icon_holder
  {
    float: left;
    margin-right: 5px;
    margin-bottom: 8px;
    margin-left: 0px !important;
    position: relative;

    .fa, .dashicons
    {
      float: left;
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      margin-left: auto;
      margin-right: auto;
      text-align: center;
      margin-top: 10px;
      font-size: 20px;
    }

    input[type=radio]
    {
      background-color: transparent;
      border: 0px;
      height: auto;
      width: auto;
      opacity: 0;
    }

  }
  .fl_bg_holder
  {
    float: left;
    background-color: #7FC6A6;
    padding: 5px 6px 8px 6px;
    color: #fff;
    height: 36px;
    width: 36px;

  }
  .floating_icon_slected, .floating_right_icon_slected, .floating_up_icon_slected, .floating_down_icon_slected
  {
    background-color: #48D1CC;
  }

  .floating_icon_holder input:checked + .fl_bg_holder {
    background-color: #48D1CC;
  }


}
#sub-accordion-section-fl_position_section{
  label{
    float: left;
    width: 40%;
  }
}
#accordion-section-fl_design_section, #sub-accordion-section-fl_design_section, #accordion-section-fl_pagination_section, #sub-accordion-section-fl_pagination_section
{

  #customize-control-fl_shadow
  {
    display: list-item;
    border: 1px solid #EEEEEE;
    padding: 12px;
    padding-right: 0;
    float: left;
    width: 95%;
    background-color: #FDFDFD;

    label
    {
      font-size: 22px;
      padding: 0;

    }
    input[type=checkbox]
    {
      height: 25px;
      width: 30px;
      background: #eaeaea;
      border-radius: 2px;
      border-color: transparent;
    }
    input[type=checkbox]:before
    {
      color: #738e96;

      float: none;

      margin-top: -6px;
    }
  }

}
#sub-accordion-section-fl_position_section .customize-inside-control-row, #accordion-section-fl_position_section .customize-inside-control-row
{    float: left;
  width: 47%;
  margin-left: 5px;
  label{width:auto;}
  input{    margin-left: 10px;}
}