#: class/wc-paybox-abstract-gateway.php:104
msgid "Enable/Disable"
msgstr "Actif/Inactif"

#: class/wc-paybox-abstract-gateway.php:106
msgid "Enable Paybox Payment"
msgstr "Activer le paiement par Paybox"

#: class/wc-paybox-abstract-gateway.php:110
msgid "Title"
msgstr "Titre"

#: class/wc-paybox-abstract-gateway.php:112
msgid "This controls the title which the user sees during checkout."
msgstr "Titre visible par le client lors d'une commande."

#: class/wc-paybox-abstract-gateway.php:123
msgid "Icon file"
msgstr "Fichier icône"

#: class/wc-paybox-abstract-gateway.php:125
msgid "Icon file to be displayed to customers. file are located in: "
msgstr ""
"Fichier d’icône à afficher au client. les fichiers sont dans le répertoire: "

#: class/wc-paybox-abstract-gateway.php:130
msgid "Description"
msgstr "Description"

#: class/wc-paybox-abstract-gateway.php:132
msgid "Payment method description that the customer will see on your checkout."
msgstr ""
"Description de la méthode de paiement . Visible par le client lors d'une "
"commande."

#: class/wc-paybox-abstract-gateway.php:137
msgid "Delay"
msgstr "Délai"

#: class/wc-paybox-abstract-gateway.php:140
msgid "Immediate"
msgstr "Immédiat"

#: class/wc-paybox-abstract-gateway.php:141
msgid "1 day"
msgstr "1 jour"

#: class/wc-paybox-abstract-gateway.php:142
msgid "2 days"
msgstr "2 jours"

#: class/wc-paybox-abstract-gateway.php:143
msgid "3 days"
msgstr "3 jours"

#: class/wc-paybox-abstract-gateway.php:144
msgid "4 days"
msgstr "4 jours"

#: class/wc-paybox-abstract-gateway.php:145
msgid "5 days"
msgstr "5 jours"

#: class/wc-paybox-abstract-gateway.php:146
msgid "6 days"
msgstr "6 jours"

#: class/wc-paybox-abstract-gateway.php:147
msgid "7 days"
msgstr "7 jours"

#: class/wc-paybox-abstract-gateway.php:153
msgid "Minimal amount"
msgstr "Montant minimal"

#: class/wc-paybox-abstract-gateway.php:155
msgid ""
"Enable this payment method for order with amount greater or equals to this "
"amount (empty to ignore this condition)"
msgstr ""
"Activer ce moyen de paiement pour les commandes dont le montant est "
"supérieur ou égal au montant suivant (laissez vide pour ne pas activer cette "
"condition)"

#: class/wc-paybox-abstract-gateway.php:159
msgid "Paybox account"
msgstr "Compte Paybox"

#: class/wc-paybox-abstract-gateway.php:163
msgid "Site number"
msgstr "Numéro du site"

#: class/wc-paybox-abstract-gateway.php:165
msgid "Site number provided by Paybox."
msgstr "Le numéro du site vous est fourni par Paybox."

#: class/wc-paybox-abstract-gateway.php:172
msgid "Rank number"
msgstr "Rang"

#: class/wc-paybox-abstract-gateway.php:174
msgid "Rank number provided by Paybox (two last digits)."
msgstr "Numéro de rang fourni par Paybox (deux derniers chiffres)."

#: class/wc-paybox-abstract-gateway.php:181
msgid "Login"
msgstr "Identifiant"

#: class/wc-paybox-abstract-gateway.php:183
msgid "Internal login provided by Paybox."
msgstr "Votre identifiant vous est fourni par Paybox."

#: class/wc-paybox-abstract-gateway.php:190
msgid "HMAC"
msgstr "HMAC"

#: class/wc-paybox-abstract-gateway.php:192
msgid "Secrete HMAC key to create using the Paybox interface."
msgstr "Clé secrète HMAC à générer puis activer dans votre Back-Office Paybox."

#: class/wc-paybox-abstract-gateway.php:199
msgid "Environment"
msgstr "Environnement"

#: class/wc-paybox-abstract-gateway.php:201
msgid "In test mode your payments will not be sent to the bank."
msgstr "En mode test, vos paiements ne seront pas envoyé à la banque."

#: class/wc-paybox-abstract-gateway.php:203
msgid "Production"
msgstr "Production"

#: class/wc-paybox-abstract-gateway.php:204
msgid "Test"
msgstr "Test"

#: class/wc-paybox-abstract-gateway.php:209
msgid "Technical settings"
msgstr "Configuration technique"

#: class/wc-paybox-abstract-gateway.php:213
msgid "IPN IPs"
msgstr "Adresses IP de l’IPN"

#: class/wc-paybox-abstract-gateway.php:215
msgid "A coma separated list of Paybox IPN IPs."
msgstr ""
"IP des serveurs Paybox autorisés, séparées par des virgules, pour la "
"réception des Notifications Instantanées de Paiement."

#: class/wc-paybox-abstract-gateway.php:222
msgid "Debug"
msgstr "Debug"

#: class/wc-paybox-abstract-gateway.php:224
msgid "Enable some debugging information"
msgstr "Activer les informations de debuggage"

#: class/wc-paybox-abstract-gateway.php:259
msgid "Customer is redirected to Paybox payment page"
msgstr "Le client est redirigé vers la pages de paiement paybox"

#: class/wc-paybox-abstract-gateway.php:294
msgid "Back..."
msgstr "Retour..."

#: class/wc-paybox-abstract-gateway.php:302
msgid ""
"This is a debug view. Click continue to be redirected to Paybox payment page."
msgstr ""
"Ceci est une vue de debug. Cliquer sur \"continuer\" pour être redirigé vers "
"la page de paiement Paybox."

#: class/wc-paybox-abstract-gateway.php:306
msgid ""
"You will be redirected to the Paybox payment page. If not, please use the "
"button bellow."
msgstr ""
"Vous serez redirigé vers la page de paiement Paybox. Si ce n'était pas le "
"cas, merci d'utiliser le bouton ci dessous."

#: class/wc-paybox-abstract-gateway.php:314
msgid "Continue..."
msgstr "Continuer..."

#: class/wc-paybox-abstract-gateway.php:370
#: class/wc-paybox-abstract-gateway.php:410
msgid "Customer is back from Paybox payment page."
msgstr "Le client revient de la page de paiement Paybox."

#: class/wc-paybox-abstract-gateway.php:371
#: class/wc-paybox-abstract-gateway.php:373
msgid "Payment refused by Paybox"
msgstr "Le paiement a été refusé par Paybox"

#: class/wc-paybox-abstract-gateway.php:391
msgid "Payment was canceled by user on Paybox payment page."
msgstr "Le paiement a été annulé par le client sur la page de paiement Paybox."

#: class/wc-paybox-abstract-gateway.php:393
msgid "Payment canceled"
msgstr "Le paiement a été annulé"

#: class/wc-paybox-abstract-gateway.php:441
#, php-format
msgid "Missing %s parameter in Paybox call"
msgstr "Le paramètre %s manque dans l'appel Paybox"

#: class/wc-paybox-abstract-gateway.php:451
#: class/wc-paybox-abstract-gateway.php:460
msgid "Payment was authorized and captured by Paybox."
msgstr "Paiement autorisé et capturé par Paybox."

#: class/wc-paybox-abstract-gateway.php:464
msgid "Second payment was captured by Paybox."
msgstr "Deuxième paiement capturé par Paybox."

#: class/wc-paybox-abstract-gateway.php:467
msgid "Third payment was captured by Paybox."
msgstr "Troisième paiement capturé par Paybox."

#: class/wc-paybox-abstract-gateway.php:470
msgid "Invalid three-time payment status"
msgstr "Statut du paiement en trois fois non valide"

#: class/wc-paybox-abstract-gateway.php:476 class/wc-paybox.php:315
#, php-format
msgid "Unexpected type %s"
msgstr "Type %s inattendu"

#: class/wc-paybox-abstract-gateway.php:483
#, php-format
msgid "Payment was refused by Paybox (%s)."
msgstr "Paiement refusé par Paybox (%s)."

#: class/wc-paybox-encrypt.php:67 class/wc-paybox-encrypt.php:83
msgid ""
"For some reason, the key has just been generated. please reenter the HMAC "
"key to crypt it."
msgstr ""
"Pour une raison quelconque, la clé vient d'être générée. Entrez à nouveau la "
"clé HMAC pour qu'elle soit cryptée."

#: class/wc-paybox-standard-gateway.php:19
msgid "Paybox"
msgstr "Paybox"

#: class/wc-paybox-standard-gateway.php:42
#: class/wc-paybox-threetime-gateway.php:59
msgid "Reference:"
msgstr "Référence:"

#: class/wc-paybox-standard-gateway.php:44
#: class/wc-paybox-threetime-gateway.php:61
msgid "Country of IP:"
msgstr "Pays de l'IP:"

#: class/wc-paybox-standard-gateway.php:46
#: class/wc-paybox-threetime-gateway.php:63
msgid "Processing date:"
msgstr "Date de traitement:"

#: class/wc-paybox-standard-gateway.php:48
#: class/wc-paybox-threetime-gateway.php:65
msgid "Card numbers:"
msgstr "Numéros de la carte:"

#: class/wc-paybox-standard-gateway.php:51
#: class/wc-paybox-threetime-gateway.php:68
msgid "Validity date:"
msgstr "Date de validité:"

#: class/wc-paybox-standard-gateway.php:60
#: class/wc-paybox-threetime-gateway.php:77
msgid "3DS version:"
msgstr "Version 3DS:"

#: class/wc-paybox-standard-gateway.php:63
#: class/wc-paybox-threetime-gateway.php:100
msgid "Transaction:"
msgstr "Transaction:"

#: class/wc-paybox-standard-gateway.php:64
#: class/wc-paybox-threetime-gateway.php:101
msgid "Call:"
msgstr "Appel:"

#: class/wc-paybox-standard-gateway.php:65
#: class/wc-paybox-threetime-gateway.php:102
msgid "Authorization:"
msgstr "Autorisation:"

#: class/wc-paybox-standard-gateway.php:67
#: class/wc-paybox-threetime-gateway.php:104
msgid "Payment information"
msgstr "Informations sur le paiement"

#: class/wc-paybox-threetime-gateway.php:21
msgid "Paybox 3 times"
msgstr "Paybox paiement en trois fois"

#: class/wc-paybox-threetime-gateway.php:82
msgid "First debit:"
msgstr "Premier paiement:"

#: class/wc-paybox-threetime-gateway.php:88
#: class/wc-paybox-threetime-gateway.php:96
msgid "Not achieved"
msgstr "Non traité"

#: class/wc-paybox-threetime-gateway.php:90
msgid "Second debit:"
msgstr "Seconde échéance:"

#: class/wc-paybox-threetime-gateway.php:98
msgid "Third debit:"
msgstr "Troisième échéance:"

#: class/wc-paybox.php:644
msgid "Paybox not available. Please try again later."
msgstr "Paybox n'est pas disponible. Merci d'essayer plus tard."

#: woocommerce-paybox.php:40
msgid "WooCommerce must be activated"
msgstr "WooCommerce doit être activé"

#: woocommerce-paybox.php:129
msgid "HMAC key cannot be decrypted please re-enter or reinitialise it."
msgstr ""
"La clé HMAC n'a pas pu être récupérée, Veuillez entrer à nouveau  votre clé "
"HMAC, la régénérer si besoin."

#: woocommerce-paybox.php:134
msgid "Woocommerce is not active !"
msgstr "WooCommerce n’est pas activé !"

