.cspfw_specific_price_section_main.remove_section {
    display: inline-block;
    margin: 10px 0px;
}
.cspfw_specific_price_section_main ul.cspfw_specific_price_rules {
    display: inline-block;
    width: 100%;
    list-style: decimal;
    padding: 0px 0px 0px 25px;
    margin: 0px !important;
}
.cspfw_specific_price_section_main {
    display: none;
    width: 100%;
    border: 1px solid #000;
    background-color: #ccc;
}
.cspfw_specific_price_section_main h3.cspfw_specific_price_heading {
    display: inline-block;
    width: 100%;
    padding: 5px 15px;
    text-align: center;
    color: #fff;
    background-color: #000;
    margin: 0px;
}
.cspfw_specific_price_section_main .cspfw_specific_price_section_inner {
    display: inline-block;
    width: 100%;
    padding: 10px 15px;
}