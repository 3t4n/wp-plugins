or.msSaveOrOpenBlob) // IE10+\r\n  {\r\n    window.navigator.msSaveOrOpenBlob(file, filename);\r\n  } else { // Others\r\n    var a = document.createElement('a'),\r\n      url = URL.createObjectURL(file);\r\n    a.href = url;\r\n    a.download = filename;\r\n    document.body.appendChild(a);\r\n    a.click();\r\n    setTimeout(function () {\r\n      document.body.removeChild(a);\r\n      window.URL.revokeObjectURL(url);\r\n    }, 0);\r\n  }\r\n}\r\n","export default class Errors {\r\n  constructor(errors) {\r\n    this.errors = errors;\r\n  }\r\n\r\n  set(errors) {\r\n    this.errors = errors;\r\n  }\r\n\r\n  get(field) {\r\n    if (this.has(field)) {\r\n      return this.errors[field];\r\n    }\r\n    return null;\r\n  }\r\n\r\n  has(field) {\r\n    return this.errors && this.errors.hasOwnProperty(field);\r\n  }\r\n\r\n  clear() {\r\n    this.errors = {};\r\n  }\r\n}\r\n","export default {\r\n  color: 'var(--primary)',\r\n  failedColor: 'var(--error)',\r\n  thickness: '2px',\r\n};\r\n","import storage from 'localforage';\r\n\r\nstorage.config({\r\n  name: 'serverlessInvoices',\r\n  version: 1.0,\r\n  storeName: 'default',\r\n});\r\n","var render = function () {var _vm=this;var _h=_vm.$createElement;var _c=_vm._self._c||_h;return _c('div',{staticClass:\"min-vh-100\",class:_vm.$route.name,attrs:{\"id\":\"app\"}},[_c('vue-progress-bar'),_c('transition',{attrs:{\"name\":\"fade\",\"mode\":\"out-in\"}},[_c('router-view')],1),_c('notifications',{attrs:{\"position\":\"bottom center\",\"classes\":\"snackbar\",\"width\":\"332\"}})],1)}\nvar staticRenderFns = []\n\nexport { render, staticRenderFns }","<template>\r\n    <div id=\"app\"\r\n         class=\"min-vh-100\"\r\n         :class=\"$route.name\">\r\n        <vue-progress-bar/>\r\n        <transition name=\"fade\" mode=\"out-in\">\r\n            <router-view/>\r\n        </transition>\r\n        <notifications position=\"bottom center\" classes=\"snackbar\" width=\"332\"/>\r\n    </div>\r\n</template>\r\n\r\n<script>\r\n