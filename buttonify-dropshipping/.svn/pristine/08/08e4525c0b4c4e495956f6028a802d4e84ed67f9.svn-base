h3, h1 {
  color: black;
  font-family: monospace;
}
ul.a {
  list-style-type: circle;
  box-shadow: 2px 2px rgba(0, 0, 0, .02);
  border-radius: 4px;
  border: 1px solid #e1e8f0;
  background: #fff;
  padding: 26px;
  font-weight: bold;
  font-style: italic;
}
ul > li {
  list-style-type: none;
  padding-left: 0;
  font-size: 16px;
}
#Go_to_Buttonify_DIV {
  color: #333;
  font-size: 16px;
}
#buttonify_connect_keyDIV {
  color: #333;
  font-size: 16px;
}
#DisconnectIV {
  font-size: 16px;
  color: #333;
}
.Go_to_Buttonify_tip {
  font-size: 16px;
}
.Go_to_Buttonify_tip_a {
  margin-top: 10px;
  margin-bottom: 20px
}
/**/
.custom-css-connect {
  border: 1px solid #FF0017 !important;
  color: #fff;
  background-color: #FF0017 !important;
  font-size: 16px;
  border-radius: 8px !important;
  display: inline-block;
}
.custom-css-refresh {
  border: 1px solid #FF0017 !important;
  color: #FF0017;
  background-color: #fff !important;
  font-size: 16px;
  border-radius: 8px !important;
  margin-left: 1em;
  display: inline-block;
}
.custom-css-connect:focus, .custom-css-refresh:focus {
  border-color: #FF0017 !important;
}
/**/
.custom-css-connect-mini {
  border: 1px solid #eee !important;
  color: #666;
  background-color: #1d2327 !important;
  font-size: 12px;
  border-radius: 8px !important;
  display: inline-block;
  padding: 7px 10px;
}
.custom-css-refresh-mini {
  border: 1px solid #eee !important;
  color: #666;
  background-color: #eee !important;
  font-size: 12px;
  border-radius: 8px !important;
  margin-left: 1em;
  display: inline-block;
  padding: 7px 10px;
}