#rankology_stats_editor_meta_box,
#rankology-stats-browsers-widget,
#rankology-stats-countries-widget,
#rankology-stats-hitsmap-widget,
#rankology-stats-hits-widget,
#rankology-stats-comparison-widget,
#rankology-stats-pages-widget,
#rankology-stats-recent-widget,
#rankology-stats-referring-widget,
#rankology-stats-search-widget,
#rankology-stats-summary-widget,
#rankology-stats-words-widget,
#rankology-stats-top-visitors-widget,
#rkns_hits_postbox,
#rkns_top_visitors_postbox,
#rkns_search_postbox,
#rkns_words_postbox,
#rkns_recent_postbox,
#rkns_map_postbox,
#rkns_pages_postbox,
#rkns_summary_postbox,
#rkns_browsers_postbox,
#rkns_referring_postbox,
#rkns_countries_postbox,
#rkns_pages_postbox,
#rankology-stats-models-widget,
#rankology-stats-platforms-widget,
#rankology-stats-quickstats-widget,
#rankology-stats-devices-widget,
#rankology-stats-useronline-widget,
.rkns-wrap {
  .postbox .inside {
    padding: 0;
    margin-bottom: 32px;
  }

  .postbox-header .handle-actions {
    margin-top: 8px;
  }

  .postbox-header.postbox-toggle {
    cursor: pointer;

    .hndle {
      cursor: pointer !important;
    }

    h2 {
      margin: 0;
    }
  }

  .rkns-ph-col-12 {
    width: 100%;
    max-width: 100%;

    .rkns-ph-picture, .rkns-ph-row {
      max-width: 100%;
    }
  }
}

.rkns-wrap {
  .postbox-container {
    border-radius: 8px;
    overflow: visible;

    .postbox {
      border-radius: 8px;
      border: 1px solid $light-color;
    }
  }
}

#rankology_stats_editor_meta_box,
#rankology-stats-comparison-widget,
#rankology-stats-browsers-widget,
#rankology-stats-countries-widget,
#rankology-stats-hitsmap-widget,
#rankology-stats-hits-widget,
#rankology-stats-pages-widget,
#rankology-stats-recent-widget,
#rankology-stats-referring-widget,
#rankology-stats-search-widget,
#rankology-stats-summary-widget,
#rankology-stats-words-widget,
#rankology-stats-top-visitors-widget,
#rkns_hits_postbox,
#rkns_top_visitors_postbox,
#rkns_search_postbox,
#rkns_words_postbox,
#rkns_recent_postbox,
#rkns_map_postbox,
#rkns_pages_postbox,
#rkns_summary_postbox,
#rkns_browsers_postbox,
#rkns_referring_postbox,
#rkns_countries_postbox,
#rkns_pages_postbox,
#rankology-stats-models-widget,
#rankology-stats-platforms-widget,
#rankology-stats-quickstats-widget,
#rankology-stats-devices-widget,
#rankology-stats-useronline-widget {
  &.postbox .inside {
    padding: 0;
    margin-bottom: 32px;
  }
}

#rankology_stats_editor_meta_box,
#rankology-stats-browsers-widget,
#rankology-stats-comparison-widget,
#rankology-stats-countries-widget,
#rankology-stats-hitsmap-widget,
#rankology-stats-hits-widget,
#rankology-stats-pages-widget,
#rankology-stats-recent-widget,
#rankology-stats-referring-widget,
#rankology-stats-search-widget,
#rankology-stats-summary-widget,
#rankology-stats-words-widget,
#rankology-stats-top-visitors-widget,
#rkns_hits_postbox,
#rkns_top_visitors_postbox,
#rkns_search_postbox,
#rkns_words_postbox,
#rkns_recent_postbox,
#rkns_map_postbox,
#rkns_pages_postbox,
#rkns_summary_postbox,
#rkns_browsers_postbox,
#rkns_referring_postbox,
#rkns_countries_postbox,
#rkns_pages_postbox,
#rankology-stats-models-widget,
#rankology-stats-platforms-widget,
#rankology-stats-quickstats-widget,
#rankology-stats-devices-widget,
#rankology-stats-useronline-widget {
  font-family: $font-base, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen-Sans, Ubuntu, Cantarell, "Helvetica Neue", sans-serif;
  overflow: visible;

  &.postbox.has-focus {
    z-index: 9999;
  }

  .postbox-header {

    h2 {
      font-weight: 600;
      font-size: 14px;
      margin: 0;
      line-height: 1.4;
    }
  }

  button {
    &:focus {
      outline: none;
      box-shadow: none;
    }
  }

  table {
    tr td, tr th {
      white-space: nowrap;
    }
  }

  .handle-actions {
    margin-top: 0 !important;
  }
}

.inside .rankology-stats-widget {
  box-shadow: none;
  margin: 2em 0;
}

.rkns_page .inside {
  font-family: $font-base !important;
}

#rankology-stats-comparison-widget {
  overflow: hidden !important;
}

.rkns_page {

  .wrap:not(.rkns-wrap) {
    margin-right: 0 !important;
    margin-left: 0 !important;
    padding: 0 20px;
  }
}

