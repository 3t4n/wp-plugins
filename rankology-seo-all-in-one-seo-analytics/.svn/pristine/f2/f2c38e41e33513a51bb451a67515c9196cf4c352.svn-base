#rankology_ga_dashboard_widget #rankology-tabs2 .rankology-tab,#rankology_angle_dashboard_widget #rankology-tabs2 .rankology-tab{padding:0}#rankology_ga_dashboard_widget #rankology-tabs2>ul,#rankology_angle_dashboard_widget #rankology-tabs2>ul{border-bottom:1px solid #f6f6f6;margin:10px 0 0 0;width:100%;display:inline-block;background:0 0;border-top:none;border-left:none;border-right:none}#rankology_ga_dashboard_widget #rankology-tabs2 ul li,#rankology_angle_dashboard_widget #rankology-tabs2 ul li{margin:0;padding:0;border:none;background:0 0}#rankology_ga_dashboard_widget #rankology-tabs2 ul li span,#rankology_angle_dashboard_widget #rankology-tabs2 ul li span{color:#72777c;font-weight:700}#rankology_ga_dashboard_widget #rankology-tabs2 ul li a,#rankology_angle_dashboard_widget #rankology-tabs2 ul li a{padding:5px 10px;display:inline-block;color:#191e23;opacity:.5;transition:all .3s linear}#rankology_ga_dashboard_widget #rankology-tabs2 ul li a:hover,#rankology_angle_dashboard_widget #rankology-tabs2 ul li a:hover{opacity:1}#rankology_ga_dashboard_widget #rankology-tabs2 ul .ui-state-active a,#rankology_angle_dashboard_widget #rankology-tabs2 ul .ui-state-active a{background:0 0;opacity:1;outline:0;font-weight:600;position:relative}#rankology_ga_dashboard_widget #rankology-tabs2 ul .ui-state-active a::after,#rankology_angle_dashboard_widget #rankology-tabs2 ul .ui-state-active a::after{border-bottom:2px solid #0085ba;content:'';position:absolute;width:100%;bottom:0;left:0;display:block}#rankology_ga_dashboard_widget .hndle .edit-box,#rankology_angle_dashboard_widget .hndle .edit-box{opacity:1}#rankology_ga_dashboard_widget .wrap-single-stat.col-6,#rankology_angle_dashboard_widget .wrap-single-stat.col-6{padding:15px;border-bottom:1px solid #f0f0f0;width:calc(50% - 31px);display:inline-block}#rankology_ga_dashboard_widget .wrap-single-stat:last-child,#rankology_angle_dashboard_widget .wrap-single-stat:last-child{border-bottom:0}#rankology_ga_dashboard_widget .wrap-single-stat .label-stat,#rankology_angle_dashboard_widget .wrap-single-stat .label-stat{font-size:11px;text-transform:uppercase;display:inline-block;width:100%;padding:5px;font-weight:700;box-sizing:border-box}#rankology_ga_dashboard_widget .wrap-single-stat .label-stat .dashicons,#rankology_angle_dashboard_widget .wrap-single-stat .label-stat .dashicons{vertical-align:middle;font-size:18px}#rankology_ga_dashboard_widget #rkseo-tabs-2 .wrap-single-stat.table-row,#rankology_ga_dashboard_widget #rkseo-tabs-3 .wrap-single-stat.table-row,#rankology_angle_dashboard_widget #rkseo-tabs-2 .wrap-single-stat.table-row,#rankology_angle_dashboard_widget #rkseo-tabs-3 .wrap-single-stat.table-row{padding-top:0;padding-bottom:5px}#rankology_ga_dashboard_widget #rankology-tabs2 .wrap-row-stat,#rankology_angle_dashboard_widget #rankology-tabs2 .wrap-row-stat{width:calc(100% - 2px);position:relative;background-color:#fdfdfd;display:inline-block;margin:0;padding:1em;border-top:1px solid #eee;border-bottom:1px solid #eee;left:-12px}#rankology_ga_dashboard_widget #rankology-tabs2 .wrap-row-stat li,#rankology_angle_dashboard_widget #rankology-tabs2 .wrap-row-stat li{margin:0 0 5px 0;justify-content:space-between;display:flex}#rankology_ga_dashboard_widget .ui-widget-content,#rankology_angle_dashboard_widget .ui-widget-content{border:none;border-radius:0;background:0 0;padding:0;margin:0}#tab_rankology_gsc .rankology-card-title{padding:0;gap:10px;justify-content:start;background:var(--backgroundSecondary);padding:20px;border-radius:8px;margin:20px 0}#tab_rankology_gsc .rankology-card-title h3,#tab_rankology_gsc .rankology-card-title p{margin:0}#tab_rankology_gsc .rankology-card-title .dashicons{font-size:40px;width:40px;height:40px}#notice-insights-alert #tab_rankology_gsc .rankology-card-content,#tab_rankology_gsc{padding:0}#tab_rankology_gsc .rankology-card-content ol{margin:0}#tab_rankology_gsc .rankology-card-content ol li{position:relative;display:flex;justify-content:space-between;margin-bottom:24px;padding-bottom:24px;border-bottom:1px solid var(--backgroundSecondary)}#tab_rankology_gsc .rankology-card-content ol li a{font-weight:700}#tab_rankology_gsc .rankology-card-content ol li img{border-radius:4px;height:72px;margin-bottom:16px;object-fit:cover;width:72px}#tab_rankology_gsc .rankology-card-content ol li:last-child{margin-bottom:0}#tab_rankology_gsc .rankology-card-content ol li .gsc-item{display:flex;justify-content:space-between;gap:20px;width:100%}#tab_rankology_gsc .rankology-card-content ol li .gsc-item .rankology-summary-item{width:inherit;border:inherit;padding:inherit}#tab_rankology_gsc .top-results{background:#eff9f1;color:var(--colorSuccess);padding:4px 8px;border-radius:8px;margin-left:10px;font-weight:500;display:inline-block}#tab_rankology_gsc .rankology-summary-item-label{margin-bottom:inherit}