
#rkns-postbox-container-1 {
  width: 30%;
  float: left;
}

#rkns-postbox-container-2 {
  margin: 0 0 0 1%;
  width: 68%;
  float: right;
}

@media screen and (max-width: 998px) {
  #rkns-postbox-container-1 {
    width: 35%;
  }

  #rkns-postbox-container-2 {
    margin: 0 0 0 1%;
    width: 63%;
  }
}

@media screen and (max-width: 758px) {
  #rkns-postbox-container-1 {
    width: 100%;
  }

  #rkns-postbox-container-2 {
    margin: 0 0 0 1%;
    width: 100%;
  }
}

@media screen and (max-width: 524px) {
  #rkns-postbox-container-1 {
    width: 100%;
  }

  #rkns-postbox-container-2 {
    margin: 0 0 0 1%;
    width: 100%;
  }
}

#rkns-postbox-container-1 a, #rkns-postbox-container-2 a, #rkns-big-postbox a {
  text-decoration: none;
}

/* WP Admin List Table */
.column-rankology-stats-tax-hits {
  width: 15%;
  text-align: center;
}

.column-rankology-stats-post-hits {
  width: 10%;
  text-align: center;
}

.rkns-admin-column__unlock {
  a {
    color: #ffffff;
    font-size: 12px;
    display: flex;
    justify-content: center;

    span {
      background: #347ab6;
      padding: 1px 3px;
      border-radius: 2px;
      position: absolute;
      visibility: hidden;
      font-size: 9px;
      line-height: 14px;
      z-index: 1;
      margin-top: 7px;
    }

    img {
      width: 100%;
      opacity: 0.5;
    }
  }

  a:hover span {
    visibility: visible;
  }
}