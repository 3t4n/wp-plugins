/* Color Style */
.rkns-text-danger {
  color: #DC3545 !important;
}

.rkns-text-success {
  color: #459605 !important;
}

.rkns-text-warning {
  color: #dc6b26 !important;
}

.rkns-text-muted {
  color: #797979 !important;
}

/* Text Center */
.rkns-center {
  text-align: center !important;
}

/* Block */
.rkns-d-none {
  display: none;
}

.rkns-d-inline-block {
  display: inline-block;
}

.rkns-middle-vertical {
  vertical-align: middle;
}

/* disable Break Link */
a[href*='?page=rkns_break_menu'] {
  pointer-events: none;
}

/* Cursor Default */
.rkns-cursor-default {
  cursor: default;
}

/* Button Danger in WordPress Admin */
.wp-core-ui .btn-danger {
  background: rgba(186, 0, 0, 0.74);
  border-color: rgba(170, 0, 0, 0.77) rgba(153, 0, 0, 0.74) rgba(153, 0, 0, 0.74);
  box-shadow: 0 1px 0 rgba(153, 0, 0, 0.74);
  color: #fff;
  text-decoration: none;
  text-shadow: 0 -1px 1px rgba(153, 0, 0, 0.74), 1px 0 1px rgba(153, 0, 0, 0.74), 0 1px 1px rgba(153, 0, 0, 0.74), -1px 0 1px rgba(153, 0, 0, 0.74);

  &:hover {
    background: #c20000;
    border-color: #990000;
    color: #fff;
  }

  &:active {
    background: rgba(170, 0, 0, 0.75);
    border-color: rgba(153, 0, 0, 0.74);
    box-shadow: inset 0 2px 0 rgba(153, 0, 0, 0.75);
  }

  &:focus {
    box-shadow: 0 1px 0 rgba(170, 0, 0, 0.75), 0 0 2px 1px rgba(219, 51, 51, 0.75);
    background: rgba(194, 0, 0, 0.75);
    border-color: rgba(153, 0, 0, 0.75);
    color: #fff;
    outline: 0 !important;
  }
}

.rkns-btn-inline {
  vertical-align: -2px;
  margin: 0 5px;
}

/* Margin */
.rkns-m-top-20 {
  margin-top: 20px;
}

/* Text Wrap */
.rkns-text-wrap {
  display: inline-block;
  overflow: hidden;
  white-space: nowrap;
  width: 100% !important;
}

/* Width 100% */
.rkns-width-100 {
  width: 100% !important;
}

.rkns-200-px {
  width: 200px !important;;
}

/* inline */
.rkns-inline {
  display: inline;
}

/* Admin Page Title */
.rkns_page_title {
  display: inline-block;
  vertical-align: -15px;
  margin-top: 10px;
  margin-bottom: 10px;
  margin-right: 5px;
}

.rkns_title {
  display: inline;
  font-size: 1.6em;
}

.rankology-stats-container {
  margin: 0 auto;
}

/* Float */
.rkns-pull-right {
  float: right;
}

.rkns-pull-left {
  float: left;
}