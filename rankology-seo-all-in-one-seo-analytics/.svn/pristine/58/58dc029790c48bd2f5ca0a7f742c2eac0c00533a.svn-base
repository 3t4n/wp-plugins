<?php

namespace RankologyFno\Services\Options\Schemas;

defined('ABSPATH') or exit('Cheatin&#8217; uh?');

trait PublisherOptions {
    /**
     * 
     *
     * @return string
     */
    public function getArticlesPublisherLogo() {
        return $this->searchOptionByKey('rankology_rich_snippets_publisher_logo');
    }

    /**
     * 
     *
     * @return string
     */
    public function getArticlesPublisherLogoWidth() {
        return $this->searchOptionByKey('rankology_rich_snippets_publisher_logo_width');
    }

    /**
     * 
     *
     * @return string
     */
    public function getArticlesPublisherLogoHeight() {
        return $this->searchOptionByKey('rankology_rich_snippets_publisher_logo_height');
    }
}
