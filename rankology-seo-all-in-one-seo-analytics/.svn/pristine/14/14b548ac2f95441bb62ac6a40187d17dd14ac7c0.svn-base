/**
    MetaBox Visitors Style
     */
.rkns-meta-box-footer {
  border-top: 1px solid #C3C4C7;
  margin: 10px -12px 0;
}

#rankology-stats-pages-chart-widget .rkns-meta-box-footer {
  margin: 10px -4px 0 !important;
}

.rkns-fade-effect {
  max-height: 210px !important;
  overflow: hidden;
}

.rkns-fade-effect::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: 0;
  pointer-events: none;
  background-image: linear-gradient(to bottom, rgba(255, 255, 255, 0), rgb(255, 255, 255) 75%);
  width: 100%;
  height: 5em;
}

.rkns-load-more {
  position: absolute;
  bottom: 20px;
  z-index: 1;
  text-align: center;
  width: 100%;
  display: none;
}

.rkns-fade-effect .rkns-load-more {
  display: block;
}

.rkns-load-more .button-primary {
  padding: 5px 10px 7px !important;
  font-size: 12px !important;
}