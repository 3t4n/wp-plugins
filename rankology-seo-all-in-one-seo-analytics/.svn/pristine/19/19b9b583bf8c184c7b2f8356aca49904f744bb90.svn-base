.rkns-mini-chart-settings-wrap input[type="text"].wp-color-picker,
.rkns-rest-api-settings-wrap input[type="text"].wp-color-picker,
.rkns-customization-settings-wrap input[type="text"].wp-color-picker,
.rkns-realtime-stats-settings-wrap input[type="text"].wp-color-picker {
  padding: 2px 3px !important;
}

.rkns-wrap label {
  color: #000;
}

.rkns-wrap td .description {
  margin-top: 12px !important;
  color: #5b5b5b;
}

.rkns-wrap select + input[type="submit"],
.rkns-wrap select + button {
  margin-left: 4px;
}

.rkns-flag {
  width: 18px;
  border-radius: 2px;
  overflow: hidden;
}

.rkns-page-header {
  position: relative;
  margin: -20px;
  margin-bottom: 20px;
  padding: 20px;
  background: #fff;
  padding-bottom: 0;
}

.rkns-datepicker {
  position: absolute;
  top: 0px;
  right: 20px;
}

.rkns-tabs {
  margin: 0;
  margin-top: 20px;
}

.rkns-tab-link {
  display: inline-block;
  position: relative;
}

.rkns-tab-link a {
  padding: 10px;
  color: #56585a;
  text-decoration: none;
  font-size: 13px;
  line-height: 24px;
  font-weight: 500;
  text-transform: capitalize;
}

.rkns-tab-link.current a {
  color: #404bf2;
  border-bottom: 2px solid #404bf2;
}

.rkns-tab-link.rkns-locked a {
  padding-right: 30px;
}

.rkns-tab-link.rkns-locked a:after {
  content: "";
  position: absolute;
  width: 17px;
  height: 17px;
  background: url("../images/preview-lock.png");
  background-size: auto;
  background-size: contain;
  margin-left: 4px;
  margin-top: 3px;
}

.c-pages-date-range {
  margin-top: 20px;
  height: 28px;
  overflow: hidden;
}

.c-pages-date-range .js-date-range-picker-input {
  position: relative !important;
  top: -15px !important;
  left: 0 !important;
}

.c-pages-select-page {
  margin-top: 4px;

  @media screen and (min-width: 768px) {
    float: right;
  }

  form {
    margin-top: 0;
  }
}

.rtl .c-pages-select-page {
  @media screen and (min-width: 768px) {
    float: left;
  }
}

#dashboard-widgets {
  .rkns-refresh {
    line-height: unset !important;
    width: auto;
    height: auto;
    padding: 5px;
    position: relative;
    top: -1px;
    border-radius: 100%;

    &::after {
      content: attr(data-tooltip);
      visibility: hidden;
      width: 37px;
      background-color: $white-color;
      box-shadow: 0 0 12px 1px rgba(0, 0, 0, 0.07);
      border-radius: 4px;
      color: $dim-black-color;
      text-align: center;
      padding: 6px 6px;
      border-radius: 6px;
      /* Position the tooltip text - see examples below! */
      position: absolute;
      z-index: 1;
      top: 110%;
      left: 50%;
      margin-left: -40px;
      font-weight: 400;
      font-size: 10px;
      line-height: 12px;
    }

    &:hover {
      &::after {
        visibility: visible;
      }
    }
  }
}
