.rkns-wrap .postbox {
  background: #ffffff;
  border: 0;
  border-radius: 8px;

  &:focus-within,
  &.has-focus {
    z-index: 99;
    position: relative;
  }
}

.rkns-wrap .postbox-header {
  border-bottom: 1px solid #e7e7e7;
}

.rkns-wrap .thickbox.button,
.rkns-wrap .button {
  background: #fff;
  border: 1px solid #d6d6d6;
  box-sizing: border-box;
  box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.05);
  border-radius: 2px;
  color: #000;
  transition: 0.2s;
  margin: 10px 0;
}

.rkns-wrap .rknsms-button-group {
  margin-top: 20px;
}

.rkns-wrap .button:hover {
  background: #fff;
  border-color: #404bf2;
  color: #000;
}

.rkns-wrap .button,
.rkns-wrap .thickbox.button {
  font-weight: 600 !important;
  font-size: 14px;
  line-height: 17px;
  padding: 15px 24px;
  border-radius: 2px;
  transition: 0.2s;
}

.rtl .rkns-wrap .button {
  font-weight: 600 !important;
  font-size: 14px;
  line-height: 17px;
  padding: 15px 16px;
  border-radius: 2px;
  transition: 0.2s;
}

.rkns-wrap .button:disabled {
  background-color: #808080 !important;
}

.rkns-wrap .button-primary {
  font-weight: 600 !important;
  font-size: 14px;
  line-height: 17px;
  padding: 15px 24px;
  border-radius: 2px;
  transition: 0.2s;
  background: #404bf2;
  border-color: #404bf2;
  color: #fff !important;
  margin: 10px 0;
}

.rkns-wrap textarea {
  max-width: calc(100% - 45px);
}

.rkns-wrap .button-primary:hover {
  background-color: #7b460a;
  border-color: #7b460a;
}

.rkns-wrap .button:focus {
  background-color: #fff;
  border-color: #7b460a;
  color: #000 !important;
  box-shadow: 0 0 0 1px #7b460a;
  outline: 2px solid transparent;
}

.rkns-wrap .button-primary:focus {
  background-color: #7b460a;
  border-color: #7b460a;
  box-shadow: 0 0 0 1px #7b460a;
  outline: 2px solid transparent;
  color: #fff !important;
}

.rkns-wrap input[type="checkbox"]:focus {
  box-shadow: none !important;
  outline: unset !important;
}

.rkns-wrap,
.chosen-container-multi .chosen-choices {
  input[type="text"],
  input[type="password"],
  input[type="number"],
  select {
    padding: 12px 16px !important;
    font-weight: normal;
    font-size: 14px;
    line-height: 20px;
    border: 1px solid #5b5b5b !important;
    box-sizing: border-box;
    border-radius: 2px;
  }

  select {
    padding: 12px 24px 12px 8px !important;

    option {
      font-family: $font-base;
    }
  }
}

.rtl .rkns-wrap select {
  padding: 12px 8px 12px 24px !important;
}

.rkns-wrap input[type="text"]:focus,
.rkns-wrap input[type="number"]:focus,
.rkns-wrap select:focus {
  border-color: #404bf2;
  box-shadow: 0 0 0 1px #404bf2;
  outline: 2px solid transparent;
}

.rkns-wrap input[type="text"]::placeholder,
.rkns-wrap input[type="number"]::placeholder,
.rkns-wrap select::placeholder {
  font-weight: normal;
  font-size: 14px;
  line-height: 20px;
  color: #000000;
}

.rkns-wrap input[type="checkbox"],
.rkns-wrap input[type="radio"] {
  background: #fff;
  width: 24px;
  height: 24px;
  border-radius: 2px;
  border: 1px solid #5b5b5b !important;
  transition: 0.2s;
}

.rkns-wrap input[type="radio"] {
