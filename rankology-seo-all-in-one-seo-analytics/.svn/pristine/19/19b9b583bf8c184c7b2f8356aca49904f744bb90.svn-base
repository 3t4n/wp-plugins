.rkns-wrap__main {
  padding: 20px 8px;

  @media screen and (min-width: 768px) {
    padding: 20px;
  }
}

.rkns-wrap {
  .postbox {
    padding: 0;

    .postbox-header {
      padding: 10px 20px 10px 32px;

      h2 {
        padding: 0;
      }
    }
  }

  &.postbox {
    padding: 0;

    .postbox-header {
      padding: 4px 20px 4px 32px;

      h2 {
        padding: 0;
      }
    }
  }

  .inside {
    overflow-x: visible;

    @media screen and (min-width: 768px) {
      overflow-x: visible;
    }

    table {
      td {
        white-space: nowrap;
      }
    }
  }
}

.rkns-wrap .postbox table tr:first-child th h3 {
}

.toplevel_page_rkns_overview_page .rkns-wrap,
.statistics_page_rkns_hits_page .rkns-wrap,
.statistics_page_rkns_online_page .rkns-wrap,
.statistics_page_rkns_online_page .rkns-wrap,
.statistics_page_rkns_referrers_page .rkns-wrap,
.statistics_page_rkns_words_page .rkns-wrap,
.statistics_page_rkns_visitors_page .rkns-wrap,
.statistics_page_rkns_searches_page .rkns-wrap,
.statistics_page_rkns_pages_page .rkns-wrap,
.statistics_page_rkns_categories_page .rkns-wrap,
.statistics_page_rkns_taxonomies_page .rkns-wrap,
.statistics_page_rkns_countries_page .rkns-wrap,
.statistics_page_rkns_tags_page .rkns-wrap,
.statistics_page_rkns_authors_page .rkns-wrap,
.statistics_page_rkns_browser_page .rkns-wrap,
.statistics_page_rkns_platform_page .rkns-wrap,
.statistics_page_rkns_top-visitors_page .rkns-wrap,
.statistics_page_rkns_optimization_page .rkns-wrap,
.statistics_page_rkns_settings_page .rkns-wrap,
.statistics_page_rkns_plugins_page .rkns-wrap,
.rkns_page .rkns-wrap {
  margin: 0 !important;
}

.toplevel_page_rkns_overview_page #wpcontent,
.statistics_page_rkns_hits_page #wpcontent,
.statistics_page_rkns_online_page #wpcontent,
.statistics_page_rkns_visitors_page #wpcontent,
.statistics_page_rkns_referrers_page #wpcontent,
.statistics_page_rkns_words_page #wpcontent,
.statistics_page_rkns_searches_page #wpcontent,
.statistics_page_rkns_pages_page #wpcontent,
.statistics_page_rkns_categories_page #wpcontent,
.statistics_page_rkns_taxonomies_page #wpcontent,
.statistics_page_rkns_countries_page #wpcontent,
.statistics_page_rkns_tags_page #wpcontent,
.statistics_page_rkns_authors_page #wpcontent,
.statistics_page_rkns_browser_page #wpcontent,
.statistics_page_rkns_platform_page #wpcontent,
.statistics_page_rkns_top-visitors_page #wpcontent,
.statistics_page_rkns_optimization_page #wpcontent,
.statistics_page_rkns_settings_page #wpcontent,
.statistics_page_rkns_plugins_page #wpcontent,
.rkns_page #wpcontent {
  padding: 0 !important;
}

.toplevel_page_rkns_overview_page #wpbody-content > .notice,
.statistics_page_rkns_hits_page #wpbody-content > .notice,
.statistics_page_rkns_online_page #wpbody-content > .notice,
.statistics_page_rkns_visitors_page #wpbody-content > .notice,
.statistics_page_rkns_referrers_page #wpbody-content > .notice,
.statistics_page_rkns_words_page #wpbody-content > .notice,
.statistics_page_rkns_searches_page #wpbody-content > .notice,
.statistics_page_rkns_pages_page #wpbody-content > .notice,
.statistics_page_rkns_categories_page #wpbody-content > .notice,
.statistics_page_rkns_taxonomies_page #wpbody-content > .notice,
.statistics_page_rkns_countries_page #wpbody-content > .notice,
.statistics_page_rkns_tags_page #wpbody-content > .notice,
.statistics_page_rkns_authors_page #wpbody-content > .notice,
.statistics_page_rkns_browser_page #wpbody-content > .notice,
.statistics_page_rkns_platform_page #wpbody-content > .notice,
.statistics_page_rkns_top-visitors_page #wpbody-content > .notice,
.statistics_page_rkns_optimization_page #wpbody-content > .notice,
.statistics_page_rkns_settings_page #wpbody-content > .notice,
.statistics_page_rkns_plugins_page #wpbody-content > .notice,
.rkns_page #wpbody-content > .notice {
  margin: 20px !important;
}

.statistics_page_rkns_pages_page {
  .o-wrap.o-wrap--no-data {
    text-align: center;
    margin-bottom: 24px;
  }
}

.statistics_page_rkns_plugins_page .rkns-wrap .notice {
  margin: 20px !important;
}

.rkns-wrap__main .notice {
  margin: 20px 0 !important;
}

.rkns-header-banner {
  width: 100%;
  box-sizing: border-box;
  position: relative;
  z-index: -1;
  background: url("../images/page-header.svg") no-repeat top left / cover;
  display: flex;
  justify-content: flex-start;
  align-items: center;
  padding: 16px 20px;

  .rkns-header-icon {
    width: 160px;
    height: 40px;
    background-position: center;
    background-repeat: no-repeat;
    background-size: contain;
    background: url("../images/white-header-icon.png") no-repeat center center / contain;
  }
}

.toplevel_page_rkns_overview_page .rkns-header-banner {
  transform: translateY(-5px);
  @media screen and (max-width: 782px) {
    transform: translateY(-10px);
  }
}

@media screen and (max-width: 400px) {
  .rkns-header-banner {
    padding-top: 40px;
  }
}

#screen-meta-links + br + .rkns-wrap .rkns-header-banner {
  transform: translateY(-31px);
  z-index: -1;
  position: relative;
  min-height: 150px;
}

#screen-meta-links + br + .rkns-wrap .rkns-wrap__main {
  transform: translateY(-31px);
}

.rkns-wrap input[type="text"].small-text {
  padding: 12px 8px !important;
  min-width: 80px;
}

.rkns-wrap .notice:not(.hidden) {
  padding: 2px 14px;
  border-radius: 4px;
  color: #242a31;
  font-weight: normal;
  font-size: 14px;
  line-height: 24px;
  border: 1px solid #d6d6d6;
  box-sizing: border-box;
  border-left: 6px solid #f2bb08;
  box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.08);
  margin: 10px 0 24px;
  display: flex;
  align-items: flex-start;

  &.notice-success {
    border-left-color: #22bb3f;
  }

  &.notice-error {
    border-left-color: #ff0000;
  }

  &.notice-info {
    border-left-color: #0090ad;
  }
}

.rkns-wrap .notice::before {
  content: "";
  min-width: 20px;
  min-height: 20px;
  display: inline-block;
  vertical-align: middle;
  margin-right: 10px;
  margin-top: 10px;
  background: center center/auto no-repeat;
  background-image: url("data:image/svg+xml,%3Csvg width='20' height='20' viewBox='0 0 20 20' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill-rule='evenodd' clip-rule='evenodd' d='M10 0C4.47715 0 0 4.47715 0 10C0 15.5228 4.47715 20 10 20C15.5228 20 20 15.5228 20 10C20 7.34784 18.9464 4.8043 17.0711 2.92893C15.1957 1.05357 12.6522 0 10 0ZM11 13.5C11 13.7761 10.7761 14 10.5 14H9.5C9.22386 14 9 13.7761 9 13.5V12.5C9 12.2239 9.22386 12 9.5 12H10.5C10.7761 12 11 12.2239 11 12.5V13.5ZM10.53 10C10.6572 10.0009 10.7647 9.90624 10.78 9.78L11.18 6.56C11.1972 6.41735 11.1523 6.27417 11.0566 6.16698C10.9609 6.05979 10.8237 5.99896 10.68 6H9.32C9.17631 5.99896 9.03912 6.05979 8.94342 6.16698C8.84771 6.27417 8.80275 6.41735 8.82 6.56L9.22 9.78C9.23526 9.90624 9.34284 10.0009 9.47 10H10.53Z' fill='%23F2BB08'/%3E%3C/svg%3E%0A");
}

