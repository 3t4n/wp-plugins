.rankology-google-suggestions #rankology_suggestions {
    display: inline-block;
    width: 100%;
    margin: 0;
    height: auto;
}

.rankology-google-suggestions .rkseo-tooltip {
    position: relative;
    margin-left: 5px;
    display: inline-block;
    cursor: help;
    vertical-align: bottom;
    text-align: left;
    background: 0 0;
    border: none;
    padding: 0;
}

.rankology-google-suggestions .rkseo-tooltip .rkseo-tooltiptext {
    visibility: hidden;
    position: absolute;
    z-index: 999999999;
    width: 300px;
    right: -260px;
    padding: 20px;
    top: 25px;
    font-weight: 400;
    box-shadow: 0 3px 30px rgba(25, 30, 35, .1);
    border: 1px solid #e2e4e7;
    background: #fff;
    word-break: break-word;
    text-transform: none;
}

.rankology-google-suggestions .rkseo-tooltip .rkseo-tooltiptext::before {
    border: 8px solid #e2e4e7;
    top: -8px;
}

.rankology-google-suggestions .rkseo-tooltip .rkseo-tooltiptext::after {
    border: 8px solid #fff;
    top: -6px;
}

.rankology-google-suggestions .rkseo-tooltip .rkseo-tooltiptext::after,
.rankology-google-suggestions .rkseo-tooltip .rkseo-tooltiptext::before {
    border-bottom-style: solid;
    border-left-color: transparent;
    border-right-color: transparent;
    border-top: none;
    margin-left: -10px;
    content: "";
    position: absolute;
    height: 0;
    width: 0;
    line-height: 0;
    left: 30px;
}

.rankology-google-suggestions .rkseo-tooltip .rkseo-tooltip-headings {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 20px;
    display: block;
}

.rankology-google-suggestions .rkseo-tooltip .rkseo-tooltip-desc {
    margin-bottom: 20px;
    display: block;
    border-bottom: 1px solid #e2e4e7;
    padding-bottom: 20px;
    font-size: 13px;
}

.rankology-google-suggestions .rkseo-tooltip .rkseo-tooltip-code {
    font-family: Menlo, Monaco, Andale Mono, Courier New, monospace;
    display: block;
    word-break: break-all;
    color: #1a7a06;
    font-size: 11px;
}

.rankology-google-suggestions #rankology_google_suggest_kw_meta {
    width: 100%;
    margin: 5px 0;
}

.rankology-google-suggestions label[for=rankology_google_suggest_kw_meta] {
    width: 100%;
    margin: 0;
}

.rankology-google-suggestions .elementor-button.elementor-button-default,
#rankology_ai_generate_seo_meta.elementor-button.elementor-button-default {
    background-color: #0071a1;
}

.rankology-google-suggestions .elementor-button.elementor-button-default:hover,
#rankology_ai_generate_seo_meta.elementor-button.elementor-button-default:hover {
    background-color: #0071a1;
    opacity: 0.8;
}

.rankology-google-suggestions #rankology_suggestions li {
    list-style: none;
    margin: 5px;
    display: inline-block;
    border: 1px solid #0073aa;
    border-radius: 3px;
    white-space: nowrap;
    min-height: 26px;
    line-height: 2.18181818;
    padding: 0 8px;
    font-size: 11px;
    background: #f3f5f6;
}

.rankology-google-suggestions #rankology_suggestions li:hover {
    background: #f1f1f1;
    border-color: #016087;

}

.rankology-google-suggestions #rankology_suggestions li a {
    color: #0073aa;
}

.rankology-google-suggestions #rankology_suggestions li a:hover {
    text-decoration: none;
}

.rankology-google-suggestions .rkseo-tooltip .dashicons {
    color: #666;
}

.elementor-control-field.rankology-google-suggestions .rkseo-tooltip:hover .rkseo-tooltiptext,
.elementor-control-field.rankology-google-suggestions .rkseo-tooltip:focus .rkseo-tooltiptext,
.elementor-control-field.rankology-google-suggestions .rkseo-tooltip:active .rkseo-tooltiptext {
    visibility: visible;
}
