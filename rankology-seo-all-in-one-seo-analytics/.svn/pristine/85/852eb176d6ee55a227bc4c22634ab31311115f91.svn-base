defined('ABSPATH') or exit('Please don&rsquo;t call the plugin directly. Thanks :)');

function rkseo_print_section_info_woocommerce() {
  //  rankology_print_pre_section('woocommerce');

    if ( ! is_plugin_active('woocommerce/woocommerce.php')) { ?>

        <div class="rankology-notice is-warning">
            <p><?php esc_html_e('You need to enable <strong>WooCommerce</strong> to apply these settings.', 'wp-rankology'); ?></p>
        </div>

        <?php
    }
}
