body .rankology-text-letter-counter .wrap-rankology-counters,
body .rankology-styles .wrap-rankology-counters {
    background: #34383c;
}

body .rankology-text-letter-counter .rkseo-progress,
body .rankology-setup .rkseo-progress,
body .rankology-styles .rkseo-progress {
    background: #34383c;
}

body .google-snippet-preview .wrap-snippet {
    padding: 5px;
    background: #fff;
    width: 100%;
}

body .elementor-control-field.google-snippet-box .google-snippet-preview {
    display: block;
    width: 100%;
}

body .analysis-score p>span {
    color: #fff;
}

body .elementor-control-field.rankology-content-analyses .gr-analysis-title button {
    background: #6d7882;
    color: #fff;
}

body .elementor-control-field.rankology-content-analyses .gr-analysis-title {
    border-top: 1px solid #3f4348;
}

body .elementor-control-field.rankology-content-analyses .gr-analysis-title button {
    background: inherit;
}

body .elementor-control-field.rankology-content-analyses .gr-analysis-title {
    border-top: 1px solid #64666a;
}

body .elementor-control-field.rankology-content-analyses .gr-analysis-content {
    border-top: 1px solid #64666a;
}

body .elementor-control-field.rankology-content-analyses .gr-analysis-title button:hover {
    background: #34383c;
}

body .elementor-control-field.rankology-content-analyses a {
    color: inherit;
}

body .elementor-control-field.rankology-content-analyses h3,
body .elementor-control-field.rankology-content-analyses h4 {
    color: inherit;
    background: #3f4348;
}

body .elementor-control-field.rankology-content-analyses h4 {
    border-bottom: 1px solid #64666a;
}

body .elementor-control-field.rankology-content-analyses .gr-analysis-title button:focus {
    color: #fff;
}
