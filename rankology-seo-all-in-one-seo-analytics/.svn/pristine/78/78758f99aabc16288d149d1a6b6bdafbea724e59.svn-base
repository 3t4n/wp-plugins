#wpadminbar #wp-admin-bar-wp-statistic-menu .ab-icon:before{content:'\f184';top:2px}#wp-admin-bar-rankology-stats-menu-page{text-align:center}#wp-admin-bar-rankology-stats-menu-page .ab-item{height:auto !important}#wp-admin-bar-rankology-stats-menu-page a{padding-bottom:4px !important}#wp-admin-bar-rankology-stats-menu-page a img{max-width:200px}#wp-admin-bar-rankology-stats-menu-page .rkns-admin-bar__chart__unlock-button{background-color:#2f5a82;padding:1px 0px;color:#ffffff;line-height:21px;font-size:12px;border-radius:2px;display:table;margin:0 auto;width:100%}
