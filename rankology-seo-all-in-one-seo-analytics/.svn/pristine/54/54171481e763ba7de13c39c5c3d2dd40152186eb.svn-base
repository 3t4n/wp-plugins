#rankology-stats-comparison-widget {
  .inside {
    margin: 0 !important;
  }
}

.rkns_comparison_widget {
  color: #0C0C0D;
  position: relative;
  display: flex;
  min-height: 150px;
  align-items: center;
  overflow: hidden;
}

.rkns_comparison_widget .animated_bg {
  position: absolute;
  height: 100%;
  width: 150px;
  left: -88px;
  top: 0;

  @media screen and (min-width: 650px) {
    height: 150px;
    width: 150px;
  }
}

.rkns_comparison_widget .animated_bg::before {
  content: '';
  background: #fdecd9;
  width: 150px;
  height: 150px;
  position: absolute;
  left: 0;
  top: 0;
  transform-origin: center;
  border-radius: 50%;
  animation: animated_bg_coparison 30s ease infinite;
}

.rkns_comparison_widget .animated_bg::after {
  content: '';
  background: #e4a051;
  width: 100px;
  height: 100px;
  position: absolute;
  left: 25px;
  top: 25px;
  border-radius: 50%;
}

@keyframes animated_bg_coparison {
  0% {
    transform: scale(1);
  }
  5% {
    transform: scale(1.1);
  }
  5% {
    transform: scale(1);
  }
  15% {
    transform: scale(1.1);
  }
  20% {
    transform: scale(1);
  }
  25% {
    transform: scale(1.1);
  }
  30% {
    transform: scale(1);
  }
  35% {
    transform: scale(1.1);
  }
  40% {
    transform: scale(1);
  }
  45% {
    transform: scale(1.1);
  }
  50% {
    transform: scale(1);
  }
  55% {
    transform: scale(1.1);
  }
  60% {
    transform: scale(1);
  }
  65% {
    transform: scale(1.1);
  }
  70% {
    transform: scale(1);
  }
  75% {
    transform: scale(1.1);
  }
  80% {
    transform: scale(1);
  }
  85% {
    transform: scale(1.1);
  }
  90% {
    transform: scale(1);
  }
  95% {
    transform: scale(1.1);
  }
  100% {
    transform: scale(1);
  }
}

.rkns_comparison_widget .main {
  display: flex;
  position: relative;
  z-index: 2;
  flex-grow: 1;
  padding-left: 40px;
  flex-wrap: wrap;

  @media screen and (min-width: 340px) {
    padding-left: 24px;
  }

  @media screen and (min-width: 650px) {
    padding-left: 48px;
    flex-wrap: nowrap;
    overflow-x: auto;
    padding-bottom: 12px;
  }

  @media screen and (min-width: 1120px) {
    padding-left: 32px;
  }

  @media screen and (min-width: 1350px) {
    padding-left: 56px;
    padding-right: 16px;
  }

  scroll-behavior: smooth;
  scrollbar-width: thin;
  scrollbar-color: #DADCE0 $light-tertiary-color;

  /* width */
  &::-webkit-scrollbar {
    width: 4px !important;
    border-radius: 2px !important;
  }

  /* Track */
  &::-webkit-scrollbar-track {
    width: 4px !important;
    background: $light-tertiary-color !important;
  }

  /* Handle */
  &::-webkit-scrollbar-thumb {
    border: 5px solid transparent;
    border-radius: 100px;
    background-color: #DADCE0;
    background-clip: content-box;
  }
}

.rkns_comparison_widget .col {
  flex: 50%;
  max-width: calc(50% - 34px);
  border-right: 1px solid #EEEFF1;
  border-bottom: 1px solid #EEEFF1;
  padding: 0 16px 0 16px;
  min-height: 150px;
  display: inline-flex;
  justify-content: center;
  flex-direction: column;

  @media screen and (max-width: 350px) {
    max-width: calc(100% - 34px);
  }

  &:nth-child(2) {
    border-right: 0;
  }

  @media screen and (min-width: 650px) {
    max-width: unset;
    border-bottom: 0;
    display: block;
    min-height: unset;
    flex: calc(25% - 1px);
    border-right: 1px solid #EEEFF1;

    &:nth-child(2) {
      border-right: 1px solid #EEEFF1;
    }
  }

  @media screen and (min-width: 1120px) {
    padding: 0 12px 0 12px;
    flex: calc(27.33% - 1px);

    &:first-child {
      flex: calc(18% - 1px);
    }
  }

  @media screen and (min-width: 1350px) {
    padding: 0 30px 0 30px;
  }

  @media screen and (min-width: 1920px) {
    padding: 0 56px 0 56px;
  }
}

.rkns_comparison_widget .col:last-child {
  border-right: none;
}

.rkns_comparison_widget .col__title {
  font-style: normal;
  font-weight: 400;
  font-size: 14px;
  line-height: 16px;
  margin: 0 0 8px;
  white-space: nowrap;
}

.rkns_comparison_widget .col__num {
  font-style: normal;
  font-weight: 500;
  font-size: 30px;
  line-height: 35px;
  margin: 0;
}

.rkns_comparison_widget .col__num--lg {
  font-style: normal;
  font-weight: 500;
  font-size: 55px;
  line-height: 64px;
  margin: 14px 0 0;
  color: #a65900;

  @media screen and (max-width: 450px) {
    margin-top: 6px;
  }
}

.rkns_comparison_widget .col__diffs {
  display: flex;
  align-items: center;
  margin: 16px 0 0;

  .diffs__change {
    display: flex;
    align-items: center;

    .diffs__change__direction {
      background-color: #EEEFF1;
      width: 20px;
      height: 20px;
      border-radius: 2px;
      font-size: 14px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-right: 4px;
      color: #808080;

      span {
        font-size: 14px;
        line-height: 20px;
      }
    }

    .diffs__change__value {
      margin-right: 6px;
      font-weight: 400;
      font-size: 12px;
      line-height: 12px;
      display: inline-flex;
    }

    &.minus {
      .diffs__change__direction {
        background-color: #FCECEB;
        color: #D74037;

        span {
          font-size: 12px;
          line-height: 20px;
        }

        span {
          transform: rotate(180deg);
          transform-origin: center;
        }
      }

      .diffs__change__value {
        color: #D74037;

        &::before {
          content: '-';
          font-size: 13px;
        }
      }
    }

    &.plus {

      .diffs__change__direction {
        background-color: #fdecd9;
        color: #a65900;

        span {
          font-size: 12px;
          line-height: 20px;
        }
      }

      .diffs__change__value {
        color: #a65900;

        &::before {
          content: '+';
          font-size: 13px;
        }
      }
    }

    &.minus, &.plus {
      .diffs__change__value, .diffs__change__value {

        &::after {
          content: '%';
        }
      }
    }
  }

  .diffs__desc {
    white-space: nowrap;
    font-style: normal;
    font-weight: 400;
    font-size: 11px;
    line-height: 12px;
    color: #56585A;
  }
}

@media screen and (min-width: 350px) {

  #side-sortables #rankology-stats-comparison-widget {
    .rkns_comparison_widget .main {
      flex-wrap: wrap !important;
      overflow: hidden;
      padding-left: 32px;
      padding-right: 0;
      padding-bottom: 0;
    }

    .rkns_comparison_widget .col {
      flex: 50%;
      max-width: calc(50% - 34px);
      border-right: 1px solid #EEEFF1;
      border-bottom: 1px solid #EEEFF1;
      padding: 0 16px 0 16px;
      min-height: 150px;
      display: inline-flex;
      justify-content: center;
      flex-direction: column;

      &:nth-child(3), &:nth-child(4) {
        border: 0;
      }

      &:nth-child(3) {
        border-right: 1px solid #EEEFF1;
      }

      &:nth-child(2) {
        border-right: none;
      }

      .diffs__desc {
        font-size: 10px;
      }

      .col__num--lg {
        margin-top: 6px;
      }

      .diffs__change__direction {
        width: 16px;
        height: 16px;

        span {
          width: 16px;
          height: 16px;
          font-size: 10px;
          line-height: 16px;
        }
      }
    }
  }
}

.rtl {
  .diffs__change__direction {
    margin-right: 0 !important;
    margin-left: 4px;
  }

  .diffs__change__value {
    margin-right: 0 !important;
    margin-left: 6px;
  }

  .rkns_comparison_widget .col {
    flex: 50%;
    max-width: calc(50% - 34px);
    border-left: 1px solid #EEEFF1;
    border-bottom: 1px solid #EEEFF1;
    padding: 0 16px 0 16px;
    min-height: 150px;
    display: inline-flex;
    justify-content: center;
    flex-direction: column;

    &:nth-child(1), &:nth-child(3) {
      border-right: 0 !important;
    }

    @media screen and (max-width: 350px) {
      max-width: calc(100% - 34px);
      border-right: 0 !important;
    }

    &:nth-child(2), &:nth-child(4) {
      border-left: 0;
    }

    @media screen and (min-width: 650px) {
      max-width: unset;
      border-bottom: 0;
      display: block;
      min-height: unset;
      flex: calc(25% - 1px);
      border-right: 0 !important;
      border-left: 1px solid #EEEFF1;

      &:nth-child(2) {
        border-left: 1px solid #EEEFF1;
      }
    }
  }

  .rkns_comparison_widget .animated_bg {
    position: absolute;
    height: 100%;
    width: 150px;
    left: 0 !important;
    right: -88px;
    top: 0;

    @media screen and (min-width: 650px) {
      height: 150px;
      width: 150px;
    }
  }

  .rkns_comparison_widget .main {
    padding-right: 48px;
    padding-left: 0 !important;

    @media screen and (min-width: 1120px) {
      padding-right: 32px;
    }

    @media screen and (min-width: 1350px) {
      padding-right: 56px;
      padding-left: 16px;
    }
  }
}