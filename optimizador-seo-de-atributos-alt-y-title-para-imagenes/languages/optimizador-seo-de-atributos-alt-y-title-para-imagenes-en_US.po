#: admin_menu
msgid "Optimizador SEO de Atributos Alt y Title para Imágenes"
msgstr "Optimizador SEO de Atributos Alt y Title para Imágenes"

#: admin_menu
msgid "Optimizador SEO Alt y Title"
msgstr "SEO Optimizer Alt and Title"

#: settings_section
msgid "Configuración del Plugin"
msgstr "Plugin Settings"

#: enable_function_label
msgid "Habilitar Función"
msgstr "Enable Functionality"

#: enable_function_description
msgid ""
"Habilitar o deshabilitar la modificación automática de los atributos alt y "
"title de las imágenes."
msgstr ""
"Enable or disable the automatic modification of image alt and title attributes."

#: attribute_option_label
msgid "Opciones de Atributo de Imagen"
msgstr "Image Attribute Options"

#: attribute_option_description
msgid "Selecciona cómo deseas asignar los atributos alt y title de las imágenes."
msgstr "Select how you want to assign the alt and title attributes of images."

#: custom_template_option
msgid "Plantilla Personalizada"
msgstr "Custom Template"

#: page_title_and_focus_keyword_option
msgid "Título de la Página y Palabra Clave de Yoast"
msgstr "Page Title and Yoast Focus Keyword"

#: filename_option
msgid "Nombre de Archivo"
msgstr "Filename"

#: page_title_option
msgid "Título de la Página"
msgstr "Page Title"

#: custom_template_description
msgid ""
"Usa etiquetas como %%filename%%, %%posttitle%%, %%sitetitle%%, %%yoastfocuskw%%, "
"%%rankmathfocuskw%% para crear tu plantilla personalizada."
msgstr ""
"Use tags like %%filename%%, %%posttitle%%, %%sitetitle%%, %%yoastfocuskw%%, "
"%%rankmathfocuskw%% to create your custom template."

#: filename_filters_heading
msgid "Opciones de Filtrado de Nombres de Archivo"
msgstr "Filename Filtering Options"

#: replace_hyphens_option
msgid "Reemplazar guiones (-) por espacios"
msgstr "Replace hyphens (-) with spaces"

#: replace_underscores_option
msgid "Reemplazar guiones bajos (_) por espacios"
msgstr "Replace underscores (_) with spaces"

#: replace_periods_option
msgid "Reemplazar puntos (.) por espacios"
msgstr "Replace periods (.) with spaces"

#: replace_commas_option
msgid "Reemplazar comas (,) por espacios"
msgstr "Replace commas (,) with spaces"

#: replace_numbers_option
msgid "Reemplazar todos los números (0-9) por espacios"
msgstr "Replace all numbers (0-9) with spaces"

#: text_case_option_label
msgid "Formato de Texto"
msgstr "Text Format"

#: text_case_option_description
msgid "Selecciona cómo deseas formatear el texto de los atributos alt y title."
msgstr "Select how you want to format the text of the alt and title attributes."

#: text_case_none
msgid "Sin cambios"
msgstr "No changes"

#: text_case_uppercase
msgid "Todas las palabras en mayúsculas"
msgstr "All words in uppercase"

#: text_case_lowercase
msgid "Todas las palabras en minúsculas"
msgstr "All words in lowercase"

#: text_case_ucfirst
msgid "Primera letra en mayúscula y el resto en minúsculas"
msgstr "First letter uppercase, rest lowercase"

#: text_case_ucwords
msgid "Primera letra de cada palabra en mayúscula y el resto en minúsculas"
msgstr "First letter of each word uppercase, rest lowercase"

#: preserve_existing_attributes_label
msgid "Conservar Atributos Existentes"
msgstr "Preserve Existing Attributes"

#: preserve_existing_attributes_description
msgid ""
"Conservar los atributos de imagen existentes y actualizar solo los que falten."
msgstr ""
"Preserve existing image attributes and update only those that are missing."

#: modify_featured_image_label
msgid "Modificar Imagen Destacada"
msgstr "Modify Featured Image"

#: modify_featured_image_description
msgid ""
"Habilitar o deshabilitar la modificación de los atributos alt y title de la "
"imagen destacada."
msgstr ""
"Enable or disable the modification of the alt and title attributes of the "
"featured image."

#: settings_section_callback
msgid "Configura las opciones del plugin según tus necesidades."
msgstr "Configure the plugin options according to your needs."

#: backup_warning_heading
msgid "Advertencia:"
msgstr "Warning:"

#: backup_warning_message
msgid ""
"Antes de usar este plugin, se recomienda hacer una copia de seguridad de tu "
"base de datos."
msgstr ""
"Before using this plugin, it is recommended to back up your database."

#: premium_feature_heading
msgid "Procesar Todas las Imágenes (Función Premium)"
msgstr "Process All Images (Premium Feature)"

#: premium_feature_description
msgid ""
"Esta función te permite actualizar los atributos alt y title de todas las "
"imágenes en la biblioteca de medios de forma masiva. Disponible en la versión "
"Premium."
msgstr ""
"This feature allows you to bulk update the alt and title attributes of all "
"images in the media library. Available in the Premium version."

#: get_premium_button
msgid "Obtener la Versión Premium"
msgstr "Get the Premium Version"
