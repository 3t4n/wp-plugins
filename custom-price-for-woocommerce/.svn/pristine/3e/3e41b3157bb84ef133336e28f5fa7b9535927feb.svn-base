<?php
return ['domain'=>'custom-price-for-woocommerce','plural-forms'=>'nplurals=3; plural=(n==1 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);','language'=>'pl_PL','project-id-version'=>'Custom Price for WooCommerce 1.1.13','pot-creation-date'=>'2025-02-07T02:25:11+00:00','po-revision-date'=>'YEAR-MO-DA HO:MI+ZONE','x-generator'=>'WP-CLI 2.11.0','messages'=>['Custom Price for WooCommerce'=>'Własna cena dla WooCommerce','https://wpde.sk/custom-price-pl'=>'https://wpde.sk/wlasna-cena-pl','WP Desk'=>'WP Desk','https://www.wpdesk.net/'=>'https://www.wpdesk.pl/','Start Here'=>'Zacznij tutaj','Upgrade to PRO'=>'Ulepsz do PRO','Enter a value'=>'Wpisz wartość','Enter a value (fixed or %)'=>'Wpisz wartość (dowolną lub z %)','Custom Price'=>'Własna cena','Settings stringPrice'=>'Cena','Settings stringSuggested price: %price%'=>'Sugerowana cena: %price%','Settings stringMinimum price: %price%'=>'Minimalna cena: %price%','Settings stringMaximum price: %price%'=>'Maksymalna cena: %price%','Custom price'=>'Własna cena','Turn on custom price'=>'Włącz własną cenę','Price'=>'Cena','Price Label'=>'Nazwa pola','Label for input price.'=>'Nazwa dla pola ceny.','%1$sUpgrade to PRO →%2$s and enable options below%3$s'=>'%1$sUlepsz do PRO →%2$s  i odblokuj poniższe opcje%3$s','Variable Billing Period'=>'Zmienny okres rozliczeniowy','Allow the customer to set the billing period.'=>'Umożliwienie klientowi ustawienia okresu rozliczeniowego.','Suggested Price'=>'Cena sugerowana','Disabled'=>'Wyłączone','Show as description'=>'Pokaż jako opis','Set amount to input as value'=>'Ustaw kwotę jak wartość pola','Set amount to input as placeholder'=>'Ustaw kwotę w polu jako placeholder','Suggested price amount'=>'Sugerowana cena','Price to replace the default price string.  Leave blank to not suggest a price.'=>'Cena, która ma zastąpić domyślny ciąg cen.  Pozostaw puste, aby nie sugerować ceny.','per'=>'na','Minimum price'=>'Cena minimalna','Lowest acceptable price for product. Leave blank to not enforce a minimum. Must be less than or equal to the set suggested price.'=>'Najniższa akceptowalna cena za produkt. Pozostaw puste, aby nie narzucać ceny minimalnej. Musi być niższa lub równa ustalonej cenie sugerowanej.','Hide minimum price'=>'Ukryj cenę minimalną','Option to not show the minimum price on the front end.'=>'Opcja nie wyświetlania ceny minimalnej na stronie głównej.','Maximum price'=>'Cena maksymalna','Highest acceptable price for product. Leave blank to not enforce a maximum.'=>'Najwyższa akceptowalna cena za produkt. Pozostaw puste, aby nie narzucać wartości maksymalnej.','Hide maximum price'=>'Ukryj cenę maksymalną','Option to not show the maximum price on the front end.'=>'Opcja ukrywa cenę maksymalną na stronie produktu.','The suggested price must be higher than the minimum for Custom Price products. Please review your prices.'=>'Cena sugerowana musi być wyższa niż minimalna dla produktów o cenie niestandardowej. Prosimy o sprawdzenie swoich cen.','The maximum price must be higher than the minimum for Custom Price products. Please review your prices.'=>'Cena maksymalna musi być wyższa niż minimalna dla produktów o cenie niestandardowej. Prosimy o sprawdzenie swoich cen.','The suggested price must be higher than the minimum for Custom Price products. Please review your prices for variation #%d.'=>'Cena sugerowana musi być wyższa niż minimalna dla produktów o cenie niestandardowej. Prosimy o sprawdzenie cen dla odmiany #%d.','The maximum price must be higher than the minimum for Custom Price products. Please review your prices for variation #%d.'=>'Cena maksymalna musi być wyższa niż minimalna w przypadku produktów z ceną niestandardową. Prosimy o sprawdzenie cen dla odmiany #%d.','Version'=>'Wersja','Template overrides'=>'Nadpisywanie szablonów','Shows any files overriding the default Custom Price templates.'=>'Pokazuje wszelkie pliki nadrzędne względem domyślnych szablonów cen niestandardowych.','%1$s version %2$s (out of date)'=>'%1$s version %2$s (out of date)','Cart updated.'=>'Koszyk zaktualizowany.','Change Custom Price subscription amount'=>'Zmień kwotę subskrypcji ceny niestandardowej','Please modify the price or billing period so that it is not the same as your existing subscription.'=>'Należy zmodyfikować cenę lub okres rozliczeniowy, tak aby nie były one takie same jak w przypadku istniejącej subskrypcji.','Please modify the price so that it is not the same as your existing subscription.'=>'Należy zmodyfikować cenę tak, aby nie była taka sama, jak w przypadku dotychczasowej prenumeraty.','You are only allowed to change this subscription\'s price.'=>'Możesz zmienić tylko cenę tego abonamentu.','You do not have permission to modify the price of this subscription.'=>'Nie masz uprawnień do zmiany ceny tej subskrypcji.','%price / %period'=>'%price / %period','Update Cart'=>'Zaktualizuj koszyk','%1$s %2$s'=>'%1$s %2$s','Choose price'=>'Wybierz cenę','edit in cart link textEdit'=>'Edytuj','edit in cart text%1$s<br/><a class="edit_price_in_cart_text edit_in_cart_text" href="%2$s"><small>%3$s</small></a>'=>'%1$s<br/><a class="edit_price_in_cart_text edit_in_cart_text" href="%2$s"><small>%3$s</small></a>','Custom price default minimum textMinimum price: %price%'=>'Minimalna cena: %price%','Custom price default maximum textMaximum price: %price%'=>'Maksymalna cena: %price%','Custom price default suggested textSuggested price: %price%'=>'Sugerowana cena: %price%','Custom price input label%1$s <span class="woocommerce-Price-currencySymbol">( %2$s )</span>'=>'%1$s <span class="woocommerce-Price-currencySymbol">( %2$s )</span>','%1$s every %2$s'=>'%1$s co %2$s','Due every %s'=>'Należny co %s','Due'=>'Należy','This is not a valid product.'=>'To nie jest prawidłowy produkt.','&quot;%%TITLE%%&quot; could not be added to the cart. Please enter a valid, positive number.'=>'&quot;%%TITLE%%&quot; nie można dodać do koszyka. Wprowadź prawidłowy, dodatni numer.','&quot;%%TITLE%%&quot; could not be added to the cart. Please enter at least %%MINIMUM%%.'=>'&quot;%%TITLE%%&quot; cannot be added to cart. Please enter a valid, positive number.','&quot;%%TITLE%%&quot; could not be added to the cart. Please enter a higher amount.'=>'&quot;%%TITLE%%&quot; nie może zostać dodany do koszyka. Wprowadź wyższą kwotę.','Please enter at least %%MINIMUM%%.'=>'Proszę wpisać co najmniej %%MINIMUM%%.','Please enter a higher amount.'=>'Wprowadź wyższą kwotę.','&quot;%%TITLE%%&quot; could not be added to the cart. Please enter less than or equal to %%MAXIMUM%%.'=>'&quot;%%TITLE%%&quot; nie może zostać dodany do koszyka. Proszę wpisać wartość mniejszą lub równą %%MAXIMUM%%.','Please enter less than or equal to %%MAXIMUM%%.'=>'Proszę wpisać wartość mniejszą lub równą %%MAXIMUM%%.','Please enter an amount.'=>'Wprowadź kwotę.','&quot;%%TITLE%%&quot; cannot be purchased. Please enter at least %%MINIMUM%%.'=>'&quot;%%TITLE%%&quot; nie można kupić. Wprowadź wartość co najmniej %%MINIMUM%%.','&quot;%%TITLE%%&quot; cannot be purchased. Please enter less than or equal to %%MAXIMUM%%.'=>'&quot;%%TITLE%%&quot; nie można kupić. Proszę wpisać wartość mniejszą lub równą %%MAXIMUM%%.','Read more in the %1$splugin documentation →%2$s'=>'Przeczytaj więcej w %1$sdokumentacji wtyczki →%2$s','This is the text that appears above the Custom Price input field.'=>'Jest to tekst, który pojawia się nad polem wprowadzania ceny niestandardowej.','Suggested Price Text'=>'Opis sugerowanej ceny','This is the text to display before the suggested price. You can use the placeholder %price% to display the suggested price.'=>'Jest to tekst, który ma być wyświetlany przed sugerowaną ceną. Aby wyświetlić sugerowaną cenę, można użyć symbolu zastępczego %price%.','Suggested price: %price%'=>'Cena sugerowana: %price%','Minimum Price Text'=>'Opis ceny minimalnej','This is the text to display before the minimum accepted price. You can use the placeholder %price% to display the minimum price.'=>'Jest to tekst, który ma być wyświetlany przed minimalną akceptowaną ceną. Aby wyświetlić cenę minimalną, można użyć symbolu %price%.','Minimum price: %price%'=>'Cena minimalna: %price%','Maximum Price Text'=>'Opis ceny maksymalnej','This is the text to display before the maximum accepted price. You can use the placeholder %price% to display the maximum price.'=>'Jest to tekst wyświetlany przed maksymalną akceptowaną ceną. Aby wyświetlić maksymalną cenę, można użyć symbolu zastępczego %price%.','Maximum price: %price%'=>'Cena maksymalna: %price%','Add to Cart Button Text for Shop'=>'Tekst przycisku Dodaj do koszyka dla sklepu','This is the text that appears on the Add to Cart buttons on the Shop Pages.'=>'Jest to tekst, który pojawia się na przyciskach Dodaj do koszyka na stronach sklepu.','Add to Cart Button Text for Single Product'=>'Tekst przycisku Dodaj do koszyka dla pojedynczego produktu','This is the text that appears on the Add to Cart buttons on the Single Product Pages. Leave blank to inherit the default add to cart text.'=>'Jest to tekst, który pojawia się na przyciskach Dodaj do koszyka na stronach pojedynczych produktów. Pozostaw puste, aby odziedziczyć domyślny tekst dodawania do koszyka.','Grow your business with WP Desk'=>'Rozwijaj swój biznes razem z WP Desk','Buy now'=>'Kup teraz','Learn more'=>'Odwiedź','Download'=>'Pobierz','More info'=>'Więcej','Support'=>'Wsparcie','Docs'=>'Docsy','Settings'=>'Ustawienia','Emergency'=>'Wypadek','Alert'=>'Ostrzeżenie','Critical'=>'Błąd krytyczny','Error'=>'Błąd','Warning'=>'Ostrzeżenie','Notice'=>'Powiadomienie','Info'=>'Informacja','Debug'=>'Debugowanie','Can not enable WP Desk Debug log! Cannot create directory %s or this directory is not writeable!'=>'Nie można włączyć WP Desk Debug log! Nie można utworzyć katalogu %s lub brak uprawnień do zapisu w tym katalogu!','Can not enable WP Desk Debug log! Cannot create file %s!'=>'Nie można włączyć logowania błędów za pomocą WP Desk Debug! Nie można utworzyć pliku %s!','You successfully opted out of collecting usage data by %1$s. If you change your mind, you can always opt in later in the plugin\'s quick links.'=>'Twoja rezygnacja ze zbierania danych użytkowania wtyczek przez %1$s została przyjęta. Jeśli zmienisz zdanie, zawsze możesz włączyć zgodę ponownie za pomocą szybkich linków na liście wtyczek.','Enable usage tracking'=>'Włącz śledzenie użycia','Disable usage tracking'=>'Wyłącz śledzenie użycia','Hey %s,'=>'Hej %s,','Please help us improve our plugins! If you opt-in, we will collect some non-sensitive data and usage information anonymously. If you skip this, that\'s okay! All plugins will work just fine.'=>'Proszę pomóż nam udoskonalić nasze wtyczki! Jeśli się zgodzisz, będziemy zbierać niewrażliwe dane użytkowania anonimowo. Jeśli pominiesz ten krok, w porządku! Wszystkie wtyczki będą działać niezależnie od Twojej decyzji.','Allow & Continue &rarr;'=>'Pozwól i kontynuuj &rarr;','Skip'=>'Pomiń','What permissions are being granted?'=>'Jakie uprawnienia są przyznawane?','Your Site Overview'=>'Dane witryny','WP version, PHP info'=>'Wersja WP, wersja PHP','Plugin Usage'=>'Dane użytkowania wtyczek','Current settings and usage information of %1$s plugins'=>'Ustawienia i informacje o użytkowaniu wtyczek %1$s','Your Store Overview'=>'Dane sklepu','Anonymized and non-sensitive store usage information'=>'Tylko niewrażliwe i anonimowe dane o użytkowaniu sklepu','Find out more &raquo;'=>'Dowiedz się więcej &raquo;','Current settings and usage information of WP Desk plugins'=>'Ustawienia i informacje o użytkowaniu wtyczek WP Desk','You are deactivating %s plugin.'=>'Dezaktywujesz wtyczkę %s.',' If you have a moment, please let us know why you are deactivating plugin (anonymous feedback):'=>' Jeśli masz chwilę, prosimy daj nam znać dlaczego dezaktywujesz wtyczkę (anonimowa opinia):','The plugin suddenly stopped working'=>'Wtyczka nagle przestała działać','The plugin broke my site'=>'Wtyczka zepsuła moją stronę','I found a better plugin'=>'Znalazłem lepszą wtyczkę','What\'s the plugin\'s name?'=>'Jaka to wtyczka?','I only needed the plugin for a short period'=>'Potrzebowałem wtyczki tylko przez krótki okres','I no longer need the plugin'=>'Nie potrzebuję już wtyczki','It\'s a temporary deactivation. I\'m just debugging an issue.'=>'Jest to tymczasowa dezaktywacja, debuguję problem.','Other'=>'Inny','Kindly tell us the reason so we can improve'=>'Napisz nam powód abyśmy mogli go poprawić','Cancel'=>'Anuluj','Skip &amp; Deactivate'=>'Pomiń i dezaktywuj','We need your help to improve <strong>WP Desk plugins</strong>, so they are more useful for you and the rest of <strong>30,000+ users</strong>. By collecting data on how you use our plugins, you will help us a lot. We will not collect any sensitive data, so you can feel safe.'=>'Potrzebujemy Twojej pomocy, aby dalej rozwijać <strong>wtyczki WP Desk</strong> i były one jeszcze bardziej pomocne dla Ciebie i pozostałych ponad <strong>30 000 użytkowników</strong>. Zbierając dane na temat tego jak korzystasz z naszych wtyczek bardzo nam w tym pomożesz. Nie będziemy zbierać żadnych danych wrażliwych, więc możesz czuć się bezpiecznie.','You successfully opted out of collecting usage data by WP Desk. If you change your mind, you can always opt in later in the plugin\'s quick links.'=>'Twoja rezygnacja ze zbierania danych użytkowania wtyczek przez WP Desk została przyjęta. Jeśli zmienisz zdanie, zawsze możesz włączyć zgodę ponownie za pomocą szybkich linków na liście wtyczek.','https://wpdesk.net/'=>'https://wpdesk.pl/','The &#8220;%s&#8221; plugin cannot run on PHP versions older than %s. Please contact your host and ask them to upgrade.'=>'Wtyczka &#8220;%s&#8221; nie może działać na wersjach PHP starszych niż %s. Skontaktuj się z administratorem hostingu i poproś o aktualizację wersji PHP.','The &#8220;%s&#8221; plugin cannot run on WordPress versions older than %s. Please update WordPress.'=>'Wtyczka &#8220;%s&#8221; nie może działać na wersjach WordPressa starszych niż %s. Wykonaj aktualizację WordPressa.','The &#8220;%s&#8221; plugin cannot run on WooCommerce versions older than %s. Please update WooCommerce.'=>'Wtyczka &#8220;%s&#8221; nie może działać na wersjach WooCommerce starszych niż %s. Wykonaj aktualizację WooCommerce.','The &#8220;%s&#8221; plugin cannot run without OpenSSL module version at least %s. Please update OpenSSL module.'=>'Wtyczka &#8220;%s&#8221; nie może działać bez aktywacji OpenSSL co najmniej w wersji %s. Wykonaj aktualizację OpenSSL.','The &#8220;%1$s&#8221; plugin requires at least %2$s version of %3$s to work correctly. Please update it to its latest release.'=>'Do poprawnego działania wtyczki &#8220;%1$s&#8221; wymagana jest wtyczka %3$s co najmniej w wersji %2$s. Wykonaj jej aktualizację.','The &#8220;%s&#8221; plugin cannot run without %s active. Please install and activate %s plugin.'=>'Wtyczka &#8220;%s&#8221; nie może działać bez aktywacji %s. Zainstaluj i aktywuj wtyczkę %s.','The &#8220;%s&#8221; plugin requires free %s plugin. <a href="%s">Install%s</a>'=>'Wtyczka &#8220;%s&#8221; wymaga bezpłatnej wtyczki %s. <a href="%s">Zainstaluj %s</a>','The &#8220;%s&#8221; plugin requires activating %s plugin. <a href="%s">Activate %s</a>'=>'Wtyczka &#8220;%s&#8221; wymaga aktywnej wtyczki %s. <a href="%s">Włącz %s</a>','The &#8220;%s&#8221; plugin cannot run without %s PHP module installed. Please contact your host and ask them to install %s.'=>'Wtyczka &#8220;%s&#8221; nie może działać bez modułu PHP: %s. Skontaktuj się z administratorem hostingu i poproś o instalację %s.','The &#8220;%s&#8221; plugin cannot run without %s PHP setting set to %s. Please contact your host and ask them to set %s.'=>'Wtyczka &#8220;%s&#8221; nie może działać bez ustawienia PHP %s ustawionego na %s. Skontaktuj się z administratorem hostingu i poproś o ustawienie %s.','The &#8220;%s&#8221; plugin is temporarily disabled since the required %s plugin is being upgraded.'=>'Wtyczka &#8220;%s&#8221; została chwilowo wyłączona, ponieważ wymagana wtyczka %s jest właśnie aktualizowana.','Submit &amp; Deactivate'=>'Wyślij i dezaktywuj','Allow'=>'Pozwól']];