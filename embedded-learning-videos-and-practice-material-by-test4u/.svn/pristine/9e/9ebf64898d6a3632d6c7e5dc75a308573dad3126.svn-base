
.alert{
	border: 1px solid transparent;
	border-radius: 4px;
	margin-bottom: 20px;
	margin-top: 20px;
	padding: 15px;
}

.alert-danger{
	background-color: #f2dede;
	border-color: #ebccd1;
	color: #a94442;
}
.alert-success{
	background-color: #dff0d8;
	border-color: #d6e9c6;
	color: #3c763d;
}


.t4u-video {
	position: relative;
	padding-bottom: 56.25%;
	padding-top: 20px;
	height: 0;
	overflow: hidden;
}

/***
* @author Brad Dalton - WP Sites
* @link http://wpsites.net/wordpress-tips/embed-videos-responsive/
***/
.t4u-video  iframe,  
.t4u-video  object,  
.t4u-video  embed {
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
}

.t4u-vileo-lesson-practice-files{
	padding:10px;
	border: 1px solid rgba(100,100,100,0.2);
	margin-top:20px;
	margin-bottom:50px;
	text-align: left;
}


.t4u-vileo-lesson-queries{
	padding:10px;
	border: 1px solid rgba(100,100,100,0.2);
	margin-top:20px;
	margin-bottom:50px;
	text-align: left;
}

.t4u_query_time{
	display:block;
	font-style:italic;
	font-size: 95%;
}

.t4u_query{
	margin-bottom:10px;
	padding:10px;
}
.t4u_query_answer{
	padding-left:20px;
	margin-top:10px;
}
.t4u_query_odd{
	background-color: #eee;
}
.t4u-bar-button-class a:before{
	content:url('data:image/png;base64,')
}