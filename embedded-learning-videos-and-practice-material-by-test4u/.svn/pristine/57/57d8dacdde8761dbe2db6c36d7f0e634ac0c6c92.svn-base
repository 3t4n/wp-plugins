<?php

// Exit if accessed directly
if ( ! defined( 'ABSPATH' ) ) {
	exit; 
}

if(!defined('T4U_PLUGIN_VERSION')) define('T4U_PLUGIN_VERSION', '1.2');

$t4u_plugin_name = T4U_PLUGIN_DIR_NAME;
$t4u_plugin_folder_name = dirname(dirname(plugin_basename(__FILE__)));
$t4u_current_folder = dirname(dirname(__FILE__));

if(!defined('DS')) define('DS', DIRECTORY_SEPARATOR);


if(!defined('T4U_PLUGIN_NAME')) define('T4U_PLUGIN_NAME', $t4u_plugin_name);
if(!defined('T4U_DOMAIN')) define('T4U_DOMAIN', $t4u_plugin_name);

if(!defined('T4U_PLUGIN_MENU_NAME')) define('T4U_PLUGIN_MENU_NAME', 'TEST4U');
if(!defined('T4U_PLUGIN_DIR')) define('T4U_PLUGIN_DIR', dirname($t4u_current_folder).DS);

if(!defined('T4U_URL')) define('T4U_URL',plugins_url().'/'.T4U_PLUGIN_NAME.'/');
if(!defined('T4U_DIR')) define('T4U_DIR', $t4u_current_folder.DS);

define( 'T4U_MAIN_FILE',T4U_DIR.'wp_test4u_cources.php' );


if(!defined('T4U_ADMINURL')) define( 'T4U_ADMINURL', site_url( '/wp-admin/admin.php' ) );


if(!defined('T4U_PLUGIN_URL')) define('T4U_PLUGIN_URL', plugin_dir_url(__FILE__));
if(!defined('T4U_PLUGIN_SETTINGS')) define('T4U_PLUGIN_SETTINGS', 'test4u_cources_settings');
if(!defined('SETTINGS_PAGE')) define('SETTINGS_PAGE', 'test4u-cources-settings');

if(!defined('T4U_POST_TYPE')) define('T4U_POST_TYPE', 'test4u_video_course');
if(!defined('T4U_API_KEY_SETTING')) define('T4U_API_KEY_SETTING', 't4u_installation_id');

//if(!defined('TEST4U_DATA_URL')) define('TEST4U_DATA_URL', 'http://10.1.1.129');
if(!defined('TEST4U_DATA_URL')) define('TEST4U_DATA_URL', 'https://www.test4u.eu');


