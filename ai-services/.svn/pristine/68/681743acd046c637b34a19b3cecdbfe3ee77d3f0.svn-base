.ai-services-sensitive-text-control-container{display:flex}.ai-services-sensitive-text-control-container .ai-services-input-visible-button{margin-right:4px}.ai-services-sensitive-text-control-container .ai-services-input-visible-button .dashicons{margin-left:4px}.ai-services-sensitive-text-control-container .components-text-control__input{min-height:36px}@media(max-width:782px){.ai-services-sensitive-text-control-container .ai-services-input-visible-button,.ai-services-sensitive-text-control-container .components-text-control__input{min-height:40px}}.ai-services-sensitive-text-control-container+.components-base-control__help{color:#757575;font-size:12px;font-style:normal;margin-top:8px}
