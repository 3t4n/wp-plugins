.ai-services-chatbot__container{position:relative;width:275px}.ai-services-chatbot__inner-container{background-color:#fff;border-radius:3px;border-radius:5px;height:500px}.ai-services-chatbot__header{align-items:center;background-color:#fff;border-bottom:1px solid #d8d8d8;border-top-right-radius:5px;border-top-left-radius:5px;color:#514f4f;display:flex;font-size:.85rem;font-weight:700;justify-content:space-between;padding:12.5px}.ai-services-chatbot__header-title{font-weight:700;padding-left:36px}.ai-services-chatbot__header-title__note{font-size:80%;font-weight:400}.ai-services-chatbot__header-close-button{background-color:transparent;border:1px solid transparent;color:#646970;margin:0;outline:none;padding:0;transition:color .1s ease-in-out;z-index:1000}.ai-services-chatbot__header-close-button:active,.ai-services-chatbot__header-close-button:focus,.ai-services-chatbot__header-close-button:hover{color:#135e96}.ai-services-chatbot__header-close-button__icon:before{content:"";font:400 20px/1 dashicons;vertical-align:middle}.ai-services-chatbot__messages-container{height:396px;overflow-x:hidden;overflow-y:scroll;padding:0 17.5px 10px}.ai-services-chatbot__message-container{display:flex;margin:15px 0}.ai-services-chatbot__message-container--user{flex-direction:row-reverse;justify-content:flex-start}.ai-services-chatbot__message-container--assistant{justify-content:flex-start}.ai-services-chatbot__avatar-container{align-items:center;border-radius:50%;display:flex;font-size:1.2rem;height:40px;justify-content:center;width:40px}.ai-services-chatbot__avatar-container--user{background-color:#3d4e8d;margin-right:12.5px}.ai-services-chatbot__avatar-container--assistant{background-color:#d8d8d8;margin-left:12.5px}.ai-services-chatbot__avatar-icon--user{fill:#fff;height:15px;width:15px}.ai-services-chatbot__avatar-icon--assistant{fill:#494646}.ai-services-chatbot__avatar-letter{margin:0;padding:0}.ai-services-chatbot__avatar-letter--user{color:#fff}.ai-services-chatbot__avatar-letter--assistant{color:#1d1d1d}.ai-services-chatbot__message{border-radius:5px;font-size:.9rem;font-weight:medium;padding:10px;position:relative;text-align:right;width:184.5px}.ai-services-chatbot__message--user{background-color:#f1f1f1;color:#585858}.ai-services-chatbot__message--assistant{background-color:#2898ec;color:#fff}.ai-services-chatbot__message--assistant.ai-services-error{background-color:#d63638}.ai-services-chatbot__message p{font-size:.9rem}.ai-services-chatbot__message ul{list-style:disc}.ai-services-chatbot__message ol,.ai-services-chatbot__message ul{padding-right:1rem}.ai-services-chatbot__message ol:first-child,.ai-services-chatbot__message p:first-child,.ai-services-chatbot__message ul:first-child{margin-top:0}.ai-services-chatbot__message ol:last-child,.ai-services-chatbot__message p:last-child,.ai-services-chatbot__message ul:last-child{margin-bottom:0}.ai-services-chatbot__message div+.button{margin-top:1rem}.ai-services-chatbot__message-arrow{border-bottom:8px solid transparent;border-top:8px solid transparent;height:0;position:absolute;width:0}.ai-services-chatbot__message-arrow--user{border-right:8px solid #f1f1f1;left:-7px;top:13px}.ai-services-chatbot__message-arrow--assistant{border-left:8px solid #2898ec;right:-7px;top:13px}.ai-services-chatbot__message-arrow--assistant.ai-services-error{border-left-color:#d63638}.ai-services-chatbot__loading-icon-container{height:17px;width:25px}.ai-services-chatbot__input-container{bottom:0;display:flex;position:absolute;width:100%}.ai-services-chatbot__input{border:none;border-bottom-right-radius:5px;border-top:1px solid #d8d8d8;font-size:.85rem;padding:12.5px;width:100%}.ai-services-chatbot__input-form{display:flex;width:100%}.ai-services-chatbot__input::-moz-placeholder{color:#585858}.ai-services-chatbot__input::placeholder{color:#585858}.ai-services-chatbot__btn-send{background-color:#2898ec;border:none;border-bottom-left-radius:5px;color:#fff;width:100px}.ai-services-chatbot__btn-send-icon{fill:#fff;margin:0 auto;width:15px}.ai-services-chatbot__loader-container{align-items:center;display:flex;justify-content:flex-start;width:100%}.ai-services-chatbot__loader{fill:#2898ec}.ai-services-chatbot__loader-dot{animation:load 1s infinite}.ai-services-chatbot__loader-dot:first-child{animation-delay:0s}.ai-services-chatbot__loader-dot:not(:first-child,:last-child){animation-delay:.2s}.ai-services-chatbot__loader-dot:last-child{animation-delay:.4s}@keyframes load{0%{opacity:0}50%{opacity:1}to{opacity:0}}
.ai-services-assistant-chatbot-container{border-radius:5px;bottom:2rem;box-shadow:0 0 0 1px rgba(0,0,0,.1);position:fixed;left:2rem;z-index:1000}@media(min-width:782px){.ai-services-assistant-chatbot-container .ai-services-chatbot__container{width:400px}.ai-services-assistant-chatbot-container .ai-services-chatbot__message--assistant{width:309.5px}}.ai-services-assistant-chatbot-container .ai-services-chatbot__input{margin:0}.components-button.button.ai-services-assistant-chatbot-button{border-radius:50%;bottom:2rem;display:flex;height:72px;margin:0 0 5px 5px;padding:0;position:fixed;left:2rem;width:72px;z-index:100}
