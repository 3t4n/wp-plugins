.hulk_affef_rating_wrap{max-width:100%;flex-basis:100%;display:flex;flex-wrap:nowrap;flex-direction:column}.hulk_affef_rating_wrap .hulk-rating-field-wrap{display:flex;width:100%;gap:20px;flex-wrap:nowrap;flex-direction:row;align-items:center;align-content:center}.hulk_affef_rating_wrap .hulk-rating-field{display:inline-flex !important;flex-wrap:wrap;gap:0}.hulk_affef_rating_wrap .hulk-empty-symbol,.hulk_affef_rating_wrap .hulk-full-symbol{display:flex;color:#ccd6df;fill:currentColor;font-size:30px;height:30px;width:30px}.hulk_affef_rating_wrap .hulk-empty-symbol i,.hulk_affef_rating_wrap .hulk-full-symbol i{font-size:inherit}.hulk_affef_rating_wrap .hulk-empty-symbol svg,.hulk_affef_rating_wrap .hulk-full-symbol svg{fill:currentColor}.hulk_affef_rating_wrap .hulk-full-symbol{color:#f0ad4e}.hulk_affef_rating_wrap .hulk-show-value{font-family:var(--e-global-typography-text-font-family),Sans-serif,serif;font-weight:var(--e-global-typography-text-font-weight);color:#7a7a7a;border:1px solid #69727d;width:auto;display:flex;align-items:center;max-width:100%;flex-basis:auto;flex-grow:0;font-size:16px;padding:0 5px;min-width:50px;justify-content:center;text-align:center;background-color:#fff}
.hulk-ffef-upgrade-overlay a{all:unset;display:inline-flex;-webkit-appearance:none;-moz-appearance:none;appearance:none;background:none;border:none;box-shadow:none;color:inherit;font:inherit;line-height:normal;margin:0;padding:0;text-align:inherit;text-decoration:none;text-shadow:none;vertical-align:baseline;white-space:normal;box-sizing:border-box}.hulk-ffef-upgrade-overlay{position:absolute;top:0;left:0;right:0;bottom:0;z-index:100;background-color:rgba(0,0,0,.1);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);display:flex;align-items:center;align-content:center;justify-content:center;border-radius:4px;overflow:hidden}.hulk-ffef-upgrade-overlay a{color:#3858e9;text-decoration:underline;font-size:16px;display:inline-block;cursor:pointer}
