.hulk_affef_select2_wrap{max-width:100%;flex-basis:100%;display:flex;flex-wrap:nowrap;flex-direction:column;align-items:flex-start;position:relative;--hulk-select2-primary-color: #69727D}.hulk_affef_select2_wrap .hulk-select2-parent{width:100%}.hulk_affef_select2_wrap .hulk-select2-container{width:100%}.hulk_affef_select2_wrap .hulk-ffef__control{border-color:var(--hulk-select2-primary-color)}.hulk_affef_select2_wrap .hulk-ffef__control:hover{border-color:var(--hulk-select2-primary-color)}.hulk_affef_select2_wrap .hulk-ffef__dropdown-indicator{color:var(--hulk-select2-primary-color)}
.hulk-ffef-upgrade-overlay a{all:unset;display:inline-flex;-webkit-appearance:none;-moz-appearance:none;appearance:none;background:none;border:none;box-shadow:none;color:inherit;font:inherit;line-height:normal;margin:0;padding:0;text-align:inherit;text-decoration:none;text-shadow:none;vertical-align:baseline;white-space:normal;box-sizing:border-box}.hulk-ffef-upgrade-overlay{position:absolute;top:0;left:0;right:0;bottom:0;z-index:100;background-color:rgba(0,0,0,.1);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);display:flex;align-items:center;align-content:center;justify-content:center;border-radius:4px;overflow:hidden}.hulk-ffef-upgrade-overlay a{color:#3858e9;text-decoration:underline;font-size:16px;display:inline-block;cursor:pointer}
