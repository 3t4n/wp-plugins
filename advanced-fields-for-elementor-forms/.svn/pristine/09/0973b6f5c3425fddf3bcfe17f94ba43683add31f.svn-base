.hulk_affef_dropzone_wrap .hulk-files,.hulk_affef_dropzone_wrap .hulk-drop-remove{all:unset;display:inline-flex;-webkit-appearance:none;-moz-appearance:none;appearance:none;background:none;border:none;box-shadow:none;color:inherit;font:inherit;line-height:normal;margin:0;padding:0;text-align:inherit;text-decoration:none;text-shadow:none;vertical-align:baseline;white-space:normal;box-sizing:border-box}.hulk_affef_dropzone_wrap{max-width:100%;flex-basis:100%;display:flex;flex-wrap:nowrap;flex-direction:column;align-items:flex-start;position:relative}.hulk_affef_dropzone_wrap .hulk-field-container{display:block;width:100%;font-family:var(--e-global-typography-text-font-family),Sans-serif,serif;font-weight:var(--e-global-typography-text-font-weight);color:var(--e-global-color-text)}.hulk_affef_dropzone_wrap .hulk-field-container>p{font-size:1rem}.hulk_affef_dropzone_wrap .hulk-field-container>em{font-size:.8rem}.hulk_affef_dropzone_wrap .hulk-dropzone{display:flex;flex-direction:column;align-items:center;padding:20px;background-color:#fff;border-radius:2px;outline:none;transition:border .24s ease-in-out;border:2px dashed #69727d;justify-content:center;height:100px}.hulk_affef_dropzone_wrap .hulk-dropzone:focus{border-color:var(--e-global-color-accent)}.hulk_affef_dropzone_wrap .hulk-dropzone .disabled{opacity:.6}.hulk_affef_dropzone_wrap .hulk-dropzone p{margin:0 !important;padding:0 !important}.hulk_affef_dropzone_wrap .hulk-files{width:100%;padding:0;vertical-align:top;margin:10px 0;position:relative;list-style:none;display:flex;flex-direction:column;gap:10px}.hulk_affef_dropzone_wrap .hulk-files>li{position:relative;margin:0;padding:0;display:flex;flex-direction:column;gap:10px}.hulk_affef_dropzone_wrap .hulk-drop-wrap{height:50px;display:flex;gap:10px;align-items:center}.hulk_affef_dropzone_wrap .hulk-icon-wrap{display:flex;position:relative;width:50px;height:50px}.hulk_affef_dropzone_wrap .hulk-drop-type{width:50px;height:50px;position:absolute;top:0;right:0;overflow:hidden;color:#7a7a7a}.hulk_affef_dropzone_wrap .hulk-drop-type svg{width:inherit;height:inherit;fill:currentColor}.hulk_affef_dropzone_wrap .hulk-drop-type img{object-fit:cover;height:100%;width:100%;border-radius:2px}.hulk_affef_dropzone_wrap .hulk-drop-type-file{display:block;position:absolute;top:25px;right:0;font-size:12px;font-weight:700;line-height:13px;padding:0 4px;border-radius:2px;box-shadow:-1px 1px 2px #abc;color:#fff;background:#0080c8;text-transform:uppercase}.hulk_affef_dropzone_wrap .hulk-info-wrap{flex-basis:100%;display:flex;flex-direction:column;gap:2px;width:calc(100% - 60px)}.hulk_affef_dropzone_wrap .hulk-file-info{display:flex;gap:5px;width:calc(100% - 50px);color:#7a7a7a}.hulk_affef_dropzone_wrap .hulk-drop-filename{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.hulk_affef_dropzone_wrap .hulk-drop-filesize{display:block;color:#444242;font-weight:700;white-space:nowrap}.hulk_affef_dropzone_wrap .hulk-drop-remove{position:absolute;top:0;left:0;width:20px;height:20px;cursor:pointer;display:flex;align-items:center;justify-content:center;border:2px solid #69727d;border-radius:100px;color:#69727d}.hulk_affef_dropzone_wrap .hulk-drop-remove svg{fill:currentColor}.hulk_affef_dropzone_wrap .hulk-drop-progressBar{border-radius:5px;overflow:hidden;width:100%;background-color:var(--e-global-color-accent);height:15px;font-size:11px;text-align:left;color:#fff;font-weight:700;padding:0 4px;display:flex;align-items:center;justify-content:flex-end;align-content:center;min-width:50px}.hulk_affef_dropzone_wrap .hulk-drop-text-error{display:block;width:100%;clear:both;white-space:normal;font-size:1em;line-height:1;color:#d9534f;font-family:inherit;font-weight:inherit}.hulk_affef_dropzone_wrap .hulk-drop-text-error:before{content:"";display:inline-block;font-family:eicons,serif;font-weight:normal;font-style:normal;vertical-align:middle;-webkit-margin-end:5px;margin-inline-end:5px}.hulk_affef_dropzone_wrap .hulk-drop-pause{position:absolute;top:0;left:0;display:none !important}.hulk_affef_dropzone_wrap .hulk-drop-upload{display:none}
.hulk-ffef-upgrade-overlay a{all:unset;display:inline-flex;-webkit-appearance:none;-moz-appearance:none;appearance:none;background:none;border:none;box-shadow:none;color:inherit;font:inherit;line-height:normal;margin:0;padding:0;text-align:inherit;text-decoration:none;text-shadow:none;vertical-align:baseline;white-space:normal;box-sizing:border-box}.hulk-ffef-upgrade-overlay{position:absolute;top:0;right:0;left:0;bottom:0;z-index:100;background-color:rgba(0,0,0,.1);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);display:flex;align-items:center;align-content:center;justify-content:center;border-radius:4px;overflow:hidden}.hulk-ffef-upgrade-overlay a{color:#3858e9;text-decoration:underline;font-size:16px;display:inline-block;cursor:pointer}
