.hulk_affef_signature_wrap{max-width:100%;flex-basis:100%;display:flex;flex-wrap:nowrap;flex-direction:column;align-items:flex-start;position:relative;font-family:var(--e-global-typography-text-font-family),sans-serif;font-weight:var(--e-global-typography-text-font-weight)}.hulk_affef_signature_wrap .hulk-pad-wrap{position:relative;background-color:#fff;display:flex;overflow:hidden;width:100%;height:200px;max-width:100%;border-width:1px;border-style:solid;border-color:#69727d;font-size:0;margin-bottom:10px;border-radius:3px;z-index:1}.hulk_affef_signature_wrap .hulk-pad-wrap:before{content:"";position:absolute;top:0;left:0;bottom:0;right:0;z-index:-1;pointer-events:none;display:block}.hulk_affef_signature_wrap .hulk-canvas{position:absolute;top:0;left:0;-webkit-user-select:none;-moz-user-select:none;-ms-user-select:none;user-select:none;touch-action:none;cursor:crosshair;width:100%;height:100%;z-index:1}.hulk_affef_signature_wrap .hulk-placeholder{position:absolute;top:0;left:0;right:0;bottom:0;display:flex;align-content:center;justify-content:center;align-items:center;max-width:80%;margin:0 auto;pointer-events:none;color:rgba(122,122,122,.3);padding:15px;z-index:-1;transition:40ms ease-in-out;transition-property:opacity}.hulk_affef_signature_wrap .hulk-placeholder svg{width:100%;max-width:100%}.hulk_affef_signature_wrap .hulk-pad-wrap[data-begin=true] .hulk-placeholder{opacity:0}.hulk_affef_signature_wrap .hulk-pad-footer{display:flex;align-items:center;justify-content:space-between;align-content:center;flex-direction:row;flex-wrap:wrap;gap:10px;width:100%}.hulk_affef_signature_wrap .hulk-pad-footer[data-select-color=true]{flex-direction:column}.hulk_affef_signature_wrap .hulk-pad-footer[data-select-color=true] .hulk-colors-list{margin-top:10px;margin-bottom:10px}.hulk_affef_signature_wrap .hulk-pad-footer[data-select-color=true] .hulk-buttons{margin-bottom:10px}@media(min-width: 576px){.hulk_affef_signature_wrap .hulk-pad-footer[data-select-color=true]{flex-direction:row}.hulk_affef_signature_wrap .hulk-pad-footer[data-select-color=true] .hulk-colors-list{margin-top:0;margin-bottom:0}.hulk_affef_signature_wrap .hulk-pad-footer[data-select-color=true] .hulk-buttons{margin-bottom:0}}.hulk_affef_signature_wrap .hulk-colors-list{display:inline-flex;align-items:center;flex-wrap:wrap}.hulk_affef_signature_wrap .hulk-colors-list-label{color:var(--e-global-color-text);font-family:var(--e-global-typography-text-font-family),sans-serif;font-weight:var(--e-global-typography-text-font-weight);cursor:pointer;-webkit-user-select:none;-moz-user-select:none;-ms-user-select:none;user-select:none}.hulk_affef_signature_wrap .hulk-colors-list-color{margin:0 0 0 10px !important;height:16px;width:16px;font-size:13px;line-height:normal;border:1px solid #787878;border-radius:50%;transition:none;color:#50575e;clear:none;cursor:pointer;display:inline-block;padding:0 !important;text-align:center;vertical-align:middle;min-width:1rem;-webkit-appearance:none;-moz-appearance:none;appearance:none;position:relative}.hulk_affef_signature_wrap .hulk-colors-list-color:checked{background:#0075ff;border-color:#0075ff;box-shadow:0 0 0 2px #fff,0 0 0 4px #0075ff;outline:2px solid rgba(0,0,0,0)}.hulk_affef_signature_wrap .hulk-colors-list-color:focus{box-shadow:0 0 0 2px #fff,0 0 0 4px #0075ff;outline:2px solid rgba(0,0,0,0)}.hulk_affef_signature_wrap .hulk-buttons{display:inline-flex;gap:10px;flex:1 auto;justify-content:flex-end;flex-wrap:wrap}.hulk_affef_signature_wrap .elementor-button{border:none;padding:6px 12px;cursor:pointer;margin:0;font-family:inherit;font-weight:inherit;font-size:14px;border-radius:3px;color:#fff;text-align:center;transition:all .3s;background-color:var(--e-global-color-accent)}.hulk_affef_signature_wrap input[type=file]{position:absolute;top:0;left:0;opacity:0;pointer-events:none}
.hulk-ffef-upgrade-overlay a{all:unset;display:inline-flex;-webkit-appearance:none;-moz-appearance:none;appearance:none;background:none;border:none;box-shadow:none;color:inherit;font:inherit;line-height:normal;margin:0;padding:0;text-align:inherit;text-decoration:none;text-shadow:none;vertical-align:baseline;white-space:normal;box-sizing:border-box}.hulk-ffef-upgrade-overlay{position:absolute;top:0;left:0;right:0;bottom:0;z-index:100;background-color:rgba(0,0,0,.1);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);display:flex;align-items:center;align-content:center;justify-content:center;border-radius:4px;overflow:hidden}.hulk-ffef-upgrade-overlay a{color:#3858e9;text-decoration:underline;font-size:16px;display:inline-block;cursor:pointer}
