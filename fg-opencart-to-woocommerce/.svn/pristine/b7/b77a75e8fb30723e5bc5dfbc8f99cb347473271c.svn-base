msgstr "Impossible de créer le répertoire %s"

#: admin/class-fg-opencart-to-woocommerce-admin.php:3376
#, php-format
msgid "%d media imported"
msgid_plural "%d medias imported"
msgstr[0] "%d média importé"
msgstr[1] "%d médias importés"

#: admin/class-fg-opencart-to-woocommerce-download-ftp.php:118
