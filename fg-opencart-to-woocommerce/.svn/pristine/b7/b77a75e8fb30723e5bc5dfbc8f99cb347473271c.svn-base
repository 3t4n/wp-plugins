#: admin/class-fg-opencart-to-woocommerce-admin.php:1199
#, php-format
msgid "%d product"
msgid_plural "%d products"
msgstr[0] "%d produit"
msgstr[1] "%d produits"

#: admin/class-fg-opencart-to-woocommerce-admin.php:527
#, php-format
msgid "%d media"
msgid_plural "%d medias"
msgstr[0] "%d média"
msgstr[1] "%d médias"

#: admin/class-fg-opencart-to-woocommerce-admin.php:528
#, php-format
msgid "%d tag"
msgid_plural "%d tags"
msgstr[0] "%d mot-clef"
msgstr[1] "%d mots-clefs"

#: admin/class-fg-opencart-to-woocommerce-admin.php:557
msgid "Instructions"
msgstr "Instructions"

#: admin/class-fg-opencart-to-woocommerce-admin.php:563
msgid "Options"
msgstr "Options"

#: admin/class-fg-opencart-to-woocommerce-admin.php:567
msgid "FAQ"
msgstr "FAQ"

#: admin/class-fg-opencart-to-woocommerce-admin.php:597
msgid "PDO is required. Please enable it."
msgstr "PDO est requis. Veuillez l'activer."

#: admin/class-fg-opencart-to-woocommerce-admin.php:606
#: admin/class-fg-opencart-to-woocommerce-admin.php:1169
msgid ""
"Couldn't connect to the OpenCart database. Please check your parameters. And "
"be sure the WordPress server can access the OpenCart database."
msgstr ""
"Impossible de se connecter à la base de données d'OpenCart. Merci de "
"vérifier vos paramètres. Et soyez certains que le serveur WordPress ait "
"accès à la base de données d'OpenCart."

#: admin/class-fg-opencart-to-woocommerce-admin.php:606
#, php-format
msgid ""
"Please read the <a href=\"%s\" target=\"_blank\">FAQ for the solution</a>."
msgstr ""
"Veuillez lire la <a href=\"%s\" target=\"_blank\">FAQ pour la solution</a>."

#: admin/class-fg-opencart-to-woocommerce-admin.php:651
#: admin/class-fg-opencart-to-woocommerce-admin.php:2748
msgid "Error:"
msgstr "Erreur :"

#: admin/class-fg-opencart-to-woocommerce-admin.php:1114
msgid "WooCommerce data deleted"
msgstr "Contenu WooCommerce supprimé"

#: admin/class-fg-opencart-to-woocommerce-admin.php:1119
msgid "WooCommerce default data created"
msgstr "Contenu par défaut de WooCommerce recréé"

#: admin/class-fg-opencart-to-woocommerce-admin.php:1161
msgid "Connected with success to the OpenCart database"
msgstr "Connecté avec succès à la base de données OpenCart"

#: admin/class-fg-opencart-to-woocommerce-admin.php:1184
msgid ""
"Error: the <a href=\"https://wordpress.org/plugins/woocommerce/\" "
"target=\"_blank\">WooCommerce plugin</a> must be installed and activated to "
"import the products."
msgstr ""
"Erreur: le <a href=\"https://wordpress.org/plugins/woocommerce/\" "
"target=\"_blank\">plugin WooCommerce</a> doit être installé et activé pour "
"importer les produits."

#: admin/class-fg-opencart-to-woocommerce-admin.php:1195
msgid "OpenCart data found:"
msgstr "Données OpenCart trouvées :"

#: admin/class-fg-opencart-to-woocommerce-admin.php:1207
#, php-format
msgid "%d CMS page"
msgid_plural "%d CMS pages"
msgstr[0] "%d page CMS"
msgstr[1] "%d pages CMS"

#: admin/class-fg-opencart-to-woocommerce-admin.php:1211
#, php-format
msgid "%d user"
msgid_plural "%d users"
msgstr[0] "%d utilisateur"
msgstr[1] "%d utilisateurs"

#: admin/class-fg-opencart-to-woocommerce-admin.php:1215
#, php-format
msgid "%d customer"
msgid_plural "%d customers"
msgstr[0] "%d client"
msgstr[1] "%d clients"

#: admin/class-fg-opencart-to-woocommerce-admin.php:1219
#, php-format
msgid "%d order"
msgid_plural "%d orders"
msgstr[0] "%d commande"
msgstr[1] "%d commandes"

#: admin/class-fg-opencart-to-woocommerce-admin.php:1456
msgid "The URL field is required to import the media."
msgstr "Le champ URL est requis pour importer les médias."

#: admin/class-fg-opencart-to-woocommerce-admin.php:1650
msgid "Importing CMS pages..."
msgstr "Import des pages CMS..."

#: admin/class-fg-opencart-to-woocommerce-admin.php:1705
#, php-format
msgid "%d CMS page imported"
msgid_plural "%d CMS pages imported"
msgstr[0] "%d page CMS importée"
msgstr[1] "%d pages CMS importées"

#: admin/class-fg-opencart-to-woocommerce-admin.php:1914
msgid "Importing product categories..."
msgstr "Import des catégories de produits..."

#: admin/class-fg-opencart-to-woocommerce-admin.php:1971
#, php-format
msgid "%d product category imported"
msgid_plural "%d product categories imported"
msgstr[0] "%d catégorie de produit importée"
msgstr[1] "%d catégories de produit importées"

#: admin/class-fg-opencart-to-woocommerce-admin.php:2086
msgid "Importing product categories hierarchy..."
msgstr "Import de la hiérarchie des catégories de produits..."

#: admin/class-fg-opencart-to-woocommerce-admin.php:2153
msgid "Importing products..."
msgstr "Import des produits..."

#: admin/class-fg-opencart-to-woocommerce-admin.php:2212
#, php-format
msgid "%d product imported"
msgid_plural "%d products imported"
msgstr[0] "%d produit importé"
msgstr[1] "%d produits importés"

