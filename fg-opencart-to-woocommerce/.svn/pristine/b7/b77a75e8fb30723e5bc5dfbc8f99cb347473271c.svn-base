#: admin/class-fg-opencart-to-woocommerce-admin.php:153
msgid "All previously imported data will be deleted from WordPress.."
msgstr ""
"Toutes les données précédemment importées seront supprimées de WordPress."

#: admin/class-fg-opencart-to-woocommerce-admin.php:154
msgid "All content will be deleted from WordPress."
msgstr "Toutes les données vont être supprimées de WordPress."

#: admin/class-fg-opencart-to-woocommerce-admin.php:155
msgid "Please select a remove option."
msgstr "Veuillez sélectionner une option de suppression."

#: admin/class-fg-opencart-to-woocommerce-admin.php:156
msgid "IMPORT COMPLETED"
msgstr "IMPORT TERMINÉ"

#: admin/class-fg-opencart-to-woocommerce-admin.php:157
msgid "Content removed from WordPress"
msgstr "Contenu supprimé de WordPress"

#: admin/class-fg-opencart-to-woocommerce-admin.php:158
#: admin/class-fg-opencart-to-woocommerce-admin.php:382
msgid "Settings saved"
msgstr "Paramètres enregistrés"

#: admin/class-fg-opencart-to-woocommerce-admin.php:159
msgid "Importing…"
msgstr "En cours d'import…"

#: admin/class-fg-opencart-to-woocommerce-admin.php:160
msgid "IMPORT STOPPED BY USER"
msgstr "IMPORT ARRÊTÉ PAR L'UTILISATEUR"

#: admin/class-fg-opencart-to-woocommerce-admin.php:174
msgid "OpenCart"
msgstr "OpenCart"

#: admin/class-fg-opencart-to-woocommerce-admin.php:174
msgid "Import OpenCart e-commerce solution to WooCommerce"
msgstr "Importer la boutique en ligne OpenCart vers WooCommerce"

#: admin/class-fg-opencart-to-woocommerce-admin.php:355
msgid "The wp-content directory must be writable."
msgstr "Le répertoire wp-content doit avoir les permissions en écriture."

#: admin/class-fg-opencart-to-woocommerce-admin.php:360
#, php-format
msgid "WordPress 4.4+ is required. Please <a href=\"%s\">update WordPress</a>."
msgstr ""
"WordPress 4.4+ est requis. Veuillez <a href=\"%s\">mettre à jour WordPress</"
"a>."

#: admin/class-fg-opencart-to-woocommerce-admin.php:370
#: admin/class-fg-opencart-to-woocommerce-admin.php:438
msgid "WordPress content removed"
msgstr "Contenu supprimé de WordPress"

#: admin/class-fg-opencart-to-woocommerce-admin.php:372
#: admin/class-fg-opencart-to-woocommerce-admin.php:440
msgid "Couldn't remove content"
msgstr "Impossible de supprimer le contenu"

#: admin/class-fg-opencart-to-woocommerce-admin.php:395
msgid "Connection successful"
msgstr "Connexion réussie"

#: admin/class-fg-opencart-to-woocommerce-admin.php:397
msgid "Connection failed"
msgstr "Connexion échouée"

#: admin/class-fg-opencart-to-woocommerce-admin.php:397
#: admin/class-fg-opencart-to-woocommerce-ftp.php:119
msgid "See the errors in the log below"
msgstr "Voir les erreurs dans l'historique ci-dessous"

#: admin/class-fg-opencart-to-woocommerce-admin.php:414
#: admin/class-fg-opencart-to-woocommerce-download.php:67
#, php-format
msgid "%s connection successful"
msgstr "Connexion %s réussie"

#: admin/class-fg-opencart-to-woocommerce-admin.php:416
#: admin/class-fg-opencart-to-woocommerce-download.php:69
#, php-format
msgid "%s connection failed"
msgstr "Connexion %s échouée"

#: admin/class-fg-opencart-to-woocommerce-admin.php:472
msgid "Import OpenCart"
msgstr "Importer OpenCart"

#: admin/class-fg-opencart-to-woocommerce-admin.php:473
msgid ""
"This plugin will import products, categories, images and information pages "
"from OpenCart to WooCommerce/WordPress.<br />Compatible with OpenCart "
"version 2 and 3."
msgstr ""
"Cette extension va importer les produits, les catégories, les images et les "
"pages d'information depuis OpenCart vers WooCommerce/WordPress.<br /"
">Compatible avec OpenCart version 2 et 3."

#: admin/class-fg-opencart-to-woocommerce-admin.php:474
#, php-format
msgid ""
"For any issue, please read the <a href=\"%s\" target=\"_blank\">FAQ</a> "
"first."
msgstr ""
"Pour toute question, veuillez d'abord lire la <a href=\"%s\" "
"target=\"_blank\">FAQ</a>."

#: admin/class-fg-opencart-to-woocommerce-admin.php:522
#, php-format
msgid "%d category"
msgid_plural "%d categories"
msgstr[0] "%d catégorie"
msgstr[1] "%d catégories"

#: admin/class-fg-opencart-to-woocommerce-admin.php:523
#, php-format
msgid "%d post"
msgid_plural "%d posts"
msgstr[0] "%d article"
msgstr[1] "%d articles"

#: admin/class-fg-opencart-to-woocommerce-admin.php:524
#, php-format
msgid "%d page"
msgid_plural "%d pages"
msgstr[0] "%d page"
msgstr[1] "%d pages"

