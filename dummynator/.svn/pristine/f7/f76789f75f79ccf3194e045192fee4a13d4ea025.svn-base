.dummynator-sidebar__wrapper{padding:10px}.dummynator-sidebar__wrapper .components-icon-button:not(:disabled):hover{box-shadow:none}.dummynator-sidebar__wrapper .components-base-control__label{display:inline-block;margin-bottom:-6px}.dummynator-sidebar__wrapper .components-button-group,.dummynator-sidebar__wrapper input[type=number]{float:right}.wp-core-ui .dummynator-sidebar__wrapper .button.button-large{padding-top:3px}