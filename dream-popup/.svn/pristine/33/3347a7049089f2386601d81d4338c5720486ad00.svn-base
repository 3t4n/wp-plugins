/*update data css start*/

#updtebtn {
    padding: 1%;
    text-align: right;
}

#update_data {
    display: none;
    margin-top: 2%;
}

.btnstyledv input[type="text"] {
    height: 100%;
    margin: 0 5px;
}

.btnstyledv input[type="color"] {
    width: 30px;
    height: 30px;
    cursor: pointer;
}


label#popup-prompt-text, #popup-prompt-cls, #popup-prompt-btntext {
    font-size: 20px;
}

.btnsizenew {
    padding-left: 10%;
}

.wp-w-40 {
    width: 40px!important;
}

.btnstyledv div.outerInp .innerInp {
    align-items: center;
    display: flex;
    margin: 20px 0px;
}

.btnstyledv input[type="text"] {
    padding: 0px;
    min-height: 33px;
    text-align: center;
}

.btnstyledv input[type="text"] {
    width: 100px;
}

.btnstyledv div.outerInp {
