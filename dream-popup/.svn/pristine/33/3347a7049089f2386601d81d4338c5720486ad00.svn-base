}

.hideTab {
    display: none!important;
}

.selectionTabDiv {
    border: 2px solid #e2e2e2;
    padding: 0 10px;
    margin-top: 30px;
    background: #fff;
}

.selectionTabs .btnTab {
    margin: 0 5px;
    padding: 5px 10px;
    cursor: pointer;
}

.selectionTabs hr {
    display: inline;
    width: 1.5px;
    height: 16px;
    background: #444;
    margin: auto 10px;
}

.selectionTabs .btnTab.activeTab {
    border-bottom: 3px solid #007cba;
}

.selectionTabs .btnTab h2 {
    margin: 0;
}

.selectionTabDiv>h2{
border-bottom: 2px solid #e2e2e2;
    padding-bottom: 10px;
}

.selectionTabs {
    display: flex;
}
