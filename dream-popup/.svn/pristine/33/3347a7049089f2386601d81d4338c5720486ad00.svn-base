.postbox {
    position: relative;
    min-width: 255px;
    border: 1px solid #ccd0d4;
    box-shadow: 0 1px 1px rgb(0 0 0 / 4%);
    background: #fff;
}
.postbox, .stuffbox {
    margin-bottom: 20px;
    padding: 0;
    line-height: 1;
    width: 100%;
}

h2.hndle {
    font-size: 14px;
}

.postbox-container {
	position: relative;
    float: left;
    width: 100%;
    margin-top: 2%;
}

#wp-content-media-buttons {
    float: left;
}

textarea#content {
    /* margin: -13px; */
    height: 300px;
    width: 100%;
    margin-top: -2.7%;
}

input#submitdata, input#sbmtbttnupdt {
    color:#f3f5f6;
    border: 1px solid #007cba;
    padding: 0.5% 2%;
    background: #007cba;
    vertical-align: top;
    cursor: pointer;
    margin-left: auto;
    margin-right: 20px;
    cursor: pointer;
    border-radius: 3px;
    text-transform: capitalize;
}

input#submitdata:hover, input#sbmtbttnupdt:hover {
    border-color: #0071a1;
    background: #0071a1;
}

.wp-editor-tools {
    padding-top: 2%;
}

#shortcodedv {
    border: 1px solid #bfbebe;
    position: relative;
    float: left;
    width: 50%;
    height: 300px;
    left: 25%;
    margin-top: -50%;
    background-color: #f7f7f7;
}

.shrtcdetxt{
    padding-left: 10px;
    padding-top: 10%;
    text-align: center;
}

/*pupup css start*/



 i.fa.fa-times {
    position: absolute;
    top: 10px;
    right: 10px;
    cursor: pointer;
    
}
div.popupcls {

    height: auto;
    position: absolute;
    left: 50%;
    top: 30%;
    opacity: 1;
}

/* 
  animation css start

*/
@keyframes slidesfromleft {
  0%   {
  opacity:0; left:0%; 
  }
  100%  {opacity:1; left:50%; }
}

@keyframes slidesfromleftreverse {
  0%   {
  opacity:1; left:50%; 
  }
  100%  {opacity:0; left:0%; }
}

@keyframes slidesfromright {
  0%   {
  opacity:0; left:100%; 
  }
  100%  {opacity:1; left:50%; }
}

@keyframes slidesfromrightreverse {
  0%   {
  opacity:1; left:50%; 
  }
  100%  {opacity:0; left:100%; }
}

@keyframes slidesfromtop {
  0%   {
  opacity:0; top: 0%; 
  }
  100%  {opacity:1; top: 30%; }
}
@keyframes slidesfromtopreverse {
  0%   {
  opacity:1; top: 30%; 
  }
  100%  {opacity:0; top: 0%; }
}

@keyframes slidesfrombottom {
  0%   {
  opacity:0; top:100%; 
  }
  100%  {opacity:1; top:30%; }
}

@keyframes slidesfrombottomreverse {
  0%   {
  opacity:1; top:30%; 
  }
  100%  {opacity:0; top:100%; }
}

.animeforward {
    animation-timing-function: ease-in-out;
    opacity: 1;
}

.animereverse {
 animation-timing-function: ease-in-out;
 opacity: 0;
}


@keyframes fade {
  0%   {
  opacity:0;  
  }
  100%  {opacity:1;}
}

@keyframes fadereverse {
  0%   {
  opacity:1;  
  }
  100%  {opacity:0;}
}

/* 
  animation css end

*/

