.wp-switch-editor {
	text-align: left;
    box-sizing: content-box;
    position: relative;
    top: 1px;
    background: #ebebeb;
    color: #666;
    cursor: pointer;
    font-size: 13px;
    line-height: 1.46153846;
    height: 20px;
    margin: 5px 0 0 5px;
    padding: 3px 8px 4px;
    border: 1px solid #e5e5e5;
}

.btnstyledv {
    width: 100%;
    background-color: #f5f2f2;
    border: 1px solid #cabfbf;
    display: flex;
    min-height: 350px;
}

.selectionOption div {
    line-height: 40px;
    padding: 0px 14px;
    border-bottom: 1px solid #e2e2e2;
    cursor: pointer;
    border-right: 1px solid #e2e2e2;
}

