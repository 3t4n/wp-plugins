   width: 24px;
    height: 20px;
    justify-content: center;
    display: flex;
}
.cookedbnew {
    padding-left: 10px;
}

.selectionOption div:hover, .activeStyleTab, .activePopStyleTab {
    background: #007cba;
    color: #fff;
}

.selectionOption {
    width: 20%;
    background: #fff;
    font-size: 16px;
}

.styleOption {
    /*width: 80%;*/
}

.label1, .label2, .label3, .label4, .label7 {
    padding: 20px 16px;
    align-items: center;
    line-height: 36px;
}

 .label1 input[type="text"], .label2 input[type="text"],.label3 input[type="text"] {
    padding: 0% 4%;
}

