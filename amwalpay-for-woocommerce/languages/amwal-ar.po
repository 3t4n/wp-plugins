#. Plugin Name of the plugin
msgid "AMWAL Payment Gateway for wooCommerce"
msgstr "بوابة دفع أمول لـ WooCommerce"

#. Description of the plugin
msgid "Amwal Credit Card Payment gateway for woocommerce. This plugin supports woocommerce version 3.0.0 or greater version."
msgstr "بوابة دفع بطاقات الائتمان من أمول لـ WooCommerce. هذا الإضافة تدعم الإصدار 3.0.0 أو الإصدارات الأحدث من WooCommerce."

#. Author of the plugin
msgid "Amwal"
msgstr "أمول"

#. Author of the plugin
msgid "Enable/Disable"
msgstr "تفعيل / تعطيل"

#. Author of the plugin
msgid "Enable Amwal PayForm Gateway"
msgstr "تفعيل بوابة دفع أمول PayForm"

#. Author of the plugin
msgid "Payment Method - Title"
msgstr "عنوان طريقة الدفع"

#. Author of the plugin
msgid "This controls the title which the user sees during checkout."
msgstr "هذا يتحكم في العنوان الذي يراه المستخدم أثناء إتمام الطلب."

#. Author of the plugin
msgid "Amwal pay"
msgstr "أمول للدفع"

#. Author of the plugin
msgid "Amwal Pay"
msgstr "أمول للدفع"

#. Author of the plugin
msgid "Payment Method - Description"
msgstr "وصف طريقة الدفع"

#. Author of the plugin
msgid "Amwal Payment Gateway for Oman  and supports all card and wallet payment"
msgstr "بوابة دفع أمول لسلطنة عمان وتدعم جميع بطاقات الدفع والمحافظ الإلكترونية."

#. Author of the plugin
msgid "This controls the description which the user sees during checkout."
msgstr "هذا يتحكم في الوصف الذي يراه المستخدم أثناء إتمام الطلب."

#. Author of the plugin
msgid "Payment Method - Logo URL"
msgstr "رابط شعار طريقة الدفع"

#. Author of the plugin
msgid "Add a Logo URL for checkout icon."
msgstr "أضف رابط شعار لاستخدامه في أيقونة الدفع."

#. Author of the plugin
msgid "Environment"
msgstr "البيئة"

#. Author of the plugin
msgid "Production"
msgstr "الإنتاج"

#. Author of the plugin
msgid "SIT"
msgstr "بيئة SIT"

#. Author of the plugin
msgid "UAT"
msgstr "بيئة UAT"

#. Author of the plugin
msgid "Select the environment for Amwal PayForm Gateway."
msgstr "اختر البيئة لبوابة أمول PayForm."

#. Author of the plugin
msgid "Merchant id"
msgstr "معرّف التاجر"

#. Author of the plugin
msgid "Please enter the merchant ID"
msgstr "يرجى إدخال معرّف التاجر"

#. Author of the plugin
msgid "Terminal id"
msgstr "معرّف الجهاز"

#. Author of the plugin
msgid "Please enter Terminal ID of your amwal merchant"
msgstr "يرجى إدخال معرّف الجهاز الخاص بتاجر أمول"

#. Author of the plugin
msgid "Secret key"
msgstr "المفتاح السري"

#. Author of the plugin
msgid "Please enter  Secret key"
msgstr "يرجى إدخال المفتاح السري"

#. Author of the plugin
msgid "Complete order after payment"
msgstr "إكمال الطلب بعد الدفع"

#. Author of the plugin
msgid "set order status completed after payment instead of processing"
msgstr "اضبط حالة الطلب إلى مكتمل بعد الدفع بدلاً من قيد المعالجة"

#. Author of the plugin
msgid "Debug Log"
msgstr "سجل التصحيح"

#. Author of the plugin
msgid "Enable debug log"
msgstr "تفعيل سجل التصحيح"

#. Author of the plugin
msgid "Log file will be saved in "
msgstr " سيتم حفظ ملف السجل في"

#. Author of the plugin
msgid "Sorry, Your order has been failed."
msgstr "عذرًا، فشل طلبك."

#. Author of the plugin
msgid "Transaction declined."
msgstr "تم رفض المعاملة."

#. Author of the plugin
msgid "AmwalPay Settings"
msgstr "إعدادات أمول للدفع"

#. Author of the plugin
msgid "Sorry, this order is invalid and cannot be paid for."
msgstr "عذرًا، هذا الطلب غير صالح ولا يمكن الدفع مقابله."

#. Author of the plugin
msgid "Sorry, AmwalPay plugin requires WooCommerce to be installed and active."
msgstr ".عذرًا، يتطلب إضافة AmwalPay تثبيت وتفعيل WooCommerce"

#. Author of the plugin
msgid "AmwalPay for WooCommerce"
msgstr "أموال باي لـ WooCommerce"
