    #wpbody-content, 
    #app_swiper_slider_sectionid_support {
    
    overflow: hidden !important;
  }
  .wrap-setting-app-wooslider {
    padding: 10px;
    height: auto;
    min-height: 400px;
    height: auto;
    display: flex;
    justify-items: space-between;
    justify-content: space-between;
  }
  
  .app-setting{
  width: 60%;
  float: left;
  min-width:600px;
  background-color: #fff;
  padding: 10px;
  margin:10px;
  }
  .app-info-wrap{
  width: 380px;
  float: right;
  word-wrap: break-word;
  padding: 10px;
  
  }
  .app-info-box {
    border: 1px solid #eee;
    -webkit-box-shadow: 0 1px 1px rgba(0,0,0,.05);
    box-shadow: 0 1px 1px rgba(0,0,0,.05);
    background: #fff;
    padding: 20px;
    margin: 10px;
  }
  h3.app-info-box-title {
    font-size: 14px;
    border-bottom: 1px solid #d7d7d7;
    padding-bottom: 10px;
  }
  
  .app-wps-wrap{
   min-height: 650px;
  }
  .form-table td p {
  margin-top: 4px;
  margin-bottom: 0;
  display: inline-block;
  margin-left: 20px;
  }
  ol.pro-features {
    font-size: 16px;
    line-height: 24px;
  }
  .cupon-btn{
  display:block;margin-top:14px; font-size:13px; color:#0073AA; line-height:20px;
  }
  .pro-btn{
  display:inline-block;
   background:#33b690; padding:8px 25px 8px; border-bottom:3px solid #33a583;
   border-radius:3px; color:white;
  }
  
  /*Button*/
  .app-btn-orange {
    background-color: #F27935 !important;
    border-color: #F27935 !important;
  }
  .app-button {
    border-style: solid;
    border-width: 0px 0px 3px;
    box-shadow: 0 -1px 0 rgba(255, 255, 255, 0.1) inset;
    color: #FFFFFF;
    border-radius: 4px;
    cursor: pointer;
    display: inline-block;
    font-style: normal;
    overflow: hidden;
    text-align: center;
    text-decoration: none;
    text-overflow: ellipsis;
    transition: all 200ms ease-in-out 0s;
    white-space: nowrap;
    padding: 12px 16px 9px;
    font-size: 16px;
    margin-right: 10px;
  }
  /*Green
  ==========================*/
  .app-btn-green {
  
  border-color: #3AC162;
  background-color: #5FCF80;
  
  }
  .app-btn-green:hover, .app-btn-green:focus, .app-btn-green:active {
    background-color: #4BC970;
    border-color: #3AC162;
    color:#d7d7d7;
  }
  /*lime
  ==========================*/
  
  .app-btn-lime {
  
    background-color: #19B5FE !important;
    border-color: #049de4 !important;
  
  }
  .app-btn-lime:hover, .app-btn-lime:focus, .app-btn-lime:active {
    background: none repeat scroll 0 0 #19B5FE !important;
    border-color: #049de4 !important;
    color: #d7d7d7;
  }
  /*Blue
  ==========================*/
  .app-btn-blue {
  
    border-color: #326E99;
    background-color: #3F8ABF;
  }
  
  .app-btn-blue:hover, .app-btn-blue:focus, .app-btn-blue:active {
    background-color: #397CAC;
    border-color: #326E99;
    color:#d7d7d7;
  }
  /*Red
  ==========================*/
  .app-btn-red {
  
    background-color: #ED5A5A !important;
    border-color: #EA4343 !important;
  
  }
  .app-btn-red:hover, .app-btn-red:focus, .app-btn-red:active {
    background: none repeat scroll 0 0 #EB4848 !important;
    border-color: #E83131 !important;
  }
  
  /* Setting panel */
  
  a#help-upgrade-tab {
    background-color:#953163;
    color: #fff;
  }
  a#help-upgrade-tab:hover {
    background-color:#D8335B;
    color: #fff;
  }
  
  /*list Items*/
  .app-pro-features-block{
  display: block;
  clear: both;
  min-height: 250px;
  margin-top:30px;
  }
  .pro-buy-button-block{
  display: block;
  width: 800px;
  margin-top:30px;
  min-height: 60px;
  clear: both;
  }
  ul.pro-features li {
    float: left;
    margin-right: 30px;
    max-width: 850px;
    min-width: 750px;
  }
  ul.pro-features li span.dashicons{
  color:#27AE60;
  }
  
  /**/
  /*list Items*/
  
  .app-pro-features-block{
  display: block;
  clear: both;
  min-height: 250px;
  margin-top:30px;
  }
  .pro-buy-button-block{
  display: block;
  width: 800px;
  margin-top:30px;
  min-height: 60px;
  clear: both;
  }
  
  p.mega-offer {
    text-align: center;
    padding: 8px;
    background-color: #EA5E03;
    color: #fff;
    width: 80%;
  }
  
  /*Shortcode tab css*/
  #app_shortcodes form  .submit{display: none;}
  .wrap-setting-app-wooslider .nav-tab {
    padding: 11px 15px;
    margin-left: 0;    background: #fff;    border: 1px solid#E3E6EF;  border-color: #E3E6EF;    border-bottom: 0;
  
  }
  .wrap-setting-app-wooslider .nav-tab-active, .wrap-setting-app-wooslider .nav-tab-active:focus, .wrap-setting-app-wooslider .nav-tab-active:focus:active, .wrap-setting-app-wooslider .nav-tab-active:hover {
    /* border-top: 2px solid #167496; */
    background: #fff;
    position: relative;
    color: #0575e6; 
    box-shadow: 0 0 0 0px #0575e6;
    border-bottom: 1px solid #fff;
   
  }
  .wrap-setting-app-wooslider .nav-tab-wrapper {
    border-bottom: 1px solid #E3E6EF;
    
  }
  /* .wrap-setting-app-wooslider .nav-tab-active::before{
    position: absolute;
    content: '';
    width: calc(100% + 2px);
    height: 2.5px;
    border-radius: 4px;
    background: linear-gradient(63deg, #01dc58 5%, #0575e6 100%);
    top: -1px;
    left: -1px;
  } */
  .wrap-setting-app-wooslider .app-setting .nav-tab{
    position: relative;
  }
  .wrap-setting-app-wooslider .app-setting .nav-tab::before{
    position: absolute;
    content: "";
    top: -1px;
    left: -1px;
    height: 4px;
    width: 0%;
    background: linear-gradient(63deg, #01dc58 5%, #0575e6 100%);
    -webkit-transition: all .4s ease-in-out;
    transition: all .4s ease-in-out;
    z-index: 123;
  }
.wrap-setting-app-wooslider .app-setting .nav-tab-active::before{
 
    width: 100%;
  
}
  .wrap-setting-app-wooslider .app-setting .nav-tab:hover::before{
    position: absolute;
    content: "";
    top: -1px;
    left: -1px;
    height: 4px;
    width: 100%;
    background: linear-gradient(63deg, #01dc58 5%, #0575e6 100%);
    -webkit-transition: all .4s ease-in-out;
    transition: all .4s ease-in-out;
    z-index: 123;
}
  
.wrap-setting-app-wooslider .form-table td label {
    margin: .35em 0 .2em!important;
    display: inline-block;
  }
  
  #display_name, 
  .wrap-setting-app-wooslider input[type=date], 
  .wrap-setting-app-wooslider input[type=datetime-local], 
  .wrap-setting-app-wooslider input[type=datetime], 
  .wrap-setting-app-wooslider input[type=email], 
  .wrap-setting-app-wooslider input[type=month], 
  .wrap-setting-app-wooslider input[type=number], 
  .wrap-setting-app-wooslider input[type=password], 
  .wrap-setting-app-wooslider input[type=search], 
  .wrap-setting-app-wooslider input[type=tel], 
  .wrap-setting-app-wooslider input[type=text], 
  .wrap-setting-app-wooslider input[type=time], 
  .wrap-setting-app-wooslider input[type=url], 
  .wrap-setting-app-wooslider input[type=week], 
  .wrap-setting-app-wooslider select {
    padding: 0 8px;
    line-height: 2;
    box-shadow: inset 0 1px 2px rgb(0 0 0 / 7%);
    background-color: transparent;
    color: #32373c;
    outline: 0;
    transition: 50ms border-color ease-in-out;
 
    border: 2px solid;
    border-radius: 3px;
    border-color: #0575e6 !important;
    padding: 0 15px;
  }


  .wrap-setting-app-wooslider  input[type="checkbox"]:focus, 
  .wrap-setting-app-wooslider  input[type="color"]:focus, 
  .wrap-setting-app-wooslider  input[type="date"]:focus, 
  .wrap-setting-app-wooslider  input[type="datetime-local"]:focus, 
  .wrap-setting-app-wooslider  input[type="datetime"]:focus, 
  .wrap-setting-app-wooslider  input[type="email"]:focus, 
  .wrap-setting-app-wooslider  input[type="month"]:focus, 
  .wrap-setting-app-wooslider  input[type="number"]:focus, 
  .wrap-setting-app-wooslider  input[type="password"]:focus, 
  .wrap-setting-app-wooslider  input[type="radio"]:focus, 
  .wrap-setting-app-wooslider  input[type="search"]:focus, 
  .wrap-setting-app-wooslider  input[type="tel"]:focus, 
  .wrap-setting-app-wooslider  input[type="text"]:focus, 
 .wrap-setting-app-wooslider   input[type="time"]:focus, 
  .wrap-setting-app-wooslider  input[type="url"]:focus, 
  .wrap-setting-app-wooslider  input[type="week"]:focus, 
  .wrap-setting-app-wooslider  select:focus, 
  .wrap-setting-app-wooslider textarea:focus {
	border-color: #01dc58 !important;
	box-shadow: 0 0 0 1px #01dc58 !important;
	outline: 2px solid transparent;
}

.app-setting .metabox-holder .submit .button-primary {
	background: linear-gradient(63deg, #01dc58 5%, #0575e6 100%)!important;
	border-color: linear-gradient(63deg, #01dc58 5%, #0575e6 100%)!important;
	color: #fff;
	text-decoration: none;
	text-shadow: none;padding: 4px 18px;
    font-size: 15px;-webkit-transition: all 0.3s ease-out 0s;
    -moz-transition: all 0.3s ease-out 0s;
    -ms-transition: all 0.3s ease-out 0s;
    -o-transition: all 0.3s ease-out 0s;
    transition: all 0.3s ease-out 0s;    position: relative;
}



.app-setting .metabox-holder .submit .button-primary:focus {
	box-shadow: 0 0 0 0px #fff,0 0 0 0px #fff  !important;
}

.wrap-setting-app-wooslider  .form-field input[type="email"], 
.wrap-setting-app-wooslider  .form-field input[type="number"], 
.wrap-setting-app-wooslider  .form-field input[type="password"], 
.wrap-setting-app-wooslider  .form-field input[type="search"], 
.wrap-setting-app-wooslider  .form-field input[type="tel"], 
.wrap-setting-app-wooslider  .form-field input[type="text"], 
.wrap-setting-app-wooslider  .form-field input[type="url"], 
.wrap-setting-app-wooslider  .form-field textarea {
	border-style: solid;
	border-width: 2px;
	width: 95%;
}