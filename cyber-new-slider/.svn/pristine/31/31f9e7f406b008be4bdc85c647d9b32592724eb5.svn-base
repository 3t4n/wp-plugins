.slick-for .slick-slide {
   /* background: #ccc;*/
    color: #3498db;
    font-size: 36px;
    line-height: 100px;
    margin: 10px;
    padding: 2%;
    position: relative;
    text-align: center;
}

.slick-slide{
	height:200px;
	padding : 0;
 }

/* .slick-slide img{
	height : 40px !important;
	width : 200px !important;
 }*/


/*.slider-nav .slick-slide{   height: 35px !important; width: 50px !important; font-size: 12px !important;   padding: 0; line-height:1; }*/
.slider-nav .slick-slide{  font-size: 12px !important;   padding: 0; line-height:1; }

.slider-for img {
	width : 100% !important;
    height: 100% !important;
}
.slick-track {
	width : none;
}

.slider-for .slick-slide {
    position: relative !important;
}
.caption-title {
    color: white;
    margin: 1px;
    position: absolute;
    text-align: center;
    top: 45%;
    width: 100%;

}
.slick-slide p, 
.slick-slide h1, 
.slick-slide h2,
.slick-slide h3,
.slick-slide h4,
.slick-slide h5,
.slick-slide h6 {
  text-align: center;
  width: 80% !important;
  margin: 0 auto !important;
  line-height: initial !important;
  }