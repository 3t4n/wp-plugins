/*
/*-------------------------- Media queries ---------------------------*/
/*for screen 769px to 1024px */
@media screen and (min-width: 769px) and (max-width: 1024px){
	
				.cyber_slider .slider-for .slick-arrow.slick-prev {
					margin-left: 3% !important;
					top: 50%;
				}

				.cyber_slider .slider-for .slick-arrow.slick-next {
					margin-right: 3% !important;
					top: 50%;
				}

				.cyber_slider .slider-nav .slick-arrow.slick-next {
				    top: 50% !important;
   					 margin-right: 13% !important;
			}
			.widefat .cyber_slider .slider-nav .slick-arrow.slick-next {
				    top: 50% !important;
   					 margin-right: 4% !important;
			}
}
/*for screen 481px to 768px */
@media screen and (min-width: 481px) and (max-width: 768px){
	
				.cyber_slider .slider-for .slick-arrow.slick-prev {
					margin-left: 6% !important;
				}

				.cyber_slider .slider-for .slick-arrow.slick-next {
					margin-right: 6% !important;
					
				}
			.cyber_slider .slider-nav .slick-arrow.slick-prev {
				    top: 50% !important;
   					 margin-left: 6% !important;
			}

			.cyber_slider .slider-nav .slick-arrow.slick-next {
				    top: 50% !important;
   					 margin-right: 6% !important;
			}
   
}
/*for screen 320px to 480px */
@media screen and (min-width: 320px) and (max-width: 480px){
	
				.cyber_slider .slider-for .slick-arrow.slick-prev {
					margin-left: 8% !important;
				}

				.cyber_slider .slider-for .slick-arrow.slick-next {
					margin-right: 8% !important;
					
				}
			.cyber_slider .slider-nav .slick-arrow.slick-prev {
				    top: 50% !important;
   					 margin-left: 10% !important;
			}

			.cyber_slider .slider-nav .slick-arrow.slick-next {
				    top: 50% !important;
   					 margin-right: 10% !important;
			}
   
}