.dpaa-video-element{max-height:100%;max-width:100%;position:relative}.dpaa-video-element.no-controls{pointer-events:none}.dpaa-video-element.as-background{height:100%;right:50%;-o-object-fit:cover;object-fit:cover;pointer-events:none;position:absolute;top:50%;transform:translateX(50%) translateY(-50%);width:100%;z-index:0}.dpaa-video-element:focus{outline:none}.has-video-background .dpaa-video-background{height:100%;right:50%;-o-object-fit:cover;object-fit:cover;pointer-events:none;position:absolute;top:50%;transform:translateX(50%) translateY(-50%);width:100%;z-index:0}
