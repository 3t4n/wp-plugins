.fsdt-field-wrap label {
    font-weight: 500;
    margin-bottom: 10px;
    display: block;
  }
  
  .fsdt-checkbox-toggle input[type="checkbox"]:checked + label {
    background-color: rgb(255 221 201);
  }
  
  .fsdt-field-wrap {
    margin-bottom: 10px;
  }
  
  /* side bar check box */
  .fsdt-checkbox-toggle input[type="checkbox"],
  .fsdt-checkbox-toggle input[type="radio"] {
    min-width: 4rem;
  }
  
  .fsdt-checkbox-toggle input[type="checkbox"] {
    height: 22px;
    width: 50px;
    opacity: 0;
    position: absolute;
    top: 4px;
    left: 0;
    z-index: 4;
  }
  
  .fsdt-checkbox-toggle input[type="checkbox"]:checked + label {
    background-color: rgb(255 221 201);
  }
  
  .fsdt-checkbox-toggle input[type="checkbox"]:checked + label:before {
    left: 16px;
    background-color: #ff8642;
    background-image: linear-gradient(315deg, #ff8642 0%, #ff8642 74%);
    box-shadow: none;
  }
  
  .fsdt-checkbox-toggle label {
    display: inline-block;
    transition: all 0.3s ease;
    height: 20px;
    width: 40px;
    border-radius: 48px;
    background-color: rgba(0, 0, 0, 0.16);
    position: relative;
    z-index: 2;
  }
  
  .fsdt-checkbox-toggle label:before {
    content: "";
    height: 24px;
    width: 24px;
    position: absolute;
    top: -2px;
    left: 0;
    background-color: white;
    border-radius: 50%;
    box-shadow: rgb(0 0 0 / 20%) 0 0 14px;
    transition: all 0.3s ease;
  }
       div.fsdt-meta-flx .fsdt-field {
      display: inline-block;
      width: calc(100% - 153px);
    }
    .fsdt-meta-flx {
      display: flex;
      margin-bottom: 15px;
    }