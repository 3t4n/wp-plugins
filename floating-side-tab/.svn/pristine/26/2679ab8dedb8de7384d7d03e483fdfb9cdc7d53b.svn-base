}

.fsdt-compare-click {
  font-size: 12px;
  background: #ffffff;
  color: #464545 !important;
  border-radius: 30px !important;
  cursor: pointer;
  transition: all 0.3s ease;
  text-decoration: none;
  border: none;
  font-weight: 600;
  margin-right: 3px;
  margin-bottom: 3px;
  padding: 15px 25px;
  line-height: 120%;
  text-transform: uppercase;
  border-radius: 44px;
  cursor: pointer;
  text-decoration: none;
  transition: all 0.3s ease;
  border: none;
  font-weight: bold;
  font-size: 12px;
}

.wrap.fsdt-wrap.fsdt-compare-overlay {
  opacity: 20%;
  pointer-events: none;
}

