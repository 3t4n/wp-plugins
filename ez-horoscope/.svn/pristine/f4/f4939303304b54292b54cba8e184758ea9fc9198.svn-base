.wrap {
    /* General styles for the settings page */
}

.wrap h1 {
    color: #0073aa;
    font-size: 24px;
    margin-bottom: 20px;
}

.wrap p {
    background-color: #f1f1f1;
    padding: 10px;
    border-left: 4px solid #0073aa;
}

.settings-form {
    background: #fff;
    padding: 20px;
    border: 1px solid #ddd;
    border-radius: 5px;
}

#syndicated-horoscope-iframe {
    overflow: hidden;
    width: 100%;
    border: none;
}

/* Style for the backlink container */
.backlink-container {
    text-align: center;
    margin-top: 20px;
}