#: inc/terms.php:18
msgid "Terms"
msgstr "Termeni"

#: inc/terms.php:21
msgid "Separate terms names or IDs by comma (these will be created if not found)."
msgstr "Separă numele sau ID-urile termenilor cu virgule (dacă nu sunt găsiți, vor fi creați)."
