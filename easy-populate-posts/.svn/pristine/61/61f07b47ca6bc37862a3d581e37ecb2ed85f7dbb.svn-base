msgstr "va seta o stare aleatorie, corelată cu data publicării"

#. Translators: %s - default value.
#: inc/post.php:87 inc/post.php:97
msgid "the default value is %s"
msgstr "valoarea implicită este %s"

#. Translators: %s - default value.
#: inc/post.php:87
msgid "published"
msgstr "publicat"

#. Translators: %s - default value.
