msgid "date"
msgstr "dată"

#: inc/images.php:81
msgid "past date"
msgstr "dată în trecut"

#: inc/images.php:82
msgid "future date"
msgstr "dată în viitor"

#: inc/images.php:83 inc/images.php:84
msgid "time"
msgstr "oră"

