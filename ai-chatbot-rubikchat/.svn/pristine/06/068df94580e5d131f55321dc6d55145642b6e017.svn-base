#toplevel_page_rubik-chat .wp-menu-image {
    display: flex;
    justify-content: center;
    align-items: center;
    background: transparent;
}
.rubik-chat-wrap a:focus,
.rubik-chat-copyright a:focus {
    outline: none !important;
}
.rubik-chat-logo {
    margin-bottom: 30px;
    text-align: center;
}
.rubik-chat-logo img {
    height: 45px;
}
.rubik-chat-form {
    display: flex;
    justify-content: center;
    flex-direction: column;
    align-items: center;
}
.rubik-chat-form .card {
    background: #fff;
    box-shadow: 0 5px 10px rgba(0, 0, 0, 0.1);
    border-radius: 15px;
    padding: 50px 50px 30px;
    max-width: 500px;
    width: 100%;
    box-sizing: border-box
}
.form-control-label {
    font-weight: 500;
    margin-bottom: 7px;
    display: block;
    font-size: 14px;
}
.form-control-input input {
    padding: 7px 15px;
    width: 100%;
    border-color: #ccc;
}
.form-control-submit p {
    margin: 10px 0 0;
}
.form-control-submit .button-primary {
    background: #000;
    border: #000;
    font-size: 14px;
    padding: 5px 20px;
    width: 100%;
}
.rubik-chat-copyright {
    margin: 12px 0 0;
}
.rubik-chat-copyright,
.rubik-chat-copyright a {
    color: #555;
}
.rubik-chat-note {
    background: #cff4fc;
    display: inline-block;
    padding: 18px 20px;
    border: solid 1px #bbe9f3;
}