msgid "Accessibility Options"
msgstr "Options d'accessibilité"

msgid "Configure accessibility options for your site."
msgstr "Configurer les options d'accessibilité pour votre site."

msgid "Accessibility"
msgstr "Accessibilité"

msgid "General settings"
msgstr "Paramètres généraux"

msgid "Custom selectors"
msgstr "Sélecteurs personnalisés"

msgid "Enable contrast adjustment"
msgstr "Activer le réglage du contraste"

msgid "Enable color inversion"
msgstr "Activer l'inversion des couleurs"

msgid "Enable text resizing"
msgstr "Activer le redimensionnement du texte"

msgid "Enable underline links"
msgstr "Activer le soulignement des liens"

msgid "Enable letter spacing adjustment"
msgstr "Activer le réglage de l'espacement des lettres"

msgid "Enable line height adjustment"
msgstr "Activer le réglage de la hauteur de ligne"

msgid "Enable text-to-speech"
msgstr "Activer la synthèse vocale"

msgid "Enable color saturation adjustment"
msgstr "Activer le réglage de la saturation des couleurs"

msgid "Enable cursor enlargement"
msgstr "Activer l'agrandissement du curseur"

msgid "Enable hide media"
msgstr "Activer le masquage des médias"

msgid "Enable tun off of animations"
msgstr "Activer la désactivation des animations"

msgid "Enable reading line"
msgstr "Activer la ligne de lecture"

msgid "Enable dyslexia-friendly mode"
msgstr "Activer le mode adapté à la dyslexie"

msgid "Contrast button selector"
msgstr "Sélecteur du bouton de contraste"

msgid "No token yet?"
msgstr "Pas encore de jeton ?"

msgid "Get your token here."
msgstr "Obtenez votre jeton ici."

msgid "Load widget"
msgstr "Charger le widget"

msgid "Selector to the color invert button"
msgstr "Sélecteur pour le bouton d'inversion des couleurs"

msgid "Text increase button selector"
msgstr "Sélecteur du bouton d'agrandissement du texte"

msgid "Text decrease button selector"
msgstr "Sélecteur du bouton de réduction du texte"

msgid "Dyslexic button selector"
msgstr "Sélecteur du bouton pour dyslexiques"

msgid "Motor-impaired button selector"
msgstr "Sélecteur du bouton pour les personnes à mobilité réduite"

msgid "ADHD button selector"
msgstr "Sélecteur du bouton pour TDAH"

msgid "Blind button selector"
msgstr "Sélecteur du bouton pour aveugles"

msgid "Cognitive and learning button selector"
msgstr "Sélecteur du bouton cognitif et d'apprentissage"

msgid "Color-blind button selector"
msgstr "Sélecteur du bouton pour daltoniens"

msgid "Dyslexia button selector"
msgstr "Sélecteur du bouton pour la dyslexie"

msgid "Epileptic button selector"
msgstr "Sélecteur du bouton pour épileptiques"

msgid "Low-vision button selector"
msgstr "Sélecteur du bouton pour basse vision"

msgid "Text resize button selector"
msgstr "Sélecteur du bouton de redimensionnement du texte"

msgid "Underline button selector"
msgstr "Sélecteur du bouton de soulignement"

msgid "Letter spacing button selector"
msgstr "Sélecteur du bouton d'espacement des lettres"

msgid "Line height button selector"
msgstr "Sélecteur du bouton de hauteur de ligne"

msgid "Text-to-speech button selector"
msgstr "Sélecteur du bouton de synthèse vocale"

msgid "Saturation button selector"
msgstr "Sélecteur du bouton de saturation"

msgid "Selector for the enlarge cursor button"
msgstr "Sélecteur du bouton d'agrandissement du curseur"

msgid "Selector for the hide media"
msgstr "Sélecteur du bouton pour masquer les médias"

msgid "Disable animations button selector"
msgstr "Sélecteur du bouton pour désactiver les animations"

msgid "CSS selector of the button displaying the line to read"
msgstr "Sélecteur CSS pour un bouton affichant une ligne à lire"

msgid "Reset button selector"
msgstr "Sélecteur du bouton de réinitialisation"

msgid "Selector to display availability statement"
msgstr "Sélecteur pour afficher la déclaration de disponibilité"

msgid "Maximum zoom level"
msgstr "Niveau de zoom maximal"

msgid "Premium"
msgstr "Premium"

msgid "Token"
msgstr "Jeton"

msgid "Default position"
msgstr "Position par défaut"

msgid "Show on left"
msgstr "Afficher à gauche"

msgid "Show on right"
msgstr "Afficher à droite"

msgid "Primary color"
msgstr "Couleur primaire"

msgid "Secondary color"
msgstr "Couleur secondaire"

msgid "Restore default"
msgstr "Rétablir la valeur par défaut"
