msgid "Accessibility Options"
msgstr "Barrierefreiheitsoptionen"

msgid "Configure accessibility options for your site."
msgstr "Konfigurieren Sie die Barrierefreiheitsoptionen für Ihre Website."

msgid "Accessibility"
msgstr "Barrierefreiheit"

msgid "General settings"
msgstr "Allgemeine Einstellungen"

msgid "Custom selectors"
msgstr "Benutzerdefinierte Selektoren"

msgid "Enable contrast adjustment"
msgstr "Kontrasteinstellung aktivieren"

msgid "Enable color inversion"
msgstr "Farbumkehrung aktivieren"

msgid "Enable text resizing"
msgstr "Textvergrößerung aktivieren"

msgid "Enable underline links"
msgstr "Unterstreichung von Links aktivieren"

msgid "Enable letter spacing adjustment"
msgstr "Buchstabenabstand anpassen aktivieren"

msgid "Enable line height adjustment"
msgstr "Zeilenhöhenanpassung aktivieren"

msgid "Enable text-to-speech"
msgstr "Text-zu-Sprache aktivieren"

msgid "Enable color saturation adjustment"
msgstr "Farbsättigungsanpassung aktivieren"

msgid "Enable cursor enlargement"
msgstr "Cursorvergrößerung aktivieren"

msgid "Enable hide media"
msgstr "Medien ausblenden aktivieren"

msgid "Enable tun off of animations"
msgstr "Animationen deaktivieren aktivieren"

msgid "Enable reading line"
msgstr "Leselinie aktivieren"

msgid "Enable dyslexia-friendly mode"
msgstr "Dyslexiefreundlichen Modus aktivieren"

msgid "Contrast button selector"
msgstr "Kontrast-Schaltflächen-Selektor"

msgid "No token yet?"
msgstr "Noch kein Token?"

msgid "Get your token here."
msgstr "Holen Sie sich Ihren Token hier."

msgid "Load widget"
msgstr "Widget laden"

msgid "Selector to the color invert button"
msgstr "Selektor für die Farbumkehr-Schaltfläche"

msgid "Text increase button selector"
msgstr "Selektor für die Textvergrößerungs-Schaltfläche"

msgid "Text decrease button selector"
msgstr "Selektor für die Textverkleinerungs-Schaltfläche"

msgid "Dyslexic button selector"
msgstr "Selektor für die Dyslexie-Schaltfläche"

msgid "Motor-impaired button selector"
msgstr "Selektor für die motorisch eingeschränkte Schaltfläche"

msgid "ADHD button selector"
msgstr "Selektor für die ADHD-Schaltfläche"

msgid "Blind button selector"
msgstr "Blinden-Schaltflächen-Selektor"

msgid "Cognitive and learning button selector"
msgstr "Selektor für die kognitive und lernende Schaltfläche"

msgid "Color-blind button selector"
msgstr "Selektor für die Farbenblind-Schaltfläche"

msgid "Dyslexia button selector"
msgstr "Selektor für die Dyslexie-Schaltfläche"

msgid "Epileptic button selector"
msgstr "Selektor für die Epilepsie-Schaltfläche"

msgid "Low-vision button selector"
msgstr "Selektor für die Sehbehinderung-Schaltfläche"

msgid "Text resize button selector"
msgstr "Selektor für die Textgrößenänderungs-Schaltfläche"

msgid "Underline button selector"
msgstr "Selektor für die Unterstreichungs-Schaltfläche"

msgid "Letter spacing button selector"
msgstr "Selektor für die Buchstabenabstands-Schaltfläche"

msgid "Line height button selector"
msgstr "Selektor für die Zeilenhöhen-Schaltfläche"

msgid "Text-to-speech button selector"
msgstr "Selektor für die Text-zu-Sprache-Schaltfläche"

msgid "Saturation button selector"
msgstr "Selektor für die Farbsättigungs-Schaltfläche"

msgid "Selector for the enlarge cursor button"
msgstr "Selektor für die Cursorvergrößerungs-Schaltfläche"

msgid "Selector for the hide media"
msgstr "Selektor für die Medienausblendungs-Schaltfläche"

msgid "Disable animations button selector"
msgstr "Selektor für die Animationsdeaktivierungs-Schaltfläche"

msgid "CSS selector of the button displaying the line to read"
msgstr "CSS-Selektor für eine Schaltfläche, die eine Zeile anzeigt, die lautet"

msgid "Reset button selector"
msgstr "Selektor für die Zurücksetzen-Schaltfläche"

msgid "Selector to display availability statement"
msgstr "Selektor zur Anzeige der Verfügbarkeitserklärung"

msgid "Maximum zoom level"
msgstr "Maximales Zoomniveau"

msgid "Premium"
msgstr "Premium"

msgid "Token"
msgstr "Token"

msgid "Default position"
msgstr "Standardposition"

msgid "Show on left"
msgstr "Auf der linken Seite anzeigen"

msgid "Show on right"
msgstr "Rechts anzeigen"

msgid "Primary color"
msgstr "Primäre Farbe"

msgid "Secondary color"
msgstr "Sekundärfarbe"

msgid "Restore default"
msgstr "Standard wiederherstellen"
