#. Description of the plugin
#: class-sticky-header-2020.php
#: class-sticky-header-2020.php:1995
msgid "This plugin extends the native customizer and provides settings for making the header sticky, with settings for scroll minification, shadow, background, spacing, text, menu and icons colors, etc. The plugin is compatible with Twenty Twenty -> Twenty Twenty-Four, Astra, and Hello Elementor themes."
msgstr ""

#. Author of the plugin
#: class-sticky-header-2020.php
msgid "Iulia Cazan"
msgstr ""

#. Author URI of the plugin
#: class-sticky-header-2020.php
msgid "https://profiles.wordpress.org/iulia-cazan"
msgstr ""

