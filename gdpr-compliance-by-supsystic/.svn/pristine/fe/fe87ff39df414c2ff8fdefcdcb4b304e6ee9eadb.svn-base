.gdprsupOptHtml-radiobuttons .gdprsupOptCellValue label {
	margin-right: 10px;
}
.gdprsupAgreement textarea, .gdprsupAgreement input[type="text"] {
	width: 100%;
}
#gdprsupAgreementEx {
	display: none;
}
.gdprsupAgreement {
	padding-bottom: 10px;
	margin-bottom: 10px;
}
.gdprsupAgreement:not(:last-child) {
	border-bottom: 1px solid #e9edee
}
.gdprsupAgreementShellDesc {
	clear: both;
	padding: 12px 0;
}

.form-table .gdprsupOptRow[data-connect] div.gdprsupOptLblCell:first-child {
	padding-left: 15px;
}
.row {
	clear: both;
}

.row.gdprsupOptRow {
	margin-left: 0;
	margin-right: 0;
}
.form-table .row.gdprsupOptRow:not(:last-child) {
	border-bottom: 1px solid #e9edee
}
.form-table .row .gdprsupOptCell {
	margin-bottom: 9px;
    padding: 15px 10px;
    line-height: 1.3;
    vertical-align: middle;
	font-size: 14px;
}
.form-table .gdprsupOptLblCell {
	font-size: 16px;
	vertical-align: top;
    text-align: left;
    padding: 20px 10px 20px 0;
    line-height: 1.3;
    font-weight: 600;
	color: #000;
}